constant ulong IG_SEGMENTED_UNIT_INDEXED_COUNT = 1ul;
constant ulong IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY = 2ul;
constant ulong IG_SEGMENTED_UNIT_DISCRIMINATOR_SHIFT = 32ul;

// Device-to-device adapter for the raw temporal Unit prelude. The temporal SSA constructor
// publishes canonical eight-u32 rows; this kernel validates those rows, computes comparison
// ranks without a host materialization boundary, and emits the exact two-column quantifier packet
// consumed by the existing segmented Unit source adapter. Dispatch exactly one thread.
struct IgSegmentedTemporalRankArgs {
    ulong temporal_words;
    ulong register_stride;
    ulong row_count;
    ulong packet_words;
    ulong template_words;
    ulong expected_function;
    ulong receipt_base;
    ulong receipt_count;
    ulong root_base;
    ulong cell_base;
    ulong cell_capacity;
    ulong zone_count;
    ulong zone_descriptor_base;
    ulong zone_byte_base;
    ulong zone_byte_count;
};

inline long ig_segmented_temporal_long(
    device const uint* values,
    ulong base,
    ulong offset) {
    return as_type<long>(
        ulong(values[base + offset]) | (ulong(values[base + offset + 1ul]) << 32ul));
}

inline bool ig_segmented_temporal_fixed_zone_char(
    int offset_seconds,
    ulong index,
    thread uchar& value) {
    long magnitude = offset_seconds < 0 ? -long(offset_seconds) : long(offset_seconds);
    if (magnitude > 86399L) return false;
    ulong hours = ulong(magnitude / 3600L);
    ulong minutes = ulong((magnitude / 60L) % 60L);
    ulong seconds = ulong(magnitude % 60L);
    ulong length = seconds == 0ul ? 6ul : 9ul;
    if (index >= length) return false;
    if (index == 0ul) value = offset_seconds < 0 ? uchar('-') : uchar('+');
    else if (index == 1ul) value = uchar('0' + hours / 10ul);
    else if (index == 2ul) value = uchar('0' + hours % 10ul);
    else if (index == 3ul || index == 6ul) value = uchar(':');
    else if (index == 4ul) value = uchar('0' + minutes / 10ul);
    else if (index == 5ul) value = uchar('0' + minutes % 10ul);
    else if (index == 7ul) value = uchar('0' + seconds / 10ul);
    else value = uchar('0' + seconds % 10ul);
    return true;
}

inline bool ig_segmented_temporal_named_zone_range(
    device const ulong* packet_template,
    thread const IgSegmentedTemporalRankArgs& args,
    ulong zone,
    thread ulong& offset,
    thread ulong& length) {
    if (zone >= args.zone_count) return false;
    ulong descriptor = args.zone_descriptor_base + zone * 2ul;
    if (descriptor < args.zone_descriptor_base
            || descriptor + 1ul >= args.zone_byte_base) return false;
    offset = packet_template[descriptor];
    length = packet_template[descriptor + 1ul];
    return length != 0ul && offset <= args.zone_byte_count
        && length <= args.zone_byte_count - offset;
}

inline bool ig_segmented_temporal_zone_order(
    device const uint* temporal,
    device const ulong* packet_template,
    thread const IgSegmentedTemporalRankArgs& args,
    ulong left_base,
    ulong right_base,
    thread int& ordering) {
    uint left_tag = temporal[left_base];
    uint right_tag = temporal[right_base];
    ulong left_offset = 0ul;
    ulong right_offset = 0ul;
    ulong left_length = 0ul;
    ulong right_length = 0ul;
    int left_fixed = 0;
    int right_fixed = 0;
    if (left_tag == 5u) {
        left_fixed = as_type<int>(temporal[left_base + 4ul]);
        if (left_fixed < -86399 || left_fixed > 86399) return false;
        left_length = left_fixed % 60 == 0 ? 6ul : 9ul;
    } else if (left_tag == 8u) {
        if (!ig_segmented_temporal_named_zone_range(
                packet_template, args, temporal[left_base + 4ul],
                left_offset, left_length)) return false;
    } else return false;
    if (right_tag == 5u) {
        right_fixed = as_type<int>(temporal[right_base + 4ul]);
        if (right_fixed < -86399 || right_fixed > 86399) return false;
        right_length = right_fixed % 60 == 0 ? 6ul : 9ul;
    } else if (right_tag == 8u) {
        if (!ig_segmented_temporal_named_zone_range(
                packet_template, args, temporal[right_base + 4ul],
                right_offset, right_length)) return false;
    } else return false;
    device const uchar* template_bytes =
        reinterpret_cast<device const uchar*>(packet_template);
    ulong shared = min(left_length, right_length);
    for (ulong index = 0ul; index < shared; ++index) {
        uchar left = 0u;
        uchar right = 0u;
        if (left_tag == 5u) {
            if (!ig_segmented_temporal_fixed_zone_char(left_fixed, index, left)) return false;
        } else {
            left = template_bytes[args.zone_byte_base * 8ul + left_offset + index];
        }
        if (right_tag == 5u) {
            if (!ig_segmented_temporal_fixed_zone_char(right_fixed, index, right)) return false;
        } else {
            right = template_bytes[args.zone_byte_base * 8ul + right_offset + index];
        }
        if (left != right) {
            ordering = left < right ? -1 : 1;
            return true;
        }
    }
    ordering = left_length < right_length ? -1 : (left_length > right_length ? 1 : 0);
    return true;
}

inline bool ig_segmented_temporal_row_valid(
    device const uint* temporal,
    thread const IgSegmentedTemporalRankArgs& args,
    ulong base) {
    uint tag = temporal[base];
    bool trailing = true;
    if (args.expected_function == 0ul) {
        for (ulong word = 3ul; word < 8ul; ++word) trailing = trailing && temporal[base + word] == 0u;
        return tag == 1u && trailing;
    }
    if (args.expected_function == 1ul || args.expected_function == 2ul) {
        long nanos = ig_segmented_temporal_long(temporal, base, 1ul);
        ulong first_unused = args.expected_function == 1ul ? 3ul : 4ul;
        for (ulong word = first_unused; word < 8ul; ++word) {
            trailing = trailing && temporal[base + word] == 0u;
        }
        if (tag != uint(args.expected_function + 1ul) || !trailing
                || nanos < 0L || nanos >= 86400000000000L) return false;
        if (args.expected_function == 2ul) {
            int offset = as_type<int>(temporal[base + 3ul]);
            return offset >= -86399 && offset <= 86399;
        }
        return true;
    }
    if (args.expected_function == 3ul) {
        for (ulong word = 4ul; word < 8ul; ++word) trailing = trailing && temporal[base + word] == 0u;
        return tag == 4u && temporal[base + 3ul] < 1000000000u && trailing;
    }
    if (args.expected_function != 4ul || (tag != 5u && tag != 8u)
            || temporal[base + 3ul] >= 1000000000u) return false;
    for (ulong word = 5ul; word < 8ul; ++word) trailing = trailing && temporal[base + word] == 0u;
    if (!trailing) return false;
    if (tag == 5u) {
        int offset = as_type<int>(temporal[base + 4ul]);
        return offset >= -86399 && offset <= 86399;
    }
    return ulong(temporal[base + 4ul]) < args.zone_count;
}

inline bool ig_segmented_temporal_order(
    device const uint* temporal,
    device const ulong* packet_template,
    thread const IgSegmentedTemporalRankArgs& args,
    ulong left_base,
    ulong right_base,
    thread int& ordering) {
    if (args.expected_function <= 1ul) {
        long left = ig_segmented_temporal_long(temporal, left_base, 1ul);
        long right = ig_segmented_temporal_long(temporal, right_base, 1ul);
        ordering = left < right ? -1 : (left > right ? 1 : 0);
        return true;
    }
    if (args.expected_function == 2ul) {
        long left_local = ig_segmented_temporal_long(temporal, left_base, 1ul);
        long right_local = ig_segmented_temporal_long(temporal, right_base, 1ul);
        int left_offset = as_type<int>(temporal[left_base + 3ul]);
        int right_offset = as_type<int>(temporal[right_base + 3ul]);
        long left = left_local - long(left_offset) * 1000000000L;
        long right = right_local - long(right_offset) * 1000000000L;
        ordering = left < right ? -1 : (left > right ? 1
            : (left_offset < right_offset ? -1 : (left_offset > right_offset ? 1 : 0)));
        return true;
    }
    long left_seconds = ig_segmented_temporal_long(temporal, left_base, 1ul);
    long right_seconds = ig_segmented_temporal_long(temporal, right_base, 1ul);
    if (left_seconds != right_seconds) {
        ordering = left_seconds < right_seconds ? -1 : 1;
        return true;
    }
    uint left_nanos = temporal[left_base + 3ul];
    uint right_nanos = temporal[right_base + 3ul];
    if (left_nanos != right_nanos) {
        ordering = left_nanos < right_nanos ? -1 : 1;
        return true;
    }
    if (args.expected_function == 3ul) {
        ordering = 0;
        return true;
    }
    return ig_segmented_temporal_zone_order(
        temporal, packet_template, args, left_base, right_base, ordering);
}

kernel void ig_segmented_temporal_rank_prelude(
    device const uint* temporal [[buffer(0)]],
    device const ulong* packet_template [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant IgSegmentedTemporalRankArgs& constant_args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    IgSegmentedTemporalRankArgs args = constant_args;
    for (ulong word = 0ul; word < args.packet_words; ++word) {
        output[word] = packet_template[word];
    }
    ulong expected_temporal_words = args.row_count * args.register_stride;
    ulong expected_roots = args.row_count * 2ul;
    ulong expected_cell_base = args.root_base + expected_roots;
    ulong item_base = args.cell_base + args.cell_capacity * IG_SEGMENTED_UNIT_QUANTIFIER_VALUE_WORDS;
    ulong expected_template_words = args.zone_byte_base + (args.zone_byte_count + 7ul) / 8ul;
    bool valid = args.row_count != 0ul
        && args.row_count <= 0xfffffffful
        && args.register_stride >= 8ul
        && args.expected_function <= 4ul
        && args.receipt_base == IG_SEGMENTED_UNIT_QUANTIFIER_HEADER_WORDS
        && args.receipt_count == 5ul
        && args.root_base == args.receipt_base
            + args.receipt_count * IG_SEGMENTED_UNIT_QUANTIFIER_RECEIPT_WORDS
        && args.cell_capacity == expected_roots
        && args.cell_base == expected_cell_base
        && args.packet_words == item_base + 2ul
        && args.temporal_words == expected_temporal_words
        && args.zone_descriptor_base == args.packet_words + 1ul
        && args.zone_byte_base == args.zone_descriptor_base + args.zone_count * 2ul
        && args.template_words == expected_template_words
        && packet_template[args.packet_words] == args.zone_count;
    ulong zone_cursor = 0ul;
    for (ulong zone = 0ul; valid && zone < args.zone_count; ++zone) {
        ulong descriptor = args.zone_descriptor_base + zone * 2ul;
        ulong offset = packet_template[descriptor];
        ulong length = packet_template[descriptor + 1ul];
        valid = offset == zone_cursor && length != 0ul
            && offset <= args.zone_byte_count
            && length <= args.zone_byte_count - offset;
        zone_cursor += length;
    }
    valid = valid && zone_cursor == args.zone_byte_count;
    device const uchar* template_bytes =
        reinterpret_cast<device const uchar*>(packet_template);
    for (ulong byte = args.zone_byte_count; valid && byte % 8ul != 0ul; ++byte) {
        valid = template_bytes[args.zone_byte_base * 8ul + byte] == 0u;
    }
    for (ulong row = 0ul; valid && row < args.row_count; ++row) {
        valid = ig_segmented_temporal_row_valid(
            temporal, args, row * args.register_stride);
    }
    if (!valid) {
        if (args.packet_words > 1ul) output[1] = 2ul;
        return;
    }
    output[18] = args.row_count;
    output[25] = expected_roots;
    output[26] = expected_roots;
    output[27] = 0ul;
    output[28] = 0ul;
    for (ulong receipt = 0ul; receipt < args.receipt_count; ++receipt) {
        ulong record = args.receipt_base
            + receipt * IG_SEGMENTED_UNIT_QUANTIFIER_RECEIPT_WORDS;
        ulong input_rows = receipt <= 2ul ? 1ul : args.row_count;
        ulong output_rows = receipt <= 1ul ? 1ul : args.row_count;
        output[record + 6ul] = input_rows;
        output[record + 7ul] = output_rows;
        output[record + 8ul] = IG_SEGMENTED_UNIT_QUANTIFIER_OUTPUT_VERSION;
    }
    for (ulong row = 0ul; row < args.row_count; ++row) {
        ulong rank = 0ul;
        ulong right_base = row * args.register_stride;
        for (ulong candidate = 0ul; candidate < args.row_count; ++candidate) {
            int ordering = 0;
            if (!ig_segmented_temporal_order(
                    temporal,
                    packet_template,
                    args,
                    candidate * args.register_stride,
                    right_base,
                    ordering)) {
                output[1] = 2ul;
                return;
            }
            rank += ordering < 0 ? 1ul : 0ul;
        }
        ulong rank_handle = row * 2ul;
        ulong count_handle = rank_handle + 1ul;
        output[args.root_base + rank_handle] = rank_handle;
        output[args.root_base + count_handle] = count_handle;
        ulong rank_cell = args.cell_base
            + rank_handle * IG_SEGMENTED_UNIT_QUANTIFIER_VALUE_WORDS;
        ulong count_cell = args.cell_base
            + count_handle * IG_SEGMENTED_UNIT_QUANTIFIER_VALUE_WORDS;
        output[rank_cell] = IG_SEGMENTED_UNIT_QUANTIFIER_INTEGER;
        output[rank_cell + 1ul] = rank;
        output[rank_cell + 2ul] = 0ul;
        output[rank_cell + 3ul] = 0ul;
        output[count_cell] = IG_SEGMENTED_UNIT_QUANTIFIER_INTEGER;
        output[count_cell + 1ul] = args.row_count;
        output[count_cell + 2ul] = 0ul;
        output[count_cell + 3ul] = 0ul;
    }
    output[item_base] = 0ul;
    output[item_base + 1ul] = 0ul;
}

inline ulong ig_segmented_graph_stage_receipt_role(ulong kind) {
    if (kind == IG_SEGMENTED_GRAPH_STAGE_PROJECT) {
        return IG_SEGMENTED_GRAPH_RECEIPT_PROJECT;
    }
    if (kind == IG_SEGMENTED_GRAPH_STAGE_ORDER) return IG_SEGMENTED_GRAPH_RECEIPT_ORDER;
    if (kind == IG_SEGMENTED_GRAPH_STAGE_SKIP) return IG_SEGMENTED_GRAPH_RECEIPT_SKIP;
    if (kind == IG_SEGMENTED_GRAPH_STAGE_LIMIT) return IG_SEGMENTED_GRAPH_RECEIPT_LIMIT;
    if (kind == IG_SEGMENTED_GRAPH_STAGE_FILTER) return IG_SEGMENTED_GRAPH_RECEIPT_FILTER;
    return ~0ul;
}

inline ulong ig_segmented_unit_kind(device const ulong* program) {
    return program[29] >> IG_SEGMENTED_UNIT_DISCRIMINATOR_SHIFT;
}

inline ulong ig_segmented_unit_maximum_list_items(device const ulong* program) {
    return ulong(uint(program[29]));
}

inline ulong ig_segmented_unit_inner_stage_count(device const ulong* program) {
    return ulong(uint(program[30]));
}

inline bool ig_segmented_unit_integer_list_order(device const ulong* program) {
    return ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
        && program[4] == 2ul;
}

inline ulong ig_segmented_graph_pre_stage_count(device const ulong* program) {
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER) {
        return ig_segmented_unit_inner_stage_count(program)
            + (ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
                ? 1ul : 0ul);
    }
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS) return 2ul;
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE) return 1ul;
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH) return 6ul;
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_GRAPH
            && program[54] != 0ul
            && program[55] == IG_SEGMENTED_GRAPH_PRE_ORDER_HEADER_WORDS
            && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC) return 1ul;
    return 0ul;
}

inline ulong ig_segmented_unit_pre_receipt_role(
    device const ulong* program,
    ulong receipt) {
    if (ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_INDEXED_COUNT) {
        return receipt == 1ul
            ? IG_SEGMENTED_GRAPH_RECEIPT_PRE_PROJECT
            : IG_SEGMENTED_GRAPH_RECEIPT_PRE_UNWIND;
    }
    if (ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY) {
        if (receipt == 1ul || receipt == 2ul || receipt == 4ul) {
            return IG_SEGMENTED_GRAPH_RECEIPT_PRE_PROJECT;
        }
        if (receipt == 3ul) return IG_SEGMENTED_GRAPH_RECEIPT_PRE_UNWIND;
        if (receipt == 5ul) return IG_SEGMENTED_GRAPH_RECEIPT_PRE_ORDER;
    }
    return ~0ul;
}

inline ulong ig_segmented_property_keys_base(device const ulong* program) {
    return program[51] + (program[6] + 1ul) * 2ul;
}

inline ulong ig_segmented_property_value_base(device const ulong* program) {
    return program[51] + (program[6] + 1ul) * 2ul;
}

inline uchar ig_segmented_program_byte(device const ulong* program, ulong byte_offset) {
    ulong word = program[byte_offset >> 3ul];
    return uchar((word >> ((byte_offset & 7ul) * 8ul)) & 0xfful);
}

