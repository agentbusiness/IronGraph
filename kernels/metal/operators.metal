    constant TemporalRegisterStepArgs& constant_args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (row != 0u) return;
    ig_temporal_register_clear(output, constant_args.register_stride);
    if (constant_args.input_tag == 0u) { output[0] = 0u; return; }
    if (constant_args.input_tag == 9u) {
        TemporalRegisterStepArgs args = constant_args;
        if (!ig_temporal_register_to_string(bytes, registers, args, output)) {
            ig_temporal_register_clear(output, args.register_stride);
        }
        return;
    }
    if (constant_args.input_tag == 8u) {
        TemporalRegisterStepArgs args = constant_args;
        ig_temporal_register_comparison_step(bytes, registers, args, output);
        return;
    }
    if (constant_args.input_tag == 2u) return;
    TemporalRegisterStepArgs args = constant_args;
    ig_temporal_register_datetime_step(bytes, registers, args, output);
}

kernel void ig_temporal_register_duration_program(
    device const uchar* bytes [[buffer(0)]],
    device const uint* registers [[buffer(1)]],
    device uint* output [[buffer(2)]],
    constant TemporalRegisterStepArgs& constant_args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (row != 0u) return;
    ig_temporal_register_clear(output, constant_args.register_stride);
    if (constant_args.input_tag == 0u) { output[0] = 0u; return; }
    if (constant_args.input_tag == 9u) {
        TemporalRegisterStepArgs args = constant_args;
        if (!ig_temporal_register_to_string(bytes, registers, args, output)) {
            ig_temporal_register_clear(output, args.register_stride);
        }
        return;
    }
    if (constant_args.input_tag == 8u) {
        TemporalRegisterStepArgs args = constant_args;
        ig_temporal_register_comparison_step(bytes, registers, args, output);
        return;
    }
    if (constant_args.input_tag == 2u) return;
    TemporalRegisterStepArgs args = constant_args;
    ig_temporal_register_duration_step(bytes, registers, args, output);
}

#endif // IG_INCLUDE_TEMPORAL_REGISTER_KERNELS

#if IG_INCLUDE_TEMPORAL_ARITHMETIC_KERNELS

// Complete relation-aware temporal arithmetic command. All six kernels are submitted through one
// command encoder, share private scan/relation/register buffers, and publish only after the final
// stage seals the device-authored completion. Runtime dimensions are bounded to u32 before any
// product is formed; no helper in this section performs variable-variable 64-bit division.
struct TemporalArithmeticArgs {
    ulong program_words;
    ulong graph_words;
    ulong output_words;
    ulong node_count;
    ulong maximum_rows;
    ulong register_count;
    ulong output_count;
    ulong scan_count;
    ulong source_count;
    ulong instruction_count;
    ulong obligation_count;
    ulong label_lane_count;
    ulong duration_lane_count;
    ulong graph_node_active_base;
    ulong graph_node_layer_base;
    ulong graph_label_base;
    ulong graph_duration_month_base;
    ulong graph_duration_day_base;
    ulong graph_duration_second_base;
    ulong graph_duration_nanos_base;
    ulong graph_duration_validity_base;
    ulong output_receipt_base;
    ulong output_value_base;
    ulong output_validity_base;
    ulong scratch_bytes;
    ulong step_index;
};

constant ulong IG_TA_PROGRAM_MAGIC = 0x4947544152505247ul;
constant ulong IG_TA_OUTPUT_MAGIC = 0x49475441524f5554ul;
constant ulong IG_TA_VERSION = 1ul;
constant ulong IG_TA_PROGRAM_HEADER_WORDS = 48ul;
constant ulong IG_TA_SCAN_WORDS = 4ul;
constant ulong IG_TA_SOURCE_WORDS = 10ul;
constant ulong IG_TA_INSTRUCTION_WORDS = 10ul;
constant ulong IG_TA_OUTPUT_DESCRIPTOR_WORDS = 2ul;
constant ulong IG_TA_OBLIGATION_WORDS = 4ul;
constant ulong IG_TA_PROPERTY_WORDS = 2ul;
constant ulong IG_TA_OUTPUT_HEADER_WORDS = 40ul;
constant ulong IG_TA_RECEIPT_WORDS = 9ul;
constant ulong IG_TA_CELL_WORDS = 4ul;
constant ulong IG_TA_SEAL = 0x5345414c45445441ul;
constant ulong IG_TA_U32_MAX = 0xfffffffful;
constant ulong IG_TA_NO_OBLIGATION = 0xfffffffffffffffful;
constant long IG_TA_NANOS_PER_SECOND = 1000000000L;
constant long IG_TA_SECONDS_PER_DAY = 86400L;
constant long IG_TA_NANOS_PER_DAY = 86400000000000L;

inline bool ig_ta_range(ulong base, ulong count, ulong limit) {
    return base <= limit && count <= limit - base;
}

inline ulong ig_ta_program_word(device const ulong* program, ulong index) {
    return program[index];
}

inline ulong ig_ta_graph_word(device const long* graph, ulong index) {
    return as_type<ulong>(graph[index]);
}

inline long ig_ta_read_long(device const uint* record, uint offset) {
    return as_type<long>(
        ulong(record[offset]) | (ulong(record[offset + 1u]) << 32));
}

inline void ig_ta_write_long(device uint* record, uint offset, long value) {
    ulong bits = as_type<ulong>(value);
    record[offset] = uint(bits);
    record[offset + 1u] = uint(bits >> 32);
}

inline void ig_ta_clear_record(device uint* record) {
    for (uint word = 0u; word < 8u; ++word) record[word] = 0u;
}

inline bool ig_ta_add_long(long left, long right, thread long& result) {
    if ((right > 0L && left > IG_TEMPORAL_LONG_MAX - right)
            || (right < 0L && left < IG_TEMPORAL_LONG_MIN - right)) return false;
    result = left + right;
    return true;
}

inline bool ig_ta_negate_long(long value, thread long& result) {
    if (value == IG_TEMPORAL_LONG_MIN) return false;
    result = -value;
    return true;
}

// Division-free signed 64-bit multiplication. Four 32x32 products reconstruct the unsigned
// magnitude and expose every high bit before the signed range is applied.
inline bool ig_ta_multiply_magnitudes(
    ulong left,
    ulong right,
    thread ulong& low,
    thread ulong& high) {
    ulong left_low = ulong(uint(left));
    ulong left_high = left >> 32;
    ulong right_low = ulong(uint(right));
    ulong right_high = right >> 32;
    ulong p0 = left_low * right_low;
    ulong p1 = left_low * right_high;
    ulong p2 = left_high * right_low;
    ulong p3 = left_high * right_high;
    ulong add1 = p1 << 32;
    low = p0 + add1;
    ulong carry1 = low < p0 ? 1ul : 0ul;
    ulong add2 = p2 << 32;
    ulong prior = low;
    low += add2;
    ulong carry2 = low < prior ? 1ul : 0ul;
    high = p3 + (p1 >> 32) + (p2 >> 32) + carry1 + carry2;
    return true;
}

inline ulong ig_ta_magnitude(long value) {
    return value < 0L ? ulong(-(value + 1L)) + 1ul : ulong(value);
}

inline bool ig_ta_multiply_long(long left, long right, thread long& result) {
    bool negative = (left < 0L) != (right < 0L);
    ulong low = 0ul;
    ulong high = 0ul;
    ig_ta_multiply_magnitudes(ig_ta_magnitude(left), ig_ta_magnitude(right), low, high);
    ulong limit = negative ? 0x8000000000000000ul : 0x7ffffffffffffffful;
    if (high != 0ul || low > limit) return false;
    if (negative) {
        result = low == 0x8000000000000000ul
            ? IG_TEMPORAL_LONG_MIN
            : -long(low);
    } else {
        result = long(low);
    }
    return true;
}

__attribute__((noinline)) bool ig_ta_normalize_duration(
    long months,
    long days,
    long seconds,
    long nanos,
    device uint* output) {
    long carry = nanos / IG_TA_NANOS_PER_SECOND;
    long remainder = nanos % IG_TA_NANOS_PER_SECOND;
    if (!ig_ta_add_long(seconds, carry, seconds)) return false;
    if (remainder < 0L) {
        if (!ig_ta_add_long(seconds, -1L, seconds)) return false;
        remainder += IG_TA_NANOS_PER_SECOND;
    }
    output[0] = 6u;
    ig_ta_write_long(output, 1u, months);
    ig_ta_write_long(output, 3u, days);
    ig_ta_write_long(output, 5u, seconds);
    output[7] = uint(remainder);
    return true;
}

inline void ig_ta_record_semantic_error(
    device ulong* output,
    ulong code,
    ulong obligation) {
    if (output[33ul] == 0ul) {
        output[33ul] = code;
        output[34ul] = obligation;
    }
}

inline void ig_ta_record_device_error(device ulong* output, ulong code) {
    if (output[2ul] == 0ul) output[2ul] = code;
}

inline void ig_ta_receipt_cardinality(
    device ulong* output,
    constant TemporalArithmeticArgs& args,
    ulong receipt,
    ulong input_rows,
    ulong output_rows) {
    if (receipt >= args.obligation_count) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong base = args.output_receipt_base + receipt * IG_TA_RECEIPT_WORDS;
    output[base + 6ul] = input_rows;
    output[base + 7ul] = output_rows;
}

inline bool ig_ta_literal_record(
    device const ulong* program,
    ulong descriptor,
    constant TemporalArithmeticArgs& args,
    uint source_class,
    device uint* record) {
    ig_ta_clear_record(record);
    uint expected_function = source_class == 7u ? 4u : source_class;
    uint function = uint(program[descriptor + 1ul]);
    uint input_tag = uint(program[descriptor + 2ul]);
    ulong payload_start_word = program[descriptor + 3ul];
    ulong payload_length_word = program[descriptor + 4ul];
    if (source_class > 7u || expected_function > 5u
            || function != expected_function || input_tag > 7u
            || payload_start_word > IG_TA_U32_MAX
            || payload_length_word > IG_TA_U32_MAX
            || payload_start_word > args.program_words * 8ul
            || payload_length_word > args.program_words * 8ul - payload_start_word) {
        return false;
    }
    if (input_tag == 0u) return true;
    if (input_tag == 2u || input_tag == 4u || input_tag == 5u || input_tag == 6u) {
        record[0] = 7u;
        return true;
    }
    device const uchar* bytes = reinterpret_cast<device const uchar*>(program);
    uint payload_start = uint(payload_start_word);
    uint payload_length = uint(payload_length_word);
    ulong zone_start_word = program[38ul];
    ulong zone_end_word = program[39ul];
    if (zone_start_word < payload_start_word || zone_end_word < zone_start_word
            || zone_end_word > args.program_words * 8ul
            || zone_start_word - payload_start_word > IG_TA_U32_MAX
            || zone_end_word - payload_start_word > IG_TA_U32_MAX
            || program[40ul] > IG_TA_U32_MAX) return false;
    TemporalRegisterStepArgs temporal_args;
    temporal_args.function = expected_function;
    temporal_args.input_tag = input_tag;
    temporal_args.payload_end = payload_length;
    temporal_args.zone_table_start = uint(zone_start_word - payload_start_word);
    temporal_args.zone_table_end = uint(zone_end_word - payload_start_word);
    temporal_args.zone_count = uint(program[40ul]);
    temporal_args.register_count = uint(args.register_count);
    temporal_args.source_register = 0u;
    temporal_args.right_register = 0u;
    temporal_args.temporal_operation = 0u;
    ulong current_bits = program[descriptor + 5ul];
    temporal_args.current_seconds_low = uint(current_bits);
    temporal_args.current_seconds_high = uint(current_bits >> 32);
    temporal_args.current_nanos = uint(program[descriptor + 6ul]);
    temporal_args.register_stride = 8u;
    temporal_args.string_capacity = 0u;
    device const uchar* payload = bytes + payload_start;
    if (input_tag == 7u && temporal_args.current_nanos >= 1000000000u) return false;
    bool success = false;
    if (expected_function == 0u) success = ig_temporal_register_date_step(
        payload, record, temporal_args, record);
    else if (expected_function == 1u) success = ig_temporal_register_local_time_step(
        payload, record, temporal_args, record);
    else if (expected_function == 2u) success = ig_temporal_register_time_step(
        payload, record, temporal_args, record);
    else if (expected_function == 3u) success = ig_temporal_register_local_datetime_step(
        payload, record, temporal_args, record);
    else if (source_class == 7u) success = ig_temporal_register_datetime_fixed_map_step(
        payload, record, temporal_args, record);
    else if (expected_function == 4u) success = ig_temporal_register_datetime_step(
        payload, record, temporal_args, record);
    else success = ig_temporal_register_duration_step(
        payload, record, temporal_args, record);
    if (!success) record[0] = 7u;
    return true;
}

inline bool ig_ta_advance(
    thread ulong& cursor,
    ulong count,
    ulong limit) {
    if (!ig_ta_range(cursor, count, limit)) return false;
    cursor += count;
    return true;
}

__attribute__((noinline)) bool ig_ta_packet_layout_valid(
    device const ulong* program,
    constant TemporalArithmeticArgs& args) {
    if (args.program_words > IG_TA_U32_MAX
            || args.graph_words > IG_TA_U32_MAX
            || args.output_words > IG_TA_U32_MAX
            || args.node_count > IG_TA_U32_MAX
            || args.maximum_rows == 0ul
            || args.maximum_rows > IG_TA_U32_MAX
            || args.register_count == 0ul
            || args.register_count > IG_TA_U32_MAX
            || args.output_count == 0ul
            || args.output_count > IG_TA_U32_MAX
            || args.scan_count > 2ul
            || args.source_count == 0ul
            || args.source_count > IG_TA_U32_MAX
            || args.instruction_count == 0ul
            || args.instruction_count > IG_TA_U32_MAX
            || args.obligation_count == 0ul
            || args.obligation_count > IG_TA_U32_MAX
            || args.label_lane_count > IG_TA_U32_MAX
            || args.duration_lane_count > IG_TA_U32_MAX
            || args.program_words < IG_TA_PROGRAM_HEADER_WORDS) return false;

    if (program[0ul] != IG_TA_PROGRAM_MAGIC
            || program[1ul] != IG_TA_VERSION
            || (program[2ul] == 0ul && program[3ul] == 0ul)
            || program[18ul] == 0ul
            || (program[18ul] & ~3ul) != 0ul
            || program[19ul] != args.node_count
            || program[20ul] != args.maximum_rows
            || program[21ul] != args.register_count
            || program[22ul] != args.output_count
            || program[23ul] != args.scan_count
            || program[24ul] != args.source_count
            || program[25ul] != args.instruction_count
            || program[26ul] != args.obligation_count
            || program[27ul] != args.label_lane_count
            || program[28ul] != args.duration_lane_count
            || program[41ul] != args.scratch_bytes
            || program[42ul] != args.program_words
            || program[44ul] != IG_TA_PROGRAM_HEADER_WORDS
            || program[45ul] != IG_TA_SEAL
            || program[46ul] != 0ul
            || program[47ul] != 0ul
            || args.register_count != args.source_count + args.instruction_count) return false;

    ulong expected_obligations = args.scan_count
        + (args.scan_count == 2ul ? 1ul : 0ul)
        + args.source_count
        + args.instruction_count
        + 1ul;
    if (expected_obligations != args.obligation_count) return false;

    ulong cursor = IG_TA_PROGRAM_HEADER_WORDS;
    if (program[29ul] != cursor
            || !ig_ta_advance(cursor, args.scan_count * IG_TA_SCAN_WORDS, args.program_words)
            || program[30ul] != cursor
            || !ig_ta_advance(cursor, args.source_count * IG_TA_SOURCE_WORDS, args.program_words)
            || program[31ul] != cursor
            || !ig_ta_advance(
                cursor,
                args.instruction_count * IG_TA_INSTRUCTION_WORDS,
                args.program_words)
            || program[32ul] != cursor
            || !ig_ta_advance(
                cursor,
                args.output_count * IG_TA_OUTPUT_DESCRIPTOR_WORDS,
                args.program_words)
            || program[33ul] != cursor
            || !ig_ta_advance(
                cursor,
                args.obligation_count * IG_TA_OBLIGATION_WORDS,
                args.program_words)
            || program[34ul] != cursor
            || program[43ul] > IG_TA_U32_MAX
            || !ig_ta_advance(cursor, program[43ul], args.program_words)
            || program[35ul] != cursor
            || !ig_ta_advance(
                cursor,
                args.duration_lane_count * IG_TA_PROPERTY_WORDS,
                args.program_words)
            || program[36ul] != cursor) return false;

    ulong raw_bytes = program[37ul];
    if (raw_bytes > IG_TA_U32_MAX
            || cursor > IG_TA_U32_MAX / 8ul
            || program[38ul] < cursor * 8ul
            || program[39ul] < program[38ul]
            || program[39ul] != cursor * 8ul + raw_bytes
            || program[40ul] > IG_TA_U32_MAX) return false;
    ulong padded_raw_words = (raw_bytes + 7ul) / 8ul;
    if (!ig_ta_advance(cursor, padded_raw_words, args.program_words)
            || cursor != args.program_words) return false;

    cursor = 0ul;
    if (args.graph_node_active_base != cursor
            || !ig_ta_advance(cursor, args.node_count, args.graph_words)
            || args.graph_node_layer_base != cursor
            || !ig_ta_advance(cursor, args.node_count, args.graph_words)
            || args.graph_label_base != cursor) return false;
    for (ulong lane = 0ul; lane < args.label_lane_count; ++lane) {
        if (!ig_ta_advance(cursor, args.node_count, args.graph_words)) return false;
    }
    if (args.graph_duration_month_base != cursor) return false;
    for (ulong lane = 0ul; lane < args.duration_lane_count; ++lane) {
        if (!ig_ta_advance(cursor, args.node_count, args.graph_words)) return false;
    }
    if (args.graph_duration_day_base != cursor) return false;
    for (ulong lane = 0ul; lane < args.duration_lane_count; ++lane) {
        if (!ig_ta_advance(cursor, args.node_count, args.graph_words)) return false;
    }
    if (args.graph_duration_second_base != cursor) return false;
    for (ulong lane = 0ul; lane < args.duration_lane_count; ++lane) {
        if (!ig_ta_advance(cursor, args.node_count, args.graph_words)) return false;
    }
    if (args.graph_duration_nanos_base != cursor) return false;
    for (ulong lane = 0ul; lane < args.duration_lane_count; ++lane) {
        if (!ig_ta_advance(cursor, args.node_count, args.graph_words)) return false;
    }
    if (args.graph_duration_validity_base != cursor) return false;
    for (ulong lane = 0ul; lane < args.duration_lane_count; ++lane) {
        if (!ig_ta_advance(cursor, args.node_count, args.graph_words)) return false;
    }
    if (cursor != args.graph_words) return false;

    if (args.output_receipt_base != IG_TA_OUTPUT_HEADER_WORDS) return false;
    cursor = args.output_receipt_base;
    if (!ig_ta_advance(
            cursor,
            args.obligation_count * IG_TA_RECEIPT_WORDS,
            args.output_words)
            || args.output_value_base != cursor) return false;
    ulong cells = args.maximum_rows * args.output_count;
    if (!ig_ta_advance(cursor, cells * IG_TA_CELL_WORDS, args.output_words)
            || args.output_validity_base != cursor
            || !ig_ta_advance(cursor, cells, args.output_words)
            || cursor != args.output_words) return false;
    return true;
}

kernel void ig_temporal_arithmetic_initialize(
    device const long* graph [[buffer(0)]],
    device const ulong* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    device uint* scans [[buffer(3)]],
    device uint* relation [[buffer(4)]],
    device uint* registers [[buffer(5)]],
    constant TemporalArithmeticArgs& args [[buffer(6)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    if (thread_index != 0u) return;
    for (ulong word = 0ul; word < args.output_words; ++word) output[word] = 0ul;
    ulong scan_words = args.node_count * max(args.scan_count, 1ul);
    ulong relation_words = args.maximum_rows * max(args.scan_count, 1ul);
    ulong register_words = args.maximum_rows * args.register_count * 8ul;
    for (ulong word = 0ul; word < scan_words; ++word) scans[word] = 0u;
    for (ulong word = 0ul; word < relation_words; ++word) relation[word] = 0u;
    for (ulong word = 0ul; word < register_words; ++word) registers[word] = 0u;
    if (!ig_ta_packet_layout_valid(program, args)) {
        output[2ul] = 1ul;
        return;
    }

    output[0ul] = IG_TA_OUTPUT_MAGIC;
    output[1ul] = IG_TA_VERSION;
    output[2ul] = 0ul;
    output[3ul] = 2ul;
    output[4ul] = program[2ul];
    output[5ul] = program[3ul];
    output[6ul] = program[4ul];
    output[7ul] = program[5ul];
    output[8ul] = program[6ul];
    output[9ul] = program[7ul];
    output[10ul] = program[8ul];
    output[11ul] = program[9ul];
    for (ulong word = 0ul; word < 4ul; ++word) {
        output[12ul + word] = program[10ul + word];
        output[16ul + word] = program[14ul + word];
    }
    output[20ul] = 0ul;
    output[21ul] = args.scan_count;
    output[22ul] = args.source_count;
    output[23ul] = args.instruction_count;
    output[24ul] = args.output_count;
    output[25ul] = args.obligation_count;
    output[26ul] = args.node_count;
    output[27ul] = args.maximum_rows;
    output[28ul] = args.register_count;
    output[29ul] = args.program_words;
    output[30ul] = args.graph_words;
    output[31ul] = args.output_words;
    output[32ul] = args.scratch_bytes;
    output[33ul] = 0ul;
    output[34ul] = IG_TA_NO_OBLIGATION;
    output[35ul] = 0ul;

    ulong obligation_base = program[33ul];
    for (ulong receipt = 0ul; receipt < args.obligation_count; ++receipt) {
        ulong source = obligation_base + receipt * IG_TA_OBLIGATION_WORDS;
        ulong target = args.output_receipt_base + receipt * IG_TA_RECEIPT_WORDS;
        if (program[source] == 0ul) {
            ig_ta_record_device_error(output, 1ul);
            continue;
        }
        output[target] = program[2ul];
        output[target + 1ul] = program[3ul];
        output[target + 2ul] = program[source];
        output[target + 3ul] = program[source + 1ul];
        output[target + 4ul] = program[source + 2ul];
        output[target + 5ul] = program[source + 3ul];
        output[target + 6ul] = 0ul;
        output[target + 7ul] = 0ul;
        output[target + 8ul] = 2ul;
    }
}

kernel void ig_temporal_arithmetic_scan(
    device const long* graph [[buffer(0)]],
    device const ulong* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    device uint* scans [[buffer(3)]],
    device uint* relation [[buffer(4)]],
    device uint* registers [[buffer(5)]],
    constant TemporalArithmeticArgs& args [[buffer(6)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)relation;
    (void)registers;
    if (thread_index != 0u || output[2ul] != 0ul) return;
    ulong scan_index = args.step_index;
    if (scan_index >= args.scan_count) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong descriptor = program[29ul] + scan_index * IG_TA_SCAN_WORDS;
    ulong label_start = program[descriptor];
    ulong label_count = program[descriptor + 1ul];
    ulong label_reference_end = program[34ul] + program[43ul];
    if (program[descriptor + 2ul] != scan_index
            || program[descriptor + 3ul] != 0ul
            || label_start < program[34ul]
            || !ig_ta_range(label_start, label_count, label_reference_end)) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    uint selected = 0u;
    uint node_count = uint(args.node_count);
    for (uint node = 0u; node < node_count; ++node) {
        ulong active = ig_ta_graph_word(graph, args.graph_node_active_base + ulong(node));
        ulong layer = ig_ta_graph_word(graph, args.graph_node_layer_base + ulong(node));
        if (active > 1ul || layer > IG_MAX_LAYER_UL) {
            ig_ta_record_device_error(output, 1ul);
            return;
        }
        bool matches = active == 1ul && (program[18ul] & (1ul << layer)) != 0ul;
        for (ulong label = 0ul; matches && label < label_count; ++label) {
            ulong lane = program[label_start + label];
            if (lane >= args.label_lane_count) {
                ig_ta_record_device_error(output, 1ul);
                return;
            }
            ulong present = ig_ta_graph_word(
                graph,
                args.graph_label_base + lane * args.node_count + ulong(node));
            if (present > 1ul) {
                ig_ta_record_device_error(output, 1ul);
                return;
            }
            matches = present == 1ul;
        }
        if (matches) {
            scans[scan_index * args.node_count + ulong(selected)] = node;
            selected += 1u;
        }
    }
    output[36ul + scan_index] = ulong(selected);
    ig_ta_receipt_cardinality(
        output,
        args,
        scan_index,
        args.node_count,
        ulong(selected));
}

kernel void ig_temporal_arithmetic_relation(
    device const long* graph [[buffer(0)]],
    device const ulong* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    device uint* scans [[buffer(3)]],
    device uint* relation [[buffer(4)]],
    device uint* registers [[buffer(5)]],
    constant TemporalArithmeticArgs& args [[buffer(6)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    (void)program;
    (void)registers;
    if (thread_index != 0u || output[2ul] != 0ul) return;
    if (args.scan_count == 0ul) {
        output[20ul] = 1ul;
        return;
    }
    ulong left_count = output[36ul];
    if (left_count > args.node_count) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    if (args.scan_count == 1ul) {
        if (left_count > args.maximum_rows) {
            ig_ta_record_device_error(output, 2ul);
            return;
        }
        for (ulong row = 0ul; row < left_count; ++row) relation[row] = scans[row];
        output[20ul] = left_count;
        return;
    }
    ulong right_count = output[37ul];
    if (right_count > args.node_count) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong row_count = left_count * right_count;
    if (row_count > args.maximum_rows) {
        ig_ta_record_device_error(output, 2ul);
        return;
    }
    ulong row = 0ul;
    for (ulong left = 0ul; left < left_count; ++left) {
        uint left_node = scans[left];
        for (ulong right = 0ul; right < right_count; ++right) {
            relation[row * 2ul] = left_node;
            relation[row * 2ul + 1ul] = scans[args.node_count + right];
            row += 1ul;
        }
    }
    output[20ul] = row_count;
    ig_ta_receipt_cardinality(
        output,
        args,
        2ul,
        left_count + right_count,
        row_count);
}

inline bool ig_ta_zero_tail(
    device const uint* record,
    uint first_word) {
    for (uint word = first_word; word < 8u; ++word) {
        if (record[word] != 0u) return false;
    }
    return true;
}

__attribute__((noinline)) bool ig_ta_canonical_record(
    device const uint* record,
    device const ulong* program,
    uint expected_type,
    constant TemporalArithmeticArgs& args) {
    uint tag = record[0];
    if (tag == 0u) return ig_ta_zero_tail(record, 1u);
    if (tag == 7u) return true;
    if (tag == 1u) {
        return expected_type == 1u && ig_ta_zero_tail(record, 3u);
    }
    if (tag == 2u) {
        long nanos = ig_ta_read_long(record, 1u);
        return expected_type == 2u
            && nanos >= 0L
            && nanos < IG_TA_NANOS_PER_DAY
            && ig_ta_zero_tail(record, 3u);
    }
    if (tag == 3u) {
        long nanos = ig_ta_read_long(record, 1u);
        int offset = as_type<int>(record[3u]);
        return expected_type == 3u
            && nanos >= 0L
            && nanos < IG_TA_NANOS_PER_DAY
            && offset >= -86399
            && offset <= 86399
            && ig_ta_zero_tail(record, 4u);
    }
    if (tag == 4u) {
        return expected_type == 4u
            && record[3u] < 1000000000u
            && ig_ta_zero_tail(record, 4u);
    }
    if (tag == 5u) {
        int offset = as_type<int>(record[4u]);
        return expected_type == 5u
            && record[3u] < 1000000000u
            && offset >= -86399
            && offset <= 86399
            && ig_ta_zero_tail(record, 5u);
    }
    if (tag == 8u) {
        return expected_type == 5u
            && record[3u] < 1000000000u
            && ulong(record[4u]) < program[40ul]
            && ig_ta_zero_tail(record, 5u);
    }
    if (tag == 6u) {
        return expected_type == 6u && record[7u] < 1000000000u;
    }
    if (tag == 9u) {
        return expected_type == 7u && ig_ta_zero_tail(record, 3u);
    }
    return false;
}

inline bool ig_ta_literal_type_matches(uint function, uint tag) {
    if (tag == 0u || tag == 7u) return true;
    if (function == 4u) return tag == 5u || tag == 8u;
    return tag == function + 1u;
}

inline void ig_temporal_arithmetic_source_step(
    device const long* graph,
    device const ulong* program,
    device ulong* output,
    device uint* scans,
    device uint* relation,
    device uint* registers,
    constant TemporalArithmeticArgs& args,
    uint thread_index,
    uint source_class) {
    (void)scans;
    if (thread_index != 0u || output[2ul] != 0ul) return;
    ulong source_index = args.step_index;
    if (source_index >= args.source_count) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong descriptor = program[30ul] + source_index * IG_TA_SOURCE_WORDS;
    ulong source_kind = program[descriptor];
    ulong receipt = program[descriptor + 7ul];
    ulong expected_receipt = args.scan_count
        + (args.scan_count == 2ul ? 1ul : 0ul)
        + source_index;
    if (receipt != expected_receipt
            || program[descriptor + 8ul] != 0ul
            || program[descriptor + 9ul] != 0ul) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong row_count = output[20ul];
    if (row_count > args.maximum_rows) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong register_base = source_index * args.maximum_rows * 8ul;
    device uint* first = registers + register_base;
    ulong valid = 0ul;
    if (source_kind == 1ul) {
        uint function = uint(program[descriptor + 1ul]);
        uint expected_function = source_class == 7u ? 4u : source_class;
        if (source_class == 6u
                || source_class > 7u
                || function != expected_function
                || program[descriptor + 2ul] > 7ul
                || program[descriptor + 5ul] != 0ul && program[descriptor + 2ul] != 7ul
                || program[descriptor + 6ul] != 0ul && program[descriptor + 2ul] != 7ul
                || !ig_ta_literal_record(program, descriptor, args, source_class, first)
                || !ig_ta_literal_type_matches(function, first[0])) {
            ig_ta_record_device_error(output, 1ul);
            return;
        }
        if (first[0] == 6u
                && !ig_ta_normalize_duration(
                    ig_ta_read_long(first, 1u),
                    ig_ta_read_long(first, 3u),
                    ig_ta_read_long(first, 5u),
                    long(as_type<int>(first[7u])),
                    first)) {
            ig_ta_clear_record(first);
            first[0] = 7u;
            ig_ta_record_semantic_error(output, 2ul, receipt);
        }
        if (first[0] == 7u) {
            ig_ta_record_semantic_error(output, 1ul, receipt);
        } else if (!ig_ta_canonical_record(first, program, function + 1u, args)) {
            ig_ta_record_device_error(output, 1ul);
            return;
        }
        for (ulong row = 1ul; row < row_count; ++row) {
            device uint* target = registers + register_base + row * 8ul;
            for (uint word = 0u; word < 8u; ++word) target[word] = first[word];
        }
        valid = first[0] != 0u && first[0] != 7u ? row_count : 0ul;
    } else if (source_kind == 2ul) {
        if (source_class != 6u
                || program[descriptor + 1ul] != 5ul
                || program[descriptor + 2ul] != 0ul
                || program[descriptor + 3ul] != 0ul
                || program[descriptor + 4ul] != 0ul
                || program[descriptor + 5ul] >= args.scan_count
                || program[descriptor + 6ul] != IG_TA_NO_OBLIGATION
                    && program[descriptor + 6ul] >= args.duration_lane_count) {
            ig_ta_record_device_error(output, 1ul);
            return;
        }
        ulong scan = program[descriptor + 5ul];
        ulong lane = program[descriptor + 6ul];
        ulong property_kind = 0ul;
        if (lane != IG_TA_NO_OBLIGATION) {
            ulong property_descriptor = program[35ul] + lane * IG_TA_PROPERTY_WORDS;
            property_kind = program[property_descriptor];
            if (property_kind > 2ul) {
                ig_ta_record_device_error(output, 1ul);
                return;
            }
        }
        if (property_kind == 2ul && row_count != 0ul) {
            ig_ta_record_semantic_error(output, 1ul, receipt);
        }
        for (ulong row = 0ul; row < row_count; ++row) {
            device uint* target = registers + register_base + row * 8ul;
            ig_ta_clear_record(target);
            if (property_kind == 2ul) {
                target[0] = 7u;
                continue;
            }
            if (property_kind == 0ul) continue;
            ulong binding = relation[row * args.scan_count + scan];
            if (binding >= args.node_count) {
                ig_ta_record_device_error(output, 1ul);
                return;
            }
            ulong lane_base = lane * args.node_count + binding;
            long months = graph[args.graph_duration_month_base + lane_base];
            long days = graph[args.graph_duration_day_base + lane_base];
            long seconds = graph[args.graph_duration_second_base + lane_base];
            long nanos = graph[args.graph_duration_nanos_base + lane_base];
            ulong validity = ig_ta_graph_word(
                graph,
                args.graph_duration_validity_base + lane_base);
            if (validity > 1ul
                    || nanos < 0L
                    || nanos >= IG_TA_NANOS_PER_SECOND
                    || (validity == 0ul
                        && (months != 0L || days != 0L || seconds != 0L || nanos != 0L))) {
                ig_ta_record_device_error(output, 1ul);
                return;
            }
            if (validity == 0ul) continue;
            target[0] = 6u;
            ig_ta_write_long(target, 1u, months);
            ig_ta_write_long(target, 3u, days);
            ig_ta_write_long(target, 5u, seconds);
            target[7u] = uint(nanos);
            valid += 1ul;
        }
    } else {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ig_ta_receipt_cardinality(output, args, receipt, row_count, valid);
}

#define IG_TA_SOURCE_KERNEL(NAME, SOURCE_CLASS)                                      \
kernel void NAME(                                                                    \
    device const long* graph [[buffer(0)]],                                           \
    device const ulong* program [[buffer(1)]],                                        \
    device ulong* output [[buffer(2)]],                                               \
    device uint* scans [[buffer(3)]],                                                 \
    device uint* relation [[buffer(4)]],                                              \
    device uint* registers [[buffer(5)]],                                             \
    constant TemporalArithmeticArgs& args [[buffer(6)]],                              \
    uint thread_index [[thread_position_in_grid]]) {                                  \
    ig_temporal_arithmetic_source_step(                                               \
        graph, program, output, scans, relation, registers, args, thread_index,       \
        SOURCE_CLASS);                                                                \
}

IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_date, 0u)
IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_local_time, 1u)
IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_time, 2u)
IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_local_datetime, 3u)
IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_datetime, 4u)
IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_duration, 5u)
IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_duration_property, 6u)
IG_TA_SOURCE_KERNEL(ig_temporal_arithmetic_source_datetime_fixed_map, 7u)

#undef IG_TA_SOURCE_KERNEL

inline bool ig_ta_sub_long(long left, long right, thread long& result) {
    if ((right > 0L && left < IG_TEMPORAL_LONG_MIN + right)
            || (right < 0L && left > IG_TEMPORAL_LONG_MAX + right)) return false;
    result = left - right;
    return true;
}

inline bool ig_ta_mul_add_long(
    long left,
    long multiplier,
    long addition,
    thread long& result) {
    long product = 0L;
    return ig_ta_multiply_long(left, multiplier, product)
        && ig_ta_add_long(product, addition, result);
}

inline bool ig_ta_divmod_magnitude(
    ulong numerator,
    ulong denominator,
    thread ulong& quotient,
    thread ulong& remainder) {
    if (denominator == 0ul) return false;
    quotient = 0ul;
    remainder = 0ul;
    #pragma clang loop unroll(disable)
    for (int bit = 63; bit >= 0; --bit) {
        bool carry = (remainder >> 63) != 0ul;
        remainder = (remainder << 1) | ((numerator >> uint(bit)) & 1ul);
        if (carry || remainder >= denominator) {
            remainder -= denominator;
            quotient |= 1ul << uint(bit);
        }
    }
    return true;
}

inline bool ig_ta_divmod_long(
    long numerator,
    ulong denominator,
    thread long& quotient,
    thread long& remainder) {
    ulong quotient_magnitude = 0ul;
    ulong remainder_magnitude = 0ul;
    if (!ig_ta_divmod_magnitude(
            ig_ta_magnitude(numerator),
            denominator,
            quotient_magnitude,
            remainder_magnitude)
            || !ig_temporal_map_signed_magnitude(
                quotient_magnitude,
                numerator < 0L,
                quotient)
            || !ig_temporal_map_signed_magnitude(
                remainder_magnitude,
                numerator < 0L,
                remainder)) return false;
    return true;
}

__attribute__((noinline)) bool ig_ta_duration_combine(
    device const uint* left,
    device const uint* right,
    bool subtract,
    device uint* result) {
    long months = 0L;
    long days = 0L;
    long seconds = 0L;
    long nanos = 0L;
    bool valid = subtract
        ? ig_ta_sub_long(ig_ta_read_long(left, 1u), ig_ta_read_long(right, 1u), months)
            && ig_ta_sub_long(ig_ta_read_long(left, 3u), ig_ta_read_long(right, 3u), days)
            && ig_ta_sub_long(ig_ta_read_long(left, 5u), ig_ta_read_long(right, 5u), seconds)
            && ig_ta_sub_long(long(left[7u]), long(right[7u]), nanos)
        : ig_ta_add_long(ig_ta_read_long(left, 1u), ig_ta_read_long(right, 1u), months)
            && ig_ta_add_long(ig_ta_read_long(left, 3u), ig_ta_read_long(right, 3u), days)
            && ig_ta_add_long(ig_ta_read_long(left, 5u), ig_ta_read_long(right, 5u), seconds)
            && ig_ta_add_long(long(left[7u]), long(right[7u]), nanos);
    return valid && ig_ta_normalize_duration(months, days, seconds, nanos, result);
}

__attribute__((noinline)) bool ig_ta_duration_integer_scale(
    device const uint* duration,
    long factor,
    device uint* result) {
    long months = 0L;
    long days = 0L;
    long seconds = 0L;
    long nanos = 0L;
    return ig_ta_multiply_long(ig_ta_read_long(duration, 1u), factor, months)
        && ig_ta_multiply_long(ig_ta_read_long(duration, 3u), factor, days)
        && ig_ta_multiply_long(ig_ta_read_long(duration, 5u), factor, seconds)
        && ig_ta_multiply_long(long(duration[7u]), factor, nanos)
        && ig_ta_normalize_duration(months, days, seconds, nanos, result);
}

// Exact rational cascade for duration division and negative binary powers. This follows the CPU
// approximation order (months -> average-month day fraction -> seconds -> nanoseconds) while its
// divisions use the fixed 64-step subtract/shift routine above, never AGX runtime i64 division.
__attribute__((noinline)) bool ig_ta_duration_ratio_scale(
    device const uint* duration,
    bool negative,
    ulong denominator,
    device uint* result) {
    if (denominator == 0ul || denominator > ulong(IG_TEMPORAL_LONG_MAX) / 86400ul) return false;
    long months = ig_ta_read_long(duration, 1u);
    long days = ig_ta_read_long(duration, 3u);
    long seconds = ig_ta_read_long(duration, 5u);
    long nanos = long(duration[7u]);
    if (negative
            && (!ig_ta_negate_long(months, months)
                || !ig_ta_negate_long(days, days)
                || !ig_ta_negate_long(seconds, seconds)
                || !ig_ta_negate_long(nanos, nanos))) return false;

    long month_whole = 0L;
    long month_remainder = 0L;
    if (!ig_ta_divmod_long(
            months,
            denominator,
            month_whole,
            month_remainder)) return false;

    long day_numerator = 0L;
    long month_day_numerator = 0L;
    if (!ig_ta_multiply_long(days, 86400L, day_numerator)
            || !ig_ta_multiply_long(
                month_remainder,
                IG_TEMPORAL_DURATION_MONTH_SECONDS,
                month_day_numerator)
            || !ig_ta_add_long(day_numerator, month_day_numerator, day_numerator)) return false;
    ulong day_denominator = denominator * 86400ul;
    long day_whole = 0L;
    long day_remainder = 0L;
    if (!ig_ta_divmod_long(
            day_numerator,
            day_denominator,
            day_whole,
            day_remainder)) return false;

    // `day_remainder / (denominator * 86400) * 86400` simplifies exactly to
    // `day_remainder / denominator` before the next truncation boundary.
    long second_numerator = 0L;
    if (!ig_ta_add_long(seconds, day_remainder, second_numerator)) return false;
    long second_whole = 0L;
    long second_remainder = 0L;
    if (!ig_ta_divmod_long(
            second_numerator,
            denominator,
            second_whole,
            second_remainder)) return false;

    long nano_numerator = 0L;
    long carried_nanos = 0L;
    if (!ig_ta_multiply_long(
            second_remainder,
            IG_TA_NANOS_PER_SECOND,
            carried_nanos)
            || !ig_ta_add_long(nanos, carried_nanos, nano_numerator)) return false;
    long nano_whole = 0L;
    long nano_remainder = 0L;
    if (!ig_ta_divmod_long(
            nano_numerator,
            denominator,
            nano_whole,
            nano_remainder)) return false;
    (void)nano_remainder;
    return ig_ta_normalize_duration(
        month_whole,
        day_whole,
        second_whole,
        nano_whole,
        result);
}

__attribute__((noinline)) bool ig_ta_float_power_of_two(
    ulong bits,
    thread bool& is_zero,
    thread bool& negative,
    thread int& exponent) {
    negative = (bits >> 63) != 0ul;
    uint encoded_exponent = uint((bits >> 52) & 0x7fful);
    ulong fraction = bits & 0x000ffffffffffffful;
    is_zero = encoded_exponent == 0u && fraction == 0ul;
    exponent = 0;
    if (is_zero) return true;
    if (encoded_exponent == 0x7ffu || fraction != 0ul || encoded_exponent == 0u) return false;
    exponent = int(encoded_exponent) - 1023;
    return true;
}

__attribute__((noinline)) bool ig_ta_duration_binary_scale(
    device const uint* duration,
    bool negative,
    int exponent,
    device uint* result) {
    if (exponent >= 0) {
        if (exponent > 62) return false;
        long factor = long(1ul << uint(exponent));
        if (negative && !ig_ta_negate_long(factor, factor)) return false;
        return ig_ta_duration_integer_scale(duration, factor, result);
    }
    int shift = -exponent;
    if (shift > 62) return false;
    return ig_ta_duration_ratio_scale(
        duration,
        negative,
        1ul << uint(shift),
        result);
}

inline TemporalRegisterStepArgs ig_ta_temporal_step_args(
    device const ulong* program,
    constant TemporalArithmeticArgs& args) {
    TemporalRegisterStepArgs temporal_args;
    temporal_args.function = 0u;
    temporal_args.input_tag = 0u;
    temporal_args.payload_end = 0u;
    temporal_args.zone_table_start = uint(program[38ul]);
    temporal_args.zone_table_end = uint(program[39ul]);
    temporal_args.zone_count = uint(program[40ul]);
    temporal_args.register_count = 1u;
    temporal_args.source_register = 0u;
    temporal_args.right_register = 0u;
    temporal_args.temporal_operation = 0u;
    temporal_args.current_seconds_low = 0u;
    temporal_args.current_seconds_high = 0u;
    temporal_args.current_nanos = 0u;
    temporal_args.register_stride = 8u;
    temporal_args.string_capacity = 0u;
    (void)args;
    return temporal_args;
}

inline bool ig_ta_chrono_epoch_day(long epoch_day) {
    long year = 0L;
    uint month = 0u;
    uint day = 0u;
    return ig_temporal_civil_from_days(epoch_day, year, month, day)
        && year >= -262143L
        && year <= 262142L;
}

__attribute__((noinline)) bool ig_ta_add_calendar_months(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& temporal_args,
    thread IgTemporalRegisterParts& value,
    long months) {
    if (value.has_date == 0u) return false;
    long year = 0L;
    uint month = 0u;
    uint day = 0u;
    if (!ig_temporal_civil_from_days(value.epoch_days, year, month, day)) return false;
    long total_month = 0L;
    if (!ig_ta_mul_add_long(year, 12L, long(month - 1u), total_month)
            || !ig_ta_add_long(total_month, months, total_month)) return false;
    year = ig_temporal_register_floor_div(total_month, 12L);
    if (year < -262143L || year > 262142L) return false;
    month = uint(total_month - year * 12L) + 1u;
    day = min(day, ig_temporal_days_in_month(year, month));
    value.epoch_days = ig_temporal_days_from_civil(year, month, day);
    return ig_ta_chrono_epoch_day(value.epoch_days)
        && ig_temporal_duration_refresh_instant(bytes, temporal_args, value);
}

__attribute__((noinline)) bool ig_ta_add_calendar_days(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& temporal_args,
    thread IgTemporalRegisterParts& value,
    long days) {
    if (value.has_date == 0u
            || !ig_ta_add_long(value.epoch_days, days, value.epoch_days)
            || !ig_ta_chrono_epoch_day(value.epoch_days)) return false;
    return ig_temporal_duration_refresh_instant(bytes, temporal_args, value);
}

inline bool ig_ta_signed_component(
    long value,
    bool subtract,
    thread long& result) {
    if (!subtract) {
        result = value;
        return true;
    }
    return ig_ta_negate_long(value, result);
}

__attribute__((noinline)) bool ig_ta_add_elapsed_timestamp(
    long seconds,
    uint nanos,
    long duration_seconds,
    uint duration_nanos,
    bool subtract,
    thread long& result_seconds,
    thread uint& result_nanos) {
    long nano_sum = long(nanos);
    if (subtract) {
        if (!ig_ta_sub_long(nano_sum, long(duration_nanos), nano_sum)
                || !ig_ta_sub_long(seconds, duration_seconds, result_seconds)) return false;
    } else if (!ig_ta_add_long(nano_sum, long(duration_nanos), nano_sum)
            || !ig_ta_add_long(seconds, duration_seconds, result_seconds)) return false;
    long carry = nano_sum / IG_TA_NANOS_PER_SECOND;
    long remainder = nano_sum % IG_TA_NANOS_PER_SECOND;
    if (remainder < 0L) {
        carry -= 1L;
        remainder += IG_TA_NANOS_PER_SECOND;
    }
    if (!ig_ta_add_long(result_seconds, carry, result_seconds)) return false;
    result_nanos = uint(remainder);
    long utc_day = ig_temporal_register_floor_div(result_seconds, 86400L);
    return ig_ta_chrono_epoch_day(utc_day);
}

__attribute__((noinline)) bool ig_ta_apply_duration_to_temporal(
    device const ulong* program,
    constant TemporalArithmeticArgs& args,
    device const uint* temporal,
    device const uint* duration,
    bool subtract,
    device uint* result) {
    device const uchar* bytes = reinterpret_cast<device const uchar*>(program);
    TemporalRegisterStepArgs temporal_args = ig_ta_temporal_step_args(program, args);
    IgTemporalRegisterParts parts;
    bool is_null = false;
    if (!ig_temporal_register_load_parts(
            bytes,
            temporal,
            temporal_args,
            0u,
            parts,
            is_null)
            || is_null) return false;
    long months = 0L;
    long days = 0L;
    if (!ig_ta_signed_component(ig_ta_read_long(duration, 1u), subtract, months)
            || !ig_ta_signed_component(ig_ta_read_long(duration, 3u), subtract, days)) {
        return false;
    }
    long duration_seconds = ig_ta_read_long(duration, 5u);
    uint duration_nanos = duration[7u];
    uint tag = temporal[0];
    if (tag == 1u) {
        long elapsed_days = duration_seconds / IG_TA_SECONDS_PER_DAY;
        if (!ig_ta_add_long(days, subtract ? -elapsed_days : elapsed_days, days)
                || !ig_ta_add_calendar_months(bytes, temporal_args, parts, months)
                || !ig_ta_add_calendar_days(bytes, temporal_args, parts, days)) return false;
        result[0] = 1u;
        ig_ta_write_long(result, 1u, parts.epoch_days);
        return true;
    }
    if (tag == 2u || tag == 3u) {
        long elapsed_seconds = duration_seconds % IG_TA_SECONDS_PER_DAY;
        long elapsed_nanos = elapsed_seconds * IG_TA_NANOS_PER_SECOND + long(duration_nanos);
        long clock = parts.clock_nanos;
        if (subtract) clock -= elapsed_nanos;
        else clock += elapsed_nanos;
        clock %= IG_TA_NANOS_PER_DAY;
        if (clock < 0L) clock += IG_TA_NANOS_PER_DAY;
        result[0] = tag;
        ig_ta_write_long(result, 1u, clock);
        if (tag == 3u) result[3u] = temporal[3u];
        return true;
    }
    if (tag != 4u && tag != 5u && tag != 8u) return false;
    if ((months != 0L || days != 0L)
            && (!ig_ta_add_calendar_months(bytes, temporal_args, parts, months)
                || !ig_ta_add_calendar_days(bytes, temporal_args, parts, days))) return false;
    long base_seconds = parts.has_instant != 0u
        ? parts.seconds
        : parts.epoch_days * 86400L + parts.clock_nanos / IG_TA_NANOS_PER_SECOND;
    uint base_nanos = parts.has_instant != 0u
        ? parts.nanos
        : uint(parts.clock_nanos % IG_TA_NANOS_PER_SECOND);
    long result_seconds = 0L;
    uint result_subseconds = 0u;
    if (!ig_ta_add_elapsed_timestamp(
            base_seconds,
            base_nanos,
            duration_seconds,
            duration_nanos,
            subtract,
            result_seconds,
            result_subseconds)) return false;
    if (tag == 4u) {
        result[0] = 4u;
        ig_ta_write_long(result, 1u, result_seconds);
        result[3u] = result_subseconds;
    } else {
        ig_temporal_register_write_zoned_instant(
            result_seconds,
            result_subseconds,
            parts.zone_kind,
            parts.offset_seconds,
            parts.zone_index,
            result);
    }
    return true;
}

inline uint ig_ta_record_type(device const uint* record) {
    uint tag = record[0];
    if (tag <= 7u || tag == 8u || tag == 9u) return tag;
    return 0xffffffffu;
}

inline bool ig_ta_record_shape_valid(
    device const uint* record,
    device const ulong* program,
    constant TemporalArithmeticArgs& args) {
    uint tag = record[0];
    if (tag == 7u) return true;
    uint expected = tag == 8u ? 5u : tag;
    return expected <= 7u
        && ig_ta_canonical_record(record, program, expected, args);
}

inline bool ig_ta_operand_descriptor_valid(
    ulong kind,
    ulong word,
    ulong prior_registers) {
    if (kind == 1ul) return word < prior_registers;
    if (kind == 2ul || kind == 3ul) return true;
    return kind == 4ul && word == 0ul;
}

inline bool ig_ta_numeric_integer(
    ulong kind,
    ulong word,
    device const uint* record,
    thread long& value) {
    if (kind == 2ul) {
        value = as_type<long>(word);
        return true;
    }
    if (kind == 1ul && record[0] == 9u) {
        value = ig_ta_read_long(record, 1u);
        return true;
    }
    return false;
}

inline bool ig_ta_numeric_float_bits(
    ulong kind,
    ulong word,
    thread ulong& bits) {
    if (kind != 3ul) return false;
    bits = word;
    return true;
}

inline void ig_ta_instruction_error(
    device ulong* output,
    ulong code,
    ulong receipt,
    device uint* target) {
    ig_ta_clear_record(target);
    target[0] = 7u;
    ig_ta_record_semantic_error(output, code, receipt);
}

kernel void ig_temporal_arithmetic_instruction(
    device const long* graph [[buffer(0)]],
    device const ulong* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    device uint* scans [[buffer(3)]],
    device uint* relation [[buffer(4)]],
    device uint* registers [[buffer(5)]],
    constant TemporalArithmeticArgs& args [[buffer(6)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    (void)scans;
    (void)relation;
    if (thread_index != 0u || output[2ul] != 0ul) return;
    ulong instruction_index = args.step_index;
    if (instruction_index >= args.instruction_count) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong descriptor = program[31ul] + instruction_index * IG_TA_INSTRUCTION_WORDS;
    ulong operation = program[descriptor];
    ulong left_kind = program[descriptor + 1ul];
    ulong left_word = program[descriptor + 2ul];
    ulong right_kind = program[descriptor + 3ul];
    ulong right_word = program[descriptor + 4ul];
    ulong output_type = program[descriptor + 5ul];
    ulong receipt = program[descriptor + 6ul];
    ulong prior_registers = args.source_count + instruction_index;
    ulong expected_receipt = args.scan_count
        + (args.scan_count == 2ul ? 1ul : 0ul)
        + args.source_count
        + instruction_index;
    if (operation < 1ul
            || operation > 4ul
            || output_type > 8ul
            || receipt != expected_receipt
            || program[descriptor + 7ul] != 0ul
            || program[descriptor + 8ul] != 0ul
            || program[descriptor + 9ul] != 0ul
            || !ig_ta_operand_descriptor_valid(left_kind, left_word, prior_registers)
            || !ig_ta_operand_descriptor_valid(right_kind, right_word, prior_registers)) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong row_count = output[20ul];
    if (row_count > args.maximum_rows) {
        ig_ta_record_device_error(output, 1ul);
        return;
    }
    ulong target_register = args.source_count + instruction_index;
    ulong target_base = target_register * args.maximum_rows * 8ul;
    ulong valid = 0ul;
    for (ulong row = 0ul; row < row_count; ++row) {
        device uint* target = registers + target_base + row * 8ul;
        ig_ta_clear_record(target);
        device const uint* left = target;
        device const uint* right = target;
        if (left_kind == 1ul) {
            left = registers + (left_word * args.maximum_rows + row) * 8ul;
        }
        if (right_kind == 1ul) {
            right = registers + (right_word * args.maximum_rows + row) * 8ul;
        }
        if ((left_kind == 1ul && !ig_ta_record_shape_valid(left, program, args))
                || (right_kind == 1ul && !ig_ta_record_shape_valid(right, program, args))) {
            ig_ta_record_device_error(output, 1ul);
            return;
        }
        bool left_null = left_kind == 4ul || (left_kind == 1ul && left[0] == 0u);
        bool right_null = right_kind == 4ul || (right_kind == 1ul && right[0] == 0u);
        if (left_null || right_null) continue;
        uint left_type = left_kind == 1ul
            ? ig_ta_record_type(left)
            : (left_kind == 2ul ? 9u : 10u);
        uint right_type = right_kind == 1ul
            ? ig_ta_record_type(right)
            : (right_kind == 2ul ? 9u : 10u);
        if (left_type == 7u || right_type == 7u
                || left_type == 0xffffffffu || right_type == 0xffffffffu
                || output_type == 0ul) {
            ig_ta_instruction_error(output, 1ul, receipt, target);
            continue;
        }

        bool success = false;
        bool compatible = false;
        if (operation == 1ul || operation == 2ul) {
            bool subtract = operation == 2ul;
            if (left_type == 6u && right_type == 6u) {
                compatible = true;
                success = ig_ta_duration_combine(left, right, subtract, target);
            } else if (!subtract && left_type == 6u
                    && (right_type >= 1u && right_type <= 5u || right_type == 8u)) {
                compatible = true;
                success = ig_ta_apply_duration_to_temporal(
                    program, args, right, left, false, target);
            } else if (left_type >= 1u && left_type <= 5u || left_type == 8u) {
                if (right_type == 6u) {
                    compatible = true;
                    success = ig_ta_apply_duration_to_temporal(
                        program, args, left, right, subtract, target);
                }
            }
        } else if (operation == 3ul) {
            device const uint* duration = left_type == 6u ? left : right;
            ulong numeric_kind = left_type == 6u ? right_kind : left_kind;
            ulong numeric_word = left_type == 6u ? right_word : left_word;
            device const uint* numeric_record = left_type == 6u ? right : left;
            bool has_duration = left_type == 6u || right_type == 6u;
            long integer = 0L;
            ulong float_bits = 0ul;
            if (has_duration
                    && ig_ta_numeric_integer(
                        numeric_kind,
                        numeric_word,
                        numeric_record,
                        integer)) {
                compatible = true;
                success = ig_ta_duration_integer_scale(duration, integer, target);
            } else if (has_duration
                    && ig_ta_numeric_float_bits(numeric_kind, numeric_word, float_bits)) {
                compatible = true;
                bool is_zero = false;
                bool negative = false;
                int exponent = 0;
                if (ig_ta_float_power_of_two(
                        float_bits,
                        is_zero,
                        negative,
                        exponent)) {
                    success = is_zero
                        ? ig_ta_duration_integer_scale(duration, 0L, target)
                        : ig_ta_duration_binary_scale(
                            duration,
                            negative,
                            exponent,
                            target);
                }
            }
        } else {
            long divisor = 0L;
            ulong float_bits = 0ul;
            if (left_type == 6u
                    && ig_ta_numeric_integer(
                        right_kind,
                        right_word,
                        right,
                        divisor)) {
                compatible = true;
                if (divisor == 0L) {
                    ig_ta_instruction_error(output, 1ul, receipt, target);
                    continue;
                }
                success = ig_ta_duration_ratio_scale(
                    left,
                    divisor < 0L,
                    ig_ta_magnitude(divisor),
                    target);
            } else if (left_type == 6u
                    && ig_ta_numeric_float_bits(right_kind, right_word, float_bits)) {
                compatible = true;
                bool is_zero = false;
                bool negative = false;
                int exponent = 0;
                if (ig_ta_float_power_of_two(
                        float_bits,
                        is_zero,
                        negative,
                        exponent)) {
                    if (is_zero) {
                        ig_ta_instruction_error(output, 1ul, receipt, target);
                        continue;
                    }
                    success = ig_ta_duration_binary_scale(
                        left,
                        negative,
                        -exponent,
                        target);
                }
            }
        }
        if (!compatible) {
            ig_ta_instruction_error(output, 1ul, receipt, target);
            continue;
        }
        if (!success) {
            ig_ta_instruction_error(output, 2ul, receipt, target);
            continue;
        }
        uint result_tag = target[0];
        bool result_type_matches = output_type == 5ul
            ? result_tag == 5u || result_tag == 8u
            : result_tag == uint(output_type);
        if (!result_type_matches
                || !ig_ta_canonical_record(target, program, uint(output_type), args)) {
            ig_ta_record_device_error(output, 1ul);
            return;
        }
        valid += 1ul;
    }
    ig_ta_receipt_cardinality(output, args, receipt, row_count, valid);
}

kernel void ig_temporal_arithmetic_publish(
    device const long* graph [[buffer(0)]],
    device const ulong* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    device uint* scans [[buffer(3)]],
    device uint* relation [[buffer(4)]],
    device uint* registers [[buffer(5)]],
    constant TemporalArithmeticArgs& args [[buffer(6)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    (void)scans;
    (void)relation;
    if (thread_index != 0u
            || output[0ul] != IG_TA_OUTPUT_MAGIC
            || output[1ul] != IG_TA_VERSION) return;
    if (output[2ul] != 0ul) {
        output[35ul] = IG_TA_SEAL;
        return;
    }
    ulong row_count = output[20ul];
    ulong semantic_status = output[33ul];
    ulong failing = output[34ul];
    if (row_count > args.maximum_rows
            || semantic_status > 2ul
            || (semantic_status == 0ul && failing != IG_TA_NO_OBLIGATION)
            || (semantic_status != 0ul && failing >= args.obligation_count)) {
        ig_ta_record_device_error(output, 1ul);
        output[35ul] = IG_TA_SEAL;
        return;
    }
    ulong final_receipt = args.obligation_count - 1ul;
    ig_ta_receipt_cardinality(
        output,
        args,
        final_receipt,
        row_count,
        semantic_status == 0ul ? row_count : 0ul);
    if (semantic_status != 0ul) {
        output[35ul] = IG_TA_SEAL;
        return;
    }

    for (ulong column = 0ul; column < args.output_count; ++column) {
        ulong descriptor = program[32ul] + column * IG_TA_OUTPUT_DESCRIPTOR_WORDS;
        ulong source_register = program[descriptor];
        ulong output_type = program[descriptor + 1ul];
        if (source_register < args.source_count
                || source_register >= args.register_count
                || output_type == 0ul
                || output_type > 7ul) {
            ig_ta_record_device_error(output, 1ul);
            output[35ul] = IG_TA_SEAL;
            return;
        }
        for (ulong row = 0ul; row < row_count; ++row) {
            device const uint* source = registers
                + (source_register * args.maximum_rows + row) * 8ul;
            if (!ig_ta_record_shape_valid(source, program, args) || source[0] == 7u) {
                ig_ta_record_device_error(output, 1ul);
                output[35ul] = IG_TA_SEAL;
                return;
            }
            bool is_null = source[0] == 0u;
            bool type_matches = output_type == 5ul
                ? source[0] == 5u || source[0] == 8u
                : source[0] == uint(output_type);
            if (!is_null && !type_matches) {
                ig_ta_record_device_error(output, 1ul);
                output[35ul] = IG_TA_SEAL;
                return;
            }
            ulong cell = column * args.maximum_rows + row;
            ulong target = args.output_value_base + cell * IG_TA_CELL_WORDS;
            if (is_null) {
                for (ulong lane = 0ul; lane < IG_TA_CELL_WORDS; ++lane) {
                    output[target + lane] = 0ul;
                }
                output[args.output_validity_base + cell] = 0ul;
            } else {
                for (ulong lane = 0ul; lane < IG_TA_CELL_WORDS; ++lane) {
                    uint low = source[uint(lane * 2ul)];
                    uint high = source[uint(lane * 2ul + 1ul)];
                    output[target + lane] = ulong(low) | (ulong(high) << 32);
                }
                output[args.output_validity_base + cell] = 1ul;
            }
        }
    }
    if (output[2ul] == 0ul) output[35ul] = IG_TA_SEAL;
}

#endif // IG_INCLUDE_TEMPORAL_ARITHMETIC_KERNELS

#endif // IG_INCLUDE_TEMPORAL_REGISTER

// IG_TEMPORAL_ARITHMETIC_SOURCE_END

// Native CREATE-node scalar/temporal intent program, wire ABI version 3.
//
// This kernel deliberately lives outside IG_INCLUDE_TEMPORAL_REGISTER so the normal operator
// library always contains it. Temporal constructors execute in the existing temporal register
// program immediately before this kernel; buffer 10 is their still-device-resident canonical
// output, not a host-decoded value. Version 3 additionally builds one homogeneous flat temporal
// LIST directly into output payload; MAP and every other document shape remain fail-closed. No
// failure has a fallback.
//
// Dispatch exactly one thread. All multi-byte words are native little-endian Metal uint/ulong
// values. Rust must bind every buffer even when its logical length is zero (a one-element sentinel
// buffer is sufficient for an empty input/output arena).
//
// Buffers:
//   0  device const ulong input_header[8]
//   1  device const ulong input_labels[args.label_count]
//   2  device const ulong input_properties[args.property_count * 8]
//   3  device const uchar input_payload[max(1, args.input_payload_bytes)]
//   4  device ulong receipt_records[args.receipt_record_capacity * 9] (in/out)
//   5  device ulong output_header[8]
//   6  device ulong output_labels[args.output_label_capacity]
//   7  device ulong output_properties[args.output_property_capacity * 6]
//   8  device uchar output_payload[max(1, args.output_payload_capacity)]
//   9  constant IgCreateNodeIntentArgs (18 consecutive u32 words, 72 bytes)
//   10 device const uint temporal_values[args.temporal_value_count * 8]
//
// input_header and output_header, eight u64 words each:
//   [0] ABI word: low32 magic 0x4947434e ("IGCN"), high32 version 3
//   [1] input must be zero; output low32=IgCreateStatus, high32=output payload bytes used
//   [2] stable NodeId u64
//   [3] shape: bits 0..7 Layer (0 OBSERVED, 1 KNOWLEDGE), bits 8..23 label_count,
//       bits 24..39 property_count, bits 40..55 receipt_count, bits 56..63 zero
//   [4..7] the four little-endian u64 lanes of ResidentCreateNodeFingerprint([u8; 32])
// On every terminal path output [0], [2..7] echo the immutable input. Only SUCCESS authorizes
// decoding labels/properties/receipts as an intent.
//
// One input label is one u64 containing only a query-local u16 label-name index. One output label
// is the exact echoed u64. Labels must be strictly increasing and below label_name_count.
//
// One input property is eight u64 words:
//   [0] query-local property-name index (u16, upper bits zero)
//   [1] IgCreateValueTag (u8, upper bits zero)
//   [2] NULL=0; BOOLEAN=0/1; INTEGER=i64 bits; FLOAT=f64 bits;
//       STRING/BYTES=input payload offset (u32, upper bits zero);
//       DATE..DURATION=temporal slot (u32, upper bits zero)
//   [3] STRING/BYTES=input payload byte length (u32, upper bits zero);
//       DATETIME=maximum admitted timezone output bytes (non-zero u32);
//       every other temporal type=0
//   [4..7] zero for scalar/temporal values
// For a temporal LIST, words [2..7] are descriptor offset, element count, exact maximum canonical
// document bytes, LIST-builder expression scope, descriptor byte length, and expected temporal
// family tag. Each 16-byte descriptor is: kind u8 (0 literal NULL, 1 constructor), expected tag
// u8, expression scope u16 LE, temporal slot u32 LE, timezone capacity u32 LE, reserved-zero u32.
// Literal NULL uses tag=0, scope=u16::MAX, slot=u32::MAX, and zero capacity. It needs no evaluator
// receipt; the LIST-builder receipt proves its position and canonical NULL tag.
// Properties must be strictly increasing by property-name index.
//
// One output property is six u64 words:
//   [0] bits 0..15 property-name index, bits 16..23 IgCreateValueTag,
//       bits 24..31 per-property IgCreateStatus, bits 32..63 zero
//   [1..4] BOOLEAN/INTEGER/FLOAT use [1]; DATE [1]=days; LOCAL_TIME [1]=nanos;
//       TIME [1]=nanos, [2]=sign-extended offset seconds; LOCAL_DATETIME [1]=seconds,
//       [2]=nanos; DATETIME [1]=seconds, [2]=nanos; DURATION [1..4]=months, days,
//       seconds, nanos (nanos is the canonical low-u32 bit pattern)
//   [5] STRING/BYTES/DATETIME/LIST low32=output payload offset, high32=exact byte length;
//       otherwise zero
// A temporal register tagged NULL must contain seven zero payload words and emits a successful
// canonical NULL output property (output type tag 0), independent of its declared temporal type.
// String, byte, and fixed-timezone payloads are copied/generated on-device. Capacity failure
// occurs before writing that value, so this ABI never emits a truncated payload.
//
// Buffer 10 uses the existing temporal-register rows, eight u32 words each:
//   tag 0 NULL; 1 DATE; 2 LOCAL_TIME; 3 TIME; 4 LOCAL_DATETIME; 5 DATETIME fixed;
//   6 DURATION; 7 semantic invalid temporal; 8 DATETIME named (v3 fail-closed).
// Scalar temporal properties and temporal LIST constructor descriptors together must name slots
// 0..temporal_value_count-1 exactly once in property/element order. Every constructor consumes one
// expression receipt; every LIST consumes one additional builder receipt.
//
// Each receipt record is nine u64 words. The host initializes [0..1] and zeroes [2..8]:
//   [0] non-zero ResidentExecutionObligation.id (preserved)
//   [1] obligation metadata: bits 0..7 kind, bits 8..15 scope tag,
//       bits 16..31 scope u16 index, bits 32..63 zero (preserved)
//   [2] receipt status: 0 pending input, 1 completed output
//   [3] execution.high
//   [4] execution.low
//   [5] echoed obligation id
//   [6] echoed obligation metadata
//   [7] low32 input cardinality=1, high32 output cardinality=1
//   [8] ResidentDeviceCompletion::Metal = 2
// Version 3 requires 2 + expression_count records: selection first, then constructor and LIST
// builder expressions in packet order, then [MutationRhs=2, MutationCommand=1, index=0]. Scalar
// temporal scopes remain their property index; LIST scopes come from the immutable descriptors.
// All records remain pending until the complete intent succeeds; only then does this kernel
// complete every receipt.

constant ulong IG_CREATE_NODE_ABI_WORD = 0x000000034743434eul;

constant uint IG_CREATE_VALUE_NULL = 0u;
constant uint IG_CREATE_VALUE_BOOLEAN = 1u;
constant uint IG_CREATE_VALUE_INTEGER = 2u;
constant uint IG_CREATE_VALUE_FLOAT = 3u;
constant uint IG_CREATE_VALUE_STRING = 4u;
constant uint IG_CREATE_VALUE_BYTES = 5u;
constant uint IG_CREATE_VALUE_DATE = 6u;
constant uint IG_CREATE_VALUE_LOCAL_TIME = 7u;
constant uint IG_CREATE_VALUE_TIME = 8u;
constant uint IG_CREATE_VALUE_LOCAL_DATETIME = 9u;
constant uint IG_CREATE_VALUE_DATETIME = 10u;
constant uint IG_CREATE_VALUE_DURATION = 11u;
constant uint IG_CREATE_VALUE_LIST = 12u;
constant uint IG_CREATE_VALUE_MAP = 13u;

constant uchar IG_CREATE_DOCUMENT_VERSION = 3u;
constant uchar IG_CREATE_DOCUMENT_NULL = 0u;
constant uchar IG_CREATE_DOCUMENT_LIST = 13u;
constant uchar IG_CREATE_LIST_LITERAL_NULL = 0u;
constant uchar IG_CREATE_LIST_CONSTRUCTOR = 1u;
constant uint IG_CREATE_LIST_DESCRIPTOR_BYTES = 16u;

// The same codes are used in output_header[1].low32 and output property word 0 bits 24..31.
constant uint IG_CREATE_STATUS_NOT_EXECUTED = 0u;
constant uint IG_CREATE_STATUS_SUCCESS = 1u;
constant uint IG_CREATE_STATUS_INVALID_HEADER = 2u;
constant uint IG_CREATE_STATUS_INDEX_BOUNDS = 3u;
constant uint IG_CREATE_STATUS_INVALID_SCALAR = 4u;
constant uint IG_CREATE_STATUS_UNSUPPORTED_DOCUMENT = 5u;
constant uint IG_CREATE_STATUS_INVALID_RECEIPT = 6u;
constant uint IG_CREATE_STATUS_OUTPUT_CAPACITY = 7u;
constant uint IG_CREATE_STATUS_MALFORMED_PACKET = 8u;
constant uint IG_CREATE_STATUS_TEMPORAL_SLOT_BOUNDS = 9u;
constant uint IG_CREATE_STATUS_INVALID_TEMPORAL = 10u;
constant uint IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH = 11u;
constant uint IG_CREATE_STATUS_TIMEZONE_CAPACITY = 12u;
constant uint IG_CREATE_STATUS_UNSUPPORTED_NAMED_TIMEZONE = 13u;

struct IgCreateNodeIntentArgs {
    uint label_count;                    // word 0
    uint property_count;                 // word 1
    uint receipt_count;                  // word 2; 2 + expression_count
    uint label_name_count;               // word 3; query-local table cardinality
    uint property_name_count;            // word 4; query-local table cardinality
    uint input_payload_bytes;             // word 5
    uint output_label_capacity;           // word 6, in labels
    uint output_property_capacity;        // word 7, in six-u64 records
    uint output_payload_capacity;         // word 8, in bytes
    uint receipt_record_capacity;         // word 9, in nine-u64 records
    uint execution_high_low;              // word 10
    uint execution_high_high;             // word 11
    uint execution_low_low;               // word 12
    uint execution_low_high;              // word 13
    uint flags;                            // word 14; must be zero in v3
    uint reserved;                         // word 15; must be zero
    uint temporal_value_count;             // word 16; eight-u32 rows in buffer 10
    uint expression_count;                 // word 17; constructor + LIST-builder receipts
};

inline ulong ig_create_node_u64(uint low, uint high) {
    return ulong(low) | (ulong(high) << 32);
}

inline bool ig_create_node_range(uint start, uint length, uint capacity) {
    return start <= capacity && length <= capacity - start;
}

inline ulong ig_create_node_property_meta(uint name, uint tag, uint status) {
    return ulong(name) | (ulong(tag) << 16) | (ulong(status) << 24);
}

inline void ig_create_node_finish(
    device ulong* output_header,
    uint status,
    uint output_payload_bytes) {
    output_header[1] = ulong(status) | (ulong(output_payload_bytes) << 32);
}

inline bool ig_create_node_receipt_input_valid(
    device const ulong* record,
    uint expected_kind,
    uint expected_scope,
    uint expected_index) {
    ulong expected_metadata = ulong(expected_kind)
        | (ulong(expected_scope) << 8)
        | (ulong(expected_index) << 16);
    if (record[0] == 0ul || record[1] != expected_metadata) {
        return false;
    }
    for (uint word = 2u; word < 9u; ++word) {
        if (record[word] != 0ul) return false;
    }
    return true;
}

inline bool ig_create_node_receipt_id_unique_before(
    device const ulong* records,
    uint record_index) {
    ulong id = records[record_index * 9u];
    for (uint previous = 0u; previous < record_index; ++previous) {
        if (records[previous * 9u] == id) return false;
    }
    return true;
}

inline bool ig_create_node_expression_receipt_valid(
    device const ulong* records,
    uint receipt_count,
    uint expression_index,
    uint expected_scope) {
    uint record_index = expression_index + 1u;
    if (record_index >= receipt_count - 1u) return false;
    device const ulong* record = records + record_index * 9u;
    device const ulong* rhs = records + (receipt_count - 1u) * 9u;
    return ig_create_node_receipt_input_valid(record, 3u, 2u, expected_scope)
        && record[0] != rhs[0]
        && ig_create_node_receipt_id_unique_before(records, record_index);
}

inline void ig_create_node_complete_receipt(
    device ulong* record,
    ulong execution_high,
    ulong execution_low) {
    record[2] = 1ul;
    record[3] = execution_high;
    record[4] = execution_low;
    record[5] = record[0];
    record[6] = record[1];
    record[7] = 1ul | (1ul << 32);
    record[8] = 2ul;
}

inline ushort ig_create_node_read_u16_le(device const uchar* bytes, uint offset) {
    return ushort(bytes[offset]) | (ushort(bytes[offset + 1u]) << 8);
}

inline uint ig_create_node_read_u32_le(device const uchar* bytes, uint offset) {
    return uint(bytes[offset])
        | (uint(bytes[offset + 1u]) << 8)
        | (uint(bytes[offset + 2u]) << 16)
        | (uint(bytes[offset + 3u]) << 24);
}

inline void ig_create_node_write_u32_le(
    device uchar* bytes,
    uint offset,
    uint value) {
    bytes[offset] = uchar(value);
    bytes[offset + 1u] = uchar(value >> 8);
    bytes[offset + 2u] = uchar(value >> 16);
    bytes[offset + 3u] = uchar(value >> 24);
}

inline void ig_create_node_write_u64_le(
    device uchar* bytes,
    uint offset,
    ulong value) {
    ig_create_node_write_u32_le(bytes, offset, uint(value));
    ig_create_node_write_u32_le(bytes, offset + 4u, uint(value >> 32));
}

inline ulong ig_create_node_temporal_i64(
    device const uint* value,
    uint low_word) {
    return ulong(value[low_word]) | (ulong(value[low_word + 1u]) << 32);
}

inline bool ig_create_node_temporal_zero_tail(
    device const uint* value,
    uint first_word) {
    for (uint word = first_word; word < 8u; ++word) {
        if (value[word] != 0u) return false;
    }
    return true;
}

inline uint ig_create_node_fixed_timezone_length(int offset_seconds) {
    if (offset_seconds == 0) return 3u; // canonical ScalarValue timezone is exactly "UTC"
    long magnitude = offset_seconds < 0 ? -long(offset_seconds) : long(offset_seconds);
    if (magnitude >= 86400L) return 0u;
    return magnitude % 60L == 0L ? 6u : 9u;
}

inline bool ig_create_node_fixed_timezone_char(
    int offset_seconds,
    uint index,
    thread uchar& value) {
    if (offset_seconds == 0) {
        if (index >= 3u) return false;
        value = index == 0u ? uchar('U') : (index == 1u ? uchar('T') : uchar('C'));
        return true;
    }
    long magnitude = offset_seconds < 0 ? -long(offset_seconds) : long(offset_seconds);
    if (magnitude >= 86400L) return false;
    uint hours = uint(magnitude / 3600L);
    uint minutes = uint((magnitude / 60L) % 60L);
    uint seconds = uint(magnitude % 60L);
    uint length = seconds == 0u ? 6u : 9u;
    if (index >= length) return false;
    if (index == 0u) value = offset_seconds < 0 ? uchar('-') : uchar('+');
    else if (index == 1u) value = uchar('0' + hours / 10u);
    else if (index == 2u) value = uchar('0' + hours % 10u);
    else if (index == 3u || index == 6u) value = uchar(':');
    else if (index == 4u) value = uchar('0' + minutes / 10u);
    else if (index == 5u) value = uchar('0' + minutes % 10u);
    else if (index == 7u) value = uchar('0' + seconds / 10u);
    else value = uchar('0' + seconds % 10u);
    return true;
}

inline uint ig_create_node_temporal_document_size(
    uint expected_tag,
    uint maximum_timezone_bytes,
    device const uint* value,
    thread uint& document_bytes) {
    uint register_tag = value[0];
    document_bytes = 0u;
    if (register_tag == 7u) return IG_CREATE_STATUS_INVALID_TEMPORAL;
    if (register_tag == 8u) return IG_CREATE_STATUS_UNSUPPORTED_NAMED_TIMEZONE;
    if (register_tag == 0u) {
        if (!ig_create_node_temporal_zero_tail(value, 1u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        document_bytes = 1u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag < IG_CREATE_VALUE_DATE || expected_tag > IG_CREATE_VALUE_DURATION
            || register_tag != expected_tag - IG_CREATE_VALUE_DATE + 1u) {
        return IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH;
    }
    if (expected_tag == IG_CREATE_VALUE_DATE) {
        if (!ig_create_node_temporal_zero_tail(value, 3u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        document_bytes = 9u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_LOCAL_TIME) {
        long nanos = as_type<long>(ig_create_node_temporal_i64(value, 1u));
        if (nanos < 0L || nanos >= 86400000000000L
                || !ig_create_node_temporal_zero_tail(value, 3u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        document_bytes = 9u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_TIME) {
        long nanos = as_type<long>(ig_create_node_temporal_i64(value, 1u));
        int offset_seconds = as_type<int>(value[3]);
        if (nanos < 0L || nanos >= 86400000000000L
                || offset_seconds <= -86400 || offset_seconds >= 86400
                || !ig_create_node_temporal_zero_tail(value, 4u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        document_bytes = 13u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_LOCAL_DATETIME) {
        if (value[3] >= 1000000000u
                || !ig_create_node_temporal_zero_tail(value, 4u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        document_bytes = 13u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_DATETIME) {
        int offset_seconds = as_type<int>(value[4]);
        uint timezone_length = ig_create_node_fixed_timezone_length(offset_seconds);
        if (value[3] >= 1000000000u || timezone_length == 0u
                || !ig_create_node_temporal_zero_tail(value, 5u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        if (timezone_length > maximum_timezone_bytes) {
            return IG_CREATE_STATUS_TIMEZONE_CAPACITY;
        }
        document_bytes = 21u + timezone_length;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_DURATION) {
        if (value[7] >= 1000000000u) return IG_CREATE_STATUS_MALFORMED_PACKET;
        document_bytes = 29u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    return IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH;
}

inline uint ig_create_node_write_temporal_document(
    uint expected_tag,
    uint maximum_timezone_bytes,
    device const uint* value,
    device uchar* output_payload,
    thread uint& output_cursor) {
    uint document_bytes = 0u;
    uint status = ig_create_node_temporal_document_size(
        expected_tag, maximum_timezone_bytes, value, document_bytes);
    if (status != IG_CREATE_STATUS_SUCCESS) return status;
    if (value[0] == 0u) {
        output_payload[output_cursor++] = IG_CREATE_DOCUMENT_NULL;
        return IG_CREATE_STATUS_SUCCESS;
    }

    output_payload[output_cursor++] = uchar(expected_tag + 1u);
    if (expected_tag == IG_CREATE_VALUE_DATE
            || expected_tag == IG_CREATE_VALUE_LOCAL_TIME) {
        ig_create_node_write_u64_le(
            output_payload, output_cursor, ig_create_node_temporal_i64(value, 1u));
        output_cursor += 8u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_TIME) {
        ig_create_node_write_u64_le(
            output_payload, output_cursor, ig_create_node_temporal_i64(value, 1u));
        ig_create_node_write_u32_le(output_payload, output_cursor + 8u, value[3]);
        output_cursor += 12u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_LOCAL_DATETIME) {
        ig_create_node_write_u64_le(
            output_payload, output_cursor, ig_create_node_temporal_i64(value, 1u));
        ig_create_node_write_u32_le(output_payload, output_cursor + 8u, value[3]);
        output_cursor += 12u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_DATETIME) {
        int offset_seconds = as_type<int>(value[4]);
        uint timezone_length = ig_create_node_fixed_timezone_length(offset_seconds);
        ig_create_node_write_u64_le(
            output_payload, output_cursor, ig_create_node_temporal_i64(value, 1u));
        ig_create_node_write_u32_le(output_payload, output_cursor + 8u, value[3]);
        ig_create_node_write_u64_le(
            output_payload, output_cursor + 12u, ulong(timezone_length));
        output_cursor += 20u;
        for (uint byte = 0u; byte < timezone_length; ++byte) {
            uchar timezone_byte = 0u;
            if (!ig_create_node_fixed_timezone_char(
                    offset_seconds, byte, timezone_byte)) {
                return IG_CREATE_STATUS_MALFORMED_PACKET;
            }
            output_payload[output_cursor++] = timezone_byte;
        }
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_DURATION) {
        ig_create_node_write_u64_le(
            output_payload, output_cursor, ig_create_node_temporal_i64(value, 1u));
        ig_create_node_write_u64_le(
            output_payload, output_cursor + 8u, ig_create_node_temporal_i64(value, 3u));
        ig_create_node_write_u64_le(
            output_payload, output_cursor + 16u, ig_create_node_temporal_i64(value, 5u));
        ig_create_node_write_u32_le(output_payload, output_cursor + 24u, value[7]);
        output_cursor += 28u;
        return IG_CREATE_STATUS_SUCCESS;
    }
    return IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH;
}

inline uint ig_create_node_write_temporal_property(
    uint expected_tag,
    uint maximum_timezone_bytes,
    device const uint* value,
    device ulong* output,
    device uchar* output_payload,
    uint output_payload_capacity,
    thread uint& output_cursor,
    thread uint& actual_tag) {
    uint register_tag = value[0];
    actual_tag = expected_tag;
    if (register_tag == 7u) return IG_CREATE_STATUS_INVALID_TEMPORAL;
    if (register_tag == 8u) return IG_CREATE_STATUS_UNSUPPORTED_NAMED_TIMEZONE;
    if (register_tag == 0u) {
        if (!ig_create_node_temporal_zero_tail(value, 1u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        actual_tag = IG_CREATE_VALUE_NULL;
        return IG_CREATE_STATUS_SUCCESS;
    }

    uint expected_register_tag = expected_tag - IG_CREATE_VALUE_DATE + 1u;
    if (register_tag != expected_register_tag) {
        return IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH;
    }

    if (expected_tag == IG_CREATE_VALUE_DATE) {
        if (!ig_create_node_temporal_zero_tail(value, 3u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        output[1] = ig_create_node_temporal_i64(value, 1u);
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_LOCAL_TIME) {
        long nanos = as_type<long>(ig_create_node_temporal_i64(value, 1u));
        if (nanos < 0L || nanos >= 86400000000000L
                || !ig_create_node_temporal_zero_tail(value, 3u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        output[1] = as_type<ulong>(nanos);
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_TIME) {
        long nanos = as_type<long>(ig_create_node_temporal_i64(value, 1u));
        int offset_seconds = as_type<int>(value[3]);
        if (nanos < 0L || nanos >= 86400000000000L
                || offset_seconds <= -86400 || offset_seconds >= 86400
                || !ig_create_node_temporal_zero_tail(value, 4u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        output[1] = as_type<ulong>(nanos);
        output[2] = as_type<ulong>(long(offset_seconds));
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_LOCAL_DATETIME) {
        if (value[3] >= 1000000000u
                || !ig_create_node_temporal_zero_tail(value, 4u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        output[1] = ig_create_node_temporal_i64(value, 1u);
        output[2] = ulong(value[3]);
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_DATETIME) {
        int offset_seconds = as_type<int>(value[4]);
        uint timezone_length = ig_create_node_fixed_timezone_length(offset_seconds);
        if (value[3] >= 1000000000u || timezone_length == 0u
                || !ig_create_node_temporal_zero_tail(value, 5u)) {
            return IG_CREATE_STATUS_MALFORMED_PACKET;
        }
        if (timezone_length > maximum_timezone_bytes) {
            return IG_CREATE_STATUS_TIMEZONE_CAPACITY;
        }
        if (!ig_create_node_range(
                output_cursor, timezone_length, output_payload_capacity)) {
            return IG_CREATE_STATUS_OUTPUT_CAPACITY;
        }
        for (uint byte = 0u; byte < timezone_length; ++byte) {
            uchar timezone_byte = 0u;
            if (!ig_create_node_fixed_timezone_char(
                    offset_seconds, byte, timezone_byte)) {
                return IG_CREATE_STATUS_MALFORMED_PACKET;
            }
            output_payload[output_cursor + byte] = timezone_byte;
        }
        output[1] = ig_create_node_temporal_i64(value, 1u);
        output[2] = ulong(value[3]);
        output[5] = ulong(output_cursor) | (ulong(timezone_length) << 32);
        output_cursor += timezone_length;
        return IG_CREATE_STATUS_SUCCESS;
    }
    if (expected_tag == IG_CREATE_VALUE_DURATION) {
        if (value[7] >= 1000000000u) return IG_CREATE_STATUS_MALFORMED_PACKET;
        output[1] = ig_create_node_temporal_i64(value, 1u);
        output[2] = ig_create_node_temporal_i64(value, 3u);
        output[3] = ig_create_node_temporal_i64(value, 5u);
        output[4] = ulong(value[7]);
        return IG_CREATE_STATUS_SUCCESS;
    }
    return IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH;
}

inline uint ig_create_node_write_temporal_list(
    device const ulong* input,
    device const uchar* input_payload,
    device const ulong* receipt_records,
    device const uint* temporal_values,
    constant IgCreateNodeIntentArgs& args,
    device ulong* output,
    device uchar* output_payload,
    thread uint& output_cursor,
    thread uint& temporal_cursor,
    thread uint& expression_cursor) {
    if (input[2] > 0xfffffffful || input[3] > 0xfffffffful
            || input[4] > 0xfffffffful || input[5] > 0xfffful
            || input[6] > 0xfffffffful || input[7] > 0xfful) {
        return IG_CREATE_STATUS_MALFORMED_PACKET;
    }
    uint descriptor_start = uint(input[2]);
    uint element_count = uint(input[3]);
    uint maximum_document_bytes = uint(input[4]);
    uint builder_scope = uint(input[5]);
    uint descriptor_bytes = uint(input[6]);
    uint family_tag = uint(input[7]);
    if (element_count == 0u || element_count > 999999u
            || family_tag < IG_CREATE_VALUE_DATE
            || family_tag > IG_CREATE_VALUE_DURATION
            || element_count > 0xffffffffu / IG_CREATE_LIST_DESCRIPTOR_BYTES
            || descriptor_bytes != element_count * IG_CREATE_LIST_DESCRIPTOR_BYTES
            || !ig_create_node_range(
                descriptor_start, descriptor_bytes, args.input_payload_bytes)
            || maximum_document_bytes < 10u) {
        return IG_CREATE_STATUS_MALFORMED_PACKET;
    }

    // Canonical document v3 stores the version byte, LIST tag, and a little-endian u64 element
    // count. Capacity is governed by the admitted output buffer, not the former 16 MiB guard.
    uint maximum_bytes = 10u;
    uint actual_bytes = 10u;
    uint list_temporal_start = temporal_cursor;
    for (uint element = 0u; element < element_count; ++element) {
        uint descriptor = descriptor_start + element * IG_CREATE_LIST_DESCRIPTOR_BYTES;
        uchar kind = input_payload[descriptor];
        uint expected_tag = uint(input_payload[descriptor + 1u]);
        uint expression_scope = uint(ig_create_node_read_u16_le(
            input_payload, descriptor + 2u));
        uint temporal_slot = ig_create_node_read_u32_le(input_payload, descriptor + 4u);
        uint timezone_capacity = ig_create_node_read_u32_le(input_payload, descriptor + 8u);
        uint reserved = ig_create_node_read_u32_le(input_payload, descriptor + 12u);
        if (kind == IG_CREATE_LIST_LITERAL_NULL) {
            if (expected_tag != 0u || expression_scope != 0xffffu
                    || temporal_slot != 0xffffffffu || timezone_capacity != 0u
                    || reserved != 0u) {
                return IG_CREATE_STATUS_MALFORMED_PACKET;
            }
            if (maximum_bytes == 0xffffffffu || actual_bytes == 0xffffffffu) {
                return IG_CREATE_STATUS_OUTPUT_CAPACITY;
            }
            maximum_bytes += 1u;
            actual_bytes += 1u;
            continue;
        }
        if (kind != IG_CREATE_LIST_CONSTRUCTOR || expected_tag != family_tag
                || reserved != 0u
                || (expected_tag == IG_CREATE_VALUE_DATETIME && timezone_capacity == 0u)
                || (expected_tag != IG_CREATE_VALUE_DATETIME && timezone_capacity != 0u)
                || temporal_slot != temporal_cursor
                || temporal_slot >= args.temporal_value_count
                || expression_cursor >= args.expression_count
                || !ig_create_node_expression_receipt_valid(
                    receipt_records, args.receipt_count, expression_cursor, expression_scope)) {
            return kind == IG_CREATE_LIST_CONSTRUCTOR
                    && temporal_slot != temporal_cursor
                ? IG_CREATE_STATUS_TEMPORAL_SLOT_BOUNDS
                : IG_CREATE_STATUS_INVALID_RECEIPT;
        }

        uint maximum_item_bytes = 0u;
        if (expected_tag == IG_CREATE_VALUE_DATE
                || expected_tag == IG_CREATE_VALUE_LOCAL_TIME) {
            maximum_item_bytes = 9u;
        } else if (expected_tag == IG_CREATE_VALUE_TIME
                || expected_tag == IG_CREATE_VALUE_LOCAL_DATETIME) {
            maximum_item_bytes = 13u;
        } else if (expected_tag == IG_CREATE_VALUE_DATETIME) {
            if (timezone_capacity > 0xffffffffu - 21u) {
                return IG_CREATE_STATUS_OUTPUT_CAPACITY;
            }
            maximum_item_bytes = 21u + timezone_capacity;
        } else if (expected_tag == IG_CREATE_VALUE_DURATION) {
            maximum_item_bytes = 29u;
        } else {
            return IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH;
        }
        uint actual_item_bytes = 0u;
        uint status = ig_create_node_temporal_document_size(
            expected_tag,
            timezone_capacity,
            temporal_values + temporal_slot * 8u,
            actual_item_bytes);
        if (status != IG_CREATE_STATUS_SUCCESS) return status;
        if (maximum_item_bytes > 0xffffffffu - maximum_bytes
                || actual_item_bytes > 0xffffffffu - actual_bytes) {
            return IG_CREATE_STATUS_OUTPUT_CAPACITY;
        }
        maximum_bytes += maximum_item_bytes;
        actual_bytes += actual_item_bytes;
        temporal_cursor += 1u;
        expression_cursor += 1u;
    }
    if (temporal_cursor == list_temporal_start) {
        return IG_CREATE_STATUS_TEMPORAL_TYPE_MISMATCH;
    }
    if (expression_cursor >= args.expression_count
            || !ig_create_node_expression_receipt_valid(
                receipt_records, args.receipt_count, expression_cursor, builder_scope)) {
        return IG_CREATE_STATUS_INVALID_RECEIPT;
    }
    expression_cursor += 1u;
    if (maximum_bytes != maximum_document_bytes || actual_bytes > maximum_document_bytes) {
        return IG_CREATE_STATUS_OUTPUT_CAPACITY;
    }
    if (!ig_create_node_range(
            output_cursor, maximum_document_bytes, args.output_payload_capacity)) {
        return IG_CREATE_STATUS_OUTPUT_CAPACITY;
    }

    uint output_start = output_cursor;
    output_payload[output_cursor++] = IG_CREATE_DOCUMENT_VERSION;
    output_payload[output_cursor++] = IG_CREATE_DOCUMENT_LIST;
    ig_create_node_write_u64_le(output_payload, output_cursor, ulong(element_count));
    output_cursor += 8u;
    for (uint element = 0u; element < element_count; ++element) {
        uint descriptor = descriptor_start + element * IG_CREATE_LIST_DESCRIPTOR_BYTES;
        uchar kind = input_payload[descriptor];
        if (kind == IG_CREATE_LIST_LITERAL_NULL) {
            output_payload[output_cursor++] = IG_CREATE_DOCUMENT_NULL;
            continue;
        }
        uint expected_tag = uint(input_payload[descriptor + 1u]);
        uint temporal_slot = ig_create_node_read_u32_le(input_payload, descriptor + 4u);
        uint timezone_capacity = ig_create_node_read_u32_le(input_payload, descriptor + 8u);
        uint status = ig_create_node_write_temporal_document(
            expected_tag,
            timezone_capacity,
            temporal_values + temporal_slot * 8u,
            output_payload,
            output_cursor);
        if (status != IG_CREATE_STATUS_SUCCESS) return status;
    }
    if (output_cursor - output_start != actual_bytes) {
        return IG_CREATE_STATUS_MALFORMED_PACKET;
    }
    output[5] = ulong(output_start) | (ulong(actual_bytes) << 32);
    return IG_CREATE_STATUS_SUCCESS;
}

kernel void ig_create_node_intent_program(
    device const ulong* input_header [[buffer(0)]],
    device const ulong* input_labels [[buffer(1)]],
    device const ulong* input_properties [[buffer(2)]],
    device const uchar* input_payload [[buffer(3)]],
    device ulong* receipt_records [[buffer(4)]],
    device ulong* output_header [[buffer(5)]],
    device ulong* output_labels [[buffer(6)]],
    device ulong* output_properties [[buffer(7)]],
    device uchar* output_payload [[buffer(8)]],
    constant IgCreateNodeIntentArgs& args [[buffer(9)]],
    device const uint* temporal_values [[buffer(10)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;

    // Always establish a terminal, fingerprint-echoing header before inspecting variable input.
    output_header[0] = input_header[0];
    output_header[1] = ulong(IG_CREATE_STATUS_NOT_EXECUTED);
    for (uint word = 2u; word < 8u; ++word) output_header[word] = input_header[word];

    if (args.output_property_capacity > 0xffffffffu / 6u
            || args.receipt_record_capacity > 0xffffffffu / 9u) {
        ig_create_node_finish(output_header, IG_CREATE_STATUS_INVALID_HEADER, 0u);
        return;
    }
    for (uint label = 0u; label < args.output_label_capacity; ++label) {
        output_labels[label] = 0ul;
    }
    for (uint word = 0u; word < args.output_property_capacity * 6u; ++word) {
        output_properties[word] = 0ul;
    }

    ulong shape = input_header[3];
    uint layer = uint(shape & 0xfful);
    uint header_label_count = uint((shape >> 8) & 0xfffful);
    uint header_property_count = uint((shape >> 24) & 0xfffful);
    uint header_receipt_count = uint((shape >> 40) & 0xfffful);
    ulong execution_high = ig_create_node_u64(args.execution_high_low, args.execution_high_high);
    ulong execution_low = ig_create_node_u64(args.execution_low_low, args.execution_low_high);
    if (input_header[0] != IG_CREATE_NODE_ABI_WORD
            || input_header[1] != 0ul
            || (shape >> 56) != 0ul
            || layer > IG_MAX_LAYER
            || header_label_count != args.label_count
            || header_property_count != args.property_count
            || header_receipt_count != args.receipt_count
            || args.label_count > 0xffffu
            || args.property_count > 0xffffu
            || args.receipt_count > 0xffffu
            || args.label_name_count > 0xffffu
            || args.property_name_count > 0xffffu
            || args.output_label_capacity < args.label_count
            || args.output_property_capacity < args.property_count
            || args.receipt_record_capacity < args.receipt_count
            || args.temporal_value_count > args.expression_count
            || args.expression_count > 0xffffu - 2u
            || args.receipt_count != args.expression_count + 2u
            || args.flags != 0u
            || args.reserved != 0u
            || (execution_high == 0ul && execution_low == 0ul)) {
        ig_create_node_finish(output_header, IG_CREATE_STATUS_INVALID_HEADER, 0u);
        return;
    }

    device ulong* selection_receipt = receipt_records;
    device ulong* rhs_receipt = receipt_records + (args.receipt_count - 1u) * 9u;
    if (!ig_create_node_receipt_input_valid(selection_receipt, 1u, 0u, 0u)
            || !ig_create_node_receipt_input_valid(rhs_receipt, 2u, 1u, 0u)
            || selection_receipt[0] == rhs_receipt[0]) {
        ig_create_node_finish(output_header, IG_CREATE_STATUS_INVALID_RECEIPT, 0u);
        return;
    }

    ulong previous_label = 0ul;
    for (uint label = 0u; label < args.label_count; ++label) {
        ulong index = input_labels[label];
        if (index > 0xfffful || index >= ulong(args.label_name_count)) {
            ig_create_node_finish(output_header, IG_CREATE_STATUS_INDEX_BOUNDS, 0u);
            return;
        }
        if (label != 0u && index <= previous_label) {
            ig_create_node_finish(output_header, IG_CREATE_STATUS_MALFORMED_PACKET, 0u);
            return;
        }
        output_labels[label] = index;
        previous_label = index;
    }

    uint output_cursor = 0u;
    uint temporal_cursor = 0u;
    uint expression_cursor = 0u;
    ulong previous_property = 0ul;
    for (uint property = 0u; property < args.property_count; ++property) {
        device const ulong* input = input_properties + property * 8u;
        device ulong* output = output_properties + property * 6u;
        ulong raw_name = input[0];
        ulong raw_tag = input[1];
        uint name = raw_name <= 0xfffful ? uint(raw_name) : 0u;
        uint tag = raw_tag <= 0xfful ? uint(raw_tag) : 0u;
        output[0] = ig_create_node_property_meta(
            name, tag, IG_CREATE_STATUS_NOT_EXECUTED);

        if (raw_name > 0xfffful || raw_name >= ulong(args.property_name_count)) {
            output[0] = ig_create_node_property_meta(
                name, tag, IG_CREATE_STATUS_INDEX_BOUNDS);
            ig_create_node_finish(output_header, IG_CREATE_STATUS_INDEX_BOUNDS, output_cursor);
            return;
        }
        if (property != 0u && raw_name <= previous_property) {
            output[0] = ig_create_node_property_meta(
                name, tag, IG_CREATE_STATUS_MALFORMED_PACKET);
            ig_create_node_finish(
                output_header, IG_CREATE_STATUS_MALFORMED_PACKET, output_cursor);
            return;
        }
        if (raw_tag > 0xfful) {
            output[0] = ig_create_node_property_meta(
                name, 0u, IG_CREATE_STATUS_MALFORMED_PACKET);
            ig_create_node_finish(
                output_header, IG_CREATE_STATUS_MALFORMED_PACKET, output_cursor);
            return;
        }
        previous_property = raw_name;

        if (tag == IG_CREATE_VALUE_MAP) {
            output[0] = ig_create_node_property_meta(
                name, tag, IG_CREATE_STATUS_UNSUPPORTED_DOCUMENT);
            ig_create_node_finish(
                output_header, IG_CREATE_STATUS_UNSUPPORTED_DOCUMENT, output_cursor);
            return;
        }
        if (tag > IG_CREATE_VALUE_MAP) {
            output[0] = ig_create_node_property_meta(
                name, tag, IG_CREATE_STATUS_MALFORMED_PACKET);
            ig_create_node_finish(
                output_header, IG_CREATE_STATUS_MALFORMED_PACKET, output_cursor);
            return;
        }

        if (tag == IG_CREATE_VALUE_LIST) {
            uint status = ig_create_node_write_temporal_list(
                input,
                input_payload,
                receipt_records,
                temporal_values,
                args,
                output,
                output_payload,
                output_cursor,
                temporal_cursor,
                expression_cursor);
            if (status != IG_CREATE_STATUS_SUCCESS) {
                output[0] = ig_create_node_property_meta(name, tag, status);
                ig_create_node_finish(output_header, status, output_cursor);
                return;
            }
            output[0] = ig_create_node_property_meta(
                name, tag, IG_CREATE_STATUS_SUCCESS);
            continue;
        }

        if (tag >= IG_CREATE_VALUE_DATE && tag <= IG_CREATE_VALUE_DURATION) {
            if (input[2] > 0xfffffffful || input[3] > 0xfffffffful
                    || input[4] != 0ul || input[5] != 0ul
                    || input[6] != 0ul || input[7] != 0ul) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_MALFORMED_PACKET);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_MALFORMED_PACKET, output_cursor);
                return;
            }
            uint temporal_slot = uint(input[2]);
            uint maximum_timezone_bytes = uint(input[3]);
            if ((tag == IG_CREATE_VALUE_DATETIME && maximum_timezone_bytes == 0u)
                    || (tag != IG_CREATE_VALUE_DATETIME && maximum_timezone_bytes != 0u)) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_TIMEZONE_CAPACITY);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_TIMEZONE_CAPACITY, output_cursor);
                return;
            }
            if (temporal_slot != temporal_cursor
                    || temporal_slot >= args.temporal_value_count) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_TEMPORAL_SLOT_BOUNDS);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_TEMPORAL_SLOT_BOUNDS, output_cursor);
                return;
            }
            if (expression_cursor >= args.expression_count
                    || !ig_create_node_expression_receipt_valid(
                        receipt_records,
                        args.receipt_count,
                        expression_cursor,
                        property)) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_INVALID_RECEIPT);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_INVALID_RECEIPT, output_cursor);
                return;
            }
            device const uint* temporal_value = temporal_values + temporal_slot * 8u;
            uint actual_tag = tag;
            uint status = ig_create_node_write_temporal_property(
                tag,
                maximum_timezone_bytes,
                temporal_value,
                output,
                output_payload,
                args.output_payload_capacity,
                output_cursor,
                actual_tag);
            if (status != IG_CREATE_STATUS_SUCCESS) {
                output[0] = ig_create_node_property_meta(name, tag, status);
                ig_create_node_finish(output_header, status, output_cursor);
                return;
            }
            output[0] = ig_create_node_property_meta(
                name, actual_tag, IG_CREATE_STATUS_SUCCESS);
            temporal_cursor += 1u;
            expression_cursor += 1u;
            continue;
        }

        bool trailing_zero = input[3] == 0ul && input[4] == 0ul && input[5] == 0ul
            && input[6] == 0ul && input[7] == 0ul;
        if (tag == IG_CREATE_VALUE_NULL) {
            if (input[2] != 0ul || !trailing_zero) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_INVALID_SCALAR);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_INVALID_SCALAR, output_cursor);
                return;
            }
        } else if (tag == IG_CREATE_VALUE_BOOLEAN) {
            if (input[2] > 1ul || !trailing_zero) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_INVALID_SCALAR);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_INVALID_SCALAR, output_cursor);
                return;
            }
            output[1] = input[2];
        } else if (tag == IG_CREATE_VALUE_INTEGER || tag == IG_CREATE_VALUE_FLOAT) {
            if (!trailing_zero) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_INVALID_SCALAR);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_INVALID_SCALAR, output_cursor);
                return;
            }
            output[1] = input[2];
        } else {
            // STRING/BYTES use words 2..3; words 4..7 remain reserved zero.
            if (input[2] > 0xfffffffful || input[3] > 0xfffffffful
                    || input[4] != 0ul || input[5] != 0ul
                    || input[6] != 0ul || input[7] != 0ul) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_MALFORMED_PACKET);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_MALFORMED_PACKET, output_cursor);
                return;
            }
            uint start = uint(input[2]);
            uint length = uint(input[3]);
            if (!ig_create_node_range(start, length, args.input_payload_bytes)) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_MALFORMED_PACKET);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_MALFORMED_PACKET, output_cursor);
                return;
            }
            if (!ig_create_node_range(
                    output_cursor, length, args.output_payload_capacity)) {
                output[0] = ig_create_node_property_meta(
                    name, tag, IG_CREATE_STATUS_OUTPUT_CAPACITY);
                ig_create_node_finish(
                    output_header, IG_CREATE_STATUS_OUTPUT_CAPACITY, output_cursor);
                return;
            }
            for (uint byte = 0u; byte < length; ++byte) {
                output_payload[output_cursor + byte] = input_payload[start + byte];
            }
            output[5] = ulong(output_cursor) | (ulong(length) << 32);
            output_cursor += length;
        }
        output[0] = ig_create_node_property_meta(name, tag, IG_CREATE_STATUS_SUCCESS);
    }

    if (temporal_cursor != args.temporal_value_count) {
        ig_create_node_finish(
            output_header, IG_CREATE_STATUS_TEMPORAL_SLOT_BOUNDS, output_cursor);
        return;
    }
    if (expression_cursor != args.expression_count) {
        ig_create_node_finish(
            output_header, IG_CREATE_STATUS_INVALID_RECEIPT, output_cursor);
        return;
    }
    for (uint receipt = 0u; receipt < args.receipt_count; ++receipt) {
        ig_create_node_complete_receipt(
            receipt_records + receipt * 9u, execution_high, execution_low);
    }
    ig_create_node_finish(output_header, IG_CREATE_STATUS_SUCCESS, output_cursor);
}

// `*.truncate()` uses a separate versioned packet because it contains three independently typed
// arguments: the raw unit, a nested temporal constructor, and an optional raw map. The host only
// transports this packet. Calendar, clock, and timezone semantics below execute on the device.
constant uchar IG_TEMPORAL_TRUNCATE_WIRE_VERSION = 1;
constant uchar IG_TEMPORAL_TRUNCATE_INPUT_NULL = 0;
constant uchar IG_TEMPORAL_TRUNCATE_INPUT_STRING = 1;
constant uchar IG_TEMPORAL_TRUNCATE_INPUT_OTHER = 2;
constant uchar IG_TEMPORAL_TRUNCATE_INPUT_MAP = 3;

constant uchar IG_TEMPORAL_TRUNCATE_MILLENNIUM = 0;
constant uchar IG_TEMPORAL_TRUNCATE_CENTURY = 1;
constant uchar IG_TEMPORAL_TRUNCATE_DECADE = 2;
constant uchar IG_TEMPORAL_TRUNCATE_YEAR = 3;
constant uchar IG_TEMPORAL_TRUNCATE_WEEK_YEAR = 4;
constant uchar IG_TEMPORAL_TRUNCATE_QUARTER = 5;
constant uchar IG_TEMPORAL_TRUNCATE_MONTH = 6;
constant uchar IG_TEMPORAL_TRUNCATE_WEEK = 7;
constant uchar IG_TEMPORAL_TRUNCATE_DAY = 8;
constant uchar IG_TEMPORAL_TRUNCATE_HOUR = 9;
constant uchar IG_TEMPORAL_TRUNCATE_MINUTE = 10;
constant uchar IG_TEMPORAL_TRUNCATE_SECOND = 11;
constant uchar IG_TEMPORAL_TRUNCATE_MILLISECOND = 12;
constant uchar IG_TEMPORAL_TRUNCATE_MICROSECOND = 13;

struct IgTemporalTruncatePacket {
    uchar unit;
    uchar source_function;
    uchar source_tag;
    uint source_start;
    uint source_end;
    uchar map_tag;
    uint map_start;
    uint map_end;
};

struct IgTemporalTruncateSource {
    // Canonical temporal tags: date=1, localtime=2, time=3, localdatetime=4,
    // fixed datetime=5, named datetime=8.
    uchar tag;
    long epoch_days;
    long clock_nanos;
    int offset_seconds;
    uchar has_declared_offset;
    uint zone_start;
    uint zone_end;
};

inline bool ig_temporal_truncate_word(
    device const uchar* bytes,
    uint start,
    uint end,
    constant char* expected,
    uint length) {
    if (end < start || end - start != length) return false;
    for (uint index = 0; index < length; ++index) {
        if (ig_ascii_lower(bytes[start + index]) != uchar(expected[index])) return false;
    }
    return true;
}

__attribute__((noinline)) bool ig_temporal_truncate_parse_unit(
    device const uchar* bytes,
    uint start,
    uint end,
    thread uchar& unit) {
    if (ig_temporal_truncate_word(bytes, start, end, "millennium", 10u)) {
        unit = IG_TEMPORAL_TRUNCATE_MILLENNIUM;
    } else if (ig_temporal_truncate_word(bytes, start, end, "century", 7u)) {
        unit = IG_TEMPORAL_TRUNCATE_CENTURY;
    } else if (ig_temporal_truncate_word(bytes, start, end, "decade", 6u)) {
        unit = IG_TEMPORAL_TRUNCATE_DECADE;
    } else if (ig_temporal_truncate_word(bytes, start, end, "year", 4u)) {
        unit = IG_TEMPORAL_TRUNCATE_YEAR;
    } else if (ig_temporal_truncate_word(bytes, start, end, "weekyear", 8u)) {
        unit = IG_TEMPORAL_TRUNCATE_WEEK_YEAR;
    } else if (ig_temporal_truncate_word(bytes, start, end, "quarter", 7u)) {
        unit = IG_TEMPORAL_TRUNCATE_QUARTER;
    } else if (ig_temporal_truncate_word(bytes, start, end, "month", 5u)) {
        unit = IG_TEMPORAL_TRUNCATE_MONTH;
    } else if (ig_temporal_truncate_word(bytes, start, end, "week", 4u)) {
        unit = IG_TEMPORAL_TRUNCATE_WEEK;
    } else if (ig_temporal_truncate_word(bytes, start, end, "day", 3u)) {
        unit = IG_TEMPORAL_TRUNCATE_DAY;
    } else if (ig_temporal_truncate_word(bytes, start, end, "hour", 4u)) {
        unit = IG_TEMPORAL_TRUNCATE_HOUR;
    } else if (ig_temporal_truncate_word(bytes, start, end, "minute", 6u)) {
        unit = IG_TEMPORAL_TRUNCATE_MINUTE;
    } else if (ig_temporal_truncate_word(bytes, start, end, "second", 6u)) {
        unit = IG_TEMPORAL_TRUNCATE_SECOND;
    } else if (ig_temporal_truncate_word(bytes, start, end, "millisecond", 11u)) {
        unit = IG_TEMPORAL_TRUNCATE_MILLISECOND;
    } else if (ig_temporal_truncate_word(bytes, start, end, "microsecond", 11u)) {
        unit = IG_TEMPORAL_TRUNCATE_MICROSECOND;
    } else {
        return false;
    }
    return true;
}

inline uint ig_temporal_truncate_unit_rank(uchar unit) {
    if (unit <= IG_TEMPORAL_TRUNCATE_YEAR) return uint(unit);
    if (unit == IG_TEMPORAL_TRUNCATE_WEEK_YEAR) return 3u;
    if (unit == IG_TEMPORAL_TRUNCATE_QUARTER) return 4u;
    if (unit == IG_TEMPORAL_TRUNCATE_MONTH || unit == IG_TEMPORAL_TRUNCATE_WEEK) return 5u;
    return uint(unit) - 2u;
}

inline bool ig_temporal_truncate_is_date_unit(uchar unit) {
    return unit <= IG_TEMPORAL_TRUNCATE_DAY;
}

__attribute__((noinline)) bool ig_temporal_parse_truncate_packet(
    device const uchar* bytes,
    uint start,
    uint end,
    thread IgTemporalTruncatePacket& packet) {
    if (end <= start || bytes[start] != IG_TEMPORAL_TRUNCATE_WIRE_VERSION) return false;
    uint cursor = start + 1u;
    if (cursor >= end) return false;
    uchar unit_tag = bytes[cursor++];
    uint unit_start = 0;
    uint unit_end = 0;
    if (!ig_temporal_map_read_payload(bytes, cursor, end, unit_start, unit_end)
            || unit_tag != IG_TEMPORAL_TRUNCATE_INPUT_STRING
            || !ig_temporal_truncate_parse_unit(bytes, unit_start, unit_end, packet.unit)
            || cursor >= end) return false;
    packet.source_function = bytes[cursor++];
    if (packet.source_function > 4u || cursor >= end) return false;
    packet.source_tag = bytes[cursor++];
    if (!ig_temporal_map_read_payload(
            bytes, cursor, end, packet.source_start, packet.source_end)
            || cursor >= end) return false;
    packet.map_tag = bytes[cursor++];
    if (!ig_temporal_map_read_payload(bytes, cursor, end, packet.map_start, packet.map_end)) {
        return false;
    }
    return cursor == end;
}

inline bool ig_temporal_truncate_target_supports(uchar target, uchar unit) {
    if (target == 0u) return ig_temporal_truncate_is_date_unit(unit);
    if (target == 3u || target == 4u) return true;
    if (target == 1u || target == 2u) return unit >= IG_TEMPORAL_TRUNCATE_DAY;
    return false;
}

inline int ig_temporal_truncate_field_rank(uint key) {
    if (key == 1u) return 3;
    if (key == 7u) return 4;
    if (key == 2u || key == 4u) return 5;
    if (key == 3u || key == 5u || key == 6u || key == 8u) return 6;
    if (key >= 9u && key <= 14u) return int(key) - 2;
    return -1;
}

__attribute__((noinline)) bool ig_temporal_truncate_validate_fields(
    uchar target,
    uchar unit,
    bool has_fields,
    thread const IgTemporalMapFields& fields) {
    if (!has_fields) return true;
    uint unit_rank = ig_temporal_truncate_unit_rank(unit);
    for (uint key = 1u; key < IG_TEMPORAL_MAP_FIELD_COUNT; ++key) {
        if (fields.present[key] == 0) continue;
        if (key == 15u) {
            if ((target != 2u && target != 4u)
                    || fields.tags[key] != IG_TEMPORAL_MAP_VALUE_STRING) return false;
            continue;
        }
        int rank = ig_temporal_truncate_field_rank(key);
        if (rank < 0 || uint(rank) <= unit_rank) return false;
        if (target == 0u && rank > 6) return false;
        if ((target == 1u || target == 2u) && rank <= 6) return false;
    }
    return true;
}

inline long ig_temporal_floor_div(long value, long divisor) {
    long quotient = value / divisor;
    long remainder = value % divisor;
    return remainder < 0L ? quotient - 1L : quotient;
}

// Parse the wall-clock portion of a named datetime without resolving it yet. Truncation is defined
// over that local wall clock; only the final DATETIME/TIME result needs the transition table.
__attribute__((noinline)) bool ig_temporal_truncate_named_datetime_source(
    device const uchar* bytes,
    uint start,
    uint end,
    thread IgTemporalTruncateSource& source) {
    uint opening = end;
    uint closing = end;
    for (uint index = start; index < end; ++index) {
        if (bytes[index] == uchar('[')) {
            if (opening != end) return false;
            opening = index;
        } else if (bytes[index] == uchar(']')) {
            if (closing != end) return false;
            closing = index;
        }
    }
    if (opening == end || closing != end - 1u || opening == start
            || opening + 1u == closing) return false;
    uint separator = opening;
    for (uint index = start; index < opening; ++index) {
        if (bytes[index] == uchar('T') || bytes[index] == uchar('t')) {
            if (separator != opening) return false;
            separator = index;
        }
    }
    if (separator == opening || separator == start || separator + 1u == opening
            || !ig_temporal_parse_date(bytes, start, separator, source.epoch_days)) return false;
    bool has_declared_offset = false;
    for (uint index = separator + 1u; index < opening; ++index) {
        uchar value = bytes[index];
        if (value == uchar('Z') || value == uchar('z')
                || value == uchar('+') || value == uchar('-')) {
            has_declared_offset = true;
            break;
        }
    }
    source.offset_seconds = 0;
    bool parsed_clock = has_declared_offset
        ? ig_temporal_parse_offset_time(
            bytes, separator + 1u, opening, source.clock_nanos, source.offset_seconds)
        : ig_temporal_parse_local_time(
            bytes, separator + 1u, opening, source.clock_nanos);
    if (!parsed_clock) return false;
    source.tag = 8u;
    source.has_declared_offset = has_declared_offset ? 1u : 0u;
    source.zone_start = opening + 1u;
    source.zone_end = closing;
    return true;
}

__attribute__((noinline)) bool ig_temporal_truncate_date_source(
    device const uchar* bytes,
    thread const IgTemporalTruncatePacket& packet,
    thread IgTemporalTruncateSource& source,
    thread bool& is_null) {
    is_null = false;
    source.tag = 7u;
    source.epoch_days = 0L;
    source.clock_nanos = 0L;
    source.offset_seconds = 0;
    source.has_declared_offset = 0u;
    source.zone_start = 0u;
    source.zone_end = 0u;
    if (packet.source_tag == IG_TEMPORAL_TRUNCATE_INPUT_NULL
            && packet.source_start == packet.source_end) {
        is_null = true;
        return true;
    }
    if (packet.source_tag == IG_TEMPORAL_TRUNCATE_INPUT_MAP) {
        IgTemporalMapFields fields;
        if (!ig_temporal_parse_map_fields(bytes, packet.source_start, packet.source_end, fields)) {
            return false;
        }
        if (packet.source_function == 0u) {
            if (!ig_temporal_map_date(bytes, fields, source.epoch_days)) return false;
            source.tag = 1u;
            return true;
        }
        if (packet.source_function == 3u) {
            if (!ig_temporal_map_date(bytes, fields, source.epoch_days)
                    || !ig_temporal_map_clock(fields, source.clock_nanos)) return false;
            source.tag = 4u;
            return true;
        }
        if (packet.source_function == 4u) {
            if (!ig_temporal_map_date(bytes, fields, source.epoch_days)
                    || !ig_temporal_map_clock(fields, source.clock_nanos)) return false;
            if (fields.present[15] == 0u) {
                source.tag = 5u;
                return true;
            }
            if (fields.tags[15] != IG_TEMPORAL_MAP_VALUE_STRING) return false;
            if (ig_temporal_map_offset(
                    bytes, fields.payload_starts[15], fields.payload_ends[15], source.offset_seconds)) {
                source.tag = 5u;
            } else {
                source.tag = 8u;
                source.zone_start = fields.payload_starts[15];
                source.zone_end = fields.payload_ends[15];
                if (source.zone_end <= source.zone_start) return false;
            }
            return true;
        }
        return false;
    }
    if (packet.source_tag != IG_TEMPORAL_TRUNCATE_INPUT_STRING) return false;
    if (packet.source_function == 0u) {
        if (!ig_temporal_parse_date(
                bytes, packet.source_start, packet.source_end, source.epoch_days)) return false;
        source.tag = 1u;
        return true;
    }
    if (packet.source_function == 3u) {
        long seconds = 0L;
        uint nanos = 0u;
        if (!ig_temporal_parse_local_datetime(
                bytes, packet.source_start, packet.source_end, seconds, nanos)) return false;
        source.epoch_days = ig_temporal_floor_div(seconds, 86400L);
        source.clock_nanos = (seconds - source.epoch_days * 86400L) * 1000000000L + long(nanos);
        source.tag = 4u;
        return true;
    }
    if (packet.source_function == 4u) {
        if (ig_temporal_truncate_named_datetime_source(
                bytes, packet.source_start, packet.source_end, source)) return true;
        long seconds = 0L;
        uint nanos = 0u;
        int offset = 0;
        if (!ig_temporal_parse_offset_datetime(
                bytes, packet.source_start, packet.source_end, seconds, nanos, offset)) return false;
        long local_seconds = seconds + long(offset);
        source.epoch_days = ig_temporal_floor_div(local_seconds, 86400L);
        source.clock_nanos = (local_seconds - source.epoch_days * 86400L) * 1000000000L
            + long(nanos);
        source.offset_seconds = offset;
        source.tag = 5u;
        return true;
    }
    return false;
}

// Clock-valued truncate targets cannot consume a DATE source. Keeping their parser separate from
// the date/datetime family bounds the call graph Metal must optimize for each cached pipeline.
__attribute__((noinline)) bool ig_temporal_truncate_clock_source(
    device const uchar* bytes,
    thread const IgTemporalTruncatePacket& packet,
    thread IgTemporalTruncateSource& source,
    thread bool& is_null) {
    is_null = false;
    source.tag = 7u;
    source.epoch_days = 0L;
    source.clock_nanos = 0L;
    source.offset_seconds = 0;
    source.has_declared_offset = 0u;
    source.zone_start = 0u;
    source.zone_end = 0u;
    if (packet.source_tag == IG_TEMPORAL_TRUNCATE_INPUT_NULL
            && packet.source_start == packet.source_end) {
        is_null = true;
        return true;
    }
    if (packet.source_tag == IG_TEMPORAL_TRUNCATE_INPUT_MAP) {
        IgTemporalMapFields fields;
        if (!ig_temporal_parse_map_fields(bytes, packet.source_start, packet.source_end, fields)) {
            return false;
        }
        if (packet.source_function == 1u) {
            if (!ig_temporal_map_clock(fields, source.clock_nanos)) return false;
            source.tag = 2u;
            return true;
        }
        if (packet.source_function == 2u) {
            if (!ig_temporal_map_clock(fields, source.clock_nanos)
                    || !ig_temporal_map_timezone_offset(bytes, fields, source.offset_seconds)) {
                return false;
            }
            source.tag = 3u;
            return true;
        }
        if (packet.source_function == 3u) {
            if (!ig_temporal_map_date(bytes, fields, source.epoch_days)
                    || !ig_temporal_map_clock(fields, source.clock_nanos)) return false;
            source.tag = 4u;
            return true;
        }
        if (packet.source_function == 4u) {
            if (!ig_temporal_map_date(bytes, fields, source.epoch_days)
                    || !ig_temporal_map_clock(fields, source.clock_nanos)) return false;
            if (fields.present[15] == 0u) {
                source.tag = 5u;
                return true;
            }
            if (fields.tags[15] != IG_TEMPORAL_MAP_VALUE_STRING) return false;
            if (ig_temporal_map_offset(
                    bytes, fields.payload_starts[15], fields.payload_ends[15], source.offset_seconds)) {
                source.tag = 5u;
            } else {
                source.tag = 8u;
                source.zone_start = fields.payload_starts[15];
                source.zone_end = fields.payload_ends[15];
                if (source.zone_end <= source.zone_start) return false;
            }
            return true;
        }
        return false;
    }
    if (packet.source_tag != IG_TEMPORAL_TRUNCATE_INPUT_STRING) return false;
    if (packet.source_function == 1u) {
        if (!ig_temporal_parse_local_time(
                bytes, packet.source_start, packet.source_end, source.clock_nanos)) return false;
        source.tag = 2u;
        return true;
    }
    if (packet.source_function == 2u) {
        if (!ig_temporal_parse_time(
                bytes,
                packet.source_start,
                packet.source_end,
                source.clock_nanos,
                source.offset_seconds)) return false;
        source.tag = 3u;
        return true;
    }
    if (packet.source_function == 3u) {
        long seconds = 0L;
        uint nanos = 0u;
        if (!ig_temporal_parse_local_datetime(
                bytes, packet.source_start, packet.source_end, seconds, nanos)) return false;
        source.epoch_days = ig_temporal_floor_div(seconds, 86400L);
        source.clock_nanos = (seconds - source.epoch_days * 86400L) * 1000000000L + long(nanos);
        source.tag = 4u;
        return true;
    }
    if (packet.source_function == 4u) {
        if (ig_temporal_truncate_named_datetime_source(
                bytes, packet.source_start, packet.source_end, source)) return true;
        long seconds = 0L;
        uint nanos = 0u;
        int offset = 0;
        if (!ig_temporal_parse_offset_datetime(
                bytes, packet.source_start, packet.source_end, seconds, nanos, offset)) return false;
        long local_seconds = seconds + long(offset);
        source.epoch_days = ig_temporal_floor_div(local_seconds, 86400L);
        source.clock_nanos = (local_seconds - source.epoch_days * 86400L) * 1000000000L
            + long(nanos);
        source.offset_seconds = offset;
        source.tag = 5u;
        return true;
    }
    return false;
}

__attribute__((noinline)) bool ig_temporal_truncate_date(
    long source_days,
    uchar unit,
    thread long& result_days) {
    long year = 0L;
    uint month = 0u;
    uint day = 0u;
    if (!ig_temporal_civil_from_days(source_days, year, month, day)) return false;
    if (unit == IG_TEMPORAL_TRUNCATE_MILLENNIUM) {
        result_days = ig_temporal_days_from_civil(ig_temporal_floor_div(year, 1000L) * 1000L, 1u, 1u);
    } else if (unit == IG_TEMPORAL_TRUNCATE_CENTURY) {
        result_days = ig_temporal_days_from_civil(ig_temporal_floor_div(year, 100L) * 100L, 1u, 1u);
    } else if (unit == IG_TEMPORAL_TRUNCATE_DECADE) {
        result_days = ig_temporal_days_from_civil(ig_temporal_floor_div(year, 10L) * 10L, 1u, 1u);
    } else if (unit == IG_TEMPORAL_TRUNCATE_YEAR) {
        result_days = ig_temporal_days_from_civil(year, 1u, 1u);
    } else if (unit == IG_TEMPORAL_TRUNCATE_WEEK_YEAR) {
        long iso_year = 0L;
        uint iso_week = 0u;
        uint iso_weekday = 0u;
        if (!ig_temporal_iso_from_days(source_days, iso_year, iso_week, iso_weekday)
                || !ig_temporal_iso_week_days(iso_year, 1u, 1u, result_days)) return false;
    } else if (unit == IG_TEMPORAL_TRUNCATE_QUARTER) {
        result_days = ig_temporal_days_from_civil(year, ((month - 1u) / 3u) * 3u + 1u, 1u);
    } else if (unit == IG_TEMPORAL_TRUNCATE_MONTH) {
        result_days = ig_temporal_days_from_civil(year, month, 1u);
    } else if (unit == IG_TEMPORAL_TRUNCATE_WEEK) {
        result_days = source_days - long(ig_temporal_iso_weekday_from_epoch(source_days) - 1u);
    } else if (unit == IG_TEMPORAL_TRUNCATE_DAY) {
        result_days = source_days;
    } else {
        return false;
    }
    return true;
}

__attribute__((noinline)) bool ig_temporal_truncate_apply_date(
    thread const IgTemporalMapFields& fields,
    bool has_fields,
    long base_days,
    thread long& result_days) {
    result_days = base_days;
    if (!has_fields) return true;
    bool week_mode = fields.present[4] != 0u || fields.present[5] != 0u;
    bool ordinal_mode = fields.present[6] != 0u;
    bool quarter_mode = fields.present[7] != 0u || fields.present[8] != 0u;
    if (uint(week_mode) + uint(ordinal_mode) + uint(quarter_mode) > 1u) return false;
    long base_year = 0L;
    uint base_month = 0u;
    uint base_day = 0u;
    if (!ig_temporal_civil_from_days(base_days, base_year, base_month, base_day)) return false;
    bool has_year = false;
    long year = 0L;
    if (!ig_temporal_map_optional_integer(fields, 1u, has_year, year)) return false;
    if (!has_year) year = base_year;
    if (week_mode) {
        long iso_year = 0L;
        uint iso_week = 0u;
        uint iso_weekday = 0u;
        if (!ig_temporal_iso_from_days(base_days, iso_year, iso_week, iso_weekday)) return false;
        if (!has_year) year = iso_year;
        bool has_week = false;
        bool has_weekday = false;
        long week = 0L;
        long weekday = 0L;
        if (!ig_temporal_map_optional_integer(fields, 4u, has_week, week)
                || !ig_temporal_map_optional_integer(fields, 5u, has_weekday, weekday)) return false;
        if (!has_week) week = long(iso_week);
        if (!has_weekday) weekday = long(iso_weekday);
        if (week < 1L || week > 53L || weekday < 1L || weekday > 7L) return false;
        return ig_temporal_iso_week_days(year, uint(week), uint(weekday), result_days);
    }
    if (ordinal_mode) {
        bool has_ordinal = false;
        long ordinal = 0L;
        if (!ig_temporal_map_optional_integer(fields, 6u, has_ordinal, ordinal)
                || !has_ordinal || ordinal < 1L || ordinal > 366L) return false;
        return ig_temporal_ordinal_days(year, uint(ordinal), result_days);
    }
    if (quarter_mode) {
        bool has_quarter = false;
        bool has_day = false;
        long quarter = 0L;
        long day_of_quarter = 0L;
        if (!ig_temporal_map_optional_integer(fields, 7u, has_quarter, quarter)
                || !ig_temporal_map_optional_integer(fields, 8u, has_day, day_of_quarter)) return false;
        if (!has_quarter) quarter = long((base_month - 1u) / 3u + 1u);
        if (!has_day) day_of_quarter = 1L;
        if (quarter < 1L || quarter > 4L || day_of_quarter < 1L) return false;
        uint first_month = (uint(quarter) - 1u) * 3u + 1u;
        long candidate = ig_temporal_days_from_civil(year, first_month, 1u) + day_of_quarter - 1L;
        long candidate_year = 0L;
        uint candidate_month = 0u;
        uint candidate_day = 0u;
        if (!ig_temporal_civil_from_days(candidate, candidate_year, candidate_month, candidate_day)
                || candidate_year != year
                || (candidate_month - 1u) / 3u + 1u != uint(quarter)) return false;
        result_days = candidate;
        return true;
    }
    bool has_month = false;
    bool has_day = false;
    long month = 0L;
    long day = 0L;
    if (!ig_temporal_map_optional_integer(fields, 2u, has_month, month)
            || !ig_temporal_map_optional_integer(fields, 3u, has_day, day)) return false;
    if (!has_month) month = long(base_month);
    if (!has_day) day = long(base_day);
    if (month < 1L || month > 12L || day < 1L || day > 31L) return false;
    return ig_temporal_calendar_days(year, uint(month), uint(day), result_days);
}

__attribute__((noinline)) bool ig_temporal_truncate_clock(
    long source,
    uchar unit,
    thread long& result) {
    const long second = 1000000000L;
    const long day = 86400L * second;
    if (source < 0L || source >= day) return false;
    long divisor = 0L;
    if (unit == IG_TEMPORAL_TRUNCATE_DAY) divisor = day;
    else if (unit == IG_TEMPORAL_TRUNCATE_HOUR) divisor = 3600L * second;
    else if (unit == IG_TEMPORAL_TRUNCATE_MINUTE) divisor = 60L * second;
    else if (unit == IG_TEMPORAL_TRUNCATE_SECOND) divisor = second;
    else if (unit == IG_TEMPORAL_TRUNCATE_MILLISECOND) divisor = 1000000L;
    else if (unit == IG_TEMPORAL_TRUNCATE_MICROSECOND) divisor = 1000L;
    else return false;
    result = (source / divisor) * divisor;
    return true;
}

__attribute__((noinline)) bool ig_temporal_truncate_apply_clock(
    thread const IgTemporalMapFields& fields,
    bool has_fields,
    long base,
    uchar unit,
    thread long& result) {
    result = base;
    if (!has_fields) return true;
    const long second_nanos = 1000000000L;
    long base_seconds = base / second_nanos;
    bool has_hour = false;
    bool has_minute = false;
    bool has_second = false;
    bool has_millisecond = false;
    bool has_microsecond = false;
    bool has_nanosecond = false;
    long hour = 0L;
    long minute = 0L;
    long second = 0L;
    long millisecond = 0L;
    long microsecond = 0L;
    long nanosecond = 0L;
    if (!ig_temporal_map_optional_integer(fields, 9u, has_hour, hour)
            || !ig_temporal_map_optional_integer(fields, 10u, has_minute, minute)
            || !ig_temporal_map_optional_integer(fields, 11u, has_second, second)
            || !ig_temporal_map_optional_integer(fields, 12u, has_millisecond, millisecond)
            || !ig_temporal_map_optional_integer(fields, 13u, has_microsecond, microsecond)
            || !ig_temporal_map_optional_integer(fields, 14u, has_nanosecond, nanosecond)) {
        return false;
    }
    if (!has_hour) hour = base_seconds / 3600L;
    if (!has_minute) minute = (base_seconds / 60L) % 60L;
    if (!has_second) second = base_seconds % 60L;
    if (hour < 0L || hour > 23L || minute < 0L || minute > 59L
            || second < 0L || second > 59L) return false;
    long base_fraction = base % second_nanos;
    long fraction = base_fraction;
    if (has_millisecond) {
        if (!has_microsecond) microsecond = 0L;
        if (!has_nanosecond) nanosecond = 0L;
        if (millisecond < 0L || millisecond > 999L || microsecond < 0L || microsecond > 999L
                || nanosecond < 0L || nanosecond > 999L) return false;
        fraction = millisecond * 1000000L + microsecond * 1000L + nanosecond;
    } else if (has_microsecond) {
        if (!has_nanosecond) nanosecond = 0L;
        if (unit == IG_TEMPORAL_TRUNCATE_MILLISECOND) {
            if (microsecond < 0L || microsecond > 999L || nanosecond < 0L || nanosecond > 999L) {
                return false;
            }
            fraction = (base_fraction / 1000000L) * 1000000L
                + microsecond * 1000L + nanosecond;
        } else {
            if (microsecond < 0L || microsecond > 999999L
                    || nanosecond < 0L || nanosecond > 999L) return false;
            fraction = microsecond * 1000L + nanosecond;
        }
    } else if (has_nanosecond) {
        if (unit == IG_TEMPORAL_TRUNCATE_MILLISECOND
                || unit == IG_TEMPORAL_TRUNCATE_MICROSECOND) {
            if (nanosecond < 0L || nanosecond > 999L) return false;
            fraction = (base_fraction / 1000L) * 1000L + nanosecond;
        } else {
            if (nanosecond < 0L || nanosecond >= second_nanos) return false;
            fraction = nanosecond;
        }
    }
    result = (hour * 3600L + minute * 60L + second) * second_nanos + fraction;
    return result >= 0L && result < 86400L * second_nanos;
}

__attribute__((noinline)) bool ig_temporal_truncate_timezone(
    device const uchar* bytes,
    thread const IgTemporalMapFields& fields,
    bool has_fields,
    thread bool& has_override,
    thread bool& named,
    thread int& offset_seconds,
    thread uint& zone_start,
    thread uint& zone_end) {
    has_override = has_fields && fields.present[15] != 0u;
    named = false;
    offset_seconds = 0;
    zone_start = 0u;
    zone_end = 0u;
    if (!has_override) return true;
    if (fields.tags[15] != IG_TEMPORAL_MAP_VALUE_STRING) return false;
    zone_start = fields.payload_starts[15];
    zone_end = fields.payload_ends[15];
    if (ig_temporal_map_offset(bytes, zone_start, zone_end, offset_seconds)) return true;
    named = zone_end > zone_start;
    return named;
}

// DATE has its own bounded entry point. It deliberately cannot reach clock-result formatting or
// timezone resolution, keeping first-use pipeline compilation independent of those larger paths.
kernel void ig_temporal_truncate_date_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant NamedDateTimeProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8u;
    for (uint word = 0u; word < 8u; ++word) output[output_base + word] = 0u;
    output[output_base] = 7u;
    if (input_tags[row] != IG_TEMPORAL_TRUNCATE_INPUT_MAP) return;
    IgTemporalTruncatePacket packet;
    if (!ig_temporal_parse_truncate_packet(utf8, offsets[row], offsets[row + 1], packet)
            || !ig_temporal_truncate_target_supports(0u, packet.unit)) return;
    IgTemporalMapFields fields;
    bool has_fields = packet.map_tag == IG_TEMPORAL_TRUNCATE_INPUT_MAP;
    if (has_fields) {
        if (!ig_temporal_parse_map_fields(utf8, packet.map_start, packet.map_end, fields)) return;
    } else if (packet.map_tag != IG_TEMPORAL_TRUNCATE_INPUT_NULL
            || packet.map_start != packet.map_end) {
        return;
    }
    if (!ig_temporal_truncate_validate_fields(0u, packet.unit, has_fields, fields)) return;
    IgTemporalTruncateSource source;
    bool is_null = false;
    if (!ig_temporal_truncate_date_source(utf8, packet, source, is_null)) return;
    if (is_null) {
        output[output_base] = 0u;
        return;
    }

    if (source.tag != 1u && source.tag != 4u && source.tag != 5u && source.tag != 8u) return;
    long days = source.epoch_days;
    if (!ig_temporal_truncate_date(days, packet.unit, days)
            || !ig_temporal_truncate_apply_date(fields, has_fields, days, days)) return;
    output[output_base] = 1u;
    ulong bits = as_type<ulong>(days);
    output[output_base + 1u] = uint(bits);
    output[output_base + 2u] = uint(bits >> 32);
}

kernel void ig_temporal_truncate_local_time_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant NamedDateTimeProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8u;
    for (uint word = 0u; word < 8u; ++word) output[output_base + word] = 0u;
    output[output_base] = 7u;
    if (input_tags[row] != ((1u << 2u) | IG_TEMPORAL_TRUNCATE_INPUT_MAP)) return;
    IgTemporalTruncatePacket packet;
    if (!ig_temporal_parse_truncate_packet(utf8, offsets[row], offsets[row + 1u], packet)
            || !ig_temporal_truncate_target_supports(1u, packet.unit)) return;
    IgTemporalMapFields fields;
    bool has_fields = packet.map_tag == IG_TEMPORAL_TRUNCATE_INPUT_MAP;
    if (has_fields) {
        if (!ig_temporal_parse_map_fields(utf8, packet.map_start, packet.map_end, fields)) return;
    } else if (packet.map_tag != IG_TEMPORAL_TRUNCATE_INPUT_NULL
            || packet.map_start != packet.map_end) {
        return;
    }
    if (!ig_temporal_truncate_validate_fields(1u, packet.unit, has_fields, fields)) return;
    IgTemporalTruncateSource source;
    bool is_null = false;
    if (!ig_temporal_truncate_clock_source(utf8, packet, source, is_null)) return;
    if (is_null) {
        output[output_base] = 0u;
        return;
    }
    if (source.tag != 2u && source.tag != 3u && source.tag != 4u
            && source.tag != 5u && source.tag != 8u) return;
    long clock = source.clock_nanos;
    if (!ig_temporal_truncate_clock(clock, packet.unit, clock)
            || !ig_temporal_truncate_apply_clock(fields, has_fields, clock, packet.unit, clock)) {
        return;
    }
    ulong raw = as_type<ulong>(clock);
    output[output_base] = 2u;
    output[output_base + 1u] = uint(raw);
    output[output_base + 2u] = uint(raw >> 32u);
}

kernel void ig_temporal_truncate_time_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant NamedDateTimeProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8u;
    for (uint word = 0u; word < 8u; ++word) output[output_base + word] = 0u;
    output[output_base] = 7u;
    if (input_tags[row] != ((2u << 2u) | IG_TEMPORAL_TRUNCATE_INPUT_MAP)) return;
    IgTemporalTruncatePacket packet;
    if (!ig_temporal_parse_truncate_packet(utf8, offsets[row], offsets[row + 1u], packet)
            || !ig_temporal_truncate_target_supports(2u, packet.unit)) return;
    IgTemporalMapFields fields;
    bool has_fields = packet.map_tag == IG_TEMPORAL_TRUNCATE_INPUT_MAP;
    if (has_fields) {
        if (!ig_temporal_parse_map_fields(utf8, packet.map_start, packet.map_end, fields)) return;
    } else if (packet.map_tag != IG_TEMPORAL_TRUNCATE_INPUT_NULL
            || packet.map_start != packet.map_end) {
        return;
    }
    if (!ig_temporal_truncate_validate_fields(2u, packet.unit, has_fields, fields)) return;
    IgTemporalTruncateSource source;
    bool is_null = false;
    if (!ig_temporal_truncate_clock_source(utf8, packet, source, is_null)) return;
    if (is_null) {
        output[output_base] = 0u;
        return;
    }
    if (source.tag != 2u && source.tag != 3u && source.tag != 4u
            && source.tag != 5u && source.tag != 8u) return;
    long clock = source.clock_nanos;
    if (!ig_temporal_truncate_clock(clock, packet.unit, clock)
            || !ig_temporal_truncate_apply_clock(fields, has_fields, clock, packet.unit, clock)) {
        return;
    }

    bool has_override = false;
    bool named_override = false;
    int offset_seconds = 0;
    uint zone_start = 0u;
    uint zone_end = 0u;
    if (!ig_temporal_truncate_timezone(
            utf8,
            fields,
            has_fields,
            has_override,
            named_override,
            offset_seconds,
            zone_start,
            zone_end)
            || named_override) return;
    if (!has_override) {
        if (source.tag == 3u || source.tag == 5u) {
            offset_seconds = source.offset_seconds;
        } else if (source.tag == 8u) {
            long local_seconds = source.epoch_days * 86400L
                + source.clock_nanos / 1000000000L;
            long resolved_seconds = 0L;
            uint ignored_zone_index = 0u;
            if (!ig_temporal_resolve_named_local(
                    utf8,
                    source.zone_start,
                    source.zone_end,
                    local_seconds,
                    source.has_declared_offset != 0u,
                    source.offset_seconds,
                    args.zone_table_start,
                    args.zone_table_end,
                    args.zone_count,
                    resolved_seconds,
                    ignored_zone_index)) return;
            long resolved_offset = local_seconds - resolved_seconds;
            if (resolved_offset < -2147483648L || resolved_offset > 2147483647L) return;
            offset_seconds = int(resolved_offset);
        }
    }
    ulong raw = as_type<ulong>(clock);
    output[output_base] = 3u;
    output[output_base + 1u] = uint(raw);
    output[output_base + 2u] = uint(raw >> 32u);
    output[output_base + 3u] = as_type<uint>(offset_seconds);
}

kernel void ig_temporal_truncate_local_datetime_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant NamedDateTimeProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8u;
    for (uint word = 0u; word < 8u; ++word) output[output_base + word] = 0u;
    output[output_base] = 7u;
    if (input_tags[row] != ((3u << 2u) | IG_TEMPORAL_TRUNCATE_INPUT_MAP)) return;
    IgTemporalTruncatePacket packet;
    if (!ig_temporal_parse_truncate_packet(utf8, offsets[row], offsets[row + 1u], packet)
            || !ig_temporal_truncate_target_supports(3u, packet.unit)) return;
    IgTemporalMapFields fields;
    bool has_fields = packet.map_tag == IG_TEMPORAL_TRUNCATE_INPUT_MAP;
    if (has_fields) {
        if (!ig_temporal_parse_map_fields(utf8, packet.map_start, packet.map_end, fields)) return;
    } else if (packet.map_tag != IG_TEMPORAL_TRUNCATE_INPUT_NULL
            || packet.map_start != packet.map_end) {
        return;
    }
    if (!ig_temporal_truncate_validate_fields(3u, packet.unit, has_fields, fields)) return;
    IgTemporalTruncateSource source;
    bool is_null = false;
    if (!ig_temporal_truncate_date_source(utf8, packet, source, is_null)) return;
    if (is_null) {
        output[output_base] = 0u;
        return;
    }
    if (source.tag != 1u && source.tag != 4u && source.tag != 5u && source.tag != 8u) return;
    bool date_unit = ig_temporal_truncate_is_date_unit(packet.unit);
    if (!date_unit && source.tag == 1u) return;
    long days = source.epoch_days;
    long clock = source.clock_nanos;
    if (date_unit) {
        if (!ig_temporal_truncate_date(days, packet.unit, days)) return;
        clock = 0L;
    } else if (!ig_temporal_truncate_clock(clock, packet.unit, clock)) {
        return;
    }
    if (!ig_temporal_truncate_apply_date(fields, has_fields, days, days)
            || !ig_temporal_truncate_apply_clock(
                fields, has_fields, clock, packet.unit, clock)) return;
    long seconds = days * 86400L + clock / 1000000000L;
    uint nanos = uint(clock % 1000000000L);
    ulong raw = as_type<ulong>(seconds);
    output[output_base] = 4u;
    output[output_base + 1u] = uint(raw);
    output[output_base + 2u] = uint(raw >> 32u);
    output[output_base + 3u] = nanos;
}

kernel void ig_temporal_truncate_datetime_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant NamedDateTimeProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8u;
    for (uint word = 0u; word < 8u; ++word) output[output_base + word] = 0u;
    output[output_base] = 7u;
    if (input_tags[row] != ((4u << 2u) | IG_TEMPORAL_TRUNCATE_INPUT_MAP)) return;
    IgTemporalTruncatePacket packet;
    if (!ig_temporal_parse_truncate_packet(utf8, offsets[row], offsets[row + 1u], packet)
            || !ig_temporal_truncate_target_supports(4u, packet.unit)) return;
    IgTemporalMapFields fields;
    bool has_fields = packet.map_tag == IG_TEMPORAL_TRUNCATE_INPUT_MAP;
    if (has_fields) {
        if (!ig_temporal_parse_map_fields(utf8, packet.map_start, packet.map_end, fields)) return;
    } else if (packet.map_tag != IG_TEMPORAL_TRUNCATE_INPUT_NULL
            || packet.map_start != packet.map_end) {
        return;
    }
    if (!ig_temporal_truncate_validate_fields(4u, packet.unit, has_fields, fields)) return;
    IgTemporalTruncateSource source;
    bool is_null = false;
    if (!ig_temporal_truncate_date_source(utf8, packet, source, is_null)) return;
    if (is_null) {
        output[output_base] = 0u;
        return;
    }
    if (source.tag != 1u && source.tag != 4u && source.tag != 5u && source.tag != 8u) return;
    bool date_unit = ig_temporal_truncate_is_date_unit(packet.unit);
    if (!date_unit && source.tag == 1u) return;
    long days = source.epoch_days;
    long clock = source.clock_nanos;
    if (date_unit) {
        if (!ig_temporal_truncate_date(days, packet.unit, days)) return;
        clock = 0L;
    } else if (!ig_temporal_truncate_clock(clock, packet.unit, clock)) {
        return;
    }
    if (!ig_temporal_truncate_apply_date(fields, has_fields, days, days)
            || !ig_temporal_truncate_apply_clock(
                fields, has_fields, clock, packet.unit, clock)) return;
    long local_seconds = days * 86400L + clock / 1000000000L;
    uint nanos = uint(clock % 1000000000L);

    bool has_override = false;
    bool named_zone = false;
    int offset_seconds = 0;
    uint zone_start = 0u;
    uint zone_end = 0u;
    if (!ig_temporal_truncate_timezone(
            utf8,
            fields,
            has_fields,
            has_override,
            named_zone,
            offset_seconds,
            zone_start,
            zone_end)) return;
    if (!has_override) {
        if (source.tag == 5u) {
            offset_seconds = source.offset_seconds;
        } else if (source.tag == 8u) {
            named_zone = true;
            zone_start = source.zone_start;
            zone_end = source.zone_end;
        }
    }
    long seconds = local_seconds;
    uint zone_index = 0u;
    if (named_zone) {
        if (!ig_temporal_resolve_named_local(
                utf8,
                zone_start,
                zone_end,
                local_seconds,
                false,
                0,
                args.zone_table_start,
                args.zone_table_end,
                args.zone_count,
                seconds,
                zone_index)) return;
    } else {
        seconds -= long(offset_seconds);
    }
    ulong raw = as_type<ulong>(seconds);
    output[output_base] = named_zone ? 8u : 5u;
    output[output_base + 1u] = uint(raw);
    output[output_base + 2u] = uint(raw >> 32u);
    output[output_base + 3u] = nanos;
    output[output_base + 4u] = named_zone ? zone_index : as_type<uint>(offset_seconds);
}

kernel void ig_temporal_named_datetime_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant NamedDateTimeProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar input_tag = input_tags[row] & 3;
    if (input_tag == 0) {
        output[output_base] = 0;
        return;
    }
    output[output_base] = 7;
    if (input_tag != 1 && input_tag != 3) return;
    long seconds = 0;
    uint nanos = 0;
    uint zone_index = 0;
    bool parsed = input_tag == 1
        ? ig_temporal_parse_named_datetime(
            utf8,
            offsets[row],
            offsets[row + 1],
            args.zone_table_start,
            args.zone_table_end,
            args.zone_count,
            seconds,
            nanos,
            zone_index)
        : ig_temporal_parse_named_map_datetime(
            utf8,
            offsets[row],
            offsets[row + 1],
            args.zone_table_start,
            args.zone_table_end,
            args.zone_count,
            seconds,
            nanos,
            zone_index);
    if (!parsed) return;
    output[output_base] = 8;
    output[output_base + 1] = uint(as_type<ulong>(seconds));
    output[output_base + 2] = uint(as_type<ulong>(seconds) >> 32);
    output[output_base + 3] = nanos;
    output[output_base + 4] = zone_index;
}

kernel void ig_temporal_value_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar packed_tag = input_tags[row];
    uchar input_tag = packed_tag & 3;
    uchar function = packed_tag >> 2;
    if (input_tag == 0) {
        output[output_base] = 0;
        return;
    }
    output[output_base] = 7;
    if (input_tag != 1) return;
    uint start = offsets[row];
    uint end = offsets[row + 1];
    if (function == 0) {
        long epoch_days = 0;
        if (!ig_temporal_parse_date(utf8, start, end, epoch_days)) return;
        output[output_base] = 1;
        ulong bits = as_type<ulong>(epoch_days);
        output[output_base + 1] = uint(bits);
        output[output_base + 2] = uint(bits >> 32);
    } else if (function == 1) {
        long nanos = 0;
        if (!ig_temporal_parse_local_time(utf8, start, end, nanos)) return;
        output[output_base] = 2;
        output[output_base + 1] = uint(as_type<ulong>(nanos));
        output[output_base + 2] = uint(as_type<ulong>(nanos) >> 32);
    } else if (function == 2) {
        long nanos = 0;
        int offset_seconds = 0;
        if (!ig_temporal_parse_time(utf8, start, end, nanos, offset_seconds)) return;
        output[output_base] = 3;
        output[output_base + 1] = uint(as_type<ulong>(nanos));
        output[output_base + 2] = uint(as_type<ulong>(nanos) >> 32);
        output[output_base + 3] = as_type<uint>(offset_seconds);
    } else if (function == 3) {
        long seconds = 0;
        uint nanos = 0;
        if (!ig_temporal_parse_local_datetime(utf8, start, end, seconds, nanos)) return;
        output[output_base] = 4;
        output[output_base + 1] = uint(as_type<ulong>(seconds));
        output[output_base + 2] = uint(as_type<ulong>(seconds) >> 32);
        output[output_base + 3] = nanos;
    } else if (function == 4) {
        long seconds = 0;
        uint nanos = 0;
        int offset_seconds = 0;
        if (!ig_temporal_parse_offset_datetime(
                utf8, start, end, seconds, nanos, offset_seconds)) return;
        output[output_base] = 5;
        output[output_base + 1] = uint(as_type<ulong>(seconds));
        output[output_base + 2] = uint(as_type<ulong>(seconds) >> 32);
        output[output_base + 3] = nanos;
        output[output_base + 4] = as_type<uint>(offset_seconds);
    }
}

struct RangeProgramArgs {
    ulong max_values;
    ulong dispatch_base;
    ulong dispatch_count;
};

// Output slot zero is a device-produced header: >= 0 is the element count, -1 is an invalid
// zero step, and -2 means the bounded query output cannot admit the whole range.  Every other
// slot is generated independently, so a range stays parallel and resident rather than being
// expanded through a host loop.
kernel void ig_range_program(
    device const long* input [[buffer(0)]],
    device long* output [[buffer(1)]],
    constant RangeProgramArgs& args [[buffer(2)]],
    uint slot_index [[thread_position_in_grid]]) {
    ulong local_slot = ulong(slot_index);
    if (local_slot >= args.dispatch_count
            || args.dispatch_base > args.max_values
            || local_slot > args.max_values - args.dispatch_base) return;
    ulong slot = args.dispatch_base + local_slot;
    long start = input[0];
    long end = input[1];
    long step = input[2];
    if (input[3] != 1 || input[4] != 1 || input[5] != 1) {
        if (slot == 0) output[0] = -3;
        return;
    }
    if (step == 0) {
        if (slot == 0) output[0] = -1;
        return;
    }
    if ((step > 0 && start > end) || (step < 0 && start < end)) {
        if (slot == 0) output[0] = 0;
        return;
    }
    ulong distance = step > 0
        ? as_type<ulong>(end) - as_type<ulong>(start)
        : as_type<ulong>(start) - as_type<ulong>(end);
    ulong magnitude = step > 0
        ? as_type<ulong>(step)
        : ulong(0) - as_type<ulong>(step);
    ulong quotient = distance / magnitude;
    // count is quotient + 1, so compare before adding to avoid the full signed-domain case from
    // overflowing an unsigned intermediate.
    if (quotient >= args.max_values) {
        if (slot == 0) output[0] = -2;
        return;
    }
    ulong count = quotient + 1;
    if (slot == 0) {
        output[0] = long(count);
        return;
    }
    ulong index = ulong(slot) - 1;
    if (index < count) {
        // The admitted count proves the mathematical result is in signed i64. Modular arithmetic
        // reproduces that exact two's-complement value without a signed-overflow intermediate.
        ulong value = as_type<ulong>(start) + index * as_type<ulong>(step);
        output[slot] = as_type<long>(value);
    }
}

// Dedicated sealed program for:
//   UNWIND range(start, end, step) AS value
//   LIMIT ... [one or more sequential stages]
//   RETURN sum(value)
//
// The descriptor and result are immutable bit-pattern packets. Rust uploads the descriptor as an
// I64 tensor, so every metadata field is recovered with as_type<ulong>; only start/end/step retain
// signed arithmetic meaning. The result remains device-authored: the host never materializes the
// range or computes stage cardinalities/the aggregate on its behalf.
constant ulong IG_SEGMENTED_RANGE_SUM_INPUT_MAGIC = 0x47535253554d494eul;
constant ulong IG_SEGMENTED_RANGE_SUM_OUTPUT_MAGIC = 0x47535253554d4f55ul;
constant ulong IG_SEGMENTED_RANGE_SUM_ABI_VERSION = 1ul;
constant uint IG_SEGMENTED_RANGE_SUM_HEADER_WORDS = 14u;
constant uint IG_SEGMENTED_RANGE_SUM_THREADS = 256u;

constant uint IG_SEGMENTED_RANGE_SUM_STATUS_NOT_EXECUTED = 0u;
constant uint IG_SEGMENTED_RANGE_SUM_STATUS_SUCCESS = 1u;
constant uint IG_SEGMENTED_RANGE_SUM_STATUS_INVALID_DESCRIPTOR = 2u;
constant uint IG_SEGMENTED_RANGE_SUM_STATUS_RANGE_TYPE = 3u;
constant uint IG_SEGMENTED_RANGE_SUM_STATUS_ZERO_STEP = 4u;
constant uint IG_SEGMENTED_RANGE_SUM_STATUS_RANGE_BUDGET = 5u;
constant uint IG_SEGMENTED_RANGE_SUM_STATUS_INTERMEDIATE_BUDGET = 6u;
constant uint IG_SEGMENTED_RANGE_SUM_STATUS_FINAL_SUM_OVERFLOW = 7u;

struct IgSegmentedRangeSumProgramArgs {
    uint limit_count;
    uint output_word_count;
    uint reserved0;
    uint reserved1;
};

inline void ig_segmented_range_sum_initialize_output(
    device const long* descriptor,
    device ulong* output,
    constant IgSegmentedRangeSumProgramArgs& args) {
    output[0] = IG_SEGMENTED_RANGE_SUM_OUTPUT_MAGIC;
    output[1] = IG_SEGMENTED_RANGE_SUM_ABI_VERSION;
    output[2] = ulong(IG_SEGMENTED_RANGE_SUM_STATUS_NOT_EXECUTED);
    output[3] = as_type<ulong>(descriptor[2]);
    output[4] = as_type<ulong>(descriptor[3]);
    output[5] = 0ul;
    output[6] = 0ul;
    output[7] = 0ul;
    output[8] = ulong(args.limit_count);
    output[9] = ulong(args.output_word_count);
    output[10] = as_type<ulong>(descriptor[13]);
    output[11] = as_type<ulong>(descriptor[14]);
    output[12] = as_type<ulong>(descriptor[15]);
    output[13] = as_type<ulong>(descriptor[16]);
    for (uint limit_index = 0u; limit_index < args.limit_count; ++limit_index) {
        output[IG_SEGMENTED_RANGE_SUM_HEADER_WORDS + limit_index] = 0ul;
    }
}

inline void ig_segmented_range_sum_add_pair(
    thread ulong& low,
    thread ulong& high,
    ulong add_low,
    ulong add_high) {
    ulong prior_low = low;
    low += add_low;
    high += add_high + ulong(low < prior_low);
}

kernel void ig_segmented_range_sum_program(
    device const long* descriptor [[buffer(0)]],
    device const uint* limits [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant IgSegmentedRangeSumProgramArgs& args [[buffer(3)]],
    uint lane [[thread_index_in_threadgroup]],
    uint3 group_position [[threadgroup_position_in_grid]],
    uint3 group_count [[threadgroups_per_grid]],
    uint3 group_size [[threads_per_threadgroup]]) {
    threadgroup ulong partial_low[IG_SEGMENTED_RANGE_SUM_THREADS];
    threadgroup ulong partial_high[IG_SEGMENTED_RANGE_SUM_THREADS];
    threadgroup ulong selected_rows;
    threadgroup uint shared_status;

    bool valid_dispatch = group_count.x == 1u
        && group_count.y == 1u
        && group_count.z == 1u
        && group_position.x == 0u
        && group_position.y == 0u
        && group_position.z == 0u
        && group_size.x == IG_SEGMENTED_RANGE_SUM_THREADS
        && group_size.y == 1u
        && group_size.z == 1u;
    if (!valid_dispatch) {
        if (lane == 0u) {
            ig_segmented_range_sum_initialize_output(descriptor, output, args);
            output[2] = ulong(IG_SEGMENTED_RANGE_SUM_STATUS_INVALID_DESCRIPTOR);
        }
        return;
    }

    if (lane == 0u) {
        ig_segmented_range_sum_initialize_output(descriptor, output, args);
        shared_status = IG_SEGMENTED_RANGE_SUM_STATUS_SUCCESS;
        selected_rows = 0ul;

        ulong descriptor_limit_count = as_type<ulong>(descriptor[12]);
        ulong expected_output_words = ulong(IG_SEGMENTED_RANGE_SUM_HEADER_WORDS)
            + ulong(args.limit_count);
        ulong max_values = as_type<ulong>(descriptor[10]);
        ulong maximum_intermediate_rows = as_type<ulong>(descriptor[11]);
        bool valid_descriptor = as_type<ulong>(descriptor[0])
                == IG_SEGMENTED_RANGE_SUM_INPUT_MAGIC
            && as_type<ulong>(descriptor[1]) == IG_SEGMENTED_RANGE_SUM_ABI_VERSION
            && descriptor_limit_count == ulong(args.limit_count)
            && args.limit_count != 0u
            && expected_output_words <= ulong(0xffffffffu)
            && ulong(args.output_word_count) == expected_output_words
            && args.reserved0 == 0u
            && args.reserved1 == 0u
            && maximum_intermediate_rows <= ulong(0xffffffffu);
        if (!valid_descriptor) {
            shared_status = IG_SEGMENTED_RANGE_SUM_STATUS_INVALID_DESCRIPTOR;
        } else if (as_type<ulong>(descriptor[7]) != 1ul
                || as_type<ulong>(descriptor[8]) != 1ul
                || as_type<ulong>(descriptor[9]) != 1ul) {
            shared_status = IG_SEGMENTED_RANGE_SUM_STATUS_RANGE_TYPE;
        } else {
            long start = descriptor[4];
            long end = descriptor[5];
            long step = descriptor[6];
            if (step == 0) {
                shared_status = IG_SEGMENTED_RANGE_SUM_STATUS_ZERO_STEP;
            } else {
                ulong source_count = 0ul;
                bool empty = (step > 0 && start > end) || (step < 0 && start < end);
                if (!empty) {
                    // This is the same inclusive-endpoint cardinality calculation as
                    // ig_range_program. Unsigned differences avoid overflow across zero, and the
                    // pre-increment comparison handles the full signed-domain range.
                    ulong distance = step > 0
                        ? as_type<ulong>(end) - as_type<ulong>(start)
                        : as_type<ulong>(start) - as_type<ulong>(end);
                    ulong magnitude = step > 0
                        ? as_type<ulong>(step)
                        : 0ul - as_type<ulong>(step);
                    ulong quotient = distance / magnitude;
                    if (quotient >= max_values) {
                        shared_status = IG_SEGMENTED_RANGE_SUM_STATUS_RANGE_BUDGET;
                    } else {
                        source_count = quotient + 1ul;
                    }
                }
                if (shared_status == IG_SEGMENTED_RANGE_SUM_STATUS_SUCCESS) {
                    output[5] = source_count;
                    ulong current = source_count;
                    for (uint limit_index = 0u;
                            limit_index < args.limit_count;
                            ++limit_index) {
                        current = min(current, ulong(limits[limit_index]));
                        output[IG_SEGMENTED_RANGE_SUM_HEADER_WORDS + limit_index] = current;
                    }
                    output[6] = current;
                    selected_rows = current;
                    if (current > maximum_intermediate_rows) {
                        shared_status =
                            IG_SEGMENTED_RANGE_SUM_STATUS_INTERMEDIATE_BUDGET;
                    }
                }
            }
        }
        if (shared_status != IG_SEGMENTED_RANGE_SUM_STATUS_SUCCESS) {
            output[2] = ulong(shared_status);
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (shared_status != IG_SEGMENTED_RANGE_SUM_STATUS_SUCCESS) return;

    long start = descriptor[4];
    long step = descriptor[6];
    ulong local_low = 0ul;
    ulong local_high = 0ul;
    for (ulong index = ulong(lane);
            index < selected_rows;
            index += ulong(IG_SEGMENTED_RANGE_SUM_THREADS)) {
        // Cardinality admission proves each modular value is the exact signed i64 range value.
        ulong value = as_type<ulong>(start) + index * as_type<ulong>(step);
        ulong sign_extension = (value & 0x8000000000000000ul) != 0ul ? ~0ul : 0ul;
        ig_segmented_range_sum_add_pair(
            local_low, local_high, value, sign_extension);
    }
    partial_low[lane] = local_low;
    partial_high[lane] = local_high;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint stride = IG_SEGMENTED_RANGE_SUM_THREADS >> 1u;
            stride != 0u;
            stride >>= 1u) {
        if (lane < stride) {
            ulong prior_low = partial_low[lane];
            ulong next_low = prior_low + partial_low[lane + stride];
            partial_high[lane] += partial_high[lane + stride]
                + ulong(next_low < prior_low);
            partial_low[lane] = next_low;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    if (lane == 0u) {
        ulong sum_low = partial_low[0];
        ulong sum_high = partial_high[0];
        bool negative = (sum_low & 0x8000000000000000ul) != 0ul;
        bool fits_i64 = negative ? sum_high == ~0ul : sum_high == 0ul;
        if (!fits_i64) {
            output[2] = ulong(IG_SEGMENTED_RANGE_SUM_STATUS_FINAL_SUM_OVERFLOW);
        } else {
            output[7] = sum_low;
            output[2] = ulong(IG_SEGMENTED_RANGE_SUM_STATUS_SUCCESS);
        }
    }
}

// The scalar program emits a complete canonical result image. A compact SSA stream is evaluated
// on device before the selected root cells are published, while the cell/map/list tables stay
// packed so result-boundary decoding cannot use compiler-owned host values as a substitute for
// GPU output.
struct ScalarProgramArgs {
    uint output_count;
    uint scalar_cell_count;
    uint map_entry_count;
    uint scalar_list_entry_count;
    uint string_count;
    uint string_byte_count;
    uint instruction_count;
    uint null_cell;
    uint false_cell;
    uint true_cell;
    uint program_word_count;
    uint table_word_count;
    uint receipt_words[8];
};

constant uint IG_SCALAR_PROGRAM_MAX_REGISTERS = 64;
constant uint IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS = 128;
constant uint IG_SCALAR_PROGRAM_INVALID = 0xffffffffu;
constant uint IG_SCALAR_PROGRAM_MAP_KEY_TYPE = 0xfffffffeu;
constant uint IG_SCALAR_PROGRAM_INDEX_SOURCE_TYPE = 0xfffffffdu;
constant uint IG_SCALAR_PROGRAM_LIST_INDEX_TYPE = 0xfffffffcu;
constant uint IG_SCALAR_PROGRAM_CORRUPT = 0xfffffffbu;

inline bool ig_scalar_program_is_semantic_status(uint value) {
    return value == IG_SCALAR_PROGRAM_INVALID
        || value == IG_SCALAR_PROGRAM_MAP_KEY_TYPE
        || value == IG_SCALAR_PROGRAM_INDEX_SOURCE_TYPE
        || value == IG_SCALAR_PROGRAM_LIST_INDEX_TYPE;
}

// Defined with the shared Boolean scalar helpers below. Declarations here keep the compact
// scalar-program VM independent of the Boolean-program wire layout while preserving exact
// INTEGER/FLOAT and NaN comparison behavior.
inline bool ig_scalar_f64_equal(ulong left, ulong right);
inline bool ig_scalar_i64_f64_equal(long integer, ulong float_bits);
inline uchar ig_compare_order(int order, uint operation);
inline ulong ig_ordered_f64_bits(ulong bits);
inline bool ig_f64_is_nan(ulong bits);
inline bool ig_scalar_i64_f64_order(long integer, ulong float_bits, thread int& order);
inline bool ig_scalar_program_string_bounds(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint string_cell,
    thread uint& start,
    thread uint& end,
    thread uint& byte_base);
inline bool ig_scalar_program_string_identity_bounds(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    ulong identity,
    thread uint& start,
    thread uint& end,
    thread uint& byte_base);

inline uint ig_scalar_program_cell_word(
    device const uint* tables,
    uint cell,
    uint field) {
    return tables[cell * 4 + field];
}

inline ulong ig_scalar_program_cell_payload(
    device const uint* tables,
    uint cell) {
    return ulong(ig_scalar_program_cell_word(tables, cell, 1))
        | (ulong(ig_scalar_program_cell_word(tables, cell, 2)) << 32);
}

inline uint ig_scalar_program_operand(
    thread const uint* registers,
    uint register_count,
    uint scalar_cell_count,
    uint kind,
    uint index) {
    if (kind == 0) return index < scalar_cell_count ? index : IG_SCALAR_PROGRAM_CORRUPT;
    if (kind == 1) return index < register_count ? registers[index] : IG_SCALAR_PROGRAM_CORRUPT;
    return IG_SCALAR_PROGRAM_CORRUPT;
}

inline uint ig_scalar_program_dynamic_index(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint source_cell,
    uint index_cell) {
    if (ig_scalar_program_is_semantic_status(source_cell)) return source_cell;
    if (ig_scalar_program_is_semantic_status(index_cell)) return index_cell;
    if (source_cell >= args.scalar_cell_count || index_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint source_tag = ig_scalar_program_cell_word(tables, source_cell, 0);
    uint index_tag = ig_scalar_program_cell_word(tables, index_cell, 0);
    if (source_tag == 0u || index_tag == 0u) return args.null_cell;
    if (source_tag == 5u) {
        if (index_tag != 2u) return IG_SCALAR_PROGRAM_LIST_INDEX_TYPE;
        ulong start_payload = ig_scalar_program_cell_payload(tables, source_cell);
        if (start_payload > 0xfffffffful) return IG_SCALAR_PROGRAM_CORRUPT;
        uint start = uint(start_payload);
        uint length = ig_scalar_program_cell_word(tables, source_cell, 3);
        if (start > args.scalar_list_entry_count
                || length > args.scalar_list_entry_count - start) {
            return IG_SCALAR_PROGRAM_CORRUPT;
        }
        long raw_index = as_type<long>(ig_scalar_program_cell_payload(tables, index_cell));
        long normalized = raw_index < 0 ? long(length) + raw_index : raw_index;
        if (normalized < 0 || ulong(normalized) >= ulong(length)) return args.null_cell;
        uint list_base = args.scalar_cell_count * 4u + args.map_entry_count * 2u;
        uint child = tables[list_base + start + uint(normalized)];
        return child < args.scalar_cell_count ? child : IG_SCALAR_PROGRAM_CORRUPT;
    }
    if (source_tag != 6u) return IG_SCALAR_PROGRAM_INDEX_SOURCE_TYPE;
    if (index_tag != 4u) return IG_SCALAR_PROGRAM_MAP_KEY_TYPE;
    ulong start_payload = ig_scalar_program_cell_payload(tables, source_cell);
    if (start_payload > 0xfffffffful) return IG_SCALAR_PROGRAM_CORRUPT;
    uint start = uint(start_payload);
    uint length = ig_scalar_program_cell_word(tables, source_cell, 3);
    if (start > args.map_entry_count || length > args.map_entry_count - start) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint index_start = 0u;
    uint index_end = 0u;
    uint byte_base = 0u;
    if (!ig_scalar_program_string_bounds(
            tables, args, index_cell, index_start, index_end, byte_base)) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint map_base = args.scalar_cell_count * 4u;
    for (uint position = 0u; position < length; ++position) {
        uint entry = map_base + (start + position) * 2u;
        ulong key_identity = ulong(tables[entry]);
        uint key_start = 0u;
        uint key_end = 0u;
        uint key_byte_base = 0u;
        if (!ig_scalar_program_string_identity_bounds(
                tables, args, key_identity, key_start, key_end, key_byte_base)) {
            return IG_SCALAR_PROGRAM_CORRUPT;
        }
        uint key_length = key_end - key_start;
        if (key_length != index_end - index_start) continue;
        bool equal = true;
        for (uint byte = 0u; byte < key_length; ++byte) {
            if (tables[key_byte_base + key_start + byte]
                    != tables[byte_base + index_start + byte]) {
                equal = false;
                break;
            }
        }
        if (equal) {
            uint child = tables[entry + 1u];
            return child < args.scalar_cell_count ? child : IG_SCALAR_PROGRAM_CORRUPT;
        }
    }
    return args.null_cell;
}

inline bool ig_scalar_program_ascii_space(uint byte) {
    return byte == 0x20u || byte == 0x09u || byte == 0x0au
        || byte == 0x0du || byte == 0x0bu || byte == 0x0cu;
}

inline bool ig_scalar_program_string_bounds(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint string_cell,
    thread uint& start,
    thread uint& end,
    thread uint& byte_base) {
    if (string_cell >= args.scalar_cell_count
            || ig_scalar_program_cell_word(tables, string_cell, 0) != 4) return false;
    ulong identity = ig_scalar_program_cell_payload(tables, string_cell);
    uint slot_end = 0u;
    if (!ig_scalar_program_string_identity_bounds(
            tables, args, identity, start, slot_end, byte_base)) return false;
    uint length = ig_scalar_program_cell_word(tables, string_cell, 3);
    if (length > slot_end - start) return false;
    end = start + length;
    return true;
}

inline bool ig_scalar_program_string_identity_bounds(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    ulong identity,
    thread uint& start,
    thread uint& end,
    thread uint& byte_base) {
    if (identity == 0 || identity > ulong(args.string_count)) return false;
    ulong offsets_base_wide = ulong(args.scalar_cell_count) * 4ul
        + ulong(args.map_entry_count) * 2ul + ulong(args.scalar_list_entry_count);
    ulong byte_base_wide = offsets_base_wide + ulong(args.string_count) + 1ul;
    if (byte_base_wide > ulong(args.table_word_count)
            || ulong(args.string_byte_count) > ulong(args.table_word_count) - byte_base_wide) {
        return false;
    }
    uint offsets_base = uint(offsets_base_wide);
    byte_base = uint(byte_base_wide);
    uint index = uint(identity - 1ul);
    start = tables[offsets_base + index];
    end = tables[offsets_base + index + 1u];
    return start <= end && end <= args.string_byte_count;
}

// Parses the finite decimal forms accepted by Cypher's toInteger STRING conversion and truncates
// toward zero using integer arithmetic only. This avoids an FP64 dependency on Apple GPUs while
// retaining exact signed-i64 boundary behavior.
inline bool ig_scalar_program_parse_i64(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint string_cell,
    thread ulong& converted) {
    uint start = 0;
    uint end = 0;
    uint byte_base = 0;
    if (!ig_scalar_program_string_bounds(
            tables, args, string_cell, start, end, byte_base)) return false;
    while (start < end && ig_scalar_program_ascii_space(tables[byte_base + start])) ++start;
    while (end > start && ig_scalar_program_ascii_space(tables[byte_base + end - 1u])) --end;
    if (start == end) return false;
    bool negative = false;
    uint first = tables[byte_base + start];
    if (first == uint('+') || first == uint('-')) {
        negative = first == uint('-');
        ++start;
    }
    if (start == end) return false;

    uint mantissa_start = start;
    uint mantissa_end = end;
    bool seen_dot = false;
    long digit_count = 0;
    long fractional_digits = 0;
    uint cursor = start;
    bool has_exponent = false;
    while (cursor < end) {
        uint byte = tables[byte_base + cursor];
        if (byte >= uint('0') && byte <= uint('9')) {
            ++digit_count;
            if (seen_dot) ++fractional_digits;
        } else if (byte == uint('.') && !seen_dot) {
            seen_dot = true;
        } else if (byte == uint('e') || byte == uint('E')) {
            mantissa_end = cursor;
            ++cursor;
            has_exponent = true;
            break;
        } else {
            return false;
        }
        ++cursor;
    }
    if (digit_count == 0) return false;

    long exponent = 0;
    if (has_exponent) {
        bool exponent_negative = false;
        if (cursor < end) {
            uint byte = tables[byte_base + cursor];
            if (byte == uint('+') || byte == uint('-')) {
                exponent_negative = byte == uint('-');
                ++cursor;
            }
        }
        if (cursor == end) return false;
        long magnitude = 0;
        while (cursor < end) {
            uint byte = tables[byte_base + cursor];
            if (byte < uint('0') || byte > uint('9')) return false;
            if (magnitude < 1000000l) {
                magnitude = min(1000000l, magnitude * 10l + long(byte - uint('0')));
            }
            ++cursor;
        }
        exponent = exponent_negative ? -magnitude : magnitude;
    }

    long integer_digits = digit_count - fractional_digits + exponent;
    if (integer_digits <= 0) {
        converted = 0;
        return true;
    }
    ulong limit = negative ? 0x8000000000000000ul : 0x7ffffffffffffffful;
    long source_digits = min(integer_digits, digit_count);
    long consumed = 0;
    ulong magnitude = 0;
    for (uint index = mantissa_start; index < mantissa_end && consumed < source_digits; ++index) {
        uint byte = tables[byte_base + index];
        if (byte < uint('0') || byte > uint('9')) continue;
        ulong digit = ulong(byte - uint('0'));
        if (magnitude > (limit - digit) / 10ul) return false;
        magnitude = magnitude * 10ul + digit;
        ++consumed;
    }
    long extra_zeros = integer_digits - digit_count;
    if (magnitude != 0) {
        if (extra_zeros > 19) return false;
        for (long index = 0; index < extra_zeros; ++index) {
            if (magnitude > limit / 10ul) return false;
            magnitude *= 10ul;
        }
    }
    converted = negative ? (0ul - magnitude) : magnitude;
    return true;
}

inline bool ig_scalar_program_f64_to_i64(ulong bits, thread ulong& converted) {
    bool negative = (bits >> 63) != 0;
    uint exponent = uint((bits >> 52) & 0x7fful);
    ulong fraction = bits & 0x000ffffffffffffful;
    if (exponent == 0x7ffu) return false;
    if (exponent == 0u || exponent < 1023u) {
        converted = 0;
        return true;
    }
    uint power = exponent - 1023u;
    if (power > 63u) return false;
    if (power == 63u) {
        if (!negative || fraction != 0) return false;
        converted = 0x8000000000000000ul;
        return true;
    }
    ulong significand = 0x0010000000000000ul | fraction;
    ulong magnitude = power >= 52u
        ? significand << (power - 52u)
        : significand >> (52u - power);
    converted = negative ? (0ul - magnitude) : magnitude;
    return true;
}

inline ulong ig_scalar_program_i64_to_f64(ulong bits) {
    bool negative = (bits >> 63) != 0;
    ulong magnitude = negative ? (0ul - bits) : bits;
    if (magnitude == 0) return 0;
    uint most_significant = 0;
    for (ulong value = magnitude; value > 1; value >>= 1) ++most_significant;
    ulong significand = 0;
    uint exponent = most_significant + 1023u;
    if (most_significant <= 52u) {
        significand = magnitude << (52u - most_significant);
    } else {
        uint shift = most_significant - 52u;
        significand = magnitude >> shift;
        ulong remainder_mask = (1ul << shift) - 1ul;
        ulong remainder = magnitude & remainder_mask;
        ulong halfway = 1ul << (shift - 1u);
        if (remainder > halfway || (remainder == halfway && (significand & 1ul) != 0)) {
            ++significand;
            if (significand == 0x0020000000000000ul) {
                significand >>= 1;
                ++exponent;
            }
        }
    }
    ulong fraction = significand & 0x000ffffffffffffful;
    return (negative ? 0x8000000000000000ul : 0ul)
        | (ulong(exponent) << 52) | fraction;
}

inline uint ig_scalar_program_to_integer(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint value_cell,
    uint destination_cell) {
    if (ig_scalar_program_is_semantic_status(value_cell)) return value_cell;
    if (value_cell >= args.scalar_cell_count || destination_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint tag = ig_scalar_program_cell_word(tables, value_cell, 0);
    if (tag == 0 || tag == 2) return value_cell;
    ulong converted = 0;
    if (tag == 1) {
        ulong value = ig_scalar_program_cell_payload(tables, value_cell);
        if (value > 1) return IG_SCALAR_PROGRAM_CORRUPT;
        converted = value;
    } else if (tag == 3) {
        if (!ig_scalar_program_f64_to_i64(
                ig_scalar_program_cell_payload(tables, value_cell), converted)) {
            return args.null_cell;
        }
    } else if (tag == 4) {
        if (!ig_scalar_program_parse_i64(tables, args, value_cell, converted)) {
            return args.null_cell;
        }
    } else {
        return IG_SCALAR_PROGRAM_INVALID;
    }
    uint base = destination_cell * 4;
    tables[base] = 2;
    tables[base + 1] = uint(converted);
    tables[base + 2] = uint(converted >> 32);
    tables[base + 3] = 0;
    return destination_cell;
}

inline uint ig_scalar_program_to_float(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint value_cell,
    uint destination_cell) {
    if (ig_scalar_program_is_semantic_status(value_cell)) return value_cell;
    if (value_cell >= args.scalar_cell_count || destination_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint tag = ig_scalar_program_cell_word(tables, value_cell, 0);
    if (tag == 3) return value_cell;
    ulong converted = 0;
    if (tag == 2) {
        converted = ig_scalar_program_i64_to_f64(
            ig_scalar_program_cell_payload(tables, value_cell));
    } else if (tag == 4) {
        ulong integer = 0;
        if (!ig_scalar_program_parse_i64(tables, args, value_cell, integer)) {
            return args.null_cell;
        }
        converted = ig_scalar_program_i64_to_f64(integer);
    } else {
        return IG_SCALAR_PROGRAM_INVALID;
    }
    uint base = destination_cell * 4;
    tables[base] = 3;
    tables[base + 1] = uint(converted);
    tables[base + 2] = uint(converted >> 32);
    tables[base + 3] = 0;
    return destination_cell;
}

inline uint ig_scalar_program_to_string(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint value_cell,
    uint instruction_index,
    uint destination_cell) {
    if (ig_scalar_program_is_semantic_status(value_cell)) return value_cell;
    if (value_cell >= args.scalar_cell_count || destination_cell >= args.scalar_cell_count
            || args.string_count < args.instruction_count
            || instruction_index >= args.instruction_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint tag = ig_scalar_program_cell_word(tables, value_cell, 0);
    if (tag == 4) return value_cell;
    uint reversed[32];
    uint length = 0;
    if (tag == 1) {
        ulong boolean = ig_scalar_program_cell_payload(tables, value_cell);
        if (boolean > 1) return IG_SCALAR_PROGRAM_CORRUPT;
        if (boolean == 0) {
            reversed[0] = uint('e');
            reversed[1] = uint('s');
            reversed[2] = uint('l');
            reversed[3] = uint('a');
            reversed[4] = uint('f');
            length = 5;
        } else {
            reversed[0] = uint('e');
            reversed[1] = uint('u');
            reversed[2] = uint('r');
            reversed[3] = uint('t');
            length = 4;
        }
    } else if (tag == 2) {
        ulong bits = ig_scalar_program_cell_payload(tables, value_cell);
        bool negative = (bits >> 63) != 0;
        ulong magnitude = negative ? (0ul - bits) : bits;
        do {
            reversed[length++] = uint('0') + uint(magnitude % 10ul);
            magnitude /= 10ul;
        } while (magnitude != 0 && length < 31u);
        if (magnitude != 0) return IG_SCALAR_PROGRAM_CORRUPT;
        if (negative) reversed[length++] = uint('-');
    } else {
        return IG_SCALAR_PROGRAM_INVALID;
    }

    uint input_string_count = args.string_count - args.instruction_count;
    uint string_id = input_string_count + instruction_index + 1u;
    ulong offsets_base_wide = ulong(args.scalar_cell_count) * 4ul
        + ulong(args.map_entry_count) * 2ul + ulong(args.scalar_list_entry_count);
    ulong byte_base_wide = offsets_base_wide + ulong(args.string_count) + 1ul;
    if (byte_base_wide > ulong(args.table_word_count)
            || ulong(args.string_byte_count) > ulong(args.table_word_count) - byte_base_wide) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint offsets_base = uint(offsets_base_wide);
    uint byte_base = uint(byte_base_wide);
    uint start = tables[offsets_base + string_id - 1u];
    uint end = tables[offsets_base + string_id];
    if (start > end || end > args.string_byte_count || length > end - start) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    for (uint index = 0; index < end - start; ++index) {
        tables[byte_base + start + index] = index < length
            ? reversed[length - index - 1u]
            : 0u;
    }
    uint base = destination_cell * 4;
    tables[base] = 4;
    tables[base + 1] = string_id;
    tables[base + 2] = 0;
    tables[base + 3] = length;
    return destination_cell;
}

inline bool ig_scalar_program_f64_is_nan(ulong bits) {
    return (bits & 0x7ff0000000000000ul) == 0x7ff0000000000000ul
        && (bits & 0x000ffffffffffffful) != 0;
}

inline bool ig_scalar_program_f64_is_infinite(ulong bits) {
    return (bits & 0x7ffffffffffffffful) == 0x7ff0000000000000ul;
}

inline ulong ig_scalar_program_shift_right_jam(ulong value, uint distance) {
    if (distance == 0u) return value;
    if (distance < 64u) {
        ulong discarded = value << (64u - distance);
        return (value >> distance) | (discarded != 0ul ? 1ul : 0ul);
    }
    return value != 0ul ? 1ul : 0ul;
}

inline bool ig_scalar_program_f64_decode_finite(
    ulong bits,
    thread int& exponent,
    thread ulong& significand) {
    uint exponent_bits = uint((bits >> 52) & 0x7fful);
    significand = bits & 0x000ffffffffffffful;
    if (exponent_bits == 0x7ffu || (exponent_bits == 0u && significand == 0ul)) return false;
    if (exponent_bits == 0u) {
        exponent = -1022;
        while ((significand & 0x0010000000000000ul) == 0ul) {
            significand <<= 1u;
            --exponent;
        }
    } else {
        exponent = int(exponent_bits) - 1023;
        significand |= 0x0010000000000000ul;
    }
    return true;
}

// Rounds one normalized binary significand carrying three guard/round/sticky bits. This is the
// common software-FP64 publication boundary used because Apple GPUs do not expose native FP64.
inline ulong ig_scalar_program_f64_round_pack(bool negative, int exponent, ulong significand) {
    if (significand == 0ul) return negative ? 0x8000000000000000ul : 0ul;
    while ((significand & 0x0080000000000000ul) == 0ul) {
        significand <<= 1u;
        --exponent;
    }
    if (exponent < -1022) {
        uint distance = uint(min(4096, -1022 - exponent));
        significand = ig_scalar_program_shift_right_jam(significand, distance);
        exponent = -1022;
    }
    ulong round_bits = significand & 7ul;
    ulong rounded = significand >> 3u;
    if (round_bits > 4ul || (round_bits == 4ul && (rounded & 1ul) != 0ul)) ++rounded;
    if (rounded >= 0x0020000000000000ul) {
        rounded >>= 1u;
        ++exponent;
    }
    if (exponent > 1023) {
        return (negative ? 0xfff0000000000000ul : 0x7ff0000000000000ul);
    }
    ulong sign = negative ? 0x8000000000000000ul : 0ul;
    if (exponent == -1022 && rounded < 0x0010000000000000ul) {
        return sign | rounded;
    }
    return sign | (ulong(exponent + 1023) << 52u)
        | (rounded & 0x000ffffffffffffful);
}

inline ulong ig_scalar_program_f64_add(ulong left, ulong right) {
    const ulong canonical_nan = 0x7ff8000000000000ul;
    if (ig_scalar_program_f64_is_nan(left) || ig_scalar_program_f64_is_nan(right)) {
        return canonical_nan;
    }
    bool left_negative = (left >> 63u) != 0ul;
    bool right_negative = (right >> 63u) != 0ul;
    bool left_infinite = ig_scalar_program_f64_is_infinite(left);
    bool right_infinite = ig_scalar_program_f64_is_infinite(right);
    if (left_infinite || right_infinite) {
        if (left_infinite && right_infinite && left_negative != right_negative) return canonical_nan;
        return left_infinite ? left : right;
    }
    ulong left_absolute = left & 0x7ffffffffffffffful;
    ulong right_absolute = right & 0x7ffffffffffffffful;
    if (left_absolute == 0ul && right_absolute == 0ul) {
        return left_negative && right_negative ? 0x8000000000000000ul : 0ul;
    }
    if (left_absolute == 0ul) return right;
    if (right_absolute == 0ul) return left;

    int left_exponent = 0;
    int right_exponent = 0;
    ulong left_significand = 0;
    ulong right_significand = 0;
    ig_scalar_program_f64_decode_finite(
        left, left_exponent, left_significand);
    ig_scalar_program_f64_decode_finite(
        right, right_exponent, right_significand);
    bool swap = left_exponent < right_exponent
        || (left_exponent == right_exponent && left_significand < right_significand);
    if (swap) {
        int exponent = left_exponent;
        left_exponent = right_exponent;
        right_exponent = exponent;
        ulong significand = left_significand;
        left_significand = right_significand;
        right_significand = significand;
        bool negative = left_negative;
        left_negative = right_negative;
        right_negative = negative;
    }
    left_significand <<= 3u;
    right_significand = ig_scalar_program_shift_right_jam(
        right_significand << 3u, uint(left_exponent - right_exponent));
    ulong result = 0;
    if (left_negative == right_negative) {
        result = left_significand + right_significand;
        if ((result & 0x0100000000000000ul) != 0ul) {
            result = ig_scalar_program_shift_right_jam(result, 1u);
            ++left_exponent;
        }
    } else {
        result = left_significand - right_significand;
        if (result == 0ul) return 0ul;
    }
    return ig_scalar_program_f64_round_pack(left_negative, left_exponent, result);
}

inline void ig_scalar_program_multiply_u64(
    ulong left,
    ulong right,
    thread ulong& high,
    thread ulong& low) {
    ulong left_low = left & 0xfffffffful;
    ulong left_high = left >> 32u;
    ulong right_low = right & 0xfffffffful;
    ulong right_high = right >> 32u;
    ulong low_product = left_low * right_low;
    ulong cross_left = left_low * right_high;
    ulong cross_right = left_high * right_low;
    ulong middle = (low_product >> 32u)
        + (cross_left & 0xfffffffful) + (cross_right & 0xfffffffful);
    low = (low_product & 0xfffffffful) | (middle << 32u);
    high = left_high * right_high + (cross_left >> 32u)
        + (cross_right >> 32u) + (middle >> 32u);
}

inline ulong ig_scalar_program_shift_right_jam_u128(ulong high, ulong low, uint distance) {
    if (distance == 0u) return low;
    if (distance < 64u) {
        ulong shifted = (high << (64u - distance)) | (low >> distance);
        ulong discarded = low << (64u - distance);
        return shifted | (discarded != 0ul ? 1ul : 0ul);
    }
    if (distance == 64u) return high | (low != 0ul ? 1ul : 0ul);
    uint high_distance = distance - 64u;
    ulong shifted = high_distance < 64u ? high >> high_distance : 0ul;
    bool discarded = low != 0ul
        || (high_distance < 64u && (high << (64u - high_distance)) != 0ul)
        || (high_distance >= 64u && high != 0ul);
    return shifted | (discarded ? 1ul : 0ul);
}

inline ulong ig_scalar_program_f64_multiply(ulong left, ulong right) {
    const ulong canonical_nan = 0x7ff8000000000000ul;
    if (ig_scalar_program_f64_is_nan(left) || ig_scalar_program_f64_is_nan(right)) {
        return canonical_nan;
    }
    bool negative = ((left ^ right) >> 63u) != 0ul;
    bool left_infinite = ig_scalar_program_f64_is_infinite(left);
    bool right_infinite = ig_scalar_program_f64_is_infinite(right);
    bool left_zero = (left & 0x7ffffffffffffffful) == 0ul;
    bool right_zero = (right & 0x7ffffffffffffffful) == 0ul;
    if ((left_infinite && right_zero) || (right_infinite && left_zero)) return canonical_nan;
    if (left_infinite || right_infinite) {
        return negative ? 0xfff0000000000000ul : 0x7ff0000000000000ul;
    }
    if (left_zero || right_zero) return negative ? 0x8000000000000000ul : 0ul;
    int left_exponent = 0;
    int right_exponent = 0;
    ulong left_significand = 0;
    ulong right_significand = 0;
    ig_scalar_program_f64_decode_finite(left, left_exponent, left_significand);
    ig_scalar_program_f64_decode_finite(right, right_exponent, right_significand);
    ulong high = 0;
    ulong low = 0;
    ig_scalar_program_multiply_u64(left_significand, right_significand, high, low);
    bool upper = (high & (1ul << 41u)) != 0ul;
    uint distance = upper ? 50u : 49u;
    int exponent = left_exponent + right_exponent + (upper ? 1 : 0);
    ulong significand = ig_scalar_program_shift_right_jam_u128(high, low, distance);
    return ig_scalar_program_f64_round_pack(negative, exponent, significand);
}

inline ulong ig_scalar_program_f64_divide(ulong left, ulong right) {
    const ulong canonical_nan = 0x7ff8000000000000ul;
    if (ig_scalar_program_f64_is_nan(left) || ig_scalar_program_f64_is_nan(right)) {
        return canonical_nan;
    }
    bool negative = ((left ^ right) >> 63u) != 0ul;
    bool left_infinite = ig_scalar_program_f64_is_infinite(left);
    bool right_infinite = ig_scalar_program_f64_is_infinite(right);
    bool left_zero = (left & 0x7ffffffffffffffful) == 0ul;
    bool right_zero = (right & 0x7ffffffffffffffful) == 0ul;
    if ((left_infinite && right_infinite) || (left_zero && right_zero)) return canonical_nan;
    if (left_infinite || right_zero) {
        return negative ? 0xfff0000000000000ul : 0x7ff0000000000000ul;
    }
    if (right_infinite || left_zero) return negative ? 0x8000000000000000ul : 0ul;
    int left_exponent = 0;
    int right_exponent = 0;
    ulong left_significand = 0;
    ulong right_significand = 0;
    ig_scalar_program_f64_decode_finite(left, left_exponent, left_significand);
    ig_scalar_program_f64_decode_finite(right, right_exponent, right_significand);
    int exponent = left_exponent - right_exponent;
    ulong remainder = left_significand;
    if (remainder < right_significand) {
        remainder <<= 1u;
        --exponent;
    }
    ulong quotient = 0ul;
    for (int bit = 55; bit >= 0; --bit) {
        if (remainder >= right_significand) {
            remainder -= right_significand;
            quotient |= 1ul << uint(bit);
        }
        if (bit != 0) remainder <<= 1u;
    }
    if (remainder != 0ul) quotient |= 1ul;
    return ig_scalar_program_f64_round_pack(negative, exponent, quotient);
}

inline bool ig_scalar_program_f64_exact_i64(ulong bits, thread long& value) {
    ulong converted = 0;
    if (!ig_scalar_program_f64_to_i64(bits, converted)) return false;
    value = as_type<long>(converted);
    return ig_scalar_i64_f64_equal(value, bits);
}

inline bool ig_scalar_program_checked_add(ulong left, ulong right, thread ulong& value) {
    value = left + right;
    ulong left_sign = left >> 63u;
    return left_sign != (right >> 63u) || (value >> 63u) == left_sign;
}

inline bool ig_scalar_program_checked_subtract(ulong left, ulong right, thread ulong& value) {
    value = left - right;
    ulong left_sign = left >> 63u;
    return left_sign == (right >> 63u) || (value >> 63u) == left_sign;
}

inline bool ig_scalar_program_checked_multiply(ulong left, ulong right, thread ulong& value) {
    bool negative = ((left ^ right) >> 63u) != 0ul;
    ulong left_magnitude = (left >> 63u) != 0ul ? 0ul - left : left;
    ulong right_magnitude = (right >> 63u) != 0ul ? 0ul - right : right;
    ulong limit = negative ? 0x8000000000000000ul : 0x7ffffffffffffffful;
    if (right_magnitude != 0ul && left_magnitude > limit / right_magnitude) return false;
    ulong magnitude = left_magnitude * right_magnitude;
    value = negative ? 0ul - magnitude : magnitude;
    return true;
}

inline bool ig_scalar_program_f64_modulo(ulong left, ulong right, thread ulong& value) {
    const ulong canonical_nan = 0x7ff8000000000000ul;
    if (ig_scalar_program_f64_is_nan(left) || ig_scalar_program_f64_is_nan(right)
            || ig_scalar_program_f64_is_infinite(left)
            || (right & 0x7ffffffffffffffful) == 0ul) {
        value = canonical_nan;
        return true;
    }
    if (ig_scalar_program_f64_is_infinite(right)
            || (left & 0x7ffffffffffffffful) == 0ul) {
        value = left;
        return true;
    }
    // Exact IEEE remainder by integer reduction of the significands.
    //
    // The obvious `left - trunc(left / right) * right` rounds three separate times and is not
    // `fmod`: it answered `1e17 % 3.0` as `0.0` where the CPU reference returns `1.0`, and it had
    // to refuse outright whenever the quotient overflowed a signed 64-bit integer, so the two
    // backends disagreed on both the value and on whether the query could run at all. The corpus
    // cannot see any of this — its modulo feature file contains no scenarios.
    //
    // `fmod` is exactly representable, so no rounding is required. Writing the operands as
    // `m1 * 2^(e1-52)` and `m2 * 2^(e2-52)`, the remainder is `(m1 * 2^(e1-e2) mod m2)` scaled by
    // `2^(e2-52)`. Doubling modulo `m2` computes that with integers only. The doublings are applied
    // eleven at a time because `m2 < 2^53` keeps `r << 11` inside 64 bits, which turns the
    // worst-case exponent spread from a few thousand steps into a couple of hundred.
    int left_exponent = 0;
    int right_exponent = 0;
    ulong left_significand = 0ul;
    ulong right_significand = 0ul;
    if (!ig_scalar_program_f64_decode_finite(left, left_exponent, left_significand)
            || !ig_scalar_program_f64_decode_finite(right, right_exponent, right_significand)) {
        return false;
    }
    ulong sign = left & 0x8000000000000000ul;
    if (left_exponent < right_exponent) {
        // Both significands share the same binade, so a smaller exponent means |left| < |right|
        // and the remainder is the dividend itself.
        value = left;
        return true;
    }
    uint spread = uint(left_exponent - right_exponent);
    ulong remainder = left_significand % right_significand;
    while (spread >= 11u) {
        remainder = (remainder << 11u) % right_significand;
        spread -= 11u;
    }
    if (spread != 0u) {
        remainder = (remainder << spread) % right_significand;
    }
    if (remainder == 0ul) {
        // `fmod` keeps the dividend's sign for an exact multiple, including negative zero.
        value = sign;
        return true;
    }
    // Renormalize `remainder * 2^(right_exponent-52)`, which may land in the subnormal range.
    int exponent = right_exponent;
    while ((remainder & 0x0010000000000000ul) == 0ul) {
        remainder <<= 1u;
        --exponent;
    }
    int biased = exponent + 1023;
    if (biased >= 0x7ff) return false;
    if (biased <= 0) {
        uint shift = uint(1 - biased);
        value = shift > 53u ? sign : (sign | (remainder >> shift));
        return true;
    }
    value = sign | (ulong(biased) << 52) | (remainder - 0x0010000000000000ul);
    return true;
}

inline bool ig_scalar_program_f64_sqrt(ulong input, thread ulong& value) {
    // Correctly rounded binary64 square root, by integer digit recurrence.
    //
    // Apple Metal has no native double, and `sqrt()` in Cypher lowers to `x ^ 0.5`, so this is the
    // only path that answers it natively. A previous revision ran eight fixed Newton-Raphson steps
    // and returned the estimate directly: that converges to within one unit in the last place but
    // is not correctly rounded, and it disagreed with the CPU reference for roughly a quarter of
    // all normal inputs. The conformance corpus could not see it — its single `sqrt()` scenario is
    // one of the values the estimate happens to get right.
    //
    // Unlike `pow`, square root is exactly rounded by definition and can be computed exactly with
    // integer arithmetic. Writing the input as `M * 2^(2k-52)` with `M` in `[2^52, 2^54)`, the
    // significand of the result is `floor(sqrt(M << 54))`, which the classic restoring recurrence
    // produces two bits at a time along with the exact remainder. The remainder is the sticky bit,
    // so round-to-nearest-even is decidable rather than estimated. Every intermediate stays inside
    // 64 bits: `s` never exceeds 2^54 and `r` never exceeds 2^55.
    if ((input & 0x8000000000000000ul) != 0ul || ig_scalar_program_f64_is_nan(input)
            || ig_scalar_program_f64_is_infinite(input)) {
        return false;
    }
    if ((input & 0x7ffffffffffffffful) == 0ul) {
        value = input;
        return true;
    }
    int exponent = 0;
    ulong significand = 0ul;
    if (!ig_scalar_program_f64_decode_finite(input, exponent, significand)) return false;

    // Force an even exponent so the halved exponent is exact.
    ulong radicand = significand;
    int half_exponent = exponent >> 1;
    if ((exponent & 1) != 0) {
        radicand <<= 1u;
        half_exponent = (exponent - 1) / 2;
    }

    ulong root = 0ul;
    ulong remainder = 0ul;
    for (int pair = 26; pair >= 0; --pair) {
        remainder = (remainder << 2) | ((radicand >> uint(2 * pair)) & 3ul);
        ulong trial = (root << 2) | 1ul;
        root <<= 1;
        if (remainder >= trial) {
            remainder -= trial;
            root |= 1ul;
        }
    }
    for (uint pair = 0u; pair < 27u; ++pair) {
        remainder <<= 2;
        ulong trial = (root << 2) | 1ul;
        root <<= 1;
        if (remainder >= trial) {
            remainder -= trial;
            root |= 1ul;
        }
    }

    // `root` holds 54 significant bits; keep 53 and round to nearest, ties to even.
    ulong guard = root & 1ul;
    ulong quotient = root >> 1u;
    if (guard != 0ul && (remainder != 0ul || (quotient & 1ul) != 0ul)) {
        ++quotient;
    }
    if (quotient == 0x0020000000000000ul) {
        quotient >>= 1u;
        ++half_exponent;
    }
    int biased = half_exponent + 1023;
    if (biased <= 0 || biased >= 0x7ff) return false;
    value = (ulong(biased) << 52) | (quotient - 0x0010000000000000ul);
    return true;
}

inline bool ig_scalar_program_f64_power(ulong base, ulong exponent, thread ulong& value) {
    if (exponent == 0x3fe0000000000000ul) {
        return ig_scalar_program_f64_sqrt(base, value);
    }
    // Integer exponents are answered only when the result is exactly representable.
    //
    // The previous implementation multiplied by repeated squaring and returned whatever came out.
    // Each product rounds, so the answer drifted from the reference's `powf` for roughly two thirds
    // of integer exponents — the corpus never noticed because every `^` scenario it contains uses
    // small values that happen to be exact. Rather than approximate, the whole computation is done
    // in integers and is refused the moment it would leave the exactly-representable range. What
    // survives is bit-identical to the reference by construction: an integer below `2^53` has a
    // single binary64 spelling, so there is nothing left to round. Everything else declines and is
    // evaluated on the host, which is visible rather than silently different.
    const ulong exact_limit = 0x0020000000000000ul;  // 2^53
    long signed_exponent = 0;
    if (!ig_scalar_program_f64_exact_i64(exponent, signed_exponent)) return false;
    if (signed_exponent == 0l) {
        value = 0x3ff0000000000000ul;
        return true;
    }
    // A negative exponent needs a reciprocal, which reintroduces a rounding the reference performs
    // differently, so it is left to the host.
    if (signed_exponent < 0l) return false;
    if ((base & 0x7ffffffffffffffful) == 0ul) {
        // `pow(±0, n)` keeps the sign only for an odd exponent, matching the reference.
        value = ((signed_exponent & 1l) != 0l) ? base : 0ul;
        return true;
    }
    long signed_base = 0;
    if (!ig_scalar_program_f64_exact_i64(base, signed_base)) return false;
    ulong absolute_base = signed_base < 0l ? ulong(-(signed_base + 1l)) + 1ul : ulong(signed_base);
    bool negative_result = signed_base < 0l && (signed_exponent & 1l) != 0l;
    if (absolute_base == 1ul) {
        value = negative_result ? 0xbff0000000000000ul : 0x3ff0000000000000ul;
        return true;
    }
    // With |base| >= 2 anything past 53 doublings has already left the exact range, which also
    // bounds the loop below.
    if (signed_exponent > 53l) return false;
    ulong magnitude = 1ul;
    for (long step = 0l; step < signed_exponent; ++step) {
        if (magnitude > exact_limit / absolute_base) return false;
        magnitude *= absolute_base;
        if (magnitude > exact_limit) return false;
    }
    ulong encoded = ig_scalar_program_i64_to_f64(magnitude);
    value = negative_result ? (encoded ^ 0x8000000000000000ul) : encoded;
    return true;
}

inline uint ig_scalar_program_write_numeric(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint destination_cell,
    uint tag,
    ulong value) {
    if (destination_cell >= args.scalar_cell_count) return IG_SCALAR_PROGRAM_CORRUPT;
    uint base = destination_cell * 4u;
    tables[base] = tag;
    tables[base + 1u] = uint(value);
    tables[base + 2u] = uint(value >> 32u);
    tables[base + 3u] = 0u;
    return destination_cell;
}

inline uint ig_scalar_program_numeric_binary(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint right_cell,
    uint destination_cell,
    uint opcode) {
    if (ig_scalar_program_is_semantic_status(left_cell)) return left_cell;
    if (ig_scalar_program_is_semantic_status(right_cell)) return right_cell;
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count
            || destination_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint left_tag = ig_scalar_program_cell_word(tables, left_cell, 0);
    uint right_tag = ig_scalar_program_cell_word(tables, right_cell, 0);
    if (left_tag == 0 || right_tag == 0) return args.null_cell;
    if ((left_tag != 2u && left_tag != 3u) || (right_tag != 2u && right_tag != 3u)) {
        return IG_SCALAR_PROGRAM_INVALID;
    }
    ulong left = ig_scalar_program_cell_payload(tables, left_cell);
    ulong right = ig_scalar_program_cell_payload(tables, right_cell);
    if (left_tag == 2u && right_tag == 2u && opcode != 12u) {
        ulong value = 0ul;
        bool valid = false;
        if (opcode == 8u) {
            valid = ig_scalar_program_checked_add(left, right, value);
        } else if (opcode == 4u) {
            valid = ig_scalar_program_checked_subtract(left, right, value);
        } else if (opcode == 9u) {
            valid = ig_scalar_program_checked_multiply(left, right, value);
        } else if (opcode == 10u) {
            long dividend = as_type<long>(left);
            long divisor = as_type<long>(right);
            if (divisor != 0l && !(dividend == (-9223372036854775807l - 1l) && divisor == -1l)) {
                value = as_type<ulong>(dividend / divisor);
                valid = true;
            }
        } else if (opcode == 11u) {
            long dividend = as_type<long>(left);
            long divisor = as_type<long>(right);
            if (divisor != 0l) {
                value = dividend == (-9223372036854775807l - 1l) && divisor == -1l
                    ? 0ul : as_type<ulong>(dividend % divisor);
                valid = true;
            }
        }
        if (!valid) return IG_SCALAR_PROGRAM_INVALID;
        return ig_scalar_program_write_numeric(tables, args, destination_cell, 2u, value);
    }
    ulong left_float = left_tag == 2u ? ig_scalar_program_i64_to_f64(left) : left;
    ulong right_float = right_tag == 2u ? ig_scalar_program_i64_to_f64(right) : right;
    ulong value = 0ul;
    if (opcode == 8u) {
        value = ig_scalar_program_f64_add(left_float, right_float);
    } else if (opcode == 4u) {
        value = ig_scalar_program_f64_add(
            left_float, right_float ^ 0x8000000000000000ul);
    } else if (opcode == 9u) {
        value = ig_scalar_program_f64_multiply(left_float, right_float);
    } else if (opcode == 10u) {
        value = ig_scalar_program_f64_divide(left_float, right_float);
    } else if (opcode == 11u) {
        if (!ig_scalar_program_f64_modulo(left_float, right_float, value)) {
            return IG_SCALAR_PROGRAM_INVALID;
        }
    } else if (opcode == 12u) {
        if (!ig_scalar_program_f64_power(left_float, right_float, value)) {
            return IG_SCALAR_PROGRAM_INVALID;
        }
    } else {
        return IG_SCALAR_PROGRAM_INVALID;
    }
    return ig_scalar_program_write_numeric(tables, args, destination_cell, 3u, value);
}

inline uint ig_scalar_program_numeric_positive(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint value_cell) {
    if (ig_scalar_program_is_semantic_status(value_cell)) return value_cell;
    if (value_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint tag = ig_scalar_program_cell_word(tables, value_cell, 0);
    return tag == 0u || tag == 2u || tag == 3u ? value_cell : IG_SCALAR_PROGRAM_INVALID;
}

inline uint ig_scalar_program_numeric_negative(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint value_cell,
    uint destination_cell) {
    if (ig_scalar_program_is_semantic_status(value_cell)) return value_cell;
    if (value_cell >= args.scalar_cell_count
            || destination_cell >= args.scalar_cell_count) return IG_SCALAR_PROGRAM_CORRUPT;
    uint tag = ig_scalar_program_cell_word(tables, value_cell, 0);
    if (tag == 0u) return args.null_cell;
    ulong value = ig_scalar_program_cell_payload(tables, value_cell);
    if (tag == 2u) {
        if (value == 0x8000000000000000ul) return IG_SCALAR_PROGRAM_INVALID;
        value = 0ul - value;
    } else if (tag == 3u) {
        value ^= 0x8000000000000000ul;
    } else {
        return IG_SCALAR_PROGRAM_INVALID;
    }
    return ig_scalar_program_write_numeric(tables, args, destination_cell, tag, value);
}

inline uint ig_scalar_program_build_list(
    device uint* tables,
    constant ScalarProgramArgs& args,
    thread const uint* registers,
    uint register_count,
    uint first_register,
    uint count_cell,
    uint offset_cell,
    uint destination_cell) {
    if (count_cell >= args.scalar_cell_count || offset_cell >= args.scalar_cell_count
            || destination_cell >= args.scalar_cell_count
            || ig_scalar_program_cell_word(tables, count_cell, 0) != 2
            || ig_scalar_program_cell_word(tables, offset_cell, 0) != 2) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    ulong count_wide = ig_scalar_program_cell_payload(tables, count_cell);
    ulong offset_wide = ig_scalar_program_cell_payload(tables, offset_cell);
    if (count_wide > 0xfffffffful || offset_wide > 0xfffffffful) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint count = uint(count_wide);
    uint offset = uint(offset_wide);
    if (first_register > register_count || count > register_count - first_register
            || offset > args.scalar_list_entry_count
            || count > args.scalar_list_entry_count - offset) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint list_base = args.scalar_cell_count * 4 + args.map_entry_count * 2;
    // Preflight the entire semantic element range before mutating the output arena. This keeps
    // first-error ordering stable and makes a failed BuildList publication atomic.
    for (uint index = 0; index < count; ++index) {
        uint cell = registers[first_register + index];
        if (ig_scalar_program_is_semantic_status(cell)) return cell;
        if (cell >= destination_cell) return IG_SCALAR_PROGRAM_CORRUPT;
    }
    for (uint index = 0; index < count; ++index) {
        uint cell = registers[first_register + index];
        tables[list_base + offset + index] = cell;
    }
    uint base = destination_cell * 4;
    tables[base] = 5;
    tables[base + 1] = offset;
    tables[base + 2] = 0;
    tables[base + 3] = count;
    return destination_cell;
}

// Device-side Cypher `+` for the bounded scalar VM. The request validator reserves a disjoint
// child-reference arena for every potentially list-producing instruction; this kernel may fill
// only that arena and may reference only cells defined before its destination register cell.
inline uint ig_scalar_program_cypher_add(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint right_cell,
    uint offset_cell,
    uint capacity_cell,
    uint destination_cell) {
    if (ig_scalar_program_is_semantic_status(left_cell)) return left_cell;
    if (ig_scalar_program_is_semantic_status(right_cell)) return right_cell;
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count
            || offset_cell >= args.scalar_cell_count || capacity_cell >= args.scalar_cell_count
            || destination_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint left_tag = ig_scalar_program_cell_word(tables, left_cell, 0);
    uint right_tag = ig_scalar_program_cell_word(tables, right_cell, 0);
    if (left_tag != 5u && right_tag != 5u) {
        return ig_scalar_program_numeric_binary(
            tables, args, left_cell, right_cell, destination_cell, 8u);
    }
    if (ig_scalar_program_cell_word(tables, offset_cell, 0) != 2u
            || ig_scalar_program_cell_word(tables, capacity_cell, 0) != 2u
            || ig_scalar_program_cell_word(tables, offset_cell, 3) != 0u
            || ig_scalar_program_cell_word(tables, capacity_cell, 3) != 0u) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    ulong offset_wide = ig_scalar_program_cell_payload(tables, offset_cell);
    ulong capacity_wide = ig_scalar_program_cell_payload(tables, capacity_cell);
    if (offset_wide > 0xfffffffful || capacity_wide > 0xfffffffful) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint offset = uint(offset_wide);
    uint capacity = uint(capacity_wide);
    if (offset > args.scalar_list_entry_count
            || capacity > args.scalar_list_entry_count - offset) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }

    uint left_width = left_tag == 5u
        ? ig_scalar_program_cell_word(tables, left_cell, 3)
        : 1u;
    uint right_width = right_tag == 5u
        ? ig_scalar_program_cell_word(tables, right_cell, 3)
        : 1u;
    if (left_width > 0xffffffffu - right_width) return IG_SCALAR_PROGRAM_INVALID;
    uint output_count = left_width + right_width;
    if (output_count > capacity) return IG_SCALAR_PROGRAM_INVALID;

    uint list_base = args.scalar_cell_count * 4u + args.map_entry_count * 2u;
    uint output_index = 0u;
    if (left_tag == 5u) {
        ulong source_wide = ig_scalar_program_cell_payload(tables, left_cell);
        if (source_wide > 0xfffffffful) return IG_SCALAR_PROGRAM_INVALID;
        uint source = uint(source_wide);
        if (source > args.scalar_list_entry_count
                || left_width > args.scalar_list_entry_count - source) {
            return IG_SCALAR_PROGRAM_INVALID;
        }
        for (uint index = 0u; index < left_width; ++index) {
            uint child = tables[list_base + source + index];
            if (child >= destination_cell) return IG_SCALAR_PROGRAM_INVALID;
            tables[list_base + offset + output_index] = child;
            ++output_index;
        }
    } else {
        if (left_cell >= destination_cell) return IG_SCALAR_PROGRAM_INVALID;
        tables[list_base + offset + output_index] = left_cell;
        ++output_index;
    }
    if (right_tag == 5u) {
        ulong source_wide = ig_scalar_program_cell_payload(tables, right_cell);
        if (source_wide > 0xfffffffful) return IG_SCALAR_PROGRAM_INVALID;
        uint source = uint(source_wide);
        if (source > args.scalar_list_entry_count
                || right_width > args.scalar_list_entry_count - source) {
            return IG_SCALAR_PROGRAM_INVALID;
        }
        for (uint index = 0u; index < right_width; ++index) {
            uint child = tables[list_base + source + index];
            if (child >= destination_cell) return IG_SCALAR_PROGRAM_INVALID;
            tables[list_base + offset + output_index] = child;
            ++output_index;
        }
    } else {
        if (right_cell >= destination_cell) return IG_SCALAR_PROGRAM_INVALID;
        tables[list_base + offset + output_index] = right_cell;
        ++output_index;
    }
    if (output_index != output_count) return IG_SCALAR_PROGRAM_INVALID;

    uint base = destination_cell * 4u;
    tables[base] = 5u;
    tables[base + 1u] = offset;
    tables[base + 2u] = 0u;
    tables[base + 3u] = output_count;
    return destination_cell;
}

inline uint ig_scalar_program_list_slice(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint source_cell,
    uint start_cell,
    uint end_cell,
    uint descriptor_cell,
    uint destination_cell) {
    if (ig_scalar_program_is_semantic_status(source_cell)) return source_cell;
    if (ig_scalar_program_is_semantic_status(start_cell)) return start_cell;
    if (ig_scalar_program_is_semantic_status(end_cell)) return end_cell;
    if (source_cell >= args.scalar_cell_count || start_cell >= args.scalar_cell_count
            || end_cell >= args.scalar_cell_count || descriptor_cell >= args.scalar_cell_count
            || destination_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint start_tag = ig_scalar_program_cell_word(tables, start_cell, 0);
    uint end_tag = ig_scalar_program_cell_word(tables, end_cell, 0);
    if (start_tag == 0u || end_tag == 0u) return args.null_cell;
    if (ig_scalar_program_cell_word(tables, source_cell, 0) != 5u
            || start_tag != 2u || end_tag != 2u
            || ig_scalar_program_cell_word(tables, descriptor_cell, 0) != 2u
            || ig_scalar_program_cell_word(tables, descriptor_cell, 3) != 0u) {
        return ig_scalar_program_cell_word(tables, source_cell, 0) != 5u
                || start_tag != 2u || end_tag != 2u
            ? IG_SCALAR_PROGRAM_INVALID : IG_SCALAR_PROGRAM_CORRUPT;
    }

    ulong source_wide = ig_scalar_program_cell_payload(tables, source_cell);
    if (source_wide > 0xfffffffful) return IG_SCALAR_PROGRAM_INVALID;
    uint source = uint(source_wide);
    uint source_count = ig_scalar_program_cell_word(tables, source_cell, 3);
    if (source > args.scalar_list_entry_count
            || source_count > args.scalar_list_entry_count - source) {
        return IG_SCALAR_PROGRAM_INVALID;
    }

    ulong descriptor = ig_scalar_program_cell_payload(tables, descriptor_cell);
    uint offset = uint(descriptor >> 32u);
    uint capacity = uint(descriptor);
    if (offset > args.scalar_list_entry_count
            || capacity > args.scalar_list_entry_count - offset) {
        return IG_SCALAR_PROGRAM_INVALID;
    }

    long length = long(source_count);
    long start = as_type<long>(ig_scalar_program_cell_payload(tables, start_cell));
    long end = as_type<long>(ig_scalar_program_cell_payload(tables, end_cell));
    if (start < 0l) start = length + start;
    if (end < 0l) end = length + end;
    if (start < 0l) start = 0l;
    if (start > length) start = length;
    if (end < 0l) end = 0l;
    if (end > length) end = length;
    uint output_count = end > start ? uint(end - start) : 0u;
    if (output_count > capacity) return IG_SCALAR_PROGRAM_INVALID;

    uint list_base = args.scalar_cell_count * 4u + args.map_entry_count * 2u;
    uint source_offset = source + uint(start);
    for (uint index = 0u; index < output_count; ++index) {
        uint child = tables[list_base + source_offset + index];
        if (child >= destination_cell) return IG_SCALAR_PROGRAM_INVALID;
        tables[list_base + offset + index] = child;
    }
    uint base = destination_cell * 4u;
    tables[base] = 5u;
    tables[base + 1u] = offset;
    tables[base + 2u] = 0u;
    tables[base + 3u] = output_count;
    return destination_cell;
}

inline uint ig_scalar_program_map_keys(
    device uint* tables,
    constant ScalarProgramArgs& args,
    uint source_cell,
    uint descriptor_cell,
    uint destination_cell) {
    if (ig_scalar_program_is_semantic_status(source_cell)) return source_cell;
    if (source_cell >= args.scalar_cell_count || descriptor_cell >= args.scalar_cell_count
            || destination_cell >= args.scalar_cell_count
            || args.scalar_cell_count < args.instruction_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint source_tag = ig_scalar_program_cell_word(tables, source_cell, 0u);
    if (source_tag == 0u) return args.null_cell;
    if (source_tag != 6u) return IG_SCALAR_PROGRAM_INVALID;
    if (ig_scalar_program_cell_word(tables, descriptor_cell, 0u) != 2u
            || ig_scalar_program_cell_word(tables, descriptor_cell, 3u) != 0u) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }

    ulong source_wide = ig_scalar_program_cell_payload(tables, source_cell);
    if (source_wide > 0xfffffffful) return IG_SCALAR_PROGRAM_CORRUPT;
    uint source = uint(source_wide);
    uint count = ig_scalar_program_cell_word(tables, source_cell, 3u);
    if (source > args.map_entry_count || count > args.map_entry_count - source) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    ulong descriptor = ig_scalar_program_cell_payload(tables, descriptor_cell);
    uint offset = uint(descriptor >> 32u);
    uint capacity = uint(descriptor);
    if (offset > args.scalar_list_entry_count
            || capacity > args.scalar_list_entry_count - offset || count > capacity) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }

    uint map_base = args.scalar_cell_count * 4u;
    uint list_base = map_base + args.map_entry_count * 2u;
    uint register_cell_base = args.scalar_cell_count - args.instruction_count;
    for (uint index = 0u; index < count; ++index) {
        uint entry = map_base + (source + index) * 2u;
        ulong key_identity = ulong(tables[entry]);
        uint key_cell = 0xffffffffu;
        for (uint candidate = 0u; candidate < register_cell_base; ++candidate) {
            if (ig_scalar_program_cell_word(tables, candidate, 0u) == 4u
                    && ig_scalar_program_cell_payload(tables, candidate) == key_identity) {
                key_cell = candidate;
                break;
            }
        }
        if (key_cell == 0xffffffffu || key_cell >= destination_cell) {
            return IG_SCALAR_PROGRAM_CORRUPT;
        }
        tables[list_base + offset + index] = key_cell;
    }
    uint base = destination_cell * 4u;
    tables[base] = 5u;
    tables[base + 1u] = offset;
    tables[base + 2u] = 0u;
    tables[base + 3u] = count;
    return destination_cell;
}

// Iterative three-valued structural equality over the scalar-program table layout. The request
// validator bounds the combined child pools before dispatch, and this second set of checks keeps
// corrupt device input from indexing outside the canonical image.
inline uchar ig_scalar_program_structural_equal(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint right_cell) {
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count) return 3;
    uint left_stack[IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS];
    uint right_stack[IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS];
    uint top = 1;
    left_stack[0] = left_cell;
    right_stack[0] = right_cell;
    bool unknown = false;
    uint map_base = args.scalar_cell_count * 4;
    uint list_base = map_base + args.map_entry_count * 2;
    while (top != 0) {
        --top;
        uint left_index = left_stack[top];
        uint right_index = right_stack[top];
        if (left_index >= args.scalar_cell_count || right_index >= args.scalar_cell_count) return 3;
        uint left_tag = ig_scalar_program_cell_word(tables, left_index, 0);
        uint right_tag = ig_scalar_program_cell_word(tables, right_index, 0);
        ulong left_payload = ig_scalar_program_cell_payload(tables, left_index);
        ulong right_payload = ig_scalar_program_cell_payload(tables, right_index);
        uint left_auxiliary = ig_scalar_program_cell_word(tables, left_index, 3);
        uint right_auxiliary = ig_scalar_program_cell_word(tables, right_index, 3);
        if (left_tag > 6 || right_tag > 6) return 3;
        if (left_tag == 0 || right_tag == 0) {
            unknown = true;
            continue;
        }
        if (left_tag == 2 && right_tag == 2) {
            if (left_payload != right_payload) return 1;
            continue;
        }
        if (left_tag == 3 && right_tag == 3) {
            if (!ig_scalar_f64_equal(left_payload, right_payload)) return 1;
            continue;
        }
        if (left_tag == 2 && right_tag == 3) {
            if (!ig_scalar_i64_f64_equal(as_type<long>(left_payload), right_payload)) return 1;
            continue;
        }
        if (left_tag == 3 && right_tag == 2) {
            if (!ig_scalar_i64_f64_equal(as_type<long>(right_payload), left_payload)) return 1;
            continue;
        }
        if (left_tag == 1 && right_tag == 1) {
            if (left_payload > 1 || right_payload > 1) return 3;
            if (left_payload != right_payload) return 1;
            continue;
        }
        if (left_tag == 4 && right_tag == 4) {
            if (left_payload != right_payload) return 1;
            continue;
        }
        if (left_tag == 5 && right_tag == 5) {
            if (left_auxiliary != right_auxiliary) return 1;
            if ((left_payload >> 32) != 0 || (right_payload >> 32) != 0) return 3;
            uint left_start = uint(left_payload);
            uint right_start = uint(right_payload);
            uint count = left_auxiliary;
            if (left_start > args.scalar_list_entry_count
                    || right_start > args.scalar_list_entry_count
                    || count > args.scalar_list_entry_count - left_start
                    || count > args.scalar_list_entry_count - right_start
                    || count > IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS - top) return 3;
            for (uint index = 0; index < count; ++index) {
                uint left_child = tables[list_base + left_start + index];
                uint right_child = tables[list_base + right_start + index];
                if (left_child >= args.scalar_cell_count || right_child >= args.scalar_cell_count) {
                    return 3;
                }
                left_stack[top] = left_child;
                right_stack[top] = right_child;
                ++top;
            }
            continue;
        }
        if (left_tag == 6 && right_tag == 6) {
            if (left_auxiliary != right_auxiliary) return 1;
            if ((left_payload >> 32) != 0 || (right_payload >> 32) != 0) return 3;
            uint left_start = uint(left_payload);
            uint right_start = uint(right_payload);
            uint count = left_auxiliary;
            if (left_start > args.map_entry_count || right_start > args.map_entry_count
                    || count > args.map_entry_count - left_start
                    || count > args.map_entry_count - right_start
                    || count > IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS - top) return 3;
            for (uint index = 0; index < count; ++index) {
                uint left_entry = map_base + (left_start + index) * 2;
                uint key = tables[left_entry];
                uint left_child = tables[left_entry + 1];
                bool found = false;
                uint right_child = 0;
                for (uint candidate = 0; candidate < count; ++candidate) {
                    uint right_entry = map_base + (right_start + candidate) * 2;
                    if (tables[right_entry] == key) {
                        right_child = tables[right_entry + 1];
                        found = true;
                        break;
                    }
                }
                if (!found || left_child >= args.scalar_cell_count
                        || right_child >= args.scalar_cell_count) return 3;
                left_stack[top] = left_child;
                right_stack[top] = right_child;
                ++top;
            }
            continue;
        }
        return 1;
    }
    return unknown ? 0 : 2;
}

// Returns 2 for an ordinary comparable pair, 1 for a numeric NaN pair, 0 for Cypher
// incomparability, and 3 for a malformed canonical scalar-program cell.
inline uchar ig_scalar_program_order_value(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint right_cell,
    thread int& order) {
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count) return 3;
    uint left_tag = ig_scalar_program_cell_word(tables, left_cell, 0u);
    uint right_tag = ig_scalar_program_cell_word(tables, right_cell, 0u);
    if (left_tag > 6u || right_tag > 6u) return 3;
    if (left_tag == 0u || right_tag == 0u) return 0;
    ulong left = ig_scalar_program_cell_payload(tables, left_cell);
    ulong right = ig_scalar_program_cell_payload(tables, right_cell);
    bool left_numeric = left_tag == 2u || left_tag == 3u;
    bool right_numeric = right_tag == 2u || right_tag == 3u;
    if (left_numeric && right_numeric) {
        if ((left_tag == 3u && ig_f64_is_nan(left))
                || (right_tag == 3u && ig_f64_is_nan(right))) return 1;
        if (left_tag == 2u && right_tag == 2u) {
            long l = as_type<long>(left);
            long r = as_type<long>(right);
            order = l < r ? -1 : (l > r ? 1 : 0);
            return 2;
        }
        if (left_tag == 3u && right_tag == 3u) {
            ulong l = ig_ordered_f64_bits(left);
            ulong r = ig_ordered_f64_bits(right);
            order = l < r ? -1 : (l > r ? 1 : 0);
            return 2;
        }
        if (left_tag == 2u) {
            return ig_scalar_i64_f64_order(as_type<long>(left), right, order) ? 2 : 1;
        }
        int reverse_order = 0;
        if (!ig_scalar_i64_f64_order(as_type<long>(right), left, reverse_order)) return 1;
        order = -reverse_order;
        return 2;
    }
    if (left_tag == 1u && right_tag == 1u) {
        if (left > 1ul || right > 1ul) return 3;
        order = left < right ? -1 : (left > right ? 1 : 0);
        return 2;
    }
    if (left_tag == 4u && right_tag == 4u) {
        uint left_start = 0u;
        uint left_end = 0u;
        uint left_base = 0u;
        uint right_start = 0u;
        uint right_end = 0u;
        uint right_base = 0u;
        if (!ig_scalar_program_string_bounds(
                tables, args, left_cell, left_start, left_end, left_base)
                || !ig_scalar_program_string_bounds(
                    tables, args, right_cell, right_start, right_end, right_base)) return 3;
        uint shared = min(left_end - left_start, right_end - right_start);
        for (uint index = 0u; index < shared; ++index) {
            uint l = tables[left_base + left_start + index];
            uint r = tables[right_base + right_start + index];
            if (l != r) {
                order = l < r ? -1 : 1;
                return 2;
            }
        }
        uint left_length = left_end - left_start;
        uint right_length = right_end - right_start;
        order = left_length < right_length ? -1 : (left_length > right_length ? 1 : 0);
        return 2;
    }
    return 0;
}

inline uchar ig_scalar_program_order_list(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint right_cell,
    uint operation) {
    uint left_starts[IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS];
    uint right_starts[IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS];
    uint left_counts[IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS];
    uint right_counts[IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS];
    uint positions[IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS];
    uint depth = 0u;
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count
            || ig_scalar_program_cell_word(tables, left_cell, 0u) != 5u
            || ig_scalar_program_cell_word(tables, right_cell, 0u) != 5u) return 3;
    ulong left_payload = ig_scalar_program_cell_payload(tables, left_cell);
    ulong right_payload = ig_scalar_program_cell_payload(tables, right_cell);
    if ((left_payload >> 32u) != 0ul || (right_payload >> 32u) != 0ul) return 3;
    left_starts[0] = uint(left_payload);
    right_starts[0] = uint(right_payload);
    left_counts[0] = ig_scalar_program_cell_word(tables, left_cell, 3u);
    right_counts[0] = ig_scalar_program_cell_word(tables, right_cell, 3u);
    positions[0] = 0u;
    uint list_base = args.scalar_cell_count * 4u + args.map_entry_count * 2u;
    while (true) {
        uint left_start = left_starts[depth];
        uint right_start = right_starts[depth];
        uint left_count = left_counts[depth];
        uint right_count = right_counts[depth];
        if (left_start > args.scalar_list_entry_count || right_start > args.scalar_list_entry_count
                || left_count > args.scalar_list_entry_count - left_start
                || right_count > args.scalar_list_entry_count - right_start) return 3;
        uint shared = min(left_count, right_count);
        if (positions[depth] >= shared) {
            if (left_count != right_count) {
                return ig_compare_order(left_count < right_count ? -1 : 1, operation);
            }
            if (depth == 0u) return ig_compare_order(0, operation);
            --depth;
            ++positions[depth];
            continue;
        }
        uint position = positions[depth];
        uint left_child = tables[list_base + left_start + position];
        uint right_child = tables[list_base + right_start + position];
        if (left_child >= args.scalar_cell_count || right_child >= args.scalar_cell_count) return 3;
        uint left_tag = ig_scalar_program_cell_word(tables, left_child, 0u);
        uint right_tag = ig_scalar_program_cell_word(tables, right_child, 0u);
        if (left_tag == 5u && right_tag == 5u) {
            ulong nested_left = ig_scalar_program_cell_payload(tables, left_child);
            ulong nested_right = ig_scalar_program_cell_payload(tables, right_child);
            if (depth + 1u >= IG_SCALAR_PROGRAM_STRUCTURAL_MAX_PAIRS
                    || (nested_left >> 32u) != 0ul || (nested_right >> 32u) != 0ul) return 3;
            ++depth;
            left_starts[depth] = uint(nested_left);
            right_starts[depth] = uint(nested_right);
            left_counts[depth] = ig_scalar_program_cell_word(tables, left_child, 3u);
            right_counts[depth] = ig_scalar_program_cell_word(tables, right_child, 3u);
            positions[depth] = 0u;
            continue;
        }
        int order = 0;
        uchar status = ig_scalar_program_order_value(tables, args, left_child, right_child, order);
        if (status == 0u) return 0;
        if (status == 1u) return 1;
        if (status != 2u) return 3;
        if (order != 0) return ig_compare_order(order, operation);
        ++positions[depth];
    }
}

inline uint ig_scalar_program_compare(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint right_cell,
    uint operation) {
    if (ig_scalar_program_is_semantic_status(left_cell)) return left_cell;
    if (ig_scalar_program_is_semantic_status(right_cell)) return right_cell;
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count
            || args.false_cell >= args.scalar_cell_count || args.true_cell >= args.scalar_cell_count
            || operation > 5u) return IG_SCALAR_PROGRAM_CORRUPT;
    uchar result = 3;
    if (operation <= 1u) {
        result = ig_scalar_program_structural_equal(tables, args, left_cell, right_cell);
        if (operation == 1u) {
            if (result == 1u) result = 2u;
            else if (result == 2u) result = 1u;
        }
    } else {
        uint left_tag = ig_scalar_program_cell_word(tables, left_cell, 0u);
        uint right_tag = ig_scalar_program_cell_word(tables, right_cell, 0u);
        if (left_tag == 5u && right_tag == 5u) {
            result = ig_scalar_program_order_list(
                tables, args, left_cell, right_cell, operation);
        } else {
            int order = 0;
            uchar status = ig_scalar_program_order_value(
                tables, args, left_cell, right_cell, order);
            result = status == 2u ? ig_compare_order(order, operation) : status;
        }
    }
    if (result == 0u) return args.null_cell;
    if (result == 1u) return args.false_cell;
    if (result == 2u) return args.true_cell;
    return IG_SCALAR_PROGRAM_CORRUPT;
}

inline uint ig_scalar_program_list_membership(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint right_cell) {
    if (ig_scalar_program_is_semantic_status(left_cell)) return left_cell;
    if (ig_scalar_program_is_semantic_status(right_cell)) return right_cell;
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count
            || args.false_cell >= args.scalar_cell_count || args.true_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    if (ig_scalar_program_cell_word(tables, args.false_cell, 0) != 1
            || ig_scalar_program_cell_payload(tables, args.false_cell) != 0
            || ig_scalar_program_cell_word(tables, args.true_cell, 0) != 1
            || ig_scalar_program_cell_payload(tables, args.true_cell) != 1) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint right_tag = ig_scalar_program_cell_word(tables, right_cell, 0);
    if (right_tag == 0) return args.null_cell;
    if (right_tag != 5) return IG_SCALAR_PROGRAM_INVALID;
    ulong start_payload = ig_scalar_program_cell_payload(tables, right_cell);
    if (start_payload > 0xfffffffful) return IG_SCALAR_PROGRAM_CORRUPT;
    uint start = uint(start_payload);
    uint count = ig_scalar_program_cell_word(tables, right_cell, 3);
    if (start > args.scalar_list_entry_count || count > args.scalar_list_entry_count - start) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint list_base = args.scalar_cell_count * 4 + args.map_entry_count * 2;
    bool unknown = false;
    for (uint index = 0; index < count; ++index) {
        uint child = tables[list_base + start + index];
        uchar equal = ig_scalar_program_structural_equal(tables, args, left_cell, child);
        if (equal == 2) return args.true_cell;
        if (equal == 0) unknown = true;
        else if (equal != 1) return IG_SCALAR_PROGRAM_CORRUPT;
    }
    return unknown ? args.null_cell : args.false_cell;
}

inline uint ig_scalar_program_list_slice_membership(
    device const uint* tables,
    constant ScalarProgramArgs& args,
    uint left_cell,
    uint list_cell,
    uint start_cell,
    uint end_cell) {
    if (ig_scalar_program_is_semantic_status(left_cell)) return left_cell;
    if (ig_scalar_program_is_semantic_status(list_cell)) return list_cell;
    if (ig_scalar_program_is_semantic_status(start_cell)) return start_cell;
    if (ig_scalar_program_is_semantic_status(end_cell)) return end_cell;
    if (left_cell >= args.scalar_cell_count || list_cell >= args.scalar_cell_count
            || start_cell >= args.scalar_cell_count || end_cell >= args.scalar_cell_count
            || args.false_cell >= args.scalar_cell_count || args.true_cell >= args.scalar_cell_count) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    if (ig_scalar_program_cell_word(tables, args.false_cell, 0) != 1
            || ig_scalar_program_cell_payload(tables, args.false_cell) != 0
            || ig_scalar_program_cell_word(tables, args.true_cell, 0) != 1
            || ig_scalar_program_cell_payload(tables, args.true_cell) != 1) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    uint list_tag = ig_scalar_program_cell_word(tables, list_cell, 0);
    if (list_tag == 0) return args.null_cell;
    if (list_tag != 5) return IG_SCALAR_PROGRAM_INVALID;
    uint start_tag = ig_scalar_program_cell_word(tables, start_cell, 0);
    uint end_tag = ig_scalar_program_cell_word(tables, end_cell, 0);
    if (start_tag == 0 || end_tag == 0) return args.null_cell;
    if (start_tag != 2 || end_tag != 2) return IG_SCALAR_PROGRAM_INVALID;
    ulong list_payload = ig_scalar_program_cell_payload(tables, list_cell);
    if (list_payload > 0xfffffffful) return IG_SCALAR_PROGRAM_CORRUPT;
    uint list_start = uint(list_payload);
    uint list_count = ig_scalar_program_cell_word(tables, list_cell, 3);
    if (list_start > args.scalar_list_entry_count
            || list_count > args.scalar_list_entry_count - list_start) {
        return IG_SCALAR_PROGRAM_CORRUPT;
    }
    long length = long(list_count);
    long start = as_type<long>(ig_scalar_program_cell_payload(tables, start_cell));
    long end = as_type<long>(ig_scalar_program_cell_payload(tables, end_cell));
    if (start < 0) start = length + start;
    if (end < 0) end = length + end;
    if (start < 0) start = 0;
    if (start > length) start = length;
    if (end < 0) end = 0;
    if (end > length) end = length;
    if (end < start) end = start;
    uint list_base = args.scalar_cell_count * 4 + args.map_entry_count * 2;
    bool unknown = false;
    for (long index = start; index < end; ++index) {
        uint child = tables[list_base + list_start + uint(index)];
        uchar equal = ig_scalar_program_structural_equal(tables, args, left_cell, child);
        if (equal == 2) return args.true_cell;
        if (equal == 0) unknown = true;
        else if (equal != 1) return IG_SCALAR_PROGRAM_CORRUPT;
    }
    return unknown ? args.null_cell : args.false_cell;
}

kernel void ig_scalar_program(
    device const uint* program [[buffer(0)]],
    device const uint* tables [[buffer(1)]],
    device uint* output [[buffer(2)]],
    constant ScalarProgramArgs& args [[buffer(3)]],
    uint slot [[thread_position_in_threadgroup]]) {
    uint instruction_words = args.instruction_count * 9;
    bool valid_program = args.instruction_count <= IG_SCALAR_PROGRAM_MAX_REGISTERS
        && args.scalar_cell_count > args.instruction_count
        && instruction_words <= args.program_word_count
        && args.output_count <= (args.program_word_count - instruction_words) / 2
        && args.null_cell < args.scalar_cell_count - args.instruction_count;
    device uint* materialized_tables = output + args.output_count;
    device uint* completion_receipt = materialized_tables + args.table_word_count;
    if (slot == 0) {
        // Mark roots corrupt first. Malformed descriptors are device/frame failures, not Cypher
        // type errors, even if evaluation cannot reach a particular output descriptor.
        for (uint output_slot = 0; output_slot < args.output_count; ++output_slot) {
            output[output_slot] = IG_SCALAR_PROGRAM_CORRUPT;
        }
        // An invalid or interrupted command must never inherit a valid-looking completion from
        // recycled device memory.
        for (uint receipt_slot = 0; receipt_slot < 8; ++receipt_slot) {
            completion_receipt[receipt_slot] = 0;
        }
    }
    for (uint table_slot = slot; table_slot < args.table_word_count; table_slot += 256) {
        materialized_tables[table_slot] = tables[table_slot];
    }
    threadgroup_barrier(mem_flags::mem_device);
    if (slot == 0 && valid_program) {
        uint registers[IG_SCALAR_PROGRAM_MAX_REGISTERS];
        uint register_cell_base = args.scalar_cell_count - args.instruction_count;
        for (uint instruction = 0; instruction < args.instruction_count; ++instruction) {
            uint base = instruction * 9;
            uint opcode = program[base];
            uint left = ig_scalar_program_operand(
                registers,
                instruction,
                args.scalar_cell_count,
                program[base + 1],
                program[base + 2]);
            uint right = ig_scalar_program_operand(
                registers,
                instruction,
                args.scalar_cell_count,
                program[base + 3],
                program[base + 4]);
            if (opcode == 0) {
                registers[instruction] = ig_scalar_program_dynamic_index(
                    materialized_tables, args, left, right);
            } else if (opcode == 1) {
                registers[instruction] = ig_scalar_program_to_integer(
                    materialized_tables, args, left, register_cell_base + instruction);
            } else if (opcode == 2) {
                registers[instruction] = ig_scalar_program_list_membership(
                    materialized_tables, args, left, right);
            } else if (opcode == 3) {
                uint start = ig_scalar_program_operand(
                    registers,
                    instruction,
                    args.scalar_cell_count,
                    program[base + 5],
                    program[base + 6]);
                uint end = ig_scalar_program_operand(
                    registers,
                    instruction,
                    args.scalar_cell_count,
                    program[base + 7],
                    program[base + 8]);
                registers[instruction] = ig_scalar_program_list_slice_membership(
                    materialized_tables, args, left, right, start, end);
            } else if (opcode == 4) {
                registers[instruction] = ig_scalar_program_numeric_binary(
                    materialized_tables,
                    args,
                    left,
                    right,
                    register_cell_base + instruction,
                    opcode);
            } else if (opcode == 5) {
                uint offset = ig_scalar_program_operand(
                    registers,
                    instruction,
                    args.scalar_cell_count,
                    program[base + 5],
                    program[base + 6]);
                if (program[base + 1] != 1) {
                    registers[instruction] = IG_SCALAR_PROGRAM_CORRUPT;
                } else {
                    registers[instruction] = ig_scalar_program_build_list(
                        materialized_tables,
                        args,
                        registers,
                        instruction,
                        program[base + 2],
                        right,
                        offset,
                        register_cell_base + instruction);
                }
            } else if (opcode == 6) {
                registers[instruction] = ig_scalar_program_to_float(
                    materialized_tables, args, left, register_cell_base + instruction);
            } else if (opcode == 7) {
                registers[instruction] = ig_scalar_program_to_string(
                    materialized_tables,
                    args,
                    left,
                    instruction,
                    register_cell_base + instruction);
            } else if (opcode >= 8 && opcode <= 12) {
                registers[instruction] = ig_scalar_program_numeric_binary(
                    materialized_tables,
                    args,
                    left,
                    right,
                    register_cell_base + instruction,
                    opcode);
            } else if (opcode == 13) {
                registers[instruction] = ig_scalar_program_numeric_positive(
                    materialized_tables, args, left);
            } else if (opcode == 14) {
                registers[instruction] = ig_scalar_program_numeric_negative(
                    materialized_tables,
                    args,
                    left,
                    register_cell_base + instruction);
            } else if (opcode == 15) {
                uint offset = ig_scalar_program_operand(
                    registers,
                    instruction,
                    args.scalar_cell_count,
                    program[base + 5],
                    program[base + 6]);
                uint capacity = ig_scalar_program_operand(
                    registers,
                    instruction,
                    args.scalar_cell_count,
                    program[base + 7],
                    program[base + 8]);
                registers[instruction] = ig_scalar_program_cypher_add(
                    materialized_tables,
                    args,
                    left,
                    right,
                    offset,
                    capacity,
                    register_cell_base + instruction);
            } else if (opcode == 16) {
                uint end = ig_scalar_program_operand(
                    registers,
                    instruction,
                    args.scalar_cell_count,
                    program[base + 5],
                    program[base + 6]);
                uint descriptor = ig_scalar_program_operand(
                    registers,
                    instruction,
                    args.scalar_cell_count,
                    program[base + 7],
                    program[base + 8]);
                registers[instruction] = ig_scalar_program_list_slice(
                    materialized_tables,
                    args,
                    left,
                    right,
                    end,
                    descriptor,
                    register_cell_base + instruction);
            } else if (opcode == 17) {
                registers[instruction] = ig_scalar_program_map_keys(
                    materialized_tables,
                    args,
                    left,
                    right,
                    register_cell_base + instruction);
            } else if (opcode >= 18u && opcode <= 23u) {
                registers[instruction] = ig_scalar_program_compare(
                    materialized_tables,
                    args,
                    left,
                    right,
                    opcode - 18u);
            } else {
                registers[instruction] = IG_SCALAR_PROGRAM_CORRUPT;
            }
        }
        uint output_base = instruction_words;
        for (uint output_slot = 0; output_slot < args.output_count; ++output_slot) {
            uint base = output_base + output_slot * 2;
            output[output_slot] = ig_scalar_program_operand(
                registers,
                args.instruction_count,
                args.scalar_cell_count,
                program[base],
                program[base + 1]);
        }
        // Publish the request-bound Metal completion only after the native program and every root
        // have completed. CPU uses a different digest and cannot satisfy this frame contract.
        for (uint receipt_slot = 0; receipt_slot < 8; ++receipt_slot) {
            completion_receipt[receipt_slot] = args.receipt_words[receipt_slot];
        }
    }
}

constant uint IG_BOOLEAN_PROGRAM_MAX_REGISTERS = 512;
constant uint IG_SCALAR_EXPRESSION_MAX_REGISTERS = 64;
constant uint IG_SCALAR_STRUCTURAL_MAX_PAIRS = 128;
constant long IG_I64_MAX = 9223372036854775807L;
constant long IG_I64_MIN = -9223372036854775807L - 1L;

struct BooleanProgramArgs {
    ulong row_count;
    uint input_count;
    uint list_input_count;
    uint list_input_width;
    uint input_stride;
    uint instruction_count;
    uint output_count;
    uint filter_count;
    uint scalar_cell_count;
    uint map_entry_count;
    uint scalar_list_entry_count;
    uint scalar_predicate_count;
    uint scalar_expression_count;
    uint scalar_expression_instruction_count;
    uint reduction_count;
    uint reduction_register_count;
};

struct IgScalarValue {
    uint tag;
    ulong payload;
    uint auxiliary;
};

inline uchar ig_boolean_and(uchar left, uchar right) {
    if (left == 3 || right == 3) return 3;
    if (left == 1 || right == 1) return 1;
    if (left == 0 || right == 0) return 0;
    return 2;
}

inline uchar ig_boolean_or(uchar left, uchar right) {
    if (left == 3 || right == 3) return 3;
    if (left == 2 || right == 2) return 2;
    if (left == 0 || right == 0) return 0;
    return 1;
}

inline uchar ig_boolean_xor(uchar left, uchar right) {
    if (left == 3 || right == 3) return 3;
    if (left == 0 || right == 0) return 0;
    return left == right ? 1 : 2;
}

inline uchar ig_boolean_not(uchar value) {
    if (value == 3) return 3;
    if (value == 0) return 0;
    return value == 1 ? 2 : 1;
}

inline uchar ig_boolean_equal(uchar left, uchar right) {
    if (left == 3 || right == 3) return 3;
    if (left == 0 || right == 0) return 0;
    return left == right ? 2 : 1;
}

inline uchar ig_boolean_input_membership(
    device const uint* inputs,
    constant BooleanProgramArgs& args,
    uint row,
    uchar left,
    uint list_input) {
    if (list_input >= args.list_input_count) return 3;
    uint list_width = args.list_input_width;
    ulong base = ulong(row) * args.input_stride + args.input_count
        + ulong(list_input) * (ulong(list_width) + 1);
    uint count = inputs[base];
    if (count > list_width) return 3;
    bool has_unknown = false;
    for (uint index = 0; index < count; ++index) {
        uint tag = inputs[base + index + 1];
        if (tag > 2) return 3;
        uchar equal = ig_boolean_equal(left, uchar(tag));
        if (equal == 2) return 2;
        if (equal == 0) has_unknown = true;
        else if (equal != 1) return 3;
    }
    return has_unknown ? 0 : 1;
}

inline uint ig_scalar_base(constant BooleanProgramArgs& args) {
    return args.instruction_count * 3;
}

inline uint ig_map_base(constant BooleanProgramArgs& args) {
    return ig_scalar_base(args) + args.scalar_cell_count * 4;
}

inline uint ig_scalar_list_base(constant BooleanProgramArgs& args) {
    return ig_map_base(args) + args.map_entry_count * 2;
}

inline uint ig_predicate_base(constant BooleanProgramArgs& args) {
    return ig_scalar_list_base(args) + args.scalar_list_entry_count;
}

inline uint ig_reduction_base(constant BooleanProgramArgs& args) {
    return ig_predicate_base(args) + args.scalar_predicate_count * 4;
}

inline uint ig_reduction_register_base(constant BooleanProgramArgs& args) {
    return ig_reduction_base(args) + args.reduction_count * 3;
}

inline uint ig_scalar_expression_descriptor_base(constant BooleanProgramArgs& args) {
    return ig_reduction_register_base(args) + args.reduction_register_count;
}

inline uint ig_scalar_expression_instruction_base(constant BooleanProgramArgs& args) {
    return ig_scalar_expression_descriptor_base(args) + args.scalar_expression_count * 3;
}

inline uint ig_scalar_word(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint cell,
    uint field) {
    return code[ig_scalar_base(args) + cell * 4 + field];
}

inline ulong ig_scalar_payload(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint cell) {
    return ulong(ig_scalar_word(code, args, cell, 1))
        | (ulong(ig_scalar_word(code, args, cell, 2)) << 32);
}

inline IgScalarValue ig_invalid_scalar_value() {
    IgScalarValue value;
    value.tag = 7;
    value.payload = 0;
    value.auxiliary = 0;
    return value;
}

inline IgScalarValue ig_scalar_cell_value(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint cell) {
    if (cell >= args.scalar_cell_count) return ig_invalid_scalar_value();
    IgScalarValue value;
    value.tag = ig_scalar_word(code, args, cell, 0);
    value.payload = ig_scalar_payload(code, args, cell);
    value.auxiliary = ig_scalar_word(code, args, cell, 3);
    return value;
}

inline bool ig_scalar_f64_equal(ulong left, ulong right) {
    const ulong exponent_mask = 0x7ff0000000000000ul;
    const ulong fraction_mask = 0x000ffffffffffffful;
    if (((left & exponent_mask) == exponent_mask && (left & fraction_mask) != 0)
            || ((right & exponent_mask) == exponent_mask && (right & fraction_mask) != 0)) {
        return false;
    }
    // Cypher numeric equality treats signed zeroes as equal.
    if ((left & ~0x8000000000000000ul) == 0 && (right & ~0x8000000000000000ul) == 0) {
        return true;
    }
    return (left & (exponent_mask | fraction_mask | 0x8000000000000000ul))
        == (right & (exponent_mask | fraction_mask | 0x8000000000000000ul));
}

// Exact INTEGER/FLOAT equality without requiring device FP64 arithmetic. The conversion only
// succeeds when the finite F64 is an exact signed-i64 integer, so values above 2^53 never lose
// bits through a host or device cast.
inline bool ig_scalar_i64_f64_equal(long integer, ulong float_bits) {
    uint exponent_bits = uint((float_bits >> 52) & 0x7fful);
    ulong fraction = float_bits & 0x000ffffffffffffful;
    if (exponent_bits == 0x7ff) return false;
    if (exponent_bits == 0) return fraction == 0 && integer == 0;
    int exponent = int(exponent_bits) - 1023;
    if (exponent < 0 || exponent > 63) return false;
    bool negative = (float_bits & 0x8000000000000000ul) != 0;
    if (exponent == 63) {
        return negative && fraction == 0 && integer == IG_I64_MIN;
    }
    ulong significand = 0x0010000000000000ul | fraction;
    ulong magnitude = 0;
    if (exponent < 52) {
        uint shift = uint(52 - exponent);
        ulong fractional_mask = (ulong(1) << shift) - 1;
        if ((significand & fractional_mask) != 0) return false;
        magnitude = significand >> shift;
    } else {
        magnitude = significand << uint(exponent - 52);
    }
    if (negative) {
        if (integer >= 0) return false;
        // This form is also defined for `long::MIN`.
        ulong integer_magnitude = ulong(-(integer + 1)) + 1;
        return integer_magnitude == magnitude;
    }
    return integer >= 0 && ulong(integer) == magnitude;
}

// Iterative deep equality for the scalar LIST/MAP child pools. The request contract limits the
// total child pool used by a structural comparison, so private device memory remains bounded and
// the kernel never needs recursion or host-side comparison.
inline uchar ig_scalar_structural_equal(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint left_cell,
    uint right_cell) {
    if (left_cell >= args.scalar_cell_count || right_cell >= args.scalar_cell_count) return 3;
    uint left_stack[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint right_stack[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint top = 1;
    left_stack[0] = left_cell;
    right_stack[0] = right_cell;
    bool unknown = false;
    while (top != 0) {
        --top;
        uint left_index = left_stack[top];
        uint right_index = right_stack[top];
        IgScalarValue left = ig_scalar_cell_value(code, args, left_index);
        IgScalarValue right = ig_scalar_cell_value(code, args, right_index);
        if (left.tag == 7 || right.tag == 7) return 3;
        if (left.tag == 0 || right.tag == 0) {
            unknown = true;
            continue;
        }
        if (left.tag == 2 && right.tag == 2) {
            if (left.payload != right.payload) return 1;
            continue;
        }
        if (left.tag == 3 && right.tag == 3) {
            if (!ig_scalar_f64_equal(left.payload, right.payload)) return 1;
            continue;
        }
        if (left.tag == 2 && right.tag == 3) {
            if (!ig_scalar_i64_f64_equal(as_type<long>(left.payload), right.payload)) return 1;
            continue;
        }
        if (left.tag == 3 && right.tag == 2) {
            if (!ig_scalar_i64_f64_equal(as_type<long>(right.payload), left.payload)) return 1;
            continue;
        }
        if (left.tag == 1 && right.tag == 1) {
            if (left.payload > 1 || right.payload > 1) return 3;
            if (left.payload != right.payload) return 1;
            continue;
        }
        if (left.tag == 4 && right.tag == 4) {
            if (left.payload != right.payload) return 1;
            continue;
        }
        if (left.tag == 5 && right.tag == 5) {
            if (left.auxiliary != right.auxiliary) return 1;
            uint count = left.auxiliary;
            uint left_start = uint(left.payload);
            uint right_start = uint(right.payload);
            if (left.payload >> 32 != 0 || right.payload >> 32 != 0
                    || left_start > args.scalar_list_entry_count
                    || right_start > args.scalar_list_entry_count
                    || count > args.scalar_list_entry_count - left_start
                    || count > args.scalar_list_entry_count - right_start
                    || count > IG_SCALAR_STRUCTURAL_MAX_PAIRS - top) return 3;
            uint list_base = ig_scalar_list_base(args);
            for (uint index = 0; index < count; ++index) {
                uint left_child = code[list_base + left_start + index];
                uint right_child = code[list_base + right_start + index];
                if (left_child >= args.scalar_cell_count || right_child >= args.scalar_cell_count) {
                    return 3;
                }
                left_stack[top] = left_child;
                right_stack[top] = right_child;
                ++top;
            }
            continue;
        }
        if (left.tag == 6 && right.tag == 6) {
            if (left.auxiliary != right.auxiliary) return 1;
            uint count = left.auxiliary;
            uint left_start = uint(left.payload);
            uint right_start = uint(right.payload);
            if (left.payload >> 32 != 0 || right.payload >> 32 != 0
                    || left_start > args.map_entry_count || right_start > args.map_entry_count
                    || count > args.map_entry_count - left_start
                    || count > args.map_entry_count - right_start
                    || count > IG_SCALAR_STRUCTURAL_MAX_PAIRS - top) return 3;
            uint map_base = ig_map_base(args);
            for (uint index = 0; index < count; ++index) {
                uint left_entry = map_base + (left_start + index) * 2;
                uint key = code[left_entry];
                uint left_child = code[left_entry + 1];
                bool found = false;
                uint right_child = 0;
                for (uint candidate = 0; candidate < count; ++candidate) {
                    uint right_entry = map_base + (right_start + candidate) * 2;
                    if (code[right_entry] == key) {
                        right_child = code[right_entry + 1];
                        found = true;
                        break;
                    }
                }
                if (!found || left_child >= args.scalar_cell_count
                        || right_child >= args.scalar_cell_count) return 3;
                left_stack[top] = left_child;
                right_stack[top] = right_child;
                ++top;
            }
            continue;
        }
        // Equality across two non-null, unlike Cypher value types is false, not a type error.
        return 1;
    }
    return unknown ? 0 : 2;
}

inline uchar ig_compare_order(int order, uint operation) {
    bool result = (operation == 0 && order == 0)
        || (operation == 1 && order != 0)
        || (operation == 2 && order < 0)
        || (operation == 3 && order <= 0)
        || (operation == 4 && order > 0)
        || (operation == 5 && order >= 0);
    return result ? 2 : 1;
}

inline uchar ig_boolean_order_compare(uchar left, uchar right, uint operation) {
    if (left == 3 || right == 3) return 3;
    if (left == 0 || right == 0) return 0;
    int order = left < right ? -1 : (left > right ? 1 : 0);
    return ig_compare_order(order, operation);
}

// Metal does not expose FP64 on every supported device. IEEE-754's monotonic bit transform lets
// this scalar VM compare finite F64 literals exactly without down-casting them to F32. Zero signs
// are normalized because Cypher considers -0.0 and 0.0 equal.
inline ulong ig_ordered_f64_bits(ulong bits) {
    if ((bits & 0x7ffffffffffffffful) == 0) bits = 0;
    return (bits & 0x8000000000000000ul) != 0
        ? ~bits
        : (bits | 0x8000000000000000ul);
}

inline bool ig_f64_is_nan(ulong bits) {
    return (bits & 0x7ff0000000000000ul) == 0x7ff0000000000000ul
        && (bits & 0x000ffffffffffffful) != 0;
}

// Exact INTEGER/FLOAT ordering without FP64 arithmetic. `order` is INTEGER compared with FLOAT.
inline bool ig_scalar_i64_f64_order(long integer, ulong float_bits, thread int& order) {
    if (ig_f64_is_nan(float_bits)) return false;
    ulong absolute_float = float_bits & 0x7ffffffffffffffful;
    bool float_negative = (float_bits >> 63) != 0 && absolute_float != 0;
    if (integer < 0 && !float_negative) {
        order = -1;
        return true;
    }
    if (integer >= 0 && float_negative) {
        order = 1;
        return true;
    }
    ulong integer_magnitude = integer < 0 ? ulong(-(integer + 1)) + 1 : ulong(integer);
    uint exponent_bits = uint((absolute_float >> 52) & 0x7fful);
    ulong fraction = absolute_float & 0x000ffffffffffffful;
    int magnitude_order = 0;
    if (exponent_bits == 0x7ff) {
        magnitude_order = -1;
    } else if (exponent_bits == 0) {
        if (fraction == 0) {
            magnitude_order = integer_magnitude == 0 ? 0 : 1;
        } else {
            magnitude_order = integer_magnitude == 0 ? -1 : 1;
        }
    } else {
        int exponent = int(exponent_bits) - 1023;
        if (exponent < 0) {
            magnitude_order = integer_magnitude == 0 ? -1 : 1;
        } else if (exponent > 63) {
            magnitude_order = -1;
        } else {
            ulong significand = 0x0010000000000000ul | fraction;
            if (exponent >= 52) {
                ulong float_magnitude = significand << uint(exponent - 52);
                magnitude_order = integer_magnitude < float_magnitude
                    ? -1 : (integer_magnitude > float_magnitude ? 1 : 0);
            } else {
                uint shift = uint(52 - exponent);
                ulong integral = significand >> shift;
                ulong mask = (ulong(1) << shift) - 1;
                magnitude_order = integer_magnitude < integral
                    ? -1 : (integer_magnitude > integral ? 1 : ((significand & mask) != 0 ? -1 : 0));
            }
        }
    }
    order = float_negative ? -magnitude_order : magnitude_order;
    return true;
}

// Returns 2 for an ordinary comparable pair, 1 for a numeric NaN pair, 0 for Cypher
// incomparability, and 3 for a malformed device value.
inline uchar ig_scalar_value_order(
    IgScalarValue left,
    IgScalarValue right,
    thread int& order) {
    if (left.tag == 7 || right.tag == 7) return 3;
    if (left.tag == 0 || right.tag == 0) return 0;
    bool left_numeric = left.tag == 2 || left.tag == 3;
    bool right_numeric = right.tag == 2 || right.tag == 3;
    if (left_numeric && right_numeric) {
        if ((left.tag == 3 && ig_f64_is_nan(left.payload))
                || (right.tag == 3 && ig_f64_is_nan(right.payload))) return 1;
        if (left.tag == 2 && right.tag == 2) {
            long l = as_type<long>(left.payload);
            long r = as_type<long>(right.payload);
            order = l < r ? -1 : (l > r ? 1 : 0);
            return 2;
        }
        if (left.tag == 3 && right.tag == 3) {
            ulong l = ig_ordered_f64_bits(left.payload);
            ulong r = ig_ordered_f64_bits(right.payload);
            order = l < r ? -1 : (l > r ? 1 : 0);
            return 2;
        }
        if (left.tag == 2) {
            return ig_scalar_i64_f64_order(as_type<long>(left.payload), right.payload, order)
                ? 2 : 1;
        }
        int reverse_order = 0;
        if (!ig_scalar_i64_f64_order(as_type<long>(right.payload), left.payload, reverse_order)) {
            return 1;
        }
        order = -reverse_order;
        return 2;
    }
    if ((left.tag == 1 && right.tag == 1)
            || (left.tag == 4 && right.tag == 4)) {
        order = left.payload < right.payload ? -1 : (left.payload > right.payload ? 1 : 0);
        return 2;
    }
    return 0;
}

inline uchar ig_scalar_value_compare(
    IgScalarValue left,
    IgScalarValue right,
    uint operation) {
    if (left.tag == 7 || right.tag == 7) return 3;
    if (left.tag == 0 || right.tag == 0) return 0;
    if (operation <= 1u) {
        bool equal = false;
        if (left.tag == 2u && right.tag == 2u) {
            equal = left.payload == right.payload;
        } else if (left.tag == 3u && right.tag == 3u) {
            equal = ig_scalar_f64_equal(left.payload, right.payload);
        } else if (left.tag == 2u && right.tag == 3u) {
            equal = ig_scalar_i64_f64_equal(as_type<long>(left.payload), right.payload);
        } else if (left.tag == 3u && right.tag == 2u) {
            equal = ig_scalar_i64_f64_equal(as_type<long>(right.payload), left.payload);
        } else if ((left.tag == 1u && right.tag == 1u)
                || (left.tag == 4u && right.tag == 4u)) {
            equal = left.payload == right.payload;
        }
        return (operation == 1u ? !equal : equal) ? 2 : 1;
    }
    int order = 0;
    uchar status = ig_scalar_value_order(left, right, order);
    if (status == 0) return 0;
    if (status == 1) return 1;
    if (status != 2) return 3;
    return ig_compare_order(order, operation);
}

// Bounded iterative lexicographic LIST ordering. A shorter equal prefix decides before any
// non-shared suffix is inspected, while NULL in a shared position propagates unknown.
inline uchar ig_scalar_list_compare(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint left_cell,
    uint right_cell,
    uint operation) {
    uint left_starts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint right_starts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint left_counts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint right_counts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint positions[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint depth = 0;
    IgScalarValue left = ig_scalar_cell_value(code, args, left_cell);
    IgScalarValue right = ig_scalar_cell_value(code, args, right_cell);
    if (left.tag != 5 || right.tag != 5 || left.payload >> 32 != 0 || right.payload >> 32 != 0) {
        return 3;
    }
    left_starts[0] = uint(left.payload);
    right_starts[0] = uint(right.payload);
    left_counts[0] = left.auxiliary;
    right_counts[0] = right.auxiliary;
    positions[0] = 0;
    uint list_base = ig_scalar_list_base(args);
    while (true) {
        uint left_start = left_starts[depth];
        uint right_start = right_starts[depth];
        uint left_count = left_counts[depth];
        uint right_count = right_counts[depth];
        if (left_start > args.scalar_list_entry_count
                || right_start > args.scalar_list_entry_count
                || left_count > args.scalar_list_entry_count - left_start
                || right_count > args.scalar_list_entry_count - right_start) return 3;
        uint shared = min(left_count, right_count);
        if (positions[depth] >= shared) {
            if (left_count != right_count) {
                return ig_compare_order(left_count < right_count ? -1 : 1, operation);
            }
            if (depth == 0) return ig_compare_order(0, operation);
            --depth;
            ++positions[depth];
            continue;
        }
        uint position = positions[depth];
        uint left_child = code[list_base + left_start + position];
        uint right_child = code[list_base + right_start + position];
        if (left_child >= args.scalar_cell_count || right_child >= args.scalar_cell_count) return 3;
        left = ig_scalar_cell_value(code, args, left_child);
        right = ig_scalar_cell_value(code, args, right_child);
        if (left.tag == 5 && right.tag == 5) {
            if (depth + 1 >= IG_SCALAR_STRUCTURAL_MAX_PAIRS
                    || left.payload >> 32 != 0 || right.payload >> 32 != 0) return 3;
            ++depth;
            left_starts[depth] = uint(left.payload);
            right_starts[depth] = uint(right.payload);
            left_counts[depth] = left.auxiliary;
            right_counts[depth] = right.auxiliary;
            positions[depth] = 0;
            continue;
        }
        int order = 0;
        uchar status = ig_scalar_value_order(left, right, order);
        if (status == 0) return 0;
        if (status == 1) return 1;
        if (status != 2) return 3;
        if (order != 0) return ig_compare_order(order, operation);
        ++positions[depth];
    }
}

inline uchar ig_scalar_compare(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint left,
    uint right,
    uint operation) {
    if (operation <= 1) {
        uchar equal = ig_scalar_structural_equal(code, args, left, right);
        return operation == 1 ? ig_boolean_not(equal) : equal;
    }
    IgScalarValue left_value = ig_scalar_cell_value(code, args, left);
    IgScalarValue right_value = ig_scalar_cell_value(code, args, right);
    if (left_value.tag == 5 && right_value.tag == 5) {
        return ig_scalar_list_compare(code, args, left, right, operation);
    }
    return ig_scalar_value_compare(
        left_value,
        right_value,
        operation);
}

struct ValueMatrixArgs {
    ulong candidate_count;
    uint value_count;
    uint cell_count;
    uint list_entry_count;
    uint utf8_byte_count;
    uint comparison;
    uint exclude_same_index;
};

inline IgScalarValue ig_value_matrix_cell(
    device const uint* cells,
    constant ValueMatrixArgs& args,
    uint index) {
    if (index >= args.cell_count) return ig_invalid_scalar_value();
    uint base = index * 4;
    IgScalarValue value;
    value.tag = cells[base];
    value.payload = ulong(cells[base + 1]) | (ulong(cells[base + 2]) << 32);
    value.auxiliary = cells[base + 3];
    return value;
}

inline uchar ig_value_matrix_scalar_order(
    device const uchar* utf8,
    constant ValueMatrixArgs& args,
    IgScalarValue left,
    IgScalarValue right,
    thread int& order) {
    if (left.tag == 4 && right.tag == 4) {
        if (left.payload >> 32 != 0 || right.payload >> 32 != 0) return 3;
        uint left_start = uint(left.payload);
        uint right_start = uint(right.payload);
        uint left_count = left.auxiliary;
        uint right_count = right.auxiliary;
        if (left_start > args.utf8_byte_count || right_start > args.utf8_byte_count
                || left_count > args.utf8_byte_count - left_start
                || right_count > args.utf8_byte_count - right_start) return 3;
        uint shared = min(left_count, right_count);
        for (uint index = 0; index < shared; ++index) {
            uchar l = utf8[left_start + index];
            uchar r = utf8[right_start + index];
            if (l != r) {
                order = l < r ? -1 : 1;
                return 2;
            }
        }
        order = left_count < right_count ? -1 : (left_count > right_count ? 1 : 0);
        return 2;
    }
    return ig_scalar_value_order(left, right, order);
}

inline uchar ig_value_matrix_list_compare(
    device const uint* cells,
    device const uint* list_entries,
    device const uchar* utf8,
    constant ValueMatrixArgs& args,
    uint left_cell,
    uint right_cell) {
    uint left_starts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint right_starts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint left_counts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint right_counts[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint positions[IG_SCALAR_STRUCTURAL_MAX_PAIRS];
    uint depth = 0;
    IgScalarValue left = ig_value_matrix_cell(cells, args, left_cell);
    IgScalarValue right = ig_value_matrix_cell(cells, args, right_cell);
    if (left.tag != 5 || right.tag != 5 || left.payload >> 32 != 0 || right.payload >> 32 != 0) {
        return 3;
    }
    left_starts[0] = uint(left.payload);
    right_starts[0] = uint(right.payload);
    left_counts[0] = left.auxiliary;
    right_counts[0] = right.auxiliary;
    positions[0] = 0;
    while (true) {
        uint left_start = left_starts[depth];
        uint right_start = right_starts[depth];
        uint left_count = left_counts[depth];
        uint right_count = right_counts[depth];
        if (left_start > args.list_entry_count || right_start > args.list_entry_count
                || left_count > args.list_entry_count - left_start
                || right_count > args.list_entry_count - right_start) return 3;
        uint shared = min(left_count, right_count);
        if (positions[depth] >= shared) {
            if (left_count != right_count) return left_count < right_count ? 0 : 2;
            if (depth == 0) return 1;
            --depth;
            ++positions[depth];
            continue;
        }
        uint position = positions[depth];
        uint left_child = list_entries[left_start + position];
        uint right_child = list_entries[right_start + position];
        if (left_child >= args.cell_count || right_child >= args.cell_count) return 3;
        left = ig_value_matrix_cell(cells, args, left_child);
        right = ig_value_matrix_cell(cells, args, right_child);
        if (left.tag == 5 && right.tag == 5) {
            if (depth + 1 >= IG_SCALAR_STRUCTURAL_MAX_PAIRS
                    || left.payload >> 32 != 0 || right.payload >> 32 != 0) return 3;
            ++depth;
            left_starts[depth] = uint(left.payload);
            right_starts[depth] = uint(right.payload);
            left_counts[depth] = left.auxiliary;
            right_counts[depth] = right.auxiliary;
            positions[depth] = 0;
            continue;
        }
        int order = 0;
        uchar status = ig_value_matrix_scalar_order(utf8, args, left, right, order);
        if (status == 0) return 3;
        if (status == 1) return 3;
        if (status != 2) return 3;
        if (order != 0) return order < 0 ? 0 : 2;
        ++positions[depth];
    }
}

inline uchar ig_value_matrix_compare(
    device const uint* cells,
    device const uint* list_entries,
    device const uchar* utf8,
    constant ValueMatrixArgs& args,
    uint left_cell,
    uint right_cell) {
    IgScalarValue left = ig_value_matrix_cell(cells, args, left_cell);
    IgScalarValue right = ig_value_matrix_cell(cells, args, right_cell);
    if (left.tag == 5 && right.tag == 5) {
        uchar list_order = ig_value_matrix_list_compare(
            cells, list_entries, utf8, args, left_cell, right_cell);
        if (list_order == 3) return 0;
        int order = list_order == 0 ? -1 : (list_order == 2 ? 1 : 0);
        return ig_compare_order(order, args.comparison);
    }
    int order = 0;
    uchar status = ig_value_matrix_scalar_order(utf8, args, left, right, order);
    if (status == 0) return 0;
    if (status == 1) return 1;
    if (status != 2) return 3;
    return ig_compare_order(order, args.comparison);
}

kernel void ig_value_matrix(
    device const uint* cells [[buffer(0)]],
    device const uint* list_entries [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant ValueMatrixArgs& args [[buffer(4)]],
    uint candidate [[thread_position_in_grid]]) {
    if (ulong(candidate) >= args.candidate_count || args.value_count == 0) return;
    uint pairs_per_row = args.value_count * args.value_count;
    uint pair = candidate % pairs_per_row;
    uint left = pair / args.value_count;
    uint right = pair % args.value_count;
    uint source = candidate / pairs_per_row;
    bool keep = !(args.exclude_same_index != 0 && left == right)
        && ig_value_matrix_compare(cells, list_entries, utf8, args, left, right) == 2;
    uint base = candidate * 4;
    output[base] = keep ? 1 : 0;
    output[base + 1] = source;
    output[base + 2] = left;
    output[base + 3] = right;
}

inline IgScalarValue ig_integer_binary(
    uint opcode,
    IgScalarValue left,
    IgScalarValue right) {
    if (left.tag == 7 || right.tag == 7) return ig_invalid_scalar_value();
    if (left.tag == 0 || right.tag == 0) {
        IgScalarValue value;
        value.tag = 0;
        value.payload = 0;
        value.auxiliary = 0;
        return value;
    }
    if (left.tag != 2 || right.tag != 2) return ig_invalid_scalar_value();
    long l = as_type<long>(left.payload);
    long r = as_type<long>(right.payload);
    long result = 0;
    if (opcode == 1) {
        if ((r > 0 && l > IG_I64_MAX - r) || (r < 0 && l < IG_I64_MIN - r)) {
            return ig_invalid_scalar_value();
        }
        result = l + r;
    } else if (opcode == 2) {
        if ((r > 0 && l < IG_I64_MIN + r) || (r < 0 && l > IG_I64_MAX + r)) {
            return ig_invalid_scalar_value();
        }
        result = l - r;
    } else if (opcode == 3) {
        if (l == 0 || r == 0) {
            result = 0;
        } else if (l == -1) {
            if (r == IG_I64_MIN) return ig_invalid_scalar_value();
            result = -r;
        } else if (r == -1) {
            if (l == IG_I64_MIN) return ig_invalid_scalar_value();
            result = -l;
        } else {
            bool overflow = (l > 0 && r > 0 && l > IG_I64_MAX / r)
                || (l > 0 && r < 0 && r < IG_I64_MIN / l)
                || (l < 0 && r > 0 && l < IG_I64_MIN / r)
                || (l < 0 && r < 0 && l < IG_I64_MAX / r);
            if (overflow) return ig_invalid_scalar_value();
            result = l * r;
        }
    } else if (opcode == 4) {
        if (r == 0 || (l == IG_I64_MIN && r == -1)) return ig_invalid_scalar_value();
        result = l % r;
    } else {
        return ig_invalid_scalar_value();
    }
    IgScalarValue value;
    value.tag = 2;
    value.payload = as_type<ulong>(result);
    value.auxiliary = 0;
    return value;
}

inline IgScalarValue ig_integer_abs(IgScalarValue operand) {
    if (operand.tag == 7 || operand.tag == 0) return operand;
    if (operand.tag != 2) return ig_invalid_scalar_value();
    long value = as_type<long>(operand.payload);
    if (value == IG_I64_MIN) return ig_invalid_scalar_value();
    operand.payload = as_type<ulong>(value < 0 ? -value : value);
    return operand;
}

inline IgScalarValue ig_exceptional_float_divide(IgScalarValue left, IgScalarValue right) {
    if (left.tag == 7 || right.tag == 7) return ig_invalid_scalar_value();
    if (left.tag == 0 || right.tag == 0) {
        IgScalarValue value;
        value.tag = 0;
        value.payload = 0;
        value.auxiliary = 0;
        return value;
    }
    bool left_numeric = left.tag == 2 || left.tag == 3;
    bool right_numeric = right.tag == 2 || right.tag == 3;
    bool left_zero = (left.tag == 2 && left.payload == 0)
        || (left.tag == 3 && (left.payload & 0x7ffffffffffffffful) == 0);
    bool right_zero = (right.tag == 2 && right.payload == 0)
        || (right.tag == 3 && (right.payload & 0x7ffffffffffffffful) == 0);
    if (!left_numeric || !right_numeric || !right_zero || (left.tag != 3 && right.tag != 3)) {
        return ig_invalid_scalar_value();
    }
    bool left_negative = left.tag == 2
        ? as_type<long>(left.payload) < 0
        : (left.payload >> 63) != 0;
    bool right_negative = right.tag == 2
        ? as_type<long>(right.payload) < 0
        : (right.payload >> 63) != 0;
    IgScalarValue value;
    value.tag = 3;
    value.payload = left_zero
        ? 0x7ff8000000000000ul
        : ((ulong(left_negative != right_negative) << 63) | 0x7ff0000000000000ul);
    value.auxiliary = 0;
    return value;
}

inline IgScalarValue ig_scalar_expression(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint expression) {
    if (expression >= args.scalar_expression_count) return ig_invalid_scalar_value();
    uint descriptor = ig_scalar_expression_descriptor_base(args) + expression * 3;
    uint offset = code[descriptor];
    uint count = code[descriptor + 1];
    uint output = code[descriptor + 2];
    if (count == 0 || count > IG_SCALAR_EXPRESSION_MAX_REGISTERS || output >= count
            || offset > args.scalar_expression_instruction_count
            || count > args.scalar_expression_instruction_count - offset) {
        return ig_invalid_scalar_value();
    }
    IgScalarValue registers[IG_SCALAR_EXPRESSION_MAX_REGISTERS];
    uint instruction_base = ig_scalar_expression_instruction_base(args) + offset * 3;
    for (uint index = 0; index < count; ++index) {
        uint base = instruction_base + index * 3;
        uint opcode = code[base];
        uint left = code[base + 1];
        uint right = code[base + 2];
        if (opcode == 0) {
            registers[index] = ig_scalar_cell_value(code, args, left);
        } else if (opcode == 5) {
            if (left >= index) return ig_invalid_scalar_value();
            registers[index] = ig_integer_abs(registers[left]);
        } else if (opcode >= 1 && opcode <= 4) {
            if (left >= index || right >= index) return ig_invalid_scalar_value();
            registers[index] = ig_integer_binary(opcode, registers[left], registers[right]);
        } else if (opcode == 6) {
            if (left >= index || right >= index) return ig_invalid_scalar_value();
            registers[index] = ig_exceptional_float_divide(registers[left], registers[right]);
        } else {
            return ig_invalid_scalar_value();
        }
    }
    return registers[output];
}

inline uchar ig_integer_size_compare(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint size,
    uint right,
    uint operation) {
    uint right_tag = ig_scalar_word(code, args, right, 0);
    if (right_tag == 0) return 0;
    long left_value = long(size);
    int order = 0;
    if (right_tag == 2) {
        long right_value = as_type<long>(ig_scalar_payload(code, args, right));
        order = left_value < right_value ? -1 : (left_value > right_value ? 1 : 0);
    } else {
        return 3;
    }
    return ig_compare_order(order, operation);
}

inline uchar ig_filtered_list_count_compare(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint reduction,
    uint right,
    uint operation,
    thread const uchar* registers,
    uint available) {
    if (reduction >= args.reduction_count || right >= args.scalar_cell_count) return 3;
    uint base = ig_reduction_base(args) + reduction * 3;
    if (code[base] != 4) return 3;
    uint offset = code[base + 1];
    uint count = code[base + 2];
    if (offset > args.reduction_register_count || count > args.reduction_register_count - offset) {
        return 3;
    }
    uint right_tag = ig_scalar_word(code, args, right, 0);
    if (right_tag == 0) return 0;
    if (right_tag != 2) return 3;
    long selected = 0;
    uint register_base = ig_reduction_register_base(args);
    for (uint index = 0; index < count; ++index) {
        uint register_index = code[register_base + offset + index];
        if (register_index >= available) return 3;
        uchar value = registers[register_index];
        if (value == 2) ++selected;
        else if (value != 0 && value != 1) return 3;
    }
    long expected = as_type<long>(ig_scalar_payload(code, args, right));
    int order = selected < expected ? -1 : (selected > expected ? 1 : 0);
    return ig_compare_order(order, operation);
}

inline uchar ig_scalar_predicate(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint predicate,
    thread const uchar* registers,
    uint available) {
    if (predicate >= args.scalar_predicate_count) return 3;
    uint base = ig_predicate_base(args) + predicate * 4;
    uint kind = code[base];
    uint left = code[base + 1];
    uint right = code[base + 2];
    uint auxiliary = code[base + 3];
    uint operation = auxiliary & 0xff;
    if (kind == 5) {
        return ig_scalar_value_compare(
            ig_scalar_expression(code, args, left),
            ig_scalar_expression(code, args, right),
            operation);
    }
    if (kind == 6) {
        return ig_filtered_list_count_compare(
            code, args, left, right, operation, registers, available);
    }
    if (left >= args.scalar_cell_count) return 3;
    uint left_tag = ig_scalar_word(code, args, left, 0);
    if (kind == 0) {
        if (left_tag == 0) return 0;
        if (left_tag == 1) return ig_scalar_payload(code, args, left) != 0 ? 2 : 1;
        return 3;
    }
    if (kind == 4) return left_tag == 0 ? 2 : 1;
    if (kind == 7) {
        if (left_tag == 0) return 2;
        if (left_tag != 6) return 3;
        uint key = auxiliary >> 8;
        uint start = ig_scalar_word(code, args, left, 1);
        uint count = ig_scalar_word(code, args, left, 3);
        if (start > args.map_entry_count || count > args.map_entry_count - start) return 3;
        uint map_base = ig_map_base(args);
        for (uint index = 0; index < count; ++index) {
            uint entry = map_base + (start + index) * 2;
            if (code[entry] == key) {
                uint value = code[entry + 1];
                if (value >= args.scalar_cell_count) return 3;
                return ig_scalar_word(code, args, value, 0) == 0 ? 2 : 1;
            }
        }
        return 2;
    }
    if (right >= args.scalar_cell_count) return 3;
    if (kind == 1) return ig_scalar_compare(code, args, left, right, operation);
    if (kind == 2) {
        if (left_tag == 0) return 0;
        if (left_tag != 4 && left_tag != 5 && left_tag != 6) return 3;
        return ig_integer_size_compare(code, args, ig_scalar_word(code, args, left, 3), right, operation);
    }
    if (kind == 3) {
        if (left_tag == 0) return 0;
        if (left_tag != 6) return 3;
        uint key = auxiliary >> 8;
        uint start = ig_scalar_word(code, args, left, 1);
        uint count = ig_scalar_word(code, args, left, 3);
        if (start > args.map_entry_count || count > args.map_entry_count - start) return 3;
        uint map_base = ig_map_base(args);
        for (uint index = 0; index < count; ++index) {
            uint entry = map_base + (start + index) * 2;
            if (code[entry] == key) {
                uint value = code[entry + 1];
                if (value >= args.scalar_cell_count) return 3;
                return ig_scalar_compare(code, args, value, right, operation);
            }
        }
        return 0;
    }
    return 3;
}

inline uchar ig_boolean_reduce(
    device const uint* code,
    constant BooleanProgramArgs& args,
    uint reduction,
    thread const uchar* registers,
    uint available) {
    if (reduction >= args.reduction_count) return 3;
    uint base = ig_reduction_base(args) + reduction * 3;
    uint kind = code[base];
    uint offset = code[base + 1];
    uint count = code[base + 2];
    if (offset > args.reduction_register_count || count > args.reduction_register_count - offset) return 3;
    bool has_false = false;
    uint true_count = 0;
    uint unknown_count = 0;
    uint register_base = ig_reduction_register_base(args);
    for (uint index = 0; index < count; ++index) {
        uint register_index = code[register_base + offset + index];
        if (register_index >= available) return 3;
        uchar value = registers[register_index];
        if (value == 1) has_false = true;
        else if (value == 2) ++true_count;
        else if (value == 0) ++unknown_count;
        else return 3;
    }
    if (kind == 0) return has_false ? 1 : (unknown_count > 0 ? 0 : 2);
    if (kind == 1) return true_count > 0 ? 2 : (unknown_count > 0 ? 0 : 1);
    if (kind == 2) return true_count > 0 ? 1 : (unknown_count > 0 ? 0 : 2);
    if (kind == 3) {
        if (true_count == 1 && unknown_count == 0) return 2;
        if ((true_count == 0 || true_count == 1) && unknown_count > 0) return 0;
        return 1;
    }
    return 3;
}

// Each row executes a bounded SSA Boolean program. Input row shaping happens during query
// compilation, but all three-valued logical operations and WHERE selection happen here on the
// selected Metal device. Output column zero is the device-generated keep mask.
kernel void ig_boolean_program(
    device const uint* inputs [[buffer(0)]],
    device const uint* code [[buffer(1)]],
    device const uint* output_and_filters [[buffer(2)]],
    device uchar* output [[buffer(3)]],
    constant BooleanProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint register_count = args.input_count + args.instruction_count;
    uint output_stride = args.output_count + 1;
    ulong output_offset = ulong(row) * output_stride;
    if (register_count == 0 || register_count > IG_BOOLEAN_PROGRAM_MAX_REGISTERS) {
        output[output_offset] = 0;
        return;
    }

    uchar registers[IG_BOOLEAN_PROGRAM_MAX_REGISTERS];
    for (uint input = 0; input < args.input_count; ++input) {
        uint value = inputs[ulong(row) * args.input_stride + input];
        if (value > 2) {
            output[output_offset] = 0;
            return;
        }
        registers[input] = uchar(value);
    }
    for (uint instruction = 0; instruction < args.instruction_count; ++instruction) {
        uint target = args.input_count + instruction;
        uint code_offset = instruction * 3;
        uint opcode = code[code_offset];
        uint left_register = code[code_offset + 1];
        uint right_register = code[code_offset + 2];
        bool register_opcode = (opcode >= 1 && opcode <= 8) || (opcode >= 11 && opcode <= 15);
        bool binary_register_opcode = (opcode == 1 || opcode == 2 || opcode == 3
            || opcode == 5 || opcode == 6 || (opcode >= 11 && opcode <= 14));
        if ((register_opcode && left_register >= target)
                || (binary_register_opcode && right_register >= target)
                || (opcode == 15 && right_register >= args.list_input_count)
                || (opcode == 9 && left_register >= args.scalar_predicate_count)
                || (opcode == 10 && left_register >= args.reduction_count)) {
            output[output_offset] = 0;
            return;
        }
        uchar left = register_opcode ? registers[left_register] : 0;
        uchar right = binary_register_opcode ? registers[right_register] : 0;
        switch (opcode) {
            case 0: registers[target] = uchar(left_register); break;
            case 1: registers[target] = ig_boolean_and(left, right); break;
            case 2: registers[target] = ig_boolean_or(left, right); break;
            case 3: registers[target] = ig_boolean_xor(left, right); break;
            case 4: registers[target] = ig_boolean_not(left); break;
            case 5: registers[target] = ig_boolean_equal(left, right); break;
            case 6: registers[target] = ig_boolean_not(ig_boolean_equal(left, right)); break;
            case 7: registers[target] = left == 3 ? 3 : (left == 0 ? 2 : 1); break;
            case 8: registers[target] = left == 3 ? 3 : (left == 0 ? 1 : 2); break;
            case 9: registers[target] = ig_scalar_predicate(code, args, left_register, registers, target); break;
            case 10: registers[target] = ig_boolean_reduce(code, args, left_register, registers, target); break;
            case 11: registers[target] = ig_boolean_order_compare(left, right, 2); break;
            case 12: registers[target] = ig_boolean_order_compare(left, right, 3); break;
            case 13: registers[target] = ig_boolean_order_compare(left, right, 4); break;
            case 14: registers[target] = ig_boolean_order_compare(left, right, 5); break;
            case 15: registers[target] = ig_boolean_input_membership(
                inputs, args, row, left, right_register); break;
            default:
                output[output_offset] = 0;
                return;
        }
    }
    bool keep = true;
    for (uint filter = 0; filter < args.filter_count; ++filter) {
        uint register_index = output_and_filters[args.output_count + filter];
        if (register_index >= register_count || registers[register_index] != 2) {
            keep = false;
            break;
        }
    }
    output[output_offset] = keep ? 1 : 0;
    for (uint column = 0; column < args.output_count; ++column) {
        uint register_index = output_and_filters[column];
        output[output_offset + column + 1] = register_index < register_count
            ? registers[register_index]
            : 0;
    }
}

constant uint IG_BOOLEAN_AGGREGATE_MAX_REDUCTIONS = 256;

struct BooleanAggregateArgs {
    ulong row_count;
    uint row_output_count;
    uint reduction_count;
    uint instruction_count;
    uint output_count;
};

// Reduces the selected output columns of a preceding Boolean program. `collect` omits null
// values, so tags 0 never participate in an aggregate list predicate; the empty-list identities
// below are therefore the Cypher semantics for all/any/none/single after `collect`.
kernel void ig_boolean_global_aggregate(
    device const uchar* rows [[buffer(0)]],
    device const uint* code [[buffer(1)]],
    device uchar* output [[buffer(2)]],
    constant BooleanAggregateArgs& args [[buffer(3)]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup uchar aggregate_values[IG_BOOLEAN_AGGREGATE_MAX_REDUCTIONS];
    if (lane < args.reduction_count) {
        uint descriptor = lane * 2;
        uint kind = code[descriptor];
        uint source = code[descriptor + 1];
        uchar aggregate = 3;
        if (kind <= 3 && source < args.row_output_count) {
            bool has_false = false;
            bool invalid = false;
            ulong true_count = 0;
            ulong row_stride = ulong(args.row_output_count) + 1;
            for (ulong row = 0; row < args.row_count; ++row) {
                ulong offset = row * row_stride;
                if (rows[offset] == 0) continue;
                uchar value = rows[offset + source + 1];
                if (value == 1) has_false = true;
                else if (value == 2) ++true_count;
                else if (value != 0) invalid = true;
            }
            if (!invalid) {
                if (kind == 0) aggregate = has_false ? 1 : 2;
                else if (kind == 1) aggregate = true_count != 0 ? 2 : 1;
                else if (kind == 2) aggregate = true_count == 0 ? 2 : 1;
                else aggregate = true_count == 1 ? 2 : 1;
            }
        }
        aggregate_values[lane] = aggregate;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lane != 0) return;

    uint register_count = args.reduction_count + args.instruction_count;
    if (register_count == 0 || register_count > IG_BOOLEAN_PROGRAM_MAX_REGISTERS) {
        for (uint column = 0; column < args.output_count; ++column) output[column] = 3;
        return;
    }
    uchar registers[IG_BOOLEAN_PROGRAM_MAX_REGISTERS];
    for (uint index = 0; index < args.reduction_count; ++index) {
        registers[index] = aggregate_values[index];
    }
    uint instruction_base = args.reduction_count * 2;
    bool valid = true;
    for (uint instruction = 0; instruction < args.instruction_count; ++instruction) {
        uint target = args.reduction_count + instruction;
        uint offset = instruction_base + instruction * 3;
        uint opcode = code[offset];
        uint left_register = code[offset + 1];
        uint right_register = code[offset + 2];
        bool register_opcode = (opcode >= 1 && opcode <= 8) || (opcode >= 11 && opcode <= 14);
        bool binary_register_opcode = (opcode == 1 || opcode == 2 || opcode == 3
            || opcode == 5 || opcode == 6 || (opcode >= 11 && opcode <= 14));
        if ((register_opcode && left_register >= target)
                || (binary_register_opcode && right_register >= target)) {
            valid = false;
            break;
        }
        uchar left = register_opcode ? registers[left_register] : 0;
        uchar right = binary_register_opcode ? registers[right_register] : 0;
        switch (opcode) {
            case 0: registers[target] = uchar(left_register); break;
            case 1: registers[target] = ig_boolean_and(left, right); break;
            case 2: registers[target] = ig_boolean_or(left, right); break;
            case 3: registers[target] = ig_boolean_xor(left, right); break;
            case 4: registers[target] = ig_boolean_not(left); break;
            case 5: registers[target] = ig_boolean_equal(left, right); break;
            case 6: registers[target] = ig_boolean_not(ig_boolean_equal(left, right)); break;
            case 7: registers[target] = left == 3 ? 3 : (left == 0 ? 2 : 1); break;
            case 8: registers[target] = left == 3 ? 3 : (left == 0 ? 1 : 2); break;
            case 11: registers[target] = ig_boolean_order_compare(left, right, 2); break;
            case 12: registers[target] = ig_boolean_order_compare(left, right, 3); break;
            case 13: registers[target] = ig_boolean_order_compare(left, right, 4); break;
            case 14: registers[target] = ig_boolean_order_compare(left, right, 5); break;
            default:
                valid = false;
                break;
        }
        if (!valid) break;
    }
    uint output_base = instruction_base + args.instruction_count * 3;
    for (uint column = 0; column < args.output_count; ++column) {
        uint register_index = code[output_base + column];
        output[column] = valid && register_index < register_count ? registers[register_index] : 3;
    }
}

constant ulong IG_MUTATION_STATIC_MAGIC = 0x49474d5554415445ul;
constant uint IG_MUTATION_STATIC_HEADER_WORDS = 9;
constant uint IG_MUTATION_STATIC_RECEIPT_WORDS = 9;
constant uint IG_MUTATION_STATIC_INTENT_WORDS = 9;
constant uint IG_MUTATION_STATIC_COMMAND_WORDS = 7;

struct MutationStaticArgs {
    ulong execution_high;
    ulong execution_low;
    ulong row_count;
    ulong output_word_count;
    ulong input_word_count;
    ulong selection_obligation_id;
    uint command_count;
    uint receipt_count;
    uint command_word_count;
    uint payload_word_count;
};

// Static mutation attempts consume canonical target-local membership lanes gathered from the
// resident image. The single device thread deliberately evaluates the bounded packet in Cypher
// row-major order so duplicate targets and later commands observe prior device-authored effects.
kernel void ig_mutation_static_intents(
    device const long* inputs [[buffer(0)]],
    device const ulong* commands [[buffer(1)]],
    device const ulong* payload [[buffer(2)]],
    device ulong* output [[buffer(3)]],
    constant MutationStaticArgs& args [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0) return;

    ulong intent_capacity = args.row_count * ulong(args.command_count);
    ulong payload_count = args.row_count * ulong(args.payload_word_count);
    ulong expected_input_words = args.row_count
        * (2ul + ulong(args.payload_word_count));
    ulong receipt_base = IG_MUTATION_STATIC_HEADER_WORDS;
    ulong intent_base = receipt_base
        + ulong(args.receipt_count) * IG_MUTATION_STATIC_RECEIPT_WORDS;
    ulong payload_base = intent_base + intent_capacity * IG_MUTATION_STATIC_INTENT_WORDS;
    ulong expected_words = payload_base + payload_count;
    bool shape_valid = args.command_count != 0
        && args.receipt_count == args.command_count * 2 + 1
        && args.command_word_count == args.command_count * IG_MUTATION_STATIC_COMMAND_WORDS
        && args.input_word_count == expected_input_words
        && expected_words == args.output_word_count;

    for (ulong word = 0; word < args.output_word_count; ++word) output[word] = 0;
    output[0] = IG_MUTATION_STATIC_MAGIC;
    output[1] = shape_valid ? 1 : 2;
    output[2] = 0;
    output[3] = shape_valid ? ulong(args.receipt_count) : 0;
    output[4] = shape_valid ? payload_count : 0;
    output[5] = args.execution_high;
    output[6] = args.execution_low;
    output[7] = 2; // ResidentDeviceCompletion::Metal
    output[8] = shape_valid ? intent_capacity : 0;
    if (!shape_valid) return;

    for (ulong row = 0; row < args.row_count; ++row) {
        ulong target_valid = as_type<ulong>(inputs[row]);
        ulong target_id = as_type<ulong>(inputs[args.row_count + row]);
        if (target_valid > 1) {
            output[1] = 2;
            return;
        }
        // A null-extended OPTIONAL target is not a mutation attempt. Compact it out while keeping
        // the selected-row cardinality in the receipts and the fixed intent-capacity layout.
        if (target_valid == 0) continue;
        for (uint command = 0; command < args.command_count; ++command) {
            ulong index = output[2];
            if (index >= intent_capacity) {
                output[1] = 2;
                return;
            }
            output[2] = index + 1ul;
            ulong descriptor = ulong(command) * IG_MUTATION_STATIC_COMMAND_WORDS;
            ulong action = commands[descriptor];
            ulong command_payload = commands[descriptor + 1];
            ulong command_payload_count = commands[descriptor + 2];
            ulong target_kind = commands[descriptor + 5];
            ulong membership_start = commands[descriptor + 6];
            if ((action != 1 && action != 2 && action != 3 && action != 4)
                || target_kind > 1
                || (target_kind == 1 && action != 3 && action != 4)
                || command_payload_count == 0
                || command_payload + command_payload_count < command_payload
                || command_payload + command_payload_count > args.payload_word_count
                || membership_start != command_payload) {
                output[1] = 2;
                return;
            }

            ulong intent = intent_base + index * IG_MUTATION_STATIC_INTENT_WORDS;
            ulong output_payload = row * ulong(args.payload_word_count) + command_payload;
            ulong changed_count = 0;
            bool property_effect = false;
            output[intent] = row;
            output[intent + 1] = command;
            output[intent + 2] = target_kind;
            output[intent + 3] = target_id;
            output[intent + 4] = action;
            output[intent + 5] = output_payload;

            for (ulong item = 0; item < command_payload_count; ++item) {
                ulong token = payload[command_payload + item];
                if (token > 0xfffful) {
                    output[1] = 2;
                    return;
                }
                ulong membership = as_type<ulong>(inputs[
                    2 * args.row_count
                        + (membership_start + item) * args.row_count
                        + row]);
                if (membership > 1) {
                    output[1] = 2;
                    return;
                }
                bool present = membership == 1;

                // Earlier attempts for the same stable entity form the statement-local overlay.
                for (ulong prior = 0; prior < index; ++prior) {
                    ulong prior_intent = intent_base
                        + prior * IG_MUTATION_STATIC_INTENT_WORDS;
                    if (output[prior_intent + 8] != 1
                        || output[prior_intent + 2] != target_kind
                        || output[prior_intent + 3] != target_id) continue;
                    ulong prior_action = output[prior_intent + 4];
                    bool same_namespace = (action == 3 || action == 4)
                        ? (prior_action == 3 || prior_action == 4)
                        : (prior_action == 1 || prior_action == 2);
                    if (!same_namespace) continue;
                    ulong prior_offset = output[prior_intent + 5];
                    ulong prior_count = output[prior_intent + 6];
                    if (prior_offset + prior_count < prior_offset
                        || prior_offset + prior_count > payload_count) {
                        output[1] = 2;
                        return;
                    }
                    for (ulong prior_item = 0; prior_item < prior_count; ++prior_item) {
                        if (output[payload_base + prior_offset + prior_item] != token) continue;
                        if (prior_action == 1 || prior_action == 4) present = true;
                        else if (prior_action == 2 || prior_action == 3) present = false;
                        else {
                            output[1] = 2;
                            return;
                        }
                    }
                }

                // Preserve exact semantics even if a corrupt packet repeats a label in one item.
                for (ulong prior_item = 0; prior_item < changed_count; ++prior_item) {
                    if (output[payload_base + output_payload + prior_item] == token) {
                        present = action == 1;
                    }
                }

                if (action == 1 || action == 2) {
                    bool changes = action == 1 ? !present : present;
                    if (changes) {
                        output[payload_base + output_payload + changed_count] = token;
                        ++changed_count;
                    }
                } else if (action == 3) {
                    if (command_payload_count != 1) {
                        output[1] = 2;
                        return;
                    }
                    output[payload_base + output_payload] = token;
                    changed_count = 1;
                    property_effect = present;
                } else {
                    if (command_payload_count != 1) {
                        output[1] = 2;
                        return;
                    }
                    output[payload_base + output_payload] = token;
                    changed_count = 1;
                    property_effect = !present;
                }
            }
            bool effectful = (action == 3 || action == 4)
                ? property_effect : changed_count != 0;
            output[intent + 6] = changed_count;
            output[intent + 7] = effectful ? 1 : 0;
            output[intent + 8] = 1; // complete attempted intent
        }
    }

    ulong receipt = receipt_base;
    output[receipt] = args.execution_high;
    output[receipt + 1] = args.execution_low;
    output[receipt + 2] = args.selection_obligation_id;
    output[receipt + 3] = 1; // MUTATION_SELECT
    output[receipt + 4] = 0; // Selection scope
    output[receipt + 5] = 0;
    output[receipt + 6] = args.row_count;
    output[receipt + 7] = args.row_count;
    output[receipt + 8] = 2;
    for (uint command = 0; command < args.command_count; ++command) {
        ulong descriptor = ulong(command) * IG_MUTATION_STATIC_COMMAND_WORDS;
        ulong attempts = 0;
        ulong effects = 0;
        for (ulong index = 0; index < output[2]; ++index) {
            ulong intent = intent_base + index * IG_MUTATION_STATIC_INTENT_WORDS;
            if (output[intent + 1] != ulong(command)) continue;
            ++attempts;
            effects += output[intent + 7];
        }
        receipt = receipt_base
            + ulong(1 + command * 2) * IG_MUTATION_STATIC_RECEIPT_WORDS;
        output[receipt] = args.execution_high;
        output[receipt + 1] = args.execution_low;
        output[receipt + 2] = commands[descriptor + 3];
        output[receipt + 3] = 2; // MUTATION_RHS
        output[receipt + 4] = 1; // MutationCommand scope
        output[receipt + 5] = command;
        output[receipt + 6] = args.row_count;
        output[receipt + 7] = attempts;
        output[receipt + 8] = 2;

        receipt += IG_MUTATION_STATIC_RECEIPT_WORDS;
        output[receipt] = args.execution_high;
        output[receipt + 1] = args.execution_low;
        output[receipt + 2] = commands[descriptor + 4];
        output[receipt + 3] = 12; // MUTATION_EFFECT
        output[receipt + 4] = 1; // MutationCommand scope
        output[receipt + 5] = command;
        output[receipt + 6] = attempts;
        output[receipt + 7] = effects;
        output[receipt + 8] = 2;
    }
}

constant ulong IG_MUTATION_TYPED_MAGIC = 0x49474d5554595045ul;
constant uint IG_MUTATION_TYPED_HEADER_WORDS = 9;
constant uint IG_MUTATION_TYPED_INTENT_WORDS = 11;
constant uint IG_MUTATION_TYPED_COMMAND_WORDS = 6;
constant uint IG_MUTATION_TYPED_VALUE_WORDS = 8;
constant uint IG_MUTATION_TYPED_RECEIPT_DESCRIPTOR_WORDS = 6;
constant uint IG_MUTATION_TYPED_TARGET_FIELDS = 6;
constant uint IG_MUTATION_TYPED_PROPERTY_FIELDS = 6;
constant uint IG_MUTATION_TYPED_MAX_COMMANDS = 64;
constant uint IG_MUTATION_TYPED_MAX_VALUES = 128;
constant uint IG_MUTATION_TYPED_MAX_STRING_BYTES = 4096;
constant ulong IG_MUTATION_VALUE_NULL = 0;
constant ulong IG_MUTATION_VALUE_BOOLEAN = 1;
constant ulong IG_MUTATION_VALUE_INTEGER = 2;
constant ulong IG_MUTATION_VALUE_FLOAT = 3;
constant ulong IG_MUTATION_VALUE_STRING = 4;
constant ulong IG_MUTATION_STRING_NODE_DICTIONARY = 1;
constant ulong IG_MUTATION_STRING_EDGE_DICTIONARY = 2;
constant ulong IG_MUTATION_STRING_PROGRAM_CONSTANT = 3;
constant ulong IG_MUTATION_STRING_OUTPUT = 4;
constant ulong IG_MUTATION_VALUE_OPCODE_CONSTANT = 0;
constant ulong IG_MUTATION_VALUE_OPCODE_PROPERTY = 1;
constant ulong IG_MUTATION_VALUE_OPCODE_ADD = 2;
constant ulong IG_MUTATION_ACTION_SET_PROPERTY = 4;

struct MutationTypedArgs {
    ulong execution_high;
    ulong execution_low;
    ulong row_count;
    ulong output_word_count;
    ulong input_word_count;
    ulong dictionary_word_count;
    ulong program_word_count;
    uint command_count;
    uint value_count;
    uint property_input_count;
    uint receipt_count;
    uint filter_count;
    uint expression_count;
    uint intent_capacity;
    uint string_slot_words;
    uint constant_byte_count;
    uint node_dictionary_offset_count;
    uint node_dictionary_byte_count;
    uint edge_dictionary_offset_count;
    uint edge_dictionary_byte_count;
};

inline ulong ig_mutation_typed_word(device const long* words, ulong index) {
    return as_type<ulong>(words[index]);
}

inline bool ig_mutation_typed_string_bounds(
    device const long* dictionary,
    constant MutationTypedArgs& args,
    ulong source,
    ulong payload,
    ulong declared_length,
    thread ulong& offset,
    thread ulong& length) {
    if (source == IG_MUTATION_STRING_NODE_DICTIONARY
        || source == IG_MUTATION_STRING_EDGE_DICTIONARY) {
        ulong offset_count = source == IG_MUTATION_STRING_NODE_DICTIONARY
            ? ulong(args.node_dictionary_offset_count)
            : ulong(args.edge_dictionary_offset_count);
        ulong offset_base = source == IG_MUTATION_STRING_NODE_DICTIONARY
            ? 0ul
            : ulong(args.node_dictionary_offset_count)
                + ulong(args.node_dictionary_byte_count);
        if (payload + 1 < payload || payload + 1 >= offset_count) return false;
        ulong start = ig_mutation_typed_word(dictionary, offset_base + payload);
        ulong end = ig_mutation_typed_word(dictionary, offset_base + payload + 1);
        ulong byte_count = source == IG_MUTATION_STRING_NODE_DICTIONARY
            ? ulong(args.node_dictionary_byte_count)
            : ulong(args.edge_dictionary_byte_count);
        if (start > end || end > byte_count
            || end - start > IG_MUTATION_TYPED_MAX_STRING_BYTES) return false;
        offset = start;
        length = end - start;
        return true;
    }
    if (source == IG_MUTATION_STRING_PROGRAM_CONSTANT) {
        if (payload + declared_length < payload
            || payload + declared_length > args.constant_byte_count) return false;
        offset = payload;
        length = declared_length;
        return true;
    }
    if (source == IG_MUTATION_STRING_OUTPUT) {
        ulong capacity = ulong(args.intent_capacity) * ulong(args.string_slot_words);
        if (payload + declared_length < payload
            || payload + declared_length > capacity) return false;
        offset = payload;
        length = declared_length;
        return true;
    }
    return false;
}

inline bool ig_mutation_typed_string_byte(
    device const long* dictionary,
    device const long* program,
    device const ulong* output,
    constant MutationTypedArgs& args,
    ulong constant_base,
    ulong payload_base,
    ulong node_byte_base,
    ulong edge_byte_base,
    ulong source,
    ulong offset,
    ulong index,
    thread ulong& value) {
    if (source == IG_MUTATION_STRING_NODE_DICTIONARY) {
        if (offset + index < offset
            || offset + index >= args.node_dictionary_byte_count) return false;
        value = ig_mutation_typed_word(dictionary, node_byte_base + offset + index);
    } else if (source == IG_MUTATION_STRING_EDGE_DICTIONARY) {
        if (offset + index < offset
            || offset + index >= args.edge_dictionary_byte_count) return false;
        value = ig_mutation_typed_word(dictionary, edge_byte_base + offset + index);
    } else if (source == IG_MUTATION_STRING_PROGRAM_CONSTANT) {
        if (offset + index < offset
            || offset + index >= args.constant_byte_count) return false;
        value = ig_mutation_typed_word(program, constant_base + offset + index);
    } else if (source == IG_MUTATION_STRING_OUTPUT) {
        ulong capacity = ulong(args.intent_capacity) * ulong(args.string_slot_words);
        if (offset + index < offset || offset + index >= capacity) return false;
        value = output[payload_base + offset + index];
    } else {
        return false;
    }
    return value <= 255;
}

inline bool ig_mutation_typed_float_equal(ulong left, ulong right) {
    if ((left << 1) == 0 && (right << 1) == 0) return true;
    const ulong exponent = 0x7ff0000000000000ul;
    const ulong mantissa = 0x000ffffffffffffful;
    bool left_nan = (left & exponent) == exponent && (left & mantissa) != 0;
    bool right_nan = (right & exponent) == exponent && (right & mantissa) != 0;
    return (left_nan && right_nan) || left == right;
}

inline bool ig_mutation_typed_scalar_equal(
    device const long* dictionary,
    device const long* program,
    device const ulong* output,
    constant MutationTypedArgs& args,
    ulong constant_base,
    ulong payload_base,
    ulong node_byte_base,
    ulong edge_byte_base,
    ulong left_tag,
    ulong left_payload,
    ulong left_source,
    ulong left_offset,
    ulong left_length,
    ulong right_tag,
    ulong right_payload,
    ulong right_source,
    ulong right_offset,
    ulong right_length,
    thread bool& valid) {
    valid = true;
    if (left_tag != right_tag) return false;
    if (left_tag == IG_MUTATION_VALUE_NULL) return true;
    if (left_tag == IG_MUTATION_VALUE_BOOLEAN
        || left_tag == IG_MUTATION_VALUE_INTEGER) return left_payload == right_payload;
    if (left_tag == IG_MUTATION_VALUE_FLOAT) {
        return ig_mutation_typed_float_equal(left_payload, right_payload);
    }
    if (left_tag != IG_MUTATION_VALUE_STRING || left_length != right_length) {
        valid = left_tag == IG_MUTATION_VALUE_STRING;
        return false;
    }
    for (ulong index = 0; index < left_length; ++index) {
        ulong left_byte = 0;
        ulong right_byte = 0;
        if (!ig_mutation_typed_string_byte(
                dictionary, program, output, args, constant_base, payload_base,
                node_byte_base, edge_byte_base, left_source, left_offset, index, left_byte)
            || !ig_mutation_typed_string_byte(
                dictionary, program, output, args, constant_base, payload_base,
                node_byte_base, edge_byte_base, right_source, right_offset, index, right_byte)) {
            valid = false;
            return false;
        }
        if (left_byte != right_byte) return false;
    }
    return true;
}

kernel void ig_mutation_typed_intents(
    device const long* inputs [[buffer(0)]],
    device const long* dictionary [[buffer(1)]],
    device const long* program [[buffer(2)]],
    device ulong* output [[buffer(3)]],
    constant MutationTypedArgs& args [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0) return;

    ulong command_words = ulong(args.command_count) * IG_MUTATION_TYPED_COMMAND_WORDS;
    ulong value_words = ulong(args.value_count) * IG_MUTATION_TYPED_VALUE_WORDS;
    ulong receipt_descriptor_words = ulong(args.receipt_count)
        * IG_MUTATION_TYPED_RECEIPT_DESCRIPTOR_WORDS;
    ulong receipt_descriptor_base = command_words + value_words;
    ulong constant_base = receipt_descriptor_base + receipt_descriptor_words;
    ulong target_words = args.row_count * ulong(args.command_count)
        * IG_MUTATION_TYPED_TARGET_FIELDS;
    ulong property_words = args.row_count * ulong(args.property_input_count)
        * IG_MUTATION_TYPED_PROPERTY_FIELDS;
    ulong expected_input_words = target_words + property_words;
    ulong expected_dictionary_words = ulong(args.node_dictionary_offset_count)
        + ulong(args.node_dictionary_byte_count)
        + ulong(args.edge_dictionary_offset_count)
        + ulong(args.edge_dictionary_byte_count);
    ulong expected_program_words = constant_base + ulong(args.constant_byte_count);
    ulong receipt_base = IG_MUTATION_TYPED_HEADER_WORDS;
    ulong intent_base = receipt_base
        + ulong(args.receipt_count) * IG_MUTATION_STATIC_RECEIPT_WORDS;
    ulong payload_base = intent_base
        + ulong(args.intent_capacity) * IG_MUTATION_TYPED_INTENT_WORDS;
    ulong payload_count = ulong(args.intent_capacity) * ulong(args.string_slot_words);
    ulong expected_output_words = payload_base + payload_count;
    bool shape_valid = args.command_count != 0
        && args.command_count <= IG_MUTATION_TYPED_MAX_COMMANDS
        && args.value_count <= IG_MUTATION_TYPED_MAX_VALUES
        && args.receipt_count == 1 + args.filter_count
            + args.expression_count + args.command_count * 2
        && ulong(args.intent_capacity) == args.row_count * ulong(args.command_count)
        && args.string_slot_words <= IG_MUTATION_TYPED_MAX_STRING_BYTES
        && args.input_word_count == expected_input_words
        && args.dictionary_word_count == expected_dictionary_words
        && args.program_word_count == expected_program_words
        && args.output_word_count == expected_output_words
        && args.node_dictionary_offset_count != 0
        && args.edge_dictionary_offset_count != 0;

    output[0] = IG_MUTATION_TYPED_MAGIC;
    output[1] = shape_valid ? 1 : 2;
    output[2] = 0;
    output[3] = shape_valid ? ulong(args.receipt_count) : 0;
    output[4] = shape_valid ? payload_count : 0;
    output[5] = args.execution_high;
    output[6] = args.execution_low;
    output[7] = 2; // ResidentDeviceCompletion::Metal
    output[8] = shape_valid ? ulong(args.intent_capacity) : 0;
    if (!shape_valid) return;

    ulong node_offset_base = 0;
    ulong node_byte_base = ulong(args.node_dictionary_offset_count);
    ulong edge_offset_base = node_byte_base + ulong(args.node_dictionary_byte_count);
    ulong edge_byte_base = edge_offset_base + ulong(args.edge_dictionary_offset_count);
    ulong command_counts[IG_MUTATION_TYPED_MAX_COMMANDS];
    ulong effect_counts[IG_MUTATION_TYPED_MAX_COMMANDS];
    ulong tags[IG_MUTATION_TYPED_MAX_VALUES];
    ulong payloads[IG_MUTATION_TYPED_MAX_VALUES];
    ulong string_sources[IG_MUTATION_TYPED_MAX_VALUES];
    ulong string_offsets[IG_MUTATION_TYPED_MAX_VALUES];
    ulong string_lengths[IG_MUTATION_TYPED_MAX_VALUES];
    uint concat_left[IG_MUTATION_TYPED_MAX_VALUES];
    uint concat_right[IG_MUTATION_TYPED_MAX_VALUES];
    uchar concatenated[IG_MUTATION_TYPED_MAX_VALUES];
    for (uint command = 0; command < IG_MUTATION_TYPED_MAX_COMMANDS; ++command) {
        command_counts[command] = 0;
        effect_counts[command] = 0;
    }
    for (uint value = 0; value < IG_MUTATION_TYPED_MAX_VALUES; ++value) {
        tags[value] = IG_MUTATION_VALUE_NULL;
        payloads[value] = 0;
        string_sources[value] = 0;
        string_offsets[value] = 0;
        string_lengths[value] = 0;
        concat_left[value] = 0;
        concat_right[value] = 0;
        concatenated[value] = 0;
    }

    ulong intent_count = 0;
    for (ulong row = 0; row < args.row_count; ++row) {
        for (uint command = 0; command < args.command_count; ++command) {
            ulong command_base = ulong(command) * IG_MUTATION_TYPED_COMMAND_WORDS;
            ulong action = ig_mutation_typed_word(program, command_base);
            ulong property_name = ig_mutation_typed_word(program, command_base + 1);
            ulong result_register_word = ig_mutation_typed_word(program, command_base + 2);
            ulong value_start_word = ig_mutation_typed_word(program, command_base + 3);
            ulong value_count_word = ig_mutation_typed_word(program, command_base + 4);
            ulong expected_kind = ig_mutation_typed_word(program, command_base + 5);
            ulong value_end_word = value_start_word + value_count_word;
            if (action != IG_MUTATION_ACTION_SET_PROPERTY
                || property_name > 0xfffful
                || result_register_word >= args.value_count
                || value_start_word > value_end_word
                || value_end_word > args.value_count
                || result_register_word < value_start_word
                || result_register_word >= value_end_word
                || expected_kind > 1) {
                output[1] = 2;
                return;
            }

            ulong target_base = ulong(command) * IG_MUTATION_TYPED_TARGET_FIELDS
                * args.row_count;
            ulong target_valid = ig_mutation_typed_word(inputs, target_base + row);
            // Target-first semantics: a null OPTIONAL binding skips every RHS instruction.
            if (target_valid == 0) continue;
            if (target_valid != 1) {
                output[1] = 2;
                return;
            }
            ulong target_kind = ig_mutation_typed_word(
                inputs,
                target_base + args.row_count + row);
            ulong target_id = ig_mutation_typed_word(
                inputs,
                target_base + 2 * args.row_count + row);
            if (target_kind != expected_kind) {
                output[1] = 2;
                return;
            }
            ulong canonical_tag = ig_mutation_typed_word(
                inputs,
                target_base + 3 * args.row_count + row);
            ulong canonical_payload = ig_mutation_typed_word(
                inputs,
                target_base + 4 * args.row_count + row);
            ulong canonical_source = ig_mutation_typed_word(
                inputs,
                target_base + 5 * args.row_count + row);
            if (canonical_tag > IG_MUTATION_VALUE_STRING
                || (canonical_tag == IG_MUTATION_VALUE_BOOLEAN && canonical_payload > 1)
                || (canonical_tag != IG_MUTATION_VALUE_STRING && canonical_source != 0)) {
                output[1] = 2;
                return;
            }

            uint value_start = uint(value_start_word);
            uint value_end = uint(value_end_word);
            for (uint value = value_start; value < value_end; ++value) {
                ulong descriptor = command_words
                    + ulong(value) * IG_MUTATION_TYPED_VALUE_WORDS;
                ulong opcode = ig_mutation_typed_word(program, descriptor);
                concatenated[value] = 0;
                string_sources[value] = 0;
                string_offsets[value] = 0;
                string_lengths[value] = 0;
                payloads[value] = 0;
                if (opcode == IG_MUTATION_VALUE_OPCODE_CONSTANT) {
                    ulong tag = ig_mutation_typed_word(program, descriptor + 1);
                    ulong payload = ig_mutation_typed_word(program, descriptor + 2);
                    ulong source = ig_mutation_typed_word(program, descriptor + 3);
                    ulong offset = ig_mutation_typed_word(program, descriptor + 4);
                    ulong length = ig_mutation_typed_word(program, descriptor + 5);
                    bool valid_scalar = tag <= IG_MUTATION_VALUE_STRING
                        && (tag != IG_MUTATION_VALUE_BOOLEAN || payload <= 1)
                        && (tag != IG_MUTATION_VALUE_STRING
                            || (source == IG_MUTATION_STRING_PROGRAM_CONSTANT
                                && offset + length >= offset
                                && offset + length <= args.constant_byte_count
                                && length <= IG_MUTATION_TYPED_MAX_STRING_BYTES));
                    if (!valid_scalar) {
                        output[1] = 2;
                        return;
                    }
                    tags[value] = tag;
                    payloads[value] = payload;
                    string_sources[value] = source;
                    string_offsets[value] = offset;
                    string_lengths[value] = length;
                } else if (opcode == IG_MUTATION_VALUE_OPCODE_PROPERTY) {
                    ulong property_ordinal = ig_mutation_typed_word(program, descriptor + 1);
                    ulong read_name = ig_mutation_typed_word(program, descriptor + 2);
                    if (property_ordinal >= args.property_input_count || read_name > 0xfffful) {
                        output[1] = 2;
                        return;
                    }
                    ulong property_base = target_words
                        + property_ordinal * IG_MUTATION_TYPED_PROPERTY_FIELDS * args.row_count;
                    ulong identity_valid = ig_mutation_typed_word(inputs, property_base + row);
                    if (identity_valid == 0) {
                        tags[value] = IG_MUTATION_VALUE_NULL;
                        continue;
                    }
                    if (identity_valid != 1) {
                        output[1] = 2;
                        return;
                    }
                    ulong entity_kind = ig_mutation_typed_word(
                        inputs,
                        property_base + args.row_count + row);
                    ulong entity_id = ig_mutation_typed_word(
                        inputs,
                        property_base + 2 * args.row_count + row);
                    bool found_overlay = false;
                    for (long prior = long(intent_count) - 1; prior >= 0; --prior) {
                        ulong prior_base = intent_base
                            + ulong(prior) * IG_MUTATION_TYPED_INTENT_WORDS;
                        if (output[prior_base + 2] == entity_kind
                            && output[prior_base + 3] == entity_id
                            && output[prior_base + 4] == IG_MUTATION_ACTION_SET_PROPERTY
                            && output[prior_base + 5] == read_name
                            && output[prior_base + 10] == 1) {
                            tags[value] = output[prior_base + 6];
                            payloads[value] = output[prior_base + 7];
                            string_lengths[value] = output[prior_base + 8];
                            if (tags[value] == IG_MUTATION_VALUE_STRING) {
                                string_sources[value] = IG_MUTATION_STRING_OUTPUT;
                                string_offsets[value] = payloads[value];
                            }
                            found_overlay = true;
                            break;
                        }
                    }
                    if (found_overlay) continue;
                    ulong tag = ig_mutation_typed_word(
                        inputs,
                        property_base + 3 * args.row_count + row);
                    ulong payload = ig_mutation_typed_word(
                        inputs,
                        property_base + 4 * args.row_count + row);
                    ulong source = ig_mutation_typed_word(
                        inputs,
                        property_base + 5 * args.row_count + row);
                    if (tag > IG_MUTATION_VALUE_STRING
                        || (tag == IG_MUTATION_VALUE_BOOLEAN && payload > 1)) {
                        output[1] = 2;
                        return;
                    }
                    tags[value] = tag;
                    payloads[value] = payload;
                    if (tag == IG_MUTATION_VALUE_STRING) {
                        ulong offset_count = source == IG_MUTATION_STRING_NODE_DICTIONARY
                            ? ulong(args.node_dictionary_offset_count)
                            : ulong(args.edge_dictionary_offset_count);
                        ulong offset_base = source == IG_MUTATION_STRING_NODE_DICTIONARY
                            ? node_offset_base : edge_offset_base;
                        if ((source != IG_MUTATION_STRING_NODE_DICTIONARY
                                && source != IG_MUTATION_STRING_EDGE_DICTIONARY)
                            || payload + 1 >= offset_count) {
                            output[1] = 2;
                            return;
                        }
                        ulong start = ig_mutation_typed_word(dictionary, offset_base + payload);
                        ulong end = ig_mutation_typed_word(dictionary, offset_base + payload + 1);
                        ulong byte_count = source == IG_MUTATION_STRING_NODE_DICTIONARY
                            ? ulong(args.node_dictionary_byte_count)
                            : ulong(args.edge_dictionary_byte_count);
                        if (start > end || end > byte_count
                            || end - start > IG_MUTATION_TYPED_MAX_STRING_BYTES) {
                            output[1] = 2;
                            return;
                        }
                        string_sources[value] = source;
                        string_offsets[value] = start;
                        string_lengths[value] = end - start;
                    }
                } else if (opcode == IG_MUTATION_VALUE_OPCODE_ADD) {
                    ulong left_word = ig_mutation_typed_word(program, descriptor + 1);
                    ulong right_word = ig_mutation_typed_word(program, descriptor + 2);
                    if (left_word < value_start || right_word < value_start
                        || left_word >= value || right_word >= value) {
                        output[1] = 2;
                        return;
                    }
                    uint left = uint(left_word);
                    uint right = uint(right_word);
                    if (tags[left] == IG_MUTATION_VALUE_NULL
                        || tags[right] == IG_MUTATION_VALUE_NULL) {
                        tags[value] = IG_MUTATION_VALUE_NULL;
                    } else if (tags[left] == IG_MUTATION_VALUE_INTEGER
                        && tags[right] == IG_MUTATION_VALUE_INTEGER) {
                        long left_value = as_type<long>(payloads[left]);
                        long right_value = as_type<long>(payloads[right]);
                        const long maximum = 0x7fffffffffffffffL;
                        const long minimum = (-0x7fffffffffffffffL - 1L);
                        if ((right_value > 0 && left_value > maximum - right_value)
                            || (right_value < 0 && left_value < minimum - right_value)) {
                            output[1] = 4;
                            return;
                        }
                        long sum = left_value + right_value;
                        tags[value] = IG_MUTATION_VALUE_INTEGER;
                        payloads[value] = as_type<ulong>(sum);
                    } else if (tags[left] == IG_MUTATION_VALUE_STRING
                        && tags[right] == IG_MUTATION_VALUE_STRING) {
                        ulong length = string_lengths[left] + string_lengths[right];
                        if (length < string_lengths[left]
                            || length > IG_MUTATION_TYPED_MAX_STRING_BYTES) {
                            output[1] = 5;
                            return;
                        }
                        tags[value] = IG_MUTATION_VALUE_STRING;
                        string_lengths[value] = length;
                        concat_left[value] = left;
                        concat_right[value] = right;
                        concatenated[value] = 1;
                    } else {
                        // Metal has no native f64 arithmetic. Float cells remain fully typed for
                        // constants/reads/SET, while mixed and float ADD fail closed.
                        output[1] = 3;
                        return;
                    }
                } else {
                    output[1] = 2;
                    return;
                }
            }

            uint result_register = uint(result_register_word);
            if (intent_count >= args.intent_capacity) {
                output[1] = 5;
                return;
            }
            ulong intent = intent_base + intent_count * IG_MUTATION_TYPED_INTENT_WORDS;
            output[intent] = row;
            output[intent + 1] = command;
            output[intent + 2] = target_kind;
            output[intent + 3] = target_id;
            output[intent + 4] = IG_MUTATION_ACTION_SET_PROPERTY;
            output[intent + 5] = property_name;
            output[intent + 6] = tags[result_register];
            output[intent + 7] = payloads[result_register];
            output[intent + 8] = 0;
            output[intent + 9] = 0;
            output[intent + 10] = 0;
            if (tags[result_register] == IG_MUTATION_VALUE_STRING) {
                ulong length = string_lengths[result_register];
                if (args.string_slot_words == 0 || length > args.string_slot_words) {
                    output[1] = 5;
                    return;
                }
                ulong output_offset = intent_count * ulong(args.string_slot_words);
                uint stack[IG_MUTATION_TYPED_MAX_VALUES];
                uint stack_count = 1;
                stack[0] = result_register;
                ulong copied = 0;
                while (stack_count != 0) {
                    uint current = stack[--stack_count];
                    if (concatenated[current] != 0) {
                        if (stack_count + 2 > IG_MUTATION_TYPED_MAX_VALUES) {
                            output[1] = 5;
                            return;
                        }
                        stack[stack_count++] = concat_right[current];
                        stack[stack_count++] = concat_left[current];
                        continue;
                    }
                    ulong source = string_sources[current];
                    ulong source_offset = string_offsets[current];
                    ulong source_length = string_lengths[current];
                    if (copied + source_length < copied
                        || copied + source_length > args.string_slot_words) {
                        output[1] = 5;
                        return;
                    }
                    for (ulong byte = 0; byte < source_length; ++byte) {
                        ulong value = 0;
                        if (source == IG_MUTATION_STRING_NODE_DICTIONARY) {
                            if (source_offset + byte >= args.node_dictionary_byte_count) {
                                output[1] = 2;
                                return;
                            }
                            value = ig_mutation_typed_word(
                                dictionary,
                                node_byte_base + source_offset + byte);
                        } else if (source == IG_MUTATION_STRING_EDGE_DICTIONARY) {
                            if (source_offset + byte >= args.edge_dictionary_byte_count) {
                                output[1] = 2;
                                return;
                            }
                            value = ig_mutation_typed_word(
                                dictionary,
                                edge_byte_base + source_offset + byte);
                        } else if (source == IG_MUTATION_STRING_PROGRAM_CONSTANT) {
                            if (source_offset + byte >= args.constant_byte_count) {
                                output[1] = 2;
                                return;
                            }
                            value = ig_mutation_typed_word(
                                program,
                                constant_base + source_offset + byte);
                        } else if (source == IG_MUTATION_STRING_OUTPUT) {
                            if (source_offset + byte >= payload_count) {
                                output[1] = 2;
                                return;
                            }
                            value = output[payload_base + source_offset + byte];
                        } else {
                            output[1] = 2;
                            return;
                        }
                        if (value > 255) {
                            output[1] = 2;
                            return;
                        }
                        output[payload_base + output_offset + copied++] = value;
                    }
                }
                if (copied != length) {
                    output[1] = 2;
                    return;
                }
                output[intent + 7] = output_offset;
                output[intent + 8] = length;
            } else if (tags[result_register] == IG_MUTATION_VALUE_NULL) {
                output[intent + 7] = 0;
            } else if (tags[result_register] > IG_MUTATION_VALUE_STRING) {
                output[1] = 2;
                return;
            }

            // Resolve the current destination value from the latest prior attempt for this
            // stable entity/property, falling back to the canonical resident lane. Attempts,
            // including no-ops, form the statement overlay exactly as the CPU reference does.
            ulong current_tag = canonical_tag;
            ulong current_payload = canonical_payload;
            ulong current_source = canonical_source;
            ulong current_offset = canonical_payload;
            ulong current_length = 0;
            for (long prior = long(intent_count) - 1; prior >= 0; --prior) {
                ulong prior_base = intent_base
                    + ulong(prior) * IG_MUTATION_TYPED_INTENT_WORDS;
                if (output[prior_base + 10] == 1
                    && output[prior_base + 2] == target_kind
                    && output[prior_base + 3] == target_id
                    && output[prior_base + 4] == IG_MUTATION_ACTION_SET_PROPERTY
                    && output[prior_base + 5] == property_name) {
                    current_tag = output[prior_base + 6];
                    current_payload = output[prior_base + 7];
                    current_source = current_tag == IG_MUTATION_VALUE_STRING
                        ? IG_MUTATION_STRING_OUTPUT : 0;
                    current_offset = current_payload;
                    current_length = output[prior_base + 8];
                    break;
                }
            }
            if (current_tag == IG_MUTATION_VALUE_STRING
                && !ig_mutation_typed_string_bounds(
                    dictionary,
                    args,
                    current_source,
                    current_payload,
                    current_length,
                    current_offset,
                    current_length)) {
                output[1] = 2;
                return;
            }
            ulong next_tag = output[intent + 6];
            ulong next_payload = output[intent + 7];
            ulong next_source = next_tag == IG_MUTATION_VALUE_STRING
                ? IG_MUTATION_STRING_OUTPUT : 0;
            ulong next_offset = next_payload;
            ulong next_length = output[intent + 8];
            bool equality_valid = false;
            bool equal = ig_mutation_typed_scalar_equal(
                dictionary,
                program,
                output,
                args,
                constant_base,
                payload_base,
                node_byte_base,
                edge_byte_base,
                current_tag,
                current_payload,
                current_source,
                current_offset,
                current_length,
                next_tag,
                next_payload,
                next_source,
                next_offset,
                next_length,
                equality_valid);
            if (!equality_valid) {
                output[1] = 2;
                return;
            }
            bool effectful = !equal;
            output[intent + 9] = effectful ? 1 : 0;
            output[intent + 10] = 1;
            ++intent_count;
            ++command_counts[command];
            if (effectful) ++effect_counts[command];
        }
    }

    for (uint receipt_index = 0; receipt_index < args.receipt_count; ++receipt_index) {
        ulong descriptor = receipt_descriptor_base
            + ulong(receipt_index) * IG_MUTATION_TYPED_RECEIPT_DESCRIPTOR_WORDS;
        ulong obligation_id = ig_mutation_typed_word(program, descriptor);
        ulong kind = ig_mutation_typed_word(program, descriptor + 1);
        ulong scope = ig_mutation_typed_word(program, descriptor + 2);
        ulong scope_index = ig_mutation_typed_word(program, descriptor + 3);
        ulong input_cardinality = ig_mutation_typed_word(program, descriptor + 4);
        ulong output_cardinality = ig_mutation_typed_word(program, descriptor + 5);
        if (kind == 1 && scope == 0) {
            if (scope_index != 0 || output_cardinality != args.row_count) {
                output[1] = 2;
                return;
            }
        } else if (kind == 4 && scope == 3) {
            if (scope_index >= args.filter_count
                || output_cardinality > input_cardinality) {
                output[1] = 2;
                return;
            }
        } else if (kind == 3 && scope == 2) {
            if (scope_index >= args.value_count) {
                output[1] = 2;
                return;
            }
            bool owner_found = false;
            for (uint command = 0; command < args.command_count; ++command) {
                ulong command_base = ulong(command) * IG_MUTATION_TYPED_COMMAND_WORDS;
                ulong start = ig_mutation_typed_word(program, command_base + 3);
                ulong count = ig_mutation_typed_word(program, command_base + 4);
                if (scope_index >= start && scope_index < start + count) {
                    input_cardinality = command_counts[command];
                    output_cardinality = command_counts[command];
                    owner_found = true;
                    break;
                }
            }
            if (!owner_found) {
                output[1] = 2;
                return;
            }
        } else if (kind == 2 && scope == 1) {
            if (scope_index >= args.command_count) {
                output[1] = 2;
                return;
            }
            input_cardinality = args.row_count;
            output_cardinality = command_counts[scope_index];
        } else if (kind == 12 && scope == 1) {
            if (scope_index >= args.command_count) {
                output[1] = 2;
                return;
            }
            input_cardinality = command_counts[scope_index];
            output_cardinality = effect_counts[scope_index];
        } else {
            output[1] = 2;
            return;
        }
        ulong receipt = receipt_base
            + ulong(receipt_index) * IG_MUTATION_STATIC_RECEIPT_WORDS;
        output[receipt] = args.execution_high;
        output[receipt + 1] = args.execution_low;
        output[receipt + 2] = obligation_id;
        output[receipt + 3] = kind;
        output[receipt + 4] = scope;
        output[receipt + 5] = scope_index;
        output[receipt + 6] = input_cardinality;
        output[receipt + 7] = output_cardinality;
        output[receipt + 8] = 2;
    }
    output[2] = intent_count;
}

constant ulong IG_MUTATION_CONTINUATION_MAGIC = 0x49474d5554434f4eul;
constant uint IG_MUTATION_CONTINUATION_HEADER_WORDS = 21;
constant uint IG_MUTATION_CONTINUATION_RECEIPT_WORDS = 9;
constant uint IG_MUTATION_CONTINUATION_DEPENDENCY_WORDS = 2;
constant uint IG_MUTATION_CONTINUATION_INPUT_FIELDS = 7;
constant uint IG_MUTATION_CONTINUATION_STAGE_WORDS = 3;
constant uint IG_MUTATION_CONTINUATION_RECEIPT_DESCRIPTOR_WORDS = 4;
constant uint IG_MUTATION_CONTINUATION_OUTPUT_ENTITY = 1;
constant uint IG_MUTATION_CONTINUATION_OUTPUT_INTEGER = 2;
constant uint IG_MUTATION_CONTINUATION_OUTPUT_AGGREGATE = 3;
constant uint IG_MUTATION_CONTINUATION_OUTPUT_COMPUTED = 4;
constant uint IG_MUTATION_CONTINUATION_SOURCE_NONE = 0;
constant uint IG_MUTATION_CONTINUATION_SOURCE_PROPERTY = 1;
constant uint IG_MUTATION_CONTINUATION_SOURCE_PROPERTY_IS_NOT_NULL = 2;
constant uint IG_MUTATION_CONTINUATION_SOURCE_PROPERTY_COUNT = 3;
constant ulong IG_MUTATION_CONTINUATION_STAGE_PROJECT = 1;
constant ulong IG_MUTATION_CONTINUATION_STAGE_FILTER_MODULO = 2;
constant ulong IG_MUTATION_CONTINUATION_STAGE_SKIP = 3;
constant ulong IG_MUTATION_CONTINUATION_STAGE_LIMIT = 4;
constant ulong IG_MUTATION_CONTINUATION_STAGE_SUM = 5;
constant uint IG_MUTATION_PACKET_STATIC = 1;
constant uint IG_MUTATION_PACKET_TYPED = 2;

struct MutationContinuationArgs {
    ulong execution_high;
    ulong execution_low;
    ulong project_high;
    ulong project_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong fingerprint_0;
    ulong fingerprint_1;
    ulong fingerprint_2;
    ulong fingerprint_3;
    ulong input_word_count;
    ulong mutation_word_count;
    ulong program_word_count;
    ulong output_word_count;
    uint row_count;
    uint stage_count;
    uint receipt_count;
    uint output_capacity;
    uint dependency_node_count;
    uint dependency_relationship_count;
    uint dependency_capacity;
    uint output_kind;
    uint property_name;
    uint value_source;
    uint mutation_kind;
};

inline bool ig_mutation_continuation_write_receipt(
    device ulong* output,
    device const long* program,
    constant MutationContinuationArgs& args,
    uint receipt_index,
    ulong input_cardinality,
    ulong output_cardinality,
    ulong expected_kind,
    ulong expected_scope) {
    if (receipt_index >= args.receipt_count) return false;
    ulong descriptor_base = ulong(args.stage_count) * IG_MUTATION_CONTINUATION_STAGE_WORDS
        + ulong(receipt_index) * IG_MUTATION_CONTINUATION_RECEIPT_DESCRIPTOR_WORDS;
    ulong obligation_id = ig_mutation_typed_word(program, descriptor_base);
    ulong kind = ig_mutation_typed_word(program, descriptor_base + 1);
    ulong scope = ig_mutation_typed_word(program, descriptor_base + 2);
    ulong scope_index = ig_mutation_typed_word(program, descriptor_base + 3);
    if (obligation_id == 0
        || kind != expected_kind
        || scope != expected_scope
        || scope_index > 0xfffful
        || (scope == 0 && scope_index != 0)) {
        return false;
    }
    ulong receipt = IG_MUTATION_CONTINUATION_HEADER_WORDS
        + ulong(receipt_index) * IG_MUTATION_CONTINUATION_RECEIPT_WORDS;
    output[receipt] = args.execution_high;
    output[receipt + 1] = args.execution_low;
    output[receipt + 2] = obligation_id;
    output[receipt + 3] = kind;
    output[receipt + 4] = scope;
    output[receipt + 5] = scope_index;
    output[receipt + 6] = input_cardinality;
    output[receipt + 7] = output_cardinality;
    output[receipt + 8] = 2;
    return true;
}

kernel void ig_mutation_continuation(
    device const long* inputs [[buffer(0)]],
    device const long* mutation [[buffer(1)]],
    device const long* program [[buffer(2)]],
    device ulong* output [[buffer(3)]],
    constant MutationContinuationArgs& args [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0) return;

    ulong dependency_count = ulong(args.dependency_node_count)
        + ulong(args.dependency_relationship_count);
    ulong expected_input_words = ulong(args.row_count)
        * IG_MUTATION_CONTINUATION_INPUT_FIELDS + dependency_count;
    ulong expected_program_words = ulong(args.stage_count)
        * IG_MUTATION_CONTINUATION_STAGE_WORDS
        + ulong(args.receipt_count) * IG_MUTATION_CONTINUATION_RECEIPT_DESCRIPTOR_WORDS;
    ulong dependency_base = IG_MUTATION_CONTINUATION_HEADER_WORDS
        + ulong(args.receipt_count) * IG_MUTATION_CONTINUATION_RECEIPT_WORDS;
    ulong value_base = dependency_base
        + ulong(args.dependency_capacity) * IG_MUTATION_CONTINUATION_DEPENDENCY_WORDS;
    ulong validity_base = value_base + ulong(args.output_capacity);
    ulong position_base = validity_base + ulong(args.output_capacity);
    ulong scratch_value_base = position_base + ulong(args.row_count);
    ulong scratch_validity_base = scratch_value_base + ulong(args.row_count);
    ulong expected_output_words = scratch_validity_base + ulong(args.row_count);
    bool shape_valid = args.receipt_count == args.stage_count + 3
        && dependency_count <= ulong(args.dependency_capacity)
        && args.value_source <= IG_MUTATION_CONTINUATION_SOURCE_PROPERTY_COUNT
        && args.property_name <= 0xffffu
        && args.output_kind >= IG_MUTATION_CONTINUATION_OUTPUT_ENTITY
        && args.output_kind <= IG_MUTATION_CONTINUATION_OUTPUT_COMPUTED
        && ((args.output_kind == IG_MUTATION_CONTINUATION_OUTPUT_ENTITY
                && args.value_source == IG_MUTATION_CONTINUATION_SOURCE_NONE)
            || (args.output_kind != IG_MUTATION_CONTINUATION_OUTPUT_ENTITY
                && args.output_kind != IG_MUTATION_CONTINUATION_OUTPUT_COMPUTED
                && args.value_source != IG_MUTATION_CONTINUATION_SOURCE_NONE)
            || (args.output_kind == IG_MUTATION_CONTINUATION_OUTPUT_COMPUTED
                && args.value_source == IG_MUTATION_CONTINUATION_SOURCE_NONE))
        && (args.output_kind != IG_MUTATION_CONTINUATION_OUTPUT_COMPUTED
            || args.value_source == IG_MUTATION_CONTINUATION_SOURCE_NONE)
        && (args.mutation_kind == IG_MUTATION_PACKET_STATIC
            || args.mutation_kind == IG_MUTATION_PACKET_TYPED)
        && args.input_word_count == expected_input_words
        && args.program_word_count == expected_program_words
        && args.output_word_count == expected_output_words;

    output[0] = IG_MUTATION_CONTINUATION_MAGIC;
    output[1] = shape_valid ? 1 : 2;
    output[2] = args.execution_high;
    output[3] = args.execution_low;
    output[4] = args.project_high;
    output[5] = args.project_low;
    output[6] = args.bookmark_term;
    output[7] = args.bookmark_index;
    output[8] = args.graph_revision;
    output[9] = args.layout_version;
    output[10] = args.fingerprint_0;
    output[11] = args.fingerprint_1;
    output[12] = args.fingerprint_2;
    output[13] = args.fingerprint_3;
    output[14] = 2;
    output[15] = args.row_count;
    output[16] = 0;
    output[17] = shape_valid ? args.receipt_count : 0;
    output[18] = args.output_kind;
    output[19] = shape_valid ? dependency_count : 0;
    output[20] = args.dependency_capacity;
    if (!shape_valid) return;

    ulong dependency_input_base = ulong(args.row_count)
        * IG_MUTATION_CONTINUATION_INPUT_FIELDS;
    for (ulong index = 0; index < dependency_count; ++index) {
        ulong dense_row = ig_mutation_typed_word(inputs, dependency_input_base + index);
        bool is_relationship = index >= ulong(args.dependency_node_count);
        ulong namespace_index = is_relationship
            ? index - ulong(args.dependency_node_count)
            : index;
        ulong namespace_base = is_relationship ? ulong(args.dependency_node_count) : 0;
        if (dense_row >= 0xfffffffful
            || (namespace_index != 0
                && ig_mutation_typed_word(
                    inputs,
                    dependency_input_base + namespace_base + namespace_index - 1) >= dense_row)) {
            output[1] = 2;
            return;
        }
        ulong destination = dependency_base
            + index * IG_MUTATION_CONTINUATION_DEPENDENCY_WORDS;
        output[destination] = is_relationship ? 1 : 0;
        output[destination + 1] = dense_row;
    }

    ulong mutation_intent_count = 0;
    ulong mutation_intent_base = 0;
    ulong mutation_payload_base = 0;
    ulong mutation_payload_count = 0;
    ulong mutation_intent_words = 0;
    if (args.mutation_kind == IG_MUTATION_PACKET_STATIC) {
        if (args.mutation_word_count < IG_MUTATION_STATIC_HEADER_WORDS
            || ig_mutation_typed_word(mutation, 0) != IG_MUTATION_STATIC_MAGIC
            || ig_mutation_typed_word(mutation, 1) != 1
            || ig_mutation_typed_word(mutation, 5) != args.execution_high
            || ig_mutation_typed_word(mutation, 6) != args.execution_low
            || ig_mutation_typed_word(mutation, 7) != 2) {
            output[1] = 2;
            return;
        }
        mutation_intent_count = ig_mutation_typed_word(mutation, 2);
        ulong mutation_receipt_count = ig_mutation_typed_word(mutation, 3);
        mutation_payload_count = ig_mutation_typed_word(mutation, 4);
        ulong mutation_intent_capacity = ig_mutation_typed_word(mutation, 8);
        mutation_intent_words = IG_MUTATION_STATIC_INTENT_WORDS;
        mutation_intent_base = IG_MUTATION_STATIC_HEADER_WORDS
            + mutation_receipt_count * IG_MUTATION_STATIC_RECEIPT_WORDS;
        mutation_payload_base = mutation_intent_base
            + mutation_intent_capacity * mutation_intent_words;
        if (mutation_intent_count > mutation_intent_capacity
            || mutation_intent_base > args.mutation_word_count
            || mutation_payload_base < mutation_intent_base
            || mutation_payload_base > args.mutation_word_count
            || mutation_payload_base + mutation_payload_count < mutation_payload_base
            || mutation_payload_base + mutation_payload_count != args.mutation_word_count) {
            output[1] = 2;
            return;
        }
    } else {
        if (args.mutation_word_count < IG_MUTATION_TYPED_HEADER_WORDS
            || ig_mutation_typed_word(mutation, 0) != IG_MUTATION_TYPED_MAGIC
            || ig_mutation_typed_word(mutation, 1) != 1
            || ig_mutation_typed_word(mutation, 5) != args.execution_high
            || ig_mutation_typed_word(mutation, 6) != args.execution_low
            || ig_mutation_typed_word(mutation, 7) != 2) {
            output[1] = 2;
            return;
        }
        mutation_intent_count = ig_mutation_typed_word(mutation, 2);
        ulong mutation_receipt_count = ig_mutation_typed_word(mutation, 3);
        mutation_payload_count = ig_mutation_typed_word(mutation, 4);
        ulong mutation_intent_capacity = ig_mutation_typed_word(mutation, 8);
        mutation_intent_words = IG_MUTATION_TYPED_INTENT_WORDS;
        mutation_intent_base = IG_MUTATION_TYPED_HEADER_WORDS
            + mutation_receipt_count * IG_MUTATION_STATIC_RECEIPT_WORDS;
        mutation_payload_base = mutation_intent_base
            + mutation_intent_capacity * mutation_intent_words;
        if (mutation_intent_count > mutation_intent_capacity
            || mutation_intent_base > args.mutation_word_count
            || mutation_payload_base < mutation_intent_base
            || mutation_payload_base > args.mutation_word_count
            || mutation_payload_base + mutation_payload_count < mutation_payload_base
            || mutation_payload_base + mutation_payload_count != args.mutation_word_count) {
            output[1] = 2;
            return;
        }
    }

    for (ulong row = 0; row < args.row_count; ++row) {
        output[position_base + row] = row;
        ulong value_tag = IG_MUTATION_VALUE_NULL;
        ulong value_payload = 0;
        if (args.value_source != IG_MUTATION_CONTINUATION_SOURCE_NONE) {
            ulong identity_valid = ig_mutation_typed_word(
                inputs,
                ulong(args.row_count) + row);
            ulong entity_kind = ig_mutation_typed_word(
                inputs,
                2 * ulong(args.row_count) + row);
            ulong entity_id = ig_mutation_typed_word(
                inputs,
                3 * ulong(args.row_count) + row);
            value_tag = ig_mutation_typed_word(
                inputs,
                4 * ulong(args.row_count) + row);
            value_payload = ig_mutation_typed_word(
                inputs,
                5 * ulong(args.row_count) + row);
            bool ordinary_property =
                args.value_source == IG_MUTATION_CONTINUATION_SOURCE_PROPERTY;
            bool property_is_not_null = args.value_source
                == IG_MUTATION_CONTINUATION_SOURCE_PROPERTY_IS_NOT_NULL;
            bool property_count = args.value_source
                == IG_MUTATION_CONTINUATION_SOURCE_PROPERTY_COUNT;
            if (identity_valid > 1 || entity_kind > 1
                || (ordinary_property
                    && (value_tag > IG_MUTATION_VALUE_INTEGER
                        || (identity_valid == 0
                            && value_tag != IG_MUTATION_VALUE_NULL)))
                || (property_is_not_null
                    && (value_tag != IG_MUTATION_VALUE_INTEGER
                        || value_payload > 1))
                || (property_count
                    && ((identity_valid == 0
                            && (value_tag != IG_MUTATION_VALUE_NULL
                                || value_payload != 0))
                        || (identity_valid != 0
                            && (value_tag != IG_MUTATION_VALUE_INTEGER
                                || value_payload > 0x7ffffffffffffffful))))) {
                output[1] = 3;
                return;
            }
            if (identity_valid == 0 && !property_is_not_null) {
                value_tag = IG_MUTATION_VALUE_NULL;
                value_payload = 0;
            }
            for (ulong intent_index = 0; intent_index < mutation_intent_count; ++intent_index) {
                ulong intent = mutation_intent_base + intent_index * mutation_intent_words;
                ulong source_row = ig_mutation_typed_word(mutation, intent);
                ulong target_kind = ig_mutation_typed_word(mutation, intent + 2);
                ulong target_id = ig_mutation_typed_word(mutation, intent + 3);
                if (source_row >= args.row_count || target_kind > 1) {
                    output[1] = 2;
                    return;
                }
                if (args.mutation_kind == IG_MUTATION_PACKET_TYPED) {
                    ulong action = ig_mutation_typed_word(mutation, intent + 4);
                    ulong property_name = ig_mutation_typed_word(mutation, intent + 5);
                    ulong intent_tag = ig_mutation_typed_word(mutation, intent + 6);
                    ulong effectful = ig_mutation_typed_word(mutation, intent + 9);
                    ulong status = ig_mutation_typed_word(mutation, intent + 10);
                    if (status != 1
                        || effectful > 1
                        || action != IG_MUTATION_ACTION_SET_PROPERTY
                        || property_name > 0xfffful
                        || intent_tag > IG_MUTATION_VALUE_INTEGER
                        || property_count) {
                        output[1] = intent_tag > IG_MUTATION_VALUE_INTEGER ? 3 : 2;
                        return;
                    }
                    if (identity_valid != 0
                        && target_kind == entity_kind
                        && target_id == entity_id
                        && property_name == args.property_name) {
                        if (property_is_not_null) {
                            value_tag = IG_MUTATION_VALUE_INTEGER;
                            value_payload = intent_tag == IG_MUTATION_VALUE_NULL ? 0 : 1;
                        } else {
                            value_tag = intent_tag;
                            value_payload = intent_tag == IG_MUTATION_VALUE_NULL
                                ? 0
                                : ig_mutation_typed_word(mutation, intent + 7);
                        }
                    }
                } else {
                    ulong action = ig_mutation_typed_word(mutation, intent + 4);
                    ulong payload_offset = ig_mutation_typed_word(mutation, intent + 5);
                    ulong payload_words = ig_mutation_typed_word(mutation, intent + 6);
                    ulong effectful = ig_mutation_typed_word(mutation, intent + 7);
                    ulong status = ig_mutation_typed_word(mutation, intent + 8);
                    if (status != 1
                        || effectful > 1
                        || (action != 1 && action != 2 && action != 3)
                        || payload_offset + payload_words < payload_offset
                        || payload_offset + payload_words > mutation_payload_count) {
                        output[1] = 2;
                        return;
                    }
                    if (action == 3) {
                        if (payload_words != 1) {
                            output[1] = 2;
                            return;
                        }
                        ulong property_name = ig_mutation_typed_word(
                            mutation,
                            mutation_payload_base + payload_offset);
                        if (property_name > 0xfffful) {
                            output[1] = 2;
                            return;
                        }
                        if (identity_valid != 0
                            && target_kind == entity_kind
                            && target_id == entity_id) {
                            if (property_count && effectful == 1) {
                                if (value_tag != IG_MUTATION_VALUE_INTEGER
                                    || value_payload == 0) {
                                    output[1] = 2;
                                    return;
                                }
                                value_payload -= 1;
                            } else if (!property_count
                                && property_name == args.property_name) {
                                if (property_is_not_null) {
                                    value_tag = IG_MUTATION_VALUE_INTEGER;
                                    value_payload = 0;
                                } else {
                                    value_tag = IG_MUTATION_VALUE_NULL;
                                    value_payload = 0;
                                }
                            }
                        }
                    }
                }
            }
        }
        output[scratch_value_base + row] = value_payload;
        output[scratch_validity_base + row] = value_tag == IG_MUTATION_VALUE_INTEGER ? 1 : 0;
    }

    if (!ig_mutation_continuation_write_receipt(
            output,
            program,
            args,
            0,
            dependency_count,
            dependency_count,
            13,
            0)) {
        output[1] = 2;
        return;
    }

    if (!ig_mutation_continuation_write_receipt(
            output,
            program,
            args,
            1,
            args.row_count,
            args.row_count,
            2,
            2)) {
        output[1] = 2;
        return;
    }

    ulong cardinality = args.row_count;
    long aggregate_value = 0;
    bool aggregate_ready = false;
    for (uint stage = 0; stage < args.stage_count; ++stage) {
        ulong stage_base = ulong(stage) * IG_MUTATION_CONTINUATION_STAGE_WORDS;
        ulong opcode = ig_mutation_typed_word(program, stage_base);
        ulong argument_0 = ig_mutation_typed_word(program, stage_base + 1);
        ulong argument_1 = ig_mutation_typed_word(program, stage_base + 2);
        ulong input_cardinality = cardinality;
        ulong expected_kind = 0;
        if (opcode == IG_MUTATION_CONTINUATION_STAGE_PROJECT) {
            expected_kind = 3;
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_FILTER_MODULO) {
            expected_kind = 4;
            long divisor = as_type<long>(argument_0);
            long operand = as_type<long>(argument_1);
            if (divisor == 0) {
                output[1] = 2;
                return;
            }
            ulong selected = 0;
            for (ulong index = 0; index < cardinality; ++index) {
                ulong row = output[position_base + index];
                if (output[scratch_validity_base + row] == 0) continue;
                long value = as_type<long>(output[scratch_value_base + row]);
                long remainder = value == (-0x7fffffffffffffffL - 1L) && divisor == -1
                    ? 0
                    : value % divisor;
                if (remainder == operand) {
                    output[position_base + selected++] = row;
                }
            }
            cardinality = selected;
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_SKIP) {
            expected_kind = 9;
            ulong skip = min(argument_0, cardinality);
            ulong remaining = cardinality - skip;
            for (ulong index = 0; index < remaining; ++index) {
                output[position_base + index] = output[position_base + skip + index];
            }
            cardinality = remaining;
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_LIMIT) {
            expected_kind = 9;
            cardinality = min(argument_0, cardinality);
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_SUM) {
            expected_kind = 10;
            long sum = 0;
            for (ulong index = 0; index < cardinality; ++index) {
                ulong row = output[position_base + index];
                if (output[scratch_validity_base + row] == 0) continue;
                long value = as_type<long>(output[scratch_value_base + row]);
                const long maximum = 0x7fffffffffffffffL;
                const long minimum = (-0x7fffffffffffffffL - 1L);
                if ((value > 0 && sum > maximum - value)
                    || (value < 0 && sum < minimum - value)) {
                    output[1] = 4;
                    return;
                }
                sum += value;
            }
            aggregate_value = sum;
            aggregate_ready = true;
            cardinality = 1;
        } else {
            output[1] = 2;
            return;
        }
        if (!ig_mutation_continuation_write_receipt(
                output,
                program,
                args,
                stage + 2,
                input_cardinality,
                cardinality,
                expected_kind,
                2)) {
            output[1] = 2;
            return;
        }
    }

    if (cardinality > args.output_capacity
        || (args.output_kind == IG_MUTATION_CONTINUATION_OUTPUT_AGGREGATE
            && !aggregate_ready)
        || (args.output_kind != IG_MUTATION_CONTINUATION_OUTPUT_AGGREGATE
            && aggregate_ready)) {
        output[1] = cardinality > args.output_capacity ? 5 : 2;
        return;
    }
    for (ulong index = 0; index < cardinality; ++index) {
        if (args.output_kind == IG_MUTATION_CONTINUATION_OUTPUT_ENTITY) {
            ulong row = output[position_base + index];
            output[value_base + index] = ig_mutation_typed_word(inputs, row);
            output[validity_base + index] = 1;
        } else if (args.output_kind == IG_MUTATION_CONTINUATION_OUTPUT_INTEGER) {
            ulong row = output[position_base + index];
            output[value_base + index] = output[scratch_value_base + row];
            output[validity_base + index] = output[scratch_validity_base + row];
        } else if (args.output_kind == IG_MUTATION_CONTINUATION_OUTPUT_COMPUTED) {
            output[value_base + index] = output[position_base + index];
            output[validity_base + index] = 1;
        } else {
            output[value_base + index] = as_type<ulong>(aggregate_value);
            output[validity_base + index] = 1;
        }
    }
    if (!ig_mutation_continuation_write_receipt(
            output,
            program,
            args,
            args.receipt_count - 1,
            cardinality,
            cardinality,
            9,
            2)) {
        output[1] = 2;
        return;
    }
    output[16] = cardinality;
}

constant ulong IG_ROW_CREATE_CONTINUATION_MAGIC = 0x4947524343544e32ul;
constant uint IG_ROW_CREATE_CONTINUATION_HEADER_WORDS = 16;
constant uint IG_ROW_CREATE_CONTINUATION_RECEIPT_WORDS = 9;
constant uint IG_ROW_CREATE_CONTINUATION_STAGE_WORDS = 3;
constant uint IG_ROW_CREATE_CONTINUATION_OBLIGATION_WORDS = 4;
constant uint IG_ROW_CREATE_CONTINUATION_OUTPUT_ENTITY = 1;
constant uint IG_ROW_CREATE_CONTINUATION_OUTPUT_INTEGER = 2;
constant uint IG_ROW_CREATE_CONTINUATION_OUTPUT_AGGREGATE = 3;

struct RowCreateContinuationArgs {
    ulong execution_high;
    ulong execution_low;
    ulong fingerprint_0;
    ulong fingerprint_1;
    ulong fingerprint_2;
    ulong fingerprint_3;
    ulong input_word_count;
    ulong program_word_count;
    ulong output_word_count;
    uint row_count;
    uint stage_count;
    uint receipt_count;
    uint output_capacity;
    uint output_kind;
};

inline bool ig_row_create_continuation_write_receipt(
    device ulong* output,
    device const long* program,
    constant RowCreateContinuationArgs& args,
    uint receipt_index,
    ulong input_cardinality,
    ulong output_cardinality,
    ulong expected_kind,
    ulong expected_scope,
    ulong expected_scope_index) {
    if (receipt_index >= args.receipt_count) return false;
    ulong descriptor_base = ulong(args.stage_count) * IG_ROW_CREATE_CONTINUATION_STAGE_WORDS
        + ulong(receipt_index) * IG_ROW_CREATE_CONTINUATION_OBLIGATION_WORDS;
    ulong obligation_id = ig_mutation_typed_word(program, descriptor_base);
    ulong kind = ig_mutation_typed_word(program, descriptor_base + 1);
    ulong scope = ig_mutation_typed_word(program, descriptor_base + 2);
    ulong scope_index = ig_mutation_typed_word(program, descriptor_base + 3);
    if (obligation_id == 0
        || kind != expected_kind
        || scope != expected_scope
        || scope_index != expected_scope_index
        || scope_index > 0xfffful) {
        return false;
    }
    ulong receipt = IG_ROW_CREATE_CONTINUATION_HEADER_WORDS
        + ulong(receipt_index) * IG_ROW_CREATE_CONTINUATION_RECEIPT_WORDS;
    output[receipt] = args.execution_high;
    output[receipt + 1] = args.execution_low;
    output[receipt + 2] = obligation_id;
    output[receipt + 3] = kind;
    output[receipt + 4] = scope;
    output[receipt + 5] = scope_index;
    output[receipt + 6] = input_cardinality;
    output[receipt + 7] = output_cardinality;
    output[receipt + 8] = 2;
    return true;
}

// Executes only after the generalized row-CREATE command has built its complete device row bank.
// Input values are a typed upload aligned by the device-resident source-lineage column; every
// filter/page/aggregate decision, stage lineage, typed final lane, and receipt is authored here.
kernel void ig_row_create_continuation(
    device const long* inputs [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant RowCreateContinuationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0) return;

    ulong receipt_base = IG_ROW_CREATE_CONTINUATION_HEADER_WORDS;
    ulong stage_count_base = receipt_base
        + ulong(args.receipt_count) * IG_ROW_CREATE_CONTINUATION_RECEIPT_WORDS;
    ulong stage_lineage_base = stage_count_base + ulong(args.stage_count);
    ulong final_position_base = stage_lineage_base
        + ulong(args.stage_count) * ulong(args.output_capacity);
    ulong value_base = final_position_base + ulong(args.output_capacity);
    ulong validity_base = value_base + ulong(args.output_capacity);
    ulong scratch_position_base = validity_base + ulong(args.output_capacity);
    ulong expected_output_words = scratch_position_base + ulong(args.output_capacity);
    ulong expected_program_words = ulong(args.stage_count)
        * IG_ROW_CREATE_CONTINUATION_STAGE_WORDS
        + ulong(args.receipt_count) * IG_ROW_CREATE_CONTINUATION_OBLIGATION_WORDS;
    bool shape_valid = args.stage_count != 0
        && args.receipt_count == args.stage_count + 1
        && args.output_capacity == max(args.row_count, 1u)
        && args.input_word_count == 2ul * ulong(args.row_count)
        && args.program_word_count == expected_program_words
        && args.output_word_count == expected_output_words
        && args.output_kind >= IG_ROW_CREATE_CONTINUATION_OUTPUT_ENTITY
        && args.output_kind <= IG_ROW_CREATE_CONTINUATION_OUTPUT_AGGREGATE;

    output[0] = IG_ROW_CREATE_CONTINUATION_MAGIC;
    output[1] = shape_valid ? 1 : 2;
    output[2] = args.execution_high;
    output[3] = args.execution_low;
    output[4] = args.fingerprint_0;
    output[5] = args.fingerprint_1;
    output[6] = args.fingerprint_2;
    output[7] = args.fingerprint_3;
    output[8] = args.row_count;
    output[9] = 0;
    output[10] = args.stage_count;
    output[11] = shape_valid ? args.receipt_count : 0;
    output[12] = args.output_kind;
    output[13] = 0;
    output[14] = args.output_capacity;
    output[15] = 2;
    if (!shape_valid) return;

    for (ulong row = 0; row < args.row_count; ++row) {
        ulong valid = ig_mutation_typed_word(inputs, ulong(args.row_count) + row);
        if (valid > 1) {
            output[1] = 3;
            return;
        }
        output[scratch_position_base + row] = row;
    }

    ulong cardinality = args.row_count;
    long aggregate_value = 0;
    bool aggregate_ready = false;
    for (uint stage = 0; stage < args.stage_count; ++stage) {
        ulong stage_base = ulong(stage) * IG_ROW_CREATE_CONTINUATION_STAGE_WORDS;
        ulong opcode = ig_mutation_typed_word(program, stage_base);
        ulong argument_0 = ig_mutation_typed_word(program, stage_base + 1);
        ulong argument_1 = ig_mutation_typed_word(program, stage_base + 2);
        ulong input_cardinality = cardinality;
        ulong expected_kind = 0;
        if (aggregate_ready && opcode != IG_MUTATION_CONTINUATION_STAGE_PROJECT) {
            output[1] = 2;
            return;
        }
        if (opcode == IG_MUTATION_CONTINUATION_STAGE_PROJECT) {
            expected_kind = 3;
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_FILTER_MODULO) {
            expected_kind = 4;
            long divisor = as_type<long>(argument_0);
            long operand = as_type<long>(argument_1);
            if (divisor == 0) {
                output[1] = 2;
                return;
            }
            ulong selected = 0;
            for (ulong index = 0; index < cardinality; ++index) {
                ulong row = output[scratch_position_base + index];
                if (ig_mutation_typed_word(inputs, ulong(args.row_count) + row) == 0) continue;
                long value = as_type<long>(ig_mutation_typed_word(inputs, row));
                long remainder = value == (-0x7fffffffffffffffL - 1L) && divisor == -1
                    ? 0
                    : value % divisor;
                if (remainder == operand) {
                    output[scratch_position_base + selected++] = row;
                }
            }
            cardinality = selected;
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_SKIP) {
            expected_kind = 9;
            ulong skip = min(argument_0, cardinality);
            ulong remaining = cardinality - skip;
            for (ulong index = 0; index < remaining; ++index) {
                output[scratch_position_base + index] =
                    output[scratch_position_base + skip + index];
            }
            cardinality = remaining;
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_LIMIT) {
            expected_kind = 9;
            cardinality = min(argument_0, cardinality);
        } else if (opcode == IG_MUTATION_CONTINUATION_STAGE_SUM) {
            expected_kind = 10;
            long sum = 0;
            for (ulong index = 0; index < cardinality; ++index) {
                ulong row = output[scratch_position_base + index];
                if (ig_mutation_typed_word(inputs, ulong(args.row_count) + row) == 0) continue;
                long value = as_type<long>(ig_mutation_typed_word(inputs, row));
                const long maximum = 0x7fffffffffffffffL;
                const long minimum = (-0x7fffffffffffffffL - 1L);
                if ((value > 0 && sum > maximum - value)
                    || (value < 0 && sum < minimum - value)) {
                    output[1] = 4;
                    return;
                }
                sum += value;
            }
            aggregate_value = sum;
            aggregate_ready = true;
            cardinality = 1;
        } else {
            output[1] = 2;
            return;
        }
        if (!ig_row_create_continuation_write_receipt(
                output,
                program,
                args,
                stage,
                input_cardinality,
                cardinality,
                expected_kind,
                2,
                stage)) {
            output[1] = 2;
            return;
        }
        ulong lineage_count = aggregate_ready ? 0 : cardinality;
        output[stage_count_base + stage] = lineage_count;
        ulong lineage = stage_lineage_base + ulong(stage) * ulong(args.output_capacity);
        for (ulong index = 0; index < lineage_count; ++index) {
            output[lineage + index] = output[scratch_position_base + index];
        }
    }

    if (cardinality > args.output_capacity
        || (args.output_kind == IG_ROW_CREATE_CONTINUATION_OUTPUT_AGGREGATE
            && !aggregate_ready)
        || (args.output_kind != IG_ROW_CREATE_CONTINUATION_OUTPUT_AGGREGATE
            && aggregate_ready)) {
        output[1] = cardinality > args.output_capacity ? 5 : 2;
        return;
    }
    if (!aggregate_ready) {
        for (ulong index = 0; index < cardinality; ++index) {
            ulong row = output[scratch_position_base + index];
            output[final_position_base + index] = row;
            if (args.output_kind == IG_ROW_CREATE_CONTINUATION_OUTPUT_INTEGER) {
                output[value_base + index] = ig_mutation_typed_word(inputs, row);
                output[validity_base + index] = ig_mutation_typed_word(
                    inputs,
                    ulong(args.row_count) + row);
            }
        }
    } else {
        output[value_base] = as_type<ulong>(aggregate_value);
        output[validity_base] = 1;
    }
    if (!ig_row_create_continuation_write_receipt(
            output,
            program,
            args,
            args.receipt_count - 1,
            cardinality,
            cardinality,
            3,
            5,
            0)) {
        output[1] = 2;
        return;
    }
    output[9] = cardinality;
    output[13] = aggregate_ready ? 1 : 0;
}

// Complete resident DELETE. Every semantic kernel below is dispatched in order through one
// command encoder. All dimensions are fail-closed at u32 and every kernel is division-free;
// notably, modulo uses a fixed-width restoring remainder instead of runtime integer division.
constant ulong IG_DELETE_PROGRAM_MAGIC = 0x494744454c505247ul;
constant ulong IG_DELETE_OUTPUT_MAGIC = 0x494744454c4f5554ul;
constant ulong IG_DELETE_VERSION = 2ul;
constant ulong IG_DELETE_PROGRAM_HEADER_WORDS = 64ul;
constant ulong IG_DELETE_FILTER_WORDS = 12ul;
constant ulong IG_DELETE_COMMAND_WORDS = 14ul;
constant ulong IG_DELETE_STAGE_WORDS = 14ul;
constant ulong IG_DELETE_OUTPUT_HEADER_WORDS = 48ul;
constant ulong IG_DELETE_RECEIPT_WORDS = 9ul;
constant ulong IG_DELETE_INTENT_WORDS = 5ul;
constant ulong IG_DELETE_DEPENDENCY_WORDS = 2ul;
constant ulong IG_DELETE_CONTROL_WORDS = 32ul;
constant ulong IG_DELETE_MAX_DIMENSION = 0xfffffffful;
constant ulong IG_DELETE_NULL_ROW = 0xfffffffful;
constant ulong IG_DELETE_BINDING_NODE = 1ul;
constant ulong IG_DELETE_BINDING_RELATIONSHIP = 2ul;
constant ulong IG_DELETE_NODE_END = 0xfffffffffffffffful;
constant ulong IG_DELETE_PROPERTY_ABSENT = 0ul;
constant ulong IG_DELETE_PROPERTY_INTEGER = 1ul;
constant ulong IG_DELETE_PROPERTY_INCOMPATIBLE = 2ul;
constant ulong IG_DELETE_SOURCE_NONE = 0ul;
constant ulong IG_DELETE_SOURCE_CONSTANT = 1ul;
constant ulong IG_DELETE_SOURCE_PROPERTY = 2ul;
constant ulong IG_DELETE_SOURCE_AGGREGATE = 3ul;
constant ulong IG_DELETE_SOURCE_NULL_ENTITY = 4ul;
constant ulong IG_DELETE_SOURCE_RELATIONSHIP_TYPE = 5ul;
constant ulong IG_DELETE_STATUS_CORRUPT = 1ul;
constant ulong IG_DELETE_STATUS_CAPACITY = 2ul;
constant ulong IG_DELETE_STATUS_CONNECTED = 3ul;
constant ulong IG_DELETE_STATUS_TYPE = 4ul;
constant ulong IG_DELETE_STATUS_OVERFLOW = 5ul;
constant ulong IG_DELETE_SEALED = 0x5345414c45444445ul;
constant ulong IG_DELETE_VARIABLE_PATH_ABI = 0x0000000647435650ul;
constant ulong IG_DELETE_VARIABLE_PATH_SUCCESS = 1ul | (3ul << 32u);

struct DeleteArgs {
    ulong execution_high;
    ulong execution_low;
    ulong project_high;
    ulong project_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong fingerprint_0;
    ulong fingerprint_1;
    ulong fingerprint_2;
    ulong fingerprint_3;
    ulong scratch_bytes;
    ulong graph_word_count;
    ulong program_word_count;
    ulong output_word_count;
    ulong node_count;
    ulong edge_count;
    ulong label_lane_count;
    ulong node_property_count;
    ulong edge_property_count;
    ulong node_active_base;
    ulong node_layer_base;
    ulong node_id_base;
    ulong label_base;
    ulong edge_active_base;
    ulong edge_layer_base;
    ulong edge_type_base;
    ulong edge_id_base;
    ulong outgoing_offset_base;
    ulong outgoing_neighbor_base;
    ulong outgoing_edge_base;
    ulong outgoing_count;
    ulong incoming_offset_base;
    ulong incoming_neighbor_base;
    ulong incoming_edge_base;
    ulong incoming_count;
    ulong node_property_value_base;
    ulong node_property_validity_base;
    ulong edge_property_value_base;
    ulong edge_property_validity_base;
    ulong filter_count;
    ulong command_count;
    ulong stage_count;
    ulong receipt_count;
    ulong selector_capacity;
    ulong intent_capacity;
    ulong dependency_capacity;
    ulong final_capacity;
    ulong receipt_base;
    ulong command_attempt_base;
    ulong intent_base;
