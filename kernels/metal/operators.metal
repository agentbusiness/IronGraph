kernel void ig_segmented_graph_source_program(
    device const ulong* nullable [[buffer(0)]],
    device const ulong* node_ids [[buffer(1)]],
    device const ulong* edge_ids [[buffer(2)]],
    device const ulong* program [[buffer(3)]],
    device ulong* source_header [[buffer(4)]],
    device ulong* source_cells [[buffer(5)]],
    device uchar* source_arena [[buffer(6)]],
    device ulong* dependencies [[buffer(7)]],
    device ulong* generic_receipts [[buffer(8)]],
    device atomic_uint* graph_control [[buffer(9)]],
    device ulong* output_header [[buffer(10)]],
    device ulong* output_cells [[buffer(11)]],
    device uchar* output_arena [[buffer(12)]],
    device ulong* outer_receipts [[buffer(13)]],
    constant IgSegmentedGraphArgs& args [[buffer(14)]],
    device const uint* grouping_columns [[buffer(15)]],
    device const uint* aggregate_descriptors [[buffer(16)]],
    device uchar* property_presence [[buffer(17)]],
    device const uint* property_offsets [[buffer(20)]],
    device const uchar* property_bytes [[buffer(21)]],
    device const uchar* property_validity [[buffer(22)]],
    constant IgSegmentedPropertyValueArgs& property_args [[buffer(23)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    if (args.output_header_words < IG_SEGMENTED_GRAPH_OUTPUT_HEADER_WORDS) return;
    for (ulong word = 0ul; word < args.source_header_words; ++word) source_header[word] = 0ul;
    for (ulong word = 0ul; word < args.source_cell_words; ++word) source_cells[word] = 0ul;
    for (ulong byte = 0ul; byte < args.source_arena_storage_bytes; ++byte) {
        source_arena[byte] = 0u;
    }
    for (ulong word = 0ul; word < args.dependency_words; ++word) dependencies[word] = 0ul;
    for (ulong word = 0ul; word < args.generic_receipt_words; ++word) {
        generic_receipts[word] = 0ul;
    }
    for (ulong byte = 0ul; byte < args.property_presence_bytes; ++byte) {
        property_presence[byte] = 0u;
    }
    uint validation = atomic_load_explicit(&graph_control[0], memory_order_relaxed);
    uint execution_phase = atomic_load_explicit(&graph_control[1], memory_order_relaxed);
    uint validation_phase = atomic_load_explicit(&graph_control[7], memory_order_relaxed);
    if (validation == IG_SEGMENTED_STATUS_NOT_EXECUTED
            && (execution_phase != IG_SEGMENTED_PHASE_NOT_STARTED
                || validation_phase != IG_SEGMENTED_GRAPH_VALIDATION_RECEIPTS)) {
        validation = IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
        atomic_store_explicit(&graph_control[0], validation, memory_order_relaxed);
        atomic_store_explicit(&graph_control[1], IG_SEGMENTED_PHASE_FAILED, memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[7], IG_SEGMENTED_GRAPH_VALIDATION_FAILED, memory_order_relaxed);
    }
    if (validation != IG_SEGMENTED_STATUS_NOT_EXECUTED) {
        ig_segmented_graph_fail(output_header, validation);
        return;
    }

    ulong binding_count = program[4];
    ulong aggregate_count = program[6];
    ulong receipt_count = program[14];
    ulong source_capacity = program[17];
    ulong source_columns = program[18];
    ulong source_arena_capacity = program[20];
    ulong actual_rows = program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
        ? nullable[18] : nullable[21];
    ulong dependency_count = program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
        ? 0ul : actual_rows * binding_count;
    ulong property_value_base = ig_segmented_property_value_base(program);
    bool property_value_source = program[53]
        == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE;
    if (property_value_source) {
        ulong property_kind = program[property_value_base + 3ul];
        ulong expected_rows = property_kind == 1ul ? program[29] : program[30];
        if (property_args.offset_storage_elems != expected_rows + 1ul
                || property_args.validity_storage_elems != max(expected_rows, 1ul)
                || property_args.entity_rows != expected_rows
                || property_args.maximum_bytes != program[property_value_base + 11ul]
                || property_args.mode != program[property_value_base + 2ul]
                || property_args.byte_storage_elems > expected_rows * property_args.maximum_bytes
                || program[property_value_base] != IG_SEGMENTED_PROPERTY_VALUE_MAGIC
                || program[property_value_base + 1ul]
                    != IG_SEGMENTED_PROPERTY_VALUE_VERSION) {
            ig_segmented_graph_fail(
                output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
            return;
        }
    } else if (property_args.entity_rows != 0ul || property_args.mode != 0ul) {
        ig_segmented_graph_fail(
            output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
        return;
    }

    // Seed both receipt packets while they are still pending.  Completion is transactional in the
    // final graph kernel; no source or aggregate receipt becomes visible on a later failure.
    for (ulong receipt = 0ul; receipt < receipt_count; ++receipt) {
        ulong descriptor = program[50]
            + receipt * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS;
        ulong record = receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        outer_receipts[record] = program[descriptor];
        outer_receipts[record + 1ul] = program[descriptor + 1ul];
    }
    for (ulong receipt = 0ul; receipt < aggregate_count + 1ul; ++receipt) {
        ulong seed = program[51] + receipt * 2ul;
        ulong record = receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        generic_receipts[record] = program[seed];
        generic_receipts[record + 1ul] = program[seed + 1ul];
    }

    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER) {
        ulong unit_kind = ig_segmented_unit_kind(program);
        ulong pre_stage_count = ig_segmented_unit_inner_stage_count(program);
        ulong total_pre_stage_count = ig_segmented_graph_pre_stage_count(program);
        ulong maximum_list_items = ig_segmented_unit_maximum_list_items(program);
        ulong inner_header_base = program[51] + (aggregate_count + 1ul) * 2ul;
        ulong inner_descriptor_base = inner_header_base
            + IG_SEGMENTED_UNIT_INNER_HEADER_WORDS;
        ulong inner_receipt_base = IG_SEGMENTED_UNIT_QUANTIFIER_HEADER_WORDS;
        ulong prior_rows = 1ul;
        for (ulong receipt = 0ul; receipt < pre_stage_count + 1ul; ++receipt) {
            ulong descriptor = inner_descriptor_base
                + receipt * IG_SEGMENTED_UNIT_INNER_RECEIPT_DESCRIPTOR_WORDS;
            ulong record = inner_receipt_base
                + receipt * IG_SEGMENTED_UNIT_QUANTIFIER_RECEIPT_WORDS;
            ulong input_rows = nullable[record + 6ul];
            ulong output_rows = nullable[record + 7ul];
            if (nullable[record] != program[31]
                    || nullable[record + 1ul] != program[32]
                    || nullable[record + 2ul] != program[descriptor]
                    || nullable[record + 3ul] != program[descriptor + 1ul]
                    || nullable[record + 4ul] != program[descriptor + 2ul]
                    || nullable[record + 5ul] != program[descriptor + 3ul]
                    || nullable[record + 8ul] != IG_SEGMENTED_UNIT_QUANTIFIER_OUTPUT_VERSION
                    || input_rows != prior_rows) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                return;
            }
            bool exact = false;
            if (unit_kind == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY) {
                if (receipt == 0ul || receipt == 1ul) {
                    exact = input_rows == 1ul && output_rows == 1ul;
                } else if (receipt == 2ul) {
                    exact = input_rows == 1ul && output_rows == actual_rows
                        && actual_rows == program[17]
                        && actual_rows <= maximum_list_items;
                } else {
                    exact = input_rows == actual_rows && output_rows == actual_rows;
                }
            } else if (receipt == 0ul) {
                exact = output_rows == input_rows;
            } else if (receipt < pre_stage_count) {
                ulong maximum_rows = 0ul;
                exact = ig_segmented_graph_product(
                        input_rows, maximum_list_items, maximum_rows)
                    && output_rows <= maximum_rows;
            } else {
                exact = output_rows == input_rows && output_rows == actual_rows;
            }
            if (!exact || input_rows > 0xfffffffful || output_rows > 0xfffffffful) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                return;
            }
            if (receipt < pre_stage_count) {
                ulong outer_record = (receipt + 1ul) * IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
                outer_receipts[outer_record + 7ul] = input_rows | (output_rows << 32u);
            }
            prior_rows = output_rows;
        }
        if (unit_kind == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY) {
            ulong order_record = total_pre_stage_count
                * IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
            outer_receipts[order_record + 7ul] = actual_rows | (actual_rows << 32u);
        }

        ulong root_base = IG_SEGMENTED_UNIT_QUANTIFIER_HEADER_WORDS
            + (pre_stage_count + 1ul) * IG_SEGMENTED_UNIT_QUANTIFIER_RECEIPT_WORDS;
        ulong root_capacity = source_capacity * binding_count;
        ulong cell_base = root_base + root_capacity;
        ulong cell_count = nullable[26];
        ulong item_base = cell_base
            + nullable[29] * IG_SEGMENTED_UNIT_QUANTIFIER_VALUE_WORDS;
        ulong byte_base = item_base + nullable[30];
        ulong source_arena_capacity = program[20];
        ulong arena_cursor = 0ul;
        device const uchar* nullable_bytes =
            reinterpret_cast<device const uchar*>(nullable);
        for (ulong row = 0ul; row < actual_rows; ++row) {
            for (ulong binding = 0ul; binding < binding_count; ++binding) {
                ulong handle = nullable[root_base + row * binding_count + binding];
                if (handle >= cell_count) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                ulong cell = cell_base
                    + handle * IG_SEGMENTED_UNIT_QUANTIFIER_VALUE_WORDS;
                ulong expected_type = program[program[41]
                    + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS + 3ul];
                ulong type = nullable[cell];
                ulong payload = nullable[cell + 1ul];
                ulong auxiliary = nullable[cell + 2ul];
                ulong provenance = nullable[cell + 3ul];
                bool scalar_valid = type == expected_type
                    && ((type == IG_SEGMENTED_UNIT_QUANTIFIER_BOOLEAN
                            && payload <= 1ul && auxiliary == 0ul && provenance == 0ul)
                        || (type == IG_SEGMENTED_UNIT_QUANTIFIER_INTEGER
                            && auxiliary == 0ul && provenance == 0ul)
                        || (type == IG_SEGMENTED_UNIT_QUANTIFIER_FLOAT
                            && auxiliary == 0ul && provenance == 0ul
                            && ig_segmented_f64_finite(payload))
                        || (type == IG_SEGMENTED_UNIT_QUANTIFIER_STRING
                            && provenance == 2ul
                            && ig_segmented_graph_range(payload, auxiliary, nullable[28])
                            && ig_segmented_graph_range(
                                arena_cursor, auxiliary, source_arena_capacity)));
                if (!scalar_valid) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                IgSegmentedCellValue value;
                value.tag = uint(type);
                value.payload = payload;
                value.auxiliary = auxiliary;
                if (type == IG_SEGMENTED_UNIT_QUANTIFIER_STRING) {
                    value.payload = arena_cursor;
                    ulong source = byte_base * 8ul + payload;
                    for (ulong byte = 0ul; byte < auxiliary; ++byte) {
                        source_arena[arena_cursor + byte] = nullable_bytes[source + byte];
                    }
                    arena_cursor += auxiliary;
                }
                ig_segmented_write_cell(
                    source_cells, uint(row * source_columns + binding), value);
                ulong reduction_binding = unit_kind == IG_SEGMENTED_UNIT_INDEXED_COUNT
                    ? 1ul : 0ul;
                if (binding == reduction_binding) {
                    ig_segmented_write_cell(
                        source_cells,
                        uint(row * source_columns + binding_count),
                        value);
                }
            }
        }
        if (unit_kind == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY) {
            // Stable insertion sort is private to the source adapter. Scalar domains order by the
            // projected value; the integer-list route never publishes that structural value and
            // instead orders by its device-computed comparison rank. Equal values/ranks retain
            // their original UNWIND position, and every swap carries the whole source row.
            ulong ordering_column = ig_segmented_unit_integer_list_order(program) ? 0ul : 1ul;
            for (ulong position = 1ul; position < actual_rows; ++position) {
                ulong destination = position;
                while (destination != 0ul) {
                    IgSegmentedCellValue candidate = ig_segmented_input_cell(
                        source_cells,
                        uint(destination * source_columns + ordering_column));
                    IgSegmentedCellValue prior = ig_segmented_input_cell(
                        source_cells,
                        uint((destination - 1ul) * source_columns + ordering_column));
                    if (ig_segmented_key_order(source_arena, candidate, prior) >= 0) break;
                    for (ulong column = 0ul; column < source_columns; ++column) {
                        ulong candidate_cell = destination * source_columns + column;
                        ulong prior_cell = (destination - 1ul) * source_columns + column;
                        IgSegmentedCellValue candidate_value = ig_segmented_input_cell(
                            source_cells, uint(candidate_cell));
                        IgSegmentedCellValue prior_value = ig_segmented_input_cell(
                            source_cells, uint(prior_cell));
                        ig_segmented_write_cell(
                            source_cells, uint(candidate_cell), prior_value);
                        ig_segmented_write_cell(
                            source_cells, uint(prior_cell), candidate_value);
                    }
                    --destination;
                }
            }
        }
        for (ulong row = actual_rows; row < source_capacity; ++row) {
            for (ulong binding = 0ul; binding < binding_count; ++binding) {
                ulong descriptor = program[41]
                    + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
                IgSegmentedCellValue value = ig_segmented_null_cell();
                if (actual_rows != 0ul && program[descriptor + 10ul] != 0ul) {
                    value = ig_segmented_input_cell(source_cells, uint(binding));
                }
                ig_segmented_write_cell(
                    source_cells, uint(row * source_columns + binding), value);
            }
        }
        IgSegmentedCellValue cover;
        cover.tag = IG_SEGMENTED_VALUE_BYTES;
        cover.payload = arena_cursor;
        cover.auxiliary = source_arena_capacity - arena_cursor;
        ig_segmented_write_cell(
            source_cells,
            uint((source_capacity - 1ul) * source_columns
                + source_columns - 1ul),
            cover);

        source_header[0] = IG_SEGMENTED_AGGREGATION_ABI_WORD;
        source_header[1] = 0ul;
        source_header[2] = program[2];
        source_header[3] = program[3];
        source_header[4] = source_capacity | (source_columns << 32u);
        source_header[5] = program[19] | (source_arena_capacity << 32u);
        source_header[6] = program[5] | (aggregate_count << 16u)
            | ((aggregate_count + 1ul) << 32u);
        source_header[7] = program[23] | (program[21] << 32u);
        source_header[8] = 0ul;
        for (ulong lane = 0ul; lane < 4ul; ++lane) {
            source_header[9ul + lane] = program[37ul + lane];
        }
        output_header[6] = actual_rows;
        output_header[7] = binding_count;
        atomic_store_explicit(
            &graph_control[0], IG_SEGMENTED_STATUS_SUCCESS, memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[1], IG_SEGMENTED_PHASE_COMPLETE, memory_order_relaxed);
        atomic_store_explicit(&graph_control[2], uint(actual_rows), memory_order_relaxed);
        atomic_store_explicit(&graph_control[3], 0u, memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[4], uint(source_capacity), memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[5], uint(source_arena_capacity), memory_order_relaxed);
        atomic_store_explicit(&graph_control[6], uint(binding_count), memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[7], IG_SEGMENTED_GRAPH_CONTROL_READY, memory_order_relaxed);
        return;
    }

    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS) {
        atomic_store_explicit(
            &graph_control[0], IG_SEGMENTED_STATUS_NOT_EXECUTED, memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[1], IG_SEGMENTED_PHASE_NOT_STARTED, memory_order_relaxed);
        atomic_store_explicit(&graph_control[2], 0u, memory_order_relaxed);
        atomic_store_explicit(&graph_control[3], 0u, memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[4], uint(source_capacity), memory_order_relaxed);
        atomic_store_explicit(&graph_control[5], 0u, memory_order_relaxed);
        atomic_store_explicit(&graph_control[6], 0u, memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[7], IG_SEGMENTED_GRAPH_PROPERTY_KEYS_READY, memory_order_relaxed);
        return;
    }

    ulong arena_cursor = 0ul;
    device const uchar* nullable_bytes = reinterpret_cast<device const uchar*>(nullable);
    for (ulong row = 0ul; row < actual_rows; ++row) {
        for (ulong binding = 0ul; binding < binding_count; ++binding) {
            ulong descriptor = program[41]
                + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
            ulong kind = program[descriptor + 2ul];
            ulong type = program[descriptor + 3ul];
            ulong dense_base = program[descriptor + 4ul];
            uint dense = ig_segmented_graph_read_u32_le(
                nullable_bytes, dense_base + row * 4ul);
            ulong graph_rows = kind == 1ul ? program[29] : program[30];
            IgSegmentedCellValue value = ig_segmented_null_cell();
            ulong canonical_id = 0ul;
            if (dense != uint(IG_NULLABLE_RELATION_NULL_ROW)) {
                if (ulong(dense) >= graph_rows) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                canonical_id = kind == 1ul ? node_ids[dense] : edge_ids[dense];
                ulong dependency = (row * binding_count + binding) * 2ul;
                dependencies[dependency] = kind;
                dependencies[dependency + 1ul] = canonical_id;
            }
            if (type == IG_NULLABLE_OUTPUT_ENTITY) {
                if (dense != uint(IG_NULLABLE_RELATION_NULL_ROW)) {
                    value.tag = kind == 1ul
                        ? IG_SEGMENTED_VALUE_NODE : IG_SEGMENTED_VALUE_RELATIONSHIP;
                    value.payload = canonical_id;
                }
            } else if (type == IG_NULLABLE_OUTPUT_INTEGER_PROPERTY
                    || type == IG_NULLABLE_OUTPUT_FLOAT_PROPERTY) {
                ulong validity = program[descriptor + 7ul];
                uchar valid = nullable_bytes[validity + row];
                if (valid > 1u || (dense == uint(IG_NULLABLE_RELATION_NULL_ROW) && valid != 0u)) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                if (valid != 0u) {
                    value.tag = type == IG_NULLABLE_OUTPUT_INTEGER_PROPERTY
                        ? IG_SEGMENTED_VALUE_INTEGER : IG_SEGMENTED_VALUE_FLOAT;
                    value.payload = ig_segmented_graph_read_u64_le(
                        nullable_bytes, program[descriptor + 5ul] + row * 8ul);
                    if (value.tag == IG_SEGMENTED_VALUE_FLOAT
                            && (ig_scalar_program_f64_is_nan(value.payload)
                                || ig_scalar_program_f64_is_infinite(value.payload))) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                        return;
                    }
                }
            } else if (type == IG_NULLABLE_OUTPUT_STRING_PROPERTY) {
                ulong validity = program[descriptor + 7ul];
                uchar valid = nullable_bytes[validity + row];
                if (valid > 1u || (dense == uint(IG_NULLABLE_RELATION_NULL_ROW) && valid != 0u)) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                ulong offsets = program[descriptor + 5ul];
                uint start = ig_segmented_graph_read_u32_le(
                    nullable_bytes, offsets + row * 4ul);
                uint end = ig_segmented_graph_read_u32_le(
                    nullable_bytes, offsets + (row + 1ul) * 4ul);
                ulong maximum_bytes = program[descriptor + 9ul];
                ulong column_capacity = source_capacity * maximum_bytes;
                if (end < start || ulong(end) > column_capacity
                        || (valid == 0u && end != start)
                        || !ig_segmented_graph_range(
                            arena_cursor, ulong(end - start), source_arena_capacity)) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                if (valid != 0u) {
                    ulong bytes = program[descriptor + 6ul];
                    value.tag = IG_SEGMENTED_VALUE_STRING;
                    value.payload = arena_cursor;
                    value.auxiliary = ulong(end - start);
                    for (uint byte = start; byte < end; ++byte) {
                        source_arena[arena_cursor++] = nullable_bytes[bytes + ulong(byte)];
                    }
                }
            }
            ulong cell = row * source_columns + binding;
            ig_segmented_write_cell(source_cells, uint(cell), value);
        }
        if (property_value_source) {
            ulong binding = program[property_value_base + 4ul];
            ulong descriptor = program[41]
                + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
            ulong dense_base = program[descriptor + 4ul];
            uint dense = ig_segmented_graph_read_u32_le(
                nullable_bytes, dense_base + row * 4ul);
            ulong property_column = program[property_value_base + 7ul];
            IgSegmentedCellValue value = ig_segmented_null_cell();
            bool present = false;
            ulong start = 0ul;
            ulong length = 0ul;
            if (dense != uint(IG_NULLABLE_RELATION_NULL_ROW)) {
                if (ulong(dense) >= property_args.entity_rows) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                uchar valid = property_validity[dense];
                start = ulong(property_offsets[dense]);
                ulong end = ulong(property_offsets[ulong(dense) + 1ul]);
                if (valid > 1u || end < start
                        || end > property_args.byte_storage_elems
                        || end - start > property_args.maximum_bytes
                        || (valid == 0u && end != start)) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                present = valid != 0u;
                length = end - start;
            }
            if (present) {
                if (length < 10ul || property_bytes[start] != 3u
                        || property_bytes[start + 1ul] != 13u
                        || !ig_segmented_graph_range(
                            arena_cursor, length, source_arena_capacity)) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                value.tag = IG_SEGMENTED_VALUE_BYTES;
                value.payload = arena_cursor;
                value.auxiliary = length;
                for (ulong byte = 0ul; byte < length; ++byte) {
                    source_arena[arena_cursor + byte] = property_bytes[start + byte];
                }
                arena_cursor += length;
            } else if (property_args.mode
                    == IG_SEGMENTED_PROPERTY_VALUE_STRUCTURAL_DISTINCT) {
                if (!ig_segmented_graph_range(arena_cursor, 1ul, source_arena_capacity)) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
                    return;
                }
                value.tag = IG_SEGMENTED_VALUE_BYTES;
                value.payload = arena_cursor;
                value.auxiliary = 1ul;
                source_arena[arena_cursor++] = 0u;
            }
            ig_segmented_write_cell(
                source_cells,
                uint(row * source_columns + property_column),
                value);
        }
        for (ulong key = 0ul; key < program[5]; ++key) {
            ulong encoded_group = program[program[42] + key];
            ulong expression_count = encoded_group >> 48ul;
            if (expression_count == 0ul) continue;
            ulong expression_start = ulong(uint(encoded_group >> 32ul) & 0xffffu);
            ulong output_column = ulong(uint(encoded_group));
            IgSegmentedCellValue value;
            uint status = ig_segmented_graph_evaluate_expression(
                program,
                source_arena,
                expression_start,
                expression_count,
                source_cells,
                row,
                source_columns,
                source_cells,
                program[19],
                value);
            if (status != 0u || value.tag > IG_SEGMENTED_VALUE_FLOAT) {
                ig_segmented_graph_fail(
                    output_header,
                    status != 0u ? status : IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE);
                return;
            }
            ig_segmented_write_cell(
                source_cells, uint(row * source_columns + output_column), value);
        }
        for (ulong aggregate = 0ul; aggregate < aggregate_count; ++aggregate) {
            ulong descriptor = program[43]
                + aggregate * IG_SEGMENTED_GRAPH_AGGREGATE_WORDS;
            ulong encoded_source = program[descriptor + 3ul];
            IgSegmentedCellValue value = ig_segmented_null_cell();
            if (encoded_source == ~0ul) {
                value.tag = IG_SEGMENTED_VALUE_INTEGER;
                value.payload = 1ul;
            } else {
                ulong expression_count = ulong(uint(encoded_source >> 32ul));
                if (expression_count == 0ul) {
                    ulong source = ulong(uint(encoded_source));
                    value = ig_segmented_input_cell(
                        source_cells, uint(row * source_columns + source));
                } else {
                    ulong expression_start = ulong(uint(encoded_source));
                    uint status = ig_segmented_graph_evaluate_expression(
                        program,
                        source_arena,
                        expression_start,
                        expression_count,
                        source_cells,
                        row,
                        source_columns,
                        source_cells,
                        program[19],
                        value);
                    if (status != 0u || value.tag > IG_SEGMENTED_VALUE_FLOAT) {
                        ig_segmented_graph_fail(
                            output_header,
                            status != 0u
                                ? status : IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE);
                        return;
                    }
                }
                if (value.tag == IG_SEGMENTED_VALUE_STRING
                        || value.tag == IG_SEGMENTED_VALUE_BYTES) {
                    ulong length = value.auxiliary;
                    ulong start = value.payload;
                    if (!ig_segmented_graph_range(
                            arena_cursor, length, source_arena_capacity)) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
                        return;
                    }
                    value.payload = arena_cursor;
                    for (ulong byte = 0ul; byte < length; ++byte) {
                        source_arena[arena_cursor + byte] = source_arena[start + byte];
                    }
                    arena_cursor += length;
                }
            }
            ig_segmented_write_cell(
                source_cells,
                uint(row * source_columns + program[descriptor + 1ul]),
                value);
        }
    }

    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH) {
        ulong group_count = 0ul;
        for (ulong seed = 0ul; seed < actual_rows; ++seed) {
            IgSegmentedCellValue seed_left = ig_segmented_input_cell(
                source_cells, uint(seed * source_columns));
            IgSegmentedCellValue seed_right = ig_segmented_input_cell(
                source_cells, uint(seed * source_columns + 1ul));
            IgSegmentedCellValue seed_left_relationship = ig_segmented_input_cell(
                source_cells, uint(seed * source_columns + 2ul));
            IgSegmentedCellValue seed_right_relationship = ig_segmented_input_cell(
                source_cells, uint(seed * source_columns + 3ul));
            if (seed_left.tag != IG_SEGMENTED_VALUE_NODE
                    || seed_right.tag != IG_SEGMENTED_VALUE_NODE
                    || seed_left_relationship.tag != IG_SEGMENTED_VALUE_RELATIONSHIP
                    || seed_right_relationship.tag != IG_SEGMENTED_VALUE_RELATIONSHIP) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                return;
            }
            bool first_group_row = true;
            for (ulong prior = 0ul; prior < seed; ++prior) {
                IgSegmentedCellValue prior_left = ig_segmented_input_cell(
                    source_cells, uint(prior * source_columns));
                IgSegmentedCellValue prior_right = ig_segmented_input_cell(
                    source_cells, uint(prior * source_columns + 1ul));
                if (prior_left.tag == IG_SEGMENTED_VALUE_NODE
                        && prior_right.tag == IG_SEGMENTED_VALUE_NODE
                        && prior_left.payload == seed_left.payload
                        && prior_right.payload == seed_right.payload) {
                    first_group_row = false;
                    break;
                }
            }
            if (!first_group_row) continue;
            ++group_count;

            ulong left_distinct = 0ul;
            ulong right_distinct = 0ul;
            for (ulong candidate = 0ul; candidate < actual_rows; ++candidate) {
                IgSegmentedCellValue candidate_left = ig_segmented_input_cell(
                    source_cells, uint(candidate * source_columns));
                IgSegmentedCellValue candidate_right = ig_segmented_input_cell(
                    source_cells, uint(candidate * source_columns + 1ul));
                if (candidate_left.tag != IG_SEGMENTED_VALUE_NODE
                        || candidate_right.tag != IG_SEGMENTED_VALUE_NODE
                        || candidate_left.payload != seed_left.payload
                        || candidate_right.payload != seed_right.payload) continue;
                IgSegmentedCellValue candidate_left_relationship = ig_segmented_input_cell(
                    source_cells, uint(candidate * source_columns + 2ul));
                IgSegmentedCellValue candidate_right_relationship = ig_segmented_input_cell(
                    source_cells, uint(candidate * source_columns + 3ul));
                if (candidate_left_relationship.tag != IG_SEGMENTED_VALUE_RELATIONSHIP
                        || candidate_right_relationship.tag
                            != IG_SEGMENTED_VALUE_RELATIONSHIP) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
                bool first_left = true;
                bool first_right = true;
                for (ulong prior = 0ul; prior < candidate; ++prior) {
                    IgSegmentedCellValue prior_left = ig_segmented_input_cell(
                        source_cells, uint(prior * source_columns));
                    IgSegmentedCellValue prior_right = ig_segmented_input_cell(
                        source_cells, uint(prior * source_columns + 1ul));
                    if (prior_left.tag != IG_SEGMENTED_VALUE_NODE
                            || prior_right.tag != IG_SEGMENTED_VALUE_NODE
                            || prior_left.payload != seed_left.payload
                            || prior_right.payload != seed_right.payload) continue;
                    IgSegmentedCellValue prior_left_relationship = ig_segmented_input_cell(
                        source_cells, uint(prior * source_columns + 2ul));
                    IgSegmentedCellValue prior_right_relationship = ig_segmented_input_cell(
                        source_cells, uint(prior * source_columns + 3ul));
                    first_left = first_left
                        && prior_left_relationship.tag == IG_SEGMENTED_VALUE_RELATIONSHIP
                        && prior_left_relationship.payload
                            != candidate_left_relationship.payload;
                    first_right = first_right
                        && prior_right_relationship.tag == IG_SEGMENTED_VALUE_RELATIONSHIP
                        && prior_right_relationship.payload
                            != candidate_right_relationship.payload;
                }
                left_distinct += first_left ? 1ul : 0ul;
                right_distinct += first_right ? 1ul : 0ul;
            }
            if (left_distinct == 0ul || right_distinct == 0ul
                    || left_distinct > 0x7ffffffffffffffful
                    || right_distinct > 0x7ffffffffffffffful) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                return;
            }

            IgSegmentedCellValue left_count;
            left_count.tag = IG_SEGMENTED_VALUE_INTEGER;
            left_count.payload = left_distinct;
            left_count.auxiliary = 0ul;
            IgSegmentedCellValue right_count;
            right_count.tag = IG_SEGMENTED_VALUE_INTEGER;
            right_count.payload = right_distinct;
            right_count.auxiliary = 0ul;
            IgSegmentedCellValue one;
            one.tag = IG_SEGMENTED_VALUE_INTEGER;
            one.payload = 1ul;
            one.auxiliary = 0ul;
            IgSegmentedCellValue zero;
            zero.tag = IG_SEGMENTED_VALUE_INTEGER;
            zero.payload = 0ul;
            zero.auxiliary = 0ul;
            for (ulong member = 0ul; member < actual_rows; ++member) {
                IgSegmentedCellValue member_left = ig_segmented_input_cell(
                    source_cells, uint(member * source_columns));
                IgSegmentedCellValue member_right = ig_segmented_input_cell(
                    source_cells, uint(member * source_columns + 1ul));
                if (member_left.payload != seed_left.payload
                        || member_right.payload != seed_right.payload) continue;
                IgSegmentedCellValue left_property = ig_segmented_input_cell(
                    source_cells, uint(member * source_columns + 4ul));
                IgSegmentedCellValue right_property = ig_segmented_input_cell(
                    source_cells, uint(member * source_columns + 5ul));
                IgSegmentedCellValue contribution = ig_segmented_null_cell();
                if (left_property.tag != IG_SEGMENTED_VALUE_NULL
                        && right_property.tag != IG_SEGMENTED_VALUE_NULL) {
                    if (left_property.tag != IG_SEGMENTED_VALUE_INTEGER
                            || right_property.tag != IG_SEGMENTED_VALUE_INTEGER) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE);
                        return;
                    }
                    IgSegmentedCellValue left_quotient;
                    IgSegmentedCellValue right_quotient;
                    IgSegmentedCellValue difference;
                    IgSegmentedCellValue absolute_difference;
                    IgSegmentedCellValue weight;
                    IgSegmentedCellValue property_sum;
                    IgSegmentedCellValue numerator;
                    IgSegmentedCellValue denominator;
                    uint status = ig_segmented_graph_numeric_binary(
                        left_property,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_DIVIDE,
                        left_count,
                        left_quotient);
                    if (status == 0u) status = ig_segmented_graph_numeric_binary(
                        right_property,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_DIVIDE,
                        right_count,
                        right_quotient);
                    if (status == 0u) status = ig_segmented_graph_numeric_binary(
                        left_quotient,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_SUBTRACT,
                        right_quotient,
                        difference);
                    absolute_difference = difference;
                    if (status == 0u && as_type<long>(difference.payload) < 0L) {
                        status = ig_segmented_graph_numeric_binary(
                            zero,
                            IG_SEGMENTED_GRAPH_INSTRUCTION_SUBTRACT,
                            difference,
                            absolute_difference);
                    }
                    if (status == 0u) status = ig_segmented_graph_numeric_binary(
                        one,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_SUBTRACT,
                        absolute_difference,
                        weight);
                    if (status == 0u) status = ig_segmented_graph_numeric_binary(
                        left_property,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_ADD,
                        right_property,
                        property_sum);
                    if (status == 0u) status = ig_segmented_graph_numeric_binary(
                        weight,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_MULTIPLY,
                        property_sum,
                        numerator);
                    if (status == 0u) status = ig_segmented_graph_numeric_binary(
                        left_count,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_ADD,
                        right_count,
                        denominator);
                    if (status == 0u) status = ig_segmented_graph_numeric_binary(
                        numerator,
                        IG_SEGMENTED_GRAPH_INSTRUCTION_DIVIDE,
                        denominator,
                        contribution);
                    if (status != 0u) {
                        ig_segmented_graph_fail(output_header, status);
                        return;
                    }
                }
                ig_segmented_write_cell(
                    source_cells, uint(member * source_columns + 6ul), contribution);
            }
        }
        ulong aggregate_cardinality = actual_rows | (group_count << 32u);
        for (ulong receipt = 1ul; receipt <= 4ul; ++receipt) {
            outer_receipts[receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS + 7ul]
                = aggregate_cardinality;
        }
        outer_receipts[5ul * IG_SEGMENTED_GRAPH_RECEIPT_WORDS + 7ul]
            = group_count | (group_count << 32u);
        outer_receipts[6ul * IG_SEGMENTED_GRAPH_RECEIPT_WORDS + 7ul]
            = group_count | (actual_rows << 32u);
    }

    if (program[54] != 0ul
            && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC) {
        ulong pre_order_base = program[54];
        ulong item_start = program[pre_order_base + 2ul];
        ulong item_count = program[pre_order_base + 3ul];
        for (ulong position = 1ul; position < actual_rows; ++position) {
            ulong destination = position;
            while (destination != 0ul) {
                int ordering = 0;
                for (ulong item = 0ul; item < item_count; ++item) {
                    ulong descriptor = program[47]
                        + (item_start + item) * IG_SEGMENTED_GRAPH_ORDER_WORDS;
                    IgSegmentedCellValue left;
                    IgSegmentedCellValue right;
                    uint left_status = ig_segmented_graph_evaluate_expression(
                        program,
                        source_arena,
                        program[descriptor],
                        program[descriptor + 1ul],
                        source_cells,
                        destination,
                        source_columns,
                        source_cells,
                        program[19],
                        left);
                    uint right_status = ig_segmented_graph_evaluate_expression(
                        program,
                        source_arena,
                        program[descriptor],
                        program[descriptor + 1ul],
                        source_cells,
                        destination - 1ul,
                        source_columns,
                        source_cells,
                        program[19],
                        right);
                    if (left_status != 0u || right_status != 0u
                            || left.tag == IG_SEGMENTED_VALUE_LIST
                            || right.tag == IG_SEGMENTED_VALUE_LIST
                            || !ig_segmented_graph_scalar_cell_valid(left, source_arena_capacity)
                            || !ig_segmented_graph_scalar_cell_valid(right, source_arena_capacity)) {
                        ig_segmented_graph_fail(
                            output_header,
                            left_status != 0u ? left_status
                                : right_status != 0u ? right_status
                                : IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE);
                        return;
                    }
                    ordering = ig_segmented_graph_order_cells(
                        program,
                        descriptor,
                        source_arena,
                        left,
                        right,
                        program[descriptor + 2ul]);
                    if (ordering != 0) break;
                }
                if (ordering >= 0) break;
                for (ulong column = 0ul; column < source_columns; ++column) {
                    ulong left_cell = destination * source_columns + column;
                    ulong right_cell = (destination - 1ul) * source_columns + column;
                    IgSegmentedCellValue left = ig_segmented_input_cell(
                        source_cells, uint(left_cell));
                    IgSegmentedCellValue right = ig_segmented_input_cell(
                        source_cells, uint(right_cell));
                    ig_segmented_write_cell(source_cells, uint(left_cell), right);
                    ig_segmented_write_cell(source_cells, uint(right_cell), left);
                }
                for (ulong binding = 0ul; binding < binding_count; ++binding) {
                    ulong left_record = (destination * binding_count + binding) * 2ul;
                    ulong right_record = ((destination - 1ul) * binding_count + binding) * 2ul;
                    ulong left_kind = dependencies[left_record];
                    ulong left_id = dependencies[left_record + 1ul];
                    dependencies[left_record] = dependencies[right_record];
                    dependencies[left_record + 1ul] = dependencies[right_record + 1ul];
                    dependencies[right_record] = left_kind;
                    dependencies[right_record + 1ul] = left_id;
                }
                --destination;
            }
        }
        ulong record = IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        outer_receipts[record + 7ul] = actual_rows | (actual_rows << 32u);
    }

    // Padding duplicates the first real grouping tuple, preserving all group equality semantics.
    // Every private reduction shadow remains NULL, so no padding row can affect a reduction.
    for (ulong row = actual_rows; row < source_capacity; ++row) {
        for (ulong binding = 0ul; binding < binding_count; ++binding) {
            ulong descriptor = program[41]
                + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
            IgSegmentedCellValue value = ig_segmented_null_cell();
            if (actual_rows != 0ul && program[descriptor + 10ul] != 0ul) {
                value = ig_segmented_input_cell(source_cells, uint(binding));
                if (value.tag == IG_SEGMENTED_VALUE_STRING
                        || value.tag == IG_SEGMENTED_VALUE_BYTES) {
                    ulong length = value.auxiliary;
                    ulong start = value.payload;
                    if (!ig_segmented_graph_range(arena_cursor, length, source_arena_capacity)) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
                        return;
                    }
                    value.payload = arena_cursor;
                    for (ulong byte = 0ul; byte < length; ++byte) {
                        source_arena[arena_cursor + byte] = source_arena[start + byte];
                    }
                    arena_cursor += length;
                }
            }
            ig_segmented_write_cell(
                source_cells, uint(row * source_columns + binding), value);
        }
        if (property_value_source) {
            ulong property_column = program[property_value_base + 7ul];
            IgSegmentedCellValue value = ig_segmented_null_cell();
            if (actual_rows != 0ul && property_args.mode
                    == IG_SEGMENTED_PROPERTY_VALUE_FLAT_LIST_GROUP) {
                value = ig_segmented_input_cell(source_cells, uint(property_column));
                if (value.tag == IG_SEGMENTED_VALUE_BYTES) {
                    ulong start = value.payload;
                    ulong length = value.auxiliary;
                    if (!ig_segmented_graph_range(
                            arena_cursor, length, source_arena_capacity)) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
                        return;
                    }
                    value.payload = arena_cursor;
                    for (ulong byte = 0ul; byte < length; ++byte) {
                        source_arena[arena_cursor + byte] = source_arena[start + byte];
                    }
                    arena_cursor += length;
                }
            }
            ig_segmented_write_cell(
                source_cells,
                uint(row * source_columns + property_column),
                value);
        }
        for (ulong key = 0ul; key < program[5]; ++key) {
            ulong encoded_group = program[program[42] + key];
            if ((encoded_group >> 48ul) == 0ul) continue;
            ulong column = ulong(uint(encoded_group));
            IgSegmentedCellValue value = ig_segmented_null_cell();
            if (actual_rows != 0ul) {
                value = ig_segmented_input_cell(source_cells, uint(column));
            }
            if (value.tag > IG_SEGMENTED_VALUE_FLOAT) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE);
                return;
            }
            ig_segmented_write_cell(
                source_cells, uint(row * source_columns + column), value);
        }
    }
    if (arena_cursor > source_arena_capacity) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
        return;
    }
    if (source_capacity != 0ul) {
        IgSegmentedCellValue cover;
        cover.tag = IG_SEGMENTED_VALUE_BYTES;
        cover.payload = arena_cursor;
        cover.auxiliary = source_arena_capacity - arena_cursor;
        ig_segmented_write_cell(
            source_cells,
            uint((source_capacity - 1ul) * source_columns
                + source_columns - 1ul),
            cover);
    } else if (arena_cursor != 0ul || source_arena_capacity != 0ul) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
        return;
    }

    source_header[0] = IG_SEGMENTED_AGGREGATION_ABI_WORD;
    source_header[1] = 0ul;
    source_header[2] = program[2];
    source_header[3] = program[3];
    source_header[4] = source_capacity | (source_columns << 32u);
    source_header[5] = program[19] | (source_arena_capacity << 32u);
    source_header[6] = program[5] | (aggregate_count << 16u)
        | ((aggregate_count + 1ul) << 32u);
    source_header[7] = program[23] | (program[21] << 32u);
    source_header[8] = program[22];
    for (ulong lane = 0ul; lane < 4ul; ++lane) {
        source_header[9ul + lane] = program[37ul + lane];
    }
    output_header[6] = actual_rows;
    output_header[7] = binding_count | (dependency_count << 32u);
    atomic_store_explicit(&graph_control[0], IG_SEGMENTED_STATUS_SUCCESS, memory_order_relaxed);
    atomic_store_explicit(&graph_control[1], IG_SEGMENTED_PHASE_COMPLETE, memory_order_relaxed);
    atomic_store_explicit(&graph_control[2], uint(actual_rows), memory_order_relaxed);
    atomic_store_explicit(&graph_control[3], uint(dependency_count), memory_order_relaxed);
    atomic_store_explicit(&graph_control[4], uint(source_capacity), memory_order_relaxed);
    atomic_store_explicit(&graph_control[5], uint(source_arena_capacity), memory_order_relaxed);
    atomic_store_explicit(&graph_control[6], uint(binding_count), memory_order_relaxed);
    if (property_value_source) {
        ulong record = IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        outer_receipts[record + 7ul] = actual_rows | (actual_rows << 32u);
    }
    atomic_store_explicit(&graph_control[7], IG_SEGMENTED_GRAPH_CONTROL_READY, memory_order_relaxed);
}

inline void ig_segmented_property_keys_fail(
    device atomic_uint* graph_control,
    device ulong* output_header,
    uint status) {
    atomic_store_explicit(&graph_control[0], status, memory_order_relaxed);
    atomic_store_explicit(&graph_control[1], IG_SEGMENTED_PHASE_FAILED, memory_order_relaxed);
    atomic_store_explicit(
        &graph_control[7], IG_SEGMENTED_GRAPH_VALIDATION_FAILED, memory_order_relaxed);
    ig_segmented_graph_fail(output_header, status);
}

// Each descriptor binds one already-resident canonical validity lane at buffer 18. Dispatches are
// ordered inside the same sealed command encoder and write only the bounded row-major R×P presence
// matrix. Missing physical columns still execute a receipted descriptor step with `present == 0`;
// they never manufacture a validity value or inspect an opaque property payload.
kernel void ig_segmented_graph_property_keys_mark(
    device const ulong* nullable [[buffer(0)]],
    device const ulong* program [[buffer(3)]],
    device atomic_uint* graph_control [[buffer(9)]],
    device ulong* output_header [[buffer(10)]],
    constant IgSegmentedGraphArgs& args [[buffer(14)]],
    device uchar* property_presence [[buffer(17)]],
    device const uchar* property_validity [[buffer(18)]],
    constant IgSegmentedPropertyValidityArgs& validity_args [[buffer(19)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    ulong property_base = ig_segmented_property_keys_base(program);
    ulong descriptor_count = program[property_base + 2ul];
    ulong descriptor_index = validity_args.descriptor_index;
    ulong entity_kind = program[property_base + 3ul];
    ulong graph_rows = entity_kind == 1ul ? program[29] : program[30];
    ulong entity_rows = nullable[21];
    ulong source_capacity = program[17];
    ulong expected_presence = 0ul;
    bool valid = program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
        && output_header[0] == IG_SEGMENTED_GRAPH_OUTPUT_MAGIC
        && uint(output_header[1]) == IG_SEGMENTED_STATUS_NOT_EXECUTED
        && uint(output_header[1] >> 32u) == IG_SEGMENTED_PHASE_NOT_STARTED
        && atomic_load_explicit(&graph_control[0], memory_order_relaxed)
            == IG_SEGMENTED_STATUS_NOT_EXECUTED
        && atomic_load_explicit(&graph_control[1], memory_order_relaxed)
            == IG_SEGMENTED_PHASE_NOT_STARTED
        && atomic_load_explicit(&graph_control[2], memory_order_relaxed) == 0u
        && atomic_load_explicit(&graph_control[3], memory_order_relaxed) == 0u
        && atomic_load_explicit(&graph_control[4], memory_order_relaxed)
            == uint(source_capacity)
        && atomic_load_explicit(&graph_control[5], memory_order_relaxed) == 0u
        && atomic_load_explicit(&graph_control[6], memory_order_relaxed)
            == uint(descriptor_index)
        && atomic_load_explicit(&graph_control[7], memory_order_relaxed)
            == IG_SEGMENTED_GRAPH_PROPERTY_KEYS_READY
        && descriptor_index < descriptor_count
        && validity_args.validity_present <= 1ul && validity_args.reserved == 0ul
        && ((validity_args.validity_present == 0ul
                && validity_args.validity_storage_elems == 1ul)
            || (validity_args.validity_present == 1ul
                && validity_args.validity_storage_elems == graph_rows))
        && entity_rows <= program[28]
        && ig_segmented_graph_product(
            program[28], descriptor_count, expected_presence)
        && expected_presence == source_capacity
        && args.property_presence_bytes == source_capacity;
    if (!valid) {
        ig_segmented_property_keys_fail(
            graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
        return;
    }

    device const uchar* nullable_bytes = reinterpret_cast<device const uchar*>(nullable);
    ulong binding = program[41]
        + program[property_base + 4ul] * IG_SEGMENTED_GRAPH_BINDING_WORDS;
    ulong dense_base = program[binding + 4ul];
    for (ulong row = 0ul; row < entity_rows; ++row) {
        uint dense = ig_segmented_graph_read_u32_le(
            nullable_bytes, dense_base + row * 4ul);
        uchar present = 0u;
        if (dense != uint(IG_NULLABLE_RELATION_NULL_ROW)) {
            if (ulong(dense) >= graph_rows) {
                ig_segmented_property_keys_fail(
                    graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                return;
            }
            if (validity_args.validity_present != 0ul) {
                present = property_validity[dense];
                if (present > 1u) {
                    ig_segmented_property_keys_fail(
                        graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                    return;
                }
            }
        }
        ulong presence = row * descriptor_count + descriptor_index;
        if (presence >= args.property_presence_bytes) {
            ig_segmented_property_keys_fail(
                graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
            return;
        }
        property_presence[presence] = present;
    }
    atomic_store_explicit(
        &graph_control[6], uint(descriptor_index + 1ul), memory_order_relaxed);
}

// Fuses list materialization and UNWIND: the logical list cells are the validated R×P presence
// matrix above, while this completion emits only present names into the generic scalar relation in
// exact source-row/descriptor order. Duplicate relationship orientations therefore remain
// duplicate rows until the following device grouping pass collapses DISTINCT keys.
kernel void ig_segmented_graph_property_keys_complete(
    device const ulong* nullable [[buffer(0)]],
    device const ulong* node_ids [[buffer(1)]],
    device const ulong* edge_ids [[buffer(2)]],
    device const ulong* program [[buffer(3)]],
    device ulong* source_header [[buffer(4)]],
    device ulong* source_cells [[buffer(5)]],
    device uchar* source_arena [[buffer(6)]],
    device ulong* dependencies [[buffer(7)]],
    device atomic_uint* graph_control [[buffer(9)]],
    device ulong* output_header [[buffer(10)]],
    device ulong* outer_receipts [[buffer(13)]],
    constant IgSegmentedGraphArgs& args [[buffer(14)]],
    device const uchar* property_presence [[buffer(17)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    ulong property_base = ig_segmented_property_keys_base(program);
    ulong descriptor_count = program[property_base + 2ul];
    ulong entity_kind = program[property_base + 3ul];
    ulong descriptor_base = property_base + IG_SEGMENTED_PROPERTY_KEYS_HEADER_WORDS;
    ulong names_word_base = descriptor_base
        + descriptor_count * IG_SEGMENTED_PROPERTY_KEYS_DESCRIPTOR_WORDS;
    ulong names_byte_base = names_word_base * 8ul;
    ulong entity_rows = nullable[21];
    ulong source_capacity = program[17];
    ulong source_columns = program[18];
    ulong source_arena_capacity = program[20];
    ulong graph_rows = entity_kind == 1ul ? program[29] : program[30];
    ulong expected_presence = 0ul;
    if (program[53] != IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
            || entity_rows > program[28]
            || !ig_segmented_graph_product(
                program[28], descriptor_count, expected_presence)
            || expected_presence != source_capacity
            || args.property_presence_bytes != source_capacity
            || atomic_load_explicit(&graph_control[0], memory_order_relaxed)
                != IG_SEGMENTED_STATUS_NOT_EXECUTED
            || atomic_load_explicit(&graph_control[1], memory_order_relaxed)
                != IG_SEGMENTED_PHASE_NOT_STARTED
            || atomic_load_explicit(&graph_control[2], memory_order_relaxed) != 0u
            || atomic_load_explicit(&graph_control[3], memory_order_relaxed) != 0u
            || atomic_load_explicit(&graph_control[4], memory_order_relaxed)
                != uint(source_capacity)
            || atomic_load_explicit(&graph_control[5], memory_order_relaxed) != 0u
            || atomic_load_explicit(&graph_control[6], memory_order_relaxed)
                != uint(descriptor_count)
            || atomic_load_explicit(&graph_control[7], memory_order_relaxed)
                != IG_SEGMENTED_GRAPH_PROPERTY_KEYS_READY) {
        ig_segmented_property_keys_fail(
            graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
        return;
    }

    device const uchar* nullable_bytes = reinterpret_cast<device const uchar*>(nullable);
    ulong binding = program[41]
        + program[property_base + 4ul] * IG_SEGMENTED_GRAPH_BINDING_WORDS;
    ulong dense_base = program[binding + 4ul];
    ulong dependency_count = entity_rows;
    for (ulong row = 0ul; row < entity_rows; ++row) {
        uint dense = ig_segmented_graph_read_u32_le(
            nullable_bytes, dense_base + row * 4ul);
        if (dense == uint(IG_NULLABLE_RELATION_NULL_ROW)) continue;
        if (ulong(dense) >= graph_rows) {
            ig_segmented_property_keys_fail(
                graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
            return;
        }
        dependencies[row * 2ul] = entity_kind;
        dependencies[row * 2ul + 1ul] = entity_kind == 1ul
            ? node_ids[dense] : edge_ids[dense];
    }

    ulong emitted_rows = 0ul;
    ulong arena_cursor = 0ul;
    for (ulong row = 0ul; row < entity_rows; ++row) {
        for (ulong property = 0ul; property < descriptor_count; ++property) {
            ulong presence = row * descriptor_count + property;
            uchar present = property_presence[presence];
            if (present > 1u) {
                ig_segmented_property_keys_fail(
                    graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE);
                return;
            }
            if (present == 0u) continue;
            ulong descriptor = descriptor_base
                + property * IG_SEGMENTED_PROPERTY_KEYS_DESCRIPTOR_WORDS;
            ulong name_offset = program[descriptor + 1ul];
            ulong name_length = program[descriptor + 2ul];
            if (emitted_rows >= source_capacity
                    || !ig_segmented_graph_range(
                        arena_cursor, name_length, source_arena_capacity)) {
                ig_segmented_property_keys_fail(
                    graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
                return;
            }
            IgSegmentedCellValue key;
            key.tag = IG_SEGMENTED_VALUE_STRING;
            key.payload = arena_cursor;
            key.auxiliary = name_length;
            for (ulong byte = 0ul; byte < name_length; ++byte) {
                source_arena[arena_cursor + byte] = ig_segmented_program_byte(
                    program, names_byte_base + name_offset + byte);
            }
            arena_cursor += name_length;
            ig_segmented_write_cell(
                source_cells, uint(emitted_rows * source_columns), key);
            IgSegmentedCellValue count;
            count.tag = IG_SEGMENTED_VALUE_INTEGER;
            count.payload = 1ul;
            count.auxiliary = 0ul;
            ig_segmented_write_cell(
                source_cells, uint(emitted_rows * source_columns + 1ul), count);
            ++emitted_rows;
        }
    }

    // E=0 deliberately leaves every grouping cell NULL. For E>0, padding copies the first real
    // key into disjoint arena bytes; neither branch writes the private CountAll shadow.
    for (ulong row = emitted_rows; row < source_capacity; ++row) {
        if (emitted_rows == 0ul) continue;
        IgSegmentedCellValue key = ig_segmented_input_cell(source_cells, 0u);
        ulong start = key.payload;
        ulong length = key.auxiliary;
        if (key.tag != IG_SEGMENTED_VALUE_STRING
                || !ig_segmented_graph_range(
                    arena_cursor, length, source_arena_capacity)) {
            ig_segmented_property_keys_fail(
                graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
            return;
        }
        key.payload = arena_cursor;
        for (ulong byte = 0ul; byte < length; ++byte) {
            source_arena[arena_cursor + byte] = source_arena[start + byte];
        }
        arena_cursor += length;
        ig_segmented_write_cell(source_cells, uint(row * source_columns), key);
    }
    if (source_capacity != 0ul) {
        IgSegmentedCellValue cover;
        cover.tag = IG_SEGMENTED_VALUE_BYTES;
        cover.payload = arena_cursor;
        cover.auxiliary = source_arena_capacity - arena_cursor;
        ig_segmented_write_cell(
            source_cells,
            uint((source_capacity - 1ul) * source_columns + source_columns - 1ul),
            cover);
    } else if (arena_cursor != 0ul || source_arena_capacity != 0ul) {
        ig_segmented_property_keys_fail(
            graph_control, output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
        return;
    }

    source_header[0] = IG_SEGMENTED_AGGREGATION_ABI_WORD;
    source_header[1] = 0ul;
    source_header[2] = program[2];
    source_header[3] = program[3];
    source_header[4] = source_capacity | (source_columns << 32u);
    source_header[5] = program[19] | (source_arena_capacity << 32u);
    source_header[6] = 1ul | (1ul << 16u) | (2ul << 32u);
    source_header[7] = program[23] | (program[21] << 32u);
    source_header[8] = program[22];
    for (ulong lane = 0ul; lane < 4ul; ++lane) {
        source_header[9ul + lane] = program[37ul + lane];
    }
    ulong property_receipt = IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
    ulong unwind_receipt = property_receipt + IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
    outer_receipts[property_receipt + 7ul] = entity_rows | (entity_rows << 32u);
    outer_receipts[unwind_receipt + 7ul] = entity_rows | (emitted_rows << 32u);
    output_header[6] = emitted_rows | (entity_rows << 32u);
    output_header[7] = 1ul | (dependency_count << 32u);
    atomic_store_explicit(
        &graph_control[0], IG_SEGMENTED_STATUS_SUCCESS, memory_order_relaxed);
    atomic_store_explicit(
        &graph_control[1], IG_SEGMENTED_PHASE_COMPLETE, memory_order_relaxed);
    atomic_store_explicit(&graph_control[2], uint(emitted_rows), memory_order_relaxed);
    atomic_store_explicit(&graph_control[3], uint(dependency_count), memory_order_relaxed);
    atomic_store_explicit(&graph_control[4], uint(source_capacity), memory_order_relaxed);
    atomic_store_explicit(
        &graph_control[5], uint(source_arena_capacity), memory_order_relaxed);
    atomic_store_explicit(&graph_control[6], 1u, memory_order_relaxed);
    atomic_store_explicit(&graph_control[7], IG_SEGMENTED_GRAPH_CONTROL_READY, memory_order_relaxed);
}

// Decodes exactly one scalar child from the canonical document bytes retained as the private
// grouping key.  PropertyValue admission proves a flat list of these five public scalar kinds;
// rechecking the bytes here keeps the final result ABI independent of that private representation.
inline uint ig_segmented_property_flat_list_item(
    device const uchar* bytes,
    ulong limit,
    thread ulong& cursor,
    thread IgSegmentedCellValue& value) {
    if (!ig_segmented_graph_range(cursor, 1ul, limit)) {
        return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    uint tag = uint(bytes[cursor++]);
    value = ig_segmented_null_cell();
    if (tag == 1u || tag == 2u) {
        value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
        value.payload = tag == 2u ? 1ul : 0ul;
        return 0u;
    }
    if (tag == 3u || tag == 4u) {
        if (!ig_segmented_graph_range(cursor, 8ul, limit)) {
            return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
        }
        value.tag = tag == 3u
            ? IG_SEGMENTED_VALUE_INTEGER : IG_SEGMENTED_VALUE_FLOAT;
        value.payload = ig_segmented_graph_read_u64_le(bytes, cursor);
        cursor += 8ul;
        if (value.tag == IG_SEGMENTED_VALUE_FLOAT
                && !ig_segmented_f64_finite(value.payload)) {
            return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
        }
        return 0u;
    }
    if (tag != 5u && tag != 6u) {
        return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    if (!ig_segmented_graph_range(cursor, 8ul, limit)) {
        return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    ulong length = ig_segmented_graph_read_u64_le(bytes, cursor);
    cursor += 8ul;
    if (!ig_segmented_graph_range(cursor, length, limit)
            || cursor > 0xfffffffful || length > 0xfffffffful
            || (tag == 5u
                && !ig_segmented_utf8(bytes, uint(cursor), uint(length)))) {
        return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    value.tag = tag == 5u ? IG_SEGMENTED_VALUE_STRING : IG_SEGMENTED_VALUE_BYTES;
    value.payload = cursor;
    value.auxiliary = length;
    cursor += length;
    return 0u;
}

inline uint ig_segmented_graph_property_flat_list(
    device const ulong* program,
    device const uchar* aggregate_arena,
    ulong aggregate_arena_bytes,
    IgSegmentedCellValue encoded,
    thread ulong& item_count,
    thread ulong& first_item,
    thread ulong& variable_bytes) {
    ulong base = ig_segmented_property_value_base(program);
    item_count = 0ul;
    first_item = 0ul;
    variable_bytes = 0ul;
    if (encoded.tag == IG_SEGMENTED_VALUE_NULL) {
        return encoded.payload == 0ul && encoded.auxiliary == 0ul
            ? 0u : IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    if (encoded.tag != IG_SEGMENTED_VALUE_BYTES
            || !ig_segmented_graph_scalar_cell_valid(encoded, aggregate_arena_bytes)
            || encoded.auxiliary < 10ul) {
        return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    ulong limit = encoded.payload + encoded.auxiliary;
    if (aggregate_arena[encoded.payload] != 3u
            || aggregate_arena[encoded.payload + 1ul] != 13u) {
        return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    item_count = ig_segmented_graph_read_u64_le(
        aggregate_arena, encoded.payload + 2ul);
    if (item_count > program[base + 9ul]
            || item_count >= program[base + 8ul]) {
        return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
    }
    first_item = encoded.payload + 10ul;
    ulong cursor = first_item;
    for (ulong item = 0ul; item < item_count; ++item) {
        IgSegmentedCellValue value;
        uint status = ig_segmented_property_flat_list_item(
            aggregate_arena, limit, cursor, value);
        if (status != 0u) return status;
        if (value.tag == IG_SEGMENTED_VALUE_STRING
                || value.tag == IG_SEGMENTED_VALUE_BYTES) {
            if (!ig_segmented_graph_sum(
                    variable_bytes, value.auxiliary, variable_bytes)) {
                return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
            }
        }
    }
    return cursor == limit && variable_bytes <= program[base + 10ul]
        ? 0u : IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
}

inline uint ig_segmented_graph_emit_property_value_lists(
    device const ulong* program,
    device const uchar* aggregate_arena,
    ulong aggregate_arena_bytes,
    device const ulong* slot_cells,
    ulong slot_count,
    device const uint* order_rows,
    ulong effective_rows,
    ulong active_rows,
    device ulong* output_cells,
    device uchar* output_arena,
    constant IgSegmentedGraphArgs& args,
    thread ulong& total_cells,
    thread ulong& arena_required) {
    ulong base = ig_segmented_property_value_base(program);
    ulong published_slot = program[base + 12ul];
    ulong output_columns = program[13];
    ulong top_level_cells = 0ul;
    ulong appended_required = 0ul;
    arena_required = 0ul;
    if (program[base + 2ul] != IG_SEGMENTED_PROPERTY_VALUE_FLAT_LIST_GROUP
            || published_slot >= slot_count || output_columns != 2ul
            || !ig_segmented_graph_product(
                active_rows, output_columns, top_level_cells)) {
        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }
    for (ulong position = 0ul; position < active_rows; ++position) {
        ulong row = order_rows[position];
        if (row >= effective_rows) return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
        for (ulong column = 0ul; column < output_columns; ++column) {
            ulong slot = program[program[49] + column];
            if (slot >= slot_count) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            IgSegmentedCellValue value = ig_segmented_input_cell(
                slot_cells, uint(row * slot_count + slot));
            if (slot == published_slot) {
                ulong items = 0ul;
                ulong first_item = 0ul;
                ulong variable_bytes = 0ul;
                uint status = ig_segmented_graph_property_flat_list(
                    program,
                    aggregate_arena,
                    aggregate_arena_bytes,
                    value,
                    items,
                    first_item,
                    variable_bytes);
                if (status != 0u) return status;
                if (!ig_segmented_graph_sum(
                        appended_required, items, appended_required)
                        || !ig_segmented_graph_sum(
                            arena_required, variable_bytes, arena_required)) {
                    return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
                }
            } else {
                if (!ig_segmented_graph_scalar_cell_valid(value, aggregate_arena_bytes)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
                }
                if ((value.tag == IG_SEGMENTED_VALUE_STRING
                            || value.tag == IG_SEGMENTED_VALUE_BYTES)
                        && !ig_segmented_graph_sum(
                            arena_required, value.auxiliary, arena_required)) {
                    return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
                }
            }
        }
    }
    if (!ig_segmented_graph_sum(top_level_cells, appended_required, total_cells)
            || total_cells > program[24] || arena_required > program[25]
            || total_cells > 0xfffffffful || arena_required > 0xfffffffful
            || args.output_cell_words < total_cells * 3ul
            || args.output_arena_storage_bytes < max(arena_required, 1ul)) {
        return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
    }

    ulong appended_cursor = 0ul;
    uint arena_cursor = 0u;
    for (ulong position = 0ul; position < active_rows; ++position) {
        ulong row = order_rows[position];
        for (ulong column = 0ul; column < output_columns; ++column) {
            ulong slot = program[program[49] + column];
            IgSegmentedCellValue encoded = ig_segmented_input_cell(
                slot_cells, uint(row * slot_count + slot));
            uint destination = uint(position * output_columns + column);
            if (slot != published_slot) {
                if (!ig_segmented_copy_input_cell(
                        aggregate_arena,
                        encoded,
                        output_cells,
                        destination,
                        output_arena,
                        uint(args.output_arena_storage_bytes),
                        arena_cursor)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
                }
                continue;
            }
            if (encoded.tag == IG_SEGMENTED_VALUE_NULL) {
                ig_segmented_write_cell(output_cells, destination, encoded);
                continue;
            }
            ulong item_count = 0ul;
            ulong cursor = 0ul;
            ulong variable_bytes = 0ul;
            uint status = ig_segmented_graph_property_flat_list(
                program,
                aggregate_arena,
                aggregate_arena_bytes,
                encoded,
                item_count,
                cursor,
                variable_bytes);
            if (status != 0u) return status;
            IgSegmentedCellValue list;
            list.tag = IG_SEGMENTED_VALUE_LIST;
            list.payload = top_level_cells + appended_cursor;
            list.auxiliary = item_count;
            ig_segmented_write_cell(output_cells, destination, list);
            ulong limit = encoded.payload + encoded.auxiliary;
            for (ulong item = 0ul; item < item_count; ++item) {
                IgSegmentedCellValue value;
                status = ig_segmented_property_flat_list_item(
                    aggregate_arena, limit, cursor, value);
                if (status != 0u) return status;
                uint child = uint(top_level_cells + appended_cursor + item);
                if (!ig_segmented_copy_input_cell(
                        aggregate_arena,
                        value,
                        output_cells,
                        child,
                        output_arena,
                        uint(args.output_arena_storage_bytes),
                        arena_cursor)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
                }
            }
            if (cursor != limit) return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
            appended_cursor += item_count;
        }
    }
    return top_level_cells + appended_cursor == total_cells
            && ulong(arena_cursor) == arena_required
        ? 0u : IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
}

inline bool ig_segmented_graph_map_scalar_bytes(
    ulong aggregate_arena_bytes,
    IgSegmentedCellValue value,
    thread ulong& bytes) {
    if (value.tag == IG_SEGMENTED_VALUE_NULL || value.tag == IG_SEGMENTED_VALUE_BOOLEAN) {
        bytes = 1ul;
        return value.tag != IG_SEGMENTED_VALUE_BOOLEAN || value.payload <= 1ul;
    }
    if (value.tag == IG_SEGMENTED_VALUE_INTEGER || value.tag == IG_SEGMENTED_VALUE_FLOAT) {
        bytes = 9ul;
        return value.auxiliary == 0ul
            && (value.tag != IG_SEGMENTED_VALUE_FLOAT || ig_segmented_f64_finite(value.payload));
    }
    if (value.tag == IG_SEGMENTED_VALUE_STRING) {
        bytes = 9ul + value.auxiliary;
        return value.payload <= aggregate_arena_bytes
            && value.auxiliary <= aggregate_arena_bytes - value.payload;
    }
    return false;
}

inline bool ig_segmented_graph_map_item_bytes(
    device const ulong* aggregate_cells,
    ulong aggregate_cell_count,
    ulong aggregate_arena_bytes,
    IgSegmentedCellValue value,
    thread ulong& bytes) {
    if (value.tag != IG_SEGMENTED_VALUE_LIST) {
        return ig_segmented_graph_map_scalar_bytes(
            aggregate_arena_bytes, value, bytes);
    }
    if (!ig_segmented_graph_range(
            value.payload, value.auxiliary, aggregate_cell_count)) return false;
    bytes = 9ul;
    for (ulong index = 0ul; index < value.auxiliary; ++index) {
        IgSegmentedCellValue child = ig_segmented_input_cell(
            aggregate_cells, uint(value.payload + index));
        ulong child_bytes = 0ul;
        if (!ig_segmented_graph_map_scalar_bytes(
                aggregate_arena_bytes, child, child_bytes)
                || !ig_segmented_graph_sum(bytes, child_bytes, bytes)) return false;
    }
    return true;
}

inline void ig_segmented_graph_write_u64_le(
    device uchar* output,
    thread uint& cursor,
    ulong value) {
    for (uint byte = 0u; byte < 8u; ++byte) {
        output[cursor++] = uchar((value >> (byte * 8u)) & 0xfful);
    }
}

inline bool ig_segmented_graph_write_map_scalar(
    device const uchar* aggregate_arena,
    ulong aggregate_arena_bytes,
    IgSegmentedCellValue value,
    device uchar* output,
    uint capacity,
    thread uint& cursor) {
    ulong required = 0ul;
    if (!ig_segmented_graph_map_scalar_bytes(
            aggregate_arena_bytes, value, required)
            || !ig_segmented_graph_range(ulong(cursor), required, ulong(capacity))) return false;
    if (value.tag == IG_SEGMENTED_VALUE_NULL) {
        output[cursor++] = 0u;
    } else if (value.tag == IG_SEGMENTED_VALUE_BOOLEAN) {
        output[cursor++] = value.payload == 0ul ? 1u : 2u;
    } else if (value.tag == IG_SEGMENTED_VALUE_INTEGER
            || value.tag == IG_SEGMENTED_VALUE_FLOAT) {
        output[cursor++] = value.tag == IG_SEGMENTED_VALUE_INTEGER ? 3u : 4u;
        ig_segmented_graph_write_u64_le(output, cursor, value.payload);
    } else if (value.tag == IG_SEGMENTED_VALUE_STRING) {
        output[cursor++] = 5u;
        ig_segmented_graph_write_u64_le(output, cursor, value.auxiliary);
        for (ulong byte = 0ul; byte < value.auxiliary; ++byte) {
            output[cursor++] = aggregate_arena[value.payload + byte];
        }
    } else {
        return false;
    }
    return true;
}

inline bool ig_segmented_graph_write_map_item(
    device const ulong* aggregate_cells,
    ulong aggregate_cell_count,
    device const uchar* aggregate_arena,
    ulong aggregate_arena_bytes,
    IgSegmentedCellValue value,
    device uchar* output,
    uint capacity,
    thread uint& cursor) {
    if (value.tag != IG_SEGMENTED_VALUE_LIST) {
        return ig_segmented_graph_write_map_scalar(
            aggregate_arena,
            aggregate_arena_bytes,
            value,
            output,
            capacity,
            cursor);
    }
    ulong required = 0ul;
    if (!ig_segmented_graph_map_item_bytes(
            aggregate_cells,
            aggregate_cell_count,
            aggregate_arena_bytes,
            value,
            required)
            || !ig_segmented_graph_range(ulong(cursor), required, ulong(capacity))) return false;
    output[cursor++] = 13u;
    ig_segmented_graph_write_u64_le(output, cursor, value.auxiliary);
    for (ulong index = 0ul; index < value.auxiliary; ++index) {
        IgSegmentedCellValue child = ig_segmented_input_cell(
            aggregate_cells, uint(value.payload + index));
        if (!ig_segmented_graph_write_map_scalar(
                aggregate_arena,
                aggregate_arena_bytes,
                child,
                output,
                capacity,
                cursor)) return false;
    }
    return true;
}

inline uint ig_segmented_graph_map_document_bytes(
    device const ulong* program,
    device const ulong* aggregate_cells,
    ulong aggregate_cell_count,
    device const uchar* aggregate_arena,
    ulong aggregate_arena_bytes,
    device const ulong* slot_cells,
    ulong row,
    ulong slot_count,
    thread ulong& bytes) {
    ulong base = program[54];
    ulong count = program[base + 3ul];
    ulong descriptor_base = base + IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS;
    bytes = 10ul;
    for (ulong index = 0ul; index < count; ++index) {
        ulong descriptor = descriptor_base
            + index * IG_SEGMENTED_GRAPH_MAP_DESCRIPTOR_WORDS;
        IgSegmentedCellValue value;
        uint status = ig_segmented_graph_evaluate_expression(
            program,
            aggregate_arena,
            program[descriptor],
            program[descriptor + 1ul],
            slot_cells,
            row,
            slot_count,
            aggregate_cells,
            aggregate_cell_count,
            value);
        ulong item_bytes = 0ul;
        if (status != 0u) return status;
        if (!ig_segmented_graph_map_item_bytes(
                aggregate_cells,
                aggregate_cell_count,
                aggregate_arena_bytes,
                value,
                item_bytes)
                || !ig_segmented_graph_sum(bytes, 8ul, bytes)
                || !ig_segmented_graph_sum(bytes, program[descriptor + 3ul], bytes)
                || !ig_segmented_graph_sum(bytes, item_bytes, bytes)) {
            return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
        }
    }
    return 0u;
}

inline uint ig_segmented_graph_write_map_document(
    device const ulong* program,
    device const ulong* aggregate_cells,
    ulong aggregate_cell_count,
    device const uchar* aggregate_arena,
    ulong aggregate_arena_bytes,
    device const ulong* slot_cells,
    ulong row,
    ulong slot_count,
    device uchar* output,
    uint capacity,
    thread uint& cursor) {
    ulong base = program[54];
    ulong count = program[base + 3ul];
    ulong descriptor_base = base + IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS;
    ulong names_word_base = descriptor_base
        + count * IG_SEGMENTED_GRAPH_MAP_DESCRIPTOR_WORDS;
    ulong names_byte_base = names_word_base * 8ul;
    if (!ig_segmented_graph_range(ulong(cursor), 10ul, ulong(capacity))) {
        return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
    }
    output[cursor++] = 3u;
    output[cursor++] = 14u;
    ig_segmented_graph_write_u64_le(output, cursor, count);
    for (ulong index = 0ul; index < count; ++index) {
        ulong descriptor = descriptor_base
            + index * IG_SEGMENTED_GRAPH_MAP_DESCRIPTOR_WORDS;
        ulong name_offset = program[descriptor + 2ul];
        ulong name_length = program[descriptor + 3ul];
        if (!ig_segmented_graph_range(
                ulong(cursor), 8ul + name_length, ulong(capacity))) {
            return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
        }
        ig_segmented_graph_write_u64_le(output, cursor, name_length);
        for (ulong byte = 0ul; byte < name_length; ++byte) {
            output[cursor++] = ig_segmented_program_byte(
                program, names_byte_base + name_offset + byte);
        }
        IgSegmentedCellValue value;
        uint status = ig_segmented_graph_evaluate_expression(
            program,
            aggregate_arena,
            program[descriptor],
            program[descriptor + 1ul],
            slot_cells,
            row,
            slot_count,
            aggregate_cells,
            aggregate_cell_count,
            value);
        if (status != 0u) return status;
        if (!ig_segmented_graph_write_map_item(
                aggregate_cells,
                aggregate_cell_count,
                aggregate_arena,
                aggregate_arena_bytes,
                value,
                output,
                capacity,
                cursor)) return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
    }
    return 0u;
}

inline uint ig_segmented_graph_emit_key_value_lists(
    device const ulong* program,
    device const uchar* aggregate_arena,
    ulong aggregate_arena_bytes,
    device const ulong* slot_cells,
    ulong slot_count,
    device const uint* order_rows,
    ulong effective_rows,
    ulong active_rows,
    device ulong* output_cells,
    device uchar* output_arena,
    constant IgSegmentedGraphArgs& args,
    thread ulong& total_cells,
    thread ulong& arena_required) {
    ulong base = program[54];
    ulong count = program[base + 2ul];
    ulong descriptor_base = base + IG_SEGMENTED_KEY_VALUE_LIST_HEADER_WORDS;
    ulong names_word_base = descriptor_base
        + count * IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS;
    ulong names_byte_base = names_word_base * 8ul;
    ulong child_count = 0ul;
    arena_required = 0ul;
    for (ulong position = 0ul; position < active_rows; ++position) {
        ulong row = order_rows[position];
        if (row >= effective_rows) return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
        for (ulong index = 0ul; index < count; ++index) {
            ulong descriptor = descriptor_base
                + index * IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS;
            ulong slot = program[descriptor];
            IgSegmentedCellValue value = ig_segmented_input_cell(
                slot_cells, uint(row * slot_count + slot));
            if (value.tag == IG_SEGMENTED_VALUE_NULL) {
                if (value.payload != 0ul || value.auxiliary != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
                }
                continue;
            }
            if (value.tag != IG_SEGMENTED_VALUE_STRING
                    || value.auxiliary > program[descriptor + 3ul]
                    || !ig_segmented_graph_scalar_cell_valid(value, aggregate_arena_bytes)) {
                return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
            }
            ulong width = program[descriptor + 2ul] + 2ul + value.auxiliary;
            if (!ig_segmented_graph_sum(child_count, 1ul, child_count)
                    || !ig_segmented_graph_sum(arena_required, width, arena_required)) {
                return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
            }
        }
    }
    if (!ig_segmented_graph_sum(active_rows, child_count, total_cells)
            || total_cells > program[24] || arena_required > program[25]
            || total_cells > 0xfffffffful || arena_required > 0xfffffffful
            || args.output_cell_words < total_cells * 3ul
            || args.output_arena_storage_bytes < max(arena_required, 1ul)) {
        return IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY;
    }

    ulong child_cursor = 0ul;
    ulong arena_cursor = 0ul;
    for (ulong position = 0ul; position < active_rows; ++position) {
        ulong row = order_rows[position];
        ulong row_children = 0ul;
        for (ulong index = 0ul; index < count; ++index) {
            ulong descriptor = descriptor_base
                + index * IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS;
            ulong slot = program[descriptor];
            IgSegmentedCellValue value = ig_segmented_input_cell(
                slot_cells, uint(row * slot_count + slot));
            if (value.tag == IG_SEGMENTED_VALUE_NULL) continue;
            ulong name_offset = program[descriptor + 1ul];
            ulong name_length = program[descriptor + 2ul];
            ulong start = arena_cursor;
            for (ulong byte = 0ul; byte < name_length; ++byte) {
                output_arena[arena_cursor++] = ig_segmented_program_byte(
                    program, names_byte_base + name_offset + byte);
            }
            output_arena[arena_cursor++] = uchar('-');
            output_arena[arena_cursor++] = uchar('>');
            for (ulong byte = 0ul; byte < value.auxiliary; ++byte) {
                output_arena[arena_cursor++] = aggregate_arena[value.payload + byte];
            }
            IgSegmentedCellValue child;
            child.tag = IG_SEGMENTED_VALUE_STRING;
            child.payload = start;
            child.auxiliary = name_length + 2ul + value.auxiliary;
            ig_segmented_write_cell(
                output_cells, uint(active_rows + child_cursor), child);
            ++child_cursor;
            ++row_children;
        }
        IgSegmentedCellValue list;
        list.tag = IG_SEGMENTED_VALUE_LIST;
        list.payload = active_rows + child_cursor - row_children;
        list.auxiliary = row_children;
        ig_segmented_write_cell(output_cells, uint(position), list);
    }
    return child_cursor + active_rows == total_cells && arena_cursor == arena_required
        ? 0u : IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
}

kernel void ig_segmented_graph_finalize_program(
    device const ulong* program [[buffer(0)]],
    device const ulong* aggregate_header [[buffer(1)]],
    device const ulong* aggregate_cells [[buffer(2)]],
    device const uchar* aggregate_arena [[buffer(3)]],
    device ulong* slot_cells [[buffer(4)]],
    device ulong* projection_result_cells [[buffer(5)]],
    device uint* order_rows [[buffer(6)]],
    device ulong* order_key_cells [[buffer(7)]],
    device const ulong* dependencies [[buffer(8)]],
    device ulong* output_header [[buffer(9)]],
    device ulong* output_cells [[buffer(10)]],
    device uchar* output_arena [[buffer(11)]],
    device ulong* outer_receipts [[buffer(12)]],
    device atomic_uint* graph_control [[buffer(13)]],
    constant IgSegmentedGraphArgs& args [[buffer(14)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    if (args.output_header_words < IG_SEGMENTED_GRAPH_OUTPUT_HEADER_WORDS
            || args.program_words < IG_SEGMENTED_GRAPH_PROGRAM_HEADER_WORDS) return;

    uint prior_status = uint(output_header[1]);
    uint prior_phase = uint(output_header[1] >> 32u);
    ulong source_kind = program[53];
    ulong source_rows = uint(output_header[6]);
    ulong property_entity_rows = uint(output_header[6] >> 32u);
    ulong expected_dependency_count = (source_kind == IG_SEGMENTED_GRAPH_SOURCE_GRAPH
            || source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
            || source_kind == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH)
        ? source_rows * program[4]
        : source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
            ? property_entity_rows * program[4] : 0ul;
    if (prior_phase == IG_SEGMENTED_PHASE_FAILED) return;
    if (prior_status != IG_SEGMENTED_STATUS_NOT_EXECUTED
            || prior_phase != IG_SEGMENTED_PHASE_NOT_STARTED
            || output_header[0] != IG_SEGMENTED_GRAPH_OUTPUT_MAGIC
            || output_header[2] != program[2] || output_header[3] != program[3]
            || source_rows > program[17]
            || (source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
                ? property_entity_rows > program[28]
                : property_entity_rows != 0ul)
            || uint(output_header[7]) != uint(program[4])
            || uint(output_header[7] >> 32u) != uint(expected_dependency_count)
            || output_header[8] != program[14]
            || output_header[9] != program[27]
            || output_header[10] != program[17]
            || uint(output_header[11]) != uint(program[23])
            || uint(output_header[11] >> 32u) != uint(program[24])
            || output_header[12] != program[25]
            || output_header[21] != program[9]
            || output_header[22] != program[12]
            || output_header[23] != IG_SEGMENTED_GRAPH_OUTPUT_VERSION
            || program[0] != IG_SEGMENTED_GRAPH_PROGRAM_MAGIC
            || program[1] != IG_SEGMENTED_GRAPH_PROGRAM_VERSION
            || program[52] != args.program_words
            || source_kind > IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
        return;
    }
    for (ulong lane = 0ul; lane < 4ul; ++lane) {
        if (output_header[13ul + lane] != program[37ul + lane]
                || output_header[17ul + lane] != program[33ul + lane]) {
            ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
            return;
        }
    }

    uint aggregate_status = uint(aggregate_header[1]);
    uint aggregate_phase = uint(aggregate_header[1] >> 32u);
    if (aggregate_status != IG_SEGMENTED_STATUS_SUCCESS
            || aggregate_phase != IG_SEGMENTED_PHASE_COMPLETE) {
        uint status = aggregate_status >= IG_SEGMENTED_STATUS_INVALID_HEADER
                && aggregate_status <= IG_SEGMENTED_STATUS_INTERNAL_BOUNDS
            ? aggregate_status : IG_SEGMENTED_STATUS_PHASE_MISMATCH;
        ig_segmented_graph_fail(output_header, status);
        return;
    }
    ulong generic_rows = uint(aggregate_header[4]);
    ulong aggregate_columns = (aggregate_header[4] >> 32u) & 0xfffful;
    ulong aggregate_cell_count = uint(aggregate_header[5]);
    ulong aggregate_arena_bytes = uint(aggregate_header[5] >> 32u);
    ulong expected_aggregate_cells = generic_rows * aggregate_columns;
    if (aggregate_header[0] != IG_SEGMENTED_AGGREGATION_ABI_WORD
            || aggregate_header[2] != program[2] || aggregate_header[3] != program[3]
            || (aggregate_header[4] >> 48u) != 0ul
            || aggregate_columns != program[8]
            || aggregate_cell_count < expected_aggregate_cells
            || aggregate_cell_count > program[21]
            || aggregate_arena_bytes > program[22]
            || uint(aggregate_header[6] & 0xfffful) != uint(program[5])
            || uint((aggregate_header[6] >> 16u) & 0xfffful) != uint(program[6])
            || uint((aggregate_header[6] >> 32u) & 0xfffful) != uint(program[6] + 1ul)
            || (aggregate_header[6] >> 48u) != 0ul
            || uint(aggregate_header[7]) != uint(program[23])
            || uint(aggregate_header[7] >> 32u) != uint(program[21])
            || uint(aggregate_header[8]) != uint(program[22])
            || (aggregate_header[8] >> 32u) != 0ul
            || args.aggregate_cell_words < aggregate_cell_count * 3ul
            || args.aggregate_arena_storage_bytes < max(aggregate_arena_bytes, 1ul)
            || atomic_load_explicit(&graph_control[0], memory_order_relaxed)
                != IG_SEGMENTED_STATUS_SUCCESS
            || atomic_load_explicit(&graph_control[1], memory_order_relaxed)
                != IG_SEGMENTED_PHASE_COMPLETE
            || atomic_load_explicit(&graph_control[2], memory_order_relaxed)
                != uint(source_rows)
            || atomic_load_explicit(&graph_control[7], memory_order_relaxed)
                != IG_SEGMENTED_GRAPH_CONTROL_READY) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
        return;
    }
    for (ulong lane = 0ul; lane < 4ul; ++lane) {
        if (aggregate_header[9ul + lane] != program[37ul + lane]) {
            ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
            return;
        }
    }
    if (!ig_segmented_graph_aggregate_relation_valid(
            program,
            aggregate_cells,
            aggregate_arena_bytes,
            generic_rows,
            aggregate_columns,
            aggregate_cell_count)) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
        return;
    }

    ulong receipt_count = program[14];
    for (ulong receipt = 0ul; receipt < receipt_count; ++receipt) {
        ulong descriptor = program[50]
            + receipt * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS;
        ulong record = receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        if (outer_receipts[record] != program[descriptor]
                || outer_receipts[record + 1ul] != program[descriptor + 1ul]) {
            ig_segmented_graph_fail(output_header, IG_SEGMENTED_STATUS_INVALID_RECEIPT);
            return;
        }
        ulong role = program[descriptor + 2ul];
        bool staged_cardinality = (source_kind
                    == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
                && (role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_PROJECT
                    || role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_UNWIND
                    || role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_ORDER))
            || (source_kind == IG_SEGMENTED_GRAPH_SOURCE_GRAPH
                && role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_ORDER
                && program[54] != 0ul
                && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC)
            || (source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
                && (role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_KEYS
                    || role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_UNWIND))
            || (source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
                && role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_VALUE)
            || (source_kind == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH
                && (role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_AGGREGATE
                    || role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_REDUCTION
                    || role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_PROJECT
                    || role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_UNWIND));
        for (ulong word = 2ul; word < IG_SEGMENTED_GRAPH_RECEIPT_WORDS; ++word) {
            if (!(staged_cardinality && word == 7ul)
                    && outer_receipts[record + word] != 0ul) {
                ig_segmented_graph_fail(output_header, IG_SEGMENTED_STATUS_INVALID_RECEIPT);
                return;
            }
        }
    }

    ulong actual_source_rows = source_rows;
    ulong effective_rows = program[5] != 0ul && actual_source_rows == 0ul
        ? 0ul : generic_rows;
    if (effective_rows > generic_rows || generic_rows > program[23]) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
        return;
    }
    if (source_kind == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER) {
        ulong unit_kind = ig_segmented_unit_kind(program);
        ulong maximum_list_items = ig_segmented_unit_maximum_list_items(program);
        ulong expected_rows = 1ul;
        for (ulong receipt = 1ul;
                receipt <= ig_segmented_graph_pre_stage_count(program);
                ++receipt) {
            ulong descriptor = program[50]
                + receipt * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS;
            ulong record = receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
            ulong role = program[descriptor + 2ul];
            ulong packed = outer_receipts[record + 7ul];
            ulong input_rows = uint(packed);
            ulong output_rows = uint(packed >> 32u);
            ulong maximum_rows = 0ul;
            bool exact = input_rows == expected_rows;
            if (unit_kind == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY) {
                if (role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_PROJECT) {
                    exact = exact && output_rows == input_rows
                        && (receipt == 1ul || receipt == 2ul || receipt == 4ul);
                } else if (role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_UNWIND) {
                    exact = exact && receipt == 3ul && input_rows == 1ul
                        && output_rows == program[17]
                        && output_rows <= maximum_list_items;
                } else if (role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_ORDER) {
                    exact = exact && receipt == 5ul && output_rows == input_rows;
                } else {
                    exact = false;
                }
            } else if (role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_PROJECT) {
                exact = exact && receipt == 1ul && output_rows == input_rows;
            } else if (role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_UNWIND) {
                exact = exact && receipt > 1ul
                    && ig_segmented_graph_product(
                        input_rows, maximum_list_items, maximum_rows)
                    && output_rows <= maximum_rows;
            } else {
                exact = false;
            }
            if (!exact) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                return;
            }
            expected_rows = output_rows;
        }
        if (expected_rows != actual_source_rows) {
            ig_segmented_graph_fail(
                output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
            return;
        }
    } else if (source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS) {
        ulong property_record = IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        ulong unwind_record = property_record + IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        ulong property_packed = outer_receipts[property_record + 7ul];
        ulong unwind_packed = outer_receipts[unwind_record + 7ul];
        ulong maximum_rows = 0ul;
        if (uint(property_packed) != uint(property_entity_rows)
                || uint(property_packed >> 32u) != uint(property_entity_rows)
                || uint(unwind_packed) != uint(property_entity_rows)
                || uint(unwind_packed >> 32u) != uint(actual_source_rows)
                || !ig_segmented_graph_product(
                    property_entity_rows,
                    program[ig_segmented_property_keys_base(program) + 2ul],
                    maximum_rows)
                || actual_source_rows > maximum_rows) {
            ig_segmented_graph_fail(
                output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
            return;
        }
    } else if (source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE) {
        ulong property_record = IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        ulong property_packed = outer_receipts[property_record + 7ul];
        if (uint(property_packed) != uint(actual_source_rows)
                || uint(property_packed >> 32u) != uint(actual_source_rows)) {
            ig_segmented_graph_fail(
                output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
            return;
        }
    } else if (source_kind == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH) {
        for (ulong receipt = 1ul; receipt <= 6ul; ++receipt) {
            ulong packed = outer_receipts[
                receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS + 7ul];
            ulong expected_input = receipt <= 4ul
                ? actual_source_rows : generic_rows;
            ulong expected_output = receipt <= 5ul
                ? generic_rows : actual_source_rows;
            if (uint(packed) != uint(expected_input)
                    || uint(packed >> 32u) != uint(expected_output)) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                return;
            }
        }
    } else if (source_kind == IG_SEGMENTED_GRAPH_SOURCE_GRAPH
            && program[54] != 0ul
            && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC) {
        ulong order_record = IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
        ulong packed = outer_receipts[order_record + 7ul];
        if (uint(packed) != uint(actual_source_rows)
                || uint(packed >> 32u) != uint(actual_source_rows)) {
            ig_segmented_graph_fail(
                output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
            return;
        }
    }
    // Dependency records are immutable source evidence.  Touch the final record only after all
    // header bounds have been checked so the compiler cannot dead-strip this preservation edge.
    ulong dependency_count = (source_kind == IG_SEGMENTED_GRAPH_SOURCE_GRAPH
            || source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
            || source_kind == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH)
        ? actual_source_rows * program[4]
        : source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
            ? property_entity_rows * program[4] : 0ul;
    if (dependency_count != uint(output_header[7] >> 32u)
            || dependency_count > program[26]
            || args.dependency_words < dependency_count * 2ul) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
        return;
    }
    if (dependency_count != 0ul) {
        ulong last = (dependency_count - 1ul) * 2ul;
        if (dependencies[last] > 2ul) {
            ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
            return;
        }
    }

    ulong slot_count = program[7];
    ulong maximum_groups = program[23];
    ulong slot_word_count = 0ul;
    ulong projection_word_count = 0ul;
    ulong row_map_base = 0ul;
    ulong cardinality_ledger_base = 0ul;
    ulong projection_scratch_words = 0ul;
    ulong order_key_word_count = 0ul;
    if (!ig_segmented_graph_product(maximum_groups, slot_count, slot_word_count)
            || !ig_segmented_graph_product(slot_word_count, 3ul, slot_word_count)
            // The live projection region is fixed to the initial effective-row domain.  Later
            // filters may reduce `active_rows`, but no stage can address a physical row outside
            // this immutable bound or reach either private tail.
            || !ig_segmented_graph_product(
                effective_rows, program[15], projection_word_count)
            || !ig_segmented_graph_product(
                projection_word_count, 3ul, projection_word_count)
            || !ig_segmented_graph_sum(
                projection_word_count, effective_rows, cardinality_ledger_base)
            || !ig_segmented_graph_sum(
                cardinality_ledger_base, program[9], projection_scratch_words)
            || !ig_segmented_graph_product(
                maximum_groups, program[16], order_key_word_count)
            || !ig_segmented_graph_product(
                order_key_word_count, 3ul, order_key_word_count)
            || args.slot_cell_words < slot_word_count
            || args.projection_result_cell_words < projection_scratch_words
            || args.order_row_elems < maximum_groups
            || args.order_key_cell_words < order_key_word_count) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY);
        return;
    }
    row_map_base = projection_word_count;
    for (ulong word = 0ul; word < slot_word_count; ++word) slot_cells[word] = 0ul;
    for (ulong word = 0ul; word < projection_scratch_words; ++word) {
        projection_result_cells[word] = 0ul;
    }
    for (ulong word = 0ul; word < order_key_word_count; ++word) {
        order_key_cells[word] = 0ul;
    }
    for (ulong row = 0ul; row < effective_rows; ++row) order_rows[row] = uint(row);

    for (ulong mapping = 0ul; mapping < program[8]; ++mapping) {
        ulong descriptor = program[44]
            + mapping * IG_SEGMENTED_GRAPH_INITIAL_WORDS;
        ulong slot = program[descriptor];
        ulong column = program[descriptor + 1ul];
        if (slot >= slot_count || column >= aggregate_columns) {
            ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
            return;
        }
        for (ulong row = 0ul; row < effective_rows; ++row) {
            ulong source = row * aggregate_columns + column;
            ulong target = row * slot_count + slot;
            IgSegmentedCellValue value = ig_segmented_input_cell(
                aggregate_cells, uint(source));
            if (!ig_segmented_graph_cell_valid(
                    value,
                    aggregate_arena_bytes,
                    expected_aggregate_cells,
                    aggregate_cell_count)) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                return;
            }
            ig_segmented_write_cell(slot_cells, uint(target), value);
        }
    }

    device ulong* row_map = projection_result_cells + row_map_base;
    device ulong* cardinality_ledger = projection_result_cells + cardinality_ledger_base;
    ulong active_rows = effective_rows;
    for (ulong stage = 0ul; stage < program[9]; ++stage) {
        ulong stage_descriptor = program[45]
            + stage * IG_SEGMENTED_GRAPH_STAGE_WORDS;
        ulong kind = program[stage_descriptor];
        ulong item_start = program[stage_descriptor + 1ul];
        ulong item_count = program[stage_descriptor + 2ul];
        ulong rows = program[stage_descriptor + 3ul];
        ulong stage_input_rows = active_rows;
        if (kind == IG_SEGMENTED_GRAPH_STAGE_PROJECT) {
            for (ulong position = 0ul; position < active_rows; ++position) {
                ulong row = order_rows[position];
                if (row >= effective_rows) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                    return;
                }
                for (ulong item = 0ul; item < item_count; ++item) {
                    ulong projection = item_start + item;
                    ulong descriptor = program[46]
                        + projection * IG_SEGMENTED_GRAPH_PROJECTION_WORDS;
                    IgSegmentedCellValue value;
                    uint status = ig_segmented_graph_evaluate_expression(
                        program,
                        aggregate_arena,
                        program[descriptor + 1ul],
                        program[descriptor + 2ul],
                        slot_cells,
                        row,
                        slot_count,
                        aggregate_cells,
                        aggregate_cell_count,
                        value);
                    if (status != 0u
                            || !ig_segmented_graph_cell_valid(
                                value,
                                aggregate_arena_bytes,
                                expected_aggregate_cells,
                                aggregate_cell_count)) {
                        ig_segmented_graph_fail(
                            output_header,
                            status != 0u ? status
                                : IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                        return;
                    }
                    ulong scratch = row * program[15] + item;
                    ig_segmented_write_cell(projection_result_cells, uint(scratch), value);
                }
                // Projection bindings are simultaneous: no expression can observe another output
                // from this same stage before every right-hand side has succeeded.
                for (ulong item = 0ul; item < item_count; ++item) {
                    ulong projection = item_start + item;
                    ulong descriptor = program[46]
                        + projection * IG_SEGMENTED_GRAPH_PROJECTION_WORDS;
                    ulong output_slot = program[descriptor];
                    ulong scratch = row * program[15] + item;
                    IgSegmentedCellValue value = ig_segmented_input_cell(
                        projection_result_cells, uint(scratch));
                    ig_segmented_write_cell(
                        slot_cells, uint(row * slot_count + output_slot), value);
                }
            }
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_ORDER) {
            for (ulong position = 0ul; position < active_rows; ++position) {
                ulong row = order_rows[position];
                if (row >= effective_rows) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                    return;
                }
                for (ulong item = 0ul; item < item_count; ++item) {
                    ulong order = item_start + item;
                    ulong descriptor = program[47]
                        + order * IG_SEGMENTED_GRAPH_ORDER_WORDS;
                    IgSegmentedCellValue value;
                    uint status = ig_segmented_graph_evaluate_expression(
                        program,
                        aggregate_arena,
                        program[descriptor],
                        program[descriptor + 1ul],
                        slot_cells,
                        row,
                        slot_count,
                        aggregate_cells,
                        aggregate_cell_count,
                        value);
                    if (status != 0u
                            || !ig_segmented_graph_cell_valid(
                                value,
                                aggregate_arena_bytes,
                                expected_aggregate_cells,
                                aggregate_cell_count)
                            || value.tag == IG_SEGMENTED_VALUE_LIST) {
                        ig_segmented_graph_fail(
                            output_header,
                            status != 0u ? status
                                : value.tag == IG_SEGMENTED_VALUE_LIST
                                    ? IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE
                                : IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                        return;
                    }
                    ulong key = row * program[16] + item;
                    ig_segmented_write_cell(order_key_cells, uint(key), value);
                }
            }
            // Stable insertion sort is intentionally serial.  It is deterministic for equal keys
            // and avoids exposing any host-selected segments or permutation.
            for (ulong position = 1ul; position < active_rows; ++position) {
                uint candidate = order_rows[position];
                ulong destination = position;
                while (destination != 0ul) {
                    uint prior = order_rows[destination - 1ul];
                    int ordering = 0;
                    for (ulong item = 0ul; item < item_count; ++item) {
                        ulong descriptor = program[47]
                            + (item_start + item) * IG_SEGMENTED_GRAPH_ORDER_WORDS;
                        IgSegmentedCellValue left = ig_segmented_input_cell(
                            order_key_cells,
                            uint(ulong(candidate) * program[16] + item));
                        IgSegmentedCellValue right = ig_segmented_input_cell(
                            order_key_cells,
                            uint(ulong(prior) * program[16] + item));
                        ordering = ig_segmented_graph_order_cells(
                            program,
                            descriptor,
                            aggregate_arena,
                            left,
                            right,
                            program[descriptor + 2ul]);
                        if (ordering != 0) break;
                    }
                    if (ordering >= 0) break;
                    order_rows[destination] = prior;
                    --destination;
                }
                order_rows[destination] = candidate;
            }
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_FILTER) {
            ulong kept_rows = 0ul;
            for (ulong position = 0ul; position < stage_input_rows; ++position) {
                ulong row = order_rows[position];
                if (row >= effective_rows) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                    return;
                }
                IgSegmentedCellValue predicate;
                uint status = ig_segmented_graph_evaluate_expression(
                    program,
                    aggregate_arena,
                    item_start,
                    item_count,
                    slot_cells,
                    row,
                    slot_count,
                    aggregate_cells,
                    aggregate_cell_count,
                    predicate);
                if (status != 0u
                        || !ig_segmented_graph_cell_valid(
                            predicate,
                            aggregate_arena_bytes,
                            expected_aggregate_cells,
                            aggregate_cell_count)) {
                    ig_segmented_graph_fail(
                        output_header,
                        status != 0u ? status
                            : IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                    return;
                }
                if (predicate.tag == IG_SEGMENTED_VALUE_NULL) continue;
                if (predicate.tag != IG_SEGMENTED_VALUE_BOOLEAN) {
                    // A typed failure is never reinterpreted as a false predicate.  No outer
                    // receipt has been touched, so later publication remains transactional.
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE);
                    return;
                }
                if (predicate.payload != 0ul) {
                    // `kept_rows <= position`, so this stable logical compaction never overwrites
                    // an order entry that has not yet supplied its predicate row.
                    order_rows[kept_rows++] = uint(row);
                }
            }

            // Label the current physical rows in both directions.  The packed map lets cycles
            // such as [2,0,1] and reverse order be applied with whole-row swaps while the compact
            // prefix retains the exact prior logical order.
            for (ulong row = 0ul; row < effective_rows; ++row) {
                row_map[row] = row | (row << 32u);
            }
            for (ulong destination = 0ul; destination < kept_rows; ++destination) {
                ulong desired_original = order_rows[destination];
                if (desired_original >= effective_rows) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                    return;
                }
                ulong source_physical = ulong(
                    ig_segmented_graph_map_original_physical(
                        row_map, desired_original));
                ulong displaced_original = ulong(
                    ig_segmented_graph_map_physical_original(row_map, destination));
                if (source_physical < destination || source_physical >= effective_rows
                        || displaced_original >= effective_rows
                        || ulong(ig_segmented_graph_map_physical_original(
                            row_map, source_physical)) != desired_original
                        || ulong(ig_segmented_graph_map_original_physical(
                            row_map, displaced_original)) != destination) {
                    // `source_physical < destination` also proves a duplicate kept locator: every
                    // already-consumed original is fixed strictly before this destination.
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                    return;
                }
                if (source_physical != destination) {
                    for (ulong slot = 0ul; slot < slot_count; ++slot) {
                        ulong source_cell = source_physical * slot_count + slot;
                        ulong destination_cell = destination * slot_count + slot;
                        IgSegmentedCellValue desired_value = ig_segmented_input_cell(
                            slot_cells, uint(source_cell));
                        IgSegmentedCellValue displaced_value = ig_segmented_input_cell(
                            slot_cells, uint(destination_cell));
                        ig_segmented_write_cell(
                            slot_cells, uint(destination_cell), desired_value);
                        ig_segmented_write_cell(
                            slot_cells, uint(source_cell), displaced_value);
                    }
                    // The four indices can alias across their low/high halves.  Each helper is a
                    // read/modify/write of only one half, so this order preserves the other map.
                    ig_segmented_graph_map_set_original_physical(
                        row_map, desired_original, uint(destination));
                    ig_segmented_graph_map_set_original_physical(
                        row_map, displaced_original, uint(source_physical));
                    ig_segmented_graph_map_set_physical_original(
                        row_map, destination, uint(desired_original));
                    ig_segmented_graph_map_set_physical_original(
                        row_map, source_physical, uint(displaced_original));
                }
                order_rows[destination] = uint(destination);
            }
            active_rows = kept_rows;
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_SKIP) {
            ulong skipped = min(rows, active_rows);
            ulong remaining = active_rows - skipped;
            for (ulong row = 0ul; row < remaining; ++row) {
                order_rows[row] = order_rows[row + skipped];
            }
            active_rows = remaining;
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_LIMIT) {
            active_rows = min(active_rows, rows);
        } else {
            ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_STAGE);
            return;
        }
        cardinality_ledger[stage] = stage_input_rows | (active_rows << 32u);
    }

    ulong output_columns = program[13];
    ulong total_cells = 0ul;
    ulong arena_required = 0ul;
    ulong property_value_base = ig_segmented_property_value_base(program);
    bool property_value_lists = source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
        && program[property_value_base + 2ul]
            == IG_SEGMENTED_PROPERTY_VALUE_FLAT_LIST_GROUP;
    if (property_value_lists) {
        uint status = ig_segmented_graph_emit_property_value_lists(
            program,
            aggregate_arena,
            aggregate_arena_bytes,
            slot_cells,
            slot_count,
            order_rows,
            effective_rows,
            active_rows,
            output_cells,
            output_arena,
            args,
            total_cells,
            arena_required);
        if (status != 0u) {
            ig_segmented_graph_fail(output_header, status);
            return;
        }
    } else if (program[54] != 0ul
            && program[program[54]] == IG_SEGMENTED_KEY_VALUE_LIST_MAGIC) {
        uint status = ig_segmented_graph_emit_key_value_lists(
            program,
            aggregate_arena,
            aggregate_arena_bytes,
            slot_cells,
            slot_count,
            order_rows,
            effective_rows,
            active_rows,
            output_cells,
            output_arena,
            args,
            total_cells,
            arena_required);
        if (status != 0u) {
            ig_segmented_graph_fail(output_header, status);
            return;
        }
    } else {
    ulong top_level_cells = 0ul;
    bool map_extension = program[54] != 0ul
        && program[program[54]] == IG_SEGMENTED_GRAPH_MAP_MAGIC;
    ulong map_slot = map_extension ? program[program[54] + 2ul] : ~0ul;
    if (!ig_segmented_graph_product(active_rows, output_columns, top_level_cells)) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY);
        return;
    }
    ulong appended_required = 0ul;
    for (ulong position = 0ul; position < active_rows; ++position) {
        ulong row = order_rows[position];
        if (row >= effective_rows) {
            ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
            return;
        }
        for (ulong column = 0ul; column < output_columns; ++column) {
            ulong slot = program[program[49] + column];
            if (map_extension && slot == map_slot) {
                ulong document_bytes = 0ul;
                uint status = ig_segmented_graph_map_document_bytes(
                    program,
                    aggregate_cells,
                    aggregate_cell_count,
                    aggregate_arena,
                    aggregate_arena_bytes,
                    slot_cells,
                    row,
                    slot_count,
                    document_bytes);
                if (status != 0u) {
                    ig_segmented_graph_fail(output_header, status);
                    return;
                }
                if (!ig_segmented_graph_range(
                        arena_required, document_bytes, program[25])) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY);
                    return;
                }
                arena_required += document_bytes;
                continue;
            }
            IgSegmentedCellValue value = ig_segmented_input_cell(
                slot_cells, uint(row * slot_count + slot));
            if (!ig_segmented_graph_cell_valid(
                    value,
                    aggregate_arena_bytes,
                    expected_aggregate_cells,
                    aggregate_cell_count)) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                return;
            }
            if (value.tag == IG_SEGMENTED_VALUE_LIST) {
                if (!ig_segmented_graph_range(
                        appended_required, value.auxiliary, program[24])) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY);
                    return;
                }
                appended_required += value.auxiliary;
                for (ulong child_offset = 0ul;
                        child_offset < value.auxiliary;
                        ++child_offset) {
                    IgSegmentedCellValue child = ig_segmented_input_cell(
                        aggregate_cells, uint(value.payload + child_offset));
                    if (child.tag == IG_SEGMENTED_VALUE_NULL
                            || !ig_segmented_graph_scalar_cell_valid(
                                child, aggregate_arena_bytes)) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                        return;
                    }
                    if (child.tag != IG_SEGMENTED_VALUE_STRING
                            && child.tag != IG_SEGMENTED_VALUE_BYTES) continue;
                    if (!ig_segmented_graph_range(
                            arena_required, child.auxiliary, program[25])) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY);
                        return;
                    }
                    arena_required += child.auxiliary;
                }
            } else if (value.tag == IG_SEGMENTED_VALUE_STRING
                    || value.tag == IG_SEGMENTED_VALUE_BYTES) {
                if (!ig_segmented_graph_range(
                        arena_required, value.auxiliary, program[25])) {
                    ig_segmented_graph_fail(
                        output_header, IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY);
                    return;
                }
                arena_required += value.auxiliary;
            }
        }
    }
    if (!ig_segmented_graph_sum(top_level_cells, appended_required, total_cells)
            || total_cells > program[24]
            || args.output_cell_words < total_cells * 3ul
            || arena_required > program[25]
            || args.output_arena_storage_bytes < max(arena_required, 1ul)
            || arena_required > 0xfffffffful || total_cells > 0xfffffffful) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY);
        return;
    }

    uint appended_cursor = 0u;
    uint arena_cursor = 0u;
    for (ulong position = 0ul; position < active_rows; ++position) {
        ulong row = order_rows[position];
        for (ulong column = 0ul; column < output_columns; ++column) {
            ulong slot = program[program[49] + column];
            uint destination = uint(position * output_columns + column);
            if (map_extension && slot == map_slot) {
                uint document_start = arena_cursor;
                uint status = ig_segmented_graph_write_map_document(
                    program,
                    aggregate_cells,
                    aggregate_cell_count,
                    aggregate_arena,
                    aggregate_arena_bytes,
                    slot_cells,
                    row,
                    slot_count,
                    output_arena,
                    uint(args.output_arena_storage_bytes),
                    arena_cursor);
                if (status != 0u) {
                    ig_segmented_graph_fail(output_header, status);
                    return;
                }
                IgSegmentedCellValue document;
                document.tag = IG_SEGMENTED_VALUE_MAP;
                document.payload = ulong(document_start);
                document.auxiliary = ulong(arena_cursor - document_start);
                ig_segmented_write_cell(output_cells, destination, document);
                continue;
            }
            IgSegmentedCellValue value = ig_segmented_input_cell(
                slot_cells, uint(row * slot_count + slot));
            if (value.tag == IG_SEGMENTED_VALUE_LIST) {
                IgSegmentedCellValue list = value;
                list.payload = top_level_cells + ulong(appended_cursor);
                ig_segmented_write_cell(output_cells, destination, list);
                for (ulong child_offset = 0ul;
                        child_offset < value.auxiliary;
                        ++child_offset) {
                    IgSegmentedCellValue child = ig_segmented_input_cell(
                        aggregate_cells, uint(value.payload + child_offset));
                    uint child_destination = uint(
                        top_level_cells + ulong(appended_cursor) + child_offset);
                    if (!ig_segmented_copy_input_cell(
                            aggregate_arena,
                            child,
                            output_cells,
                            child_destination,
                            output_arena,
                            uint(args.output_arena_storage_bytes),
                            arena_cursor)) {
                        ig_segmented_graph_fail(
                            output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                        return;
                    }
                }
                appended_cursor += uint(value.auxiliary);
                continue;
            }
            if (!ig_segmented_copy_input_cell(
                    aggregate_arena,
                    value,
                    output_cells,
                    destination,
                    output_arena,
                    uint(args.output_arena_storage_bytes),
                    arena_cursor)) {
                ig_segmented_graph_fail(
                    output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
                return;
            }
        }
    }
    if (ulong(appended_cursor) != appended_required
            || ulong(arena_cursor) != arena_required) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
        return;
    }
    }

    // Replay the private per-stage ledger before touching any receipt, keeping failure publication
    // transactional even when a later stage or output copy fails after one or more filters.
    ulong replayed_cardinality = effective_rows;
    for (ulong stage = 0ul; stage < program[9]; ++stage) {
        ulong descriptor = program[45]
            + stage * IG_SEGMENTED_GRAPH_STAGE_WORDS;
        ulong kind = program[descriptor];
        ulong rows = program[descriptor + 3ul];
        ulong packed = cardinality_ledger[stage];
        ulong input_rows = uint(packed);
        ulong output_rows = uint(packed >> 32u);
        bool exact = input_rows == replayed_cardinality;
        if (kind == IG_SEGMENTED_GRAPH_STAGE_PROJECT
                || kind == IG_SEGMENTED_GRAPH_STAGE_ORDER) {
            exact = exact && output_rows == input_rows;
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_SKIP) {
            exact = exact && output_rows == input_rows - min(input_rows, rows);
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_LIMIT) {
            exact = exact && output_rows == min(input_rows, rows);
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_FILTER) {
            exact = exact && output_rows <= input_rows;
        } else {
            exact = false;
        }
        if (!exact) {
            ig_segmented_graph_fail(
                output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
            return;
        }
        replayed_cardinality = output_rows;
    }
    if (replayed_cardinality != active_rows) {
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS);
        return;
    }

    // Complete source, aggregation, and reduction receipts only after output preflight and copy
    // have succeeded.  Post-stage cardinalities come only from the validated private ledger.
    for (ulong receipt = 0ul; receipt < receipt_count; ++receipt) {
        ulong descriptor = program[50]
            + receipt * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS;
        ulong role = program[descriptor + 2ul];
        if (role == IG_SEGMENTED_GRAPH_RECEIPT_SOURCE) {
            ig_segmented_graph_complete_receipt(
                outer_receipts + receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS,
                program[2], program[3], 1ul,
                source_kind == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
                    ? 1ul
                    : source_kind == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
                        ? property_entity_rows : actual_source_rows);
        } else if (role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_PROJECT
                || role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_UNWIND
                || role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_ORDER
                || role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_KEYS
                || role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_UNWIND
                || role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_VALUE
                || role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_AGGREGATE
                || role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_REDUCTION
                || role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_PROJECT
                || role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_UNWIND) {
            ulong record = receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS;
            ulong packed = outer_receipts[record + 7ul];
            ig_segmented_graph_complete_receipt(
                outer_receipts + record,
                program[2], program[3], uint(packed), uint(packed >> 32u));
        } else if (role == IG_SEGMENTED_GRAPH_RECEIPT_AGGREGATE
                || role == IG_SEGMENTED_GRAPH_RECEIPT_REDUCTION) {
            ig_segmented_graph_complete_receipt(
                outer_receipts + receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS,
                program[2], program[3], actual_source_rows, effective_rows);
        }
    }
    for (ulong stage = 0ul; stage < program[9]; ++stage) {
        ulong descriptor = program[45]
            + stage * IG_SEGMENTED_GRAPH_STAGE_WORDS;
        ulong receipt = program[descriptor + 4ul];
        ulong packed = cardinality_ledger[stage];
        ulong input_rows = uint(packed);
        ulong output_rows = uint(packed >> 32u);
        ig_segmented_graph_complete_receipt(
            outer_receipts + receipt * IG_SEGMENTED_GRAPH_RECEIPT_WORDS,
            program[2], program[3], input_rows, output_rows);
    }
    output_header[4] = active_rows | (output_columns << 32u);
    output_header[5] = total_cells | (arena_required << 32u);
    ig_segmented_graph_header_status(
        output_header, IG_SEGMENTED_STATUS_SUCCESS, IG_SEGMENTED_PHASE_COMPLETE);
}

// ---- Execution-scoped typed procedure-table selection -------------------------------
// Input packet (ulong words):
//   0 ABI, 1 reserved, 2..3 execution, 4 rows|inputs, 5 output capacity,
//   6 obligation id, 7 obligation metadata, 8..11 table fingerprint,
//   12..15 request fingerprint, 16 descriptor width, then ten-word input descriptors.
// The first kernel compares independent source rows in parallel. Stable compaction is performed
// by the shared native prefix-scan. The second kernel validates that ordered device result and
// publishes the only host-visible row IDs and completion receipt.

constant ulong IG_PROCEDURE_TABLE_ABI = 0x0000000147435054ul;
constant uint IG_PROCEDURE_TABLE_DESCRIPTOR_WORDS = 10u;
constant uint IG_PROCEDURE_TABLE_STATUS_SUCCESS = 1u;
constant uint IG_PROCEDURE_TABLE_PHASE_COMPLETE = 1u;

struct ProcedureTableMatchArgs {
    uint row_count;
    uint input_count;
    uint descriptor_base;
    uint descriptor_words;
    uint packet_words;
    uint arena_bytes;
};

inline bool ig_procedure_word_range(
    ulong offset,
    ulong count,
    constant ProcedureTableMatchArgs& args) {
    return offset <= ulong(args.packet_words)
        && count <= ulong(args.packet_words) - offset;
}

inline bool ig_procedure_string_equal(
    device const ulong* packet,
    device const uchar* arena,
    device const ulong* descriptor,
    uint row,
    constant ProcedureTableMatchArgs& args) {
    ulong offsets = descriptor[2];
    if (!ig_procedure_word_range(offsets, ulong(args.row_count) + 1ul, args)) return false;
    ulong relative_start = packet[offsets + ulong(row)];
    ulong relative_end = packet[offsets + ulong(row) + 1ul];
    if (relative_start > relative_end) return false;
    ulong table_start = descriptor[5] + relative_start;
    ulong table_end = descriptor[5] + relative_end;
    ulong argument_start = descriptor[7];
    ulong argument_length = descriptor[8];
    if (table_start > table_end
            || table_end > ulong(args.arena_bytes)
            || argument_start > ulong(args.arena_bytes)
            || argument_length > ulong(args.arena_bytes) - argument_start
            || table_end - table_start != argument_length) return false;
    for (ulong byte = 0ul; byte < argument_length; ++byte) {
        if (arena[table_start + byte] != arena[argument_start + byte]) return false;
    }
    return true;
}

kernel void ig_procedure_table_match_program(
    device const ulong* packet [[buffer(0)]],
    device const uchar* arena [[buffer(1)]],
    device uchar* mask [[buffer(2)]],
    constant ProcedureTableMatchArgs& args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (row >= args.row_count) return;
    mask[row] = 0;
    if (args.packet_words < args.descriptor_base
            || packet[0] != IG_PROCEDURE_TABLE_ABI
            || uint(packet[4]) != args.row_count
            || uint(packet[4] >> 32u) != args.input_count
            || args.descriptor_words != IG_PROCEDURE_TABLE_DESCRIPTOR_WORDS
            || packet[16] != ulong(IG_PROCEDURE_TABLE_DESCRIPTOR_WORDS)) return;
    ulong descriptor_end = ulong(args.descriptor_base)
        + ulong(args.input_count) * ulong(args.descriptor_words);
    if (descriptor_end > ulong(args.packet_words)) return;

    for (uint input = 0u; input < args.input_count; ++input) {
        device const ulong* descriptor = packet + args.descriptor_base
            + input * args.descriptor_words;
        ulong validity = descriptor[1];
        if (!ig_procedure_word_range(validity, ulong(args.row_count), args)) return;
        bool present = packet[validity + ulong(row)] != 0ul;
        uint argument_tag = uint(descriptor[6]);
        if (argument_tag == 0u) {
            if (present) return;
            continue;
        }
        if (!present) return;

        uint value_type = uint(descriptor[0]);
        ulong payload0 = descriptor[2];
        if (value_type == 1u) {
            if (argument_tag != 1u
                    || !ig_procedure_word_range(payload0, ulong(args.row_count), args)
                    || packet[payload0 + ulong(row)] != descriptor[7]) return;
            continue;
        }
        if (value_type == 2u) {
            if (argument_tag != 2u
                    || !ig_procedure_word_range(payload0, ulong(args.row_count), args)
                    || packet[payload0 + ulong(row)] != descriptor[7]) return;
            continue;
        }
        if (value_type == 3u) {
            if (argument_tag != 3u
                    || !ig_procedure_word_range(payload0, ulong(args.row_count), args)
                    || !ig_scalar_f64_equal(packet[payload0 + ulong(row)], descriptor[7])) return;
            continue;
        }
        if (value_type == 4u) {
            ulong kinds = descriptor[2];
            ulong integers = descriptor[3];
            ulong floats = descriptor[4];
            if (!ig_procedure_word_range(kinds, ulong(args.row_count), args)
                    || !ig_procedure_word_range(integers, ulong(args.row_count), args)
                    || !ig_procedure_word_range(floats, ulong(args.row_count), args)) return;
            uint kind = uint(packet[kinds + ulong(row)]);
            bool equal = false;
            if (kind == 1u && argument_tag == 2u) {
                equal = packet[integers + ulong(row)] == descriptor[7];
            } else if (kind == 2u && argument_tag == 3u) {
                equal = ig_scalar_f64_equal(packet[floats + ulong(row)], descriptor[7]);
            } else if (kind == 1u && argument_tag == 3u) {
                equal = ig_scalar_i64_f64_equal(
                    as_type<long>(packet[integers + ulong(row)]), descriptor[7]);
            } else if (kind == 2u && argument_tag == 2u) {
                equal = ig_scalar_i64_f64_equal(
                    as_type<long>(descriptor[7]), packet[floats + ulong(row)]);
            }
            if (!equal) return;
            continue;
        }
        if (value_type == 5u) {
            if (argument_tag != 4u
                    || !ig_procedure_string_equal(packet, arena, descriptor, row, args)) return;
            continue;
        }
        return;
    }
    mask[row] = 1;
}

struct ProcedureTablePublishArgs {
    uint row_count;
    uint selected_count;
    uint maximum_output_rows;
    uint output_header_words;
    uint packet_words;
};

kernel void ig_procedure_table_publish_program(
    device const ulong* packet [[buffer(0)]],
    device const uint* selected [[buffer(1)]],
    device uchar* output_bytes [[buffer(2)]],
    constant ProcedureTablePublishArgs& args [[buffer(3)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u) return;
    device ulong* output = reinterpret_cast<device ulong*>(output_bytes);
    for (uint word = 0u; word < args.output_header_words; ++word) output[word] = 0ul;
    device uint* output_rows = reinterpret_cast<device uint*>(
        output_bytes + ulong(args.output_header_words) * 8ul);
    for (uint row = 0u; row < args.maximum_output_rows; ++row) output_rows[row] = 0u;
    output[0] = IG_PROCEDURE_TABLE_ABI;
    output[1] = ulong(2u) | (ulong(IG_PROCEDURE_TABLE_PHASE_COMPLETE) << 32u);
    if (args.packet_words < 17u
            || args.output_header_words < 25u
            || packet[0] != IG_PROCEDURE_TABLE_ABI
            || uint(packet[4]) != args.row_count
            || packet[5] != ulong(args.maximum_output_rows)) return;
    if (args.selected_count > args.maximum_output_rows) {
        output[1] = ulong(3u) | (ulong(IG_PROCEDURE_TABLE_PHASE_COMPLETE) << 32u);
        return;
    }
    uint previous = 0u;
    for (uint index = 0u; index < args.selected_count; ++index) {
        uint source = selected[index];
        if (source >= args.row_count || (index != 0u && source <= previous)) {
            output[1] = ulong(4u) | (ulong(IG_PROCEDURE_TABLE_PHASE_COMPLETE) << 32u);
            return;
        }
        output_rows[index] = source;
        previous = source;
    }
    output[2] = packet[2];
    output[3] = packet[3];
    output[4] = ulong(args.row_count);
    output[5] = ulong(args.selected_count);
    output[6] = ulong(args.maximum_output_rows);
    output[7] = packet[6];
    output[8] = packet[7];
    for (uint lane = 0u; lane < 4u; ++lane) {
        output[9u + lane] = packet[8u + lane];
        output[13u + lane] = packet[12u + lane];
    }
    output[17] = packet[2];
    output[18] = packet[3];
    output[19] = packet[6];
    output[20] = packet[7];
    output[21] = ulong(args.row_count);
    output[22] = ulong(args.selected_count);
    output[23] = 2ul; // ResidentDeviceCompletion::Metal
    output[24] = 0ul;
    output[1] = ulong(IG_PROCEDURE_TABLE_STATUS_SUCCESS)
        | (ulong(IG_PROCEDURE_TABLE_PHASE_COMPLETE) << 32u);
}

// Complete bounded variable-length path program. Frontier order is parent-major followed by the
// canonical CSR order (outgoing before incoming for undirected patterns). A serial device prefix
// computes deterministic scatter offsets; the host never reads a frontier or drives adjacency.
constant ulong IG_VARIABLE_PATH_ABI = 0x0000000647435650ul;
constant uint IG_VARIABLE_PATH_PACKET_HEADER_WORDS = 24u;
constant uint IG_VARIABLE_PATH_SEGMENT_WORDS = 7u;
constant uint IG_VARIABLE_PATH_OUTPUT_HEADER_WORDS = 24u;
constant uint IG_VARIABLE_PATH_RECEIPT_WORDS = 7u;
constant uint IG_VARIABLE_PATH_STATUS_RUNNING = 0u;
constant uint IG_VARIABLE_PATH_STATUS_SUCCESS = 1u;
constant uint IG_VARIABLE_PATH_STATUS_CORRUPT = 2u;
constant uint IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY = 3u;
constant uint IG_VARIABLE_PATH_STATUS_OUTPUT_CAPACITY = 4u;
constant uint IG_VARIABLE_PATH_STATUS_PATH_SHAPE = 5u;
constant uint IG_VARIABLE_PATH_STATUS_INVISIBLE_INPUT = 6u;
constant uint IG_VARIABLE_PATH_PHASE_INITIALIZE = 1u;
constant uint IG_VARIABLE_PATH_PHASE_TRAVERSE = 2u;
constant uint IG_VARIABLE_PATH_PHASE_COMPLETE = 3u;
constant uint IG_VARIABLE_PATH_CONTROL_STATUS = 0u;
constant uint IG_VARIABLE_PATH_CONTROL_PHASE = 1u;
constant uint IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT = 2u;
constant uint IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT = 3u;
constant uint IG_VARIABLE_PATH_CONTROL_SELECTED_STARTS = 4u;
constant uint IG_VARIABLE_PATH_CONTROL_SEGMENT_INPUT = 5u;
constant uint IG_VARIABLE_PATH_CONTROL_COPY_COUNT = 6u;
constant uint IG_VARIABLE_PATH_CONTROL_COPY_DESTINATION = 7u;
constant uint IG_VARIABLE_PATH_CONTROL_NEXT_COUNT = 8u;
constant uint IG_VARIABLE_PATH_CONTROL_SEGMENT = 9u;
constant uint IG_VARIABLE_PATH_CONTROL_PARENT_COUNT = 10u;
constant uint IG_VARIABLE_PATH_CONTROL_COMBINED_STARTS = 11u;
constant uint IG_VARIABLE_PATH_CONTROL_SELECTED_TERMINALS = 12u;
constant uint IG_VARIABLE_PATH_CONTROL_PRE_FINAL_COUNT = 13u;
constant uint IG_VARIABLE_PATH_CONTROL_KEPT_COUNT = 14u;
constant uint IG_VARIABLE_PATH_CONTROL_NULL_COUNT = 15u;
constant uint IG_VARIABLE_PATH_CONTROL_CARDINALITIES = 16u;
constant uint IG_VARIABLE_PATH_NULL_ROW = 0xffffffffu;
constant ulong IG_VARIABLE_PATH_EMPTY_RANGE_FLAG = 1ul << 63u;
constant ulong IG_VARIABLE_PATH_MAXIMUM_MASK = 0xfffffffful;
constant ulong IG_VARIABLE_PATH_KNOWN_EMPTY_TYPE_FLAG = 1ul << 63u;
constant ulong IG_VARIABLE_PATH_TYPE_COUNT_MASK = 0xfffffffful;

struct VariablePathArgs {
    ulong execution_high;
    ulong execution_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong scan_obligation_id;
    ulong bound_terminal_obligation_id;
    ulong cartesian_obligation_id;
    ulong final_obligation_id;
    ulong final_projection_argument;
    ulong final_projection_flags;
    ulong final_projection_capacity_0;
    ulong final_projection_capacity_1;
    ulong final_projection_operand_0;
    ulong final_projection_operand_1;
    ulong output_word_count;
