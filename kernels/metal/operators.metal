#include <metal_stdlib>
using namespace metal;

/// Highest valid value of the resident layer byte: OBSERVED=0, KNOWLEDGE=1, WORKSPACE=2.
/// Integrity checks compare against this rather than a literal so a fourth layer is a one-line
/// change instead of a hunt through every kernel.
constant uint IG_MAX_LAYER = 2u;
constant ulong IG_MAX_LAYER_UL = 2ul;
/// Every layer selected at once: the widest legal read mask, derived from the layer ceiling above.
constant ulong IG_MAX_LAYER_MASK = (1ul << (IG_MAX_LAYER_UL + 1ul)) - 1ul;


struct FilterI64Args {
    ulong row_count;
    long operand;
    uint operation;
};

kernel void ig_filter_i64(
    device const long* values [[buffer(0)]],
    device const uchar* validity [[buffer(1)]],
    device uchar* selected [[buffer(2)]],
    constant FilterI64Args& args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (row >= args.row_count || validity[row] == 0) {
        if (row < args.row_count) selected[row] = 0;
        return;
    }
    long value = values[row];
    bool keep = (args.operation == 0 && value == args.operand)
        || (args.operation == 1 && value != args.operand)
        || (args.operation == 2 && value < args.operand)
        || (args.operation == 3 && value <= args.operand)
        || (args.operation == 4 && value > args.operand)
        || (args.operation == 5 && value >= args.operand);
    selected[row] = keep ? 1 : 0;
}

kernel void ig_exact_l2(
    device const float* matrix [[buffer(0)]],
    device const float* query [[buffer(1)]],
    device float* distances [[buffer(2)]],
    constant uint& rows [[buffer(3)]],
    constant uint& dimension [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (row >= rows) return;
    float sum = 0.0f;
    for (uint coordinate = 0; coordinate < dimension; ++coordinate) {
        float delta = matrix[row * dimension + coordinate] - query[coordinate];
        sum = fma(delta, delta, sum);
    }
    distances[row] = sum;
}

struct ToBooleanArgs {
    ulong row_count;
};

inline uchar ig_ascii_lower(uchar value) {
    return value >= uchar('A') && value <= uchar('Z')
        ? uchar(value + (uchar('a') - uchar('A')))
        : value;
}

// Input tags: null=0, false=1, true=2, UTF-8 string=3, unsupported=4.
// Output tags: null=0, false=1, true=2, InvalidArgumentValue=3.
kernel void ig_to_boolean(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uchar* output_tags [[buffer(3)]],
    constant ToBooleanArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uchar tag = input_tags[row];
    if (tag <= 2) {
        output_tags[row] = tag;
        return;
    }
    if (tag != 3) {
        output_tags[row] = 3;
        return;
    }
    uint start = offsets[row];
    uint end = offsets[row + 1];
    if (end < start) {
        output_tags[row] = 0;
        return;
    }
    uint length = end - start;
    if (length == 4
        && ig_ascii_lower(utf8[start]) == uchar('t')
        && ig_ascii_lower(utf8[start + 1]) == uchar('r')
        && ig_ascii_lower(utf8[start + 2]) == uchar('u')
        && ig_ascii_lower(utf8[start + 3]) == uchar('e')) {
        output_tags[row] = 2;
    } else if (length == 5
        && ig_ascii_lower(utf8[start]) == uchar('f')
        && ig_ascii_lower(utf8[start + 1]) == uchar('a')
        && ig_ascii_lower(utf8[start + 2]) == uchar('l')
        && ig_ascii_lower(utf8[start + 3]) == uchar('s')
        && ig_ascii_lower(utf8[start + 4]) == uchar('e')) {
        output_tags[row] = 1;
    } else {
        output_tags[row] = 0;
    }
}

// The low two bits of each input tag encode null=0, UTF-8 string=1, unsupported=2; the upper
// bits select the temporal constructor. Output records use eight u32 words: null=0,
// date(epoch days)=1, local-time(nanos)=2, invalid argument=7.
struct TemporalValueProgramArgs {
    ulong row_count;
};

// Input follows the ordinary temporal byte stream until `zone_table_start`, followed by a
// serialized immutable IANA transition image. The kernel parses and resolves the datetime; this
// image merely supplies the authoritative zone rules for the bounded resident date range.
struct NamedDateTimeProgramArgs {
    ulong row_count;
    uint zone_table_start;
    uint zone_table_end;
    uint zone_count;
    uint reserved;
};

inline bool ig_temporal_ascii_digit(uchar value) {
    return value >= uchar('0') && value <= uchar('9');
}

inline uint ig_temporal_decimal(uchar value) {
    return uint(value - uchar('0'));
}

inline bool ig_temporal_leap_year(long year) {
    return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
}

inline uint ig_temporal_days_in_month(long year, uint month) {
    if (month == 2) return ig_temporal_leap_year(year) ? 29u : 28u;
    return (month == 1 || month == 3 || month == 5 || month == 7 || month == 8
            || month == 10 || month == 12) ? 31u : 30u;
}

// Howard Hinnant's proleptic-Gregorian civil-date conversion, with 1970-01-01 as day zero.
// All arithmetic and the resident epoch-day payload stay in signed 64-bit space.
inline long ig_temporal_days_from_civil(long year, uint month, uint day) {
    year -= month <= 2 ? 1 : 0;
    long era = (year >= 0 ? year : year - 399) / 400;
    uint year_of_era = uint(year - era * 400);
    uint march_month = month > 2 ? month - 3 : month + 9;
    uint day_of_year = (153 * march_month + 2) / 5 + day - 1;
    uint day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
    return era * 146097 + long(day_of_era) - 719468;
}

inline bool ig_temporal_digits(
    device const uchar* utf8,
    uint start,
    uint width) {
    for (uint index = 0; index < width; ++index) {
        if (!ig_temporal_ascii_digit(utf8[start + index])) return false;
    }
    return true;
}

inline uint ig_temporal_decimal(
    device const uchar* utf8,
    uint start,
    uint width) {
    uint value = 0;
    for (uint index = 0; index < width; ++index) {
        value = value * 10 + ig_temporal_decimal(utf8[start + index]);
    }
    return value;
}

inline uint ig_temporal_iso_weekday_from_epoch(long epoch_days) {
    long remainder = epoch_days % 7;
    if (remainder < 0) remainder += 7;
    return uint((remainder + 3) % 7 + 1);
}

inline bool ig_temporal_iso_year_has_53_weeks(long year) {
    long jan1 = ig_temporal_days_from_civil(year, 1, 1);
    uint weekday = ig_temporal_iso_weekday_from_epoch(jan1);
    return weekday == 4 || (weekday == 3 && ig_temporal_leap_year(year));
}

inline bool ig_temporal_calendar_days(
    long year,
    uint month,
    uint day,
    thread long& epoch_days) {
    if (month == 0 || month > 12 || day == 0 || day > ig_temporal_days_in_month(year, month)) {
        return false;
    }
    epoch_days = ig_temporal_days_from_civil(year, month, day);
    return true;
}

inline bool ig_temporal_iso_week_days(
    long year,
    uint week,
    uint weekday,
    thread long& epoch_days) {
    if (week == 0 || week > 53 || weekday == 0 || weekday > 7
            || (week == 53 && !ig_temporal_iso_year_has_53_weeks(year))) {
        return false;
    }
    long jan4 = ig_temporal_days_from_civil(year, 1, 4);
    long week_one_monday = jan4 - long(ig_temporal_iso_weekday_from_epoch(jan4) - 1);
    epoch_days = week_one_monday + long(week - 1) * 7 + long(weekday - 1);
    return true;
}

inline bool ig_temporal_ordinal_days(
    long year,
    uint ordinal,
    thread long& epoch_days) {
    uint maximum = ig_temporal_leap_year(year) ? 366u : 365u;
    if (ordinal == 0 || ordinal > maximum) return false;
    epoch_days = ig_temporal_days_from_civil(year, 1, 1) + long(ordinal - 1);
    return true;
}

inline bool ig_temporal_parse_expanded_calendar_date(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& epoch_days) {
    if (end < start || end - start < 10u) return false;
    uint month_separator = end - 6u;
    uint day_separator = end - 3u;
    if (utf8[month_separator] != uchar('-') || utf8[day_separator] != uchar('-')) return false;
    uint year_start = start;
    long sign = 1L;
    if (utf8[year_start] == uchar('+') || utf8[year_start] == uchar('-')) {
        sign = utf8[year_start] == uchar('-') ? -1L : 1L;
        year_start += 1u;
    }
    uint year_width = month_separator - year_start;
    if (year_width < 4u || year_width > 9u
            || !ig_temporal_digits(utf8, year_start, year_width)
            || !ig_temporal_digits(utf8, month_separator + 1u, 2u)
            || !ig_temporal_digits(utf8, day_separator + 1u, 2u)) return false;
    long year = sign * long(ig_temporal_decimal(utf8, year_start, year_width));
    if (year < -999999999L || year > 999999999L) return false;
    return ig_temporal_calendar_days(
        year,
        ig_temporal_decimal(utf8, month_separator + 1u, 2u),
        ig_temporal_decimal(utf8, day_separator + 1u, 2u),
        epoch_days);
}

inline bool ig_temporal_parse_date(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& epoch_days) {
    if (end < start) return false;
    uint length = end - start;
    if (ig_temporal_parse_expanded_calendar_date(utf8, start, end, epoch_days)) return true;
    if (length == 10 && utf8[start + 4] == uchar('-') && utf8[start + 7] == uchar('-')
            && ig_temporal_digits(utf8, start, 4) && ig_temporal_digits(utf8, start + 5, 2)
            && ig_temporal_digits(utf8, start + 8, 2)) {
        return ig_temporal_calendar_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 5, 2),
            ig_temporal_decimal(utf8, start + 8, 2),
            epoch_days);
    }
    if (length == 8 && utf8[start + 4] == uchar('W')
            && ig_temporal_digits(utf8, start, 4) && ig_temporal_digits(utf8, start + 5, 2)
            && ig_temporal_digits(utf8, start + 7, 1)) {
        return ig_temporal_iso_week_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 5, 2),
            ig_temporal_decimal(utf8, start + 7, 1),
            epoch_days);
    }
    if (length == 10 && utf8[start + 4] == uchar('-') && utf8[start + 5] == uchar('W')
            && utf8[start + 8] == uchar('-') && ig_temporal_digits(utf8, start, 4)
            && ig_temporal_digits(utf8, start + 6, 2) && ig_temporal_digits(utf8, start + 9, 1)) {
        return ig_temporal_iso_week_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 6, 2),
            ig_temporal_decimal(utf8, start + 9, 1),
            epoch_days);
    }
    if (length == 8 && utf8[start + 4] == uchar('-') && utf8[start + 5] == uchar('W')
            && ig_temporal_digits(utf8, start, 4) && ig_temporal_digits(utf8, start + 6, 2)) {
        return ig_temporal_iso_week_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 6, 2),
            1,
            epoch_days);
    }
    if (length == 7 && utf8[start + 4] == uchar('W')
            && ig_temporal_digits(utf8, start, 4) && ig_temporal_digits(utf8, start + 5, 2)) {
        return ig_temporal_iso_week_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 5, 2),
            1,
            epoch_days);
    }
    if (length == 8 && utf8[start + 4] == uchar('-')
            && ig_temporal_digits(utf8, start, 4) && ig_temporal_digits(utf8, start + 5, 3)) {
        return ig_temporal_ordinal_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 5, 3),
            epoch_days);
    }
    if (length == 8 && ig_temporal_digits(utf8, start, 8)) {
        return ig_temporal_calendar_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 4, 2),
            ig_temporal_decimal(utf8, start + 6, 2),
            epoch_days);
    }
    if (length == 7 && ig_temporal_digits(utf8, start, 7)) {
        return ig_temporal_ordinal_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 4, 3),
            epoch_days);
    }
    if (length == 7 && utf8[start + 4] == uchar('-')
            && ig_temporal_digits(utf8, start, 4) && ig_temporal_digits(utf8, start + 5, 2)) {
        return ig_temporal_calendar_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 5, 2),
            1,
            epoch_days);
    }
    if (length == 6 && ig_temporal_digits(utf8, start, 6)) {
        return ig_temporal_calendar_days(
            long(ig_temporal_decimal(utf8, start, 4)),
            ig_temporal_decimal(utf8, start + 4, 2),
            1,
            epoch_days);
    }
    if (length == 4 && ig_temporal_digits(utf8, start, 4)) {
        return ig_temporal_calendar_days(long(ig_temporal_decimal(utf8, start, 4)), 1, 1, epoch_days);
    }
    return false;
}

inline bool ig_temporal_parse_local_time(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& nanos) {
    if (end < start) return false;
    uint fraction_start = end;
    for (uint index = start; index < end; ++index) {
        if (utf8[index] == uchar('.')) {
            if (fraction_start != end) return false;
            fraction_start = index + 1;
        }
    }
    uint whole_end = fraction_start == end ? end : fraction_start - 1;
    uint whole_length = whole_end - start;
    uint hour = 0;
    uint minute = 0;
    uint second = 0;
    bool has_seconds = false;
    if (whole_length == 8 && utf8[start + 2] == uchar(':') && utf8[start + 5] == uchar(':')
            && ig_temporal_digits(utf8, start, 2) && ig_temporal_digits(utf8, start + 3, 2)
            && ig_temporal_digits(utf8, start + 6, 2)) {
        hour = ig_temporal_decimal(utf8, start, 2);
        minute = ig_temporal_decimal(utf8, start + 3, 2);
        second = ig_temporal_decimal(utf8, start + 6, 2);
        has_seconds = true;
    } else if (whole_length == 6 && ig_temporal_digits(utf8, start, 6)) {
        hour = ig_temporal_decimal(utf8, start, 2);
        minute = ig_temporal_decimal(utf8, start + 2, 2);
        second = ig_temporal_decimal(utf8, start + 4, 2);
        has_seconds = true;
    } else if (whole_length == 5 && utf8[start + 2] == uchar(':')
            && ig_temporal_digits(utf8, start, 2) && ig_temporal_digits(utf8, start + 3, 2)) {
        hour = ig_temporal_decimal(utf8, start, 2);
        minute = ig_temporal_decimal(utf8, start + 3, 2);
    } else if (whole_length == 4 && ig_temporal_digits(utf8, start, 4)) {
        hour = ig_temporal_decimal(utf8, start, 2);
        minute = ig_temporal_decimal(utf8, start + 2, 2);
    } else if (whole_length == 2 && ig_temporal_digits(utf8, start, 2)) {
        hour = ig_temporal_decimal(utf8, start, 2);
    } else {
        return false;
    }
    if (hour > 23 || minute > 59 || second > 59) return false;
    long fraction = 0;
    if (fraction_start != end) {
        uint width = end - fraction_start;
        if (!has_seconds || width == 0 || width > 9 || !ig_temporal_digits(utf8, fraction_start, width)) {
            return false;
        }
        fraction = long(ig_temporal_decimal(utf8, fraction_start, width));
        for (uint index = width; index < 9; ++index) {
            fraction *= 10;
        }
    }
    nanos = (long(hour) * 3600 + long(minute) * 60 + long(second)) * 1000000000L + fraction;
    return true;
}

inline bool ig_temporal_parse_offset_time(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& nanos,
    thread int& offset_seconds) {
    if (end <= start) return false;
    uint offset_start = end;
    for (uint index = start; index < end; ++index) {
        uchar value = utf8[index];
        if (value == uchar('Z') || value == uchar('z') || value == uchar('+') || value == uchar('-')) {
            if (offset_start != end) return false;
            offset_start = index;
        }
    }
    if (offset_start == end || offset_start == start) return false;
    if (!ig_temporal_parse_local_time(utf8, start, offset_start, nanos)) return false;
    uchar marker = utf8[offset_start];
    if (marker == uchar('Z') || marker == uchar('z')) {
        if (offset_start + 1 != end) return false;
        offset_seconds = 0;
        return true;
    }
    uint offset_start_digits = offset_start + 1;
    uint width = end - offset_start_digits;
    uint hours = 0;
    uint minutes = 0;
    uint seconds = 0;
    if (width == 2 && ig_temporal_digits(utf8, offset_start_digits, 2)) {
        hours = ig_temporal_decimal(utf8, offset_start_digits, 2);
    } else if (width == 4 && ig_temporal_digits(utf8, offset_start_digits, 4)) {
        hours = ig_temporal_decimal(utf8, offset_start_digits, 2);
        minutes = ig_temporal_decimal(utf8, offset_start_digits + 2, 2);
    } else if (width == 5 && utf8[offset_start_digits + 2] == uchar(':')
            && ig_temporal_digits(utf8, offset_start_digits, 2)
            && ig_temporal_digits(utf8, offset_start_digits + 3, 2)) {
        hours = ig_temporal_decimal(utf8, offset_start_digits, 2);
        minutes = ig_temporal_decimal(utf8, offset_start_digits + 3, 2);
    } else if (width == 6 && ig_temporal_digits(utf8, offset_start_digits, 6)) {
        hours = ig_temporal_decimal(utf8, offset_start_digits, 2);
        minutes = ig_temporal_decimal(utf8, offset_start_digits + 2, 2);
        seconds = ig_temporal_decimal(utf8, offset_start_digits + 4, 2);
    } else if (width == 8 && utf8[offset_start_digits + 2] == uchar(':')
            && utf8[offset_start_digits + 5] == uchar(':')
            && ig_temporal_digits(utf8, offset_start_digits, 2)
            && ig_temporal_digits(utf8, offset_start_digits + 3, 2)
            && ig_temporal_digits(utf8, offset_start_digits + 6, 2)) {
        hours = ig_temporal_decimal(utf8, offset_start_digits, 2);
        minutes = ig_temporal_decimal(utf8, offset_start_digits + 3, 2);
        seconds = ig_temporal_decimal(utf8, offset_start_digits + 6, 2);
    } else {
        return false;
    }
    if (hours > 18 || minutes > 59 || seconds > 59
            || (hours == 18 && (minutes != 0 || seconds != 0))) {
        return false;
    }
    uint absolute = hours * 3600 + minutes * 60 + seconds;
    offset_seconds = marker == uchar('-') ? -int(absolute) : int(absolute);
    return true;
}

inline bool ig_temporal_parse_time(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& nanos,
    thread int& offset_seconds) {
    if (ig_temporal_parse_offset_time(utf8, start, end, nanos, offset_seconds)) return true;
    if (!ig_temporal_parse_local_time(utf8, start, end, nanos)) return false;
    offset_seconds = 0;
    return true;
}

inline bool ig_temporal_parse_local_datetime(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& seconds,
    thread uint& nanos) {
    if (end <= start) return false;
    uint separator = end;
    for (uint index = start; index < end; ++index) {
        if (utf8[index] == uchar('T') || utf8[index] == uchar('t')) {
            if (separator != end) return false;
            separator = index;
        }
    }
    if (separator == end) {
        long epoch_days = 0L;
        if (!ig_temporal_parse_date(utf8, start, end, epoch_days)) return false;
        seconds = epoch_days * 86400L;
        nanos = 0u;
        return true;
    }
    if (separator == start || separator + 1 == end) return false;
    long epoch_days = 0;
    long time_nanos = 0;
    if (!ig_temporal_parse_date(utf8, start, separator, epoch_days)
            || !ig_temporal_parse_local_time(utf8, separator + 1, end, time_nanos)) {
        return false;
    }
    seconds = epoch_days * 86400L + time_nanos / 1000000000L;
    nanos = uint(time_nanos % 1000000000L);
    return true;
}

__attribute__((noinline)) bool ig_temporal_parse_offset_datetime(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& seconds,
    thread uint& nanos,
    thread int& offset_seconds) {
    if (end <= start) return false;
    uint separator = end;
    for (uint index = start; index < end; ++index) {
        if (utf8[index] == uchar('T') || utf8[index] == uchar('t')) {
            if (separator != end) return false;
            separator = index;
        }
    }
    if (separator == end || separator == start || separator + 1 == end) return false;
    long epoch_days = 0;
    long time_nanos = 0;
    if (!ig_temporal_parse_date(utf8, start, separator, epoch_days)
            || !ig_temporal_parse_offset_time(
                utf8, separator + 1, end, time_nanos, offset_seconds)) {
        return false;
    }
    seconds = epoch_days * 86400L + time_nanos / 1000000000L - long(offset_seconds);
    nanos = uint(time_nanos % 1000000000L);
    return true;
}

// Literal temporal maps use a compact compiler-owned AST packet. It contains raw field values,
// never a precomputed date/time, so parsing defaults, validation, and materialization remain on
// the selected device. Keep these codes in lockstep with `src/gpu/mod.rs`.
constant uchar IG_TEMPORAL_MAP_WIRE_VERSION = 1;
constant uchar IG_TEMPORAL_MAP_VALUE_NULL = 0;
constant uchar IG_TEMPORAL_MAP_VALUE_INTEGER = 1;
constant uchar IG_TEMPORAL_MAP_VALUE_FLOAT = 2;
constant uchar IG_TEMPORAL_MAP_VALUE_STRING = 3;
constant uchar IG_TEMPORAL_MAP_VALUE_TEMPORAL = 4;
constant uchar IG_TEMPORAL_MAP_VALUE_OTHER = 5;
constant uchar IG_TEMPORAL_MAP_VALUE_REGISTER = 6;
constant uint IG_TEMPORAL_MAP_FIELD_COUNT = 31;

struct IgTemporalMapFields {
    uchar present[IG_TEMPORAL_MAP_FIELD_COUNT];
    uchar tags[IG_TEMPORAL_MAP_FIELD_COUNT];
    long integers[IG_TEMPORAL_MAP_FIELD_COUNT];
    uchar temporal_functions[IG_TEMPORAL_MAP_FIELD_COUNT];
    uchar temporal_input_tags[IG_TEMPORAL_MAP_FIELD_COUNT];
    uint register_indices[IG_TEMPORAL_MAP_FIELD_COUNT];
    uint payload_starts[IG_TEMPORAL_MAP_FIELD_COUNT];
    uint payload_ends[IG_TEMPORAL_MAP_FIELD_COUNT];
};

inline bool ig_temporal_map_read_u32(
    device const uchar* bytes,
    thread uint& cursor,
    uint end,
    thread uint& value) {
    if (cursor > end || end - cursor < 4) return false;
    value = uint(bytes[cursor])
        | (uint(bytes[cursor + 1]) << 8)
        | (uint(bytes[cursor + 2]) << 16)
        | (uint(bytes[cursor + 3]) << 24);
    cursor += 4;
    return true;
}

inline bool ig_temporal_map_read_i64(
    device const uchar* bytes,
    thread uint& cursor,
    uint end,
    thread long& value) {
    if (cursor > end || end - cursor < 8) return false;
    ulong raw = ulong(bytes[cursor])
        | (ulong(bytes[cursor + 1]) << 8)
        | (ulong(bytes[cursor + 2]) << 16)
        | (ulong(bytes[cursor + 3]) << 24)
        | (ulong(bytes[cursor + 4]) << 32)
        | (ulong(bytes[cursor + 5]) << 40)
        | (ulong(bytes[cursor + 6]) << 48)
        | (ulong(bytes[cursor + 7]) << 56);
    cursor += 8;
    value = as_type<long>(raw);
    return true;
}

inline bool ig_temporal_map_read_payload(
    device const uchar* bytes,
    thread uint& cursor,
    uint end,
    thread uint& payload_start,
    thread uint& payload_end) {
    uint length = 0;
    if (!ig_temporal_map_read_u32(bytes, cursor, end, length)
            || cursor > end || end - cursor < length) return false;
    payload_start = cursor;
    payload_end = cursor + length;
    cursor = payload_end;
    return true;
}

__attribute__((noinline)) bool ig_temporal_parse_map_fields(
    device const uchar* bytes,
    uint start,
    uint end,
    thread IgTemporalMapFields& fields) {
    if (end < start || end - start < 2 || bytes[start] != IG_TEMPORAL_MAP_WIRE_VERSION) return false;
    for (uint index = 0; index < IG_TEMPORAL_MAP_FIELD_COUNT; ++index) {
        fields.present[index] = 0;
        fields.tags[index] = IG_TEMPORAL_MAP_VALUE_OTHER;
        fields.integers[index] = 0;
        fields.temporal_functions[index] = 255;
        fields.temporal_input_tags[index] = 2;
        fields.register_indices[index] = 0;
        fields.payload_starts[index] = 0;
        fields.payload_ends[index] = 0;
    }
    uint cursor = start + 2;
    uint entry_count = uint(bytes[start + 1]);
    for (uint entry = 0; entry < entry_count; ++entry) {
        if (cursor >= end) return false;
        uint key = uint(bytes[cursor]);
        cursor += 1;
        if (key == 0 || key >= IG_TEMPORAL_MAP_FIELD_COUNT || fields.present[key] != 0 || cursor >= end) {
            return false;
        }
        uchar tag = bytes[cursor];
        cursor += 1;
        fields.present[key] = 1;
        fields.tags[key] = tag;
        if (tag == IG_TEMPORAL_MAP_VALUE_NULL || tag == IG_TEMPORAL_MAP_VALUE_OTHER) {
            continue;
        }
        if (tag == IG_TEMPORAL_MAP_VALUE_INTEGER || tag == IG_TEMPORAL_MAP_VALUE_FLOAT) {
            long value = 0;
            if (!ig_temporal_map_read_i64(bytes, cursor, end, value)) return false;
            fields.integers[key] = value;
            continue;
        }
        if (tag == IG_TEMPORAL_MAP_VALUE_STRING) {
            if (!ig_temporal_map_read_payload(
                    bytes,
                    cursor,
                    end,
                    fields.payload_starts[key],
                    fields.payload_ends[key])) return false;
            continue;
        }
        if (tag == IG_TEMPORAL_MAP_VALUE_TEMPORAL) {
            if (cursor > end || end - cursor < 2) return false;
            fields.temporal_functions[key] = bytes[cursor];
            fields.temporal_input_tags[key] = bytes[cursor + 1];
            cursor += 2;
            if (!ig_temporal_map_read_payload(
                    bytes,
                    cursor,
                    end,
                    fields.payload_starts[key],
                    fields.payload_ends[key])) return false;
            continue;
        }
        if (tag == IG_TEMPORAL_MAP_VALUE_REGISTER) {
            if (cursor > end || end - cursor < 2) return false;
            fields.register_indices[key] = uint(bytes[cursor]) | (uint(bytes[cursor + 1]) << 8);
            cursor += 2;
            continue;
        }
        return false;
    }
    return cursor == end;
}

inline bool ig_temporal_map_optional_integer(
    thread const IgTemporalMapFields& fields,
    uint key,
    thread bool& has_value,
    thread long& value) {
    if (key >= IG_TEMPORAL_MAP_FIELD_COUNT) return false;
    has_value = fields.present[key] != 0;
    if (!has_value) {
        value = 0;
        return true;
    }
    if (fields.tags[key] != IG_TEMPORAL_MAP_VALUE_INTEGER) return false;
    value = fields.integers[key];
    return true;
}

inline bool ig_temporal_civil_from_days(
    long epoch_days,
    thread long& year,
    thread uint& month,
    thread uint& day) {
    long z = epoch_days + 719468L;
    long era = (z >= 0 ? z : z - 146096L) / 146097L;
    uint day_of_era = uint(z - era * 146097L);
    uint year_of_era = uint(
        (long(day_of_era) - long(day_of_era) / 1460L + long(day_of_era) / 36524L
            - long(day_of_era) / 146096L) / 365L);
    year = long(year_of_era) + era * 400L;
    uint day_of_year = day_of_era - (365u * year_of_era + year_of_era / 4u - year_of_era / 100u);
    uint march_month = (5u * day_of_year + 2u) / 153u;
    day = day_of_year - (153u * march_month + 2u) / 5u + 1u;
    month = march_month < 10u ? march_month + 3u : march_month - 9u;
    year += month <= 2u ? 1L : 0L;
    return true;
}

inline bool ig_temporal_iso_from_days(
    long epoch_days,
    thread long& iso_year,
    thread uint& iso_week,
    thread uint& iso_weekday) {
    iso_weekday = ig_temporal_iso_weekday_from_epoch(epoch_days);
    long thursday = epoch_days + (4L - long(iso_weekday));
    uint ignored_month = 0;
    uint ignored_day = 0;
    if (!ig_temporal_civil_from_days(thursday, iso_year, ignored_month, ignored_day)) return false;
    long jan4 = ig_temporal_days_from_civil(iso_year, 1u, 4u);
    long week_one_monday = jan4 - long(ig_temporal_iso_weekday_from_epoch(jan4) - 1u);
    iso_week = uint((epoch_days - week_one_monday) / 7L + 1L);
    return iso_week >= 1u && iso_week <= 53u;
}

inline bool ig_temporal_map_base_date(
    device const uchar* bytes,
    thread const IgTemporalMapFields& fields,
    thread bool& has_base,
    thread long& base_days) {
    has_base = fields.present[16] != 0;
    base_days = 0;
    if (!has_base) return true;
    if (fields.tags[16] != IG_TEMPORAL_MAP_VALUE_TEMPORAL
            || fields.temporal_functions[16] != 0
            || fields.temporal_input_tags[16] != 1) return false;
    return ig_temporal_parse_date(
        bytes,
        fields.payload_starts[16],
        fields.payload_ends[16],
        base_days);
}

__attribute__((noinline)) bool ig_temporal_map_date_with_base(
    thread const IgTemporalMapFields& fields,
    bool has_base,
    long base_days,
    thread long& epoch_days) {
    long base_year = 0;
    uint base_month = 0;
    uint base_day = 0;
    long base_iso_year = 0;
    uint base_iso_week = 0;
    uint base_iso_weekday = 0;
    if (has_base && (!ig_temporal_civil_from_days(base_days, base_year, base_month, base_day)
            || !ig_temporal_iso_from_days(
                base_days, base_iso_year, base_iso_week, base_iso_weekday))) return false;
    bool has_year = false;
    bool has_week = false;
    bool has_ordinal = false;
    bool has_quarter = false;
    long year = 0;
    long week = 0;
    long ordinal = 0;
    long quarter = 0;
    if (!ig_temporal_map_optional_integer(fields, 1, has_year, year)
            || !ig_temporal_map_optional_integer(fields, 4, has_week, week)
            || !ig_temporal_map_optional_integer(fields, 6, has_ordinal, ordinal)
            || !ig_temporal_map_optional_integer(fields, 7, has_quarter, quarter)) return false;
    if (has_week) {
        if (!has_year) {
            if (!has_base) return false;
            year = base_iso_year;
        }
        bool has_weekday = false;
        long weekday = 0;
        if (!ig_temporal_map_optional_integer(fields, 5, has_weekday, weekday)) return false;
        if (!has_weekday) weekday = has_base ? long(base_iso_weekday) : 1L;
        if (week < 1L || week > 53L || weekday < 1L || weekday > 7L) return false;
        return ig_temporal_iso_week_days(year, uint(week), uint(weekday), epoch_days);
    }
    if (has_ordinal) {
        if (!has_year) {
            if (!has_base) return false;
            year = base_year;
        }
        if (ordinal < 1L || ordinal > 366L) return false;
        return ig_temporal_ordinal_days(year, uint(ordinal), epoch_days);
    }
    if (has_quarter) {
        if (!has_year) {
            if (!has_base) return false;
            year = base_year;
        }
        if (quarter < 1L || quarter > 4L) return false;
        bool has_day_of_quarter = false;
        long day_of_quarter = 0;
        if (!ig_temporal_map_optional_integer(fields, 8, has_day_of_quarter, day_of_quarter)) return false;
        if (!has_day_of_quarter) {
            day_of_quarter = has_base
                ? base_days - ig_temporal_days_from_civil(
                    base_year, ((base_month - 1u) / 3u) * 3u + 1u, 1u) + 1L
                : 1L;
        }
        if (day_of_quarter < 1L) return false;
        uint start_month = (uint(quarter) - 1u) * 3u + 1u;
        long candidate = ig_temporal_days_from_civil(year, start_month, 1u) + day_of_quarter - 1L;
        long candidate_year = 0;
        uint candidate_month = 0;
        uint candidate_day = 0;
        if (!ig_temporal_civil_from_days(candidate, candidate_year, candidate_month, candidate_day)
                || candidate_year != year || (candidate_month - 1u) / 3u + 1u != uint(quarter)) return false;
        epoch_days = candidate;
        return true;
    }
    if (!has_year) {
        if (!has_base) return false;
        year = base_year;
    }
    bool has_month = false;
    bool has_day = false;
    long month = 0;
    long day = 0;
    if (!ig_temporal_map_optional_integer(fields, 2, has_month, month)
            || !ig_temporal_map_optional_integer(fields, 3, has_day, day)) return false;
    if (!has_month) month = has_base ? long(base_month) : 1L;
    if (!has_day) day = has_base ? long(base_day) : 1L;
    if (month < 1L || month > 12L || day < 1L || day > 31L) return false;
    return ig_temporal_calendar_days(year, uint(month), uint(day), epoch_days);
}

inline bool ig_temporal_map_date(
    device const uchar* bytes,
    thread const IgTemporalMapFields& fields,
    thread long& epoch_days) {
    bool has_base = false;
    long base_days = 0;
    return ig_temporal_map_base_date(bytes, fields, has_base, base_days)
        && ig_temporal_map_date_with_base(fields, has_base, base_days, epoch_days);
}

__attribute__((noinline)) bool ig_temporal_map_clock_with_base(
    thread const IgTemporalMapFields& fields,
    bool has_base,
    long base_nanos,
    thread long& nanos) {
    bool has_hour = false;
    bool has_minute = false;
    bool has_second = false;
    bool has_millisecond = false;
    bool has_microsecond = false;
    bool has_nanosecond = false;
    long hour = 0;
    long minute = 0;
    long second = 0;
    long millisecond = 0;
    long microsecond = 0;
    long nanosecond = 0;
    if (!ig_temporal_map_optional_integer(fields, 9, has_hour, hour)
            || !ig_temporal_map_optional_integer(fields, 10, has_minute, minute)
            || !ig_temporal_map_optional_integer(fields, 11, has_second, second)
            || !ig_temporal_map_optional_integer(fields, 12, has_millisecond, millisecond)
            || !ig_temporal_map_optional_integer(fields, 13, has_microsecond, microsecond)
            || !ig_temporal_map_optional_integer(fields, 14, has_nanosecond, nanosecond)) return false;
    long base_seconds = has_base ? base_nanos / 1000000000L : 0L;
    long base_fraction = has_base ? base_nanos % 1000000000L : 0L;
    if (!has_hour) hour = base_seconds / 3600L;
    if (!has_minute) minute = (base_seconds / 60L) % 60L;
    if (!has_second) second = base_seconds % 60L;
    if (hour < 0L || hour > 23L || minute < 0L || minute > 59L || second < 0L || second > 59L) {
        return false;
    }
    long fraction = 0;
    if (has_millisecond) {
        if (millisecond < 0L || millisecond > 999L || microsecond < 0L || microsecond > 999L
                || nanosecond < 0L || nanosecond > 999L) return false;
        fraction = millisecond * 1000000L + microsecond * 1000L + nanosecond;
    } else if (has_microsecond) {
        if (microsecond < 0L || microsecond > 999999L || nanosecond < 0L || nanosecond > 999L) {
            return false;
        }
        fraction = microsecond * 1000L + nanosecond;
    } else if (has_nanosecond) {
        fraction = nanosecond;
    } else {
        fraction = base_fraction;
    }
    if (fraction < 0L || fraction >= 1000000000L) return false;
    nanos = (hour * 3600L + minute * 60L + second) * 1000000000L + fraction;
    return true;
}

inline bool ig_temporal_map_clock(
    thread const IgTemporalMapFields& fields,
    thread long& nanos) {
    return fields.present[17] == 0
        && ig_temporal_map_clock_with_base(fields, false, 0L, nanos);
}

inline bool ig_temporal_map_offset(
    device const uchar* bytes,
    uint start,
    uint end,
    thread int& offset_seconds) {
    if (end <= start) return false;
    if (end - start == 1 && (bytes[start] == uchar('Z') || bytes[start] == uchar('z'))) {
        offset_seconds = 0;
        return true;
    }
    if (end - start == 3 && bytes[start] == uchar('U') && bytes[start + 1] == uchar('T')
            && bytes[start + 2] == uchar('C')) {
        offset_seconds = 0;
        return true;
    }
    uchar marker = bytes[start];
    if (marker != uchar('+') && marker != uchar('-')) return false;
    uint digits_start = start + 1;
    uint width = end - digits_start;
    uint hours = 0;
    uint minutes = 0;
    uint seconds = 0;
    if (width == 2 && ig_temporal_digits(bytes, digits_start, 2)) {
        hours = ig_temporal_decimal(bytes, digits_start, 2);
    } else if (width == 4 && ig_temporal_digits(bytes, digits_start, 4)) {
        hours = ig_temporal_decimal(bytes, digits_start, 2);
        minutes = ig_temporal_decimal(bytes, digits_start + 2, 2);
    } else if (width == 5 && bytes[digits_start + 2] == uchar(':')
            && ig_temporal_digits(bytes, digits_start, 2)
            && ig_temporal_digits(bytes, digits_start + 3, 2)) {
        hours = ig_temporal_decimal(bytes, digits_start, 2);
        minutes = ig_temporal_decimal(bytes, digits_start + 3, 2);
    } else if (width == 6 && ig_temporal_digits(bytes, digits_start, 6)) {
        hours = ig_temporal_decimal(bytes, digits_start, 2);
        minutes = ig_temporal_decimal(bytes, digits_start + 2, 2);
        seconds = ig_temporal_decimal(bytes, digits_start + 4, 2);
    } else if (width == 8 && bytes[digits_start + 2] == uchar(':')
            && bytes[digits_start + 5] == uchar(':')
            && ig_temporal_digits(bytes, digits_start, 2)
            && ig_temporal_digits(bytes, digits_start + 3, 2)
            && ig_temporal_digits(bytes, digits_start + 6, 2)) {
        hours = ig_temporal_decimal(bytes, digits_start, 2);
        minutes = ig_temporal_decimal(bytes, digits_start + 3, 2);
        seconds = ig_temporal_decimal(bytes, digits_start + 6, 2);
    } else {
        return false;
    }
    if (hours > 18u || minutes > 59u || seconds > 59u
            || (hours == 18u && (minutes != 0u || seconds != 0u))) return false;
    uint absolute = hours * 3600u + minutes * 60u + seconds;
    offset_seconds = marker == uchar('-') ? -int(absolute) : int(absolute);
    return true;
}

inline bool ig_temporal_map_timezone_offset(
    device const uchar* bytes,
    thread const IgTemporalMapFields& fields,
    thread int& offset_seconds) {
    if (fields.present[15] == 0) {
        offset_seconds = 0;
        return true;
    }
    if (fields.tags[15] != IG_TEMPORAL_MAP_VALUE_STRING) return false;
    return ig_temporal_map_offset(
        bytes, fields.payload_starts[15], fields.payload_ends[15], offset_seconds);
}

constant long IG_TEMPORAL_LONG_MAX = 9223372036854775807L;
constant long IG_TEMPORAL_LONG_MIN = -9223372036854775807L - 1L;
constant long IG_TEMPORAL_DURATION_MONTH_SECONDS = 2629746L;

inline bool ig_temporal_map_mul_u64(
    ulong left,
    ulong right,
    thread ulong& high,
    thread ulong& low) {
    const ulong mask = 0xfffffffful;
    ulong left_low = left & mask;
    ulong left_high = left >> 32;
    ulong right_low = right & mask;
    ulong right_high = right >> 32;
    ulong product_low = left_low * right_low;
    ulong product_cross_left = left_low * right_high;
    ulong product_cross_right = left_high * right_low;
    ulong carry = (product_low >> 32)
        + (product_cross_left & mask)
        + (product_cross_right & mask);
    low = (product_low & mask) | (carry << 32);
    high = left_high * right_high
        + (product_cross_left >> 32)
        + (product_cross_right >> 32)
        + (carry >> 32);
    return true;
}

inline bool ig_temporal_map_signed_magnitude(
    ulong magnitude,
    bool negative,
    thread long& value) {
    ulong maximum = ulong(IG_TEMPORAL_LONG_MAX);
    if (!negative) {
        if (magnitude > maximum) return false;
        value = long(magnitude);
        return true;
    }
    if (magnitude > maximum + 1ul) return false;
    value = magnitude == maximum + 1ul ? IG_TEMPORAL_LONG_MIN : -long(magnitude);
    return true;
}

/// Extracts a FLOAT map field as its exact truncated integer and an exact-to-nanosecond
/// fractional product. This avoids relying on device FP64 support and mirrors the CPU reference
/// implementation's IEEE-754 rational arithmetic.
inline bool ig_temporal_map_float_duration_parts(
    ulong bits,
    long unit_nanos,
    thread long& whole,
    thread long& fractional_nanos) {
    if (unit_nanos <= 0) return false;
    uint exponent_bits = uint((bits >> 52) & 0x7fful);
    ulong fraction = bits & 0x000ffffffffffffful;
    if (exponent_bits == 0x7ffu) return false;
    bool negative = (bits >> 63) != 0;
    ulong significand = exponent_bits == 0 ? fraction : (0x0010000000000000ul | fraction);
    if (significand == 0) {
        whole = 0;
        fractional_nanos = 0;
        return true;
    }
    int exponent = exponent_bits == 0 ? -1074 : int(exponent_bits) - 1023 - 52;
    if (exponent >= 0) {
        if (exponent > 63) return false;
        uint shift = uint(exponent);
        if (shift != 0 && significand > (ulong(IG_TEMPORAL_LONG_MAX) + 1ul) >> shift) {
            return false;
        }
        if (!ig_temporal_map_signed_magnitude(significand << shift, negative, whole)) return false;
        fractional_nanos = 0;
        return true;
    }
    uint shift = uint(-exponent);
    ulong whole_magnitude = shift >= 64u ? 0ul : significand >> shift;
    ulong remainder = shift >= 64u ? significand : significand & ((1ul << shift) - 1ul);
    ulong high = 0;
    ulong low = 0;
    ig_temporal_map_mul_u64(remainder, ulong(unit_nanos), high, low);
    ulong fraction_magnitude = 0;
    if (shift < 64u) {
        if ((high >> shift) != 0) return false;
        fraction_magnitude = (high << (64u - shift)) | (low >> shift);
    } else if (shift < 128u) {
        fraction_magnitude = high >> (shift - 64u);
    }
    return ig_temporal_map_signed_magnitude(whole_magnitude, negative, whole)
        && ig_temporal_map_signed_magnitude(fraction_magnitude, negative, fractional_nanos);
}

inline bool ig_temporal_map_duration_number(
    thread const IgTemporalMapFields& fields,
    uint key,
    long unit_nanos,
    thread bool& has_value,
    thread long& whole,
    thread long& fractional_nanos) {
    if (key >= IG_TEMPORAL_MAP_FIELD_COUNT) return false;
    has_value = fields.present[key] != 0;
    whole = 0;
    fractional_nanos = 0;
    if (!has_value) return true;
    if (fields.tags[key] == IG_TEMPORAL_MAP_VALUE_INTEGER) {
        whole = fields.integers[key];
        return true;
    }
    if (fields.tags[key] == IG_TEMPORAL_MAP_VALUE_FLOAT) {
        return ig_temporal_map_float_duration_parts(
            as_type<ulong>(fields.integers[key]), unit_nanos, whole, fractional_nanos);
    }
    return false;
}

inline bool ig_temporal_map_duration_add(
    thread long& target,
    long value) {
    if ((value > 0 && target > IG_TEMPORAL_LONG_MAX - value)
            || (value < 0 && target < IG_TEMPORAL_LONG_MIN - value)) return false;
    target += value;
    return true;
}

inline bool ig_temporal_duration_normalize_seconds_nanos(
    thread long& seconds,
    thread long& nanos) {
    const long nanos_per_second = 1000000000L;
    long carry = nanos / nanos_per_second;
    long remainder = nanos % nanos_per_second;
    if (remainder < 0L) {
        carry -= 1L;
        remainder += nanos_per_second;
    }
    if (!ig_temporal_map_duration_add(seconds, carry)) return false;
    nanos = remainder;
    return true;
}

inline bool ig_temporal_map_duration_scaled(
    long value,
    long multiplier,
    thread long& scaled) {
    if (multiplier <= 0
            || (value > 0 && value > IG_TEMPORAL_LONG_MAX / multiplier)
            || (value < 0 && value < IG_TEMPORAL_LONG_MIN / multiplier)) return false;
    scaled = value * multiplier;
    return true;
}

inline bool ig_temporal_map_duration_add_nanos(
    thread long& days,
    thread long& seconds,
    thread long& nanos,
    long value,
    bool promote_days) {
    const long nanos_per_second = 1000000000L;
    const long nanos_per_day = 86400000000000L;
    long added_days = promote_days ? value / nanos_per_day : 0;
    long remainder = promote_days ? value % nanos_per_day : value;
    if (!ig_temporal_map_duration_add(days, added_days)
            || !ig_temporal_map_duration_add(seconds, remainder / nanos_per_second)
            || !ig_temporal_map_duration_add(nanos, remainder % nanos_per_second)) return false;
    if (nanos >= nanos_per_second || nanos <= -nanos_per_second) {
        long carry = nanos / nanos_per_second;
        if (!ig_temporal_map_duration_add(seconds, carry)) return false;
        nanos %= nanos_per_second;
    }
    return true;
}

inline bool ig_temporal_map_duration_apply(
    thread const IgTemporalMapFields& fields,
    uint key,
    long multiplier,
    long unit_nanos,
    uint target,
    thread long& months,
    thread long& days,
    thread long& seconds,
    thread long& nanos) {
    bool has_value = false;
    long whole = 0;
    long fractional_nanos = 0;
    if (!ig_temporal_map_duration_number(
            fields, key, unit_nanos, has_value, whole, fractional_nanos)) return false;
    if (!has_value) return true;
    long scaled = 0;
    if (target == 0u) {
        return ig_temporal_map_duration_scaled(whole, multiplier, scaled)
            && ig_temporal_map_duration_add(months, scaled)
            && ig_temporal_map_duration_add_nanos(days, seconds, nanos, fractional_nanos, true);
    }
    if (target == 1u) {
        return ig_temporal_map_duration_scaled(whole, multiplier, scaled)
            && ig_temporal_map_duration_add(days, scaled)
            && ig_temporal_map_duration_add_nanos(days, seconds, nanos, fractional_nanos, true);
    }
    if (target == 2u) {
        return ig_temporal_map_duration_scaled(whole, multiplier, scaled)
            && ig_temporal_map_duration_add(seconds, scaled)
            && ig_temporal_map_duration_add_nanos(days, seconds, nanos, fractional_nanos, false);
    }
    if (target == 3u) {
        return ig_temporal_map_duration_scaled(whole, multiplier, scaled)
            && ig_temporal_map_duration_add(scaled, fractional_nanos)
            && ig_temporal_map_duration_add_nanos(days, seconds, nanos, scaled, false);
    }
    return false;
}

inline bool ig_temporal_map_duration_components(
    thread const IgTemporalMapFields& fields,
    thread long& months,
    thread long& days,
    thread long& seconds,
    thread long& nanos) {
    for (uint key = 1u; key < 21u; ++key) {
        if (fields.present[key] != 0) return false;
    }
    months = 0L;
    days = 0L;
    seconds = 0L;
    nanos = 0L;
    if (!ig_temporal_map_duration_apply(
            fields, 21u, 12L, 31556952000000000L, 0u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 22u, 1L, 2629746000000000L, 0u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 23u, 7L, 604800000000000L, 1u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 24u, 1L, 86400000000000L, 1u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 25u, 3600L, 3600000000000L, 2u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 26u, 60L, 60000000000L, 2u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 27u, 1L, 1000000000L, 2u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 28u, 1000000L, 1000000L, 3u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 29u, 1000L, 1000L, 3u, months, days, seconds, nanos)
        || !ig_temporal_map_duration_apply(
            fields, 30u, 1L, 1L, 3u, months, days, seconds, nanos)) return false;
    return ig_temporal_duration_normalize_seconds_nanos(seconds, nanos);
}

inline bool ig_temporal_decimal_long(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& value) {
    if (end <= start) return false;
    value = 0;
    for (uint index = start; index < end; ++index) {
        if (!ig_temporal_ascii_digit(utf8[index])) return false;
        long digit = long(utf8[index] - uchar('0'));
        if (value > (IG_TEMPORAL_LONG_MAX - digit) / 10L) return false;
        value = value * 10L + digit;
    }
    return true;
}

inline bool ig_temporal_decimal_signed_long(
    device const uchar* utf8,
    uint start,
    uint end,
    bool negative,
    thread long& value) {
    if (end <= start) return false;
    ulong magnitude = 0ul;
    ulong limit = ulong(IG_TEMPORAL_LONG_MAX) + (negative ? 1ul : 0ul);
    for (uint index = start; index < end; ++index) {
        if (!ig_temporal_ascii_digit(utf8[index])) return false;
        ulong digit = ulong(utf8[index] - uchar('0'));
        if (magnitude > (limit - digit) / 10ul) return false;
        magnitude = magnitude * 10ul + digit;
    }
    return ig_temporal_map_signed_magnitude(magnitude, negative, value);
}

inline bool ig_temporal_parse_duration_decimal(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& whole,
    thread long& fractional,
    thread uint& fractional_digits) {
    if (end <= start) return false;
    bool negative = false;
    if (utf8[start] == uchar('-') || utf8[start] == uchar('+')) {
        negative = utf8[start] == uchar('-');
        start += 1u;
    }
    if (end <= start) return false;
    uint decimal = end;
    for (uint index = start; index < end; ++index) {
        if (utf8[index] == uchar('.')) {
            if (decimal != end) return false;
            decimal = index;
        } else if (!ig_temporal_ascii_digit(utf8[index])) {
            return false;
        }
    }
    uint whole_end = decimal == end ? end : decimal;
    if (!ig_temporal_decimal_signed_long(utf8, start, whole_end, negative, whole)) return false;
    if (decimal == end) {
        fractional = 0;
        fractional_digits = 0;
        return true;
    }
    uint fraction_start = decimal + 1;
    fractional_digits = end - fraction_start;
    if (fractional_digits == 0 || fractional_digits > 9
            || !ig_temporal_decimal_long(utf8, fraction_start, end, fractional)) {
        return false;
    }
    if (negative) fractional = -fractional;
    return true;
}

inline bool ig_temporal_duration_add_scaled(
    thread long& target,
    long value,
    long multiplier) {
    long addition = 0L;
    return ig_temporal_map_duration_scaled(value, multiplier, addition)
        && ig_temporal_map_duration_add(target, addition);
}

inline bool ig_temporal_duration_add_fraction(
    thread long& days,
    thread long& seconds,
    thread long& nanos,
    long unit_seconds,
    long fractional,
    uint fractional_digits) {
    if (fractional == 0) return true;
    if (unit_seconds <= 0 || fractional_digits == 0 || fractional_digits > 9) return false;
    bool negative = fractional < 0L;
    long magnitude = negative ? -fractional : fractional;
    long denominator = 1;
    for (uint index = 0; index < fractional_digits; ++index) denominator *= 10L;
    if (unit_seconds > IG_TEMPORAL_LONG_MAX / 1000000000L) return false;
    long base_nanos = unit_seconds * 1000000000L;
    long quotient = base_nanos / denominator;
    long remainder = base_nanos % denominator;
    if ((quotient != 0 && magnitude > IG_TEMPORAL_LONG_MAX / quotient)
            || (remainder != 0 && magnitude > IG_TEMPORAL_LONG_MAX / remainder)) {
        return false;
    }
    long fractional_nanos = quotient * magnitude + (remainder * magnitude) / denominator;
    if (negative) fractional_nanos = -fractional_nanos;
    if (unit_seconds >= 86400L) {
        long added_days = fractional_nanos / 86400000000000L;
        if (!ig_temporal_map_duration_add(days, added_days)) return false;
        fractional_nanos %= 86400000000000L;
    }
    long added_seconds = fractional_nanos / 1000000000L;
    long added_nanos = fractional_nanos % 1000000000L;
    return ig_temporal_map_duration_add(seconds, added_seconds)
        && ig_temporal_map_duration_add(nanos, added_nanos)
        && ig_temporal_duration_normalize_seconds_nanos(seconds, nanos);
}

inline bool ig_temporal_parse_standard_duration(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& months,
    thread long& days,
    thread long& seconds,
    thread long& nanos) {
    bool in_time = false;
    bool saw_component = false;
    bool saw_time_component = false;
    uint seen = 0;
    uint index = start;
    while (index < end) {
        if (utf8[index] == uchar('T')) {
            if (in_time) return false;
            in_time = true;
            index += 1;
            continue;
        }
        uint number_start = index;
        if (utf8[index] == uchar('-') || utf8[index] == uchar('+')) index += 1u;
        while (index < end && (ig_temporal_ascii_digit(utf8[index]) || utf8[index] == uchar('.'))) {
            index += 1;
        }
        if (number_start == index
                || ((utf8[number_start] == uchar('-') || utf8[number_start] == uchar('+'))
                    && number_start + 1u == index)
                || index == end) return false;
        long whole = 0;
        long fractional = 0;
        uint fractional_digits = 0;
        if (!ig_temporal_parse_duration_decimal(
                utf8, number_start, index, whole, fractional, fractional_digits)) return false;
        uchar unit = utf8[index++];
        uint bit = 0;
        if (!in_time && unit == uchar('Y')) bit = 1;
        else if (!in_time && unit == uchar('M')) bit = 2;
        else if (!in_time && unit == uchar('W')) bit = 4;
        else if (!in_time && unit == uchar('D')) bit = 8;
        else if (in_time && unit == uchar('H')) bit = 16;
        else if (in_time && unit == uchar('M')) bit = 32;
        else if (in_time && unit == uchar('S')) bit = 64;
        else return false;
        if ((seen & bit) != 0) return false;
        seen |= bit;
        saw_component = true;
        saw_time_component = saw_time_component || in_time;
        if (!in_time && unit == uchar('Y')) {
            if (!ig_temporal_duration_add_scaled(months, whole, 12L)
                    || !ig_temporal_duration_add_fraction(
                        days, seconds, nanos, 12L * IG_TEMPORAL_DURATION_MONTH_SECONDS,
                        fractional, fractional_digits)) return false;
        } else if (!in_time && unit == uchar('M')) {
            if (!ig_temporal_duration_add_scaled(months, whole, 1L)
                    || !ig_temporal_duration_add_fraction(
                        days, seconds, nanos, IG_TEMPORAL_DURATION_MONTH_SECONDS,
                        fractional, fractional_digits)) return false;
        } else if (!in_time && unit == uchar('W')) {
            if (!ig_temporal_duration_add_scaled(days, whole, 7L)
                    || !ig_temporal_duration_add_fraction(
                        days, seconds, nanos, 604800L, fractional, fractional_digits)) return false;
        } else if (!in_time && unit == uchar('D')) {
            if (!ig_temporal_duration_add_scaled(days, whole, 1L)
                    || !ig_temporal_duration_add_fraction(
                        days, seconds, nanos, 86400L, fractional, fractional_digits)) return false;
        } else if (in_time && unit == uchar('H')) {
            if (!ig_temporal_duration_add_scaled(seconds, whole, 3600L)
                    || !ig_temporal_duration_add_fraction(
                        days, seconds, nanos, 3600L, fractional, fractional_digits)) return false;
        } else if (in_time && unit == uchar('M')) {
            if (!ig_temporal_duration_add_scaled(seconds, whole, 60L)
                    || !ig_temporal_duration_add_fraction(
                        days, seconds, nanos, 60L, fractional, fractional_digits)) return false;
        } else if (in_time && unit == uchar('S')) {
            if (!ig_temporal_duration_add_scaled(seconds, whole, 1L)
                    || !ig_temporal_duration_add_fraction(
                        days, seconds, nanos, 1L, fractional, fractional_digits)) return false;
        }
    }
    return saw_component && (!in_time || saw_time_component);
}

inline bool ig_temporal_parse_extended_duration(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& months,
    thread long& days,
    thread long& seconds,
    thread long& nanos) {
    uint first_dash = end;
    uint second_dash = end;
    uint separator = end;
    for (uint index = start; index < end; ++index) {
        if (utf8[index] == uchar('T')) {
            if (separator != end) return false;
            separator = index;
        } else if (utf8[index] == uchar('-') && separator == end) {
            if (first_dash == end) first_dash = index;
            else if (second_dash == end) second_dash = index;
            else return false;
        }
    }
    if (first_dash == end || second_dash == end || separator == end
            || first_dash == start || second_dash == first_dash + 1
            || separator == second_dash + 1 || separator + 1 == end) return false;
    uint first_colon = end;
    uint second_colon = end;
    for (uint index = separator + 1; index < end; ++index) {
        if (utf8[index] == uchar(':')) {
            if (first_colon == end) first_colon = index;
            else if (second_colon == end) second_colon = index;
            else return false;
        }
    }
    if (first_colon == end || second_colon == end || first_colon == separator + 1
            || second_colon == first_colon + 1 || second_colon + 1 == end) return false;
    long year = 0;
    long month = 0;
    long day = 0;
    long hour = 0;
    long minute = 0;
    long second = 0;
    long fractional = 0;
    uint fractional_digits = 0;
    if (!ig_temporal_decimal_long(utf8, start, first_dash, year)
            || !ig_temporal_decimal_long(utf8, first_dash + 1, second_dash, month)
            || !ig_temporal_decimal_long(utf8, second_dash + 1, separator, day)
            || !ig_temporal_decimal_long(utf8, separator + 1, first_colon, hour)
            || !ig_temporal_decimal_long(utf8, first_colon + 1, second_colon, minute)
            || !ig_temporal_parse_duration_decimal(
                utf8, second_colon + 1, end, second, fractional, fractional_digits)) {
        return false;
    }
    return ig_temporal_duration_add_scaled(months, year, 12L)
        && ig_temporal_duration_add_scaled(months, month, 1L)
        && ig_temporal_duration_add_scaled(days, day, 1L)
        && ig_temporal_duration_add_scaled(seconds, hour, 3600L)
        && ig_temporal_duration_add_scaled(seconds, minute, 60L)
        && ig_temporal_duration_add_scaled(seconds, second, 1L)
        && ig_temporal_duration_add_fraction(days, seconds, nanos, 1L, fractional, fractional_digits);
}

inline bool ig_temporal_parse_duration(
    device const uchar* utf8,
    uint start,
    uint end,
    thread long& months,
    thread long& days,
    thread long& seconds,
    thread long& nanos) {
    if (end <= start) return false;
    bool negative = false;
    if (utf8[start] == uchar('-') || utf8[start] == uchar('+')) {
        negative = utf8[start] == uchar('-');
        start += 1;
    }
    if (start >= end || utf8[start] != uchar('P')) return false;
    start += 1;
    if (start >= end) return false;
    months = 0;
    days = 0;
    seconds = 0;
    nanos = 0;
    bool extended = false;
    for (uint index = start; index < end; ++index) {
        if (utf8[index] == uchar(':')) {
            extended = true;
            break;
        }
    }
    bool parsed = extended
        ? ig_temporal_parse_extended_duration(utf8, start, end, months, days, seconds, nanos)
        : ig_temporal_parse_standard_duration(utf8, start, end, months, days, seconds, nanos);
    if (!parsed) return false;
    if (negative) {
        if (months == IG_TEMPORAL_LONG_MIN || days == IG_TEMPORAL_LONG_MIN
                || seconds == IG_TEMPORAL_LONG_MIN || nanos == IG_TEMPORAL_LONG_MIN) return false;
        months = -months;
        days = -days;
        seconds = -seconds;
        nanos = -nanos;
    }
    return ig_temporal_duration_normalize_seconds_nanos(seconds, nanos);
}

// Duration parsing has a separate lazy pipeline.  Keeping it out of the common date/time
// pipeline prevents an uncommon, branch-heavy grammar from inflating every ACTIVE Metal node's
// startup compilation path; the selected device still parses every duration byte itself.
kernel void ig_temporal_duration_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar input_tag = input_tags[row] & 3;
    if (input_tag == 0) {
        output[output_base] = 0;
        return;
    }
    output[output_base] = 7;
    if (input_tag != 1) return;
    long months = 0;
    long days = 0;
    long seconds = 0;
    long nanos = 0;
    if (!ig_temporal_parse_duration(
            utf8, offsets[row], offsets[row + 1], months, days, seconds, nanos)) return;
    output[output_base] = 6;
    output[output_base + 1] = uint(as_type<ulong>(months));
    output[output_base + 2] = uint(as_type<ulong>(months) >> 32);
    output[output_base + 3] = uint(as_type<ulong>(days));
    output[output_base + 4] = uint(as_type<ulong>(days) >> 32);
    output[output_base + 5] = uint(as_type<ulong>(seconds));
    output[output_base + 6] = uint(as_type<ulong>(seconds) >> 32);
    output[output_base + 7] = as_type<uint>(int(nanos));
}

// Map constructors compile as narrow lazy kernels by result type. A date-only map must not make
// the time/datetime grammar part of its first-use compilation path, while every kernel still
// parses the raw map packet and produces its own final typed record.
kernel void ig_temporal_map_date_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar packed = input_tags[row];
    if ((packed & 3) == 0) { output[output_base] = 0; return; }
    output[output_base] = 7;
    if ((packed & 3) != 3 || (packed >> 2) != 0) return;
    IgTemporalMapFields fields;
    long days = 0;
    if (!ig_temporal_parse_map_fields(utf8, offsets[row], offsets[row + 1], fields)
            || !ig_temporal_map_date(utf8, fields, days)) return;
    output[output_base] = 1;
    ulong bits = as_type<ulong>(days);
    output[output_base + 1] = uint(bits);
    output[output_base + 2] = uint(bits >> 32);
}

kernel void ig_temporal_map_local_time_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar packed = input_tags[row];
    if ((packed & 3) == 0) { output[output_base] = 0; return; }
    output[output_base] = 7;
    if ((packed & 3) != 3 || (packed >> 2) != 1) return;
    IgTemporalMapFields fields;
    long nanos = 0;
    if (!ig_temporal_parse_map_fields(utf8, offsets[row], offsets[row + 1], fields)
            || !ig_temporal_map_clock(fields, nanos)) return;
    output[output_base] = 2;
    output[output_base + 1] = uint(as_type<ulong>(nanos));
    output[output_base + 2] = uint(as_type<ulong>(nanos) >> 32);
}

kernel void ig_temporal_map_time_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar packed = input_tags[row];
    if ((packed & 3) == 0) { output[output_base] = 0; return; }
    output[output_base] = 7;
    if ((packed & 3) != 3 || (packed >> 2) != 2) return;
    IgTemporalMapFields fields;
    long nanos = 0;
    int offset_seconds = 0;
    if (!ig_temporal_parse_map_fields(utf8, offsets[row], offsets[row + 1], fields)
            || !ig_temporal_map_clock(fields, nanos)
            || !ig_temporal_map_timezone_offset(utf8, fields, offset_seconds)) return;
    output[output_base] = 3;
    output[output_base + 1] = uint(as_type<ulong>(nanos));
    output[output_base + 2] = uint(as_type<ulong>(nanos) >> 32);
    output[output_base + 3] = as_type<uint>(offset_seconds);
}

kernel void ig_temporal_map_local_datetime_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar packed = input_tags[row];
    if ((packed & 3) == 0) { output[output_base] = 0; return; }
    output[output_base] = 7;
    if ((packed & 3) != 3 || (packed >> 2) != 3) return;
    IgTemporalMapFields fields;
    long days = 0;
    long clock = 0;
    if (!ig_temporal_parse_map_fields(utf8, offsets[row], offsets[row + 1], fields)
            || !ig_temporal_map_date(utf8, fields, days)
            || !ig_temporal_map_clock(fields, clock)) return;
    long seconds = days * 86400L + clock / 1000000000L;
    output[output_base] = 4;
    output[output_base + 1] = uint(as_type<ulong>(seconds));
    output[output_base + 2] = uint(as_type<ulong>(seconds) >> 32);
    output[output_base + 3] = uint(clock % 1000000000L);
}

kernel void ig_temporal_map_datetime_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar packed = input_tags[row];
    if ((packed & 3) == 0) { output[output_base] = 0; return; }
    output[output_base] = 7;
    if ((packed & 3) != 3 || (packed >> 2) != 4) return;
    IgTemporalMapFields fields;
    if (!ig_temporal_parse_map_fields(utf8, offsets[row], offsets[row + 1], fields)) return;
    bool has_epoch_seconds = false;
    bool has_epoch_millis = false;
    bool has_epoch_nanos = false;
    long epoch_seconds = 0;
    long epoch_millis = 0;
    long epoch_nanos = 0;
    if (!ig_temporal_map_optional_integer(fields, 19, has_epoch_seconds, epoch_seconds)
            || !ig_temporal_map_optional_integer(fields, 20, has_epoch_millis, epoch_millis)
            || !ig_temporal_map_optional_integer(fields, 14, has_epoch_nanos, epoch_nanos)
            || (has_epoch_seconds && has_epoch_millis)) return;
    long seconds = 0;
    uint nanos = 0;
    int offset_seconds = 0;
    if (has_epoch_seconds) {
        seconds = epoch_seconds;
        if (has_epoch_nanos && (epoch_nanos < 0L || epoch_nanos >= 1000000000L)) return;
        nanos = uint(has_epoch_nanos ? epoch_nanos : 0L);
    } else if (has_epoch_millis) {
        seconds = epoch_millis / 1000L;
        long remainder = epoch_millis % 1000L;
        if (remainder < 0L) { seconds -= 1L; remainder += 1000L; }
        nanos = uint(remainder * 1000000L);
    } else {
        long days = 0;
        long clock = 0;
        if (!ig_temporal_map_date(utf8, fields, days)
                || !ig_temporal_map_clock(fields, clock)
                || !ig_temporal_map_timezone_offset(utf8, fields, offset_seconds)) return;
        seconds = days * 86400L + clock / 1000000000L - long(offset_seconds);
        nanos = uint(clock % 1000000000L);
    }
    output[output_base] = 5;
    output[output_base + 1] = uint(as_type<ulong>(seconds));
    output[output_base + 2] = uint(as_type<ulong>(seconds) >> 32);
    output[output_base + 3] = nanos;
    output[output_base + 4] = as_type<uint>(offset_seconds);
}

// Duration maps use the same opaque literal packet as date/time maps, but their unit and
// fractional normalization is deliberately isolated from the ISO-duration parser. This keeps
// a real device-side semantic implementation without folding the map into host-produced text.
kernel void ig_temporal_map_duration_program(
    device const uchar* input_tags [[buffer(0)]],
    device const uint* offsets [[buffer(1)]],
    device const uchar* utf8 [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant TemporalValueProgramArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    uint output_base = row * 8;
    for (uint word = 0; word < 8; ++word) output[output_base + word] = 0;
    uchar packed = input_tags[row];
    if ((packed & 3) == 0) { output[output_base] = 0; return; }
    output[output_base] = 7;
    if ((packed & 3) != 3 || (packed >> 2) != 5) return;
    IgTemporalMapFields fields;
    if (!ig_temporal_parse_map_fields(utf8, offsets[row], offsets[row + 1], fields)) return;
    long months = 0;
    long days = 0;
    long seconds = 0;
    long nanos = 0;
    if (!ig_temporal_map_duration_components(fields, months, days, seconds, nanos)) return;
    output[output_base] = 6;
    output[output_base + 1] = uint(as_type<ulong>(months));
    output[output_base + 2] = uint(as_type<ulong>(months) >> 32);
    output[output_base + 3] = uint(as_type<ulong>(days));
    output[output_base + 4] = uint(as_type<ulong>(days) >> 32);
    output[output_base + 5] = uint(as_type<ulong>(seconds));
    output[output_base + 6] = uint(as_type<ulong>(seconds) >> 32);
    output[output_base + 7] = as_type<uint>(int(nanos));
}

inline bool ig_named_datetime_read_u16(
    device const uchar* bytes,
    thread uint& cursor,
    uint end,
    thread uint& value) {
    if (cursor > end || end - cursor < 2) return false;
    value = uint(bytes[cursor]) | (uint(bytes[cursor + 1]) << 8);
    cursor += 2;
    return true;
}

inline bool ig_named_datetime_read_u32(
    device const uchar* bytes,
    thread uint& cursor,
    uint end,
    thread uint& value) {
    if (cursor > end || end - cursor < 4) return false;
    value = uint(bytes[cursor])
        | (uint(bytes[cursor + 1]) << 8)
        | (uint(bytes[cursor + 2]) << 16)
        | (uint(bytes[cursor + 3]) << 24);
    cursor += 4;
    return true;
}

inline bool ig_named_datetime_read_i32(
    device const uchar* bytes,
    thread uint& cursor,
    uint end,
    thread int& value) {
    uint raw = 0;
    if (!ig_named_datetime_read_u32(bytes, cursor, end, raw)) return false;
    value = as_type<int>(raw);
    return true;
}

inline bool ig_named_datetime_read_i64(
    device const uchar* bytes,
    thread uint& cursor,
    uint end,
    thread long& value) {
    if (cursor > end || end - cursor < 8) return false;
    ulong raw = ulong(bytes[cursor])
        | (ulong(bytes[cursor + 1]) << 8)
        | (ulong(bytes[cursor + 2]) << 16)
        | (ulong(bytes[cursor + 3]) << 24)
        | (ulong(bytes[cursor + 4]) << 32)
        | (ulong(bytes[cursor + 5]) << 40)
        | (ulong(bytes[cursor + 6]) << 48)
        | (ulong(bytes[cursor + 7]) << 56);
    cursor += 8;
    value = as_type<long>(raw);
    return true;
}

inline bool ig_named_datetime_zone_equal(
    device const uchar* bytes,
    uint input_start,
    uint input_end,
    uint table_start,
    uint table_length) {
    if (input_end < input_start || input_end - input_start != table_length) return false;
    for (uint index = 0; index < table_length; ++index) {
        if (bytes[input_start + index] != bytes[table_start + index]) return false;
    }
    return true;
}

__attribute__((noinline)) bool ig_temporal_named_zone_index(
    device const uchar* utf8,
    uint input_zone_start,
    uint input_zone_end,
    uint zone_table_start,
    uint zone_table_end,
    uint zone_count,
    thread uint& zone_index) {
    if (zone_table_start >= zone_table_end) return false;
    uint cursor = zone_table_start;
    uint encoded_zone_count = 0;
    if (!ig_named_datetime_read_u32(utf8, cursor, zone_table_end, encoded_zone_count)
            || encoded_zone_count != zone_count) return false;
    for (uint current_zone = 0; current_zone < zone_count; ++current_zone) {
        uint name_length = 0;
        if (!ig_named_datetime_read_u16(utf8, cursor, zone_table_end, name_length)
                || cursor > zone_table_end || zone_table_end - cursor < name_length) return false;
        uint name_start = cursor;
        cursor += name_length;
        uint interval_count = 0;
        if (!ig_named_datetime_read_u32(utf8, cursor, zone_table_end, interval_count)) return false;
        bool matching_zone = ig_named_datetime_zone_equal(
            utf8, input_zone_start, input_zone_end, name_start, name_length);
        for (uint interval = 0; interval < interval_count; ++interval) {
            long ignored_start = 0;
            long ignored_end = 0;
            int ignored_offset = 0;
            if (!ig_named_datetime_read_i64(utf8, cursor, zone_table_end, ignored_start)
                    || !ig_named_datetime_read_i64(utf8, cursor, zone_table_end, ignored_end)
                    || !ig_named_datetime_read_i32(utf8, cursor, zone_table_end, ignored_offset)) {
                return false;
            }
        }
        if (matching_zone) {
            zone_index = current_zone;
            return true;
        }
    }
    return false;
}

inline bool ig_temporal_resolve_named_local(
    device const uchar* utf8,
    uint input_zone_start,
    uint input_zone_end,
    long local_seconds,
    bool has_declared_offset,
    int declared_offset,
    uint zone_table_start,
    uint zone_table_end,
    uint zone_count,
    thread long& seconds,
    thread uint& zone_index) {
    if (zone_table_start >= zone_table_end) return false;
    uint cursor = zone_table_start;
    uint encoded_zone_count = 0;
    if (!ig_named_datetime_read_u32(utf8, cursor, zone_table_end, encoded_zone_count)
            || encoded_zone_count != zone_count) return false;
    for (uint current_zone = 0; current_zone < zone_count; ++current_zone) {
        uint name_length = 0;
        if (!ig_named_datetime_read_u16(utf8, cursor, zone_table_end, name_length)
                || cursor > zone_table_end || zone_table_end - cursor < name_length) return false;
        uint name_start = cursor;
        cursor += name_length;
        uint interval_count = 0;
        if (!ig_named_datetime_read_u32(utf8, cursor, zone_table_end, interval_count)) return false;
        bool matching_zone = ig_named_datetime_zone_equal(
            utf8, input_zone_start, input_zone_end, name_start, name_length);
        bool found = false;
        long found_seconds = 0;
        for (uint interval = 0; interval < interval_count; ++interval) {
            long interval_start = 0;
            long interval_end = 0;
            int interval_offset = 0;
            if (!ig_named_datetime_read_i64(utf8, cursor, zone_table_end, interval_start)
                    || !ig_named_datetime_read_i64(utf8, cursor, zone_table_end, interval_end)
                    || !ig_named_datetime_read_i32(utf8, cursor, zone_table_end, interval_offset)) {
                return false;
            }
            if (!matching_zone || (has_declared_offset && interval_offset != declared_offset)) continue;
            long candidate = local_seconds - long(interval_offset);
            if (candidate >= interval_start && candidate < interval_end) {
                if (found && !has_declared_offset) return false;
                found = true;
                found_seconds = candidate;
            }
        }
        if (matching_zone && found) {
            seconds = found_seconds;
            zone_index = current_zone;
            return true;
        }
    }
    return false;
}

__attribute__((noinline)) bool ig_temporal_parse_named_datetime(
    device const uchar* utf8,
    uint start,
    uint end,
    uint zone_table_start,
    uint zone_table_end,
    uint zone_count,
    thread long& seconds,
    thread uint& nanos,
    thread uint& zone_index) {
    if (end <= start || zone_table_start >= zone_table_end) return false;
    uint opening = end;
    uint closing = end;
    for (uint index = start; index < end; ++index) {
        if (utf8[index] == uchar('[')) {
            if (opening != end) return false;
            opening = index;
        } else if (utf8[index] == uchar(']')) {
            if (closing != end) return false;
            closing = index;
        }
    }
    if (opening == end || closing != end - 1 || opening == start || opening + 1 == closing) return false;
    uint separator = opening;
    for (uint index = start; index < opening; ++index) {
        if (utf8[index] == uchar('T') || utf8[index] == uchar('t')) {
            if (separator != opening) return false;
            separator = index;
        }
    }
    if (separator == opening || separator == start || separator + 1 == opening) return false;
    long epoch_days = 0;
    if (!ig_temporal_parse_date(utf8, start, separator, epoch_days)) return false;
    if (epoch_days < ig_temporal_days_from_civil(1800L, 1u, 1u)
            || epoch_days >= ig_temporal_days_from_civil(2201L, 1u, 1u)) return false;
    bool has_declared_offset = false;
    for (uint index = separator + 1; index < opening; ++index) {
        uchar value = utf8[index];
        if (value == uchar('Z') || value == uchar('z') || value == uchar('+') || value == uchar('-')) {
            has_declared_offset = true;
            break;
        }
    }
    long local_nanos = 0;
    int declared_offset = 0;
    bool parsed_clock = has_declared_offset
        ? ig_temporal_parse_offset_time(
            utf8, separator + 1, opening, local_nanos, declared_offset)
        : ig_temporal_parse_local_time(utf8, separator + 1, opening, local_nanos);
    if (!parsed_clock) return false;
    long local_seconds = epoch_days * 86400L + local_nanos / 1000000000L;
    nanos = uint(local_nanos % 1000000000L);
    uint input_zone_start = opening + 1;
    uint input_zone_end = closing;
    return ig_temporal_resolve_named_local(
        utf8,
        input_zone_start,
        input_zone_end,
        local_seconds,
        has_declared_offset,
        declared_offset,
        zone_table_start,
        zone_table_end,
        zone_count,
        seconds,
        zone_index);
}

