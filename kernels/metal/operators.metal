constant ulong IG_Q_DOUBLE_POW5_TABLE[26] = {
    1ul, 5ul, 25ul, 125ul, 625ul, 3125ul, 15625ul, 78125ul, 390625ul,
    1953125ul, 9765625ul, 48828125ul, 244140625ul, 1220703125ul,
