};

struct DeleteStepArgs {
    ulong index;
};

inline ulong ig_delete_word(device const long* words, ulong index) {
    return as_type<ulong>(words[index]);
}

inline bool ig_delete_range(ulong base, ulong count, ulong total) {
    return base <= total && count <= total - base;
}

inline bool ig_delete_product(ulong left, ulong right, thread ulong& product) {
    if (left > IG_DELETE_MAX_DIMENSION || right > IG_DELETE_MAX_DIMENSION) return false;
    product = left * right;
    return true;
}

inline void ig_delete_fail(device ulong* output, ulong status) {
    if (output[2] == 0ul) output[2] = status;
}

inline bool ig_delete_ready(device ulong* output) {
    return output[2] == 0ul;
}

inline void ig_delete_write_receipt(
    device ulong* output,
    constant DeleteArgs& args,
    ulong receipt,
    ulong obligation_id,
    ulong obligation_kind,
    ulong scope,
    ulong scope_index,
    ulong input_rows,
    ulong output_rows) {
    if (receipt >= args.receipt_count) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    ulong base = args.receipt_base + receipt * IG_DELETE_RECEIPT_WORDS;
    output[base] = args.execution_high;
    output[base + 1ul] = args.execution_low;
    output[base + 2ul] = obligation_id;
    output[base + 3ul] = obligation_kind;
    output[base + 4ul] = scope;
    output[base + 5ul] = scope_index;
    output[base + 6ul] = input_rows;
    output[base + 7ul] = output_rows;
    output[base + 8ul] = 2ul;
}

inline bool ig_delete_node_matches(
    device const long* graph,
    device const long* program,
    constant DeleteArgs& args,
    ulong node,
    ulong label_offset,
    ulong label_count) {
    if (node >= args.node_count) return false;
    ulong active = ig_delete_word(graph, args.node_active_base + node);
    ulong layer = ig_delete_word(graph, args.node_layer_base + node);
    if (active > 1ul || layer > IG_MAX_LAYER_UL) return false;
    if (active == 0ul || (ig_delete_word(program, 2ul) & (1ul << layer)) == 0ul) return false;
    for (ulong index = 0ul; index < label_count; ++index) {
        ulong lane = ig_delete_word(program, label_offset + index);
        if (lane >= args.label_lane_count) return false;
        ulong member = ig_delete_word(graph, args.label_base + lane * args.node_count + node);
        if (member != 1ul) return false;
    }
    return true;
}

inline bool ig_delete_edge_matches(
    device const long* graph,
    device const long* program,
    constant DeleteArgs& args,
    ulong edge) {
    if (edge >= args.edge_count) return false;
    ulong active = ig_delete_word(graph, args.edge_active_base + edge);
    ulong layer = ig_delete_word(graph, args.edge_layer_base + edge);
    if (active > 1ul || layer > IG_MAX_LAYER_UL) return false;
    if (active == 0ul || (ig_delete_word(program, 2ul) & (1ul << layer)) == 0ul) return false;
    ulong type_count = ig_delete_word(program, 9ul);
    if (type_count == 0ul) return true;
    ulong type_offset = ig_delete_word(program, 8ul);
    ulong relationship_type = ig_delete_word(graph, args.edge_type_base + edge);
    for (ulong index = 0ul; index < type_count; ++index) {
        if (ig_delete_word(program, type_offset + index) == relationship_type) return true;
    }
    return false;
}

inline bool ig_delete_compare(long left, ulong operation, long right) {
    if (operation == 0ul) return left == right;
    if (operation == 1ul) return left != right;
    if (operation == 2ul) return left < right;
    if (operation == 3ul) return left <= right;
    if (operation == 4ul) return left > right;
    return operation == 5ul && left >= right;
}

inline ulong ig_delete_magnitude(long value) {
    ulong bits = as_type<ulong>(value);
    return value < 0 ? (~bits) + 1ul : bits;
}

inline long ig_delete_remainder(long value, long divisor) {
    ulong numerator = ig_delete_magnitude(value);
    ulong denominator = ig_delete_magnitude(divisor);
    ulong remainder = 0ul;
    for (uint step = 0u; step < 64u; ++step) {
        uint bit = 63u - step;
        remainder = (remainder << 1ul) | ((numerator >> bit) & 1ul);
        if (remainder >= denominator) remainder -= denominator;
    }
    if (value < 0 && remainder != 0ul) remainder = (~remainder) + 1ul;
    return as_type<long>(remainder);
}

inline bool ig_delete_binding_row(
    device ulong* output,
    constant DeleteArgs& args,
    ulong binding_kind,
    ulong binding_index,
    ulong row,
    thread ulong& dense) {
    if (row >= output[17]) return false;
    ulong expansion_count = output[35];
    if (binding_kind == IG_DELETE_BINDING_NODE) {
        ulong column = 0ul;
        if (binding_index == 0ul) column = 0ul;
        else if (binding_index == IG_DELETE_NODE_END && expansion_count != 0ul) {
            column = expansion_count;
        } else if (binding_index < expansion_count) column = binding_index;
        else return false;
        dense = output[args.start_row_base + column * args.selector_capacity + row];
        return dense == IG_DELETE_NULL_ROW || dense < args.node_count;
    }
    if (binding_kind == IG_DELETE_BINDING_RELATIONSHIP
            && binding_index < expansion_count) {
        dense = output[
            args.relationship_row_base + binding_index * args.selector_capacity + row];
        return dense == IG_DELETE_NULL_ROW || dense < args.edge_count;
    }
    return false;
}

inline uint ig_delete_source_value(
    device const long* graph,
    device ulong* output,
    constant DeleteArgs& args,
    ulong source_kind,
    ulong binding_kind,
    ulong binding_index,
    ulong property_mode,
    ulong property_lane,
    ulong constant_bits,
    ulong row,
    thread long& value,
    thread bool& valid) {
    valid = false;
    value = 0;
    if (source_kind == IG_DELETE_SOURCE_CONSTANT) {
        value = as_type<long>(constant_bits);
        valid = true;
        return 0u;
    }
    if (source_kind == IG_DELETE_SOURCE_AGGREGATE) {
        if (output[args.control_base + 6ul] != 1ul) return 1u;
        value = as_type<long>(output[args.control_base + 7ul]);
        valid = true;
        return 0u;
    }
    if (source_kind == IG_DELETE_SOURCE_NULL_ENTITY) {
        return (binding_kind == IG_DELETE_BINDING_NODE
            || binding_kind == IG_DELETE_BINDING_RELATIONSHIP) ? 0u : 1u;
    }
    if (source_kind == IG_DELETE_SOURCE_RELATIONSHIP_TYPE) {
        if (binding_kind != IG_DELETE_BINDING_RELATIONSHIP) return 1u;
        ulong dense = 0ul;
        if (!ig_delete_binding_row(
                output, args, binding_kind, binding_index, row, dense)) return 1u;
        if (dense == IG_DELETE_NULL_ROW) return 0u;
        if (dense >= args.edge_count) return 1u;
        value = as_type<long>(ig_delete_word(graph, args.edge_type_base + dense));
        valid = true;
        return 0u;
    }
    if (source_kind != IG_DELETE_SOURCE_PROPERTY) return 1u;
    if (property_mode == IG_DELETE_PROPERTY_INCOMPATIBLE) return 2u;
    if (property_mode == IG_DELETE_PROPERTY_ABSENT) return 0u;
    if (property_mode != IG_DELETE_PROPERTY_INTEGER) return 1u;
    ulong dense = 0ul;
    if (!ig_delete_binding_row(output, args, binding_kind, binding_index, row, dense)) return 1u;
    if (dense == IG_DELETE_NULL_ROW) return 0u;
    ulong value_base = 0ul;
    ulong validity_base = 0ul;
    ulong row_count = 0ul;
    ulong lane_count = 0ul;
    if (binding_kind == IG_DELETE_BINDING_NODE) {
        value_base = args.node_property_value_base;
        validity_base = args.node_property_validity_base;
        row_count = args.node_count;
        lane_count = args.node_property_count;
    } else if (binding_kind == IG_DELETE_BINDING_RELATIONSHIP) {
        value_base = args.edge_property_value_base;
        validity_base = args.edge_property_validity_base;
        row_count = args.edge_count;
        lane_count = args.edge_property_count;
    } else return 1u;
    if (property_lane >= lane_count || dense >= row_count) return 1u;
    ulong validity = ig_delete_word(graph, validity_base + property_lane * row_count + dense);
    if (validity > 1ul) return 1u;
    if (validity == 0ul) return 0u;
    value = as_type<long>(ig_delete_word(graph, value_base + property_lane * row_count + dense));
    valid = true;
    return 0u;
}

kernel void ig_delete_initialize(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    for (uint index = 0u; index < uint(args.output_word_count); ++index) output[index] = 0ul;
    output[0] = IG_DELETE_OUTPUT_MAGIC;
    output[1] = IG_DELETE_VERSION;
    output[4] = args.execution_high;
    output[5] = args.execution_low;
    output[6] = args.project_high;
    output[7] = args.project_low;
    output[8] = args.bookmark_term;
    output[9] = args.bookmark_index;
    output[10] = args.graph_revision;
    output[11] = args.layout_version;
    output[12] = args.fingerprint_0;
    output[13] = args.fingerprint_1;
    output[14] = args.fingerprint_2;
    output[15] = args.fingerprint_3;
    output[18] = args.command_count;
    output[21] = args.receipt_count;
    output[24] = args.scratch_bytes;
    output[25] = args.graph_word_count;
    output[26] = args.program_word_count;
    output[27] = args.output_word_count;
    output[28] = args.selector_capacity;
    output[29] = args.intent_capacity;
    output[30] = args.dependency_capacity;
    output[31] = args.final_capacity;
    output[32] = args.filter_count;
    output[33] = args.stage_count;
    (void)graph;
    (void)program;
}

kernel void ig_delete_validate_program_header(
