inline bool ig_temporal_parse_named_map_datetime(
    device const uchar* utf8,
    uint start,
    uint end,
    uint zone_table_start,
    uint zone_table_end,
    uint zone_count,
    thread long& seconds,
    thread uint& nanos,
    thread uint& zone_index) {
    IgTemporalMapFields fields;
    if (!ig_temporal_parse_map_fields(utf8, start, end, fields)
            || fields.present[15] == 0
            || fields.tags[15] != IG_TEMPORAL_MAP_VALUE_STRING) return false;
    uint input_zone_start = fields.payload_starts[15];
    uint input_zone_end = fields.payload_ends[15];
    if (input_zone_end <= input_zone_start) return false;
    bool has_epoch_seconds = false;
    bool has_epoch_millis = false;
    bool has_epoch_nanos = false;
    long epoch_seconds = 0;
    long epoch_millis = 0;
    long epoch_nanos = 0;
    if (!ig_temporal_map_optional_integer(fields, 19, has_epoch_seconds, epoch_seconds)
            || !ig_temporal_map_optional_integer(fields, 20, has_epoch_millis, epoch_millis)
            || !ig_temporal_map_optional_integer(fields, 14, has_epoch_nanos, epoch_nanos)
            || (has_epoch_seconds && has_epoch_millis)) return false;
    if (has_epoch_seconds || has_epoch_millis) {
        if (!ig_temporal_named_zone_index(
                utf8,
                input_zone_start,
                input_zone_end,
                zone_table_start,
                zone_table_end,
                zone_count,
                zone_index)) return false;
        if (has_epoch_seconds) {
            seconds = epoch_seconds;
            if (has_epoch_nanos && (epoch_nanos < 0L || epoch_nanos >= 1000000000L)) return false;
            nanos = uint(has_epoch_nanos ? epoch_nanos : 0L);
        } else {
            seconds = epoch_millis / 1000L;
            long remainder = epoch_millis % 1000L;
            if (remainder < 0L) { seconds -= 1L; remainder += 1000L; }
            nanos = uint(remainder * 1000000L);
        }
        return true;
    }
    long epoch_days = 0;
    long clock = 0;
    if (!ig_temporal_map_date(utf8, fields, epoch_days)
            || !ig_temporal_map_clock(fields, clock)
            || epoch_days < ig_temporal_days_from_civil(1800L, 1u, 1u)
            || epoch_days >= ig_temporal_days_from_civil(2201L, 1u, 1u)) return false;
    nanos = uint(clock % 1000000000L);
    return ig_temporal_resolve_named_local(
        utf8,
        input_zone_start,
        input_zone_end,
        epoch_days * 86400L + clock / 1000000000L,
        false,
        0,
        zone_table_start,
        zone_table_end,
        zone_count,
        seconds,
        zone_index);
}

// The register program is substantially larger than the common scalar/sort kernels. Keep it out
// of the eagerly compiled operator library and include it only in the dedicated lazy register
// library. An undefined preprocessor identifier evaluates to zero, so every other library built
// from this source excludes this section by default.
#if IG_INCLUDE_TEMPORAL_REGISTER

#ifndef IG_INCLUDE_TEMPORAL_REGISTER_KERNELS
#define IG_INCLUDE_TEMPORAL_REGISTER_KERNELS IG_INCLUDE_TEMPORAL_REGISTER
#endif

#ifndef IG_INCLUDE_TEMPORAL_ARITHMETIC_KERNELS
#define IG_INCLUDE_TEMPORAL_ARITHMETIC_KERNELS IG_INCLUDE_TEMPORAL_REGISTER
#endif

// Dependent temporal projections use one uniform-stride SSA register file. Canonical temporal
// records retain their eight-word prefix; String records use tag/length plus bounded inline UTF-8.
// Registers remain device-resident and only declared outputs cross the Rust boundary.
struct TemporalRegisterStepArgs {
    uint function;
    uint input_tag;
    uint payload_end;
    uint zone_table_start;
    uint zone_table_end;
    uint zone_count;
    uint register_count;
    uint source_register;
    uint right_register;
    uint temporal_operation;
    uint current_seconds_low;
    uint current_seconds_high;
    uint current_nanos;
    uint register_stride;
    uint string_capacity;
};

struct IgTemporalRegisterParts {
    uchar has_date;
    uchar has_clock;
    uchar zone_kind; // 0 none, 1 fixed offset, 2 named zone
    uchar has_instant;
    long epoch_days;
    long clock_nanos;
    int offset_seconds;
    uint zone_index;
    long seconds;
    uint nanos;
};

inline long ig_temporal_register_floor_div(long value, long divisor) {
    long quotient = value / divisor;
    long remainder = value % divisor;
    return remainder < 0L ? quotient - 1L : quotient;
}

inline long ig_temporal_register_current_seconds(
    thread const TemporalRegisterStepArgs& args) {
    return as_type<long>(
        ulong(args.current_seconds_low) | (ulong(args.current_seconds_high) << 32));
}

inline void ig_temporal_register_clear(
    device uint* output,
    uint register_stride) {
    for (uint word = 0u; word < register_stride; ++word) output[word] = 0u;
    output[0] = 7u;
}

inline void ig_temporal_register_write_long(
    device uint* output,
    uint offset,
    long value) {
    ulong bits = as_type<ulong>(value);
    output[offset] = uint(bits);
    output[offset + 1u] = uint(bits >> 32);
}

inline long ig_temporal_register_read_long(
    device const uint* registers,
    uint base,
    uint offset) {
    return as_type<long>(
        ulong(registers[base + offset])
            | (ulong(registers[base + offset + 1u]) << 32));
}

inline bool ig_temporal_register_expected_comparison_tag(uint function, uint tag) {
    if (function == 0u) return tag == 1u;
    if (function == 1u) return tag == 2u;
    if (function == 2u) return tag == 3u;
    if (function == 3u) return tag == 4u;
    if (function == 4u) return tag == 5u || tag == 8u;
    return function == 5u && tag == 6u;
}

inline bool ig_temporal_register_zone_name_range(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    uint requested_zone,
    thread uint& name_start,
    thread uint& name_length) {
    if (requested_zone >= args.zone_count
            || args.zone_table_start >= args.zone_table_end) return false;
    uint cursor = args.zone_table_start;
    uint encoded_zone_count = 0u;
    if (!ig_named_datetime_read_u32(
            bytes, cursor, args.zone_table_end, encoded_zone_count)
            || encoded_zone_count != args.zone_count) return false;
    for (uint zone = 0u; zone < args.zone_count; ++zone) {
        uint length = 0u;
        if (!ig_named_datetime_read_u16(bytes, cursor, args.zone_table_end, length)
                || cursor > args.zone_table_end
                || args.zone_table_end - cursor < length) return false;
        uint start = cursor;
        cursor += length;
        uint interval_count = 0u;
        if (!ig_named_datetime_read_u32(
                bytes, cursor, args.zone_table_end, interval_count)
                || cursor > args.zone_table_end
                || interval_count > (args.zone_table_end - cursor) / 20u) return false;
        cursor += interval_count * 20u;
        if (zone == requested_zone) {
            name_start = start;
            name_length = length;
            return true;
        }
    }
    return false;
}

inline uint ig_temporal_register_fixed_zone_length(int offset_seconds) {
    long magnitude = offset_seconds < 0 ? -long(offset_seconds) : long(offset_seconds);
    return magnitude % 60L == 0L ? 6u : 9u;
}

inline bool ig_temporal_register_fixed_zone_char(
    int offset_seconds,
    uint index,
    thread uchar& value) {
    long magnitude = offset_seconds < 0 ? -long(offset_seconds) : long(offset_seconds);
    if (magnitude > 86399L) return false;
    uint hours = uint(magnitude / 3600L);
    uint minutes = uint((magnitude / 60L) % 60L);
    uint seconds = uint(magnitude % 60L);
    uint length = seconds == 0u ? 6u : 9u;
    if (index >= length) return false;
    if (index == 0u) value = offset_seconds < 0 ? uchar('-') : uchar('+');
    else if (index == 1u) value = uchar('0' + hours / 10u);
    else if (index == 2u) value = uchar('0' + hours % 10u);
    else if (index == 3u || index == 6u) value = uchar(':');
    else if (index == 4u) value = uchar('0' + minutes / 10u);
    else if (index == 5u) value = uchar('0' + minutes % 10u);
    else if (index == 7u) value = uchar('0' + seconds / 10u);
    else value = uchar('0' + seconds % 10u);
    return true;
}

