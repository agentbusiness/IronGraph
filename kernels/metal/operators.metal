}

kernel void ig_delete_validate_program_filters(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong offset = ig_delete_word(program, 12ul);
    for (ulong index = 0ul; index < args.filter_count; ++index) {
        ulong base = offset + index * IG_DELETE_FILTER_WORDS;
        ulong property_mode = ig_delete_word(program, base + 2ul);
        if (ig_delete_word(program, base) != IG_DELETE_BINDING_RELATIONSHIP
            || ig_delete_word(program, base + 1ul) != 0ul
            || property_mode > IG_DELETE_PROPERTY_INCOMPATIBLE
            || (property_mode == IG_DELETE_PROPERTY_INTEGER
                && ig_delete_word(program, base + 3ul) >= args.edge_property_count)
            || ig_delete_word(program, base + 4ul) > 5ul
            || ig_delete_word(program, base + 6ul) == 0ul) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
    }
    output[args.control_base] |= 2ul;
    (void)graph;
}

kernel void ig_delete_validate_program_commands(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong offset = ig_delete_word(program, 14ul);
    for (ulong index = 0ul; index < args.command_count; ++index) {
        ulong base = offset + index * IG_DELETE_COMMAND_WORDS;
        ulong kind = ig_delete_word(program, base);
        ulong binding = ig_delete_word(program, base + 1ul);
        ulong expansion_count = ig_delete_word(program, 30ul);
        bool binding_valid = (kind == IG_DELETE_BINDING_NODE
                && (binding == 0ul
                    || (binding == IG_DELETE_NODE_END && expansion_count != 0ul)
                    || (binding > 0ul && binding < expansion_count)))
            || (kind == IG_DELETE_BINDING_RELATIONSHIP && binding < expansion_count);
        ulong selector = ig_delete_word(program, base + 11ul);
        ulong selector_index = ig_delete_word(program, base + 12ul);
        bool initial_optional_command = ig_delete_word(program, 48ul) == 0ul
            || (selector == 0ul && selector_index == 0ul);
        bool expansion_optional_command = ig_delete_word(program, 11ul) == 0ul
            || (selector == 0ul && selector_index == 0ul);
        bool exact_three_hop_command = true;
        if (ig_delete_word(program, 50ul) == 1ul) {
            ulong expected_kind = (index == 1ul || index == 3ul || index == 5ul)
                ? IG_DELETE_BINDING_RELATIONSHIP
                : IG_DELETE_BINDING_NODE;
            ulong expected_binding = index == 0ul ? 0ul
                : index == 1ul ? 0ul
                : index == 2ul ? 1ul
                : index == 3ul ? 1ul
                : index == 4ul ? 2ul
                : index == 5ul ? 2ul
                : IG_DELETE_NODE_END;
            exact_three_hop_command = kind == expected_kind
                && binding == expected_binding
                && ig_delete_word(program, base + 2ul) == 1ul
                && selector == 0ul
                && selector_index == 0ul;
        }
        bool exact_variable_path_command = true;
        if (ig_delete_word(program, 51ul) == 1ul) {
            exact_variable_path_command = kind == IG_DELETE_BINDING_NODE
                && binding == (index == 0ul ? 0ul : IG_DELETE_NODE_END)
                && ig_delete_word(program, base + 2ul) == 1ul
                && selector == 0ul
                && selector_index == 0ul;
        }
        if (!binding_valid || ig_delete_word(program, base + 2ul) > 1ul
            || ig_delete_word(program, base + 3ul) == 0ul
            || ig_delete_word(program, base + 7ul) == 0ul
            || !initial_optional_command
            || !expansion_optional_command
            || !exact_three_hop_command
            || !exact_variable_path_command
            || selector > 1ul
            || (selector == 0ul && selector_index != 0ul)
            || selector_index > IG_DELETE_MAX_DIMENSION
            || ig_delete_word(program, base + 13ul) != 0ul) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
    }
    output[args.control_base] |= 4ul;
    (void)graph;
}

kernel void ig_delete_validate_program_stages(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong offset = ig_delete_word(program, 16ul);
    for (ulong index = 0ul; index < args.stage_count; ++index) {
        ulong base = offset + index * IG_DELETE_STAGE_WORDS;
        ulong opcode = ig_delete_word(program, base);
        ulong source = ig_delete_word(program, base + 1ul);
        ulong property_mode = ig_delete_word(program, base + 4ul);
        bool source_valid = source <= IG_DELETE_SOURCE_RELATIONSHIP_TYPE
            && (source != IG_DELETE_SOURCE_NULL_ENTITY
                || (ig_delete_word(program, base + 2ul) == IG_DELETE_BINDING_NODE
                    || ig_delete_word(program, base + 2ul)
                        == IG_DELETE_BINDING_RELATIONSHIP))
            && (source != IG_DELETE_SOURCE_NULL_ENTITY || opcode == 1ul)
            && (source != IG_DELETE_SOURCE_RELATIONSHIP_TYPE
                || (ig_delete_word(program, base + 2ul) == IG_DELETE_BINDING_RELATIONSHIP
                    && property_mode == IG_DELETE_PROPERTY_ABSENT
                    && opcode == 1ul));
        if (source == IG_DELETE_SOURCE_NULL_ENTITY) {
            ulong kind = ig_delete_word(program, base + 2ul);
            ulong command = ig_delete_word(program, 14ul);
            bool exact_nullable_entity = ig_delete_word(program, 49ul) == 1ul
                && args.stage_count == 1ul
                && index == 0ul
                && args.command_count == 1ul
                && ig_delete_word(program, 18ul) == IG_DELETE_SOURCE_NULL_ENTITY
                && ig_delete_word(program, 19ul) == kind
                && ig_delete_word(program, 20ul) == 0ul
                && ig_delete_word(program, command) == kind
                && ig_delete_word(program, command + 1ul) == 0ul
                && ig_delete_word(program, command + 11ul) == 0ul
                && ig_delete_word(program, command + 12ul) == 0ul;
            for (ulong field = 0ul; field < 6ul && exact_nullable_entity; ++field) {
                exact_nullable_entity = ig_delete_word(program, 18ul + field)
                    == ig_delete_word(program, base + 1ul + field);
            }
            source_valid = source_valid && exact_nullable_entity;
        }
        bool exact_variable_path_stage = ig_delete_word(program, 51ul) == 0ul
            || (index == 0ul
                && opcode == 6ul
                && source == IG_DELETE_SOURCE_NONE
                && ig_delete_word(program, base + 2ul) == 0ul
                && ig_delete_word(program, base + 3ul) == 0ul
                && ig_delete_word(program, base + 4ul) == 0ul
                && ig_delete_word(program, base + 5ul) == 0ul
                && ig_delete_word(program, base + 6ul) == 0ul
                && ig_delete_word(program, base + 7ul) == 0ul
                && ig_delete_word(program, base + 8ul) == 0ul);
        if (opcode < 1ul || opcode > 6ul || !source_valid
            || !exact_variable_path_stage
            || property_mode > IG_DELETE_PROPERTY_INCOMPATIBLE
            || ig_delete_word(program, base + 9ul) == 0ul
            || (opcode == 2ul && as_type<long>(ig_delete_word(program, base + 7ul)) == 0)) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
    }
    if ((ig_delete_word(program, 31ul) == 0ul && args.stage_count != 0ul)
        || (ig_delete_word(program, 31ul) == 1ul && args.stage_count == 0ul)
        || (ig_delete_word(program, 51ul) == 1ul
            && (ig_delete_word(program, 18ul) != IG_DELETE_SOURCE_AGGREGATE
                || ig_delete_word(program, 19ul) != 0ul
                || ig_delete_word(program, 20ul) != 0ul
                || ig_delete_word(program, 21ul) != IG_DELETE_PROPERTY_ABSENT
                || ig_delete_word(program, 22ul) != 0ul
                || ig_delete_word(program, 23ul) != 0ul))
        || (ig_delete_word(program, 18ul) == IG_DELETE_SOURCE_NULL_ENTITY
            && (args.stage_count != 1ul
                || ig_delete_word(program, ig_delete_word(program, 16ul) + 1ul)
                    != IG_DELETE_SOURCE_NULL_ENTITY))) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    output[args.control_base] |= 8ul;
    (void)graph;
}

kernel void ig_delete_validate_nodes(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    for (ulong node = 0ul; node < args.node_count; ++node) {
        if (ig_delete_word(graph, args.node_active_base + node) > 1ul
            || ig_delete_word(graph, args.node_layer_base + node) > IG_MAX_LAYER_UL) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        for (ulong lane = 0ul; lane < args.label_lane_count; ++lane) {
            if (ig_delete_word(graph, args.label_base + lane * args.node_count + node) > 1ul) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
        }
