inline bool ig_segmented_graph_range(ulong start, ulong length, ulong capacity) {
    return start <= capacity && length <= capacity - start;
}

inline bool ig_segmented_graph_product(ulong left, ulong right, thread ulong& product) {
    uint left_low = uint(left);
    uint left_high = uint(left >> 32ul);
    uint right_low = uint(right);
    uint right_high = uint(right >> 32ul);
    ulong low_low = ulong(left_low) * ulong(right_low);
    ulong low_high = ulong(left_low) * ulong(right_high);
    ulong high_low = ulong(left_high) * ulong(right_low);
    ulong high_high = ulong(left_high) * ulong(right_high);

    // Exact base-2^32 limbs preserve the complete u64 contract while avoiding an AGX G_UMULO
    // legalization failure for two unrestricted device-loaded 64-bit operands.
    ulong middle = (low_low >> 32ul)
        + ulong(uint(low_high)) + ulong(uint(high_low));
    product = (middle << 32ul) | ulong(uint(low_low));
    ulong high_product = high_high + (low_high >> 32ul)
        + (high_low >> 32ul) + (middle >> 32ul);
    return high_product == 0ul;
}

inline bool ig_segmented_graph_sum(ulong left, ulong right, thread ulong& sum) {
    sum = left + right;
    return sum >= left;
}

inline bool ig_segmented_graph_advance(
    thread ulong& cursor,
    ulong expected,
    ulong count,
    ulong capacity) {
    if (cursor != expected || !ig_segmented_graph_range(cursor, count, capacity)) return false;
    cursor += count;
    return true;
}

inline uint ig_segmented_graph_read_u32_le(device const uchar* bytes, ulong start) {
    return uint(bytes[start])
        | (uint(bytes[start + 1ul]) << 8u)
        | (uint(bytes[start + 2ul]) << 16u)
        | (uint(bytes[start + 3ul]) << 24u);
}

inline ulong ig_segmented_graph_read_u64_le(device const uchar* bytes, ulong start) {
    ulong value = 0ul;
    for (uint byte = 0u; byte < 8u; ++byte) {
        value |= ulong(bytes[start + ulong(byte)]) << (byte * 8u);
    }
    return value;
}

inline void ig_segmented_graph_header_status(
    device ulong* output_header,
    uint status,
    uint phase) {
    output_header[1] = ulong(status) | (ulong(phase) << 32u);
}

inline void ig_segmented_graph_initialize_output(
    device const ulong* program,
    device ulong* output_header) {
    for (ulong word = 0ul; word < IG_SEGMENTED_GRAPH_OUTPUT_HEADER_WORDS; ++word) {
        output_header[word] = 0ul;
    }
    output_header[0] = IG_SEGMENTED_GRAPH_OUTPUT_MAGIC;
    ig_segmented_graph_header_status(
        output_header, IG_SEGMENTED_STATUS_NOT_EXECUTED, IG_SEGMENTED_PHASE_NOT_STARTED);
    output_header[2] = program[2];
    output_header[3] = program[3];
    output_header[7] = program[4];
    output_header[8] = program[14];
    output_header[9] = program[27];
    output_header[10] = program[17];
    output_header[11] = program[23] | (program[24] << 32u);
    output_header[12] = program[25];
    for (ulong lane = 0ul; lane < 4ul; ++lane) {
        output_header[13ul + lane] = program[37ul + lane];
        output_header[17ul + lane] = program[33ul + lane];
    }
    output_header[21] = program[9];
    output_header[22] = program[12];
    output_header[23] = IG_SEGMENTED_GRAPH_OUTPUT_VERSION;
}

inline void ig_segmented_graph_fail(
    device ulong* output_header,
    uint status) {
    output_header[4] = 0ul;
    output_header[5] = 0ul;
    ig_segmented_graph_header_status(output_header, status, IG_SEGMENTED_PHASE_FAILED);
}

inline bool ig_segmented_graph_validation_enter(
    device atomic_uint* graph_control,
    uint expected_phase) {
    uint status = atomic_load_explicit(&graph_control[0], memory_order_relaxed);
    if (status != IG_SEGMENTED_STATUS_NOT_EXECUTED) return false;
    uint execution_phase = atomic_load_explicit(&graph_control[1], memory_order_relaxed);
    uint phase = atomic_load_explicit(&graph_control[7], memory_order_relaxed);
    if (execution_phase == IG_SEGMENTED_PHASE_NOT_STARTED && phase == expected_phase) return true;
    atomic_store_explicit(
        &graph_control[0], IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS, memory_order_relaxed);
    atomic_store_explicit(&graph_control[1], IG_SEGMENTED_PHASE_FAILED, memory_order_relaxed);
    atomic_store_explicit(
        &graph_control[7], IG_SEGMENTED_GRAPH_VALIDATION_FAILED, memory_order_relaxed);
    return false;
}

inline void ig_segmented_graph_validation_finish(
    device atomic_uint* graph_control,
    uint status,
    uint next_phase) {
    if (status != IG_SEGMENTED_STATUS_NOT_EXECUTED) {
        atomic_store_explicit(&graph_control[0], status, memory_order_relaxed);
        atomic_store_explicit(&graph_control[1], IG_SEGMENTED_PHASE_FAILED, memory_order_relaxed);
        atomic_store_explicit(
            &graph_control[7], IG_SEGMENTED_GRAPH_VALIDATION_FAILED, memory_order_relaxed);
        return;
    }
    atomic_store_explicit(&graph_control[7], next_phase, memory_order_relaxed);
}

inline bool ig_segmented_graph_scalar_cell_valid(
    IgSegmentedCellValue value,
    ulong arena_bytes) {
    if (value.tag > IG_SEGMENTED_VALUE_RELATIONSHIP) return false;
    if (value.tag == IG_SEGMENTED_VALUE_NULL) {
        return value.payload == 0ul && value.auxiliary == 0ul;
    }
    if (value.tag == IG_SEGMENTED_VALUE_BOOLEAN) {
        return value.payload <= 1ul && value.auxiliary == 0ul;
    }
    if (value.tag == IG_SEGMENTED_VALUE_INTEGER
            || value.tag == IG_SEGMENTED_VALUE_NODE
            || value.tag == IG_SEGMENTED_VALUE_RELATIONSHIP) {
        return value.auxiliary == 0ul;
    }
    if (value.tag == IG_SEGMENTED_VALUE_FLOAT) {
        return value.auxiliary == 0ul && ig_segmented_f64_finite(value.payload);
    }
    return value.payload <= arena_bytes
        && value.auxiliary <= arena_bytes - value.payload;
}

inline bool ig_segmented_graph_cell_valid(
    IgSegmentedCellValue value,
    ulong arena_bytes,
    ulong list_base,
    ulong list_limit) {
    if (value.tag != IG_SEGMENTED_VALUE_LIST) {
        return ig_segmented_graph_scalar_cell_valid(value, arena_bytes);
    }
    return value.payload >= list_base && value.payload <= list_limit
        && value.auxiliary <= list_limit - value.payload;
}

// The generic aggregation finalizer owns this packet, but the graph adapter still validates its
// complete flat-list and byte-arena shape before dereferencing any list child.  Top-level cells are
// row-major.  Every collect range must consume the next exact portion of the appended suffix, and
// STRING/BYTES payloads must consume the arena in generic publication order with no aliases,
// gaps, hidden children, nested lists, or retained NULLs.
inline bool ig_segmented_graph_aggregate_relation_valid(
    device const ulong* program,
    device const ulong* aggregate_cells,
    ulong aggregate_arena_bytes,
    ulong aggregate_rows,
    ulong aggregate_columns,
    ulong aggregate_cell_count) {
    ulong top_level_cells = 0ul;
    if (!ig_segmented_graph_product(
            aggregate_rows, aggregate_columns, top_level_cells)
            || aggregate_cell_count < top_level_cells) return false;

    ulong list_cursor = top_level_cells;
    ulong arena_cursor = 0ul;
    for (ulong index = 0ul; index < top_level_cells; ++index) {
        ulong column = index % aggregate_columns;
        bool collect_column = column >= program[5]
            && program[program[43]
                + (column - program[5]) * IG_SEGMENTED_GRAPH_AGGREGATE_WORDS]
                == IG_SEGMENTED_AGGREGATE_COLLECT;
        IgSegmentedCellValue value = ig_segmented_input_cell(
            aggregate_cells, uint(index));
        if ((value.tag == IG_SEGMENTED_VALUE_LIST) != collect_column) return false;
        if (value.tag == IG_SEGMENTED_VALUE_LIST) {
            if (value.payload != list_cursor
                    || value.auxiliary > aggregate_cell_count - list_cursor) return false;
            for (ulong child_offset = 0ul;
                    child_offset < value.auxiliary;
                    ++child_offset) {
                IgSegmentedCellValue child = ig_segmented_input_cell(
                    aggregate_cells, uint(list_cursor + child_offset));
                if (child.tag == IG_SEGMENTED_VALUE_NULL
                        || !ig_segmented_graph_scalar_cell_valid(
                            child, aggregate_arena_bytes)) return false;
                if (child.tag == IG_SEGMENTED_VALUE_STRING
                        || child.tag == IG_SEGMENTED_VALUE_BYTES) {
                    if (child.payload != arena_cursor
                            || child.auxiliary > aggregate_arena_bytes - arena_cursor) {
                        return false;
                    }
                    arena_cursor += child.auxiliary;
                }
            }
            list_cursor += value.auxiliary;
            continue;
        }
        if (!ig_segmented_graph_scalar_cell_valid(value, aggregate_arena_bytes)) return false;
        if (value.tag == IG_SEGMENTED_VALUE_STRING
                || value.tag == IG_SEGMENTED_VALUE_BYTES) {
            if (value.payload != arena_cursor
                    || value.auxiliary > aggregate_arena_bytes - arena_cursor) return false;
            arena_cursor += value.auxiliary;
        }
    }
    return list_cursor == aggregate_cell_count && arena_cursor == aggregate_arena_bytes;
}

inline uint ig_segmented_graph_numeric_binary(
    IgSegmentedCellValue left,
    ulong operation,
    IgSegmentedCellValue right,
    thread IgSegmentedCellValue& value) {
    if (left.tag == IG_SEGMENTED_VALUE_NULL || right.tag == IG_SEGMENTED_VALUE_NULL) {
        value = ig_segmented_null_cell();
        return 0u;
    }
    if (left.tag == IG_SEGMENTED_VALUE_LIST || right.tag == IG_SEGMENTED_VALUE_LIST) {
        return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
    }
    bool left_numeric = left.tag == IG_SEGMENTED_VALUE_INTEGER
        || left.tag == IG_SEGMENTED_VALUE_FLOAT;
    bool right_numeric = right.tag == IG_SEGMENTED_VALUE_INTEGER
        || right.tag == IG_SEGMENTED_VALUE_FLOAT;
    if (!left_numeric || !right_numeric) return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;

    if (left.tag == IG_SEGMENTED_VALUE_INTEGER
            && right.tag == IG_SEGMENTED_VALUE_INTEGER) {
        ulong result = 0ul;
        bool valid = true;
        if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_ADD) {
            valid = ig_scalar_program_checked_add(left.payload, right.payload, result);
        } else if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_SUBTRACT) {
            valid = ig_scalar_program_checked_subtract(left.payload, right.payload, result);
        } else if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_MULTIPLY) {
            valid = ig_scalar_program_checked_multiply(left.payload, right.payload, result);
        } else {
            long signed_left = as_type<long>(left.payload);
            long signed_right = as_type<long>(right.payload);
            if (signed_right == 0L) return IG_SEGMENTED_GRAPH_STATUS_DIVISION_BY_ZERO;
            bool exceptional = signed_left == (-0x7fffffffffffffffL - 1L)
                && signed_right == -1L;
            if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_DIVIDE) {
                if (exceptional) valid = false;
                else result = as_type<ulong>(signed_left / signed_right);
            } else if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_MODULO) {
                result = exceptional ? 0ul : as_type<ulong>(signed_left % signed_right);
            } else {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
        if (!valid) return IG_SEGMENTED_GRAPH_STATUS_ARITHMETIC_OVERFLOW;
        value.tag = IG_SEGMENTED_VALUE_INTEGER;
        value.payload = result;
        value.auxiliary = 0ul;
        return 0u;
    }

    ulong left_float = left.tag == IG_SEGMENTED_VALUE_INTEGER
        ? ig_scalar_program_i64_to_f64(left.payload) : left.payload;
    ulong right_float = right.tag == IG_SEGMENTED_VALUE_INTEGER
        ? ig_scalar_program_i64_to_f64(right.payload) : right.payload;
    if ((operation == IG_SEGMENTED_GRAPH_INSTRUCTION_DIVIDE
                || operation == IG_SEGMENTED_GRAPH_INSTRUCTION_MODULO)
            && (right_float << 1u) == 0ul) {
        return IG_SEGMENTED_GRAPH_STATUS_DIVISION_BY_ZERO;
    }
    ulong result = 0ul;
    if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_ADD) {
        result = ig_scalar_program_f64_add(left_float, right_float);
    } else if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_SUBTRACT) {
        result = ig_scalar_program_f64_add(
            left_float, right_float ^ 0x8000000000000000ul);
    } else if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_MULTIPLY) {
        result = ig_scalar_program_f64_multiply(left_float, right_float);
    } else if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_DIVIDE) {
        result = ig_scalar_program_f64_divide(left_float, right_float);
    } else if (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_MODULO) {
        if (!ig_scalar_program_f64_modulo(left_float, right_float, result)) {
            return IG_SEGMENTED_GRAPH_STATUS_ARITHMETIC_OVERFLOW;
        }
    } else {
        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }
    if (!ig_segmented_f64_finite(result)) {
        return IG_SEGMENTED_GRAPH_STATUS_ARITHMETIC_OVERFLOW;
    }
    value.tag = IG_SEGMENTED_VALUE_FLOAT;
    value.payload = result;
    value.auxiliary = 0ul;
    return 0u;
}

inline uint ig_segmented_graph_compare(
    device const uchar* arena,
    IgSegmentedCellValue left,
    ulong operation,
    IgSegmentedCellValue right,
    thread IgSegmentedCellValue& value) {
    if (left.tag == IG_SEGMENTED_VALUE_NULL || right.tag == IG_SEGMENTED_VALUE_NULL) {
        value = ig_segmented_null_cell();
        return 0u;
    }
    if (left.tag == IG_SEGMENTED_VALUE_LIST || right.tag == IG_SEGMENTED_VALUE_LIST) {
        return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
    }

    bool equality = operation == IG_SEGMENTED_GRAPH_INSTRUCTION_EQUAL
        || operation == IG_SEGMENTED_GRAPH_INSTRUCTION_NOT_EQUAL;
    bool left_numeric = left.tag == IG_SEGMENTED_VALUE_INTEGER
        || left.tag == IG_SEGMENTED_VALUE_FLOAT;
    bool right_numeric = right.tag == IG_SEGMENTED_VALUE_INTEGER
        || right.tag == IG_SEGMENTED_VALUE_FLOAT;
    if (equality) {
        bool equal = false;
        if (left_numeric && right_numeric) {
            equal = ig_segmented_numeric_order(left, right) == 0;
        } else if (left.tag == right.tag) {
            equal = left.tag == IG_SEGMENTED_VALUE_STRING
                    || left.tag == IG_SEGMENTED_VALUE_BYTES
                ? ig_segmented_bytes_equal(arena, left, right)
                : left.payload == right.payload;
        }
        value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
        value.payload = (equal
            ^ (operation == IG_SEGMENTED_GRAPH_INSTRUCTION_NOT_EQUAL)) ? 1ul : 0ul;
        value.auxiliary = 0ul;
        return 0u;
    }

    int order = 0;
    if (left_numeric && right_numeric) {
        order = ig_segmented_numeric_order(left, right);
    } else if (left.tag == IG_SEGMENTED_VALUE_STRING
            && right.tag == IG_SEGMENTED_VALUE_STRING) {
        order = ig_segmented_bytes_order(arena, left, right);
    } else if (left.tag == IG_SEGMENTED_VALUE_BOOLEAN
            && right.tag == IG_SEGMENTED_VALUE_BOOLEAN) {
        order = left.payload < right.payload ? -1 : (left.payload > right.payload ? 1 : 0);
    } else {
        value = ig_segmented_null_cell();
        return 0u;
    }
    bool compared = operation == IG_SEGMENTED_GRAPH_INSTRUCTION_LESS ? order < 0
        : operation == IG_SEGMENTED_GRAPH_INSTRUCTION_LESS_OR_EQUAL ? order <= 0
        : operation == IG_SEGMENTED_GRAPH_INSTRUCTION_GREATER ? order > 0
        : operation == IG_SEGMENTED_GRAPH_INSTRUCTION_GREATER_OR_EQUAL ? order >= 0
        : false;
    value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
    value.payload = compared ? 1ul : 0ul;
    value.auxiliary = 0ul;
    return 0u;
}

inline uint ig_segmented_graph_evaluate_expression(
    device const ulong* program,
    device const uchar* arena,
    ulong instruction_start,
    ulong instruction_count,
    device const ulong* slot_cells,
    ulong slot_row,
    ulong slot_count,
    device const ulong* document_cells,
    ulong document_cell_count,
    thread IgSegmentedCellValue& result) {
    if (instruction_count == 0ul
            || !ig_segmented_graph_range(
                instruction_start, instruction_count, program[12])) {
        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }
    IgSegmentedCellValue stack[IG_SEGMENTED_GRAPH_EXPRESSION_STACK];
    uint depth = 0u;
    for (ulong offset = 0ul; offset < instruction_count; ++offset) {
        ulong descriptor = program[48]
            + (instruction_start + offset) * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS;
        ulong opcode = program[descriptor];
        ulong argument_0 = program[descriptor + 1ul];
        ulong argument_1 = program[descriptor + 2ul];
        ulong argument_2 = program[descriptor + 3ul];
        bool small_string = opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_EQUAL_SMALL_STRING
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NOT_EQUAL_SMALL_STRING;
        bool order_string_append =
            opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_APPEND_SMALL_STRING_ORDER;
        if (!small_string && !order_string_append && argument_2 != 0ul) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        IgSegmentedCellValue value = ig_segmented_null_cell();
        if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_KEY_VALUE_LIST) {
            if (instruction_count != 1ul || offset != 0ul
                    || argument_0 == 0ul || argument_0 != program[54]
                    || program[55] < IG_SEGMENTED_KEY_VALUE_LIST_HEADER_WORDS
                    || !ig_segmented_graph_range(argument_0, program[55], program[52])
                    || program[argument_0] != IG_SEGMENTED_KEY_VALUE_LIST_MAGIC
                    || program[argument_0 + 1ul] != IG_SEGMENTED_KEY_VALUE_LIST_VERSION
                    || program[argument_0 + 2ul] != argument_1) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            value.tag = IG_SEGMENTED_VALUE_LIST;
            // The Project stage validates every value against the aggregate document bank before
            // the exact key/value completion specialization emits its real children.  An empty
            // range at the bank's end is the unique sentinel valid for every aggregate shape.
            value.payload = document_cell_count;
            value.auxiliary = 0ul;
            stack[depth++] = value;
            continue;
        }
        bool pushes_literal = opcode >= IG_SEGMENTED_GRAPH_INSTRUCTION_SLOT
            && opcode <= IG_SEGMENTED_GRAPH_INSTRUCTION_FLOAT;
        if (pushes_literal) {
            if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_SLOT) {
                if (argument_0 >= slot_count || argument_1 != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
                ulong cell_index = slot_row * slot_count + argument_0;
                if (cell_index > 0xfffffffful) {
                    return IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS;
                }
                value = ig_segmented_input_cell(slot_cells, uint(cell_index));
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NULL) {
                if (argument_0 != 0ul || argument_1 != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_BOOLEAN) {
                if (argument_0 > 1ul || argument_1 != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
                value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
                value.payload = argument_0;
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_INTEGER) {
                if (argument_1 != 0ul) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                value.tag = IG_SEGMENTED_VALUE_INTEGER;
                value.payload = argument_0;
            } else {
                if (argument_1 != 0ul || !ig_segmented_f64_finite(argument_0)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
                value.tag = IG_SEGMENTED_VALUE_FLOAT;
                value.payload = argument_0;
            }
            if (depth >= IG_SEGMENTED_GRAPH_EXPRESSION_STACK) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            stack[depth++] = value;
            continue;
        }
        if (small_string) {
            if (argument_0 > 16ul || depth == 0u) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            for (ulong byte = argument_0; byte < 16ul; ++byte) {
                ulong packed = byte < 8ul ? argument_1 : argument_2;
                if (((packed >> ((byte & 7ul) * 8ul)) & 0xfful) != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
            }
            IgSegmentedCellValue operand = stack[depth - 1u];
            if (operand.tag == IG_SEGMENTED_VALUE_NULL) {
                value = operand;
            } else {
                bool equal = operand.tag == IG_SEGMENTED_VALUE_STRING
                    && operand.auxiliary == argument_0;
                for (ulong byte = 0ul; equal && byte < argument_0; ++byte) {
                    ulong packed = byte < 8ul ? argument_1 : argument_2;
                    uchar expected = uchar(
                        (packed >> ((byte & 7ul) * 8ul)) & 0xfful);
                    equal = arena[operand.payload + byte] == expected;
                }
                value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
                value.payload = (equal
                    ^ (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NOT_EQUAL_SMALL_STRING))
                    ? 1ul : 0ul;
                value.auxiliary = 0ul;
            }
            stack[depth - 1u] = value;
            continue;
        }
        if (order_string_append) {
            if (argument_0 > 16ul || depth == 0u || offset + 1ul != instruction_count) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            for (ulong byte = argument_0; byte < 16ul; ++byte) {
                ulong packed = byte < 8ul ? argument_1 : argument_2;
                if (((packed >> ((byte & 7ul) * 8ul)) & 0xfful) != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
            }
            // The source cell is deliberately retained. ORDER consumes it immediately with the
            // instruction-aware virtual concatenation comparator; no result projection may admit
            // this opcode.
            IgSegmentedCellValue operand = stack[depth - 1u];
            if (operand.tag != IG_SEGMENTED_VALUE_NULL
                    && operand.tag != IG_SEGMENTED_VALUE_STRING) {
                return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
            }
            continue;
        }
        if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_MAP_PUBLICATION) {
            if (argument_0 == 0ul || argument_0 != program[54]
                    || program[55] < IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS
                    || !ig_segmented_graph_range(argument_0, program[55], program[52])
                    || program[argument_0] != IG_SEGMENTED_GRAPH_MAP_MAGIC
                    || program[argument_0 + 1ul] != IG_SEGMENTED_GRAPH_MAP_VERSION
                    || program[argument_0 + 3ul] != argument_1
                    || argument_1 > ulong(depth)) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            depth -= uint(argument_1);
            stack[depth++] = ig_segmented_null_cell();
            continue;
        }

        bool arithmetic = opcode >= IG_SEGMENTED_GRAPH_INSTRUCTION_ADD
            && opcode <= IG_SEGMENTED_GRAPH_INSTRUCTION_MODULO;
        bool comparison = opcode >= IG_SEGMENTED_GRAPH_INSTRUCTION_EQUAL
            && opcode <= IG_SEGMENTED_GRAPH_INSTRUCTION_GREATER_OR_EQUAL;
        bool binary = arithmetic || comparison;
        bool rank_range_equal = opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_RANK_RANGE_EQUAL;
        bool coalesce = opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_COALESCE;
        if (coalesce) {
            if (argument_0 == 0ul || argument_0 > ulong(depth) || argument_1 != 0ul) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            uint first = depth - uint(argument_0);
            value = ig_segmented_null_cell();
            for (uint index = first; index < depth; ++index) {
                if (stack[index].tag != IG_SEGMENTED_VALUE_NULL) {
                    value = stack[index];
                    break;
                }
            }
            depth = first;
            stack[depth++] = value;
            continue;
        }
        if ((rank_range_equal
                    && (ig_segmented_unit_kind(program)
                            != IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
                        || argument_0 == 0ul
                        || argument_0 > ig_segmented_unit_maximum_list_items(program)
                        || argument_1 != 0ul))
                || (!rank_range_equal && (argument_0 != 0ul || argument_1 != 0ul))
                || depth < (binary ? 2u : 1u)) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        if (binary) {
            IgSegmentedCellValue right = stack[--depth];
            IgSegmentedCellValue left = stack[--depth];
            uint status = arithmetic
                ? ig_segmented_graph_numeric_binary(left, opcode, right, value)
                : ig_segmented_graph_compare(arena, left, opcode, right, value);
            if (status != 0u) return status;
        } else {
            IgSegmentedCellValue operand = stack[--depth];
            if (rank_range_equal) {
                if (operand.tag != IG_SEGMENTED_VALUE_LIST
                        || !ig_segmented_graph_range(
                            operand.payload, operand.auxiliary, document_cell_count)) {
                    return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
                }
                bool equal = operand.auxiliary == argument_0;
                for (ulong index = 0ul; equal && index < operand.auxiliary; ++index) {
                    IgSegmentedCellValue child = ig_segmented_input_cell(
                        document_cells, uint(operand.payload + index));
                    equal = child.tag == IG_SEGMENTED_VALUE_INTEGER
                        && child.payload == index && child.auxiliary == 0ul;
                }
                value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
                value.payload = equal ? 1ul : 0ul;
                value.auxiliary = 0ul;
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_POSITIVE) {
                if (operand.tag != IG_SEGMENTED_VALUE_NULL
                        && operand.tag != IG_SEGMENTED_VALUE_INTEGER
                        && operand.tag != IG_SEGMENTED_VALUE_FLOAT) {
                    return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
                }
                value = operand;
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NEGATIVE) {
                if (operand.tag == IG_SEGMENTED_VALUE_NULL) {
                    value = operand;
                } else if (operand.tag == IG_SEGMENTED_VALUE_INTEGER) {
                    long signed_value = as_type<long>(operand.payload);
                    if (signed_value == (-0x7fffffffffffffffL - 1L)) {
                        return IG_SEGMENTED_GRAPH_STATUS_ARITHMETIC_OVERFLOW;
                    }
                    value.tag = IG_SEGMENTED_VALUE_INTEGER;
                    value.payload = as_type<ulong>(-signed_value);
                } else if (operand.tag == IG_SEGMENTED_VALUE_FLOAT) {
                    value.tag = IG_SEGMENTED_VALUE_FLOAT;
                    value.payload = operand.payload ^ 0x8000000000000000ul;
                } else {
                    return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
                }
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NOT) {
                if (operand.tag == IG_SEGMENTED_VALUE_NULL) {
                    value = operand;
                } else if (operand.tag == IG_SEGMENTED_VALUE_BOOLEAN) {
                    value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
                    value.payload = 1ul - operand.payload;
                } else {
                    return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
                }
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_IS_NULL
                    || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_IS_NOT_NULL) {
                value.tag = IG_SEGMENTED_VALUE_BOOLEAN;
                bool is_null = operand.tag == IG_SEGMENTED_VALUE_NULL;
                value.payload = (is_null
                    ^ (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_IS_NOT_NULL)) ? 1ul : 0ul;
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_SIZE) {
                if (operand.tag == IG_SEGMENTED_VALUE_NULL) {
                    value = operand;
                } else if (operand.tag == IG_SEGMENTED_VALUE_LIST) {
                    value.tag = IG_SEGMENTED_VALUE_INTEGER;
                    value.payload = operand.auxiliary;
                } else if (operand.tag == IG_SEGMENTED_VALUE_STRING) {
                    ulong characters = 0ul;
                    for (ulong byte = 0ul; byte < operand.auxiliary; ++byte) {
                        // The generic relation validator already proved UTF-8.  Each Unicode
                        // scalar has exactly one byte which is not a continuation byte.
                        characters += (arena[operand.payload + byte] & 0xc0u) != 0x80u
                            ? 1ul : 0ul;
                    }
                    value.tag = IG_SEGMENTED_VALUE_INTEGER;
                    value.payload = characters;
                } else {
                    return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
                }
            } else if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_HEAD) {
                if (operand.tag == IG_SEGMENTED_VALUE_NULL) {
                    value = operand;
                } else if (operand.tag != IG_SEGMENTED_VALUE_LIST
                        || !ig_segmented_graph_range(
                            operand.payload, operand.auxiliary, document_cell_count)) {
                    return IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE;
                } else if (operand.auxiliary == 0ul) {
                    value = ig_segmented_null_cell();
                } else {
                    value = ig_segmented_input_cell(document_cells, uint(operand.payload));
                }
            } else {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
        if (depth >= IG_SEGMENTED_GRAPH_EXPRESSION_STACK) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        stack[depth++] = value;
    }
    if (depth != 1u) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    result = stack[0];
    return 0u;
}

inline int ig_segmented_graph_order_cells(
    device const ulong* program,
    ulong order_descriptor,
    device const uchar* arena,
    IgSegmentedCellValue left,
    IgSegmentedCellValue right,
    ulong flags) {
    bool left_null = left.tag == IG_SEGMENTED_VALUE_NULL;
    bool right_null = right.tag == IG_SEGMENTED_VALUE_NULL;
    bool nulls_first = (flags & 2ul) != 0ul;
    if (left_null || right_null) {
        if (left_null && right_null) return 0;
        return left_null == nulls_first ? -1 : 1;
    }
    ulong instruction_start = program[order_descriptor];
    ulong instruction_count = program[order_descriptor + 1ul];
    ulong final_instruction = program[48]
        + (instruction_start + instruction_count - 1ul)
            * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS;
    bool virtual_append = program[final_instruction]
        == IG_SEGMENTED_GRAPH_INSTRUCTION_APPEND_SMALL_STRING_ORDER;
    int order = 0;
    if (virtual_append
            && left.tag == IG_SEGMENTED_VALUE_STRING
            && right.tag == IG_SEGMENTED_VALUE_STRING) {
        ulong suffix_bytes = program[final_instruction + 1ul];
        ulong left_bytes = left.auxiliary + suffix_bytes;
        ulong right_bytes = right.auxiliary + suffix_bytes;
        ulong common = min(left_bytes, right_bytes);
        for (ulong byte = 0ul; byte < common && order == 0; ++byte) {
            uchar left_byte;
            if (byte < left.auxiliary) {
                left_byte = arena[left.payload + byte];
            } else {
                ulong suffix = byte - left.auxiliary;
                ulong packed = suffix < 8ul
                    ? program[final_instruction + 2ul]
                    : program[final_instruction + 3ul];
                left_byte = uchar((packed >> ((suffix & 7ul) * 8ul)) & 0xfful);
            }
            uchar right_byte;
            if (byte < right.auxiliary) {
                right_byte = arena[right.payload + byte];
            } else {
                ulong suffix = byte - right.auxiliary;
                ulong packed = suffix < 8ul
                    ? program[final_instruction + 2ul]
                    : program[final_instruction + 3ul];
                right_byte = uchar((packed >> ((suffix & 7ul) * 8ul)) & 0xfful);
            }
            order = left_byte < right_byte ? -1 : (left_byte > right_byte ? 1 : 0);
        }
        if (order == 0) {
            order = left_bytes < right_bytes ? -1 : (left_bytes > right_bytes ? 1 : 0);
        }
    } else {
        order = ig_segmented_key_order(arena, left, right);
    }
    return (flags & 1ul) != 0ul ? -order : order;
}

inline void ig_segmented_graph_complete_receipt(
    device ulong* record,
    ulong execution_high,
    ulong execution_low,
    ulong input_rows,
    ulong output_rows) {
    record[2] = 1ul;
    record[3] = execution_high;
    record[4] = execution_low;
    record[5] = record[0];
    record[6] = record[1];
    record[7] = input_rows | (output_rows << 32u);
    record[8] = 2ul;
}

inline uint ig_segmented_graph_map_original_physical(
    device const ulong* row_map,
    ulong original) {
    return uint(row_map[original]);
}

inline uint ig_segmented_graph_map_physical_original(
    device const ulong* row_map,
    ulong physical) {
    return uint(row_map[physical] >> 32u);
}

inline void ig_segmented_graph_map_set_original_physical(
    device ulong* row_map,
    ulong original,
    uint physical) {
    row_map[original] = (row_map[original] & 0xffffffff00000000ul) | ulong(physical);
}

inline void ig_segmented_graph_map_set_physical_original(
    device ulong* row_map,
    ulong physical,
    uint original) {
    row_map[physical] = ulong(uint(row_map[physical])) | (ulong(original) << 32u);
}

inline bool ig_segmented_key_value_list_shape(
    device const ulong* program,
    ulong instruction_start,
    ulong instruction_count,
    ulong slot_count) {
    ulong base = program[54];
    ulong trailer_words = program[55];
    if (base == 0ul || trailer_words < IG_SEGMENTED_KEY_VALUE_LIST_HEADER_WORDS
            || !ig_segmented_graph_range(base, trailer_words, program[52])
            || base + trailer_words != program[52]
            || program[base] != IG_SEGMENTED_KEY_VALUE_LIST_MAGIC
            || program[base + 1ul] != IG_SEGMENTED_KEY_VALUE_LIST_VERSION
            || program[base + 6ul] != IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS) {
        return false;
    }
    ulong count = program[base + 2ul];
    ulong cells_per_group = program[base + 3ul];
    ulong bytes_per_group = program[base + 4ul];
    ulong name_bytes = program[base + 5ul];
    ulong grouped_entity_slot = count + 1ul;
    ulong count_slot = count * 2ul + 2ul;
    ulong output_slot = count * 2ul + 4ul;
    ulong expected_slot_count = count * 2ul + 5ul;
    ulong descriptor_words = 0ul;
    ulong descriptor_base = base + IG_SEGMENTED_KEY_VALUE_LIST_HEADER_WORDS;
    ulong names_word_base = 0ul;
    ulong padded_name_words = 0ul;
    ulong expected_cells = 0ul;
    ulong expected_arena = 0ul;
    if (count > IG_SEGMENTED_MAX_GROUP_KEYS
            || count + 1ul != program[5] || count + 1ul != program[4]
            || cells_per_group != count + 2ul
            || name_bytes > 0xfffffffful || name_bytes > ~0ul - 7ul
            || !ig_segmented_graph_product(
                count, IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS, descriptor_words)
            || !ig_segmented_graph_sum(descriptor_base, descriptor_words, names_word_base)
            || !ig_segmented_graph_sum(
                IG_SEGMENTED_KEY_VALUE_LIST_HEADER_WORDS,
                descriptor_words,
                padded_name_words)
            || !ig_segmented_graph_sum(
                padded_name_words, (name_bytes + 7ul) / 8ul, padded_name_words)
            || padded_name_words != trailer_words
            || !ig_segmented_graph_product(program[23], cells_per_group, expected_cells)
            || expected_cells != program[24]
            || !ig_segmented_graph_product(program[23], bytes_per_group, expected_arena)
            || expected_arena != program[25]
            || program[6] != 1ul || program[8] != count + 2ul
            || program[9] != 1ul || program[10] != 1ul || program[11] != 0ul
            || program[12] != 1ul || program[13] != 1ul
            || program[15] != 1ul || program[16] != 0ul
            || program[53] != IG_SEGMENTED_GRAPH_SOURCE_GRAPH
            || instruction_start != 0ul || instruction_count != 1ul
            || slot_count != expected_slot_count || slot_count != program[7]) {
        return false;
    }
    ulong stage = program[45];
    ulong projection = program[46];
    ulong instruction = program[48];
    if (program[stage] != IG_SEGMENTED_GRAPH_STAGE_PROJECT
            || program[stage + 1ul] != 0ul || program[stage + 2ul] != 1ul
            || program[stage + 3ul] != 0ul
            || program[projection] != output_slot
            || program[projection + 1ul] != 0ul || program[projection + 2ul] != 1ul
            || program[projection + 3ul] != 0ul
            || program[instruction] != IG_SEGMENTED_GRAPH_INSTRUCTION_KEY_VALUE_LIST
            || program[instruction + 1ul] != base
            || program[instruction + 2ul] != count
            || program[instruction + 3ul] != 0ul
            || program[program[49]] != program[projection]) return false;

    ulong entity_binding = program[41];
    ulong entity_mapping = program[44];
    if (program[entity_binding] != 0ul || program[entity_binding + 1ul] != 0ul
            || program[entity_binding + 2ul] != 2ul
            || program[entity_binding + 3ul] != IG_NULLABLE_OUTPUT_ENTITY
            || program[entity_binding + 9ul] != 0ul
            || program[entity_binding + 10ul] != 1ul
            || program[entity_mapping] != grouped_entity_slot
            || program[entity_mapping + 1ul] != 0ul
            || uint(program[program[42]]) != 0u
            || (program[program[42]] >> 32ul) != 0ul) return false;

    ulong name_cursor = 0ul;
    ulong observed_bytes_per_group = 0ul;
    ulong property_width_per_group = 0ul;
    ulong names_byte_base = 0ul;
    device const uchar* program_bytes = reinterpret_cast<device const uchar*>(program);
    if (!ig_segmented_graph_product(names_word_base, 8ul, names_byte_base)) return false;
    for (ulong index = 0ul; index < count; ++index) {
        ulong descriptor = descriptor_base
            + index * IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS;
        ulong slot = program[descriptor];
        ulong name_offset = program[descriptor + 1ul];
        ulong name_length = program[descriptor + 2ul];
        ulong maximum_bytes = program[descriptor + 3ul];
        ulong binding = program[41]
            + (index + 1ul) * IG_SEGMENTED_GRAPH_BINDING_WORDS;
        ulong grouping = program[program[42] + index + 1ul];
        ulong mapping = program[44]
            + (index + 1ul) * IG_SEGMENTED_GRAPH_INITIAL_WORDS;
        if (slot != count + 2ul + index
                || name_offset != name_cursor || name_length == 0ul
                || maximum_bytes > 0xfffffffful
                || !ig_segmented_graph_range(name_offset, name_length, name_bytes)
                || names_byte_base > 0xfffffffful
                || name_offset > 0xfffffffful - names_byte_base
                || name_length > 0xfffffffful - names_byte_base - name_offset
                || !ig_segmented_utf8(
                    program_bytes,
                    uint(names_byte_base + name_offset),
                    uint(name_length))
                || program[binding] != index + 1ul
                || program[binding + 1ul] != index + 1ul
                || program[binding + 2ul] != 2ul
                || program[binding + 3ul] != IG_NULLABLE_OUTPUT_STRING_PROPERTY
                || program[binding + 9ul] != maximum_bytes
                || program[binding + 10ul] != 1ul
                || uint(grouping) != uint(index + 1ul)
                || (grouping >> 32ul) != 0ul
                || program[mapping] != count + 2ul + index
                || program[mapping + 1ul] != index + 1ul) {
            return false;
        }
        for (ulong prior = 0ul; prior < index; ++prior) {
            ulong prior_descriptor = descriptor_base
                + prior * IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS;
            if (program[prior_descriptor] == slot) return false;
        }
        if (index != 0ul) {
            ulong prior = descriptor - IG_SEGMENTED_KEY_VALUE_LIST_DESCRIPTOR_WORDS;
            ulong prior_offset = program[prior + 1ul];
            ulong prior_length = program[prior + 2ul];
            ulong common = min(prior_length, name_length);
            bool different = false;
            bool ordered = false;
            for (ulong byte = 0ul; byte < common && !different; ++byte) {
                uchar left = ig_segmented_program_byte(
                    program, names_byte_base + prior_offset + byte);
                uchar right = ig_segmented_program_byte(
                    program, names_byte_base + name_offset + byte);
                if (left != right) {
                    different = true;
                    ordered = left < right;
                }
            }
            if ((!different && prior_length >= name_length) || (different && !ordered)) {
                return false;
            }
        }
        name_cursor += name_length;
        if (!ig_segmented_graph_sum(
                observed_bytes_per_group, name_length + 2ul, observed_bytes_per_group)
                || !ig_segmented_graph_sum(
                    observed_bytes_per_group, maximum_bytes, observed_bytes_per_group)
                || !ig_segmented_graph_sum(
                    property_width_per_group, maximum_bytes, property_width_per_group)) {
            return false;
        }
    }
    ulong aggregate = program[43];
    ulong count_mapping = program[44] + (count + 1ul) * IG_SEGMENTED_GRAPH_INITIAL_WORDS;
    ulong expected_aggregate_cells = 0ul;
    ulong expected_aggregate_arena = 0ul;
    ulong expected_source_arena = 0ul;
    if (name_cursor != name_bytes || observed_bytes_per_group != bytes_per_group
            || program[aggregate] != IG_SEGMENTED_AGGREGATE_COUNT_VALUE
            || program[aggregate + 1ul] != program[4]
            || program[aggregate + 2ul] != 0ul || program[aggregate + 3ul] != ~0ul
            || program[aggregate + 4ul] != 0ul
            || program[count_mapping] != count_slot
            || program[count_mapping + 1ul] != count + 1ul
            || !ig_segmented_graph_product(
                program[23], count + 2ul, expected_aggregate_cells)
            || expected_aggregate_cells != program[21]
            || !ig_segmented_graph_product(
                program[23], property_width_per_group, expected_aggregate_arena)
            || expected_aggregate_arena != program[22]
            || !ig_segmented_graph_product(
                program[17], property_width_per_group, expected_source_arena)
            || expected_source_arena != program[20]) return false;
    ulong padded_name_bytes = ((name_bytes + 7ul) / 8ul) * 8ul;
    for (ulong byte = name_bytes; byte < padded_name_bytes; ++byte) {
        if (ig_segmented_program_byte(program, names_byte_base + byte) != 0u) return false;
    }
    return true;
}

inline bool ig_segmented_graph_pre_order_shape(device const ulong* program) {
    ulong base = program[54];
    ulong trailer_words = program[55];
    if (base == 0ul || trailer_words != IG_SEGMENTED_GRAPH_PRE_ORDER_HEADER_WORDS
            || !ig_segmented_graph_range(base, trailer_words, program[52])
            || base + trailer_words != program[52]
            || program[base] != IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC
            || program[base + 1ul] != IG_SEGMENTED_GRAPH_PRE_ORDER_VERSION
            || program[base + 4ul] != IG_SEGMENTED_GRAPH_ORDER_WORDS) {
        return false;
    }
    ulong start = program[base + 2ul];
    ulong count = program[base + 3ul];
    return start == 0ul && count != 0ul
        && ig_segmented_graph_range(start, count, program[11]);
}

inline bool ig_segmented_graph_expression_shape(
    device const ulong* program,
    ulong instruction_start,
    ulong instruction_count,
    ulong slot_count);

inline bool ig_segmented_graph_has_virtual_order_suffix(
    device const ulong* program,
    ulong instruction_start,
    ulong instruction_count);

inline bool ig_segmented_graph_map_shape(
    device const ulong* program,
    ulong instruction_start,
    ulong instruction_count,
    ulong output_slot,
    ulong slot_count) {
    ulong base = program[54];
    ulong trailer_words = program[55];
    if (base == 0ul || trailer_words < IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS
            || !ig_segmented_graph_range(base, trailer_words, program[52])
            || base + trailer_words != program[52]
            || program[base] != IG_SEGMENTED_GRAPH_MAP_MAGIC
            || program[base + 1ul] != IG_SEGMENTED_GRAPH_MAP_VERSION
            || program[base + 2ul] != output_slot || output_slot >= slot_count
            || program[base + 4ul] != IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS
            || program[base + 5ul] != IG_SEGMENTED_GRAPH_MAP_DESCRIPTOR_WORDS
            || program[base + 7ul] != 0ul) return false;
    ulong count = program[base + 3ul];
    ulong name_bytes = program[base + 6ul];
    ulong descriptor_words = 0ul;
    ulong descriptor_base = base + IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS;
    ulong names_word_base = 0ul;
    ulong expected_words = 0ul;
    if (count == 0ul || count > IG_SEGMENTED_MAX_COLUMNS
            || name_bytes > 0xfffffffful || name_bytes > ~0ul - 7ul
            || !ig_segmented_graph_product(
                count, IG_SEGMENTED_GRAPH_MAP_DESCRIPTOR_WORDS, descriptor_words)
            || !ig_segmented_graph_sum(descriptor_base, descriptor_words, names_word_base)
            || !ig_segmented_graph_sum(
                IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS, descriptor_words, expected_words)
            || !ig_segmented_graph_sum(
                expected_words, (name_bytes + 7ul) / 8ul, expected_words)
            || expected_words != trailer_words) return false;
    ulong names_byte_base = 0ul;
    if (!ig_segmented_graph_product(names_word_base, 8ul, names_byte_base)) return false;
    ulong name_cursor = 0ul;
    ulong expression_cursor = instruction_start;
    for (ulong index = 0ul; index < count; ++index) {
        ulong descriptor = descriptor_base
            + index * IG_SEGMENTED_GRAPH_MAP_DESCRIPTOR_WORDS;
        ulong start = program[descriptor];
        ulong width = program[descriptor + 1ul];
        ulong name_offset = program[descriptor + 2ul];
        ulong name_length = program[descriptor + 3ul];
        if (start != expression_cursor || width == 0ul
                || !ig_segmented_graph_range(start, width, program[12])
                || !ig_segmented_graph_expression_shape(program, start, width, slot_count)
                || ig_segmented_graph_has_virtual_order_suffix(program, start, width)
                || name_offset != name_cursor || name_length == 0ul
                || !ig_segmented_graph_range(name_offset, name_length, name_bytes)
                || program[descriptor + 4ul] != 0ul || program[descriptor + 5ul] != 0ul
                || names_byte_base > 0xfffffffful
                || name_offset > 0xfffffffful - names_byte_base
                || name_length > 0xfffffffful - names_byte_base - name_offset
                || !ig_segmented_utf8(
                    reinterpret_cast<device const uchar*>(program),
                    uint(names_byte_base + name_offset),
                    uint(name_length))) return false;
        if (index != 0ul) {
            ulong prior = descriptor - IG_SEGMENTED_GRAPH_MAP_DESCRIPTOR_WORDS;
            ulong prior_offset = program[prior + 2ul];
            ulong prior_length = program[prior + 3ul];
            ulong common = min(prior_length, name_length);
            bool different = false;
            bool ordered = false;
            for (ulong byte = 0ul; byte < common && !different; ++byte) {
                uchar left = ig_segmented_program_byte(
                    program, names_byte_base + prior_offset + byte);
                uchar right = ig_segmented_program_byte(
                    program, names_byte_base + name_offset + byte);
                if (left != right) {
                    different = true;
                    ordered = left < right;
                }
            }
            if ((!different && prior_length >= name_length) || (different && !ordered)) {
                return false;
            }
        }
        expression_cursor += width;
        name_cursor += name_length;
    }
    ulong map_descriptor = program[48]
        + expression_cursor * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS;
    if (expression_cursor < instruction_start
            || expression_cursor - instruction_start + 1ul != instruction_count
            || expression_cursor >= program[12]
            || program[map_descriptor] != IG_SEGMENTED_GRAPH_INSTRUCTION_MAP_PUBLICATION
            || program[map_descriptor + 1ul] != base
            || program[map_descriptor + 2ul] != count
            || program[map_descriptor + 3ul] != 0ul
            || name_cursor != name_bytes) return false;
    ulong padded_name_bytes = ((name_bytes + 7ul) / 8ul) * 8ul;
    for (ulong byte = name_bytes; byte < padded_name_bytes; ++byte) {
        if (ig_segmented_program_byte(program, names_byte_base + byte) != 0u) return false;
    }
    return true;
}

inline bool ig_segmented_graph_expression_shape(
    device const ulong* program,
    ulong instruction_start,
    ulong instruction_count,
    ulong slot_count) {
    if (instruction_count == 0ul
            || !ig_segmented_graph_range(
                instruction_start, instruction_count, program[12])) return false;
    uint depth = 0u;
    for (ulong offset = 0ul; offset < instruction_count; ++offset) {
        ulong descriptor = program[48]
            + (instruction_start + offset) * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS;
        ulong opcode = program[descriptor];
        ulong argument_0 = program[descriptor + 1ul];
        ulong argument_1 = program[descriptor + 2ul];
        ulong argument_2 = program[descriptor + 3ul];
        bool small_string = opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_EQUAL_SMALL_STRING
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NOT_EQUAL_SMALL_STRING;
        bool order_string_append =
            opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_APPEND_SMALL_STRING_ORDER;
        if (!small_string && !order_string_append && argument_2 != 0ul) return false;
        bool pushes = opcode >= IG_SEGMENTED_GRAPH_INSTRUCTION_SLOT
            && opcode <= IG_SEGMENTED_GRAPH_INSTRUCTION_FLOAT;
        if (pushes) {
            if ((opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_SLOT
                        && (argument_0 >= slot_count || argument_1 != 0ul))
                    || (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NULL
                        && (argument_0 != 0ul || argument_1 != 0ul))
                    || (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_BOOLEAN
                        && (argument_0 > 1ul || argument_1 != 0ul))
                    || (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_INTEGER
                        && argument_1 != 0ul)
                    || (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_FLOAT
                        && (argument_1 != 0ul || !ig_segmented_f64_finite(argument_0)))) {
                return false;
            }
            if (depth >= IG_SEGMENTED_GRAPH_EXPRESSION_STACK) return false;
            ++depth;
            continue;
        }
        if (small_string) {
            if (argument_0 > 16ul || depth == 0u) return false;
            for (ulong byte = argument_0; byte < 16ul; ++byte) {
                ulong packed = byte < 8ul ? argument_1 : argument_2;
                if (((packed >> ((byte & 7ul) * 8ul)) & 0xfful) != 0ul) return false;
            }
            continue;
        }
        if (order_string_append) {
            // A virtual append is meaningful only as the root of one ORDER key. Context-specific
            // validators below reject it from grouping, reduction, projection, and filter ranges.
            if (argument_0 > 16ul || depth == 0u || offset + 1ul != instruction_count) {
                return false;
            }
            for (ulong byte = argument_0; byte < 16ul; ++byte) {
                ulong packed = byte < 8ul ? argument_1 : argument_2;
                if (((packed >> ((byte & 7ul) * 8ul)) & 0xfful) != 0ul) return false;
            }
            continue;
        }
        if (opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_MAP_PUBLICATION) {
            if (argument_0 == 0ul || argument_0 != program[54]
                    || program[55] < IG_SEGMENTED_GRAPH_MAP_HEADER_WORDS
                    || !ig_segmented_graph_range(argument_0, program[55], program[52])
                    || program[argument_0] != IG_SEGMENTED_GRAPH_MAP_MAGIC
                    || program[argument_0 + 1ul] != IG_SEGMENTED_GRAPH_MAP_VERSION
                    || program[argument_0 + 3ul] != argument_1
                    || argument_1 > ulong(depth)) return false;
            depth = depth - uint(argument_1) + 1u;
            continue;
        }
        bool binary = (opcode >= IG_SEGMENTED_GRAPH_INSTRUCTION_ADD
                && opcode <= IG_SEGMENTED_GRAPH_INSTRUCTION_MODULO)
            || (opcode >= IG_SEGMENTED_GRAPH_INSTRUCTION_EQUAL
                && opcode <= IG_SEGMENTED_GRAPH_INSTRUCTION_GREATER_OR_EQUAL);
        bool unary = opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_POSITIVE
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NEGATIVE
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_NOT
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_IS_NULL
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_IS_NOT_NULL
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_SIZE
            || opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_HEAD;
        bool coalesce = opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_COALESCE
            && argument_0 != 0ul && argument_0 <= ulong(depth) && argument_1 == 0ul;
        bool rank_range_equal = opcode == IG_SEGMENTED_GRAPH_INSTRUCTION_RANK_RANGE_EQUAL
            && ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
            && argument_0 != 0ul
            && argument_0 <= ig_segmented_unit_maximum_list_items(program)
            && argument_1 == 0ul;
        if ((!binary && !unary && !rank_range_equal && !coalesce)
                || (!rank_range_equal && (argument_0 != 0ul || argument_1 != 0ul))
                || depth < (binary ? 2u : 1u)) {
            if (!coalesce) return false;
        }
        if (coalesce) depth = depth - uint(argument_0) + 1u;
        else if (binary) --depth;
    }
    return depth == 1u;
}

inline bool ig_segmented_graph_has_virtual_order_suffix(
    device const ulong* program,
    ulong instruction_start,
    ulong instruction_count) {
    if (instruction_count == 0ul
            || !ig_segmented_graph_range(
                instruction_start, instruction_count, program[12])) return false;
    ulong descriptor = program[48]
        + (instruction_start + instruction_count - 1ul)
            * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS;
    return program[descriptor]
