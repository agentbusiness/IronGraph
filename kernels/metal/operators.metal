    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong filter_words = 0ul;
    ulong command_words = 0ul;
    ulong stage_words = 0ul;
    ulong expansion_count = ig_delete_word(program, 30ul);
    ulong exact_three_hop = ig_delete_word(program, 50ul);
    ulong variable_path_mode = ig_delete_word(program, 51ul);
    bool expansion_contract = (exact_three_hop == 0ul && expansion_count <= 1ul)
        || (exact_three_hop == 1ul
            && expansion_count == 3ul
            && ig_delete_word(program, 29ul) == 3ul
            && ig_delete_word(program, 3ul) == 1ul
            && ig_delete_word(program, 7ul) == 0ul
            && ig_delete_word(program, 9ul) == 0ul
            && ig_delete_word(program, 10ul) == 0ul
            && ig_delete_word(program, 11ul) == 0ul
            && ig_delete_word(program, 31ul) == 0ul
            && ig_delete_word(program, 48ul) == 0ul
            && ig_delete_word(program, 49ul) == 0ul
            && args.filter_count == 0ul
            && args.command_count == 7ul
            && args.stage_count == 0ul);
    bool variable_path_contract = variable_path_mode == 0ul
        || (variable_path_mode == 1ul
            && exact_three_hop == 0ul
            && expansion_count == 1ul
            && ig_delete_word(program, 3ul) == 3ul
            && ig_delete_word(program, 5ul) == 0ul
            && ig_delete_word(program, 7ul) == 0ul
            && ig_delete_word(program, 9ul) == 0ul
            && ig_delete_word(program, 10ul) == 0ul
            && ig_delete_word(program, 11ul) == 0ul
            && ig_delete_word(program, 29ul) == 1ul
            && ig_delete_word(program, 31ul) == 1ul
            && ig_delete_word(program, 48ul) == 0ul
            && ig_delete_word(program, 49ul) == 0ul
            && args.filter_count == 0ul
            && args.command_count == 2ul
            && args.stage_count == 1ul);
    bool valid = args.program_word_count >= IG_DELETE_PROGRAM_HEADER_WORDS
        && ig_delete_word(program, 0ul) == IG_DELETE_PROGRAM_MAGIC
        && ig_delete_word(program, 1ul) == IG_DELETE_VERSION
        && ig_delete_word(program, 2ul) != 0ul
        && ig_delete_word(program, 2ul) <= 3ul
        && ig_delete_word(program, 3ul) <= 3ul
        && ig_delete_word(program, 11ul) <= 1ul
        && ig_delete_word(program, 13ul) == args.filter_count
        && ig_delete_word(program, 15ul) == args.command_count
        && ig_delete_word(program, 17ul) == args.stage_count
        && ig_delete_word(program, 24ul) == args.selector_capacity
        && ig_delete_word(program, 25ul) == args.intent_capacity
        && ig_delete_word(program, 26ul) == args.dependency_capacity
        && ig_delete_word(program, 27ul) == args.final_capacity
        && ig_delete_word(program, 28ul) == args.final_capacity
        && exact_three_hop <= 1ul
        && variable_path_mode <= 1ul
        && variable_path_mode == args.variable_path_mode
        && expansion_contract
        && variable_path_contract
        && ig_delete_word(program, 29ul) == ig_delete_word(program, 30ul)
        && ig_delete_word(program, 31ul) <= 1ul
        && ig_delete_word(program, 44ul) == args.receipt_count
        && ig_delete_word(program, 45ul) == args.node_property_count
        && ig_delete_word(program, 46ul) == args.edge_property_count
        && ig_delete_word(program, 47ul) == args.label_lane_count
        && ig_delete_word(program, 48ul) <= 1ul
        && ig_delete_word(program, 49ul) <= 1ul
        && args.expected_static_empty <= 1ul
        && ig_delete_word(program, 49ul) == args.expected_static_empty
        && (ig_delete_word(program, 49ul) == 0ul
            || ig_delete_word(program, 48ul) == 1ul)
        && (ig_delete_word(program, 11ul) == 0ul
            || (ig_delete_word(program, 30ul) == 1ul
                && ig_delete_word(program, 48ul) == 0ul
                && args.filter_count == 0ul
                && args.stage_count == 0ul))
        && (ig_delete_word(program, 48ul) == 0ul
            || (ig_delete_word(program, 30ul) <= 1ul
                && args.filter_count == 0ul
                && ig_delete_word(program, 11ul) == 0ul))
        && args.command_count != 0ul
        && args.selector_capacity != 0ul
        && ig_delete_product(args.filter_count, IG_DELETE_FILTER_WORDS, filter_words)
        && ig_delete_product(args.command_count, IG_DELETE_COMMAND_WORDS, command_words)
        && ig_delete_product(args.stage_count, IG_DELETE_STAGE_WORDS, stage_words)
        && ig_delete_range(ig_delete_word(program, 12ul), filter_words, args.program_word_count)
        && ig_delete_range(ig_delete_word(program, 14ul), command_words, args.program_word_count)
        && ig_delete_range(ig_delete_word(program, 16ul), stage_words, args.program_word_count)
        && ig_delete_range(ig_delete_word(program, 4ul), ig_delete_word(program, 5ul), args.program_word_count)
        && ig_delete_range(ig_delete_word(program, 6ul), ig_delete_word(program, 7ul), args.program_word_count)
        && ig_delete_range(ig_delete_word(program, 8ul), ig_delete_word(program, 9ul), args.program_word_count);
    for (ulong reserved = 52ul; reserved < IG_DELETE_PROGRAM_HEADER_WORDS; ++reserved) {
        valid = valid && ig_delete_word(program, reserved) == 0ul;
    }
    if (!valid) ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
    else {
        output[args.control_base] = 1ul;
        output[35] = ig_delete_word(program, 30ul);
    }
