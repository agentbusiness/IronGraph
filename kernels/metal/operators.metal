            ? args.node_string_byte_count : args.edge_string_byte_count;
        if (lanes == 0ul) continue;
        ulong prior = 0ul;
        for (ulong index = 0ul; index < offset_count; ++index) {
            ulong offset = ig_nullable_word(graph, offset_base + index);
            if (offset < prior || offset > byte_count || (index == 0ul && offset != 0ul)) {
                output[1] = 2ul;
                return;
            }
            prior = offset;
        }
        if (prior != byte_count) {
            output[1] = 2ul;
            return;
        }
        for (ulong byte = 0ul; byte < byte_count; ++byte) {
            if (ig_nullable_word(graph, byte_base + byte) > 255ul) {
                output[1] = 2ul;
                return;
            }
        }
    }
    ulong property_lane_count = ig_nullable_word(program, 10ul);
    ulong program_descriptor_base = ig_nullable_word(program, 15ul);
    ulong mixed_cursor = args.edge_string_byte_base + args.edge_string_byte_count;
    for (ulong lane = 0ul; lane < property_lane_count; ++lane) {
        ulong program_base = program_descriptor_base
            + lane * IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS;
        ulong graph_base = args.property_descriptor_base
            + lane * IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS;
        for (ulong word = 0ul; word < 4ul; ++word) {
            if (ig_nullable_word(program, program_base + word)
                    != ig_nullable_word(graph, graph_base + word)) {
                output[1] = 2ul;
                return;
            }
        }
        ulong kind = ig_nullable_word(graph, graph_base);
        ulong shape = ig_nullable_word(graph, graph_base + 1ul);
        ulong category = ig_nullable_word(graph, graph_base + 3ul);
        ulong storage = ig_nullable_word(graph, graph_base + 4ul);
        if (shape == 1ul || shape == 3ul) {
            ulong lane_count = kind == 1ul
                ? (shape == 1ul
                    ? args.node_integer_lane_count : args.node_float_lane_count)
                : (kind == 2ul
                    ? (shape == 1ul
                        ? args.edge_integer_lane_count : args.edge_float_lane_count)
                    : 0ul);
            if ((kind != 1ul && kind != 2ul) || category >= lane_count
                || storage != 0ul
                || ig_nullable_word(graph, graph_base + 5ul) != 0ul
                || ig_nullable_word(graph, graph_base + 6ul) != 0ul
                || ig_nullable_word(graph, graph_base + 7ul) != 0ul) {
                output[1] = 2ul;
                return;
            }
            continue;
        }
        ulong rows = kind == 1ul ? args.node_count
            : (kind == 2ul ? args.edge_count : 0ul);
        ulong lane_count = kind == 1ul ? args.node_string_lane_count
            : (kind == 2ul ? args.edge_string_lane_count : 0ul);
        ulong values = kind == 1ul
            ? args.node_string_value_base : args.edge_string_value_base;
        ulong validity = kind == 1ul
            ? args.node_string_validity_base : args.edge_string_validity_base;
        if (shape != 2ul || (kind != 1ul && kind != 2ul)
            || category >= lane_count) {
            output[1] = 2ul;
            return;
        }
        if (storage == IG_NULLABLE_STRING_STORAGE_DICTIONARY) {
            if (ig_nullable_word(graph, graph_base + 5ul) != 0ul
                || ig_nullable_word(graph, graph_base + 6ul) != 0ul
                || ig_nullable_word(graph, graph_base + 7ul) != 0ul) {
                output[1] = 2ul;
                return;
            }
            ulong offset_count = kind == 1ul
                ? args.node_string_offset_count : args.edge_string_offset_count;
            for (ulong row = 0ul; row < rows; ++row) {
                ulong present = ig_nullable_word(
                    graph, validity + category * rows + row);
                ulong dictionary_id = ig_nullable_word(
                    graph, values + category * rows + row);
                if (present > 1ul
                    || (present == 1ul
                        && (offset_count < 2ul
                            || dictionary_id >= offset_count - 1ul))) {
                    output[1] = 2ul;
                    return;
                }
            }
            continue;
        }
        if (storage != IG_NULLABLE_STRING_STORAGE_MIXED) {
            output[1] = 2ul;
            return;
        }
        ulong offset_base = ig_nullable_word(graph, graph_base + 5ul);
        ulong byte_base = ig_nullable_word(graph, graph_base + 6ul);
        ulong byte_count = ig_nullable_word(graph, graph_base + 7ul);
        ulong offset_count = rows + 1ul;
        if (offset_count <= rows || offset_base != mixed_cursor
            || byte_base != offset_base + offset_count
            || !ig_nullable_range(offset_base, offset_count, args.graph_word_count)
            || !ig_nullable_range(byte_base, byte_count, args.graph_word_count)
            || byte_base + byte_count > args.property_descriptor_base) {
            output[1] = 2ul;
            return;
        }
        ulong prior = 0ul;
        for (ulong index = 0ul; index < offset_count; ++index) {
            ulong offset = ig_nullable_word(graph, offset_base + index);
            if (offset < prior || offset > byte_count
                || (index == 0ul && offset != 0ul)) {
                output[1] = 2ul;
                return;
            }
            prior = offset;
        }
        if (prior != byte_count) {
            output[1] = 2ul;
            return;
        }
        for (ulong byte = 0ul; byte < byte_count; ++byte) {
            if (ig_nullable_word(graph, byte_base + byte) > 255ul) {
                output[1] = 2ul;
                return;
            }
        }
        for (ulong row = 0ul; row < rows; ++row) {
            ulong present = ig_nullable_word(
                graph, validity + category * rows + row);
            ulong start = ig_nullable_word(graph, offset_base + row);
            ulong end = ig_nullable_word(graph, offset_base + row + 1ul);
            ulong value = ig_nullable_word(graph, values + category * rows + row);
            if (present > 1ul || value != start
                || (present == 1ul && start >= end)) {
                output[1] = 2ul;
                return;
            }
        }
        mixed_cursor = byte_base + byte_count;
    }
    if (mixed_cursor != args.property_descriptor_base) {
        output[1] = 2ul;
        return;
    }
    output[args.control_base + 7ul] = IG_NULLABLE_RELATION_GRAPH_VALID;
}

kernel void ig_nullable_relation_prepare_stage_identity(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    if (stage >= args.stage_count || step.filter != ~0ul
        || step.opcode < IG_NULLABLE_RELATION_STAGE_NODE_SCAN
        || step.opcode > IG_NULLABLE_RELATION_STAGE_FINAL_PROJECT
        || output[args.control_base] != IG_NULLABLE_RELATION_CONTROL_MAGIC
        || output[args.control_base + 5ul] != stage
        || output[args.control_base + 7ul] != IG_NULLABLE_RELATION_GRAPH_VALID
        || output[args.control_base + 8ul] != 0ul) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong obligation_id = ig_nullable_word(program, descriptor + 15ul);
    if (ig_nullable_word(program, descriptor) != step.opcode
        || obligation_id == 0ul
        || ig_nullable_word(program, descriptor + 16ul) >= args.receipt_count) {
        output[1] = 2ul;
        return;
    }
    output[args.control_base + 8ul] = 1ul
        | ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (step.opcode << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
}

kernel void ig_nullable_relation_prepare_stage_obligation(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (step.opcode << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 1ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong obligation_id = ig_nullable_word(program, descriptor + 15ul);
    for (ulong prior_stage = 0ul; prior_stage < stage; ++prior_stage) {
        ulong prior_descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
            + prior_stage * IG_NULLABLE_RELATION_STAGE_WORDS;
        if (ig_nullable_word(program, prior_descriptor + 15ul) == obligation_id) {
            output[1] = 2ul;
            return;
        }
    }
    output[args.control_base + 8ul] = token | 2ul;
}

inline ulong ig_nullable_optional_group_for_stage(
    device const long* program,
    constant NullableRelationArgs& args,
    ulong stage);

kernel void ig_nullable_relation_prepare_stage_capacity(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (step.opcode << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 2ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong optional_group = ig_nullable_optional_group_for_stage(program, args, stage);
    if ((optional_group == 0ul && output[args.control_base + 16ul] != 0ul)
        || (optional_group != 0ul
            && output[args.control_base + 16ul] != optional_group)) {
        output[1] = 2ul;
        return;
    }
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_width = output[args.control_base + 2ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong prior_capacity = output[args.control_base + 4ul];
    ulong input_capacity = ig_nullable_word(program, descriptor + 18ul);
    ulong expected_width = ig_nullable_word(program, descriptor + 21ul);
    ulong relation_cells = 0ul;
    if (input_capacity != prior_capacity || input_rows > input_capacity
        || current_selector > 1ul
        || current_width > ig_nullable_word(program, 7ul)
        || expected_width > ig_nullable_word(program, 7ul)
        || !ig_nullable_product(input_rows, current_width, relation_cells)
        || relation_cells > args.maximum_relation_cells) {
        output[1] = 2ul;
        return;
    }
    output[args.control_base + 8ul] = token | 3ul;
}

kernel void ig_nullable_relation_node_scan_validate(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_NODE_SCAN
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || step.opcode != IG_NULLABLE_RELATION_STAGE_NODE_SCAN
        || output[args.control_base + 8ul] != (token | 3ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong current_width = output[args.control_base + 2ul];
    ulong expected_width = ig_nullable_word(program, descriptor + 21ul);
    ulong obligation_kind = ig_nullable_word(program, descriptor + 17ul);
    ulong mode = ig_nullable_word(program, descriptor + 1ul);
    ulong expected_kind = mode == 1ul ? 1ul : (mode == 2ul ? 2ul : 0ul);
    ulong output_slot = ig_nullable_word(program, descriptor + 2ul);
    ulong domain_kind = ig_nullable_word(program, descriptor + 7ul);
    ulong domain_offset = ig_nullable_word(program, descriptor + 8ul);
    ulong domain_count = ig_nullable_word(program, descriptor + 9ul);
    if (expected_kind == 0ul || obligation_kind != expected_kind
        || output_slot >= args.binding_slot_count
        || ig_nullable_slot_present(output[args.slot_map_base + output_slot])
        || !ig_nullable_domain_valid(program, args, domain_kind,
            domain_offset, domain_count, true)) {
        output[1] = 2ul;
        return;
    }
    if (current_width == ~0ul || current_width + 1ul != expected_width) {
        output[1] = 2ul;
        return;
    }
    output[args.control_base + 14ul] = expected_width;
    output[args.control_base + 8ul] = token | 4ul;
}

inline uint ig_nullable_evaluate_predicate(
    device const long* graph,
    device const long* program,
    device const ulong* output,
    constant NullableRelationArgs& args,
    ulong first,
    ulong count,
    ulong current_base,
    ulong row,
    ulong current_rows,
    ulong current_width,
    ulong overlay_slot0,
    ulong overlay_kind0,
    ulong overlay_dense0,
    ulong overlay_slot1,
    ulong overlay_kind1,
    ulong overlay_dense1);

inline ulong ig_nullable_candidate_filter_descriptor(
    constant NullableRelationArgs& args,
    ulong filter) {
    return IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + args.stage_count * IG_NULLABLE_RELATION_STAGE_WORDS
        + filter * IG_NULLABLE_RELATION_FILTER_WORDS;
}

inline ulong ig_nullable_optional_group_descriptor(
    constant NullableRelationArgs& args,
    ulong group) {
    return IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + args.stage_count * IG_NULLABLE_RELATION_STAGE_WORDS
        + args.filter_count * IG_NULLABLE_RELATION_FILTER_WORDS
        + group * IG_NULLABLE_RELATION_OPTIONAL_GROUP_WORDS;
}

inline ulong ig_nullable_optional_group_for_stage(
    device const long* program,
    constant NullableRelationArgs& args,
    ulong stage) {
    for (ulong group = 0ul; group < args.optional_group_count; ++group) {
        ulong descriptor = ig_nullable_optional_group_descriptor(args, group);
        if (ig_nullable_word(program, descriptor) <= stage
            && stage <= ig_nullable_word(program, descriptor + 1ul)) return group + 1ul;
    }
    return 0ul;
}

inline bool ig_nullable_stage_has_candidate_filters(
    device const long* program,
    constant NullableRelationArgs& args,
    ulong stage) {
    for (ulong filter = 0ul; filter < args.filter_count; ++filter) {
        ulong descriptor = ig_nullable_candidate_filter_descriptor(args, filter);
        if (ig_nullable_word(program, descriptor)
                == IG_NULLABLE_RELATION_FILTER_OPTIONAL_CANDIDATES
            && ig_nullable_word(program, descriptor + 1ul) == stage) return true;
    }
    return false;
}

inline void ig_nullable_initialize_candidate_filter_receipts(
    device const long* program,
    device ulong* output,
    constant NullableRelationArgs& args,
    ulong stage) {
    for (ulong filter = 0ul; filter < args.filter_count; ++filter) {
        ulong descriptor = ig_nullable_candidate_filter_descriptor(args, filter);
        if (ig_nullable_word(program, descriptor)
                != IG_NULLABLE_RELATION_FILTER_OPTIONAL_CANDIDATES
            || ig_nullable_word(program, descriptor + 1ul) != stage) continue;
        ig_nullable_write_receipt(output, args,
            ig_nullable_word(program, descriptor + 5ul),
            ig_nullable_word(program, descriptor + 4ul),
            ig_nullable_word(program, descriptor + 6ul),
            0ul, 0ul, 0ul, 0ul, 0ul);
    }
}

// Candidate predicates execute against the current relation plus at most two bindings introduced
// by this physical stage. Filters are chained in declaration order: a rejected candidate is never
// observed by a later filter, exactly matching Cypher's OPTIONAL candidate semantics.
inline uint ig_nullable_candidate_survives(
    device const long* graph,
    device const long* program,
    device ulong* output,
    constant NullableRelationArgs& args,
    ulong stage,
    ulong current_base,
    ulong row,
    ulong current_rows,
    ulong current_width,
    ulong overlay_slot0,
    ulong overlay_kind0,
    ulong overlay_dense0,
    ulong overlay_slot1,
    ulong overlay_kind1,
    ulong overlay_dense1,
    bool observe) {
    for (ulong filter = 0ul; filter < args.filter_count; ++filter) {
        ulong descriptor = ig_nullable_candidate_filter_descriptor(args, filter);
        if (ig_nullable_word(program, descriptor)
                != IG_NULLABLE_RELATION_FILTER_OPTIONAL_CANDIDATES
            || ig_nullable_word(program, descriptor + 1ul) != stage) continue;
        uint truth = ig_nullable_evaluate_predicate(
            graph, program, output, args,
            ig_nullable_word(program, descriptor + 2ul),
            ig_nullable_word(program, descriptor + 3ul),
            current_base, row, current_rows, current_width,
            overlay_slot0, overlay_kind0, overlay_dense0,
            overlay_slot1, overlay_kind1, overlay_dense1);
        if (truth > 2u) return 2u;
        if (observe) {
            ulong receipt = ig_nullable_word(program, descriptor + 5ul);
            ulong base = IG_NULLABLE_RELATION_HEADER_WORDS
                + receipt * IG_NULLABLE_RELATION_RECEIPT_WORDS;
            ++output[base + 5ul];
            if (truth == 0u) ++output[base + 6ul];
            else if (truth == 1u) {
                ++output[base + 7ul];
                ++output[base + 9ul];
            } else ++output[base + 8ul];
        }
        if (truth != 1u) return 0u;
    }
    return 1u;
}

inline void ig_nullable_initialize_group_filter_receipts(
    device const long* program,
    device ulong* output,
    constant NullableRelationArgs& args,
    ulong group) {
    for (ulong filter = 0ul; filter < args.filter_count; ++filter) {
        ulong descriptor = ig_nullable_candidate_filter_descriptor(args, filter);
        if (ig_nullable_word(program, descriptor)
                != IG_NULLABLE_RELATION_FILTER_OPTIONAL_GROUP
            || ig_nullable_word(program, descriptor + 1ul) != group) continue;
        ig_nullable_write_receipt(output, args,
            ig_nullable_word(program, descriptor + 5ul),
            ig_nullable_word(program, descriptor + 4ul),
            ig_nullable_word(program, descriptor + 6ul),
            0ul, 0ul, 0ul, 0ul, 0ul);
    }
}

// A WHERE attached to a multi-stage OPTIONAL pattern filters complete path candidates before the
// group decides whether each parent needs one null-extended row. Filters are chained in source
// order, so later filters observe only rows accepted by every earlier filter.
inline uint ig_nullable_group_candidate_survives(
    device const long* graph,
    device const long* program,
    device ulong* output,
    constant NullableRelationArgs& args,
    ulong group,
    ulong current_base,
    ulong row,
    ulong current_rows,
    ulong current_width) {
    for (ulong filter = 0ul; filter < args.filter_count; ++filter) {
        ulong descriptor = ig_nullable_candidate_filter_descriptor(args, filter);
        if (ig_nullable_word(program, descriptor)
                != IG_NULLABLE_RELATION_FILTER_OPTIONAL_GROUP
            || ig_nullable_word(program, descriptor + 1ul) != group) continue;
        uint truth = ig_nullable_evaluate_predicate(
            graph, program, output, args,
            ig_nullable_word(program, descriptor + 2ul),
            ig_nullable_word(program, descriptor + 3ul),
            current_base, row, current_rows, current_width,
            ~0ul, 0ul, 0ul, ~0ul, 0ul, 0ul);
        if (truth > 2u) return 2u;
        ulong receipt = ig_nullable_word(program, descriptor + 5ul);
        ulong base = IG_NULLABLE_RELATION_HEADER_WORDS
            + receipt * IG_NULLABLE_RELATION_RECEIPT_WORDS;
        ++output[base + 5ul];
        if (truth == 0u) ++output[base + 6ul];
        else if (truth == 1u) {
            ++output[base + 7ul];
            ++output[base + 9ul];
        } else ++output[base + 8ul];
        if (truth != 1u) return 0u;
    }
    return 1u;
}

kernel void ig_nullable_relation_group_begin(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    if (thread_index != 0u || output[1] != 0ul
        || step.opcode != IG_NULLABLE_RELATION_GROUP_BEGIN
        || step.filter >= args.optional_group_count) return;
    ulong descriptor = ig_nullable_optional_group_descriptor(args, step.filter);
    ulong rows = output[args.control_base + 1ul];
    ulong width = output[args.control_base + 2ul];
    ulong selector = output[args.control_base + 3ul];
    ulong current_base = selector == 0ul ? args.relation_a_base : args.relation_b_base;
    ulong lineage_base = selector == 0ul ? args.lineage_a_base : args.lineage_b_base;
    ulong cells = 0ul;
    if (ig_nullable_word(program, descriptor) != step.stage
        || output[args.control_base + 5ul] != step.stage
        || output[args.control_base + 7ul] != IG_NULLABLE_RELATION_GRAPH_VALID
        || output[args.control_base + 8ul] != 0ul
        || output[args.control_base + 16ul] != 0ul
        || output[args.control_base + 17ul] != 0ul
        || output[args.control_base + 18ul] != 0ul
        || output[args.control_base + 16ul] != 0ul
        || rows > args.maximum_relation_rows
        || !ig_nullable_product(rows, width, cells)
        || cells > args.maximum_relation_cells) {
        output[1] = 2ul;
        return;
    }
    ulong introduced_offset = ig_nullable_word(program, descriptor + 2ul);
    ulong introduced_count = ig_nullable_word(program, descriptor + 3ul);
    for (ulong binding = 0ul; binding < introduced_count; ++binding) {
        ulong slot = ig_nullable_word(program, introduced_offset + binding * 2ul);
        if (slot >= args.binding_slot_count
            || ig_nullable_slot_present(output[args.slot_map_base + slot])) {
            output[1] = 2ul;
            return;
        }
    }
    for (ulong row = 0ul; row < rows; ++row) {
        if (!ig_nullable_copy_row(output, current_base, args.parent_relation_base,
                args.maximum_relation_cells, row, rows, width, row, width)) {
            output[1] = 2ul;
            return;
        }
        output[lineage_base + row] = row;
    }
    output[args.control_base + 16ul] = step.filter + 1ul;
    output[args.control_base + 17ul] = rows;
    output[args.control_base + 18ul] = width;
}

kernel void ig_nullable_relation_group_finish(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    if (thread_index != 0u || output[1] != 0ul
        || step.opcode != IG_NULLABLE_RELATION_GROUP_FINISH
        || step.filter >= args.optional_group_count) return;
    ulong descriptor = ig_nullable_optional_group_descriptor(args, step.filter);
    ulong current_rows = output[args.control_base + 1ul];
    ulong current_width = output[args.control_base + 2ul];
    ulong selector = output[args.control_base + 3ul];
    ulong current_base = selector == 0ul ? args.relation_a_base : args.relation_b_base;
    ulong next_base = selector == 0ul ? args.relation_b_base : args.relation_a_base;
    ulong lineage_base = selector == 0ul ? args.lineage_a_base : args.lineage_b_base;
    ulong parent_rows = output[args.control_base + 17ul];
    ulong parent_width = output[args.control_base + 18ul];
    ulong introduced_offset = ig_nullable_word(program, descriptor + 2ul);
    ulong introduced_count = ig_nullable_word(program, descriptor + 3ul);
    ulong stage_descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + step.stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong output_capacity = ig_nullable_word(program, stage_descriptor + 20ul);
    if (ig_nullable_word(program, descriptor + 1ul) != step.stage
        || output[args.control_base + 5ul] != step.stage + 1ul
        || output[args.control_base + 7ul] != IG_NULLABLE_RELATION_GRAPH_VALID
        || output[args.control_base + 8ul] != 0ul
        || output[args.control_base + 16ul] != step.filter + 1ul
        || parent_rows > args.maximum_relation_rows
        || current_rows > args.maximum_relation_rows
        || parent_width > current_width
        || current_width - parent_width != introduced_count) {
        output[1] = 2ul;
        return;
    }
    for (ulong binding = 0ul; binding < introduced_count; ++binding) {
        ulong slot = ig_nullable_word(program, introduced_offset + binding * 2ul);
        ulong kind = ig_nullable_word(program, introduced_offset + binding * 2ul + 1ul);
        ulong entry = slot < args.binding_slot_count
            ? output[args.slot_map_base + slot] : 0ul;
        if (!ig_nullable_slot_present(entry)
            || ig_nullable_slot_kind(entry) != kind
            || ig_nullable_slot_column(entry) < parent_width
            || ig_nullable_slot_column(entry) >= current_width) {
            output[1] = 2ul;
            return;
        }
    }
    ulong candidate = 0ul;
    ulong output_rows = 0ul;
    ulong surviving_candidates = 0ul;
    ulong matched_parents = 0ul;
    ulong null_rows = 0ul;
    ig_nullable_initialize_group_filter_receipts(
        program, output, args, step.filter);
    for (ulong parent = 0ul; parent < parent_rows; ++parent) {
        if (candidate < current_rows
            && output[lineage_base + candidate] < parent) {
            output[1] = 2ul;
            return;
        }
        ulong first_output = output_rows;
        while (candidate < current_rows
            && output[lineage_base + candidate] == parent) {
            bool complete = true;
            for (ulong binding = 0ul; binding < introduced_count; ++binding) {
                ulong slot = ig_nullable_word(
                    program, introduced_offset + binding * 2ul);
                ulong column = ig_nullable_slot_column(output[args.slot_map_base + slot]);
                if (output[current_base + candidate * current_width + column]
                        == IG_NULLABLE_RELATION_NULL_ROW) {
                    complete = false;
                    break;
                }
            }
            uint survives = complete ? ig_nullable_group_candidate_survives(
                graph, program, output, args, step.filter,
                current_base, candidate, current_rows, current_width) : 0u;
            if (survives > 1u) {
                output[1] = 2ul;
                return;
            }
            if (survives == 1u) {
                if (output_rows == output_capacity
                    || !ig_nullable_copy_row(output, current_base, next_base,
                        args.maximum_relation_cells, candidate, current_rows,
                        current_width, output_rows, current_width)) {
                    output[1] = 3ul;
                    return;
                }
                ++output_rows;
                ++surviving_candidates;
            }
            ++candidate;
        }
        if (output_rows != first_output) {
            ++matched_parents;
            continue;
        }
        if (output_rows == output_capacity
            || !ig_nullable_copy_row(output, args.parent_relation_base, next_base,
                args.maximum_relation_cells, parent, parent_rows,
                parent_width, output_rows, current_width)) {
            output[1] = 3ul;
            return;
        }
        for (ulong binding = 0ul; binding < introduced_count; ++binding) {
            ulong slot = ig_nullable_word(program, introduced_offset + binding * 2ul);
            ulong column = ig_nullable_slot_column(output[args.slot_map_base + slot]);
            output[next_base + output_rows * current_width + column] =
                IG_NULLABLE_RELATION_NULL_ROW;
        }
        ++null_rows;
        ++output_rows;
    }
    if (candidate != current_rows
        || matched_parents + null_rows != parent_rows) {
        output[1] = 2ul;
        return;
    }
    ig_nullable_write_receipt(output, args,
        ig_nullable_word(program, descriptor + 5ul),
        ig_nullable_word(program, descriptor + 4ul),
        ig_nullable_word(program, descriptor + 6ul),
        parent_rows, matched_parents, surviving_candidates, null_rows, output_rows);
    output[args.control_base + 1ul] = output_rows;
    output[args.control_base + 3ul] = 1ul - selector;
    output[args.control_base + 4ul] = output_capacity;
    output[args.control_base + 16ul] = 0ul;
    output[args.control_base + 17ul] = 0ul;
    output[args.control_base + 18ul] = 0ul;
}

kernel void ig_nullable_relation_node_scan_count(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_NODE_SCAN
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 4ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    bool atomic_optional = output[args.control_base + 16ul] != 0ul;
    ulong input_rows = output[args.control_base + 1ul];
    ulong mode = ig_nullable_word(program, descriptor + 1ul);
    ulong domain_kind = ig_nullable_word(program, descriptor + 7ul);
    ulong domain_offset = ig_nullable_word(program, descriptor + 8ul);
    ulong domain_count = ig_nullable_word(program, descriptor + 9ul);
    ulong domain_rows = 0ul;
    for (ulong node = 0ul; node < args.node_count; ++node) {
        uint matches = ig_nullable_node_matches(graph, program, args, node,
            domain_kind, domain_offset, domain_count);
        if (matches == 2u) {
            output[1] = 2ul;
            return;
        }
        if (matches == 1u) ++domain_rows;
    }
    bool candidate_filters = ig_nullable_stage_has_candidate_filters(
        program, args, stage);
    ig_nullable_initialize_candidate_filter_receipts(
        program, output, args, stage);
    ulong candidate_rows = 0ul;
    ulong matched_input_rows = 0ul;
    ulong null_rows = 0ul;
    if (!candidate_filters) {
        if (!ig_nullable_product(input_rows, domain_rows, candidate_rows)) {
            output[1] = 2ul;
            return;
        }
        matched_input_rows = domain_rows == 0ul ? 0ul : input_rows;
        null_rows = domain_rows == 0ul && mode == 2ul && !atomic_optional
            ? input_rows : 0ul;
    } else {
        ulong output_slot = ig_nullable_word(program, descriptor + 2ul);
        for (ulong input = 0ul; input < input_rows; ++input) {
            ulong row_candidates = 0ul;
            for (ulong node = 0ul; node < args.node_count; ++node) {
                uint matches = ig_nullable_node_matches(graph, program, args, node,
                    domain_kind, domain_offset, domain_count);
                if (matches != 1u) continue;
                uint survives = ig_nullable_candidate_survives(
                    graph, program, output, args, stage,
                    output[args.control_base + 3ul] == 0ul
                        ? args.relation_a_base : args.relation_b_base,
                    input, input_rows, output[args.control_base + 2ul],
                    output_slot, 1ul, node, ~0ul, 0ul, 0ul, true);
                if (survives == 2u) {
                    output[1] = 2ul;
                    return;
                }
                if (survives != 1u) continue;
                if (candidate_rows == ~0ul) {
                    output[1] = 2ul;
                    return;
                }
                ++candidate_rows;
                ++row_candidates;
            }
            if (row_candidates != 0ul) ++matched_input_rows;
            else if (mode == 2ul && !atomic_optional) ++null_rows;
        }
    }
    if (candidate_rows > ~0ul - null_rows) {
        output[1] = 2ul;
        return;
    }
    ulong output_rows = candidate_rows + null_rows;
    ulong candidate_capacity = ig_nullable_word(program, descriptor + 19ul);
    ulong output_capacity = ig_nullable_word(program, descriptor + 20ul);
    if (candidate_rows > candidate_capacity || output_rows > output_capacity) {
        output[1] = 3ul;
        return;
    }
    output[args.control_base + 9ul] = domain_rows;
    output[args.control_base + 10ul] = candidate_rows;
    output[args.control_base + 11ul] = matched_input_rows;
    output[args.control_base + 12ul] = null_rows;
    output[args.control_base + 13ul] = output_rows;
    output[args.control_base + 15ul] = 0ul;
    output[args.control_base + 8ul] = token | 5ul;
}

kernel void ig_nullable_relation_node_scan_materialize(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_NODE_SCAN
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 5ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_width = output[args.control_base + 2ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong current_base = current_selector == 0ul
        ? args.relation_a_base : args.relation_b_base;
    ulong next_base = current_selector == 0ul
        ? args.relation_b_base : args.relation_a_base;
    bool atomic_optional = output[args.control_base + 16ul] != 0ul;
    ulong current_lineage_base = current_selector == 0ul
        ? args.lineage_a_base : args.lineage_b_base;
    ulong next_lineage_base = current_selector == 0ul
        ? args.lineage_b_base : args.lineage_a_base;
    ulong mode = ig_nullable_word(program, descriptor + 1ul);
    ulong output_slot = ig_nullable_word(program, descriptor + 2ul);
    ulong domain_kind = ig_nullable_word(program, descriptor + 7ul);
    ulong domain_offset = ig_nullable_word(program, descriptor + 8ul);
    ulong domain_count = ig_nullable_word(program, descriptor + 9ul);
    ulong domain_rows = output[args.control_base + 9ul];
    ulong output_rows = output[args.control_base + 13ul];
    ulong output_width = output[args.control_base + 14ul];
    bool candidate_filters = ig_nullable_stage_has_candidate_filters(
        program, args, stage);
    ulong out = 0ul;
    for (ulong input = 0ul; input < input_rows; ++input) {
        ulong first_output = out;
        if (domain_rows != 0ul) {
            for (ulong node = 0ul; node < args.node_count; ++node) {
                uint matches = ig_nullable_node_matches(graph, program, args, node,
                    domain_kind, domain_offset, domain_count);
                if (matches != 1u) continue;
                if (candidate_filters) {
                    uint survives = ig_nullable_candidate_survives(
                        graph, program, output, args, stage,
                        current_base, input, input_rows, current_width,
                        output_slot, 1ul, node, ~0ul, 0ul, 0ul, false);
                    if (survives == 2u) {
                        output[1] = 2ul;
                        return;
                    }
                    if (survives != 1u) continue;
                }
                if (out >= output_rows
                    || !ig_nullable_copy_row(output, current_base, next_base,
                        args.maximum_relation_cells, input, input_rows,
                        current_width, out, output_width)) {
                    output[1] = 3ul;
                    return;
                }
                output[next_base + out * output_width + current_width] = node;
                if (atomic_optional) {
                    output[next_lineage_base + out] =
                        output[current_lineage_base + input];
                }
                ++out;
            }
        }
        if (out == first_output && mode == 2ul && !atomic_optional) {
            if (out >= output_rows
                || !ig_nullable_copy_row(output, current_base, next_base,
                    args.maximum_relation_cells, input, input_rows,
                    current_width, out, output_width)) {
                output[1] = 3ul;
                return;
            }
            output[next_base + out * output_width + current_width] =
                IG_NULLABLE_RELATION_NULL_ROW;
            ++out;
        }
    }
    if (out != output_rows) {
        output[1] = 2ul;
        return;
    }
    output[args.slot_map_base + output_slot] =
        ig_nullable_slot_entry(1ul, current_width);
    output[args.control_base + 15ul] = out;
    output[args.control_base + 8ul] = token | 6ul;
}

kernel void ig_nullable_relation_node_scan_commit(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_NODE_SCAN
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    ulong output_rows = output[args.control_base + 13ul];
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 6ul)
        || output[args.control_base + 15ul] != output_rows) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong output_capacity = ig_nullable_word(program, descriptor + 20ul);
    ulong obligation_id = ig_nullable_word(program, descriptor + 15ul);
    ulong obligation_kind = ig_nullable_word(program, descriptor + 17ul);
    ig_nullable_commit_stage(output, args, stage,
        ig_nullable_word(program, descriptor + 16ul), obligation_id, obligation_kind,
        input_rows, current_selector, output_capacity,
        output[args.control_base + 11ul], output[args.control_base + 10ul],
        output[args.control_base + 12ul], output_rows,
        output[args.control_base + 14ul], true);
}

kernel void ig_nullable_relation_expand_validate(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_EXPAND
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || step.opcode != IG_NULLABLE_RELATION_STAGE_EXPAND
        || output[args.control_base + 8ul] != (token | 3ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong current_width = output[args.control_base + 2ul];
    ulong expected_width = ig_nullable_word(program, descriptor + 21ul);
    ulong obligation_kind = ig_nullable_word(program, descriptor + 17ul);
    ulong mode = ig_nullable_word(program, descriptor + 1ul);
    ulong expected_kind = mode == 1ul ? 3ul : (mode == 2ul ? 4ul : 0ul);
    ulong source_slot = ig_nullable_word(program, descriptor + 2ul);
    ulong relationship_slot = ig_nullable_word(program, descriptor + 3ul);
    ulong target_kind = ig_nullable_word(program, descriptor + 4ul);
    ulong target_slot = ig_nullable_word(program, descriptor + 5ul);
    ulong direction = ig_nullable_word(program, descriptor + 6ul);
    ulong relationship_domain = ig_nullable_word(program, descriptor + 7ul);
    ulong relationship_offset = ig_nullable_word(program, descriptor + 8ul);
    ulong relationship_count = ig_nullable_word(program, descriptor + 9ul);
    ulong target_domain = ig_nullable_word(program, descriptor + 10ul);
    ulong target_offset = ig_nullable_word(program, descriptor + 11ul);
    ulong target_count = ig_nullable_word(program, descriptor + 12ul);
    ulong exclusion_offset = ig_nullable_word(program, descriptor + 13ul);
    ulong exclusion_count = ig_nullable_word(program, descriptor + 14ul);
    ulong payload_base = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + args.stage_count * IG_NULLABLE_RELATION_STAGE_WORDS;
    if (exclusion_count > args.binding_slot_count
        || exclusion_offset < payload_base
        || !ig_nullable_range(exclusion_offset, exclusion_count + 4ul,
            args.program_word_count)) {
        output[1] = 2ul;
        return;
    }
    ulong source_domain_metadata = exclusion_offset + 1ul + exclusion_count;
    ulong source_domain = ig_nullable_word(program, source_domain_metadata);
    ulong source_offset = ig_nullable_word(program, source_domain_metadata + 1ul);
    ulong source_count = ig_nullable_word(program, source_domain_metadata + 2ul);
    bool has_relationship = relationship_slot != ~0ul;
    ulong relationship_entry = has_relationship && relationship_slot < args.binding_slot_count
        ? output[args.slot_map_base + relationship_slot] : 0ul;
    bool relationship_is_present = has_relationship
        && ig_nullable_slot_present(relationship_entry);
    bool introduces_relationship = has_relationship && relationship_entry == 0ul;
    bool introduces_target = target_kind == 1ul;
    if (expected_kind == 0ul || obligation_kind != expected_kind
        || source_slot >= args.binding_slot_count
        || (has_relationship && relationship_slot >= args.binding_slot_count)
        || target_kind > 1ul || target_slot >= args.binding_slot_count
        || direction < 1ul || direction > 3ul
        || !ig_nullable_domain_valid(program, args, relationship_domain,
            relationship_offset, relationship_count, false)
        || !ig_nullable_domain_valid(program, args, target_domain,
            target_offset, target_count, true)
        || !ig_nullable_domain_valid(program, args, source_domain,
            source_offset, source_count, true)) {
        output[1] = 2ul;
        return;
    }
    ulong source_entry = output[args.slot_map_base + source_slot];
    if (!ig_nullable_slot_present(source_entry)
        || ig_nullable_slot_kind(source_entry) != 1ul
        || ig_nullable_slot_column(source_entry) >= current_width) {
        output[1] = 2ul;
        return;
    }
    if (has_relationship && !introduces_relationship
        && (!relationship_is_present
            || ig_nullable_slot_kind(relationship_entry) != 2ul
            || ig_nullable_slot_column(relationship_entry) >= current_width)) {
        output[1] = 2ul;
        return;
    }
    ulong uniqueness_group = ig_nullable_word(program, exclusion_offset);
    ulong previous_exclusion = 0ul;
    for (ulong exclusion = 0ul; exclusion < exclusion_count; ++exclusion) {
        ulong slot = ig_nullable_word(program, exclusion_offset + 1ul + exclusion);
        ulong entry = slot < args.binding_slot_count
            ? output[args.slot_map_base + slot] : 0ul;
        if (slot >= args.binding_slot_count
            || (exclusion != 0ul && slot <= previous_exclusion)
            || !ig_nullable_slot_present(entry)
            || ig_nullable_slot_kind(entry) != 2ul
            || ig_nullable_slot_column(entry) >= current_width) {
            output[1] = 2ul;
            return;
        }
        previous_exclusion = slot;
    }
    ulong expected_exclusions = 0ul;
    ulong last_group = 0ul;
    bool saw_prior_group = false;
    for (ulong prior = 0ul; prior < stage; ++prior) {
        ulong prior_descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
            + prior * IG_NULLABLE_RELATION_STAGE_WORDS;
        if (ig_nullable_word(program, prior_descriptor)
                != IG_NULLABLE_RELATION_STAGE_EXPAND) continue;
        ulong prior_offset = ig_nullable_word(program, prior_descriptor + 13ul);
        ulong prior_count = ig_nullable_word(program, prior_descriptor + 14ul);
        if (prior_count > args.binding_slot_count || prior_offset < payload_base
            || !ig_nullable_range(prior_offset, prior_count + 4ul,
                args.program_word_count)) {
            output[1] = 2ul;
            return;
        }
        ulong prior_group = ig_nullable_word(program, prior_offset);
        if ((saw_prior_group && prior_group < last_group)
            || prior_group > uniqueness_group) {
            output[1] = 2ul;
            return;
        }
        saw_prior_group = true;
        last_group = prior_group;
        if (prior_group != uniqueness_group) continue;
        ulong prior_slot = ig_nullable_word(program, prior_descriptor + 3ul);
        if (prior_slot == ~0ul || relationship_slot == ~0ul) {
            output[1] = 2ul;
            return;
        }
        bool first_occurrence = true;
        for (ulong earlier = 0ul; earlier < prior; ++earlier) {
            ulong earlier_descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
                + earlier * IG_NULLABLE_RELATION_STAGE_WORDS;
            if (ig_nullable_word(program, earlier_descriptor)
                    != IG_NULLABLE_RELATION_STAGE_EXPAND) continue;
            ulong earlier_offset = ig_nullable_word(program, earlier_descriptor + 13ul);
            if (ig_nullable_range(earlier_offset, 1ul, args.program_word_count)
                && ig_nullable_word(program, earlier_offset) == uniqueness_group
                && ig_nullable_word(program, earlier_descriptor + 3ul) == prior_slot) {
                first_occurrence = false;
                break;
            }
        }
        if (!first_occurrence) continue;
        ++expected_exclusions;
        bool found = false;
        for (ulong exclusion = 0ul; exclusion < exclusion_count; ++exclusion) {
            if (ig_nullable_word(program, exclusion_offset + 1ul + exclusion)
                    == prior_slot) {
                found = true;
                break;
            }
        }
        if (!found) {
            output[1] = 2ul;
            return;
        }
    }
    if (expected_exclusions != exclusion_count) {
        output[1] = 2ul;
        return;
    }
    ulong target_entry = output[args.slot_map_base + target_slot];
    if ((introduces_target && ig_nullable_slot_present(target_entry))
        || (!introduces_target && (!ig_nullable_slot_present(target_entry)
            || ig_nullable_slot_kind(target_entry) != 1ul
            || ig_nullable_slot_column(target_entry) >= current_width))) {
        output[1] = 2ul;
        return;
    }
    ulong output_width = current_width
        + (introduces_relationship ? 1ul : 0ul)
        + (introduces_target ? 1ul : 0ul);
    if (output_width != expected_width) {
        output[1] = 2ul;
        return;
    }
    output[args.control_base + 14ul] = output_width;
    output[args.control_base + 8ul] = token | 4ul;
}

kernel void ig_nullable_relation_expand_count(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_EXPAND
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 4ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_width = output[args.control_base + 2ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong current_base = current_selector == 0ul
        ? args.relation_a_base : args.relation_b_base;
    ulong mode = ig_nullable_word(program, descriptor + 1ul);
    bool atomic_optional = output[args.control_base + 16ul] != 0ul;
    ulong source_slot = ig_nullable_word(program, descriptor + 2ul);
    ulong relationship_slot = ig_nullable_word(program, descriptor + 3ul);
    ulong target_kind = ig_nullable_word(program, descriptor + 4ul);
    ulong target_slot = ig_nullable_word(program, descriptor + 5ul);
    ulong direction = ig_nullable_word(program, descriptor + 6ul);
    ulong relationship_domain = ig_nullable_word(program, descriptor + 7ul);
    ulong relationship_offset = ig_nullable_word(program, descriptor + 8ul);
    ulong relationship_count = ig_nullable_word(program, descriptor + 9ul);
    ulong target_domain = ig_nullable_word(program, descriptor + 10ul);
    ulong target_offset = ig_nullable_word(program, descriptor + 11ul);
    ulong target_count = ig_nullable_word(program, descriptor + 12ul);
    bool introduces_target = target_kind == 1ul;
    ulong source_column = ig_nullable_slot_column(
        output[args.slot_map_base + source_slot]);
    ulong target_column = introduces_target ? 0ul : ig_nullable_slot_column(
        output[args.slot_map_base + target_slot]);
    ulong candidate_capacity = ig_nullable_word(program, descriptor + 19ul);
    ulong output_capacity = ig_nullable_word(program, descriptor + 20ul);
    bool candidate_filters = ig_nullable_stage_has_candidate_filters(
        program, args, stage);
    ig_nullable_initialize_candidate_filter_receipts(
        program, output, args, stage);
    ulong candidate_rows = 0ul;
    ulong matched_input_rows = 0ul;
    ulong null_rows = 0ul;
    ulong output_rows = 0ul;
    for (ulong input = 0ul; input < input_rows; ++input) {
        ulong row_candidates = 0ul;
        ulong source = output[current_base
            + input * current_width + source_column];
        ulong existing_target = introduces_target
            ? IG_NULLABLE_RELATION_NULL_ROW
            : output[current_base + input * current_width + target_column];
        if ((source != IG_NULLABLE_RELATION_NULL_ROW && source >= args.node_count)
            || (!introduces_target && existing_target != IG_NULLABLE_RELATION_NULL_ROW
                && existing_target >= args.node_count)) {
            output[1] = 2ul;
            return;
        }
        if (source != IG_NULLABLE_RELATION_NULL_ROW
            && (introduces_target || existing_target != IG_NULLABLE_RELATION_NULL_ROW)
            && relationship_domain != IG_NULLABLE_RELATION_DOMAIN_EMPTY
            && target_domain != IG_NULLABLE_RELATION_DOMAIN_EMPTY) {
            ulong pass_count = direction == 3ul ? 2ul : 1ul;
            for (ulong pass = 0ul; pass < pass_count; ++pass) {
                bool incoming = direction == 2ul || (direction == 3ul && pass == 1ul);
                IgNullableCsrResolvedRow row =
                    ig_nullable_csr_resolve_orientation(graph, args, incoming, source);
                for (ulong position = row.begin; position < row.end; ++position) {
                    ulong neighbor = ig_nullable_csr_orientation_neighbor(
                        graph, args, incoming, row, position);
                    ulong edge = ig_nullable_csr_orientation_edge(
                        graph, args, incoming, row, position);
                    if (direction == 3ul && incoming && neighbor == source) continue;
                    uint candidate_matches = ig_nullable_expand_candidate_matches(
                        graph, program, output, args, descriptor, current_base,
                        input, current_width, edge, neighbor);
                    if (candidate_matches == 2u) {
                        output[1] = 2ul;
                        return;
                    }
                    if (candidate_matches != 1u) continue;
                    if (candidate_filters) {
                        uint survives = ig_nullable_candidate_survives(
                            graph, program, output, args, stage,
                            current_base, input, input_rows, current_width,
                            relationship_slot, 2ul, edge,
                            introduces_target ? target_slot : ~0ul,
                            1ul, neighbor, true);
                        if (survives == 2u) {
                            output[1] = 2ul;
                            return;
                        }
                        if (survives != 1u) continue;
                    }
                    if (candidate_rows == candidate_capacity
                        || output_rows == output_capacity) {
                        output[1] = 3ul;
                        return;
                    }
                    ++candidate_rows;
                    ++output_rows;
                    ++row_candidates;
                }
            }
        }
        if (row_candidates != 0ul) ++matched_input_rows;
        if (row_candidates == 0ul && mode == 2ul && !atomic_optional) {
            if (output_rows == output_capacity) {
                output[1] = 3ul;
                return;
            }
            ++null_rows;
            ++output_rows;
        }
    }
    if (candidate_rows > candidate_capacity
        || output_rows > output_capacity) {
        output[1] = 3ul;
        return;
    }
    output[args.control_base + 10ul] = candidate_rows;
    output[args.control_base + 11ul] = matched_input_rows;
    output[args.control_base + 12ul] = null_rows;
    output[args.control_base + 13ul] = output_rows;
    output[args.control_base + 15ul] = 0ul;
    output[args.control_base + 8ul] = token | 5ul;
}

kernel void ig_nullable_relation_expand_materialize(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_EXPAND
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 5ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_width = output[args.control_base + 2ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong current_base = current_selector == 0ul
        ? args.relation_a_base : args.relation_b_base;
    ulong next_base = current_selector == 0ul
        ? args.relation_b_base : args.relation_a_base;
    ulong mode = ig_nullable_word(program, descriptor + 1ul);
    ulong source_slot = ig_nullable_word(program, descriptor + 2ul);
    ulong relationship_slot = ig_nullable_word(program, descriptor + 3ul);
    ulong target_kind = ig_nullable_word(program, descriptor + 4ul);
    ulong target_slot = ig_nullable_word(program, descriptor + 5ul);
    ulong direction = ig_nullable_word(program, descriptor + 6ul);
    ulong relationship_domain = ig_nullable_word(program, descriptor + 7ul);
    ulong relationship_offset = ig_nullable_word(program, descriptor + 8ul);
    ulong relationship_count = ig_nullable_word(program, descriptor + 9ul);
    ulong target_domain = ig_nullable_word(program, descriptor + 10ul);
    ulong target_offset = ig_nullable_word(program, descriptor + 11ul);
    ulong target_count = ig_nullable_word(program, descriptor + 12ul);
    bool introduces_relationship = relationship_slot != ~0ul
        && !ig_nullable_slot_present(output[args.slot_map_base + relationship_slot]);
    bool introduces_target = target_kind == 1ul;
    bool atomic_optional = output[args.control_base + 16ul] != 0ul;
    ulong current_lineage_base = current_selector == 0ul
        ? args.lineage_a_base : args.lineage_b_base;
    ulong next_lineage_base = current_selector == 0ul
        ? args.lineage_b_base : args.lineage_a_base;
    ulong source_column = ig_nullable_slot_column(
        output[args.slot_map_base + source_slot]);
    ulong target_column = introduces_target ? 0ul : ig_nullable_slot_column(
        output[args.slot_map_base + target_slot]);
    ulong relationship_column = current_width;
    ulong introduced_target_column = current_width
        + (introduces_relationship ? 1ul : 0ul);
    ulong output_width = output[args.control_base + 14ul];
    bool candidate_filters = ig_nullable_stage_has_candidate_filters(
        program, args, stage);
    ulong candidate_rows = 0ul;
    ulong null_rows = 0ul;
    ulong output_rows = 0ul;
    for (ulong input = 0ul; input < input_rows; ++input) {
        ulong first_output = output_rows;
        ulong source = output[current_base + input * current_width + source_column];
        ulong existing_target = introduces_target ? IG_NULLABLE_RELATION_NULL_ROW
            : output[current_base + input * current_width + target_column];
        if (source != IG_NULLABLE_RELATION_NULL_ROW
            && (introduces_target || existing_target != IG_NULLABLE_RELATION_NULL_ROW)
            && relationship_domain != IG_NULLABLE_RELATION_DOMAIN_EMPTY
            && target_domain != IG_NULLABLE_RELATION_DOMAIN_EMPTY) {
            ulong pass_count = direction == 3ul ? 2ul : 1ul;
            for (ulong pass = 0ul; pass < pass_count; ++pass) {
                bool incoming = direction == 2ul || (direction == 3ul && pass == 1ul);
                IgNullableCsrResolvedRow row =
                    ig_nullable_csr_resolve_orientation(graph, args, incoming, source);
                for (ulong position = row.begin; position < row.end; ++position) {
                    ulong neighbor = ig_nullable_csr_orientation_neighbor(
                        graph, args, incoming, row, position);
                    ulong edge = ig_nullable_csr_orientation_edge(
                        graph, args, incoming, row, position);
                    if (direction == 3ul && incoming && neighbor == source) continue;
                    uint candidate_matches = ig_nullable_expand_candidate_matches(
                        graph, program, output, args, descriptor, current_base,
                        input, current_width, edge, neighbor);
                    if (candidate_matches == 2u) {
                        output[1] = 2ul;
                        return;
                    }
                    if (candidate_matches != 1u) continue;
                    if (candidate_filters) {
                        uint survives = ig_nullable_candidate_survives(
                            graph, program, output, args, stage,
                            current_base, input, input_rows, current_width,
                            relationship_slot, 2ul, edge,
                            introduces_target ? target_slot : ~0ul,
                            1ul, neighbor, false);
                        if (survives == 2u) {
                            output[1] = 2ul;
                            return;
                        }
                        if (survives != 1u) continue;
                    }
                    if (candidate_rows >= output[args.control_base + 10ul]
                        || output_rows >= output[args.control_base + 13ul]
                        || !ig_nullable_copy_row(output, current_base, next_base,
                            args.maximum_relation_cells, input, input_rows,
                            current_width, output_rows, output_width)) {
                        output[1] = 2ul;
                        return;
                    }
                    if (introduces_relationship) {
                        output[next_base + output_rows * output_width
                            + relationship_column] = edge;
                    }
                    if (introduces_target) {
                        output[next_base + output_rows * output_width
                            + introduced_target_column] = neighbor;
                    }
                    if (atomic_optional) {
                        output[next_lineage_base + output_rows] =
                            output[current_lineage_base + input];
                    }
                    ++candidate_rows;
                    ++output_rows;
                }
            }
        }
        if (output_rows == first_output && mode == 2ul && !atomic_optional) {
            if (null_rows >= output[args.control_base + 12ul]
                || output_rows >= output[args.control_base + 13ul]
                || !ig_nullable_copy_row(output, current_base, next_base,
                    args.maximum_relation_cells, input, input_rows,
                    current_width, output_rows, output_width)) {
                output[1] = 2ul;
                return;
            }
            if (introduces_relationship) {
                output[next_base + output_rows * output_width
                    + relationship_column] = IG_NULLABLE_RELATION_NULL_ROW;
            }
            if (introduces_target) {
                output[next_base + output_rows * output_width
                    + introduced_target_column] = IG_NULLABLE_RELATION_NULL_ROW;
            }
            ++null_rows;
            ++output_rows;
        }
    }
    if (candidate_rows != output[args.control_base + 10ul]
        || null_rows != output[args.control_base + 12ul]
        || output_rows != output[args.control_base + 13ul]) {
        output[1] = 2ul;
        return;
    }
    if (introduces_relationship) {
        output[args.slot_map_base + relationship_slot] =
            ig_nullable_slot_entry(2ul, relationship_column);
    }
    if (introduces_target) {
        output[args.slot_map_base + target_slot] =
            ig_nullable_slot_entry(1ul, introduced_target_column);
    }
    output[args.control_base + 15ul] = output_rows;
    output[args.control_base + 8ul] = token | 6ul;
}

kernel void ig_nullable_relation_expand_commit(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_EXPAND
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    ulong output_rows = output[args.control_base + 13ul];
    if (stage >= args.stage_count
        || output[args.control_base + 8ul] != (token | 6ul)
        || output[args.control_base + 15ul] != output_rows) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong output_capacity = ig_nullable_word(program, descriptor + 20ul);
    ulong obligation_id = ig_nullable_word(program, descriptor + 15ul);
    ulong obligation_kind = ig_nullable_word(program, descriptor + 17ul);
    ig_nullable_commit_stage(output, args, stage,
        ig_nullable_word(program, descriptor + 16ul), obligation_id, obligation_kind,
        input_rows, current_selector, output_capacity,
        output[args.control_base + 11ul], output[args.control_base + 10ul],
        output[args.control_base + 12ul], output_rows,
        output[args.control_base + 14ul], true);
}

kernel void ig_nullable_relation_scope_project(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_SCOPE_PROJECT
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || step.opcode != IG_NULLABLE_RELATION_STAGE_SCOPE_PROJECT
        || output[args.control_base + 8ul] != (token | 3ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_width = output[args.control_base + 2ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong candidate_capacity = ig_nullable_word(program, descriptor + 19ul);
    ulong output_capacity = ig_nullable_word(program, descriptor + 20ul);
    ulong expected_width = ig_nullable_word(program, descriptor + 21ul);
    ulong row_limit = ig_nullable_word(program, descriptor + 1ul);
    ulong obligation_id = ig_nullable_word(program, descriptor + 15ul);
    ulong obligation_kind = ig_nullable_word(program, descriptor + 17ul);
    ulong current_base = current_selector == 0ul
        ? args.relation_a_base : args.relation_b_base;
    ulong next_base = current_selector == 0ul
        ? args.relation_b_base : args.relation_a_base;
    if (obligation_kind != 5ul) {
        output[1] = 2ul;
        return;
    }
    ulong payload_offset = ig_nullable_word(program, descriptor + 13ul);
    ulong binding_count = ig_nullable_word(program, descriptor + 14ul);
    ulong payload_words = 0ul;
    if (!ig_nullable_product(binding_count, 2ul, payload_words)
        || !ig_nullable_range(payload_offset, payload_words, args.program_word_count)
        || binding_count != expected_width) {
        output[1] = 2ul;
        return;
    }
    for (ulong slot = 0ul; slot < args.binding_slot_count; ++slot) {
        output[args.next_slot_map_base + slot] = 0ul;
    }
    for (ulong binding = 0ul; binding < binding_count; ++binding) {
        ulong source_slot = ig_nullable_word(program, payload_offset + binding * 2ul);
        ulong output_slot = ig_nullable_word(program,
            payload_offset + binding * 2ul + 1ul);
        if (source_slot >= args.binding_slot_count
            || output_slot >= args.binding_slot_count) {
            output[1] = 2ul;
            return;
        }
        ulong source_entry = output[args.slot_map_base + source_slot];
        if (!ig_nullable_slot_present(source_entry)
            || ig_nullable_slot_column(source_entry) >= current_width
            || ig_nullable_slot_present(
                output[args.next_slot_map_base + output_slot])) {
            output[1] = 2ul;
            return;
        }
        output[args.next_slot_map_base + output_slot] = ig_nullable_slot_entry(
            ig_nullable_slot_kind(source_entry), binding);
    }
    if (row_limit != ~0ul && row_limit > IG_NULLABLE_RELATION_MAX_DIMENSION) {
        output[1] = 2ul;
        return;
    }
    ulong output_rows = row_limit == ~0ul
        ? input_rows : min(input_rows, row_limit);
    ulong projected_cells = 0ul;
    if (!ig_nullable_product(output_rows, binding_count, projected_cells)) {
        output[1] = 2ul;
        return;
    }
    if (projected_cells > args.maximum_relation_cells
        || output_rows > output_capacity
        || output_rows > candidate_capacity) {
        output[1] = 3ul;
        return;
    }
    for (ulong row = 0ul; row < output_rows; ++row) {
        for (ulong binding = 0ul; binding < binding_count; ++binding) {
            ulong source_slot = ig_nullable_word(program, payload_offset + binding * 2ul);
            ulong source_column = ig_nullable_slot_column(
                output[args.slot_map_base + source_slot]);
            output[next_base + row * binding_count + binding] =
                output[current_base + row * current_width + source_column];
        }
    }
    for (ulong slot = 0ul; slot < args.binding_slot_count; ++slot) {
        output[args.slot_map_base + slot] =
            output[args.next_slot_map_base + slot];
    }
    ig_nullable_commit_stage(output, args, stage,
        ig_nullable_word(program, descriptor + 16ul), obligation_id, obligation_kind,
        input_rows, current_selector, output_capacity,
        output_rows, output_rows, 0ul,
        output_rows, binding_count, true);
}

inline ulong ig_nullable_filter_descriptor(
    constant NullableRelationArgs& args,
    ulong filter) {
    return IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + args.stage_count * IG_NULLABLE_RELATION_STAGE_WORDS
        + filter * IG_NULLABLE_RELATION_FILTER_WORDS;
}

inline bool ig_nullable_predicate_binding(
    device const ulong* output,
    constant NullableRelationArgs& args,
    ulong current_base,
    ulong row,
    ulong current_rows,
    ulong current_width,
    ulong slot,
    ulong expected_kind,
    ulong overlay_slot0,
    ulong overlay_kind0,
    ulong overlay_dense0,
    ulong overlay_slot1,
    ulong overlay_kind1,
    ulong overlay_dense1,
    thread ulong4& value) {
    if (row >= current_rows || slot >= args.binding_slot_count
        || (expected_kind != 1ul && expected_kind != 2ul)) return false;
    ulong dense = IG_NULLABLE_RELATION_NULL_ROW;
    if (slot == overlay_slot0) {
        if (overlay_kind0 != expected_kind) return false;
        dense = overlay_dense0;
    } else if (slot == overlay_slot1) {
        if (overlay_kind1 != expected_kind) return false;
        dense = overlay_dense1;
    } else {
        ulong entry = output[args.slot_map_base + slot];
        if (!ig_nullable_slot_present(entry)
            || ig_nullable_slot_kind(entry) != expected_kind
            || ig_nullable_slot_column(entry) >= current_width) return false;
        dense = output[current_base + row * current_width
            + ig_nullable_slot_column(entry)];
    }
    if (dense == IG_NULLABLE_RELATION_NULL_ROW) {
        value = ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul);
        return true;
    }
    ulong capacity = expected_kind == 1ul ? args.node_count : args.edge_count;
    if (dense >= capacity) return false;
    value = ulong4(expected_kind == 1ul
        ? IG_NULLABLE_VALUE_NODE : IG_NULLABLE_VALUE_RELATIONSHIP,
        dense, 0ul, 0ul);
    return true;
}

inline uint ig_nullable_value_truth(ulong4 value) {
    if (value.x == IG_NULLABLE_VALUE_NULL) return 2u;
    if (value.x != IG_NULLABLE_VALUE_BOOLEAN || value.y > 1ul) return 3u;
    return value.y == 0ul ? 0u : 1u;
}

inline bool ig_nullable_compare_integer(long left, ulong operation, long right) {
    if (operation == 0ul) return left == right;
    if (operation == 1ul) return left != right;
    if (operation == 2ul) return left < right;
    if (operation == 3ul) return left <= right;
    if (operation == 4ul) return left > right;
    if (operation == 5ul) return left >= right;
    return false;
}

inline bool ig_nullable_string_property_value(
    device const long* graph,
    constant NullableRelationArgs& args,
    ulong kind,
    ulong category_lane,
    ulong global_lane,
    ulong dense,
    thread ulong4& value) {
    ulong rows = kind == 1ul ? args.node_count
        : (kind == 2ul ? args.edge_count : 0ul);
    ulong lane_count = kind == 1ul ? args.node_string_lane_count
        : (kind == 2ul ? args.edge_string_lane_count : 0ul);
    if ((kind != 1ul && kind != 2ul) || category_lane >= lane_count
        || dense >= rows) return false;
    ulong validity_base = kind == 1ul
        ? args.node_string_validity_base : args.edge_string_validity_base;
    ulong present = ig_nullable_word(
        graph, validity_base + category_lane * rows + dense);
    if (present > 1ul) return false;
    if (present == 0ul) {
        value = ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul);
        return true;
    }
    ulong descriptor = args.property_descriptor_base
        + global_lane * IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS;
    if (!ig_nullable_range(descriptor,
            IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS, args.graph_word_count)
        || ig_nullable_word(graph, descriptor) != kind
        || ig_nullable_word(graph, descriptor + 1ul) != 2ul
        || ig_nullable_word(graph, descriptor + 3ul) != category_lane) return false;
    ulong storage = ig_nullable_word(graph, descriptor + 4ul);
    if (storage == IG_NULLABLE_STRING_STORAGE_DICTIONARY) {
        ulong values_base = kind == 1ul
            ? args.node_string_value_base : args.edge_string_value_base;
        ulong dictionary_id = ig_nullable_word(
            graph, values_base + category_lane * rows + dense);
        value = ulong4(IG_NULLABLE_VALUE_STRING,
            kind == 1ul ? IG_NULLABLE_STRING_NODE_DICTIONARY
                : IG_NULLABLE_STRING_EDGE_DICTIONARY,
            dictionary_id, 0ul);
        return true;
    }
    if (storage != IG_NULLABLE_STRING_STORAGE_MIXED) return false;
    ulong offset_base = ig_nullable_word(graph, descriptor + 5ul);
    ulong byte_base = ig_nullable_word(graph, descriptor + 6ul);
    ulong byte_count = ig_nullable_word(graph, descriptor + 7ul);
    if (!ig_nullable_range(offset_base, rows + 1ul, args.graph_word_count)
        || !ig_nullable_range(byte_base, byte_count, args.graph_word_count)) return false;
    ulong start = ig_nullable_word(graph, offset_base + dense);
    ulong end = ig_nullable_word(graph, offset_base + dense + 1ul);
    if (start >= end || end > byte_count) return false;
    ulong tag = ig_nullable_word(graph, byte_base + start);
    if (tag != IG_NULLABLE_MIXED_STRING_TAG) {
        value = ulong4(IG_NULLABLE_VALUE_PRESENT_NON_STRING, 0ul, 0ul, 0ul);
        return true;
    }
    ulong string_start = byte_base + start + 1ul;
    ulong string_length = end - start - 1ul;
    if (!ig_nullable_range(string_start, string_length, args.graph_word_count)) return false;
    value = ulong4(IG_NULLABLE_VALUE_STRING,
        IG_NULLABLE_STRING_GRAPH_DIRECT, string_start, string_length);
    return true;
}

inline bool ig_nullable_string_bounds(
    device const long* graph,
    device const long* program,
    constant NullableRelationArgs& args,
    ulong4 value,
    thread ulong& source,
    thread ulong& start,
    thread ulong& end) {
    if (value.x != IG_NULLABLE_VALUE_STRING) return false;
    source = value.y;
    if (source == IG_NULLABLE_STRING_PROGRAM) {
        start = value.z;
        end = start + value.w;
        return end >= start && ig_nullable_range(start, value.w, args.program_word_count);
    }
    if (source == IG_NULLABLE_STRING_GRAPH_DIRECT) {
        start = value.z;
        end = start + value.w;
        return end >= start && ig_nullable_range(start, value.w, args.graph_word_count);
    }
    ulong offset_base = source == IG_NULLABLE_STRING_NODE_DICTIONARY
        ? args.node_string_offset_base
        : (source == IG_NULLABLE_STRING_EDGE_DICTIONARY
            ? args.edge_string_offset_base : ~0ul);
    ulong offset_count = source == IG_NULLABLE_STRING_NODE_DICTIONARY
        ? args.node_string_offset_count
        : (source == IG_NULLABLE_STRING_EDGE_DICTIONARY
            ? args.edge_string_offset_count : 0ul);
    if (offset_base == ~0ul || value.z >= offset_count
        || value.z + 1ul >= offset_count) return false;
    start = ig_nullable_word(graph, offset_base + value.z);
    end = ig_nullable_word(graph, offset_base + value.z + 1ul);
    ulong byte_count = source == IG_NULLABLE_STRING_NODE_DICTIONARY
        ? args.node_string_byte_count : args.edge_string_byte_count;
    return start <= end && end <= byte_count;
}

inline ulong ig_nullable_string_byte(
    device const long* graph,
    device const long* program,
    constant NullableRelationArgs& args,
    ulong source,
    ulong index) {
    if (source == IG_NULLABLE_STRING_PROGRAM) return ig_nullable_word(program, index);
    if (source == IG_NULLABLE_STRING_NODE_DICTIONARY) {
        return ig_nullable_word(graph, args.node_string_byte_base + index);
    }
    if (source == IG_NULLABLE_STRING_EDGE_DICTIONARY) {
        return ig_nullable_word(graph, args.edge_string_byte_base + index);
    }
    if (source == IG_NULLABLE_STRING_GRAPH_DIRECT) {
        return ig_nullable_word(graph, index);
    }
    return ~0ul;
}

inline bool ig_nullable_string_equal(
    device const long* graph,
    device const long* program,
    constant NullableRelationArgs& args,
    ulong4 left,
    ulong4 right,
    thread bool& valid) {
    ulong left_source = 0ul;
    ulong left_start = 0ul;
    ulong left_end = 0ul;
    ulong right_source = 0ul;
    ulong right_start = 0ul;
    ulong right_end = 0ul;
    valid = ig_nullable_string_bounds(
        graph, program, args, left, left_source, left_start, left_end)
        && ig_nullable_string_bounds(
            graph, program, args, right, right_source, right_start, right_end);
    if (!valid || left_end - left_start != right_end - right_start) return false;
    for (ulong byte = 0ul; byte < left_end - left_start; ++byte) {
        ulong left_byte = ig_nullable_string_byte(
            graph, program, args, left_source, left_start + byte);
        ulong right_byte = ig_nullable_string_byte(
            graph, program, args, right_source, right_start + byte);
        if (left_byte > 255ul || right_byte > 255ul) {
            valid = false;
            return false;
        }
        if (left_byte != right_byte) return false;
    }
    return true;
}

inline int ig_nullable_string_order(
    device const long* graph,
    device const long* program,
    constant NullableRelationArgs& args,
    ulong4 left,
    ulong4 right,
    thread bool& valid) {
    ulong left_source = 0ul;
    ulong left_start = 0ul;
    ulong left_end = 0ul;
    ulong right_source = 0ul;
    ulong right_start = 0ul;
    ulong right_end = 0ul;
    valid = ig_nullable_string_bounds(
        graph, program, args, left, left_source, left_start, left_end)
        && ig_nullable_string_bounds(
            graph, program, args, right, right_source, right_start, right_end);
    if (!valid) return 0;
    ulong left_length = left_end - left_start;
    ulong right_length = right_end - right_start;
    ulong common = min(left_length, right_length);
    for (ulong byte = 0ul; byte < common; ++byte) {
        ulong left_byte = ig_nullable_string_byte(
            graph, program, args, left_source, left_start + byte);
        ulong right_byte = ig_nullable_string_byte(
            graph, program, args, right_source, right_start + byte);
        if (left_byte > 255ul || right_byte > 255ul) {
            valid = false;
            return 0;
        }
        if (left_byte < right_byte) return -1;
        if (left_byte > right_byte) return 1;
    }
    if (left_length < right_length) return -1;
    if (left_length > right_length) return 1;
    return 0;
}

inline uint ig_nullable_relationship_endpoint(
    device const long* graph,
    device const long* program,
    device const ulong* output,
    constant NullableRelationArgs& args,
    ulong current_base,
    ulong row,
    ulong current_rows,
    ulong current_width,
    ulong relationship_slot,
    ulong node_slot,
    ulong endpoint,
    ulong overlay_slot0,
    ulong overlay_kind0,
    ulong overlay_dense0,
    ulong overlay_slot1,
    ulong overlay_kind1,
    ulong overlay_dense1) {
    ulong4 relationship;
    ulong4 node;
    if (!ig_nullable_predicate_binding(output, args, current_base, row,
            current_rows, current_width, relationship_slot, 2ul,
            overlay_slot0, overlay_kind0, overlay_dense0,
            overlay_slot1, overlay_kind1, overlay_dense1, relationship)
        || !ig_nullable_predicate_binding(output, args, current_base, row,
            current_rows, current_width, node_slot, 1ul,
            overlay_slot0, overlay_kind0, overlay_dense0,
            overlay_slot1, overlay_kind1, overlay_dense1, node)
        || endpoint < 1ul || endpoint > 3ul) return 3u;
    if (relationship.x == IG_NULLABLE_VALUE_NULL
        || node.x == IG_NULLABLE_VALUE_NULL) return 2u;
    if (ig_nullable_relationship_matches(graph, program, args,
            relationship.y, IG_NULLABLE_RELATION_DOMAIN_ANY, 0ul, 0ul) != 1u
        || ig_nullable_node_matches(graph, program, args,
            node.y, IG_NULLABLE_RELATION_DOMAIN_ANY, 0ul, 0ul) != 1u) return 0u;
    ulong source = ig_nullable_word(
        graph, args.edge_source_base + relationship.y);
    ulong target = ig_nullable_word(
        graph, args.edge_target_base + relationship.y);
    if (source >= args.node_count || target >= args.node_count) return 3u;
    bool matches = endpoint == 1ul ? node.y == source
        : (endpoint == 2ul ? node.y == target
            : (node.y == source || node.y == target));
    return matches ? 1u : 0u;
}

inline uint ig_nullable_evaluate_predicate(
    device const long* graph,
    device const long* program,
    device const ulong* output,
    constant NullableRelationArgs& args,
    ulong first,
    ulong count,
    ulong current_base,
    ulong row,
    ulong current_rows,
    ulong current_width,
    ulong overlay_slot0,
    ulong overlay_kind0,
    ulong overlay_dense0,
    ulong overlay_slot1,
    ulong overlay_kind1,
    ulong overlay_dense1) {
    ulong4 stack[IG_NULLABLE_PREDICATE_STACK];
    uint depth = 0u;
    for (ulong index = 0ul; index < count; ++index) {
        ulong instruction = first + index * IG_NULLABLE_RELATION_PREDICATE_WORDS;
        if (!ig_nullable_range(instruction,
                IG_NULLABLE_RELATION_PREDICATE_WORDS, args.program_word_count)) return 3u;
        ulong opcode = ig_nullable_word(program, instruction);
        ulong4 value = ulong4(0ul);
        bool pushes = true;
        if (opcode == IG_NULLABLE_PREDICATE_NULL) {
            value = ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul);
        } else if (opcode == IG_NULLABLE_PREDICATE_BOOLEAN) {
            ulong boolean = ig_nullable_word(program, instruction + 1ul);
            if (boolean > 1ul) return 3u;
            value = ulong4(IG_NULLABLE_VALUE_BOOLEAN, boolean, 0ul, 0ul);
        } else if (opcode == IG_NULLABLE_PREDICATE_INTEGER) {
            value = ulong4(IG_NULLABLE_VALUE_INTEGER,
                ig_nullable_word(program, instruction + 1ul), 0ul, 0ul);
        } else if (opcode == IG_NULLABLE_PREDICATE_STRING) {
            ulong start = ig_nullable_word(program, instruction + 1ul);
            ulong length = ig_nullable_word(program, instruction + 2ul);
            if (!ig_nullable_range(start, length, args.program_word_count)) return 3u;
            value = ulong4(IG_NULLABLE_VALUE_STRING,
                IG_NULLABLE_STRING_PROGRAM, start, length);
        } else if (opcode == IG_NULLABLE_PREDICATE_BINDING) {
            if (!ig_nullable_predicate_binding(output, args, current_base, row,
                    current_rows, current_width,
                    ig_nullable_word(program, instruction + 1ul),
                    ig_nullable_word(program, instruction + 2ul),
                    overlay_slot0, overlay_kind0, overlay_dense0,
                    overlay_slot1, overlay_kind1, overlay_dense1, value)) return 3u;
        } else if (opcode == IG_NULLABLE_PREDICATE_INTEGER_PROPERTY
                || opcode == IG_NULLABLE_PREDICATE_STRING_PROPERTY) {
            ulong kind = ig_nullable_word(program, instruction + 2ul);
            ulong lane = ig_nullable_word(program, instruction + 3ul);
            ulong global_lane = ig_nullable_word(program, instruction + 4ul);
            ulong4 binding;
            ulong lane_descriptor = ig_nullable_word(program, 15ul)
                + global_lane * IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS;
            ulong expected_shape = opcode == IG_NULLABLE_PREDICATE_INTEGER_PROPERTY
                ? 1ul : 2ul;
            if (global_lane >= ig_nullable_word(program, 10ul)
                || ig_nullable_word(program, lane_descriptor) != kind
                || ig_nullable_word(program, lane_descriptor + 1ul) != expected_shape
                || ig_nullable_word(program, lane_descriptor + 3ul) != lane
                || !ig_nullable_predicate_binding(output, args, current_base, row,
                    current_rows, current_width,
                    ig_nullable_word(program, instruction + 1ul), kind,
                    overlay_slot0, overlay_kind0, overlay_dense0,
                    overlay_slot1, overlay_kind1, overlay_dense1, binding)) return 3u;
            if (binding.x == IG_NULLABLE_VALUE_NULL) {
                value = binding;
            } else {
                bool integer = opcode == IG_NULLABLE_PREDICATE_INTEGER_PROPERTY;
                if (!integer) {
                    if (!ig_nullable_string_property_value(graph, args,
                            kind, lane, global_lane, binding.y, value)) return 3u;
                } else {
                    ulong lane_count = kind == 1ul
                        ? args.node_integer_lane_count
                        : (kind == 2ul ? args.edge_integer_lane_count : 0ul);
                    ulong rows = kind == 1ul ? args.node_count : args.edge_count;
                    ulong values = kind == 1ul
                        ? args.node_integer_value_base : args.edge_integer_value_base;
                    ulong validity = kind == 1ul
                        ? args.node_integer_validity_base : args.edge_integer_validity_base;
                    if (lane >= lane_count || binding.y >= rows) return 3u;
                    ulong present = ig_nullable_word(
                        graph, validity + lane * rows + binding.y);
                    if (present > 1ul) return 3u;
                    value = present == 0ul
                        ? ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul)
                        : ulong4(IG_NULLABLE_VALUE_INTEGER,
                            ig_nullable_word(
                                graph, values + lane * rows + binding.y),
                            0ul, 0ul);
                }
            }
        } else if (opcode == IG_NULLABLE_PREDICATE_HAS_LABELS) {
            ulong4 binding;
            if (!ig_nullable_predicate_binding(output, args, current_base, row,
                    current_rows, current_width,
                    ig_nullable_word(program, instruction + 1ul), 1ul,
                    overlay_slot0, overlay_kind0, overlay_dense0,
                    overlay_slot1, overlay_kind1, overlay_dense1, binding)) return 3u;
            if (binding.x == IG_NULLABLE_VALUE_NULL) {
                value = binding;
            } else {
                ulong domain = ig_nullable_word(program, instruction + 2ul);
                ulong offset = ig_nullable_word(program, instruction + 3ul);
                ulong domain_count = ig_nullable_word(program, instruction + 4ul);
                if (!ig_nullable_domain_valid(
                        program, args, domain, offset, domain_count, true)) return 3u;
                uint matches = ig_nullable_node_matches(
                    graph, program, args, binding.y, domain, offset, domain_count);
                if (matches > 1u) return 3u;
                value = ulong4(IG_NULLABLE_VALUE_BOOLEAN,
                    matches == 1u ? 1ul : 0ul, 0ul, 0ul);
            }
        } else if (opcode == IG_NULLABLE_PREDICATE_RELATIONSHIP_ENDPOINT) {
            uint truth = ig_nullable_relationship_endpoint(
                graph, program, output, args, current_base, row,
                current_rows, current_width,
                ig_nullable_word(program, instruction + 1ul),
                ig_nullable_word(program, instruction + 2ul),
                ig_nullable_word(program, instruction + 3ul),
                overlay_slot0, overlay_kind0, overlay_dense0,
                overlay_slot1, overlay_kind1, overlay_dense1);
            if (truth == 3u) return 3u;
            value = truth == 2u
                ? ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul)
                : ulong4(IG_NULLABLE_VALUE_BOOLEAN, ulong(truth), 0ul, 0ul);
        } else {
            pushes = false;
            if (opcode == IG_NULLABLE_PREDICATE_IS_NULL
                    || opcode == IG_NULLABLE_PREDICATE_NOT) {
                if (depth < 1u) return 3u;
                ulong4 operand = stack[--depth];
                if (opcode == IG_NULLABLE_PREDICATE_IS_NULL) {
                    ulong negated = ig_nullable_word(program, instruction + 1ul);
                    if (negated > 1ul) return 3u;
                    bool is_null = operand.x == IG_NULLABLE_VALUE_NULL;
                    value = ulong4(IG_NULLABLE_VALUE_BOOLEAN,
                        (is_null != (negated != 0ul)) ? 1ul : 0ul, 0ul, 0ul);
                } else {
                    uint truth = ig_nullable_value_truth(operand);
                    if (truth == 3u) return 3u;
                    value = truth == 2u
                        ? ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul)
                        : ulong4(IG_NULLABLE_VALUE_BOOLEAN,
                            truth == 0u ? 1ul : 0ul, 0ul, 0ul);
                }
            } else {
                if (depth < 2u) return 3u;
                ulong4 right = stack[--depth];
                ulong4 left = stack[--depth];
                if (opcode == IG_NULLABLE_PREDICATE_COMPARE_INTEGER) {
                    ulong operation = ig_nullable_word(program, instruction + 1ul);
                    if (left.x == IG_NULLABLE_VALUE_NULL
                        || right.x == IG_NULLABLE_VALUE_NULL) {
                        value = ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul);
                    } else if (left.x == IG_NULLABLE_VALUE_INTEGER
                            && right.x == IG_NULLABLE_VALUE_INTEGER
                            && operation <= 5ul) {
                        bool matches = ig_nullable_compare_integer(
                            as_type<long>(left.y), operation, as_type<long>(right.y));
                        value = ulong4(IG_NULLABLE_VALUE_BOOLEAN,
                            matches ? 1ul : 0ul, 0ul, 0ul);
                    } else if ((left.x == IG_NULLABLE_VALUE_NODE
                                || left.x == IG_NULLABLE_VALUE_RELATIONSHIP)
                            && left.x == right.x && operation <= 1ul) {
                        bool equal = left.y == right.y;
                        value = ulong4(IG_NULLABLE_VALUE_BOOLEAN,
                            equal == (operation == 0ul) ? 1ul : 0ul, 0ul, 0ul);
                    } else return 3u;
                } else if (opcode == IG_NULLABLE_PREDICATE_COMPARE_STRING) {
                    ulong operation = ig_nullable_word(program, instruction + 1ul);
                    if (left.x == IG_NULLABLE_VALUE_NULL
                        || right.x == IG_NULLABLE_VALUE_NULL) {
                        value = ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul);
                    } else if (operation <= 5ul) {
                        bool valid = false;
                        int ordering = ig_nullable_string_order(
                            graph, program, args, left, right, valid);
                        if (!valid) return 3u;
                        bool matches = operation == 0ul ? ordering == 0
                            : (operation == 1ul ? ordering != 0
                                : (operation == 2ul ? ordering < 0
                                    : (operation == 3ul ? ordering <= 0
                                        : (operation == 4ul ? ordering > 0
                                            : ordering >= 0))));
                        value = ulong4(IG_NULLABLE_VALUE_BOOLEAN,
                            matches ? 1ul : 0ul, 0ul, 0ul);
                    } else return 3u;
                } else if (opcode == IG_NULLABLE_PREDICATE_AND
                        || opcode == IG_NULLABLE_PREDICATE_OR) {
                    uint left_truth = ig_nullable_value_truth(left);
                    uint right_truth = ig_nullable_value_truth(right);
                    if (left_truth == 3u || right_truth == 3u) return 3u;
                    uint truth = 2u;
                    if (opcode == IG_NULLABLE_PREDICATE_AND) {
                        truth = left_truth == 0u || right_truth == 0u ? 0u
                            : (left_truth == 1u && right_truth == 1u ? 1u : 2u);
                    } else {
                        truth = left_truth == 1u || right_truth == 1u ? 1u
                            : (left_truth == 0u && right_truth == 0u ? 0u : 2u);
                    }
                    value = truth == 2u
                        ? ulong4(IG_NULLABLE_VALUE_NULL, 0ul, 0ul, 0ul)
                        : ulong4(IG_NULLABLE_VALUE_BOOLEAN, ulong(truth), 0ul, 0ul);
                } else return 3u;
            }
        }
        if (depth >= IG_NULLABLE_PREDICATE_STACK) return 3u;
        stack[depth++] = value;
        (void)pushes;
    }
    return depth == 1u ? ig_nullable_value_truth(stack[0]) : 3u;
}

kernel void ig_nullable_relation_filter_evaluate(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (output[1] != 0ul || step.opcode != IG_NULLABLE_RELATION_STAGE_FILTER
        || step.filter >= args.filter_count || step.stage >= args.stage_count
        || output[args.control_base + 7ul] != IG_NULLABLE_RELATION_GRAPH_VALID) return;
    ulong descriptor = ig_nullable_filter_descriptor(args, step.filter);
    if (ig_nullable_word(program, descriptor) != IG_NULLABLE_RELATION_FILTER_AFTER
        || ig_nullable_word(program, descriptor + 1ul) != step.stage
        || output[args.control_base + 5ul] != step.stage + 1ul) return;
    ulong rows = output[args.control_base + 1ul];
    ulong row = ulong(thread_index);
    if (row >= rows || row >= args.maximum_filter_rows) return;
    ulong width = output[args.control_base + 2ul];
    ulong selector = output[args.control_base + 3ul];
    ulong current_base = selector == 0ul ? args.relation_a_base : args.relation_b_base;
    output[args.filter_truth_base + row] = ulong(ig_nullable_evaluate_predicate(
        graph, program, output, args,
        ig_nullable_word(program, descriptor + 2ul),
        ig_nullable_word(program, descriptor + 3ul),
        current_base, row, rows, width,
        ~0ul, 0ul, 0ul, ~0ul, 0ul, 0ul));
}

kernel void ig_nullable_relation_filter_prefix(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    if (thread_index != 0u || output[1] != 0ul
        || step.opcode != IG_NULLABLE_RELATION_STAGE_FILTER
        || step.filter >= args.filter_count || step.stage >= args.stage_count
        || output[args.control_base + 8ul] != 0ul) return;
    ulong descriptor = ig_nullable_filter_descriptor(args, step.filter);
    ulong rows = output[args.control_base + 1ul];
    if (ig_nullable_word(program, descriptor) != IG_NULLABLE_RELATION_FILTER_AFTER
        || ig_nullable_word(program, descriptor + 1ul) != step.stage
        || rows > args.maximum_filter_rows) {
        output[1] = 2ul;
        return;
    }
    ulong false_rows = 0ul;
    ulong true_rows = 0ul;
    ulong null_rows = 0ul;
    for (ulong row = 0ul; row < rows; ++row) {
        ulong truth = output[args.filter_truth_base + row];
        output[args.filter_rank_base + row] = true_rows;
        if (truth == 0ul) ++false_rows;
        else if (truth == 1ul) ++true_rows;
        else if (truth == 2ul) ++null_rows;
        else {
            output[1] = 2ul;
            return;
        }
    }
    if (true_rows > output[args.control_base + 4ul]) {
        output[1] = 3ul;
        return;
    }
    output[args.control_base + 9ul] = false_rows;
    output[args.control_base + 10ul] = true_rows;
    output[args.control_base + 11ul] = null_rows;
    output[args.control_base + 12ul] = rows;
    output[args.control_base + 8ul] = step.filter + 1ul;
}

kernel void ig_nullable_relation_filter_compact(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    (void)program;
    if (output[1] != 0ul || step.opcode != IG_NULLABLE_RELATION_STAGE_FILTER
        || output[args.control_base + 8ul] != step.filter + 1ul) return;
    ulong rows = output[args.control_base + 12ul];
    ulong row = ulong(thread_index);
    if (row >= rows || output[args.filter_truth_base + row] != 1ul) return;
    ulong width = output[args.control_base + 2ul];
    ulong selector = output[args.control_base + 3ul];
    ulong current_base = selector == 0ul ? args.relation_a_base : args.relation_b_base;
    ulong next_base = selector == 0ul ? args.relation_b_base : args.relation_a_base;
    ulong destination = output[args.filter_rank_base + row];
    if (destination >= output[args.control_base + 10ul]
        || !ig_nullable_copy_row(output, current_base, next_base,
            args.maximum_relation_cells, row, rows, width, destination, width)) {
        output[1] = 2ul;
    }
}

kernel void ig_nullable_relation_filter_commit(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)graph;
    if (thread_index != 0u || output[1] != 0ul
        || step.opcode != IG_NULLABLE_RELATION_STAGE_FILTER
        || step.filter >= args.filter_count
        || output[args.control_base + 8ul] != step.filter + 1ul) return;
    ulong descriptor = ig_nullable_filter_descriptor(args, step.filter);
    ulong input_rows = output[args.control_base + 12ul];
    ulong false_rows = output[args.control_base + 9ul];
    ulong true_rows = output[args.control_base + 10ul];
    ulong null_rows = output[args.control_base + 11ul];
    if (ig_nullable_word(program, descriptor) != IG_NULLABLE_RELATION_FILTER_AFTER
        || ig_nullable_word(program, descriptor + 1ul) != step.stage
        || false_rows + true_rows + null_rows != input_rows
        || ig_nullable_word(program, descriptor + 4ul) == 0ul
        || ig_nullable_word(program, descriptor + 5ul) >= args.receipt_count
        || ig_nullable_word(program, descriptor + 6ul) != 7ul) {
        output[1] = 2ul;
        return;
    }
    ig_nullable_write_receipt(output, args,
        ig_nullable_word(program, descriptor + 5ul),
        ig_nullable_word(program, descriptor + 4ul),
        ig_nullable_word(program, descriptor + 6ul),
        input_rows, false_rows, true_rows, null_rows, true_rows);
    output[args.control_base + 1ul] = true_rows;
    output[args.control_base + 3ul] = 1ul - output[args.control_base + 3ul];
    output[args.control_base + 8ul] = 0ul;
}

inline bool ig_nullable_byte_advance(
    thread ulong& cursor,
    ulong count,
    ulong end,
    thread ulong& base) {
    base = cursor;
    if (cursor > end || count > end - cursor) return false;
    cursor += count;
    return true;
}

inline void ig_nullable_store_u32_le(
    device uchar* bytes,
    ulong base,
    uint value) {
    bytes[base] = uchar(value & 0xffu);
    bytes[base + 1ul] = uchar((value >> 8u) & 0xffu);
    bytes[base + 2ul] = uchar((value >> 16u) & 0xffu);
    bytes[base + 3ul] = uchar((value >> 24u) & 0xffu);
}

inline void ig_nullable_store_u64_le(
    device uchar* bytes,
    ulong base,
    ulong value) {
    for (uint byte = 0u; byte < 8u; ++byte) {
        bytes[base + ulong(byte)] = uchar((value >> (byte * 8u)) & 0xfful);
    }
}

inline bool ig_nullable_ascii_space(ulong byte) {
    return byte == 0x20ul || byte == 0x09ul || byte == 0x0aul
        || byte == 0x0dul || byte == 0x0bul || byte == 0x0cul;
}

// Returns 1 for a converted value, 0 for a well-formed STRING that Cypher converts to NULL, and
// 2 for a corrupt resident string descriptor. Decimal fractions/exponents truncate toward zero;
// all arithmetic remains integer-only so this path has no FP64 device requirement.
inline uint ig_nullable_string_to_i64(
    device const long* graph,
    device const long* program,
    constant NullableRelationArgs& args,
    ulong4 string_value,
    thread ulong& converted) {
    ulong source = 0ul;
    ulong start = 0ul;
    ulong end = 0ul;
    if (!ig_nullable_string_bounds(
            graph, program, args, string_value, source, start, end)) return 2u;
    while (start < end) {
        ulong byte = ig_nullable_string_byte(graph, program, args, source, start);
        if (byte > 255ul) return 2u;
        if (!ig_nullable_ascii_space(byte)) break;
        ++start;
    }
    while (end > start) {
        ulong byte = ig_nullable_string_byte(graph, program, args, source, end - 1ul);
        if (byte > 255ul) return 2u;
        if (!ig_nullable_ascii_space(byte)) break;
        --end;
    }
    if (start == end) return 0u;
    bool negative = false;
    ulong first = ig_nullable_string_byte(graph, program, args, source, start);
    if (first > 255ul) return 2u;
    if (first == ulong('+') || first == ulong('-')) {
        negative = first == ulong('-');
        ++start;
    }
    if (start == end) return 0u;

    ulong mantissa_start = start;
    ulong mantissa_end = end;
    bool seen_dot = false;
    long digit_count = 0L;
    long fractional_digits = 0L;
    ulong position = start;
    bool has_exponent = false;
    while (position < end) {
        ulong byte = ig_nullable_string_byte(graph, program, args, source, position);
        if (byte > 255ul) return 2u;
        if (byte >= ulong('0') && byte <= ulong('9')) {
            ++digit_count;
            if (seen_dot) ++fractional_digits;
        } else if (byte == ulong('.') && !seen_dot) {
            seen_dot = true;
        } else if (byte == ulong('e') || byte == ulong('E')) {
            mantissa_end = position;
            ++position;
            has_exponent = true;
            break;
        } else {
            return 0u;
        }
        ++position;
    }
    if (digit_count == 0L) return 0u;

    long exponent = 0L;
    if (has_exponent) {
        bool exponent_negative = false;
        if (position < end) {
            ulong byte = ig_nullable_string_byte(graph, program, args, source, position);
            if (byte > 255ul) return 2u;
            if (byte == ulong('+') || byte == ulong('-')) {
                exponent_negative = byte == ulong('-');
                ++position;
            }
        }
        if (position == end) return 0u;
        long magnitude = 0L;
        while (position < end) {
            ulong byte = ig_nullable_string_byte(graph, program, args, source, position);
            if (byte > 255ul) return 2u;
            if (byte < ulong('0') || byte > ulong('9')) return 0u;
            if (magnitude < 1000000L) {
                magnitude = min(1000000L, magnitude * 10L + long(byte - ulong('0')));
            }
            ++position;
        }
        exponent = exponent_negative ? -magnitude : magnitude;
    }

    long integer_digits = digit_count - fractional_digits + exponent;
    if (integer_digits <= 0L) {
        converted = 0ul;
        return 1u;
    }
    ulong limit = negative ? 0x8000000000000000ul : 0x7ffffffffffffffful;
    long source_digits = min(integer_digits, digit_count);
    long consumed = 0L;
    ulong magnitude = 0ul;
    for (ulong index = mantissa_start;
            index < mantissa_end && consumed < source_digits;
            ++index) {
        ulong byte = ig_nullable_string_byte(graph, program, args, source, index);
        if (byte > 255ul) return 2u;
        if (byte < ulong('0') || byte > ulong('9')) continue;
        ulong digit = byte - ulong('0');
        if (magnitude > (limit - digit) / 10ul) return 0u;
        magnitude = magnitude * 10ul + digit;
        ++consumed;
    }
    long extra_zeros = integer_digits - digit_count;
    if (magnitude != 0ul) {
        if (extra_zeros > 19L) return 0u;
        for (long index = 0L; index < extra_zeros; ++index) {
            if (magnitude > limit / 10ul) return 0u;
            magnitude *= 10ul;
        }
    }
    converted = negative ? (0ul - magnitude) : magnitude;
    return 1u;
}

inline ulong ig_nullable_write_i64(
    device uchar* output_bytes,
    ulong output_base,
    ulong bits) {
    bool negative = (bits >> 63ul) != 0ul;
    ulong magnitude = negative ? (0ul - bits) : bits;
    uchar reversed[20];
    ulong length = 0ul;
    do {
        reversed[length++] = uchar('0') + uchar(magnitude % 10ul);
        magnitude /= 10ul;
    } while (magnitude != 0ul && length < IG_NULLABLE_INTEGER_STRING_MAXIMUM_BYTES);
    if (negative) reversed[length++] = uchar('-');
    for (ulong index = 0ul; index < length; ++index) {
        output_bytes[output_base + index] = reversed[length - index - 1ul];
    }
    return length;
}

kernel void ig_nullable_relation_final_project(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    constant NullableRelationStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    ulong stage = step.stage;
    ulong token = ((stage + 1ul) << IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT)
        | (IG_NULLABLE_RELATION_STAGE_FINAL_PROJECT
            << IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT);
    if (stage >= args.stage_count
        || step.opcode != IG_NULLABLE_RELATION_STAGE_FINAL_PROJECT
        || output[args.control_base + 8ul] != (token | 3ul)) {
        output[1] = 2ul;
        return;
    }
    ulong descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
    ulong input_rows = output[args.control_base + 1ul];
    ulong current_width = output[args.control_base + 2ul];
    ulong current_selector = output[args.control_base + 3ul];
    ulong candidate_capacity = ig_nullable_word(program, descriptor + 19ul);
    ulong output_capacity = ig_nullable_word(program, descriptor + 20ul);
    ulong expected_width = ig_nullable_word(program, descriptor + 21ul);
    ulong obligation_id = ig_nullable_word(program, descriptor + 15ul);
    ulong obligation_kind = ig_nullable_word(program, descriptor + 17ul);
    ulong current_base = current_selector == 0ul
        ? args.relation_a_base : args.relation_b_base;
    ulong payload_offset = ig_nullable_word(program, descriptor + 13ul);
    ulong binding_count = ig_nullable_word(program, descriptor + 14ul);
    ulong payload_words = 0ul;
    if (obligation_kind != 6ul || stage + 1ul != args.stage_count
        || output[args.control_base + 6ul] != 0ul
        || binding_count != args.final_output_columns
        || current_width != expected_width
        || !ig_nullable_product(binding_count,
            IG_NULLABLE_RELATION_OUTPUT_SOURCE_WORDS, payload_words)
        || !ig_nullable_range(payload_offset, payload_words, args.program_word_count)) {
        output[1] = 2ul;
        return;
    }
    if (input_rows > args.maximum_output_rows
        || input_rows > output_capacity
        || input_rows > candidate_capacity) {
        output[1] = 3ul;
        return;
    }
    if (args.final_base > ~0ul / 8ul) {
        output[1] = 2ul;
        return;
    }
    ulong packet_start = args.final_base * 8ul;
    if (packet_start > ~0ul - args.final_byte_count) {
        output[1] = 2ul;
        return;
    }
    ulong packet_end = packet_start + args.final_byte_count;
    ulong output_bytes_count = args.output_word_count * 8ul;
    if (packet_end > output_bytes_count) {
        output[1] = 2ul;
        return;
    }
    device uchar* output_bytes = reinterpret_cast<device uchar*>(output);
    ulong cursor = packet_start;
    for (ulong column = 0ul; column < binding_count; ++column) {
        ulong source_descriptor = payload_offset
            + column * IG_NULLABLE_RELATION_OUTPUT_SOURCE_WORDS;
        ulong source_type = ig_nullable_word(program, source_descriptor);
        ulong source_slot = ig_nullable_word(program, source_descriptor + 1ul);
        ulong source_kind = ig_nullable_word(program, source_descriptor + 2ul);
        ulong property_lane = ig_nullable_word(program, source_descriptor + 3ul);
        ulong global_lane = ig_nullable_word(program, source_descriptor + 4ul);
        ulong property = ig_nullable_word(program, source_descriptor + 5ul);
        ulong maximum_bytes = ig_nullable_word(program, source_descriptor + 6ul);
        bool entity = source_type == IG_NULLABLE_OUTPUT_ENTITY;
        bool integer = source_type == IG_NULLABLE_OUTPUT_INTEGER_PROPERTY;
        bool floating = source_type == IG_NULLABLE_OUTPUT_FLOAT_PROPERTY;
        bool string = source_type == IG_NULLABLE_OUTPUT_STRING_PROPERTY;
        bool null_property = source_type == IG_NULLABLE_OUTPUT_NULL_PROPERTY;
        bool relationship_type = source_type == IG_NULLABLE_OUTPUT_RELATIONSHIP_TYPE;
        bool entity_label_predicate =
            source_type == IG_NULLABLE_OUTPUT_ENTITY_LABEL_PREDICATE;
        bool string_to_integer =
            source_type == IG_NULLABLE_OUTPUT_STRING_PROPERTY_TO_INTEGER;
        bool integer_to_float =
            source_type == IG_NULLABLE_OUTPUT_INTEGER_PROPERTY_TO_FLOAT;
        bool integer_to_string =
            source_type == IG_NULLABLE_OUTPUT_INTEGER_PROPERTY_TO_STRING;
        bool integer_output = integer || string_to_integer;
        bool float_output = floating || integer_to_float;
        bool string_output = string || integer_to_string;
        bool integer_property = integer || integer_to_float || integer_to_string;
        bool float_property = floating;
        bool string_property = string || string_to_integer;
        bool property_source = integer_property || float_property || string_property;
        if ((!entity && !integer && !floating && !string
                && !string_to_integer && !integer_to_float && !integer_to_string
                && !null_property && !relationship_type && !entity_label_predicate)
            || source_slot >= args.binding_slot_count
            || (source_kind != 1ul && source_kind != 2ul)
            || (!property_source && !entity_label_predicate
                && (property_lane != ~0ul || global_lane != ~0ul
                    || property != ~0ul || maximum_bytes != 0ul))
            || (relationship_type && source_kind != 2ul)
            || ((integer_output || float_output) && maximum_bytes != 0ul)
            || (integer_to_string
                && maximum_bytes != IG_NULLABLE_INTEGER_STRING_MAXIMUM_BYTES)
            || (property_source && (property == ~0ul
                || global_lane >= ig_nullable_word(program, 10ul)))
            || (entity_label_predicate
                && (maximum_bytes != 0ul
                    || property_lane == IG_NULLABLE_RELATION_DOMAIN_ANY
                    || !ig_nullable_domain_valid(program, args,
                        property_lane, global_lane, property, source_kind == 1ul)
                    || (source_kind == 2ul
                        && property_lane == IG_NULLABLE_RELATION_DOMAIN_KNOWN
                        && property != 1ul)))) {
            output[1] = 2ul;
            return;
        }
        if (property_source) {
            ulong lane_descriptor = ig_nullable_word(program, 15ul)
                + global_lane * IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS;
            ulong expected_shape = integer_property ? 1ul : (string_property ? 2ul : 3ul);
            if (ig_nullable_word(program, lane_descriptor) != source_kind
                || ig_nullable_word(program, lane_descriptor + 1ul) != expected_shape
                || ig_nullable_word(program, lane_descriptor + 2ul) != property
                || ig_nullable_word(program, lane_descriptor + 3ul) != property_lane) {
                output[1] = 2ul;
                return;
            }
        }
        ulong source_entry = output[args.slot_map_base + source_slot];
        if (!ig_nullable_slot_present(source_entry)
            || ig_nullable_slot_kind(source_entry) != source_kind
            || ig_nullable_slot_column(source_entry) >= current_width) {
            output[1] = 2ul;
            return;
        }
        ulong graph_rows = source_kind == 1ul ? args.node_count : args.edge_count;
        ulong lane_count = source_kind == 1ul
            ? (integer_property ? args.node_integer_lane_count
                : (float_property ? args.node_float_lane_count : args.node_string_lane_count))
            : (integer_property ? args.edge_integer_lane_count
                : (float_property ? args.edge_float_lane_count : args.edge_string_lane_count));
        if (property_source && property_lane >= lane_count) {
            output[1] = 2ul;
            return;
        }
        ulong source_bytes = 0ul;
        if (!ig_nullable_product(args.maximum_output_rows, 4ul, source_bytes)) {
            output[1] = 2ul;
            return;
        }
        ulong source_rows_base = 0ul;
        if (!ig_nullable_byte_advance(
                cursor, source_bytes, packet_end, source_rows_base)) {
            output[1] = 2ul;
            return;
        }
        ulong values_or_offsets_base = ~0ul;
        ulong bytes_base = ~0ul;
        ulong validity_base = ~0ul;
        if (integer_output || float_output || relationship_type) {
            ulong value_bytes = 0ul;
            if (!ig_nullable_product(args.maximum_output_rows, 8ul, value_bytes)
                || !ig_nullable_byte_advance(
                    cursor, value_bytes, packet_end, values_or_offsets_base)) {
                output[1] = 2ul;
                return;
            }
            if ((integer_output || float_output) && !ig_nullable_byte_advance(
                    cursor, args.maximum_output_rows, packet_end, validity_base)) {
                output[1] = 2ul;
                return;
            }
        } else if (entity_label_predicate) {
            if (!ig_nullable_byte_advance(
                    cursor, args.maximum_output_rows, packet_end, values_or_offsets_base)
                || !ig_nullable_byte_advance(
                    cursor, args.maximum_output_rows, packet_end, validity_base)) {
                output[1] = 2ul;
                return;
            }
        } else if (string_output) {
            if (args.maximum_output_rows == ~0ul) {
                output[1] = 2ul;
                return;
            }
            ulong offset_bytes = 0ul;
            ulong arena_bytes = 0ul;
            if (!ig_nullable_product(args.maximum_output_rows + 1ul, 4ul, offset_bytes)
                || !ig_nullable_product(
                    args.maximum_output_rows, maximum_bytes, arena_bytes)
                || !ig_nullable_byte_advance(
                    cursor, offset_bytes, packet_end, values_or_offsets_base)
                || !ig_nullable_byte_advance(
                    cursor, arena_bytes, packet_end, bytes_base)
                || !ig_nullable_byte_advance(
                    cursor, args.maximum_output_rows, packet_end, validity_base)) {
                output[1] = 2ul;
                return;
            }
        }
        ulong descriptor_base = args.column_base
            + column * IG_NULLABLE_RELATION_COLUMN_WORDS;
        output[descriptor_base] = source_slot;
        output[descriptor_base + 1ul] = source_kind;
        output[descriptor_base + 2ul] = source_type;
        output[descriptor_base + 3ul] = entity_label_predicate
            ? property_lane : property;
        output[descriptor_base + 4ul] = entity_label_predicate
            ? property : maximum_bytes;
        output[descriptor_base + 5ul] = source_rows_base;
        output[descriptor_base + 6ul] = values_or_offsets_base;
        output[descriptor_base + 7ul] = bytes_base;
        output[descriptor_base + 8ul] = validity_base;
        output[descriptor_base + 9ul] = cursor;
        ulong source_column = ig_nullable_slot_column(source_entry);
        for (ulong row = 0ul; row < input_rows; ++row) {
            ulong dense = output[current_base + row * current_width + source_column];
            if (dense != IG_NULLABLE_RELATION_NULL_ROW && dense >= graph_rows) {
                output[1] = 2ul;
                return;
            }
            ig_nullable_store_u32_le(output_bytes,
                source_rows_base + row * 4ul, uint(dense));
        }
        if (integer || floating || integer_to_float) {
            ulong graph_values = source_kind == 1ul
                ? (integer_property ? args.node_integer_value_base : args.node_float_value_base)
                : (integer_property ? args.edge_integer_value_base : args.edge_float_value_base);
            ulong graph_validity = source_kind == 1ul
                ? (integer_property ? args.node_integer_validity_base : args.node_float_validity_base)
                : (integer_property ? args.edge_integer_validity_base : args.edge_float_validity_base);
            for (ulong row = 0ul; row < input_rows; ++row) {
                ulong dense = output[current_base + row * current_width + source_column];
                ulong value = 0ul;
                ulong valid = 0ul;
                if (dense != IG_NULLABLE_RELATION_NULL_ROW) {
                    valid = ig_nullable_word(graph,
                        graph_validity + property_lane * graph_rows + dense);
                    if (valid > 1ul) {
                        output[1] = 2ul;
                        return;
                    }
                    if (valid != 0ul) {
                        value = ig_nullable_word(graph,
                            graph_values + property_lane * graph_rows + dense);
                        if (floating && (ig_scalar_program_f64_is_nan(value)
                                || ig_scalar_program_f64_is_infinite(value))) {
                            output[1] = 2ul;
                            return;
                        }
                        if (integer_to_float) {
                            value = ig_scalar_program_i64_to_f64(value);
                        }
                    }
                }
                ig_nullable_store_u64_le(
                    output_bytes, values_or_offsets_base + row * 8ul, value);
                output_bytes[validity_base + row] = uchar(valid);
            }
        } else if (string_to_integer) {
            for (ulong row = 0ul; row < input_rows; ++row) {
                ulong dense = output[current_base + row * current_width + source_column];
                ulong value = 0ul;
                ulong valid = 0ul;
                if (dense != IG_NULLABLE_RELATION_NULL_ROW) {
                    ulong4 string_value;
                    if (!ig_nullable_string_property_value(graph, args,
                            source_kind, property_lane, global_lane,
                            dense, string_value)) {
                        output[1] = 2ul;
                        return;
                    }
                    if (string_value.x == IG_NULLABLE_VALUE_STRING) {
                        uint status = ig_nullable_string_to_i64(
                            graph, program, args, string_value, value);
                        if (status == 2u) {
                            output[1] = 2ul;
                            return;
                        }
                        valid = status == 1u ? 1ul : 0ul;
                    } else if (string_value.x != IG_NULLABLE_VALUE_NULL) {
                        output[1] = 2ul;
                        return;
                    }
                }
                ig_nullable_store_u64_le(
                    output_bytes, values_or_offsets_base + row * 8ul, value);
                output_bytes[validity_base + row] = uchar(valid);
            }
        } else if (entity_label_predicate) {
            for (ulong row = 0ul; row < input_rows; ++row) {
                ulong dense = output[current_base + row * current_width + source_column];
                ulong value = 0ul;
                ulong valid = 0ul;
                if (dense != IG_NULLABLE_RELATION_NULL_ROW) {
                    uint matches = source_kind == 1ul
                        ? ig_nullable_node_matches(graph, program, args, dense,
                            property_lane, global_lane, property)
                        : ig_nullable_relationship_matches(graph, program, args, dense,
                            property_lane, global_lane, property);
                    if (matches > 1u) {
                        output[1] = 2ul;
                        return;
                    }
                    value = matches == 1u ? 1ul : 0ul;
                    valid = 1ul;
                }
                output_bytes[values_or_offsets_base + row] = uchar(value);
                output_bytes[validity_base + row] = uchar(valid);
            }
        } else if (relationship_type) {
            for (ulong row = 0ul; row < input_rows; ++row) {
                ulong dense = output[current_base + row * current_width + source_column];
                ulong token = dense == IG_NULLABLE_RELATION_NULL_ROW
                    ? 0ul : ig_nullable_word(graph, args.edge_type_base + dense);
                ig_nullable_store_u64_le(
                    output_bytes, values_or_offsets_base + row * 8ul, token);
            }
        } else if (string) {
            ulong arena_capacity = args.maximum_output_rows * maximum_bytes;
            ulong byte_cursor = 0ul;
            ig_nullable_store_u32_le(output_bytes, values_or_offsets_base, 0u);
            for (ulong row = 0ul; row < input_rows; ++row) {
                ulong dense = output[current_base + row * current_width + source_column];
                ulong valid = 0ul;
                if (dense != IG_NULLABLE_RELATION_NULL_ROW) {
                    ulong4 string_value;
                    if (!ig_nullable_string_property_value(graph, args,
                            source_kind, property_lane, global_lane,
                            dense, string_value)) {
                        output[1] = 2ul;
                        return;
                    }
                    if (string_value.x == IG_NULLABLE_VALUE_STRING) {
                        valid = 1ul;
                        ulong string_source = 0ul;
                        ulong string_start = 0ul;
                        ulong string_end = 0ul;
                        if (!ig_nullable_string_bounds(graph, program, args,
                                string_value, string_source, string_start, string_end)) {
                            output[1] = 2ul;
                            return;
                        }
                        ulong length = string_end - string_start;
                        if (length > maximum_bytes || byte_cursor > arena_capacity
                            || length > arena_capacity - byte_cursor) {
                            output[1] = 2ul;
                            return;
                        }
                        for (ulong byte = 0ul; byte < length; ++byte) {
                            ulong value = ig_nullable_string_byte(graph, program, args,
                                string_source, string_start + byte);
                            if (value > 255ul) {
                                output[1] = 2ul;
                                return;
                            }
                            output_bytes[bytes_base + byte_cursor + byte] = uchar(value);
                        }
                        byte_cursor += length;
                    } else if (string_value.x != IG_NULLABLE_VALUE_NULL) {
                        output[1] = 2ul;
                        return;
                    }
                }
                output_bytes[validity_base + row] = uchar(valid);
                ig_nullable_store_u32_le(output_bytes,
                    values_or_offsets_base + (row + 1ul) * 4ul, uint(byte_cursor));
            }
        } else if (integer_to_string) {
            ulong arena_capacity = args.maximum_output_rows * maximum_bytes;
            ulong byte_cursor = 0ul;
            ulong graph_values = source_kind == 1ul
                ? args.node_integer_value_base : args.edge_integer_value_base;
            ulong graph_validity = source_kind == 1ul
                ? args.node_integer_validity_base : args.edge_integer_validity_base;
            ig_nullable_store_u32_le(output_bytes, values_or_offsets_base, 0u);
            for (ulong row = 0ul; row < input_rows; ++row) {
                ulong dense = output[current_base + row * current_width + source_column];
                ulong valid = 0ul;
                if (dense != IG_NULLABLE_RELATION_NULL_ROW) {
                    valid = ig_nullable_word(graph,
                        graph_validity + property_lane * graph_rows + dense);
                    if (valid > 1ul) {
                        output[1] = 2ul;
                        return;
                    }
                    if (valid != 0ul) {
                        ulong value = ig_nullable_word(graph,
                            graph_values + property_lane * graph_rows + dense);
                        if (byte_cursor > arena_capacity
                            || maximum_bytes > arena_capacity - byte_cursor) {
                            output[1] = 2ul;
                            return;
                        }
                        ulong length = ig_nullable_write_i64(
                            output_bytes, bytes_base + byte_cursor, value);
                        if (length == 0ul || length > maximum_bytes) {
                            output[1] = 2ul;
                            return;
                        }
                        byte_cursor += length;
                    }
                }
                output_bytes[validity_base + row] = uchar(valid);
                ig_nullable_store_u32_le(output_bytes,
                    values_or_offsets_base + (row + 1ul) * 4ul, uint(byte_cursor));
            }
        }
    }
    if (cursor != packet_end) {
        output[1] = 2ul;
        return;
    }
    ig_nullable_commit_stage(output, args, stage,
        ig_nullable_word(program, descriptor + 16ul), obligation_id, obligation_kind,
        input_rows, current_selector, output_capacity,
        input_rows, input_rows, 0ul,
        input_rows, current_width, false);
    output[args.control_base + 6ul] = 1ul;
    output[21] = input_rows;
}

struct IgCsrResolvedRow {
    uint begin;
    uint end;
    uint overlay;
};

// Resolve a complete replacement row before the immutable cold CSR. One compact packet stores
// [row ids K][offsets K+1][neighbors M][edge ids M]. Binary search makes lookup logarithmic in
// changed rows while an empty overlay takes the original two offset loads.
inline bool ig_csr_resolve_row(
    device const uint* base_offsets,
    ulong base_entry_count,
    device const uint* overlay,
    uint overlay_count,
    uint row,
    thread IgCsrResolvedRow& resolved) {
    if (overlay_count != 0u) {
        uint low = 0u;
        uint high = overlay_count;
        while (low < high) {
            uint middle = low + ((high - low) >> 1u);
            if (overlay[middle] < row) low = middle + 1u;
            else high = middle;
        }
        if (low < overlay_count && overlay[low] == row) {
            uint payload_count = overlay[2u * overlay_count];
            uint begin = overlay[overlay_count + low];
            uint end = overlay[overlay_count + low + 1u];
            if (begin > end || ulong(end) > ulong(payload_count)) return false;
            resolved = IgCsrResolvedRow{begin, end, 1u};
            return true;
        }
    }
    uint begin = base_offsets[row];
    uint end = base_offsets[row + 1u];
    if (begin > end || ulong(end) > base_entry_count) return false;
    resolved = IgCsrResolvedRow{begin, end, 0u};
    return true;
}

inline uint ig_csr_resolved_neighbor(
    device const uint* base_neighbors,
    device const uint* overlay,
    uint overlay_count,
    IgCsrResolvedRow row,
    uint position) {
    if (row.overlay == 0u) return base_neighbors[position];
    return overlay[2u * overlay_count + 1u + position];
}

inline uint ig_csr_resolved_edge(
    device const uint* base_edges,
    device const uint* overlay,
    uint overlay_count,
    IgCsrResolvedRow row,
    uint position) {
    if (row.overlay == 0u) return base_edges[position];
    uint payload_count = overlay[2u * overlay_count];
    return overlay[2u * overlay_count + 1u + payload_count + position];
}

kernel void ig_nullable_relation_publish(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 0ul) return;
    if (output[args.control_base] != IG_NULLABLE_RELATION_CONTROL_MAGIC
        || output[args.control_base + 5ul] != args.stage_count
        || output[args.control_base + 6ul] != 1ul
        || output[args.control_base + 7ul] != IG_NULLABLE_RELATION_GRAPH_VALID
        || output[args.control_base + 8ul] != 0ul
        || output[args.control_base + 1ul] != output[21]
        || output[21] > args.maximum_output_rows) {
        output[1] = output[21] > args.maximum_output_rows ? 3ul : 2ul;
        return;
    }
    output[1] = 1ul;
}

constant ulong IG_PATTERN_PREDICATE_MAGIC = 0x4947504154544552ul;
constant uint IG_PATTERN_PACKET_HEADER_WORDS = 6;
constant uint IG_PATTERN_LEAF_WORDS = 11;
constant uint IG_PATTERN_INSTRUCTION_WORDS = 2;
constant uint IG_PATTERN_FRAME_HEADER_WORDS = 12;
constant uint IG_PATTERN_RECEIPT_WORDS = 9;
constant uint IG_PATTERN_MAX_LEAVES = 64;
constant uint IG_PATTERN_MAX_INSTRUCTIONS = 256;

struct PatternPredicateArgs {
    ulong execution_high;
    ulong execution_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong scan_obligation_id;
    ulong row_count;
    ulong output_word_count;
    uint node_count;
    uint edge_count;
    uint leaf_count;
    uint instruction_count;
    uint packet_word_count;
    uint layer_mask;
    uint output_capacity;
    uint receipt_count;
    uint source_mode;
    uint outgoing_overlay_count;
    uint incoming_overlay_count;
    uint reserved;
};

inline ulong ig_pattern_word(device const long* packet, ulong index) {
    return as_type<ulong>(packet[index]);
}

inline bool ig_pattern_packet_is_valid(
    device const long* packet,
    constant PatternPredicateArgs& args) {
    if (args.leaf_count == 0 || args.leaf_count > IG_PATTERN_MAX_LEAVES
        || args.instruction_count == 0
        || args.instruction_count > IG_PATTERN_MAX_INSTRUCTIONS
        || args.source_mode > 1
        || args.reserved != 0
        || args.receipt_count != args.leaf_count + 1 + (args.source_mode == 1 ? 1 : 0)
        || (args.source_mode == 0 && args.scan_obligation_id != 0)
        || (args.source_mode == 1
            && (args.scan_obligation_id == 0 || args.row_count != args.node_count))) {
        return false;
    }
    ulong leaf_words = ulong(args.leaf_count) * IG_PATTERN_LEAF_WORDS;
    ulong instruction_words = ulong(args.instruction_count)
        * IG_PATTERN_INSTRUCTION_WORDS;
    ulong type_count = ig_pattern_word(packet, 3);
    ulong property_count = ig_pattern_word(packet, 4);
    ulong expected_words = IG_PATTERN_PACKET_HEADER_WORDS
        + leaf_words + instruction_words + type_count + property_count;
    return ig_pattern_word(packet, 0) == 2
        && ig_pattern_word(packet, 1) == args.leaf_count
        && ig_pattern_word(packet, 2) == args.instruction_count
        && property_count <= ulong(args.leaf_count) * 2ul
        && expected_words == args.packet_word_count;
}

inline uint ig_pattern_relationship_matches(
    device const long* packet,
    device const long* edge_types,
    uint edge,
    uint type_mode,
    ulong type_start,
    ulong type_count,
    ulong packet_type_base,
    ulong packet_type_total) {
    if (type_mode == 0) return type_count == 0 ? 1 : 2;
    if (type_mode == 2) return type_count == 0 ? 0 : 2;
    if (type_mode != 1 || type_count == 0
        || type_start > packet_type_total
        || type_count > packet_type_total - type_start) {
        return 2;
    }
    ulong relationship_type = as_type<ulong>(edge_types[edge]);
    for (ulong index = 0; index < type_count; ++index) {
        if (ig_pattern_word(packet, packet_type_base + type_start + index)
            == relationship_type) {
            return 1;
        }
    }
    return 0;
}

// Returns 0 for an invisible/non-matching edge, 1 for a valid edge, and 2 for corrupt resident
// input. Checking the neighbor here makes the same helper valid for both intermediate and final
// nodes of an exact-two path.
inline uint ig_pattern_visible_typed_edge(
    device const long* packet,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint neighbor,
    uint edge,
    uint type_mode,
    ulong type_start,
    ulong type_count,
    ulong packet_type_base,
    ulong packet_type_total,
    constant PatternPredicateArgs& args) {
    if (neighbor >= args.node_count || edge >= args.edge_count) return 2;
    uchar neighbor_active = node_active[neighbor];
    uchar relationship_active = edge_active[edge];
    uchar neighbor_layer = node_layers[neighbor];
    uchar relationship_layer = edge_layers[edge];
    if (neighbor_active > 1 || relationship_active > 1
        || neighbor_layer > int(IG_MAX_LAYER) || relationship_layer > int(IG_MAX_LAYER)) {
        return 2;
    }
    if (neighbor_active == 0 || relationship_active == 0
        || (args.layer_mask & (1u << uint(neighbor_layer))) == 0
        || (args.layer_mask & (1u << uint(relationship_layer))) == 0) {
        return 0;
    }
    return ig_pattern_relationship_matches(
        packet,
        edge_types,
        edge,
        type_mode,
        type_start,
        type_count,
        packet_type_base,
        packet_type_total);
}

// Returns 0 for NULL/unequal properties, 1 for equal INTEGER properties, and 2 for a corrupt
// lane. The bank is property-major and contains the complete resident node domain.
inline uint ig_pattern_property_equality_matches(
    device const long* property_values,
    device const uchar* property_validity,
    uint source,
    uint neighbor,
    ulong start_lane,
    ulong end_lane,
    ulong property_lane_count,
    constant PatternPredicateArgs& args) {
    if (source >= args.node_count || neighbor >= args.node_count
        || start_lane >= property_lane_count || end_lane >= property_lane_count) {
        return 2;
    }
    ulong start_index = start_lane * ulong(args.node_count) + ulong(source);
    ulong end_index = end_lane * ulong(args.node_count) + ulong(neighbor);
    uchar start_valid = property_validity[start_index];
    uchar end_valid = property_validity[end_index];
    if (start_valid > 1 || end_valid > 1) return 2;
    if (start_valid == 0 || end_valid == 0) return 0;
    return property_values[start_index] == property_values[end_index] ? 1 : 0;
}

// Returns 0 for no witness, 1 for a witness, and 2 for corrupt resident input. `exclude_edge`
// enforces different-relationship path semantics for the second hop of an exact-two leaf.
inline uint ig_pattern_probe_adjacency(
    device const long* packet,
    device const uint* offsets,
    device const uint* neighbors,
    device const uint* adjacency_edges,
    device const uint* overlay,
    uint overlay_count,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint source,
    uint excluded_edge,
    uint exclude_edge,
    uint type_mode,
    ulong type_start,
    ulong type_count,
    ulong packet_type_base,
    ulong packet_type_total,
    constant PatternPredicateArgs& args) {
    if (source >= args.node_count) return 2;
    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(
            offsets, args.edge_count, overlay, overlay_count, source, row)) return 2;
    for (uint offset = row.begin; offset < row.end; ++offset) {
        uint neighbor = ig_csr_resolved_neighbor(
            neighbors, overlay, overlay_count, row, offset);
        uint edge = ig_csr_resolved_edge(
            adjacency_edges, overlay, overlay_count, row, offset);
        if (exclude_edge != 0 && edge == excluded_edge) continue;
        uint matches = ig_pattern_visible_typed_edge(
            packet,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            neighbor,
            edge,
            type_mode,
            type_start,
            type_count,
            packet_type_base,
            packet_type_total,
            args);
        if (matches != 0) return matches;
    }
    return 0;
}

// Counts qualifying physical relationships in one CSR orientation. Status 1 means the caller's
// deterministic early-stop threshold was reached; status 2 reports corrupt resident input.
inline uint ig_pattern_count_adjacency(
    device const long* packet,
    device const uint* offsets,
    device const uint* neighbors,
    device const uint* adjacency_edges,
    device const uint* overlay,
    uint overlay_count,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    device const long* property_values,
    device const uchar* property_validity,
    uint source,
    bool skip_self_loops,
    uint type_mode,
    ulong type_start,
    ulong type_count,
    ulong packet_type_base,
    ulong packet_type_total,
    uint property_mode,
    ulong start_property_lane,
    ulong end_property_lane,
    ulong property_lane_count,
    ulong stop_at,
    constant PatternPredicateArgs& args,
    thread ulong& witnesses) {
    if (source >= args.node_count) return 2;
    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(
            offsets, args.edge_count, overlay, overlay_count, source, row)) return 2;
    for (uint offset = row.begin; offset < row.end; ++offset) {
        uint neighbor = ig_csr_resolved_neighbor(
            neighbors, overlay, overlay_count, row, offset);
        uint edge = ig_csr_resolved_edge(
            adjacency_edges, overlay, overlay_count, row, offset);
        if (skip_self_loops && neighbor == source) continue;
        uint matches = ig_pattern_visible_typed_edge(
            packet,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            neighbor,
            edge,
            type_mode,
            type_start,
            type_count,
            packet_type_base,
            packet_type_total,
            args);
        if (matches == 2) return 2;
        if (matches == 0) continue;
        if (property_mode == 1) {
            matches = ig_pattern_property_equality_matches(
                property_values,
                property_validity,
                source,
                neighbor,
                start_property_lane,
                end_property_lane,
                property_lane_count,
                args);
            if (matches == 2) return 2;
            if (matches == 0) continue;
        }
        ++witnesses;
        if (witnesses >= stop_at) return 1;
    }
    return 0;
}

// Probes one CSR orientation for the first hop, then follows the leaf direction for the second.
// A physical relationship used by the first hop is excluded from both second-hop orientations.
inline uint ig_pattern_probe_exact_two_first_adjacency(
    device const long* packet,
    device const uint* first_offsets,
    device const uint* first_neighbors,
    device const uint* first_edges,
    device const uint* first_overlay,
    uint first_overlay_count,
    device const uint* outgoing_offsets,
    device const uint* outgoing_neighbors,
    device const uint* outgoing_edges,
    device const uint* outgoing_overlay,
    uint outgoing_overlay_count,
    device const uint* incoming_offsets,
    device const uint* incoming_neighbors,
    device const uint* incoming_edges,
    device const uint* incoming_overlay,
    uint incoming_overlay_count,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint source,
    uint direction,
    uint type_mode,
    ulong type_start,
    ulong type_count,
    ulong packet_type_base,
    ulong packet_type_total,
    constant PatternPredicateArgs& args) {
    if (source >= args.node_count) return 2;
    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(
            first_offsets, args.edge_count, first_overlay, first_overlay_count, source, row)) {
        return 2;
    }
    for (uint offset = row.begin; offset < row.end; ++offset) {
        uint middle = ig_csr_resolved_neighbor(
            first_neighbors, first_overlay, first_overlay_count, row, offset);
        uint first_edge = ig_csr_resolved_edge(
            first_edges, first_overlay, first_overlay_count, row, offset);
        uint first_matches = ig_pattern_visible_typed_edge(
            packet,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            middle,
            first_edge,
            type_mode,
            type_start,
            type_count,
            packet_type_base,
            packet_type_total,
            args);
        if (first_matches == 2) return 2;
        if (first_matches == 0) continue;

        uint witness = 0;
        if (direction == 0 || direction == 2) {
            witness = ig_pattern_probe_adjacency(
                packet,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                outgoing_overlay,
                outgoing_overlay_count,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                middle,
                first_edge,
                1,
                type_mode,
                type_start,
                type_count,
                packet_type_base,
                packet_type_total,
                args);
            if (witness != 0) return witness;
        }
        if (direction == 1 || direction == 2) {
            witness = ig_pattern_probe_adjacency(
                packet,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                incoming_overlay,
                incoming_overlay_count,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                middle,
                first_edge,
                1,
                type_mode,
                type_start,
                type_count,
                packet_type_base,
                packet_type_total,
                args);
            if (witness != 0) return witness;
        }
    }
    return 0;
}

// One invocation owns one (outer row, existential leaf) pair. The graph remains resident and the
// only output is a Boolean witness mask, so parallel relationships and undirected self-loops can
// never multiply the outer row stream.
kernel void ig_pattern_predicate_traverse(
    device const uint* input_rows [[buffer(0)]],
    device const long* packet [[buffer(1)]],
    device const uint* outgoing_offsets [[buffer(2)]],
    device const uint* outgoing_neighbors [[buffer(3)]],
    device const uint* outgoing_edges [[buffer(4)]],
    device const uint* incoming_offsets [[buffer(5)]],
    device const uint* incoming_neighbors [[buffer(6)]],
    device const uint* incoming_edges [[buffer(7)]],
    device const uchar* node_active [[buffer(8)]],
    device const uchar* node_layers [[buffer(9)]],
    device const uchar* edge_active [[buffer(10)]],
    device const uchar* edge_layers [[buffer(11)]],
    device const long* edge_types [[buffer(12)]],
    device const long* property_values [[buffer(13)]],
    device const uchar* property_validity [[buffer(14)]],
    device const uint* outgoing_overlay [[buffer(15)]],
    device const uint* incoming_overlay [[buffer(16)]],
    device uchar* masks [[buffer(17)]],
    constant PatternPredicateArgs& args [[buffer(18)]],
    uint pair [[thread_position_in_grid]]) {
    ulong pair_count = args.row_count * ulong(args.leaf_count);
    if (ulong(pair) >= pair_count) return;
    if (!ig_pattern_packet_is_valid(packet, args)) {
        masks[pair] = uchar(2);
        return;
    }

    uint leaf = pair % args.leaf_count;
    ulong row = ulong(pair) / args.leaf_count;
    ulong leaf_base = IG_PATTERN_PACKET_HEADER_WORDS
        + ulong(leaf) * IG_PATTERN_LEAF_WORDS;
    ulong direction_word = ig_pattern_word(packet, leaf_base);
    ulong type_mode_word = ig_pattern_word(packet, leaf_base + 1);
    ulong type_start = ig_pattern_word(packet, leaf_base + 2);
    ulong type_count = ig_pattern_word(packet, leaf_base + 3);
    ulong length = ig_pattern_word(packet, leaf_base + 4);
    ulong property_mode_word = ig_pattern_word(packet, leaf_base + 6);
    ulong start_property_lane = ig_pattern_word(packet, leaf_base + 7);
    ulong end_property_lane = ig_pattern_word(packet, leaf_base + 8);
    ulong minimum_witnesses = ig_pattern_word(packet, leaf_base + 9);
    ulong maximum_witnesses = ig_pattern_word(packet, leaf_base + 10);
    ulong packet_type_total = ig_pattern_word(packet, 3);
    ulong property_lane_count = ig_pattern_word(packet, 4);
    ulong packet_type_base = IG_PATTERN_PACKET_HEADER_WORDS
        + ulong(args.leaf_count) * IG_PATTERN_LEAF_WORDS
        + ulong(args.instruction_count) * IG_PATTERN_INSTRUCTION_WORDS;
    if (direction_word > 2 || type_mode_word > 2 || length > 2
        || property_mode_word > 1
        || minimum_witnesses == 0 || maximum_witnesses < minimum_witnesses
        || (type_mode_word != 1 && type_count != 0)
        || (type_mode_word == 1 && type_count == 0)
        || type_start > packet_type_total
        || type_count > packet_type_total - type_start
        || (property_mode_word == 0
            && (start_property_lane != 0 || end_property_lane != 0))
        || (property_mode_word == 1
            && (start_property_lane >= property_lane_count
                || end_property_lane >= property_lane_count))
        || (length != 0
            && (property_mode_word != 0
                || minimum_witnesses != 1
                || maximum_witnesses != 0xfffffffful))) {
        masks[pair] = uchar(2);
        return;
    }
    uint source = args.source_mode == 1 ? uint(row) : input_rows[row];
    if (source >= args.node_count) {
        masks[pair] = uchar(2);
        return;
    }
    uchar source_active = node_active[source];
    uchar source_layer = node_layers[source];
    if (source_active > 1 || source_layer > int(IG_MAX_LAYER)) {
        masks[pair] = uchar(2);
        return;
    }
    if (source_active == 0
        || (args.layer_mask & (1u << uint(source_layer))) == 0) {
        // Fused scans skip invisible slots before Boolean evaluation. Explicit Rows treat the
        // same marker as a caller contract violation, so NOT can never revive an invalid source.
        masks[pair] = uchar(3);
        return;
    }
    if (type_mode_word == 2) {
        masks[pair] = uchar(0);
        return;
    }

    uint witness = 0;
    if (length == 2) {
        if (direction_word == 0 || direction_word == 2) {
            witness = ig_pattern_probe_exact_two_first_adjacency(
                packet,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                outgoing_overlay,
                args.outgoing_overlay_count,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                outgoing_overlay,
                args.outgoing_overlay_count,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                incoming_overlay,
                args.incoming_overlay_count,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                source,
                uint(direction_word),
                uint(type_mode_word),
                type_start,
                type_count,
                packet_type_base,
                packet_type_total,
                args);
        }
        if (direction_word == 1 || (direction_word == 2 && witness == 0)) {
            witness = ig_pattern_probe_exact_two_first_adjacency(
                packet,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                incoming_overlay,
                args.incoming_overlay_count,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                outgoing_overlay,
                args.outgoing_overlay_count,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                incoming_overlay,
                args.incoming_overlay_count,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                source,
                uint(direction_word),
                uint(type_mode_word),
                type_start,
                type_count,
                packet_type_base,
                packet_type_total,
                args);
        }
    } else {
        ulong witnesses = 0ul;
        ulong stop_at = maximum_witnesses == 0xfffffffful
            ? minimum_witnesses : maximum_witnesses + 1ul;
        uint count_status = 0;
        if (direction_word == 0 || direction_word == 2) {
            count_status = ig_pattern_count_adjacency(
                packet,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                outgoing_overlay,
                args.outgoing_overlay_count,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                property_values,
                property_validity,
                source,
                false,
                uint(type_mode_word),
                type_start,
                type_count,
                packet_type_base,
                packet_type_total,
                uint(property_mode_word),
                start_property_lane,
                end_property_lane,
                property_lane_count,
                stop_at,
                args,
                witnesses);
            if (count_status == 2) {
                masks[pair] = uchar(2);
                return;
            }
        }
        if (direction_word == 1
            || (direction_word == 2 && witnesses < stop_at)) {
            count_status = ig_pattern_count_adjacency(
                packet,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                incoming_overlay,
                args.incoming_overlay_count,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                property_values,
                property_validity,
                source,
                direction_word == 2,
                uint(type_mode_word),
                type_start,
                type_count,
                packet_type_base,
                packet_type_total,
                uint(property_mode_word),
                start_property_lane,
                end_property_lane,
                property_lane_count,
                stop_at,
                args,
                witnesses);
            if (count_status == 2) {
                masks[pair] = uchar(2);
                return;
            }
        }
        witness = witnesses >= minimum_witnesses && witnesses <= maximum_witnesses ? 1 : 0;
    }
    masks[pair] = uchar(witness);
}

constant uint IG_PATTERN_COMPACT_THREADS = 256;
constant uint IG_PATTERN_COMPACT_ROWS_PER_LANE = 4;
constant uint IG_PATTERN_COMPACT_TILE_ROWS =
    IG_PATTERN_COMPACT_THREADS * IG_PATTERN_COMPACT_ROWS_PER_LANE;
constant uint IG_PATTERN_COMPACT_NO_ERROR = 0xffffffffu;

// Deterministic workgroup prefix primitive. Every lane contributes one contiguous four-row
// chunk, so adding this lane prefix to its private intra-chunk prefix preserves physical order.
inline uint ig_pattern_exclusive_prefix_256(
    threadgroup uint* scratch,
    uint lane,
    uint value) {
    scratch[lane] = value;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint distance = 1; distance < IG_PATTERN_COMPACT_THREADS; distance <<= 1) {
        uint addend = lane >= distance ? scratch[lane - distance] : 0;
        threadgroup_barrier(mem_flags::mem_threadgroup);
        scratch[lane] += addend;
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    return scratch[lane] - value;
}

inline uint ig_pattern_minimum_256(
    threadgroup uint* scratch,
    uint lane,
    uint value) {
    scratch[lane] = value;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint stride = IG_PATTERN_COMPACT_THREADS >> 1; stride != 0; stride >>= 1) {
        if (lane < stride) scratch[lane] = min(scratch[lane], scratch[lane + stride]);
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    return scratch[0];
}

inline uint ig_pattern_error_word(uint position, uint status) {
    return (position << 3) | status;
}

// One lane owns one outer row. This is the only pass which interprets the postfix Boolean
// program; its compact state is consumed by deterministic tile scans below.
kernel void ig_pattern_predicate_evaluate(
    device const long* packet [[buffer(0)]],
    device const uchar* masks [[buffer(1)]],
    device uchar* row_states [[buffer(2)]],
    constant PatternPredicateArgs& args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    if (!ig_pattern_packet_is_valid(packet, args)) {
        row_states[row] = uchar(3); // corrupt program/image
        return;
    }

    ulong mask_base = ulong(row) * ulong(args.leaf_count);
    uchar first_value = masks[mask_base];
    if (first_value == 3) {
        if (args.source_mode != 1) {
            row_states[row] = uchar(4); // invalid explicit source row
            return;
        }
        for (uint leaf = 1; leaf < args.leaf_count; ++leaf) {
            if (masks[mask_base + leaf] != 3) {
                row_states[row] = uchar(3);
                return;
            }
        }
        row_states[row] = uchar(0); // invisible fused scan slot
        return;
    }

    for (uint leaf = 0; leaf < args.leaf_count; ++leaf) {
        if (masks[mask_base + leaf] > 1) {
            row_states[row] = uchar(3);
            return;
        }
    }

    uchar stack[IG_PATTERN_MAX_INSTRUCTIONS];
    uint stack_count = 0;
    ulong instruction_base = IG_PATTERN_PACKET_HEADER_WORDS
        + ulong(args.leaf_count) * IG_PATTERN_LEAF_WORDS;
    for (uint instruction = 0; instruction < args.instruction_count; ++instruction) {
        ulong descriptor = instruction_base
            + ulong(instruction) * IG_PATTERN_INSTRUCTION_WORDS;
        ulong opcode = ig_pattern_word(packet, descriptor);
        ulong operand = ig_pattern_word(packet, descriptor + 1);
        if (opcode == 0) {
            if (operand >= args.leaf_count || stack_count >= IG_PATTERN_MAX_INSTRUCTIONS) {
                row_states[row] = uchar(3);
                return;
            }
            stack[stack_count++] = masks[mask_base + uint(operand)];
        } else if (opcode == 1) {
            if (stack_count == 0 || operand != 0) {
                row_states[row] = uchar(3);
                return;
            }
            stack[stack_count - 1] = stack[stack_count - 1] == 0 ? 1 : 0;
        } else if (opcode == 2 || opcode == 3) {
            if (stack_count < 2 || operand != 0) {
                row_states[row] = uchar(3);
                return;
            }
            uchar right = stack[--stack_count];
            uchar left = stack[stack_count - 1];
            stack[stack_count - 1] = opcode == 2
                ? uchar(left != 0 && right != 0)
                : uchar(left != 0 || right != 0);
        } else {
            row_states[row] = uchar(3);
            return;
        }
    }
    if (stack_count != 1) {
        row_states[row] = uchar(3);
        return;
    }
    row_states[row] = stack[0] == 0 ? uchar(1) : uchar(2);
}

// A 256-lane group owns one contiguous 1,024-row tile. No atomic contributes to rank or count.
kernel void ig_pattern_predicate_tile_counts(
    device const uchar* masks [[buffer(0)]],
    device const uchar* row_states [[buffer(1)]],
    device uint* local_ranks [[buffer(2)]],
    device uint4* block_metadata [[buffer(3)]],
    device uint* block_leaf_counts [[buffer(4)]],
    constant PatternPredicateArgs& args [[buffer(5)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup uint scratch[IG_PATTERN_COMPACT_THREADS];
    ulong base = ulong(block) * IG_PATTERN_COMPACT_TILE_ROWS;
    uint selected_flags[IG_PATTERN_COMPACT_ROWS_PER_LANE];
    uint visible_flags[IG_PATTERN_COMPACT_ROWS_PER_LANE];
    uint selected_in_lane = 0;
    uint visible_in_lane = 0;
    uint first_error = IG_PATTERN_COMPACT_NO_ERROR;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        ulong row = base + ulong(lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item);
        uchar state = row < args.row_count ? row_states[row] : uchar(0);
        uint selected = row < args.row_count && state == 2 ? 1 : 0;
        uint visible = row < args.row_count && (state == 1 || state == 2) ? 1 : 0;
        selected_flags[item] = selected;
        visible_flags[item] = visible;
        selected_in_lane += selected;
        visible_in_lane += visible;
        if (row < args.row_count && state >= 3) {
            uint status = state == 4 ? 4 : 2;
            first_error = min(first_error, ig_pattern_error_word(uint(row), status));
        }
    }

    uint lane_prefix = ig_pattern_exclusive_prefix_256(
        scratch, lane, selected_in_lane);
    uint selected_total = scratch[IG_PATTERN_COMPACT_THREADS - 1];
    uint within_lane = 0;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        ulong row = base + ulong(lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item);
        if (row < args.row_count) local_ranks[row] = lane_prefix + within_lane;
        within_lane += selected_flags[item];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    (void)ig_pattern_exclusive_prefix_256(scratch, lane, visible_in_lane);
    uint visible_total = scratch[IG_PATTERN_COMPACT_THREADS - 1];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    first_error = ig_pattern_minimum_256(scratch, lane, first_error);

    if (lane < args.leaf_count) {
        uint leaf_count = 0;
        for (uint local = 0; local < IG_PATTERN_COMPACT_TILE_ROWS; ++local) {
            ulong row = base + local;
            if (row < args.row_count) {
                uchar state = row_states[row];
                if ((state == 1 || state == 2)
                    && masks[row * ulong(args.leaf_count) + lane] == 1) {
                    ++leaf_count;
                }
            }
        }
        block_leaf_counts[ulong(block) * args.leaf_count + lane] = leaf_count;
    }
    if (lane == 0) {
        block_metadata[block] = uint4(selected_total, visible_total, first_error, 0);
    }
}

// The admitted one-endpoint domain produces at most 1,024 tiles, so one 256-lane group can scan
// all tile counts and reduce all receipt cardinalities without a host-visible intermediate.
kernel void ig_pattern_predicate_block_scan(
    device const long* packet [[buffer(0)]],
    device const uint4* block_metadata [[buffer(1)]],
    device const uint* block_leaf_counts [[buffer(2)]],
    device uint* block_offsets [[buffer(3)]],
    device uint* summary [[buffer(4)]],
    constant PatternPredicateArgs& args [[buffer(5)]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup uint scratch[IG_PATTERN_COMPACT_THREADS];
    uint block_count = uint(max(1ul,
        (args.row_count + IG_PATTERN_COMPACT_TILE_ROWS - 1)
            / IG_PATTERN_COMPACT_TILE_ROWS));
    uint selected_chunks[IG_PATTERN_COMPACT_ROWS_PER_LANE];
    uint selected_in_lane = 0;
    uint visible_in_lane = 0;
    uint first_error = IG_PATTERN_COMPACT_NO_ERROR;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        uint block = lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item;
        uint4 metadata = block < block_count
            ? block_metadata[block]
            : uint4(0, 0, IG_PATTERN_COMPACT_NO_ERROR, 0);
        selected_chunks[item] = metadata.x;
        selected_in_lane += metadata.x;
        visible_in_lane += metadata.y;
        first_error = min(first_error, metadata.z);
    }

    uint lane_prefix = ig_pattern_exclusive_prefix_256(
        scratch, lane, selected_in_lane);
    uint selected_total = scratch[IG_PATTERN_COMPACT_THREADS - 1];
    uint within_lane = 0;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        uint block = lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item;
        if (block < block_count) block_offsets[block] = lane_prefix + within_lane;
        within_lane += selected_chunks[item];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    (void)ig_pattern_exclusive_prefix_256(scratch, lane, visible_in_lane);
    uint visible_total = scratch[IG_PATTERN_COMPACT_THREADS - 1];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    first_error = ig_pattern_minimum_256(scratch, lane, first_error);

    if (lane < args.leaf_count) {
        uint count = 0;
        for (uint block = 0; block < block_count; ++block) {
            count += block_leaf_counts[ulong(block) * args.leaf_count + lane];
        }
        summary[4 + lane] = count;
    }
    if (lane == 0) {
        ulong expected_output_words = IG_PATTERN_FRAME_HEADER_WORDS
            + ulong(args.receipt_count) * IG_PATTERN_RECEIPT_WORDS
            + args.output_capacity;
        uint status = 1;
        if (expected_output_words != args.output_word_count
            || !ig_pattern_packet_is_valid(packet, args)) {
            status = 2;
        } else if (first_error != IG_PATTERN_COMPACT_NO_ERROR) {
            status = first_error & 7u;
        } else if (selected_total > args.output_capacity) {
            status = 3;
        }
        summary[0] = selected_total;
        summary[1] = visible_total;
        summary[2] = status;
        summary[3] = block_count;
    }
}

kernel void ig_pattern_predicate_scatter(
    device const uint* input_rows [[buffer(0)]],
    device const uchar* row_states [[buffer(1)]],
    device const uint* local_ranks [[buffer(2)]],
    device const uint* block_offsets [[buffer(3)]],
    device const uint* summary [[buffer(4)]],
    device ulong* output [[buffer(5)]],
    constant PatternPredicateArgs& args [[buffer(6)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count || summary[2] != 1 || row_states[row] != 2) return;
    uint block = row / IG_PATTERN_COMPACT_TILE_ROWS;
    uint destination = block_offsets[block] + local_ranks[row];
    if (destination >= summary[0] || destination >= args.output_capacity) return;
    ulong row_output_base = IG_PATTERN_FRAME_HEADER_WORDS
        + ulong(args.receipt_count) * IG_PATTERN_RECEIPT_WORDS;
    output[row_output_base + destination] = args.source_mode == 1
        ? ulong(row)
        : ulong(input_rows[row]);
}

// Receipts remain device-authored. Success is the final store after every row and receipt word
// has been produced by earlier Metal passes in this command encoder.
kernel void ig_pattern_predicate_publish(
    device const long* packet [[buffer(0)]],
    device const uint* summary [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant PatternPredicateArgs& args [[buffer(3)]],
    uint lane [[thread_index_in_threadgroup]]) {
    uint status = summary[2];
    if (lane == 0) {
        output[0] = IG_PATTERN_PREDICATE_MAGIC;
        output[1] = 2;
        output[2] = args.execution_high;
        output[3] = args.execution_low;
        output[4] = args.row_count;
        output[5] = status == 1 || status == 3 ? ulong(summary[0]) : 0;
        output[6] = args.receipt_count;
        output[7] = 2;
        output[8] = args.bookmark_term;
        output[9] = args.bookmark_index;
        output[10] = args.graph_revision;
        output[11] = args.layout_version;
    }
    if (status == 1 && lane < args.receipt_count) {
        uint receipt_offset = args.source_mode == 1 ? 1 : 0;
        ulong receipt = IG_PATTERN_FRAME_HEADER_WORDS
            + ulong(lane) * IG_PATTERN_RECEIPT_WORDS;
        output[receipt] = args.execution_high;
        output[receipt + 1] = args.execution_low;
        output[receipt + 5] = 0;
        output[receipt + 8] = 2;
        if (args.source_mode == 1 && lane == 0) {
            output[receipt + 2] = args.scan_obligation_id;
            output[receipt + 3] = 7;
            output[receipt + 4] = 6;
            output[receipt + 6] = args.row_count;
            output[receipt + 7] = summary[1];
        } else if (lane < receipt_offset + args.leaf_count) {
            uint leaf = lane - receipt_offset;
            ulong leaf_base = IG_PATTERN_PACKET_HEADER_WORDS
                + ulong(leaf) * IG_PATTERN_LEAF_WORDS;
            output[receipt + 2] = ig_pattern_word(packet, leaf_base + 5);
            output[receipt + 3] = 5;
            output[receipt + 4] = 4;
            output[receipt + 5] = leaf;
            output[receipt + 6] = summary[1];
            output[receipt + 7] = summary[4 + leaf];
        } else {
            output[receipt + 2] = ig_pattern_word(packet, 5);
            output[receipt + 3] = 6;
            output[receipt + 4] = 5;
            output[receipt + 6] = summary[1];
            output[receipt + 7] = summary[0];
        }
    }
    threadgroup_barrier(mem_flags::mem_device);
    if (lane == 0) output[1] = status;
}

constant ulong IG_PATTERN_PAIR_MAGIC = 0x4947504149525052ul;
constant uint IG_PATTERN_PAIR_PACKET_HEADER_WORDS = 7;
constant uint IG_PATTERN_PAIR_FRAME_HEADER_WORDS = 12;
constant uint IG_PATTERN_PAIR_RECEIPT_WORDS = 9;
constant uint IG_PATTERN_PAIR_RECEIPTS = 5;
constant uint IG_PATTERN_PAIR_CHUNK_ROWS =
    IG_PATTERN_COMPACT_TILE_ROWS * IG_PATTERN_COMPACT_TILE_ROWS;

struct PatternPairPredicateArgs {
    ulong execution_high;
    ulong execution_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong n_scan_obligation_id;
    ulong m_scan_obligation_id;
    ulong cartesian_obligation_id;
    ulong pair_count;
    ulong pair_base;
    ulong output_word_count;
    ulong output_capacity;
    uint node_count;
    uint edge_count;
    uint packet_word_count;
    uint layer_mask;
    uint dispatch_count;
    uint traversal_word_count;
    uint receipt_count;
    uint reserved;
};

inline ulong ig_pattern_pair_word(device const long* packet, ulong index) {
    return as_type<ulong>(packet[index]);
}

inline bool ig_pattern_pair_contract_is_valid(
    device const long* packet,
    constant PatternPairPredicateArgs& args) {
    ulong node_count = args.node_count;
    ulong expected_pairs = node_count * node_count;
    ulong type_count = ig_pattern_pair_word(packet, 4);
    ulong type_mode = ig_pattern_pair_word(packet, 2);
    ulong expected_traversal_words = (node_count + 63ul) / 64ul;
    return args.pair_count == expected_pairs
        && args.output_capacity <= args.pair_count
        && args.pair_base <= args.pair_count
        && ulong(args.dispatch_count) <= args.pair_count - args.pair_base
        && args.dispatch_count <= IG_PATTERN_PAIR_CHUNK_ROWS
        && ulong(args.traversal_word_count) == expected_traversal_words
        && args.receipt_count == IG_PATTERN_PAIR_RECEIPTS
        && args.n_scan_obligation_id != 0
        && args.m_scan_obligation_id != 0
        && args.cartesian_obligation_id != 0
        && args.reserved == 0
        && ig_pattern_pair_word(packet, 0) == 1
        && ig_pattern_pair_word(packet, 1) <= 2
        && type_mode <= 2
        && ig_pattern_pair_word(packet, 3) <= 2
        && ((type_mode == 1 && type_count != 0)
            || (type_mode != 1 && type_count == 0))
        && IG_PATTERN_PAIR_PACKET_HEADER_WORDS + type_count == args.packet_word_count
        && ig_pattern_pair_word(packet, 5) != 0
        && ig_pattern_pair_word(packet, 6) != 0;
}

inline uint ig_pattern_pair_edge_matches(
    device const long* packet,
    device const long* edge_types,
    uint edge,
    constant PatternPairPredicateArgs& args) {
    ulong type_mode = ig_pattern_pair_word(packet, 2);
    ulong type_count = ig_pattern_pair_word(packet, 4);
    if (type_mode == 0) return 1;
    if (type_mode == 2) return 0;
    if (type_mode != 1 || type_count == 0 || edge >= args.edge_count) return 2;
    ulong relationship_type = as_type<ulong>(edge_types[edge]);
    for (ulong index = 0; index < type_count; ++index) {
        if (ig_pattern_pair_word(
                packet,
                IG_PATTERN_PAIR_PACKET_HEADER_WORDS + index)
            == relationship_type) {
            return 1;
        }
    }
    return 0;
}

inline uint ig_pattern_pair_visible_edge(
    device const long* packet,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint neighbor,
    uint edge,
    constant PatternPairPredicateArgs& args) {
    if (neighbor >= args.node_count || edge >= args.edge_count) return 2;
    uchar neighbor_active = node_active[neighbor];
    uchar relationship_active = edge_active[edge];
    uchar neighbor_layer = node_layers[neighbor];
    uchar relationship_layer = edge_layers[edge];
    if (neighbor_active > 1 || relationship_active > 1
        || neighbor_layer > int(IG_MAX_LAYER) || relationship_layer > int(IG_MAX_LAYER)) {
        return 2;
    }
    if (neighbor_active == 0 || relationship_active == 0
        || (args.layer_mask & (1u << uint(neighbor_layer))) == 0
        || (args.layer_mask & (1u << uint(relationship_layer))) == 0) {
        return 0;
    }
    return ig_pattern_pair_edge_matches(packet, edge_types, edge, args);
}

inline bool ig_pattern_pair_bit_is_set(device const ulong* bits, uint row) {
    return (bits[row >> 6] & (1ul << ulong(row & 63))) != 0;
}

inline void ig_pattern_pair_set_bit(device ulong* bits, uint row) {
    bits[row >> 6] |= 1ul << ulong(row & 63);
}

inline void ig_pattern_pair_clear_bits(
    device ulong* bits,
    constant PatternPairPredicateArgs& args) {
    for (uint word = 0; word < args.traversal_word_count; ++word) bits[word] = 0;
}

// Returns 0 for no target, 1 for target reached, and 2 for corrupt resident input.
inline uint ig_pattern_pair_frontier_step_adjacency(
    device const long* packet,
    device const uint* offsets,
    device const uint* neighbors,
    device const uint* adjacency_edges,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    device const ulong* frontier,
    device const ulong* visited,
    device ulong* next,
    uint target,
    uint excluded_edge,
    uint exclude_edge,
    constant PatternPairPredicateArgs& args) {
    for (uint current = 0; current < args.node_count; ++current) {
        if (!ig_pattern_pair_bit_is_set(frontier, current)) continue;
        uint start = offsets[current];
        uint end = offsets[current + 1];
        if (start > end || end > args.edge_count) return 2;
        for (uint offset = start; offset < end; ++offset) {
            uint neighbor = neighbors[offset];
            uint edge = adjacency_edges[offset];
            if (exclude_edge != 0 && edge == excluded_edge) continue;
            uint matches = ig_pattern_pair_visible_edge(
                packet,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                neighbor,
                edge,
                args);
            if (matches == 2) return 2;
            if (matches == 0) continue;
            if (neighbor == target) return 1;
            if (!ig_pattern_pair_bit_is_set(visited, neighbor)) {
                ig_pattern_pair_set_bit(next, neighbor);
            }
        }
    }
    return 0;
}

inline uint ig_pattern_pair_reachable(
    device const long* packet,
    device const uint* outgoing_offsets,
    device const uint* outgoing_neighbors,
    device const uint* outgoing_edges,
    device const uint* incoming_offsets,
    device const uint* incoming_neighbors,
    device const uint* incoming_edges,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint source,
    uint target,
    uint excluded_edge,
    uint exclude_edge,
    device ulong* visited,
    device ulong* frontier,
    device ulong* next,
    constant PatternPairPredicateArgs& args) {
    ig_pattern_pair_clear_bits(visited, args);
    ig_pattern_pair_clear_bits(frontier, args);
    ig_pattern_pair_set_bit(visited, source);
    ig_pattern_pair_set_bit(frontier, source);
    uint direction = uint(ig_pattern_pair_word(packet, 1));
    for (uint depth = 0; depth < args.node_count; ++depth) {
        ig_pattern_pair_clear_bits(next, args);
        uint found = 0;
        if (direction == 0 || direction == 2) {
            found = ig_pattern_pair_frontier_step_adjacency(
                packet,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                frontier,
                visited,
                next,
                target,
                excluded_edge,
                exclude_edge,
                args);
            if (found != 0) return found;
        }
        if (direction == 1 || direction == 2) {
            found = ig_pattern_pair_frontier_step_adjacency(
                packet,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                frontier,
                visited,
                next,
                target,
                excluded_edge,
                exclude_edge,
                args);
            if (found != 0) return found;
        }
        bool any = false;
        for (uint word = 0; word < args.traversal_word_count; ++word) {
            next[word] &= ~visited[word];
            any = any || next[word] != 0;
            visited[word] |= next[word];
            frontier[word] = next[word];
        }
        if (!any) return 0;
    }
    return 0;
}

inline uint ig_pattern_pair_probe_target_adjacency(
    device const long* packet,
    device const uint* offsets,
    device const uint* neighbors,
    device const uint* adjacency_edges,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint source,
    uint target,
    uint excluded_edge,
    uint exclude_edge,
    constant PatternPairPredicateArgs& args) {
    uint start = offsets[source];
    uint end = offsets[source + 1];
    if (start > end || end > args.edge_count) return 2;
    for (uint offset = start; offset < end; ++offset) {
        uint neighbor = neighbors[offset];
        uint edge = adjacency_edges[offset];
        if (neighbor != target || (exclude_edge != 0 && edge == excluded_edge)) continue;
        uint matches = ig_pattern_pair_visible_edge(
            packet,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            neighbor,
            edge,
            args);
        if (matches != 0) return matches;
    }
    return 0;
}

inline uint ig_pattern_pair_one(
    device const long* packet,
    device const uint* outgoing_offsets,
    device const uint* outgoing_neighbors,
    device const uint* outgoing_edges,
    device const uint* incoming_offsets,
    device const uint* incoming_neighbors,
    device const uint* incoming_edges,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint source,
    uint target,
    constant PatternPairPredicateArgs& args) {
    uint direction = uint(ig_pattern_pair_word(packet, 1));
    uint witness = 0;
    if (direction == 0 || direction == 2) {
        witness = ig_pattern_pair_probe_target_adjacency(
            packet,
            outgoing_offsets,
            outgoing_neighbors,
            outgoing_edges,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            source,
            target,
            0,
            0,
            args);
        if (witness != 0) return witness;
    }
    if (direction == 1 || direction == 2) {
        return ig_pattern_pair_probe_target_adjacency(
            packet,
            incoming_offsets,
            incoming_neighbors,
            incoming_edges,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            source,
            target,
            0,
            0,
            args);
    }
    return 0;
}

inline uint ig_pattern_pair_exact_two_first_adjacency(
    device const long* packet,
    device const uint* first_offsets,
    device const uint* first_neighbors,
    device const uint* first_edges,
    device const uint* outgoing_offsets,
    device const uint* outgoing_neighbors,
    device const uint* outgoing_edges,
    device const uint* incoming_offsets,
    device const uint* incoming_neighbors,
    device const uint* incoming_edges,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    uint source,
    uint target,
    constant PatternPairPredicateArgs& args) {
    uint start = first_offsets[source];
    uint end = first_offsets[source + 1];
    if (start > end || end > args.edge_count) return 2;
    uint direction = uint(ig_pattern_pair_word(packet, 1));
    for (uint offset = start; offset < end; ++offset) {
        uint middle = first_neighbors[offset];
        uint first_edge = first_edges[offset];
        uint first_matches = ig_pattern_pair_visible_edge(
            packet,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            middle,
            first_edge,
            args);
        if (first_matches == 2) return 2;
        if (first_matches == 0) continue;
        uint witness = 0;
        if (direction == 0 || direction == 2) {
            witness = ig_pattern_pair_probe_target_adjacency(
                packet,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                middle,
                target,
                first_edge,
                1,
                args);
            if (witness != 0) return witness;
        }
        if (direction == 1 || direction == 2) {
            witness = ig_pattern_pair_probe_target_adjacency(
                packet,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                middle,
                target,
                first_edge,
                1,
                args);
            if (witness != 0) return witness;
        }
    }
    return 0;
}

