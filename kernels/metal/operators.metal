    return ig_nullable_csr_edge(graph,
        incoming ? args.incoming_edge_base : args.outgoing_edge_base,
        incoming ? args.incoming_overlay_base : args.outgoing_overlay_base,
        incoming ? args.incoming_overlay_row_count : args.outgoing_overlay_row_count,
        row, position);
}

inline bool ig_nullable_range(ulong base, ulong count, ulong total) {
    return base <= total && count <= total - base;
}

inline bool ig_nullable_csr_overlay_valid(
    device const long* graph,
    ulong base,
    ulong word_count,
    ulong row_count,
    ulong node_count,
    ulong graph_word_count) {
    if (row_count == 0ul) return word_count == 0ul;
    if (row_count > IG_NULLABLE_RELATION_MAX_DIMENSION) return false;
    ulong prefix = row_count * 2ul + 1ul;
    if (prefix > word_count || !ig_nullable_range(base, word_count, graph_word_count)) {
        return false;
    }
    ulong payload_count = ig_nullable_word(graph, base + row_count * 2ul);
    if (payload_count > IG_NULLABLE_RELATION_MAX_DIMENSION
        || prefix + payload_count * 2ul != word_count) return false;
    ulong prior_row = 0ul;
    ulong prior_offset = 0ul;
    for (ulong index = 0ul; index < row_count; ++index) {
        ulong row = ig_nullable_word(graph, base + index);
        ulong offset = ig_nullable_word(graph, base + row_count + index);
        if (row >= node_count || (index != 0ul && row <= prior_row)
            || offset < prior_offset || offset > payload_count
            || (index == 0ul && offset != 0ul)) return false;
        prior_row = row;
        prior_offset = offset;
    }
    return true;
}

inline bool ig_nullable_product(ulong left, ulong right, thread ulong& product) {
    if (left > IG_NULLABLE_RELATION_MAX_DIMENSION
        || right > IG_NULLABLE_RELATION_MAX_DIMENSION) return false;
    product = left * right;
    return true;
}

inline bool ig_nullable_advance(
    thread ulong& cursor,
    ulong expected_base,
    ulong count,
    ulong total) {
    if (cursor != expected_base || !ig_nullable_range(cursor, count, total)) return false;
    cursor += count;
    return true;
}

inline bool ig_nullable_domain_valid(
    device const long* program,
    constant NullableRelationArgs& args,
    ulong kind,
    ulong offset,
    ulong count,
    bool labels) {
    if (kind == IG_NULLABLE_RELATION_DOMAIN_ANY
            || kind == IG_NULLABLE_RELATION_DOMAIN_EMPTY) {
        return offset == 0ul && count == 0ul;
    }
    if (kind != IG_NULLABLE_RELATION_DOMAIN_KNOWN || count == 0ul
            || !ig_nullable_range(offset, count, args.program_word_count)) {
        return false;
    }
    if (labels) {
        for (ulong index = 0ul; index < count; ++index) {
            if (ig_nullable_word(program, offset + index) >= args.label_lane_count) return false;
        }
    }
    return true;
}

// 0 means invisible/non-matching, 1 means visible/matching, and 2 means corrupt input.
inline uint ig_nullable_node_matches(
    device const long* graph,
    device const long* program,
    constant NullableRelationArgs& args,
    ulong node,
    ulong domain_kind,
    ulong domain_offset,
    ulong domain_count) {
    if (node >= args.node_count) return 2u;
    ulong active = ig_nullable_word(graph, args.node_active_base + node);
    ulong layer = ig_nullable_word(graph, args.node_layer_base + node);
    if (active > 1ul || layer > IG_MAX_LAYER_UL) return 2u;
    if (active == 0ul || (args.layers & (1ul << layer)) == 0ul) return 0u;
    if (domain_kind == IG_NULLABLE_RELATION_DOMAIN_ANY) return 1u;
    if (domain_kind == IG_NULLABLE_RELATION_DOMAIN_EMPTY) return 0u;
    if (domain_kind != IG_NULLABLE_RELATION_DOMAIN_KNOWN) return 2u;
    for (ulong index = 0ul; index < domain_count; ++index) {
        ulong lane = ig_nullable_word(program, domain_offset + index);
        if (lane >= args.label_lane_count) return 2u;
        ulong membership = ig_nullable_word(
            graph, args.label_base + lane * args.node_count + node);
        if (membership > 1ul) return 2u;
        if (membership == 0ul) return 0u;
    }
    return 1u;
}

// 0 means invisible/non-matching, 1 means visible/matching, and 2 means corrupt input.
inline uint ig_nullable_relationship_matches(
    device const long* graph,
    device const long* program,
    constant NullableRelationArgs& args,
    ulong edge,
    ulong domain_kind,
    ulong domain_offset,
    ulong domain_count) {
    if (edge >= args.edge_count) return 2u;
    ulong active = ig_nullable_word(graph, args.edge_active_base + edge);
    ulong layer = ig_nullable_word(graph, args.edge_layer_base + edge);
    if (active > 1ul || layer > IG_MAX_LAYER_UL) return 2u;
    if (active == 0ul || (args.layers & (1ul << layer)) == 0ul) return 0u;
    if (domain_kind == IG_NULLABLE_RELATION_DOMAIN_ANY) return 1u;
    if (domain_kind == IG_NULLABLE_RELATION_DOMAIN_EMPTY) return 0u;
    if (domain_kind != IG_NULLABLE_RELATION_DOMAIN_KNOWN) return 2u;
    ulong relationship_type = ig_nullable_word(graph, args.edge_type_base + edge);
    for (ulong index = 0ul; index < domain_count; ++index) {
        if (ig_nullable_word(program, domain_offset + index) == relationship_type) return 1u;
    }
    return 0u;
}

inline bool ig_nullable_copy_row(
    device ulong* output,
    ulong current_base,
    ulong next_base,
    ulong maximum_relation_cells,
    ulong source_row,
    ulong current_rows,
    ulong current_width,
    ulong output_row,
    ulong next_width) {
    if (source_row >= current_rows) return false;
    ulong source_cell_count = 0ul;
    ulong output_cell_count = 0ul;
    if (!ig_nullable_product(current_rows, current_width, source_cell_count)
            || !ig_nullable_product(output_row + 1ul, next_width, output_cell_count)
            || source_cell_count > maximum_relation_cells
            || output_cell_count > maximum_relation_cells) {
        return false;
    }
    for (ulong column = 0ul; column < current_width; ++column) {
        output[next_base + output_row * next_width + column] =
            output[current_base + source_row * current_width + column];
    }
    return true;
}

inline ulong ig_nullable_slot_entry(ulong kind, ulong column) {
    return (kind << 32ul) | (column + 1ul);
}

inline bool ig_nullable_slot_present(ulong entry) {
    ulong encoded_column = entry & 0xfffffffful;
    ulong kind = entry >> 32ul;
    return encoded_column != 0ul && (kind == 1ul || kind == 2ul);
}

inline ulong ig_nullable_slot_column(ulong entry) {
    return (entry & 0xfffffffful) - 1ul;
}

inline ulong ig_nullable_slot_kind(ulong entry) {
    return entry >> 32ul;
}

// One canonical fixed-hop candidate predicate shared by count and materialization. A return of
// zero is an ordinary non-match, one is a match, and two means the sealed packet is corrupt.
inline uint ig_nullable_expand_candidate_matches(
    device const long* graph,
    device const long* program,
    device const ulong* output,
    constant NullableRelationArgs& args,
    ulong descriptor,
    ulong current_base,
    ulong input,
    ulong current_width,
    ulong edge,
    ulong neighbor) {
    ulong relationship_domain = ig_nullable_word(program, descriptor + 7ul);
    ulong relationship_offset = ig_nullable_word(program, descriptor + 8ul);
    ulong relationship_count = ig_nullable_word(program, descriptor + 9ul);
    ulong target_domain = ig_nullable_word(program, descriptor + 10ul);
    ulong target_offset = ig_nullable_word(program, descriptor + 11ul);
    ulong target_count = ig_nullable_word(program, descriptor + 12ul);
    uint relationship_matches = ig_nullable_relationship_matches(
        graph, program, args, edge, relationship_domain,
        relationship_offset, relationship_count);
    if (relationship_matches != 1u) return relationship_matches;
    uint target_matches = ig_nullable_node_matches(
        graph, program, args, neighbor, target_domain, target_offset, target_count);
    if (target_matches != 1u) return target_matches;

    ulong target_kind = ig_nullable_word(program, descriptor + 4ul);
    ulong target_slot = ig_nullable_word(program, descriptor + 5ul);
    if (target_kind == 0ul) {
        ulong entry = output[args.slot_map_base + target_slot];
        if (!ig_nullable_slot_present(entry) || ig_nullable_slot_kind(entry) != 1ul
                || ig_nullable_slot_column(entry) >= current_width) return 2u;
        ulong existing = output[current_base
            + input * current_width + ig_nullable_slot_column(entry)];
        if (existing == IG_NULLABLE_RELATION_NULL_ROW) return 0u;
        if (existing >= args.node_count) return 2u;
        if (existing != neighbor) return 0u;
    }

    ulong relationship_slot = ig_nullable_word(program, descriptor + 3ul);
    if (relationship_slot != ~0ul) {
        if (relationship_slot >= args.binding_slot_count) return 2u;
        ulong entry = output[args.slot_map_base + relationship_slot];
        if (ig_nullable_slot_present(entry)) {
            if (ig_nullable_slot_kind(entry) != 2ul
                    || ig_nullable_slot_column(entry) >= current_width) return 2u;
            ulong existing = output[current_base
                + input * current_width + ig_nullable_slot_column(entry)];
            if (existing == IG_NULLABLE_RELATION_NULL_ROW) return 0u;
            if (existing >= args.edge_count) return 2u;
            if (existing != edge) return 0u;
        }
    }

    ulong exclusion_offset = ig_nullable_word(program, descriptor + 13ul);
    ulong exclusion_count = ig_nullable_word(program, descriptor + 14ul);
    if (exclusion_count > args.binding_slot_count
        || !ig_nullable_range(exclusion_offset, exclusion_count + 4ul,
            args.program_word_count)) return 2u;
    ulong source_domain_metadata = exclusion_offset + 1ul + exclusion_count;
    ulong source_domain = ig_nullable_word(program, source_domain_metadata);
    ulong source_offset = ig_nullable_word(program, source_domain_metadata + 1ul);
    ulong source_count = ig_nullable_word(program, source_domain_metadata + 2ul);
    if (!ig_nullable_domain_valid(program, args, source_domain,
            source_offset, source_count, true)) return 2u;
    ulong source_slot = ig_nullable_word(program, descriptor + 2ul);
    if (source_slot >= args.binding_slot_count) return 2u;
    ulong source_entry = output[args.slot_map_base + source_slot];
    if (!ig_nullable_slot_present(source_entry)
        || ig_nullable_slot_kind(source_entry) != 1ul
        || ig_nullable_slot_column(source_entry) >= current_width) return 2u;
    ulong source = output[current_base
        + input * current_width + ig_nullable_slot_column(source_entry)];
    if (source == IG_NULLABLE_RELATION_NULL_ROW) return 0u;
    uint source_matches = ig_nullable_node_matches(
        graph, program, args, source, source_domain, source_offset, source_count);
    if (source_matches != 1u) return source_matches;
    for (ulong index = 0ul; index < exclusion_count; ++index) {
        ulong slot = ig_nullable_word(program, exclusion_offset + 1ul + index);
        if (slot >= args.binding_slot_count) return 2u;
        ulong entry = output[args.slot_map_base + slot];
        if (!ig_nullable_slot_present(entry) || ig_nullable_slot_kind(entry) != 2ul
                || ig_nullable_slot_column(entry) >= current_width) return 2u;
        ulong prior = output[current_base
            + input * current_width + ig_nullable_slot_column(entry)];
        if (prior != IG_NULLABLE_RELATION_NULL_ROW && prior >= args.edge_count) return 2u;
        if (prior == edge) return 0u;
    }
    return 1u;
}

inline void ig_nullable_write_receipt(
    device ulong* output,
    constant NullableRelationArgs& args,
    ulong stage,
    ulong obligation_id,
    ulong obligation_kind,
    ulong input_rows,
    ulong matched_input_rows,
    ulong candidate_rows,
    ulong null_rows,
    ulong output_rows) {
    ulong base = IG_NULLABLE_RELATION_HEADER_WORDS
        + stage * IG_NULLABLE_RELATION_RECEIPT_WORDS;
    output[base] = args.execution_high;
    output[base + 1ul] = args.execution_low;
    output[base + 2ul] = obligation_id;
    output[base + 3ul] = stage;
    output[base + 4ul] = obligation_kind;
    output[base + 5ul] = input_rows;
    output[base + 6ul] = matched_input_rows;
    output[base + 7ul] = candidate_rows;
    output[base + 8ul] = null_rows;
    output[base + 9ul] = output_rows;
    output[base + 10ul] = 2ul;
}

constant ulong IG_NULLABLE_RELATION_CONTROL_WORDS = 24ul;
constant ulong IG_NULLABLE_RELATION_CONTROL_MAGIC = 0x49474e554c435452ul;
constant ulong IG_NULLABLE_RELATION_GRAPH_VALID = 2047ul;
constant ulong IG_NULLABLE_RELATION_PREPARED_STAGE_SHIFT = 8ul;
constant ulong IG_NULLABLE_RELATION_PREPARED_OPCODE_SHIFT = 56ul;

struct NullableRelationStepArgs {
    ulong stage;
    ulong opcode;
    ulong filter;
};

inline void ig_nullable_initialize_header(
    device ulong* output,
    constant NullableRelationArgs& args) {
    output[0] = IG_NULLABLE_RELATION_MAGIC;
    output[1] = 2ul;
    output[2] = args.execution_high;
    output[3] = args.execution_low;
    output[4] = args.project_high;
    output[5] = args.project_low;
    output[6] = args.bookmark_term;
    output[7] = args.bookmark_index;
    output[8] = args.graph_revision;
    output[9] = args.layout_version;
    output[10] = args.catalog_0;
    output[11] = args.catalog_1;
    output[12] = args.catalog_2;
    output[13] = args.catalog_3;
    output[14] = args.fingerprint_0;
    output[15] = args.fingerprint_1;
    output[16] = args.fingerprint_2;
    output[17] = args.fingerprint_3;
    output[18] = 2ul;
    output[19] = args.stage_count;
    output[20] = args.receipt_count;
    output[21] = 0ul;
    output[22] = args.final_output_columns;
    output[23] = args.scratch_bytes;
    output[24] = args.output_word_count;
    output[25] = args.maximum_relation_cells;
    output[26] = args.maximum_output_rows;
    output[27] = args.binding_slot_count;
    output[28] = args.program_word_count;
    output[29] = args.graph_word_count;
    output[30] = IG_NULLABLE_RELATION_VERSION;
    output[31] = 1ul;
}

inline void ig_nullable_commit_stage(
    device ulong* output,
    constant NullableRelationArgs& args,
    ulong logical_stage,
    ulong receipt,
    ulong obligation_id,
    ulong obligation_kind,
    ulong input_rows,
    ulong current_selector,
    ulong output_capacity,
    ulong matched_input_rows,
    ulong candidate_rows,
    ulong null_rows,
    ulong output_rows,
    ulong output_width,
    bool toggled) {
    ig_nullable_write_receipt(output, args, receipt, obligation_id,
        obligation_kind, input_rows, matched_input_rows,
        candidate_rows, null_rows, output_rows);
    output[args.control_base + 1ul] = output_rows;
    output[args.control_base + 2ul] = output_width;
    output[args.control_base + 3ul] = toggled
        ? 1ul - current_selector : current_selector;
    output[args.control_base + 4ul] = output_capacity;
    output[args.control_base + 5ul] = logical_stage + 1ul;
    output[args.control_base + 7ul] = IG_NULLABLE_RELATION_GRAPH_VALID;
    output[args.control_base + 8ul] = 0ul;
}

kernel void ig_nullable_relation_initialize(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    ig_nullable_initialize_header(output, args);
}

kernel void ig_nullable_relation_validate_output_limits(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 2ul || output[31] != 1ul) return;
    if (args.stage_count == 0ul || args.stage_count > 256ul
        || args.filter_count > 256ul
        || args.optional_group_count > 256ul
        || args.receipt_count
            != args.stage_count + args.filter_count + args.optional_group_count
        || args.maximum_relation_rows == 0ul
        || (args.filter_count == 0ul && args.maximum_filter_rows != 0ul)
        || args.binding_slot_count > IG_NULLABLE_RELATION_MAX_BINDINGS
        || args.final_output_columns > IG_NULLABLE_RELATION_MAX_BINDINGS
        || args.label_lane_count > IG_NULLABLE_RELATION_MAX_BINDINGS
        || args.layers == 0ul || args.layers > IG_MAX_LAYER_MASK) return;
    output[31] = 2ul;
}

kernel void ig_nullable_relation_validate_output_columns(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 2ul || output[31] != 2ul) return;
    ulong receipt_words = 0ul;
    ulong column_words = 0ul;
    if (!ig_nullable_product(args.receipt_count,
            IG_NULLABLE_RELATION_RECEIPT_WORDS, receipt_words)
        || !ig_nullable_range(IG_NULLABLE_RELATION_HEADER_WORDS, receipt_words,
            args.output_word_count)
        || args.column_base != IG_NULLABLE_RELATION_HEADER_WORDS + receipt_words
        || !ig_nullable_product(args.final_output_columns,
            IG_NULLABLE_RELATION_COLUMN_WORDS, column_words)
        || !ig_nullable_range(args.column_base, column_words, args.output_word_count)
        || args.final_base != args.column_base + column_words
        ) return;
    output[31] = 3ul;
}

kernel void ig_nullable_relation_validate_output_final(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 2ul || output[31] != 3ul) return;
    if (args.final_byte_count > ~0ul - 7ul) return;
    ulong final_words = (args.final_byte_count + 7ul) / 8ul;
    if (!ig_nullable_range(args.final_base, final_words, args.output_word_count)
        || args.relation_a_base != args.final_base + final_words) return;
    output[31] = 4ul;
}

kernel void ig_nullable_relation_validate_output_scratch(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 2ul || output[31] != 4ul) return;
    if (!ig_nullable_range(args.relation_a_base, args.maximum_relation_cells,
            args.output_word_count)
        || args.relation_b_base != args.relation_a_base + args.maximum_relation_cells
        || !ig_nullable_range(args.relation_b_base, args.maximum_relation_cells,
            args.output_word_count)
        || args.parent_relation_base != args.relation_b_base + args.maximum_relation_cells
        || !ig_nullable_range(args.parent_relation_base, args.maximum_relation_cells,
            args.output_word_count)
        || args.lineage_a_base != args.parent_relation_base + args.maximum_relation_cells
        || !ig_nullable_range(args.lineage_a_base, args.maximum_relation_rows,
            args.output_word_count)
        || args.lineage_b_base != args.lineage_a_base + args.maximum_relation_rows
        || !ig_nullable_range(args.lineage_b_base, args.maximum_relation_rows,
            args.output_word_count)
        || args.slot_map_base != args.lineage_b_base + args.maximum_relation_rows
        || args.next_slot_map_base != args.slot_map_base + args.binding_slot_count
        || !ig_nullable_range(args.slot_map_base, args.binding_slot_count,
            args.output_word_count)
        || !ig_nullable_range(args.next_slot_map_base, args.binding_slot_count,
            args.output_word_count)
        || args.filter_truth_base != args.next_slot_map_base + args.binding_slot_count
        || !ig_nullable_range(args.filter_truth_base, args.maximum_filter_rows,
            args.output_word_count)
        || args.filter_rank_base != args.filter_truth_base + args.maximum_filter_rows
        || !ig_nullable_range(args.filter_rank_base, args.maximum_filter_rows,
            args.output_word_count)
        || args.control_base != args.filter_rank_base + args.maximum_filter_rows
        || !ig_nullable_range(args.control_base, IG_NULLABLE_RELATION_CONTROL_WORDS,
            args.output_word_count)
        || args.control_base + IG_NULLABLE_RELATION_CONTROL_WORDS
            != args.output_word_count) return;
    output[31] = 5ul;
}

kernel void ig_nullable_relation_validate_program(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[1] != 2ul || output[31] != 5ul) return;
    ulong descriptor_words = 0ul;
    ulong filter_words = 0ul;
    ulong optional_group_words = 0ul;
    ulong predicate_words = 0ul;
    ulong property_lane_words = 0ul;
    ulong filter_base = 0ul;
    ulong optional_group_base = 0ul;
    ulong predicate_base = 0ul;
    ulong property_lane_base = 0ul;
    if (!ig_nullable_product(args.stage_count,
            IG_NULLABLE_RELATION_STAGE_WORDS, descriptor_words)
        || !ig_nullable_product(args.filter_count,
            IG_NULLABLE_RELATION_FILTER_WORDS, filter_words)
        || !ig_nullable_product(args.optional_group_count,
            IG_NULLABLE_RELATION_OPTIONAL_GROUP_WORDS, optional_group_words)
        || !ig_nullable_product(ig_nullable_word(program, 9ul),
            IG_NULLABLE_RELATION_PREDICATE_WORDS, predicate_words)
        || !ig_nullable_product(ig_nullable_word(program, 10ul),
            IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS, property_lane_words)) return;
    filter_base = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS + descriptor_words;
    optional_group_base = filter_base + filter_words;
    predicate_base = optional_group_base + optional_group_words;
    property_lane_base = predicate_base + predicate_words;
    if (!ig_nullable_range(IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS,
            descriptor_words, args.program_word_count)
        || filter_base < IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
        || !ig_nullable_range(filter_base, filter_words, args.program_word_count)
        || optional_group_base < filter_base
        || !ig_nullable_range(
            optional_group_base, optional_group_words, args.program_word_count)
        || predicate_base < optional_group_base
        || !ig_nullable_range(predicate_base, predicate_words, args.program_word_count)
        || property_lane_base < predicate_base
        || !ig_nullable_range(
            property_lane_base, property_lane_words, args.program_word_count)
        || ig_nullable_word(program, 0ul) != IG_NULLABLE_RELATION_PROGRAM_MAGIC
        || ig_nullable_word(program, 1ul) != IG_NULLABLE_RELATION_VERSION
        || ig_nullable_word(program, 2ul) != args.stage_count
        || ig_nullable_word(program, 3ul) != args.program_word_count
        || ig_nullable_word(program, 4ul) != args.label_lane_count
        || ig_nullable_word(program, 5ul) != args.layers
        || ig_nullable_word(program, 6ul) != args.binding_slot_count
        || ig_nullable_word(program, 7ul) > args.binding_slot_count
        || ig_nullable_word(program, 8ul) != args.filter_count
        || ig_nullable_word(program, 10ul) != args.node_integer_lane_count
            + args.node_float_lane_count + args.node_string_lane_count
            + args.edge_integer_lane_count + args.edge_float_lane_count
            + args.edge_string_lane_count
        || ig_nullable_word(program, 11ul) != args.node_integer_lane_count
        || ig_nullable_word(program, 12ul) != args.node_string_lane_count
        || ig_nullable_word(program, 13ul) != args.edge_integer_lane_count
        || ig_nullable_word(program, 14ul) != args.edge_string_lane_count
        || ig_nullable_word(program, 15ul) != property_lane_base
        || ig_nullable_word(program, 16ul) != args.optional_group_count
        || ig_nullable_word(program, 17ul) != optional_group_base) return;
    ulong category_counts[6] = {0ul, 0ul, 0ul, 0ul, 0ul, 0ul};
    ulong prior_kind = 0ul;
    ulong prior_shape = 0ul;
    ulong prior_property = 0ul;
    for (ulong lane = 0ul; lane < ig_nullable_word(program, 10ul); ++lane) {
        ulong base = property_lane_base
            + lane * IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS;
        ulong kind = ig_nullable_word(program, base);
        ulong shape = ig_nullable_word(program, base + 1ul);
        ulong property = ig_nullable_word(program, base + 2ul);
        ulong category = ig_nullable_word(program, base + 3ul);
        if ((kind != 1ul && kind != 2ul)
            || (shape != 1ul && shape != 2ul && shape != 3ul)
            || property == ~0ul
            || (lane != 0ul && (kind < prior_kind
                || (kind == prior_kind && property < prior_property)
                || (kind == prior_kind && property == prior_property
                    && shape <= prior_shape)))) return;
        for (ulong metadata = 4ul;
                metadata < IG_NULLABLE_RELATION_PROPERTY_LANE_WORDS; ++metadata) {
            if (ig_nullable_word(program, base + metadata) != 0ul) return;
        }
        ulong category_index = (kind - 1ul) * 3ul + (shape - 1ul);
        if (category != category_counts[category_index]) return;
        ++category_counts[category_index];
        prior_kind = kind;
        prior_shape = shape;
        prior_property = property;
    }
    if (category_counts[0] != args.node_integer_lane_count
        || category_counts[1] != args.node_string_lane_count
        || category_counts[2] != args.node_float_lane_count
        || category_counts[3] != args.edge_integer_lane_count
        || category_counts[4] != args.edge_string_lane_count
        || category_counts[5] != args.edge_float_lane_count) return;
    for (ulong filter = 0ul; filter < args.filter_count; ++filter) {
        ulong descriptor = filter_base + filter * IG_NULLABLE_RELATION_FILTER_WORDS;
        ulong placement = ig_nullable_word(program, descriptor);
        ulong target_stage = ig_nullable_word(program, descriptor + 1ul);
        ulong first = ig_nullable_word(program, descriptor + 2ul);
        ulong count = ig_nullable_word(program, descriptor + 3ul);
        ulong receipt = ig_nullable_word(program, descriptor + 5ul);
        ulong instruction_words = 0ul;
        if ((placement != IG_NULLABLE_RELATION_FILTER_AFTER
                && placement != IG_NULLABLE_RELATION_FILTER_OPTIONAL_CANDIDATES
                && placement != IG_NULLABLE_RELATION_FILTER_OPTIONAL_GROUP)
            || (placement == IG_NULLABLE_RELATION_FILTER_OPTIONAL_GROUP
                ? target_stage >= args.optional_group_count
                : target_stage >= args.stage_count)
            || (placement == IG_NULLABLE_RELATION_FILTER_AFTER
                && target_stage + 1ul >= args.stage_count)
            || count == 0ul
            || first < predicate_base
            || (first - predicate_base) % IG_NULLABLE_RELATION_PREDICATE_WORDS != 0ul
            || !ig_nullable_product(count,
                IG_NULLABLE_RELATION_PREDICATE_WORDS, instruction_words)
            || !ig_nullable_range(first, instruction_words,
                predicate_base + predicate_words)
            || ig_nullable_word(program, descriptor + 4ul) == 0ul
            || receipt >= args.receipt_count
            || ig_nullable_word(program, descriptor + 6ul)
                != (placement == IG_NULLABLE_RELATION_FILTER_AFTER ? 7ul : 8ul)
            || ig_nullable_word(program, descriptor + 7ul) != 0ul) return;
        if (placement == IG_NULLABLE_RELATION_FILTER_OPTIONAL_CANDIDATES) {
            ulong stage_descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
                + target_stage * IG_NULLABLE_RELATION_STAGE_WORDS;
            ulong opcode = ig_nullable_word(program, stage_descriptor);
            if ((opcode != IG_NULLABLE_RELATION_STAGE_NODE_SCAN
                    && opcode != IG_NULLABLE_RELATION_STAGE_EXPAND)
                || ig_nullable_word(program, stage_descriptor + 1ul) != 2ul) return;
        }
    }
    ulong prior_group_last = 0ul;
    for (ulong group = 0ul; group < args.optional_group_count; ++group) {
        ulong descriptor = optional_group_base
            + group * IG_NULLABLE_RELATION_OPTIONAL_GROUP_WORDS;
        ulong first_stage = ig_nullable_word(program, descriptor);
        ulong last_stage = ig_nullable_word(program, descriptor + 1ul);
        ulong introduced_offset = ig_nullable_word(program, descriptor + 2ul);
        ulong introduced_count = ig_nullable_word(program, descriptor + 3ul);
        ulong introduced_words = 0ul;
        if (first_stage >= last_stage || last_stage >= args.stage_count
            || (group != 0ul && first_stage <= prior_group_last)
            || introduced_count == 0ul
            || !ig_nullable_product(introduced_count, 2ul, introduced_words)
            || introduced_offset < property_lane_base + property_lane_words
            || !ig_nullable_range(
                introduced_offset, introduced_words, args.program_word_count)
            || ig_nullable_word(program, descriptor + 4ul) == 0ul
            || ig_nullable_word(program, descriptor + 5ul) >= args.receipt_count
            || ig_nullable_word(program, descriptor + 6ul) != 9ul
            || ig_nullable_word(program, descriptor + 7ul) != 0ul) return;
        for (ulong stage = first_stage; stage <= last_stage; ++stage) {
            ulong stage_descriptor = IG_NULLABLE_RELATION_PROGRAM_HEADER_WORDS
                + stage * IG_NULLABLE_RELATION_STAGE_WORDS;
            ulong opcode = ig_nullable_word(program, stage_descriptor);
            if (ig_nullable_word(program, stage_descriptor + 1ul) != 2ul
                || (stage == first_stage
                    ? (opcode != IG_NULLABLE_RELATION_STAGE_NODE_SCAN
                        && opcode != IG_NULLABLE_RELATION_STAGE_EXPAND)
                    : opcode != IG_NULLABLE_RELATION_STAGE_EXPAND)) return;
        }
        for (ulong binding = 0ul; binding < introduced_count; ++binding) {
            ulong slot = ig_nullable_word(
                program, introduced_offset + binding * 2ul);
            ulong kind = ig_nullable_word(
                program, introduced_offset + binding * 2ul + 1ul);
            if (slot >= args.binding_slot_count || (kind != 1ul && kind != 2ul)) return;
            for (ulong earlier = 0ul; earlier < binding; ++earlier) {
                if (ig_nullable_word(program, introduced_offset + earlier * 2ul) == slot) return;
            }
        }
        prior_group_last = last_stage;
    }
    output[31] = 6ul;
}

kernel void ig_nullable_relation_initialize_state(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant NullableRelationArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
