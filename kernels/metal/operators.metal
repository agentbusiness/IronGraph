kernel void ig_pattern_pair_scan(
    device const long* packet [[buffer(0)]],
    device const uchar* node_active [[buffer(1)]],
    device const uchar* node_layers [[buffer(2)]],
    device uchar* n_visible [[buffer(3)]],
    device uchar* m_visible [[buffer(4)]],
    device atomic_uint* scan_summary [[buffer(5)]],
    constant PatternPairPredicateArgs& args [[buffer(6)]],
    uint slot [[thread_position_in_grid]]) {
    if (slot >= args.node_count) return;
    if (!ig_pattern_pair_contract_is_valid(packet, args)) {
        n_visible[slot] = uchar(2);
        m_visible[slot] = uchar(2);
        atomic_fetch_min_explicit(&scan_summary[2], 2u, memory_order_relaxed);
        return;
    }
    uchar active = node_active[slot];
    uchar layer = node_layers[slot];
    if (active > 1 || layer > int(IG_MAX_LAYER)) {
        n_visible[slot] = uchar(2);
        m_visible[slot] = uchar(2);
        atomic_fetch_min_explicit(&scan_summary[2], 2u, memory_order_relaxed);
        return;
    }
    uint visible = active != 0 && (args.layer_mask & (1u << uint(layer))) != 0 ? 1 : 0;
    n_visible[slot] = uchar(visible);
    m_visible[slot] = uchar(visible);
    if (visible != 0) {
        atomic_fetch_add_explicit(&scan_summary[0], 1u, memory_order_relaxed);
        atomic_fetch_add_explicit(&scan_summary[1], 1u, memory_order_relaxed);
    }
}

kernel void ig_pattern_pair_traverse(
    device const long* packet [[buffer(0)]],
    device const uint* outgoing_offsets [[buffer(1)]],
    device const uint* outgoing_neighbors [[buffer(2)]],
    device const uint* outgoing_edges [[buffer(3)]],
    device const uint* incoming_offsets [[buffer(4)]],
    device const uint* incoming_neighbors [[buffer(5)]],
    device const uint* incoming_edges [[buffer(6)]],
    device const uchar* node_active [[buffer(7)]],
    device const uchar* node_layers [[buffer(8)]],
    device const uchar* edge_active [[buffer(9)]],
    device const uchar* edge_layers [[buffer(10)]],
    device const long* edge_types [[buffer(11)]],
    device const uchar* n_visible [[buffer(12)]],
    device const uchar* m_visible [[buffer(13)]],
    device uchar* masks [[buffer(14)]],
    device ulong* traversal_bits [[buffer(15)]],
    constant PatternPairPredicateArgs& args [[buffer(16)]],
    uint local_position [[thread_position_in_grid]]) {
    if (local_position >= args.dispatch_count) return;
    if (!ig_pattern_pair_contract_is_valid(packet, args) || args.node_count == 0) {
        masks[local_position] = uchar(2);
        return;
    }
    ulong position = args.pair_base + ulong(local_position);
    if (position >= args.pair_count) {
        masks[local_position] = uchar(2);
        return;
    }
    uint source = uint(position / ulong(args.node_count));
    uint target = uint(position % ulong(args.node_count));
    uint source_visible = n_visible[source];
    uint target_visible = m_visible[target];
    if (source_visible > 1 || target_visible > 1) {
        masks[local_position] = uchar(2);
        return;
    }
    if (source_visible == 0 || target_visible == 0
        || ig_pattern_pair_word(packet, 2) == 2) {
        masks[local_position] = uchar(0);
        return;
    }
    ulong length = ig_pattern_pair_word(packet, 3);
    uint witness = 0;
    if (length == 0) {
        witness = ig_pattern_pair_one(
            packet,
            outgoing_offsets,
            outgoing_neighbors,
            outgoing_edges,
            incoming_offsets,
            incoming_neighbors,
            incoming_edges,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            source,
            target,
            args);
    } else if (length == 2) {
        witness = ig_pattern_pair_exact_two(
            packet,
            outgoing_offsets,
            outgoing_neighbors,
            outgoing_edges,
            incoming_offsets,
            incoming_neighbors,
            incoming_edges,
            node_active,
            node_layers,
            edge_active,
            edge_layers,
            edge_types,
            source,
            target,
            args);
    } else {
        ulong scratch_base = ulong(local_position)
            * ulong(args.traversal_word_count) * 3ul;
        device ulong* visited = traversal_bits + scratch_base;
        device ulong* frontier = visited + args.traversal_word_count;
        device ulong* next = frontier + args.traversal_word_count;
        if (source == target) {
            witness = ig_pattern_pair_nonempty_cycle(
                packet,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                source,
                visited,
                frontier,
                next,
                args);
        } else {
            witness = ig_pattern_pair_reachable(
                packet,
                outgoing_offsets,
                outgoing_neighbors,
                outgoing_edges,
                incoming_offsets,
                incoming_neighbors,
                incoming_edges,
                node_active,
                node_layers,
                edge_active,
                edge_layers,
                edge_types,
                source,
                target,
                0,
                0,
                visited,
                frontier,
                next,
                args);
        }
    }
    masks[local_position] = uchar(witness);
}

// Pair positions already are the required row-major key. This pass assigns each selected key a
// deterministic local rank and records tile counts; output ordering never depends on atomics.
kernel void ig_pattern_pair_tile_counts(
    device const uchar* masks [[buffer(0)]],
    device uint* local_ranks [[buffer(1)]],
    device uint4* block_metadata [[buffer(2)]],
    constant PatternPairPredicateArgs& args [[buffer(3)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup uint scratch[IG_PATTERN_COMPACT_THREADS];
    uint base = block * IG_PATTERN_COMPACT_TILE_ROWS;
    uint selected_flags[IG_PATTERN_COMPACT_ROWS_PER_LANE];
    uint selected_in_lane = 0;
    uint first_error = IG_PATTERN_COMPACT_NO_ERROR;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        uint position = base + lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item;
        uchar value = position < args.dispatch_count ? masks[position] : uchar(0);
        uint selected = position < args.dispatch_count && value == 1 ? 1 : 0;
        selected_flags[item] = selected;
        selected_in_lane += selected;
        if (position < args.dispatch_count && value > 1) {
            first_error = min(first_error, ig_pattern_error_word(position, 2));
        }
    }
    uint lane_prefix = ig_pattern_exclusive_prefix_256(
        scratch, lane, selected_in_lane);
    uint selected_total = scratch[IG_PATTERN_COMPACT_THREADS - 1];
    uint within_lane = 0;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        uint position = base + lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item;
        if (position < args.dispatch_count) {
            local_ranks[position] = lane_prefix + within_lane;
        }
        within_lane += selected_flags[item];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    first_error = ig_pattern_minimum_256(scratch, lane, first_error);
    if (lane == 0) {
        block_metadata[block] = uint4(selected_total, 0, first_error, 0);
    }
}

// One group resolves the prefixes for one reusable physical chunk. Chunks are submitted in
// increasing `pair_base` order, so the global offset remains deterministic without atomics.
kernel void ig_pattern_pair_block_scan(
    device const long* packet [[buffer(0)]],
    device const uint4* block_metadata [[buffer(1)]],
    device uint* block_offsets [[buffer(2)]],
    device ulong* global_summary [[buffer(3)]],
    device ulong* chunk_summary [[buffer(4)]],
    constant PatternPairPredicateArgs& args [[buffer(5)]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup uint scratch[IG_PATTERN_COMPACT_THREADS];
    uint block_count = uint(max(1ul,
        (ulong(args.dispatch_count) + IG_PATTERN_COMPACT_TILE_ROWS - 1)
            / IG_PATTERN_COMPACT_TILE_ROWS));
    uint selected_chunks[IG_PATTERN_COMPACT_ROWS_PER_LANE];
    uint selected_in_lane = 0;
    uint first_error = IG_PATTERN_COMPACT_NO_ERROR;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        uint block = lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item;
        uint4 metadata = block < block_count
            ? block_metadata[block]
            : uint4(0, 0, IG_PATTERN_COMPACT_NO_ERROR, 0);
        selected_chunks[item] = metadata.x;
        selected_in_lane += metadata.x;
        first_error = min(first_error, metadata.z);
    }
    uint lane_prefix = ig_pattern_exclusive_prefix_256(
        scratch, lane, selected_in_lane);
    uint selected_total = scratch[IG_PATTERN_COMPACT_THREADS - 1];
    uint within_lane = 0;
    for (uint item = 0; item < IG_PATTERN_COMPACT_ROWS_PER_LANE; ++item) {
        uint block = lane * IG_PATTERN_COMPACT_ROWS_PER_LANE + item;
        if (block < block_count) block_offsets[block] = lane_prefix + within_lane;
        within_lane += selected_chunks[item];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    first_error = ig_pattern_minimum_256(scratch, lane, first_error);

    ulong expected_words = IG_PATTERN_PAIR_FRAME_HEADER_WORDS
        + ulong(IG_PATTERN_PAIR_RECEIPTS) * IG_PATTERN_PAIR_RECEIPT_WORDS
        + args.output_capacity * 3ul;
    if (lane == 0) {
        ulong base = global_summary[0];
        ulong status = global_summary[1];
        ulong next = base;
        if (status == 1ul
            && (expected_words != args.output_word_count
            || !ig_pattern_pair_contract_is_valid(packet, args)
            || first_error != IG_PATTERN_COMPACT_NO_ERROR)) {
            status = 2ul;
        } else if (status == 1ul) {
            ulong selected = ulong(selected_total);
            if (base > args.pair_count || selected > args.pair_count - base) {
                status = 2ul;
            } else {
                next = base + selected;
                if (base > args.output_capacity
                    || selected > args.output_capacity - base) {
                    status = 3ul;
                }
            }
        }
        chunk_summary[0] = base;
        chunk_summary[1] = ulong(selected_total);
        chunk_summary[2] = status;
        global_summary[0] = next;
        global_summary[1] = status;
    }
}

kernel void ig_pattern_pair_scatter(
    device const uchar* masks [[buffer(0)]],
    device const uint* local_ranks [[buffer(1)]],
    device const uint* block_offsets [[buffer(2)]],
    device const ulong* chunk_summary [[buffer(3)]],
    device ulong* output [[buffer(4)]],
    constant PatternPairPredicateArgs& args [[buffer(5)]],
    uint local_position [[thread_position_in_grid]]) {
    if (local_position >= args.dispatch_count
        || chunk_summary[2] != 1ul
        || masks[local_position] != 1) return;
    uint block = local_position / IG_PATTERN_COMPACT_TILE_ROWS;
    ulong destination = chunk_summary[0]
        + ulong(block_offsets[block]) + ulong(local_ranks[local_position]);
    if (destination >= chunk_summary[0] + chunk_summary[1]
        || destination >= args.output_capacity) return;
    ulong position = args.pair_base + ulong(local_position);
    ulong rows_base = IG_PATTERN_PAIR_FRAME_HEADER_WORDS
        + ulong(IG_PATTERN_PAIR_RECEIPTS) * IG_PATTERN_PAIR_RECEIPT_WORDS;
    ulong output_base = rows_base + destination * 3ul;
    output[output_base] = position;
    output[output_base + 1] = position / ulong(args.node_count);
    output[output_base + 2] = position % ulong(args.node_count);
}

kernel void ig_pattern_pair_publish(
    device const long* packet [[buffer(0)]],
    device atomic_uint* scan_summary [[buffer(1)]],
    device const ulong* global_summary [[buffer(2)]],
    device ulong* output [[buffer(3)]],
    constant PatternPairPredicateArgs& args [[buffer(4)]],
    uint lane [[thread_index_in_threadgroup]]) {
    ulong visible_n = ulong(atomic_load_explicit(&scan_summary[0], memory_order_relaxed));
    ulong visible_m = ulong(atomic_load_explicit(&scan_summary[1], memory_order_relaxed));
    uint scan_error = atomic_load_explicit(&scan_summary[2], memory_order_relaxed);
    ulong visible_pairs = visible_n * visible_m;
    ulong selected_total = global_summary[0];
    ulong status = global_summary[1];
    ulong expected_words = IG_PATTERN_PAIR_FRAME_HEADER_WORDS
        + ulong(IG_PATTERN_PAIR_RECEIPTS) * IG_PATTERN_PAIR_RECEIPT_WORDS
        + args.output_capacity * 3ul;
    if (status == 1ul
        && (expected_words != args.output_word_count
            || !ig_pattern_pair_contract_is_valid(packet, args)
            || scan_error != IG_PATTERN_COMPACT_NO_ERROR
            || selected_total > visible_pairs)) {
        status = 2ul;
    }
    if (lane == 0) {
        output[0] = IG_PATTERN_PAIR_MAGIC;
        output[1] = 2;
        output[2] = args.execution_high;
        output[3] = args.execution_low;
        output[4] = args.pair_count;
        output[5] = status == 1ul || status == 3ul ? selected_total : 0ul;
        output[6] = args.receipt_count;
        output[7] = 2;
        output[8] = args.bookmark_term;
        output[9] = args.bookmark_index;
        output[10] = args.graph_revision;
        output[11] = args.layout_version;
    }
    if (status == 1ul && lane < IG_PATTERN_PAIR_RECEIPTS) {
        uint index = lane;
        ulong receipt = IG_PATTERN_PAIR_FRAME_HEADER_WORDS
            + ulong(index) * IG_PATTERN_PAIR_RECEIPT_WORDS;
        output[receipt] = args.execution_high;
        output[receipt + 1] = args.execution_low;
        output[receipt + 5] = 0;
        output[receipt + 8] = 2;
        if (index == 0) {
            output[receipt + 2] = args.n_scan_obligation_id;
            output[receipt + 3] = 7;
            output[receipt + 4] = 7;
            output[receipt + 6] = args.node_count;
            output[receipt + 7] = visible_n;
        } else if (index == 1) {
            output[receipt + 2] = args.m_scan_obligation_id;
            output[receipt + 3] = 7;
            output[receipt + 4] = 8;
            output[receipt + 6] = args.node_count;
            output[receipt + 7] = visible_m;
        } else if (index == 2) {
            output[receipt + 2] = args.cartesian_obligation_id;
            output[receipt + 3] = 8;
            output[receipt + 4] = 9;
            output[receipt + 6] = visible_pairs;
            output[receipt + 7] = visible_pairs;
        } else if (index == 3) {
            output[receipt + 2] = ig_pattern_pair_word(packet, 5);
            output[receipt + 3] = 5;
            output[receipt + 4] = 4;
            output[receipt + 6] = visible_pairs;
            output[receipt + 7] = selected_total;
        } else {
            output[receipt + 2] = ig_pattern_pair_word(packet, 6);
            output[receipt + 3] = 6;
            output[receipt + 4] = 5;
            output[receipt + 6] = visible_pairs;
            output[receipt + 7] = selected_total;
        }
    }
    threadgroup_barrier(mem_flags::mem_device);
    if (lane == 0) output[1] = status;
}

kernel void ig_expand_csr(
    device const uint* offsets [[buffer(0)]],
    device const uint* neighbors [[buffer(1)]],
    device const uint* edges [[buffer(2)]],
    device const uint* sources [[buffer(3)]],
    device uint3* output [[buffer(4)]],
    device atomic_uint* output_count [[buffer(5)]],
    constant uint& source_count [[buffer(6)]],
    uint index [[thread_position_in_grid]]) {
    if (index >= source_count) return;
    uint source = sources[index];
    for (uint offset = offsets[source]; offset < offsets[source + 1]; ++offset) {
        uint destination = atomic_fetch_add_explicit(output_count, 1, memory_order_relaxed);
        output[destination] = uint3(source, neighbors[offset], edges[offset]);
    }
}

// Resident sparse graph analytics. Iterative algorithms are deliberately split into phase
// kernels: Metal provides no grid-wide barrier inside one dispatch. The host may encode several
// ordered phases in one command buffer, but every global dependency crosses a dispatch boundary.

constant uint IG_GRAPH_UNREACHED = 0xffffffffu;
constant uint IG_GRAPH_REDUCTION_TILE = 256u;

struct IgGraphBfsArgs {
    uint node_count;
    uint edge_count;
    uint adjacency_count;
    uint source;
    uint layer_mask;
    uint depth;
    uint edge_begin;
    uint edge_end;
    uint node_begin;
    uint overlay_count;
};

inline bool ig_graph_layer_visible(uchar layer, uint layer_mask) {
    return layer < 32u && (layer_mask & (1u << uint(layer))) != 0u;
}

kernel void ig_graph_bfs_initialize(
    device const uchar* visible_nodes [[buffer(0)]],
    device atomic_uint* distances [[buffer(1)]],
    device uchar* frontier [[buffer(2)]],
    device uchar* next_frontier [[buffer(3)]],
    device atomic_uint* next_count [[buffer(4)]],
    constant IgGraphBfsArgs& args [[buffer(5)]],
    uint local_node [[thread_position_in_grid]]) {
    uint node = args.node_begin + local_node;
    if (node >= args.node_count) return;
    bool source = node == args.source && visible_nodes[node] != 0u;
    atomic_store_explicit(
        distances + node,
        source ? 0u : IG_GRAPH_UNREACHED,
        memory_order_relaxed);
    frontier[node] = source ? 1u : 0u;
    next_frontier[node] = 0u;
    if (node == 0u) {
        bool seed_visible = args.source < args.node_count && visible_nodes[args.source] != 0u;
        atomic_store_explicit(next_count, seed_visible ? 1u : 0u, memory_order_relaxed);
        atomic_store_explicit(next_count + 1, 0u, memory_order_relaxed);
    }
}

kernel void ig_graph_bfs_prepare_step(
    device uchar* next_frontier [[buffer(0)]],
    device atomic_uint* next_count [[buffer(1)]],
    constant IgGraphBfsArgs& args [[buffer(2)]],
    uint local_node [[thread_position_in_grid]]) {
    uint node = args.node_begin + local_node;
    if (node >= args.node_count) return;
    next_frontier[node] = 0u;
    if (node == 0u) atomic_store_explicit(next_count, 0u, memory_order_relaxed);
}

// Top-down BFS over outgoing CSR. Exactly one successful distance CAS publishes each node into
// the next frontier, so the byte write has a single writer even with parallel edges.
kernel void ig_graph_bfs_top_down_step(
    device const uint* outgoing_offsets [[buffer(0)]],
    device const uint* outgoing_neighbors [[buffer(1)]],
    device const uint* outgoing_edges [[buffer(2)]],
    device const uint* outgoing_overlay [[buffer(3)]],
    device const uchar* visible_nodes [[buffer(4)]],
    device const uchar* edge_active [[buffer(5)]],
    device const uchar* edge_layers [[buffer(6)]],
    device const uchar* frontier [[buffer(7)]],
    device atomic_uint* distances [[buffer(8)]],
    device uchar* next_frontier [[buffer(9)]],
    device atomic_uint* next_count [[buffer(10)]],
    constant IgGraphBfsArgs& args [[buffer(11)]],
    uint local_source [[thread_position_in_grid]]) {
    uint source = args.node_begin + local_source;
    if (source >= args.node_count || frontier[source] == 0u || visible_nodes[source] == 0u) {
        return;
    }
    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(outgoing_offsets, args.adjacency_count,
            outgoing_overlay, args.overlay_count, source, row)
            || args.edge_begin > args.edge_end
            || args.edge_end > max(args.adjacency_count, args.edge_count)) {
        atomic_fetch_max_explicit(next_count + 1, 1u, memory_order_relaxed);
        return;
    }
    uint begin = row.begin;
    uint end = row.end;
    begin = max(begin, args.edge_begin);
    end = min(end, args.edge_end);
    for (uint position = begin; position < end; ++position) {
        uint edge = ig_csr_resolved_edge(
            outgoing_edges, outgoing_overlay, args.overlay_count, row, position);
        uint target = ig_csr_resolved_neighbor(
            outgoing_neighbors, outgoing_overlay, args.overlay_count, row, position);
        if (edge >= args.edge_count || target >= args.node_count) {
            atomic_fetch_max_explicit(next_count + 1, 2u, memory_order_relaxed);
            continue;
        }
        // A layer index is corrupt when it exceeds the highest defined layer, not when it exceeds
        // the two that existed when this was written; `Layer::Workspace = 2` is ordinary data.
        // IG_MAX_LAYER is the same bound the other 20-odd checks in this file already use.
        if (edge_layers[edge] > IG_MAX_LAYER) {
            atomic_fetch_max_explicit(next_count + 1, 3u, memory_order_relaxed);
            continue;
        }
        if (edge_active[edge] > 1u) {
            atomic_fetch_max_explicit(next_count + 1, 3u, memory_order_relaxed);
            continue;
        }
        if (edge_active[edge] == 0u
            || !ig_graph_layer_visible(edge_layers[edge], args.layer_mask)
            || visible_nodes[target] == 0u) {
            continue;
        }
        uint previous = atomic_fetch_min_explicit(
            distances + target, args.depth, memory_order_relaxed);
        bool discovered = previous == IG_GRAPH_UNREACHED;
        if (discovered) {
            next_frontier[target] = 1u;
            atomic_fetch_add_explicit(next_count, 1u, memory_order_relaxed);
        }
    }
}

// Bottom-up counterpart for dense frontiers. A target is written only by its own lane, making the
// first matching incoming edge sufficient and deterministic for the distance-only BFS contract.
kernel void ig_graph_bfs_bottom_up_step(
    device const uint* incoming_offsets [[buffer(0)]],
    device const uint* incoming_neighbors [[buffer(1)]],
    device const uint* incoming_edges [[buffer(2)]],
    device const uint* incoming_overlay [[buffer(3)]],
    device const uchar* visible_nodes [[buffer(4)]],
    device const uchar* edge_active [[buffer(5)]],
    device const uchar* edge_layers [[buffer(6)]],
    device const uchar* frontier [[buffer(7)]],
    device atomic_uint* distances [[buffer(8)]],
    device uchar* next_frontier [[buffer(9)]],
    device atomic_uint* next_count [[buffer(10)]],
    constant IgGraphBfsArgs& args [[buffer(11)]],
    uint local_target [[thread_position_in_grid]]) {
    uint target = args.node_begin + local_target;
    if (target >= args.node_count || visible_nodes[target] == 0u
        || atomic_load_explicit(distances + target, memory_order_relaxed) != IG_GRAPH_UNREACHED) {
        return;
    }
    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(incoming_offsets, args.adjacency_count,
            incoming_overlay, args.overlay_count, target, row)
            || args.edge_begin > args.edge_end
            || args.edge_end > max(args.adjacency_count, args.edge_count)) {
        atomic_fetch_max_explicit(next_count + 1, 1u, memory_order_relaxed);
        return;
    }
    uint begin = row.begin;
    uint end = row.end;
    begin = max(begin, args.edge_begin);
    end = min(end, args.edge_end);
    for (uint position = begin; position < end; ++position) {
        uint edge = ig_csr_resolved_edge(
            incoming_edges, incoming_overlay, args.overlay_count, row, position);
        uint source = ig_csr_resolved_neighbor(
            incoming_neighbors, incoming_overlay, args.overlay_count, row, position);
        if (edge >= args.edge_count || source >= args.node_count) {
            atomic_fetch_max_explicit(next_count + 1, 2u, memory_order_relaxed);
            continue;
        }
        // See the outgoing sweep: a Workspace layer index is data, not corruption.
        if (edge_layers[edge] > IG_MAX_LAYER) {
            atomic_fetch_max_explicit(next_count + 1, 3u, memory_order_relaxed);
            continue;
        }
        if (edge_active[edge] > 1u) {
            atomic_fetch_max_explicit(next_count + 1, 3u, memory_order_relaxed);
            continue;
        }
        if (edge_active[edge] == 0u
            || !ig_graph_layer_visible(edge_layers[edge], args.layer_mask)
            || visible_nodes[source] == 0u || frontier[source] == 0u) {
            continue;
        }
        uint previous = atomic_fetch_min_explicit(
            distances + target, args.depth, memory_order_relaxed);
        bool discovered = previous == IG_GRAPH_UNREACHED;
        if (discovered) {
            next_frontier[target] = 1u;
            atomic_fetch_add_explicit(next_count, 1u, memory_order_relaxed);
        }
        return;
    }
}

// Unit-weight Dijkstra shares BFS's hop-distance phase. This final pass converts every reached
// hop count to an exact binary64 payload and derives the deterministic predecessor independently
// of frontier scheduling: among all visible incoming edges from the preceding level, the smallest
// dense source row wins. `control[0]` must be zeroed before dispatch and is a deterministic status
// maximum: 0=success, 1=invalid arguments, 2=CSR bounds, 3=corrupt visibility metadata.
constant uint IG_GRAPH_DIJKSTRA_STATUS_INVALID_ARGUMENT = 1u;
constant uint IG_GRAPH_DIJKSTRA_STATUS_CSR_BOUNDS = 2u;
constant uint IG_GRAPH_DIJKSTRA_STATUS_METADATA = 3u;
constant ulong IG_GRAPH_F64_INFINITY = 0x7ff0000000000000ul;

struct IgGraphDijkstraUnitArgs {
    uint node_count;
    uint edge_count;
    uint incoming_adjacency_count;
    uint layer_mask;
    uint edge_begin;
    uint edge_end;
    uint initialize;
    uint incoming_overlay_count;
    uint node_begin;
};

inline ulong ig_graph_u32_to_f64_bits(uint value) {
    if (value == 0u) return 0ul;
    uint most_significant = 31u - clz(value);
    ulong exponent = ulong(most_significant + 1023u) << 52u;
    ulong normalized = ulong(value) << (52u - most_significant);
    return exponent | (normalized & 0x000ffffffffffffful);
}

kernel void ig_graph_dijkstra_unit_prepare(
    device atomic_uint* control [[buffer(0)]],
    uint index [[thread_position_in_grid]]) {
    if (index == 0u) atomic_store_explicit(control, 0u, memory_order_relaxed);
}

kernel void ig_graph_dijkstra_unit_finalize(
    device const uint* incoming_offsets [[buffer(0)]],
    device const uint* incoming_neighbors [[buffer(1)]],
    device const uint* incoming_edges [[buffer(2)]],
    device const uint* incoming_overlay [[buffer(3)]],
    device const uchar* visible_nodes [[buffer(4)]],
    device const uchar* edge_active [[buffer(5)]],
    device const uchar* edge_layers [[buffer(6)]],
    device const atomic_uint* distances [[buffer(7)]],
    device ulong* cost_bits [[buffer(8)]],
    device uint* predecessors [[buffer(9)]],
    device atomic_uint* control [[buffer(10)]],
    constant IgGraphDijkstraUnitArgs& args [[buffer(11)]],
    uint local_target [[thread_position_in_grid]]) {
    uint target = args.node_begin + local_target;
    if (target >= args.node_count) return;
    if (args.initialize != 0u) {
        cost_bits[target] = IG_GRAPH_F64_INFINITY;
        predecessors[target] = IG_GRAPH_UNREACHED;
    }

    if (args.initialize > 1u
            || args.edge_begin > args.edge_end
            || args.edge_end > max(args.incoming_adjacency_count, args.edge_count)) {
        atomic_fetch_max_explicit(
            control, IG_GRAPH_DIJKSTRA_STATUS_INVALID_ARGUMENT, memory_order_relaxed);
        return;
    }
    uchar target_visible = visible_nodes[target];
    if (target_visible > 1u) {
        atomic_fetch_max_explicit(
            control, IG_GRAPH_DIJKSTRA_STATUS_METADATA, memory_order_relaxed);
        return;
    }
    uint target_distance = atomic_load_explicit(distances + target, memory_order_relaxed);
    if (target_visible == 0u || target_distance == IG_GRAPH_UNREACHED) return;
    cost_bits[target] = ig_graph_u32_to_f64_bits(target_distance);
    if (target_distance == 0u) return;

    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(incoming_offsets, args.incoming_adjacency_count,
            incoming_overlay, args.incoming_overlay_count, target, row)) {
        atomic_fetch_max_explicit(
            control, IG_GRAPH_DIJKSTRA_STATUS_CSR_BOUNDS, memory_order_relaxed);
        return;
    }
    uint begin = row.begin;
    uint end = row.end;
    begin = max(begin, args.edge_begin);
    end = min(end, args.edge_end);
    uint required_source_distance = target_distance - 1u;
    uint best = predecessors[target];
    for (uint position = begin; position < end; ++position) {
        uint edge = ig_csr_resolved_edge(
            incoming_edges, incoming_overlay, args.incoming_overlay_count, row, position);
        uint source = ig_csr_resolved_neighbor(
            incoming_neighbors, incoming_overlay, args.incoming_overlay_count, row, position);
        if (edge >= args.edge_count || source >= args.node_count) {
            atomic_fetch_max_explicit(
                control, IG_GRAPH_DIJKSTRA_STATUS_CSR_BOUNDS, memory_order_relaxed);
            continue;
        }
        uchar source_visible = visible_nodes[source];
        uchar active = edge_active[edge];
        uchar layer = edge_layers[edge];
        if (source_visible > 1u || active > 1u || layer > IG_MAX_LAYER) {
            atomic_fetch_max_explicit(
                control, IG_GRAPH_DIJKSTRA_STATUS_METADATA, memory_order_relaxed);
            continue;
        }
        if (source_visible == 0u || active == 0u
                || !ig_graph_layer_visible(layer, args.layer_mask)) {
            continue;
        }
        uint source_distance = atomic_load_explicit(
            distances + source, memory_order_relaxed);
        if (source_distance == required_source_distance && source < best) best = source;
    }
    predecessors[target] = best;
}

struct IgGraphPageRankArgs {
    uint node_count;
    uint edge_count;
    uint adjacency_count;
    uint visible_count;
    uint layer_mask;
    uint iteration;
    uint range_begin;
    uint range_count;
    uint quantum;
    uint overlay_count;
    ulong damping_bits;
    ulong tolerance_bits;
};

// PageRank uses software IEEE-754 binary64 because Apple GPUs do not expose native FP64. Every
// reduction follows the CPU reference's canonical order. Host-issued edge/node tiles bound every
// dispatch and provide cancellation points. control[0] is converged, control[1] is completed
// iterations, control[2] is corruption status (1=CSR bounds, 2=ordinal bounds, 3=metadata), and
// control[3] is the number of pull rows that still have input after the current quantum.
kernel void ig_graph_pagerank_prepare(
    device atomic_uint* control [[buffer(0)]],
    device ulong* scalars [[buffer(1)]],
    uint index [[thread_position_in_grid]]) {
    if (index != 0u) return;
    atomic_store_explicit(control + 0, 0u, memory_order_relaxed);
    atomic_store_explicit(control + 1, 0u, memory_order_relaxed);
    atomic_store_explicit(control + 2, 0u, memory_order_relaxed);
    atomic_store_explicit(control + 3, 0u, memory_order_relaxed);
    scalars[0] = 0ul;
    scalars[1] = 0ul;
}

kernel void ig_graph_pagerank_initialize_nodes(
    device const uchar* visible_nodes [[buffer(0)]],
    device atomic_uint* out_degree [[buffer(1)]],
    device uint* cursor [[buffer(2)]],
    device ulong* rank_a [[buffer(3)]],
    device ulong* rank_b [[buffer(4)]],
    device atomic_uint* control [[buffer(5)]],
    constant IgGraphPageRankArgs& args [[buffer(6)]],
    uint local_node [[thread_position_in_grid]]) {
    if (local_node >= args.range_count) return;
    if (args.range_begin > args.node_count
            || local_node >= args.node_count - args.range_begin) return;
    uint node = args.range_begin + local_node;
    if (node >= args.node_count) return;
    uchar visibility = visible_nodes[node];
    if (visibility > 1u) atomic_fetch_max_explicit(control + 2, 3u, memory_order_relaxed);
    atomic_store_explicit(out_degree + node, 0u, memory_order_relaxed);
    cursor[node] = 0u;
    ulong initial = visibility == 1u
        ? ig_scalar_program_f64_divide(
            0x3ff0000000000000ul, ig_graph_u32_to_f64_bits(args.visible_count))
        : 0ul;
    rank_a[node] = initial;
    rank_b[node] = initial;
}

kernel void ig_graph_pagerank_degree_edges(
    device const uint* edge_targets [[buffer(0)]],
    device const uint* edge_sources [[buffer(2)]],
    device const uchar* visible_nodes [[buffer(3)]],
    device const uchar* edge_active [[buffer(4)]],
    device const uchar* edge_layers [[buffer(5)]],
    device atomic_uint* out_degree [[buffer(6)]],
    device atomic_uint* control [[buffer(7)]],
    constant IgGraphPageRankArgs& args [[buffer(8)]],
    uint local_position [[thread_position_in_grid]]) {
    if (local_position >= args.range_count) return;
    if (args.range_begin > args.edge_count
            || args.range_count > args.edge_count - args.range_begin) {
        atomic_fetch_max_explicit(control + 2, 1u, memory_order_relaxed);
        return;
    }
    uint position = args.range_begin + local_position;
    uint edge = position;
    uint target = edge_targets[edge];
    if (edge >= args.edge_count || target >= args.node_count) {
        atomic_fetch_max_explicit(control + 2, 2u, memory_order_relaxed);
        return;
    }
    uint source = edge_sources[edge];
    if (source >= args.node_count) {
        atomic_fetch_max_explicit(control + 2, 2u, memory_order_relaxed);
        return;
    }
    uchar source_visible = visible_nodes[source];
    uchar target_visible = visible_nodes[target];
    uchar active = edge_active[edge];
    uchar layer = edge_layers[edge];
    if (source_visible > 1u || target_visible > 1u || active > 1u || layer > IG_MAX_LAYER) {
        atomic_fetch_max_explicit(control + 2, 3u, memory_order_relaxed);
        return;
    }
    if (source_visible == 1u && target_visible == 1u && active == 1u
            && ig_graph_layer_visible(layer, args.layer_mask)) {
        atomic_fetch_add_explicit(out_degree + source, 1u, memory_order_relaxed);
    }
}

kernel void ig_graph_pagerank_dangling_chunk(
    device const uchar* visible_nodes [[buffer(0)]],
    device const atomic_uint* out_degree [[buffer(1)]],
    device const ulong* current_rank [[buffer(2)]],
    device const atomic_uint* control [[buffer(3)]],
    device ulong* scalars [[buffer(4)]],
    constant IgGraphPageRankArgs& args [[buffer(5)]],
    uint index [[thread_position_in_grid]]) {
    if (index != 0u || atomic_load_explicit(control + 0, memory_order_relaxed) != 0u
            || atomic_load_explicit(control + 2, memory_order_relaxed) != 0u) return;
    if (args.range_begin > args.node_count) return;
    uint end = args.range_begin
        + min(args.range_count, args.node_count - args.range_begin);
    ulong sum = args.range_begin == 0u ? 0ul : scalars[0];
    for (uint node = args.range_begin; node < end; ++node) {
        if (visible_nodes[node] == 1u
                && atomic_load_explicit(out_degree + node, memory_order_relaxed) == 0u) {
            sum = ig_scalar_program_f64_add(sum, current_rank[node]);
        }
    }
    scalars[0] = sum;
}

kernel void ig_graph_pagerank_pull_prepare(
    device const uint* incoming_offsets [[buffer(0)]],
    device const uint* incoming_overlay [[buffer(1)]],
    device const uchar* visible_nodes [[buffer(2)]],
    device uint* cursor [[buffer(3)]],
    device const ulong* scalars [[buffer(4)]],
    device ulong* next_rank [[buffer(5)]],
    device atomic_uint* control [[buffer(6)]],
    constant IgGraphPageRankArgs& args [[buffer(7)]],
    uint local_target [[thread_position_in_grid]]) {
    if (local_target >= args.range_count) return;
    if (args.range_begin > args.node_count
            || local_target >= args.node_count - args.range_begin) return;
    uint target = args.range_begin + local_target;
    if (target >= args.node_count || atomic_load_explicit(control + 0, memory_order_relaxed) != 0u
            || atomic_load_explicit(control + 2, memory_order_relaxed) != 0u) return;
    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(incoming_offsets, args.adjacency_count,
            incoming_overlay, args.overlay_count, target, row)) {
        atomic_fetch_max_explicit(control + 2, 1u, memory_order_relaxed);
        return;
    }
    cursor[target] = row.begin;
    cursor[size_t(args.node_count) + size_t(target)] = row.end;
    if (visible_nodes[target] != 1u) {
        next_rank[target] = 0ul;
        return;
    }
    ulong count_bits = ig_graph_u32_to_f64_bits(args.visible_count);
    ulong teleport = ig_scalar_program_f64_divide(
        ig_scalar_program_f64_add(
            0x3ff0000000000000ul, args.damping_bits ^ 0x8000000000000000ul),
        count_bits);
    ulong dangling = ig_scalar_program_f64_divide(
        ig_scalar_program_f64_multiply(args.damping_bits, scalars[0]), count_bits);
    next_rank[target] = ig_scalar_program_f64_add(teleport, dangling);
}

kernel void ig_graph_pagerank_pending_clear(
    device atomic_uint* control [[buffer(0)]],
    uint index [[thread_position_in_grid]]) {
    if (index == 0u) atomic_store_explicit(control + 3, 0u, memory_order_relaxed);
}

kernel void ig_graph_pagerank_pull_scan(
    device const uint* incoming_neighbors [[buffer(0)]],
    device const uint* incoming_edges [[buffer(1)]],
    device const uint* incoming_offsets [[buffer(2)]],
    device const uint* incoming_overlay [[buffer(3)]],
    device const uchar* visible_nodes [[buffer(4)]],
    device const uchar* edge_active [[buffer(5)]],
    device const uchar* edge_layers [[buffer(6)]],
    device const atomic_uint* out_degree [[buffer(7)]],
    device const ulong* current_rank [[buffer(8)]],
    device uint* cursor [[buffer(9)]],
    device ulong* next_rank [[buffer(10)]],
    device atomic_uint* control [[buffer(11)]],
    constant IgGraphPageRankArgs& args [[buffer(12)]],
    uint local_target [[thread_position_in_grid]]) {
    if (local_target >= args.range_count) return;
    if (args.range_begin > args.node_count
            || local_target >= args.node_count - args.range_begin) return;
    uint target = args.range_begin + local_target;
    if (target >= args.node_count || visible_nodes[target] != 1u
            || atomic_load_explicit(control + 0, memory_order_relaxed) != 0u
            || atomic_load_explicit(control + 2, memory_order_relaxed) != 0u) return;
    uint position = cursor[target];
    uint row_end = cursor[size_t(args.node_count) + size_t(target)];
    IgCsrResolvedRow row;
    if (!ig_csr_resolve_row(incoming_offsets, args.adjacency_count,
            incoming_overlay, args.overlay_count, target, row)
            || position < row.begin || row_end != row.end || position > row_end) {
        atomic_fetch_max_explicit(control + 2, 1u, memory_order_relaxed);
        return;
    }
    uint limit = position + min(args.quantum, row_end - position);
    ulong accumulated = next_rank[target];
    for (; position < limit; ++position) {
        uint edge = ig_csr_resolved_edge(
            incoming_edges, incoming_overlay, args.overlay_count, row, position);
        uint source = ig_csr_resolved_neighbor(
            incoming_neighbors, incoming_overlay, args.overlay_count, row, position);
        if (edge >= args.edge_count || source >= args.node_count) {
            atomic_fetch_max_explicit(control + 2, 2u, memory_order_relaxed);
            continue;
        }
        uchar source_visible = visible_nodes[source];
        uchar active = edge_active[edge];
        uchar layer = edge_layers[edge];
        if (source_visible > 1u || active > 1u || layer > IG_MAX_LAYER) {
            atomic_fetch_max_explicit(control + 2, 3u, memory_order_relaxed);
            continue;
        }
        uint degree = atomic_load_explicit(out_degree + source, memory_order_relaxed);
        if (source_visible != 1u || active != 1u
                || !ig_graph_layer_visible(layer, args.layer_mask) || degree == 0u) continue;
        ulong contribution = ig_scalar_program_f64_divide(
            ig_scalar_program_f64_multiply(args.damping_bits, current_rank[source]),
            ig_graph_u32_to_f64_bits(degree));
        accumulated = ig_scalar_program_f64_add(accumulated, contribution);
    }
    cursor[target] = position;
    next_rank[target] = accumulated;
    if (position < row_end) atomic_fetch_add_explicit(control + 3, 1u, memory_order_relaxed);
}

kernel void ig_graph_pagerank_delta_chunk(
    device const uchar* visible_nodes [[buffer(0)]],
    device const ulong* current_rank [[buffer(1)]],
    device const ulong* next_rank [[buffer(2)]],
    device atomic_uint* control [[buffer(3)]],
    device ulong* scalars [[buffer(4)]],
    constant IgGraphPageRankArgs& args [[buffer(5)]],
    uint index [[thread_position_in_grid]]) {
    if (index != 0u || atomic_load_explicit(control + 0, memory_order_relaxed) != 0u
            || atomic_load_explicit(control + 2, memory_order_relaxed) != 0u) return;
    if (args.range_begin > args.node_count) return;
    uint end = args.range_begin
        + min(args.range_count, args.node_count - args.range_begin);
    ulong delta = args.range_begin == 0u ? 0ul : scalars[1];
    for (uint node = args.range_begin; node < end; ++node) {
        if (visible_nodes[node] == 1u) {
            ulong difference = ig_scalar_program_f64_add(
                current_rank[node], next_rank[node] ^ 0x8000000000000000ul)
                & 0x7ffffffffffffffful;
            delta = ig_scalar_program_f64_add(delta, difference);
        }
    }
    scalars[1] = delta;
    if (end == args.node_count) {
        atomic_store_explicit(control + 1, args.iteration + 1u, memory_order_relaxed);
        if (delta <= args.tolerance_bits) {
            atomic_store_explicit(control + 0, 1u, memory_order_relaxed);
        }
    }
}

kernel void ig_graph_pagerank_publish(
    device const ulong* rank_a [[buffer(0)]],
    device const ulong* rank_b [[buffer(1)]],
    device atomic_uint* control [[buffer(2)]],
    device const uint* selected_rows [[buffer(3)]],
    device uint* output [[buffer(4)]],
    constant IgGraphPageRankArgs& args [[buffer(5)]],
    uint local_row [[thread_position_in_grid]]) {
    if (local_row >= args.range_count) return;
    if (args.range_begin > args.visible_count
            || local_row >= args.visible_count - args.range_begin) return;
    uint row = args.range_begin + local_row;
    uint node = selected_rows[row];
    if (node >= args.node_count) {
        atomic_fetch_max_explicit(control + 2, 2u, memory_order_relaxed);
        return;
    }
    uint completed = atomic_load_explicit(control + 1, memory_order_relaxed);
    ulong bits = (completed & 1u) == 0u ? rank_a[node] : rank_b[node];
    output[size_t(row) * 2ul] = uint(bits);
    output[size_t(row) * 2ul + 1ul] = uint(bits >> 32u);
}

