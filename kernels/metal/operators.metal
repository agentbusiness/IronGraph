    bool has_clock_base = has_time || has_datetime;
    long base_days = has_date ? date_source.epoch_days : (has_datetime ? datetime_source.epoch_days : 0L);
    long base_clock = has_time ? time_source.clock_nanos
        : (has_datetime ? datetime_source.clock_nanos : 0L);
    if ((has_date && date_source.has_date == 0u)
            || (has_time && time_source.has_clock == 0u)
            || (has_datetime
                && (datetime_source.has_date == 0u || datetime_source.has_clock == 0u))) return false;
    long days = 0L;
    long clock = 0L;
    if (!ig_temporal_map_date_with_base(fields, has_date_base, base_days, days)
            || !ig_temporal_map_clock_with_base(fields, has_clock_base, base_clock, clock)) {
        return false;
    }
    bool has_requested = false;
    uchar requested_kind = 0u;
    int requested_offset = 0;
    uint requested_zone = 0u;
    if (!ig_temporal_register_requested_zone(
            bytes,
            args,
            fields,
            has_requested,
            requested_kind,
            requested_offset,
            requested_zone)) return false;
    bool has_overrides = false;
    for (uint key = 1u; key <= 14u; ++key) {
        has_overrides = has_overrides || fields.present[key] != 0u;
    }
    if (!has_overrides && has_datetime && datetime_source.has_instant != 0u) {
        uchar zone_kind = has_requested ? requested_kind : datetime_source.zone_kind;
        int offset = has_requested ? requested_offset : datetime_source.offset_seconds;
        uint zone = has_requested ? requested_zone : datetime_source.zone_index;
        if (zone_kind == 0u) { zone_kind = 1u; offset = 0; }
        ig_temporal_register_write_zoned_instant(
            datetime_source.seconds,
            datetime_source.nanos,
            zone_kind,
            offset,
            zone,
            output);
        return true;
    }

    bool has_source_zone = false;
    uchar source_kind = 0u;
    int source_offset = 0;
    uint source_zone = 0u;
    if (has_time && time_source.zone_kind != 0u) {
        has_source_zone = true;
        source_kind = time_source.zone_kind;
        source_offset = time_source.offset_seconds;
        source_zone = time_source.zone_index;
    } else if (has_datetime && datetime_source.zone_kind != 0u) {
        has_source_zone = true;
        source_kind = datetime_source.zone_kind;
        source_offset = datetime_source.offset_seconds;
        source_zone = datetime_source.zone_index;
    }
    if (!has_source_zone) {
        uchar target_kind = has_requested ? requested_kind : 1u;
        int target_offset = has_requested ? requested_offset : 0;
        uint target_zone = has_requested ? requested_zone : 0u;
        return ig_temporal_register_write_zoned_local(
            bytes, args, days, clock, target_kind, target_offset, target_zone, output);
    }
    if (!has_requested) {
        return ig_temporal_register_write_zoned_local(
            bytes, args, days, clock, source_kind, source_offset, source_zone, output);
    }
    long seconds = 0L;
    if (!ig_temporal_register_local_to_instant(
            bytes,
            args,
            days,
            clock,
            source_kind,
            source_offset,
            source_zone,
            seconds)) return false;
    ig_temporal_register_write_zoned_instant(
        seconds,
        uint(clock % 1000000000L),
        requested_kind,
        requested_offset,
        requested_zone,
        output);
    return true;
}

inline bool ig_temporal_duration_refresh_instant(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    thread IgTemporalRegisterParts& value) {
    if (value.zone_kind == 0u) return true;
    if (value.has_date == 0u || value.has_clock == 0u) {
        return value.zone_kind == 1u;
    }
    long seconds = 0L;
    if (!ig_temporal_register_local_to_instant(
            bytes,
            args,
            value.epoch_days,
            value.clock_nanos,
            value.zone_kind,
            value.offset_seconds,
            value.zone_index,
            seconds)) return false;
    value.seconds = seconds;
    value.nanos = uint(value.clock_nanos % 1000000000L);
    value.has_instant = 1u;
    return true;
}

inline bool ig_temporal_duration_attach_date(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    thread IgTemporalRegisterParts& value,
    long epoch_days) {
    if (value.has_date != 0u) return true;
    value.has_date = 1u;
    value.epoch_days = epoch_days;
    return ig_temporal_duration_refresh_instant(bytes, args, value);
}

inline bool ig_temporal_duration_attach_zone(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    thread IgTemporalRegisterParts& value,
    thread const IgTemporalRegisterParts& source) {
    if (value.zone_kind != 0u) return true;
    value.zone_kind = source.zone_kind;
    value.offset_seconds = source.offset_seconds;
    value.zone_index = source.zone_index;
    if (value.has_date == 0u && value.zone_kind == 2u) return false;
    return ig_temporal_duration_refresh_instant(bytes, args, value);
}

inline bool ig_temporal_duration_normalize_pair(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    uint unit,
    thread IgTemporalRegisterParts& from,
    thread IgTemporalRegisterParts& to) {
    if (unit == 2u) {
        if (from.has_date != 0u && from.has_clock == 0u) {
            from.has_clock = 1u;
            from.clock_nanos = 0L;
        }
        if (to.has_date != 0u && to.has_clock == 0u) {
            to.has_clock = 1u;
            to.clock_nanos = 0L;
        }
    } else if (from.has_clock != 0u && to.has_clock == 0u) {
        to.has_clock = 1u;
        to.clock_nanos = 0L;
    } else if (to.has_clock != 0u && from.has_clock == 0u) {
        from.has_clock = 1u;
        from.clock_nanos = 0L;
    }
    if (from.has_date != 0u && to.has_date == 0u) {
        if (!ig_temporal_duration_attach_date(bytes, args, to, from.epoch_days)) return false;
    } else if (to.has_date != 0u && from.has_date == 0u) {
        if (!ig_temporal_duration_attach_date(bytes, args, from, to.epoch_days)) return false;
    }
    if (from.zone_kind != 0u && to.zone_kind == 0u) {
        if (!ig_temporal_duration_attach_zone(bytes, args, to, from)) return false;
    } else if (to.zone_kind != 0u && from.zone_kind == 0u) {
        if (!ig_temporal_duration_attach_zone(bytes, args, from, to)) return false;
    }
    return true;
}

inline bool ig_temporal_duration_local_in_zone(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    thread const IgTemporalRegisterParts& value,
    uchar zone_kind,
    int offset_seconds,
    uint zone_index,
    thread long& epoch_days,
    thread long& clock_nanos) {
    if (value.has_instant == 0u || zone_kind == 0u) {
        if (value.has_date == 0u || value.has_clock == 0u) return false;
        epoch_days = value.epoch_days;
        clock_nanos = value.clock_nanos;
        return true;
    }
    int offset = offset_seconds;
    if (zone_kind == 2u && !ig_temporal_register_named_offset_at(
            bytes,
            args.zone_table_start,
            args.zone_table_end,
            args.zone_count,
            zone_index,
            value.seconds,
            offset)) return false;
    long local_seconds = value.seconds + long(offset);
    epoch_days = ig_temporal_register_floor_div(local_seconds, 86400L);
    clock_nanos = (local_seconds - epoch_days * 86400L) * 1000000000L
        + long(value.nanos);
    return true;
}

inline long ig_temporal_duration_adjusted_end_day(
    long from_day,
    long from_clock,
    long to_day,
    long to_clock) {
    if (to_day > from_day && to_clock < from_clock) return to_day - 1L;
    if (to_day < from_day && to_clock > from_clock) return to_day + 1L;
    return to_day;
}

inline bool ig_temporal_duration_complete_months(
    long from_day,
    long to_day,
    thread long& months) {
    long from_year = 0L;
    long to_year = 0L;
    uint from_month = 0u;
    uint to_month = 0u;
    uint from_date = 0u;
    uint to_date = 0u;
    if (!ig_temporal_civil_from_days(from_day, from_year, from_month, from_date)
            || !ig_temporal_civil_from_days(to_day, to_year, to_month, to_date)) return false;
    long from_packed = ((from_year * 12L + long(from_month - 1u)) * 32L) + long(from_date);
    long to_packed = ((to_year * 12L + long(to_month - 1u)) * 32L) + long(to_date);
    months = (to_packed - from_packed) / 32L;
    return true;
}

inline bool ig_temporal_duration_until_months(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    IgTemporalRegisterParts from,
    IgTemporalRegisterParts to,
    thread long& months) {
    if (!ig_temporal_duration_normalize_pair(bytes, args, 0u, from, to)
            || from.has_date == 0u || to.has_date == 0u) return false;
    long from_day = from.epoch_days;
    long to_day = to.epoch_days;
    long from_clock = from.has_clock != 0u ? from.clock_nanos : 0L;
    long to_clock = to.has_clock != 0u ? to.clock_nanos : 0L;
    if (from.zone_kind != 0u && to.zone_kind != 0u) {
        if (!ig_temporal_duration_local_in_zone(
                bytes,
                args,
                from,
                from.zone_kind,
                from.offset_seconds,
                from.zone_index,
                from_day,
                from_clock)
                || !ig_temporal_duration_local_in_zone(
                    bytes,
                    args,
                    to,
                    from.zone_kind,
                    from.offset_seconds,
                    from.zone_index,
                    to_day,
                    to_clock)) return false;
    }
    if (from.has_clock != 0u && to.has_clock != 0u) {
        to_day = ig_temporal_duration_adjusted_end_day(
            from_day, from_clock, to_day, to_clock);
    }
    return ig_temporal_duration_complete_months(from_day, to_day, months);
}

inline bool ig_temporal_duration_until_days(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    IgTemporalRegisterParts from,
    IgTemporalRegisterParts to,
    thread long& days) {
    if (!ig_temporal_duration_normalize_pair(bytes, args, 1u, from, to)
            || from.has_date == 0u || to.has_date == 0u) return false;
    long from_day = from.epoch_days;
    long to_day = to.epoch_days;
    long from_clock = from.has_clock != 0u ? from.clock_nanos : 0L;
    long to_clock = to.has_clock != 0u ? to.clock_nanos : 0L;
    if (from.zone_kind != 0u && to.zone_kind != 0u) {
        if (!ig_temporal_duration_local_in_zone(
                bytes,
                args,
                from,
                from.zone_kind,
                from.offset_seconds,
                from.zone_index,
                from_day,
                from_clock)
                || !ig_temporal_duration_local_in_zone(
                    bytes,
                    args,
                    to,
                    from.zone_kind,
                    from.offset_seconds,
                    from.zone_index,
                    to_day,
                    to_clock)) return false;
    }
    if (from.has_clock != 0u && to.has_clock != 0u) {
        to_day = ig_temporal_duration_adjusted_end_day(
            from_day, from_clock, to_day, to_clock);
    }
    days = to_day - from_day;
    return true;
}

inline bool ig_temporal_duration_timestamp(
    thread const IgTemporalRegisterParts& value,
    thread long& seconds,
    thread uint& nanos) {
    if (value.has_clock == 0u) return false;
    nanos = uint(value.clock_nanos % 1000000000L);
    if (value.has_date != 0u) {
        if (value.zone_kind != 0u) {
            if (value.has_instant == 0u) return false;
            seconds = value.seconds;
            nanos = value.nanos;
        } else {
            seconds = value.epoch_days * 86400L + value.clock_nanos / 1000000000L;
        }
        return true;
    }
    seconds = value.clock_nanos / 1000000000L;
    if (value.zone_kind == 1u) seconds -= long(value.offset_seconds);
    else if (value.zone_kind != 0u) return false;
    return true;
}

inline bool ig_temporal_duration_until_seconds(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    IgTemporalRegisterParts from,
    IgTemporalRegisterParts to,
    thread long& seconds,
    thread uint& nanos) {
    if (!ig_temporal_duration_normalize_pair(bytes, args, 2u, from, to)) return false;
    long from_seconds = 0L;
    long to_seconds = 0L;
    uint from_nanos = 0u;
    uint to_nanos = 0u;
    if (!ig_temporal_duration_timestamp(from, from_seconds, from_nanos)
            || !ig_temporal_duration_timestamp(to, to_seconds, to_nanos)) return false;
    seconds = to_seconds - from_seconds;
    long nano_delta = long(to_nanos) - long(from_nanos);
    if (nano_delta < 0L) {
        seconds -= 1L;
        nano_delta += 1000000000L;
    }
    nanos = uint(nano_delta);
    return true;
}

inline bool ig_temporal_duration_add_months(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    thread IgTemporalRegisterParts& value,
    long months) {
    if (value.has_date == 0u) return false;
    long year = 0L;
    uint month = 0u;
    uint day = 0u;
    if (!ig_temporal_civil_from_days(value.epoch_days, year, month, day)) return false;
    long total_month = year * 12L + long(month - 1u) + months;
    year = ig_temporal_register_floor_div(total_month, 12L);
    if (year < -999999999L || year > 999999999L) return false;
    month = uint(total_month - year * 12L) + 1u;
    day = min(day, ig_temporal_days_in_month(year, month));
    value.epoch_days = ig_temporal_days_from_civil(year, month, day);
    return ig_temporal_duration_refresh_instant(bytes, args, value);
}

inline bool ig_temporal_duration_add_days(
    device const uchar* bytes,
    thread const TemporalRegisterStepArgs& args,
    thread IgTemporalRegisterParts& value,
    long days) {
    if (value.has_date == 0u) return false;
    value.epoch_days += days;
    long year = 0L;
    uint month = 0u;
    uint day = 0u;
    if (!ig_temporal_civil_from_days(value.epoch_days, year, month, day)
            || year < -999999999L || year > 999999999L) return false;
    return ig_temporal_duration_refresh_instant(bytes, args, value);
}

inline void ig_temporal_duration_write(
    long months,
    long days,
    long seconds,
    uint nanos,
    device uint* output) {
    output[0] = 6u;
    ig_temporal_register_write_long(output, 1u, months);
    ig_temporal_register_write_long(output, 3u, days);
    ig_temporal_register_write_long(output, 5u, seconds);
    output[7] = nanos;
}

__attribute__((noinline)) bool ig_temporal_register_duration_step(
    device const uchar* bytes,
    device const uint* registers,
    thread const TemporalRegisterStepArgs& args,
    device uint* output) {
    if (args.input_tag == 4u) {
        if (args.source_register >= args.register_count) return false;
        uint base = args.source_register * args.register_stride;
#if IG_INCLUDE_TEMPORAL_REGISTER_KERNELS
        if (registers[base] == 11u) {
            uint length = 0u;
            long months = 0L;
            long days = 0L;
            long seconds = 0L;
            long nanos = 0L;
            if (!ig_temporal_register_source_string(
                    registers, args, args.source_register, base, length)) return false;
            device const uchar* text =
                reinterpret_cast<device const uchar*>(registers + base + 2u);
            if (!ig_temporal_parse_duration(
                    text, 0u, length, months, days, seconds, nanos)) return false;
            ig_temporal_duration_write(months, days, seconds, uint(nanos), output);
            return true;
        }
#endif
        if (registers[base] == 0u) { output[0] = 0u; return true; }
        if (registers[base] != 6u) return false;
        for (uint word = 0u; word < 8u; ++word) output[word] = registers[base + word];
        return true;
    }
    if (args.input_tag == 6u) {
        if (args.source_register >= args.register_count) return false;
        uint base = args.source_register * args.register_stride;
        if (registers[base] == 0u) { output[0] = 0u; return true; }
        if (registers[base] != 6u || args.temporal_operation > 3u) return false;
        long value = 0L;
        uint offset = args.temporal_operation == 0u ? 1u
            : (args.temporal_operation == 1u ? 3u
                : (args.temporal_operation == 2u ? 5u : 7u));
        if (args.temporal_operation == 3u) {
            value = long(as_type<int>(registers[base + offset]));
        } else {
            value = as_type<long>(
                ulong(registers[base + offset]) | (ulong(registers[base + offset + 1u]) << 32));
        }
        output[0] = 9u;
        ig_temporal_register_write_long(output, 1u, value);
        return true;
    }
    if (args.input_tag == 5u) {
        IgTemporalRegisterParts from;
        IgTemporalRegisterParts to;
        bool from_null = false;
        bool to_null = false;
        if (args.temporal_operation > 3u
                || !ig_temporal_register_load_parts(
                    bytes, registers, args, args.source_register, from, from_null)
                || !ig_temporal_register_load_parts(
                    bytes, registers, args, args.right_register, to, to_null)) return false;
        if (from_null || to_null) { output[0] = 0u; return true; }
        long months = 0L;
        long days = 0L;
        long seconds = 0L;
        uint nanos = 0u;
        if (args.temporal_operation == 1u) {
            if (!ig_temporal_duration_until_months(bytes, args, from, to, months)) return false;
        } else if (args.temporal_operation == 2u) {
            if (!ig_temporal_duration_until_days(bytes, args, from, to, days)) return false;
        } else if (args.temporal_operation == 3u) {
            if (!ig_temporal_duration_until_seconds(
                    bytes, args, from, to, seconds, nanos)) return false;
        } else {
            IgTemporalRegisterParts cursor = from;
            if (from.has_date != 0u && to.has_date != 0u) {
                if (!ig_temporal_duration_until_months(
                        bytes, args, cursor, to, months)
                        || !ig_temporal_duration_add_months(bytes, args, cursor, months)
                        || !ig_temporal_duration_until_days(bytes, args, cursor, to, days)
                        || !ig_temporal_duration_add_days(bytes, args, cursor, days)) return false;
            }
            if (!ig_temporal_duration_until_seconds(
                    bytes, args, cursor, to, seconds, nanos)) return false;
        }
        ig_temporal_duration_write(months, days, seconds, nanos, output);
        return true;
    }
    if (args.input_tag == 3u) {
        IgTemporalMapFields fields;
        if (!ig_temporal_parse_map_fields(bytes, 0u, args.payload_end, fields)) return false;
        long months = 0L;
        long days = 0L;
        long seconds = 0L;
        long nanos = 0L;
        if (!ig_temporal_map_duration_components(fields, months, days, seconds, nanos)) {
            return false;
        }
        ig_temporal_duration_write(months, days, seconds, uint(nanos), output);
        return true;
    }
    if (args.input_tag != 1u) return false;
    long months = 0L;
    long days = 0L;
    long seconds = 0L;
    long nanos = 0L;
    if (!ig_temporal_parse_duration(
            bytes, 0u, args.payload_end, months, days, seconds, nanos)) return false;
    ig_temporal_duration_write(months, days, seconds, uint(nanos), output);
    return true;
}

