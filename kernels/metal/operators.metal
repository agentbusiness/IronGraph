inline ulong ig_variable_path_word(device const long* packet, ulong index) {
    return as_type<ulong>(packet[index]);
}

struct IgVariablePathCsrRow {
    uint begin;
    uint end;
    uint overlay;
};

// Complete replacement rows keep variable expansion proportional to the changed-row overlay.
inline IgVariablePathCsrRow ig_variable_path_csr_row(
    device const uint* offsets,
    device const uint* overlay,
    uint overlay_count,
    uint source) {
    uint low = 0u;
    uint high = overlay_count;
    while (low < high) {
        uint middle = low + (high - low) / 2u;
        uint candidate = overlay[middle];
        if (candidate < source) low = middle + 1u;
        else high = middle;
    }
    if (low < overlay_count && overlay[low] == source) {
        return IgVariablePathCsrRow{
            overlay[overlay_count + low],
            overlay[overlay_count + low + 1u],
            1u};
    }
    return IgVariablePathCsrRow{offsets[source], offsets[source + 1u], 0u};
}

inline uint ig_variable_path_csr_neighbor(
    device const uint* neighbors,
    device const uint* overlay,
    uint overlay_count,
    IgVariablePathCsrRow row,
    uint position) {
    return row.overlay == 0u ? neighbors[position]
        : overlay[overlay_count * 2u + 1u + position];
}

inline uint ig_variable_path_csr_edge(
    device const uint* edges,
    device const uint* overlay,
    uint overlay_count,
    IgVariablePathCsrRow row,
    uint position) {
    if (row.overlay == 0u) return edges[position];
    uint payload_count = overlay[overlay_count * 2u];
    return overlay[overlay_count * 2u + 1u + payload_count + position];
}

// The effective maximum is clamped to the resident edge domain. `minimum > maximum` therefore
// represents a valid empty traversal only when the host set the explicit empty-range marker.
// Every unmarked inversion, spurious marker, out-of-domain maximum, or unknown high bit remains a
// corrupt packet instead of being silently interpreted as an empty query.
inline bool ig_variable_path_decode_maximum(
    ulong word,
    ulong minimum,
    uint edge_count,
    thread ulong& maximum) {
    ulong allowed = IG_VARIABLE_PATH_EMPTY_RANGE_FLAG | IG_VARIABLE_PATH_MAXIMUM_MASK;
    if ((word & ~allowed) != 0ul || minimum > IG_VARIABLE_PATH_MAXIMUM_MASK) return false;
    maximum = word & IG_VARIABLE_PATH_MAXIMUM_MASK;
    bool marked_empty = (word & IG_VARIABLE_PATH_EMPTY_RANGE_FLAG) != 0ul;
    return maximum <= ulong(edge_count) && marked_empty == (minimum > maximum);
}

inline bool ig_variable_path_decode_type_count(
    ulong word,
    thread ulong& count,
    thread bool& known_empty) {
    ulong allowed = IG_VARIABLE_PATH_KNOWN_EMPTY_TYPE_FLAG
        | IG_VARIABLE_PATH_TYPE_COUNT_MASK;
    if ((word & ~allowed) != 0ul) return false;
    count = word & IG_VARIABLE_PATH_TYPE_COUNT_MASK;
    known_empty = (word & IG_VARIABLE_PATH_KNOWN_EMPTY_TYPE_FLAG) != 0ul;
    return !known_empty || count == 0ul;
}

inline uint ig_variable_path_edge_stride(constant VariablePathArgs& args) {
    return args.edge_count;
}

inline uint ig_variable_path_node_stride(constant VariablePathArgs& args) {
    return args.edge_count + 1u;
}

inline ulong ig_variable_path_edge_base(constant VariablePathArgs& args) {
    return ulong(args.frontier_capacity) * 4ul;
}

inline ulong ig_variable_path_node_base(constant VariablePathArgs& args) {
    return ig_variable_path_edge_base(args)
        + ulong(args.frontier_capacity) * ulong(ig_variable_path_edge_stride(args));
}

inline ulong ig_variable_path_segment_end_base(constant VariablePathArgs& args) {
    return ig_variable_path_node_base(args)
        + ulong(args.frontier_capacity) * ulong(ig_variable_path_node_stride(args));
}

inline bool ig_variable_path_packet_valid(
    device const long* packet,
    constant VariablePathArgs& args) {
    ulong scan_descriptor_count = ulong(args.multiplicity_scan_count)
        + ulong(args.bound_terminal_mode);
    ulong expected_path_store_words = ulong(args.frontier_capacity)
        * (5ul + ulong(args.edge_count) * 2ul + ulong(args.segment_count));
    ulong final_relation_words = args.final_projection_mode == 0u
        ? 0ul
        : (args.final_projection_mode == 6u
            ? args.final_projection_capacity_1
            : (args.final_projection_mode == 7u
                ? ulong(args.output_capacity) + ulong(args.node_count)
                : (args.final_projection_mode == 8u
                    ? args.final_projection_capacity_0
                    : (args.final_projection_mode == 9u
                        ? 1ul
                        : (args.final_projection_mode == 10u
                            ? args.final_projection_capacity_0 * 2ul
                            : (args.final_projection_mode == 12u
                                ? 1ul
                                : ulong(args.output_capacity) * 5ul))))));
    ulong expected_output_words = ulong(IG_VARIABLE_PATH_OUTPUT_HEADER_WORDS)
        + ulong(args.receipt_count) * ulong(IG_VARIABLE_PATH_RECEIPT_WORDS)
        + ulong(args.output_capacity)
            * (7ul + ulong(args.edge_count) * 2ul + ulong(args.segment_count))
        + final_relation_words;
    bool has_cartesian_source = args.multiplicity_scan_count != 0u
        || args.bound_terminal_mode != 0u;
    uint expected_projection_obligations = args.final_projection_mode == 0u ? 0u
        : (args.final_projection_mode <= 3u ? 1u
        : (args.final_projection_mode <= 5u ? 2u
        : (args.final_projection_mode == 6u ? 4u
        : (args.final_projection_mode == 7u ? 3u
        : (args.final_projection_mode == 8u ? 2u
        : (args.final_projection_mode == 9u ? 4u
        : (args.final_projection_mode == 10u ? 2u
        : (args.final_projection_mode == 11u ? 1u
        : (args.final_projection_mode == 12u ? 4u
        : (args.final_projection_mode == 13u ? 2u
        : (args.final_projection_mode == 14u ? 4u
        : (args.final_projection_mode == 15u ? 1u
        : (args.final_projection_mode == 16u ? 3u : 0xffffffffu)))))))))))));
    bool projection_argument_present = args.final_projection_argument != 0xfffffffffffffffful;
    bool projection_shape_valid = false;
    if (args.final_projection_mode == 0u) {
        projection_shape_valid = args.final_projection_argument == 0xfffffffful
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul;
    } else if (args.final_projection_mode == 1u) {
        projection_shape_valid = args.final_projection_argument < ulong(args.segment_count)
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.optional_mode == 0u;
    } else if (args.final_projection_mode == 2u) {
        projection_shape_valid = args.final_projection_argument == 0xfffffffful
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.optional_mode != 0u;
    } else if (args.final_projection_mode == 3u) {
        projection_shape_valid = args.final_projection_argument <= 2ul
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && ((args.final_projection_argument <= 1ul && args.optional_mode == 0u)
                || (args.final_projection_argument == 2ul
                    && args.optional_mode != 0u
                    && args.bound_terminal_mode != 0u));
    } else if (args.final_projection_mode == 4u) {
        projection_shape_valid = args.final_projection_flags <= 1ul
            && ((args.final_projection_flags & 1ul) != 0ul) == projection_argument_present
            && args.final_projection_capacity_0 != 0ul
            && args.final_projection_capacity_0 <= 0xfffffffful
            && args.final_projection_capacity_1 == 0ul
            && args.optional_mode == 0u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 5u) {
        projection_shape_valid = args.final_projection_flags >= 2ul
            && args.final_projection_flags <= 3ul
            && ((args.final_projection_flags & 1ul) != 0ul) == projection_argument_present
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.optional_mode != 0u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 6u) {
        projection_shape_valid = args.final_projection_flags >= 2ul
            && args.final_projection_flags <= 3ul
            && ((args.final_projection_flags & 1ul) != 0ul) == projection_argument_present
            && args.final_projection_capacity_0 <= 0xfffffffful
            && args.final_projection_capacity_1
                == args.final_projection_capacity_0 * args.final_projection_capacity_0
            && args.final_projection_capacity_1 <= 0xfffffffful
            && args.optional_mode == 0u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 7u) {
        projection_shape_valid = projection_argument_present
            && args.final_projection_flags <= 1ul
            && ((args.final_projection_flags & 1ul) != 0ul)
                == (args.final_projection_operand_0 != 0xfffffffffffffffful)
            && args.final_projection_capacity_0 != 0ul
            && args.final_projection_capacity_0 <= ulong(args.output_capacity)
            && args.optional_mode != 0u
            && args.bound_terminal_mode != 0u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 8u) {
        projection_shape_valid = projection_argument_present
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 != 0ul
            && args.final_projection_capacity_0 <= 0xfffffffful
            && args.final_projection_capacity_1 == 0ul
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.segment_count == 4u;
    } else if (args.final_projection_mode == 9u) {
        projection_shape_valid = projection_argument_present
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 <= ulong(args.edge_count)
            && args.final_projection_capacity_1
                == ulong(args.output_capacity) * args.final_projection_capacity_0
            && args.final_projection_operand_0 == 0ul
            && args.final_projection_operand_1 == 0ul
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.segment_count == 2u;
    } else if (args.final_projection_mode == 10u) {
        projection_shape_valid = (args.final_projection_argument == 0xfffffffffffffffful
                || args.final_projection_argument <= 10ul)
            && args.final_projection_flags <= 1ul
            && args.final_projection_capacity_0
                == (args.final_projection_argument == 0xfffffffffffffffful
                    ? 10ul : args.final_projection_argument)
            && args.final_projection_capacity_1 == 10ul
            && args.final_projection_operand_0 == 0ul
            && args.final_projection_operand_1 == 0ul
            && args.output_capacity == 1u
            && args.edge_count <= 1u
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 11u) {
        projection_shape_valid = projection_argument_present
            && args.final_projection_flags == 1ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.final_projection_operand_0 == 0ul
            && args.final_projection_operand_1 == 0ul
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 12u) {
        projection_shape_valid = projection_argument_present
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.final_projection_operand_0 == 2ul
            && args.final_projection_operand_1 == 0ul
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.segment_count == 2u;
    } else if (args.final_projection_mode == 13u) {
        projection_shape_valid = args.final_projection_argument == 0xfffffffful
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.final_projection_operand_0 == 0ul
            && args.final_projection_operand_1 == 0ul
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 14u) {
        projection_shape_valid = projection_argument_present
            && args.final_projection_flags == 1ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.final_projection_operand_0 != 0xfffffffffffffffful
            && args.final_projection_operand_1 != 0xfffffffffffffffful
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.multiplicity_scan_count == 0u
            && args.source_mode == 1u
            && args.segment_count == 1u;
    } else if (args.final_projection_mode == 15u
            || args.final_projection_mode == 16u) {
        projection_shape_valid = args.final_projection_argument == 0xfffffffful
            && args.final_projection_flags == 0ul
            && args.final_projection_capacity_0 == 0ul
            && args.final_projection_capacity_1 == 0ul
            && args.final_projection_operand_0 == 0ul
            && args.final_projection_operand_1 == 0ul
            && args.optional_mode == 0u
            && args.bound_terminal_mode == 0u
            && args.multiplicity_scan_count == 0u
            && args.segment_count == 1u;
    }
    if (args.segment_count == 0u
            || args.frontier_capacity == 0u
            || args.source_mode > 1u
            || args.bound_terminal_mode > 1u
            || args.optional_mode > 1u
            || args.final_projection_mode > 16u
            || !projection_shape_valid
            || args.final_projection_obligation_count != expected_projection_obligations
            || (args.optional_mode != 0u && args.output_limit != 0xffffffffu)
            || (args.source_mode == 0u && args.scan_obligation_id != 0ul)
            || (args.source_mode == 1u
                && (args.scan_obligation_id == 0ul
                    || args.input_row_count != args.node_count))
            || (args.bound_terminal_mode == 0u
                && args.bound_terminal_obligation_id != 0ul)
            || (args.bound_terminal_mode == 1u
                && args.bound_terminal_obligation_id == 0ul)
            || (!has_cartesian_source && args.cartesian_obligation_id != 0ul)
            || (has_cartesian_source && args.cartesian_obligation_id == 0ul)
            || args.receipt_count
                != args.segment_count + 1u + args.multiplicity_scan_count
                    + args.bound_terminal_mode
                    + (args.cartesian_obligation_id != 0ul ? 1u : 0u)
                    + (args.source_mode == 1u ? 1u : 0u)
                    + args.final_projection_obligation_count
            || args.control_words < IG_VARIABLE_PATH_CONTROL_CARDINALITIES
                + args.multiplicity_scan_count + args.bound_terminal_mode
                    + args.segment_count * 2u
            || ulong(args.path_store_words) != expected_path_store_words
            || args.output_word_count != expected_output_words
            || args.packet_word_count < IG_VARIABLE_PATH_PACKET_HEADER_WORDS
            || ig_variable_path_word(packet, 0ul) != IG_VARIABLE_PATH_ABI
            || ig_variable_path_word(packet, 1ul) != ulong(args.segment_count)
            || ig_variable_path_word(packet, 9ul)
                != ulong(IG_VARIABLE_PATH_PACKET_HEADER_WORDS) + scan_descriptor_count
            || ig_variable_path_word(packet, 11ul) != ulong(args.packet_word_count)
            || ig_variable_path_word(packet, 7ul) != args.final_obligation_id
            || ig_variable_path_word(packet, 8ul) != (6ul | (5ul << 8u))
            || ig_variable_path_word(packet, 12ul) != ulong(args.final_projection_mode)
            || ig_variable_path_word(packet, 13ul) != args.final_projection_argument
            || ig_variable_path_word(packet, 14ul)
                != ulong(args.final_projection_obligation_count)
            || ig_variable_path_word(packet, 19ul) != args.final_projection_flags
            || ig_variable_path_word(packet, 20ul) != args.final_projection_capacity_0
            || ig_variable_path_word(packet, 21ul) != args.final_projection_capacity_1
            || ig_variable_path_word(packet, 22ul) != args.final_projection_operand_0
            || ig_variable_path_word(packet, 23ul) != args.final_projection_operand_1) {
        return false;
    }
    for (uint obligation = 0u; obligation < 4u; ++obligation) {
        ulong id = ig_variable_path_word(packet, 15ul + ulong(obligation));
        if ((obligation < args.final_projection_obligation_count) != (id != 0ul)) return false;
    }
    ulong descriptors = ulong(args.segment_count) * ulong(IG_VARIABLE_PATH_SEGMENT_WORDS);
    ulong descriptor_base = ig_variable_path_word(packet, 9ul);
    ulong type_base = ig_variable_path_word(packet, 10ul);
    ulong type_count = ig_variable_path_word(packet, 2ul);
    if (descriptor_base > ulong(args.packet_word_count)
            || descriptors > ulong(args.packet_word_count) - descriptor_base
            || type_base != descriptor_base + descriptors
            || type_base > ulong(args.packet_word_count)
            || type_count != ulong(args.packet_word_count) - type_base) {
        return false;
    }
    for (uint scan = 0u; scan < args.multiplicity_scan_count; ++scan) {
        if (ig_variable_path_word(
                packet, ulong(IG_VARIABLE_PATH_PACKET_HEADER_WORDS + scan)) == 0ul) {
            return false;
        }
    }
    if (args.bound_terminal_mode != 0u
            && ig_variable_path_word(
                packet,
                ulong(IG_VARIABLE_PATH_PACKET_HEADER_WORDS
                    + args.multiplicity_scan_count))
                != args.bound_terminal_obligation_id) {
        return false;
    }
    for (uint segment = 0u; segment < args.segment_count; ++segment) {
        ulong descriptor = descriptor_base
            + ulong(segment) * ulong(IG_VARIABLE_PATH_SEGMENT_WORDS);
        ulong direction = ig_variable_path_word(packet, descriptor);
        ulong minimum = ig_variable_path_word(packet, descriptor + 1ul);
        ulong maximum = 0ul;
        ulong type_start = ig_variable_path_word(packet, descriptor + 3ul);
        ulong segment_type_count = 0ul;
        bool known_empty = false;
        ulong target_flags = ig_variable_path_word(packet, descriptor + 5ul);
        ulong obligation = ig_variable_path_word(packet, descriptor + 6ul);
        if (direction > 2ul
                || !ig_variable_path_decode_maximum(
                    ig_variable_path_word(packet, descriptor + 2ul),
                    minimum,
                    args.edge_count,
                    maximum)
                || !ig_variable_path_decode_type_count(
                    ig_variable_path_word(packet, descriptor + 4ul),
                    segment_type_count,
                    known_empty)
                || type_start > type_count
                || segment_type_count > type_count - type_start
                || (target_flags & ~1ul) != 0ul
                || obligation == 0ul) {
            return false;
        }
        if (args.final_projection_mode == 1u
                && ulong(segment) == args.final_projection_argument
                && (direction != 2ul || minimum != 1ul || maximum != 1ul)) {
            return false;
        }
        if (segment == 0u
                && (args.final_projection_mode == 4u
                    || args.final_projection_mode == 6u
                    || args.final_projection_mode == 7u
                    || args.final_projection_mode == 9u)
                && (direction != 0ul || minimum != 1ul || maximum != 1ul)) return false;
        if (segment == 0u && args.final_projection_mode == 5u
                && (direction != 2ul || minimum != 1ul || maximum != 1ul)) return false;
        if (args.final_projection_mode == 8u
                && (direction != 2ul || minimum != 1ul || maximum != 1ul)) return false;
        if (segment == 1u && args.final_projection_mode == 9u
                && (direction != 1ul || minimum != 1ul || maximum != 1ul)) return false;
        if (args.final_projection_mode == 10u
                && (segment != 0u || direction != 0ul
                    || minimum != 1ul || maximum != 1ul)) return false;
        if (args.final_projection_mode == 11u
                && (segment != 0u || direction > 1ul
                    || minimum != 1ul || maximum != 1ul)) return false;
        if (args.final_projection_mode == 12u
                && (((segment == 0u) != (direction == 2ul))
                    || (segment == 1u && direction != 0ul)
                    || segment > 1u
                    || minimum != 1ul || maximum != 1ul)) return false;
        if ((args.final_projection_mode == 13u
                    || args.final_projection_mode == 15u
                    || args.final_projection_mode == 16u)
                && (segment != 0u || direction != 0ul || minimum != 1ul
                    || maximum != ulong(args.edge_count))) return false;
        if (args.final_projection_mode == 14u
                && (segment != 0u || direction != 0ul || minimum != 0ul
                    || maximum != 0ul)) return false;
    }
    return true;
}

inline ulong ig_variable_path_segment_base(device const long* packet, uint segment) {
    return ig_variable_path_word(packet, 9ul)
        + ulong(segment) * ulong(IG_VARIABLE_PATH_SEGMENT_WORDS);
}

inline void ig_variable_path_fail(device atomic_uint* control, uint status) {
    uint prior = IG_VARIABLE_PATH_STATUS_RUNNING;
    while (prior == IG_VARIABLE_PATH_STATUS_RUNNING
            && !atomic_compare_exchange_weak_explicit(
                &control[IG_VARIABLE_PATH_CONTROL_STATUS],
                &prior,
                status,
                memory_order_relaxed,
                memory_order_relaxed)) {}
}

inline void ig_variable_path_copy_one(
    device const uint* source,
    uint source_row,
    device uint* destination,
    uint destination_row,
    constant VariablePathArgs& args) {
    uint capacity = args.frontier_capacity;
    uint length = source[2u * capacity + source_row];
    destination[destination_row] = source[source_row];
    destination[capacity + destination_row] = source[capacity + source_row];
    destination[2u * capacity + destination_row] = length;
    destination[3u * capacity + destination_row]
        = source[3u * capacity + source_row];
    ulong edge_base = ig_variable_path_edge_base(args);
    ulong edge_stride = ulong(ig_variable_path_edge_stride(args));
    ulong node_base = ig_variable_path_node_base(args);
    ulong node_stride = ulong(ig_variable_path_node_stride(args));
    for (uint hop = 0u; hop < length; ++hop) {
        destination[edge_base + ulong(destination_row) * edge_stride + ulong(hop)]
            = source[edge_base + ulong(source_row) * edge_stride + ulong(hop)];
    }
    for (uint node = 0u; node <= length; ++node) {
        destination[node_base + ulong(destination_row) * node_stride + ulong(node)]
            = source[node_base + ulong(source_row) * node_stride + ulong(node)];
    }
    ulong segment_base = ig_variable_path_segment_end_base(args);
    for (uint segment = 0u; segment < args.segment_count; ++segment) {
        destination[segment_base
                + ulong(destination_row) * ulong(args.segment_count) + ulong(segment)]
            = source[segment_base
                + ulong(source_row) * ulong(args.segment_count) + ulong(segment)];
    }
}

inline bool ig_variable_path_trail_contains(
    device const uint* paths,
    uint path,
    uint edge,
    constant VariablePathArgs& args) {
    uint length = paths[2u * args.frontier_capacity + path];
    ulong base = ig_variable_path_edge_base(args)
        + ulong(path) * ulong(ig_variable_path_edge_stride(args));
    for (uint hop = 0u; hop < length; ++hop) {
        if (paths[base + ulong(hop)] == edge) return true;
    }
    return false;
}

inline uint ig_variable_path_candidate_matches(
    device const long* packet,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    device const uchar* relationship_masks,
    device const uint* paths,
    uint path,
    uint neighbor,
    uint edge,
    uint segment,
    constant VariablePathArgs& args) {
    if (neighbor >= args.node_count || edge >= args.edge_count) return 2u;
    uchar n_active = node_active[neighbor];
    uchar n_layer = node_layers[neighbor];
    uchar e_active = edge_active[edge];
    uchar e_layer = edge_layers[edge];
    if (n_active > 1u || e_active > 1u || n_layer > IG_MAX_LAYER || e_layer > IG_MAX_LAYER) return 2u;
    if (n_active == 0u || e_active == 0u
            || (args.layer_mask & (1u << uint(n_layer))) == 0u
            || (args.layer_mask & (1u << uint(e_layer))) == 0u
            || ig_variable_path_trail_contains(paths, path, edge, args)) {
        return 0u;
    }
    uchar relationship_selected = relationship_masks[
        ulong(segment) * ulong(args.edge_count) + ulong(edge)];
    if (relationship_selected > 1u) return 2u;
    if (relationship_selected == 0u) return 0u;
    ulong descriptor = ig_variable_path_segment_base(packet, segment);
    ulong type_start = ig_variable_path_word(packet, descriptor + 3ul);
    ulong type_count = 0ul;
    bool known_empty = false;
    ulong total_types = ig_variable_path_word(packet, 2ul);
    ulong type_base = ig_variable_path_word(packet, 10ul);
    if (!ig_variable_path_decode_type_count(
            ig_variable_path_word(packet, descriptor + 4ul),
            type_count,
            known_empty)
            || type_start > total_types
            || type_count > total_types - type_start) return 2u;
    if (known_empty) return 0u;
    if (type_count == 0ul) return 1u;
    ulong relationship_type = as_type<ulong>(edge_types[edge]);
    for (ulong index = 0ul; index < type_count; ++index) {
        if (ig_variable_path_word(packet, type_base + type_start + index)
                == relationship_type) {
            return 1u;
        }
    }
    return 0u;
}

inline uint ig_variable_path_count_orientation(
    device const long* packet,
    device const uint* offsets,
    device const uint* neighbors,
    device const uint* adjacency_edges,
    device const uint* overlay,
    uint overlay_count,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    device const uchar* relationship_masks,
    device const uint* paths,
    uint path,
    uint source,
    uint segment,
    bool skip_self_loops,
    constant VariablePathArgs& args,
    thread bool& corrupt) {
    IgVariablePathCsrRow row = ig_variable_path_csr_row(
        offsets, overlay, overlay_count, source);
    uint bound = row.overlay == 0u ? args.edge_count : overlay[overlay_count * 2u];
    if (row.begin > row.end || row.end > bound) {
        corrupt = true;
        return 0u;
    }
    uint count = 0u;
    for (uint position = row.begin; position < row.end; ++position) {
        uint neighbor = ig_variable_path_csr_neighbor(
            neighbors, overlay, overlay_count, row, position);
        uint edge = ig_variable_path_csr_edge(
            adjacency_edges, overlay, overlay_count, row, position);
        if (skip_self_loops && neighbor == source) continue;
        uint matched = ig_variable_path_candidate_matches(
            packet, node_active, node_layers, edge_active, edge_layers, edge_types,
            relationship_masks, paths, path, neighbor, edge, segment, args);
        if (matched == 2u) {
            corrupt = true;
            return 0u;
        }
        count += matched;
    }
    return count;
}

inline uint ig_variable_path_scatter_orientation(
    device const long* packet,
    device const uint* offsets,
    device const uint* neighbors,
    device const uint* adjacency_edges,
    device const uint* overlay,
    uint overlay_count,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    device const long* edge_types,
    device const uchar* relationship_masks,
    device const uint* source_paths,
    device uint* destination_paths,
    uint path,
    uint source,
    uint segment,
    uint write,
    bool skip_self_loops,
    constant VariablePathArgs& args,
    thread bool& corrupt) {
    IgVariablePathCsrRow row = ig_variable_path_csr_row(
        offsets, overlay, overlay_count, source);
    uint bound = row.overlay == 0u ? args.edge_count : overlay[overlay_count * 2u];
    if (row.begin > row.end || row.end > bound) {
        corrupt = true;
        return write;
    }
    uint length = source_paths[2u * args.frontier_capacity + path];
    if (length >= args.edge_count) return write;
    for (uint position = row.begin; position < row.end; ++position) {
        uint neighbor = ig_variable_path_csr_neighbor(
            neighbors, overlay, overlay_count, row, position);
        uint edge = ig_variable_path_csr_edge(
            adjacency_edges, overlay, overlay_count, row, position);
        if (skip_self_loops && neighbor == source) continue;
        uint matched = ig_variable_path_candidate_matches(
            packet, node_active, node_layers, edge_active, edge_layers, edge_types,
            relationship_masks, source_paths, path, neighbor, edge, segment, args);
        if (matched == 2u) {
            corrupt = true;
            return write;
        }
        if (matched == 0u) continue;
        ig_variable_path_copy_one(source_paths, path, destination_paths, write, args);
        uint next_length = length + 1u;
        destination_paths[args.frontier_capacity + write] = neighbor;
        destination_paths[2u * args.frontier_capacity + write] = next_length;
        ulong edge_slot = ig_variable_path_edge_base(args)
            + ulong(write) * ulong(ig_variable_path_edge_stride(args)) + ulong(length);
        ulong node_slot = ig_variable_path_node_base(args)
            + ulong(write) * ulong(ig_variable_path_node_stride(args)) + ulong(next_length);
        destination_paths[edge_slot] = edge;
        destination_paths[node_slot] = neighbor;
        ++write;
    }
    return write;
}

kernel void ig_variable_path_initialize(
    device const uint* input_rows [[buffer(0)]],
    device const long* packet [[buffer(1)]],
    device const uchar* start_mask [[buffer(2)]],
    device const uchar* multiplicity_masks [[buffer(3)]],
    device const uchar* terminal_mask [[buffer(4)]],
    device uint* frontier [[buffer(5)]],
    device uint* terminal_rows [[buffer(6)]],
    device uint* parent_table [[buffer(7)]],
    device atomic_uint* control [[buffer(8)]],
    constant VariablePathArgs& args [[buffer(9)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u) return;
    for (uint word = 0u; word < args.control_words; ++word) {
        atomic_store_explicit(&control[word], 0u, memory_order_relaxed);
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PHASE],
        IG_VARIABLE_PATH_PHASE_INITIALIZE,
        memory_order_relaxed);
    if (!ig_variable_path_packet_valid(packet, args)) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    ulong multiplicity = 1ul;
    for (uint scan = 0u; scan < args.multiplicity_scan_count; ++scan) {
        uint visible = 0u;
        for (uint row = 0u; row < args.node_count; ++row) {
            uchar selected = multiplicity_masks[
                ulong(scan) * ulong(args.node_count) + ulong(row)];
            if (selected > 1u) {
                ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
                return;
            }
            visible += uint(selected);
        }
        atomic_store_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_CARDINALITIES + scan],
            visible,
            memory_order_relaxed);
        if (visible != 0u
                && multiplicity > ulong(args.frontier_capacity) / ulong(visible)) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY);
            return;
        }
        multiplicity *= ulong(visible);
    }
    uint terminal_count = 0u;
    if (args.bound_terminal_mode != 0u) {
        for (uint row = 0u; row < args.node_count; ++row) {
            uchar selected = terminal_mask[row];
            if (selected > 1u) {
                ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
                return;
            }
            if (selected != 0u) terminal_rows[terminal_count++] = row;
        }
        atomic_store_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_CARDINALITIES
                + args.multiplicity_scan_count],
            terminal_count,
            memory_order_relaxed);
    }
    uint selected = 0u;
    for (uint position = 0u; position < args.input_row_count; ++position) {
        uint row = args.source_mode == 1u ? position : input_rows[position];
        if (row >= args.node_count || start_mask[row] > 1u) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
            return;
        }
        if (start_mask[row] == 0u) {
            if (args.source_mode == 0u) {
                ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_INVISIBLE_INPUT);
                return;
            }
            continue;
        }
        ++selected;
    }
    ulong combined = multiplicity;
    if (selected != 0u
            && combined > ulong(args.frontier_capacity) / ulong(selected)) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY);
        return;
    }
    combined *= ulong(selected);
    uint terminal_factor = args.bound_terminal_mode != 0u ? terminal_count : 1u;
    if (terminal_factor != 0u
            && combined > ulong(args.frontier_capacity) / ulong(terminal_factor)) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY);
        return;
    }
    combined *= ulong(terminal_factor);
    uint output = 0u;
    for (ulong outer = 0ul; outer < multiplicity; ++outer) {
        for (uint position = 0u; position < args.input_row_count; ++position) {
            uint row = args.source_mode == 1u ? position : input_rows[position];
            if (start_mask[row] == 0u) continue;
            for (uint terminal_index = 0u;
                    terminal_index < terminal_factor;
                    ++terminal_index) {
                uint terminal = args.bound_terminal_mode != 0u
                    ? terminal_rows[terminal_index]
                    : IG_VARIABLE_PATH_NULL_ROW;
                parent_table[ulong(output) * 2ul] = row;
                parent_table[ulong(output) * 2ul + 1ul] = terminal;
                frontier[output] = row;
                frontier[args.frontier_capacity + output] = row;
                frontier[2u * args.frontier_capacity + output] = 0u;
                frontier[3u * args.frontier_capacity + output] = output;
                frontier[ig_variable_path_node_base(args)
                    + ulong(output) * ulong(ig_variable_path_node_stride(args))] = row;
                ulong segment_base = ig_variable_path_segment_end_base(args)
                    + ulong(output) * ulong(args.segment_count);
                for (uint segment = 0u; segment < args.segment_count; ++segment) {
                    frontier[segment_base + ulong(segment)] = 0u;
                }
                ++output;
            }
        }
    }
    if (ulong(output) != combined) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], output, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_SELECTED_STARTS], selected, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COMBINED_STARTS], output, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_SELECTED_TERMINALS],
        terminal_count,
        memory_order_relaxed);
}

kernel void ig_variable_path_segment_begin(
    device const long* packet [[buffer(0)]],
    device atomic_uint* control [[buffer(1)]],
    constant VariablePathArgs& args [[buffer(2)]],
    constant VariablePathStepArgs& step [[buffer(3)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
                != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    if (step.segment >= args.segment_count || !ig_variable_path_packet_valid(packet, args)) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    ulong descriptor = ig_variable_path_segment_base(packet, step.segment);
    ulong direction = ig_variable_path_word(packet, descriptor);
    ulong minimum = ig_variable_path_word(packet, descriptor + 1ul);
    ulong maximum = 0ul;
    if (direction > 2ul
            || !ig_variable_path_decode_maximum(
                ig_variable_path_word(packet, descriptor + 2ul),
                minimum,
                args.edge_count,
                maximum)) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    uint frontier = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_SEGMENT_INPUT], frontier, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT], 0u, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_SEGMENT], step.segment, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_COUNT], 0u, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_DESTINATION], 0u, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT], 0u, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PHASE],
        IG_VARIABLE_PATH_PHASE_TRAVERSE,
        memory_order_relaxed);
}

kernel void ig_variable_path_copy(
    device const uint* source [[buffer(0)]],
    device uint* destination [[buffer(1)]],
    device const atomic_uint* control [[buffer(2)]],
    constant VariablePathArgs& args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_COUNT], memory_order_relaxed);
    if (row >= count) return;
    uint destination_base = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_DESTINATION], memory_order_relaxed);
    if (destination_base > args.frontier_capacity
            || count > args.frontier_capacity - destination_base) return;
    ig_variable_path_copy_one(source, row, destination, destination_base + row, args);
}

// Stable, device-resident endpoint filtering. Intermediate traversal frontiers remain intact;
// only candidates at an accepted depth are compacted into the segment's accepted-path bank.
kernel void ig_variable_path_accept_count(
    device const uint* source [[buffer(0)]],
    device const uchar* target_masks [[buffer(1)]],
    device const long* packet [[buffer(2)]],
    device uint* counts [[buffer(3)]],
    device atomic_uint* control [[buffer(4)]],
    constant VariablePathArgs& args [[buffer(5)]],
    constant VariablePathStepArgs& step [[buffer(6)]],
    uint row [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint frontier = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    if (row >= frontier) return;
    if (step.segment >= args.segment_count) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        counts[row] = 0u;
        return;
    }
    uint endpoint = source[args.frontier_capacity + row];
    if (endpoint >= args.node_count) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_PATH_SHAPE);
        counts[row] = 0u;
        return;
    }
    ulong mask = ulong(step.segment) * ulong(args.node_count) + ulong(endpoint);
    ulong descriptor = ig_variable_path_segment_base(packet, step.segment);
    ulong target_flags = ig_variable_path_word(packet, descriptor + 5ul);
    if ((target_flags & ~1ul) != 0ul) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        counts[row] = 0u;
        return;
    }
    bool equals_start = (target_flags & 1ul) == 0ul;
    if (!equals_start) {
        ulong node = ig_variable_path_node_base(args)
            + ulong(row) * ulong(ig_variable_path_node_stride(args));
        equals_start = source[node] == endpoint;
    }
    counts[row] = target_masks[mask] != 0 && equals_start ? 1u : 0u;
}

kernel void ig_variable_path_accept_prefix(
    device const uint* counts [[buffer(0)]],
    device uint* offsets [[buffer(1)]],
    device atomic_uint* control [[buffer(2)]],
    constant VariablePathArgs& args [[buffer(3)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
                != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint frontier = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    uint accepted = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT], memory_order_relaxed);
    if (frontier > args.frontier_capacity || accepted > args.frontier_capacity) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY);
        return;
    }
    ulong matched = 0ul;
    for (uint row = 0u; row < frontier; ++row) {
        if (counts[row] > 1u) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
            return;
        }
        offsets[row] = accepted + uint(matched);
        matched += ulong(counts[row]);
        if (matched > ulong(args.frontier_capacity - accepted)) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY);
            return;
        }
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT],
        accepted + uint(matched),
        memory_order_relaxed);
}

kernel void ig_variable_path_accept_scatter(
    device const uint* source [[buffer(0)]],
    device uint* accepted [[buffer(1)]],
    device const uint* counts [[buffer(2)]],
    device const uint* offsets [[buffer(3)]],
    device const atomic_uint* control [[buffer(4)]],
    constant VariablePathArgs& args [[buffer(5)]],
    constant VariablePathStepArgs& step [[buffer(6)]],
    uint row [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint frontier = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    if (row >= frontier || counts[row] == 0u) return;
    if (step.segment >= args.segment_count) return;
    uint destination = offsets[row];
    uint accepted_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT], memory_order_relaxed);
    if (destination >= accepted_count || destination >= args.frontier_capacity) return;
    ig_variable_path_copy_one(source, row, accepted, destination, args);
    uint length = source[2u * args.frontier_capacity + row];
    accepted[ig_variable_path_segment_end_base(args)
            + ulong(destination) * ulong(args.segment_count) + ulong(step.segment)] = length;
}

kernel void ig_variable_path_expand_count(
    device const long* packet [[buffer(0)]],
    device const uint* outgoing_offsets [[buffer(1)]],
    device const uint* outgoing_neighbors [[buffer(2)]],
    device const uint* outgoing_edges [[buffer(3)]],
    device const uint* incoming_offsets [[buffer(4)]],
    device const uint* incoming_neighbors [[buffer(5)]],
    device const uint* incoming_edges [[buffer(6)]],
    device const uchar* node_active [[buffer(7)]],
    device const uchar* node_layers [[buffer(8)]],
    device const uchar* edge_active [[buffer(9)]],
    device const uchar* edge_layers [[buffer(10)]],
    device const long* edge_types [[buffer(11)]],
    device const uchar* relationship_masks [[buffer(12)]],
    device const uint* paths [[buffer(13)]],
    device uint* counts [[buffer(14)]],
    device atomic_uint* control [[buffer(15)]],
    device const uint* outgoing_overlay [[buffer(16)]],
    device const uint* incoming_overlay [[buffer(17)]],
    constant VariablePathArgs& args [[buffer(18)]],
    constant VariablePathStepArgs& step [[buffer(19)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint frontier = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    if (path >= frontier) return;
    if (step.segment >= args.segment_count) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    uint source = paths[args.frontier_capacity + path];
    uint length = paths[2u * args.frontier_capacity + path];
    if (source >= args.node_count || length > args.edge_count) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_PATH_SHAPE);
        counts[path] = 0u;
        return;
    }
    ulong descriptor = ig_variable_path_segment_base(packet, step.segment);
    uint direction = uint(ig_variable_path_word(packet, descriptor));
    bool corrupt = false;
    uint count = 0u;
    if (length < args.edge_count && (direction == 0u || direction == 2u)) {
        count += ig_variable_path_count_orientation(
            packet, outgoing_offsets, outgoing_neighbors, outgoing_edges,
            outgoing_overlay, args.outgoing_overlay_count,
            node_active, node_layers, edge_active, edge_layers, edge_types,
            relationship_masks, paths, path, source, step.segment, false, args, corrupt);
    }
    if (!corrupt && length < args.edge_count && (direction == 1u || direction == 2u)) {
        count += ig_variable_path_count_orientation(
            packet, incoming_offsets, incoming_neighbors, incoming_edges,
            incoming_overlay, args.incoming_overlay_count,
            node_active, node_layers, edge_active, edge_layers, edge_types,
            relationship_masks, paths, path, source, step.segment, direction == 2u,
            args, corrupt);
    }
    if (direction > 2u || corrupt) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        counts[path] = 0u;
        return;
    }
    counts[path] = count;
}

kernel void ig_variable_path_prefix(
    device const uint* counts [[buffer(0)]],
    device uint* offsets [[buffer(1)]],
    device atomic_uint* control [[buffer(2)]],
    constant VariablePathArgs& args [[buffer(3)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
                != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint parents = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    ulong total = 0ul;
    for (uint path = 0u; path < parents; ++path) {
        offsets[path] = uint(total);
        total += ulong(counts[path]);
        if (total > ulong(args.frontier_capacity)) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY);
            atomic_store_explicit(
                &control[IG_VARIABLE_PATH_CONTROL_PARENT_COUNT], parents, memory_order_relaxed);
            atomic_store_explicit(
                &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], 0u, memory_order_relaxed);
            return;
        }
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PARENT_COUNT], parents, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_NEXT_COUNT], uint(total), memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], uint(total), memory_order_relaxed);
}

kernel void ig_variable_path_scatter(
    device const long* packet [[buffer(0)]],
    device const uint* outgoing_offsets [[buffer(1)]],
    device const uint* outgoing_neighbors [[buffer(2)]],
    device const uint* outgoing_edges [[buffer(3)]],
    device const uint* incoming_offsets [[buffer(4)]],
    device const uint* incoming_neighbors [[buffer(5)]],
    device const uint* incoming_edges [[buffer(6)]],
    device const uchar* node_active [[buffer(7)]],
    device const uchar* node_layers [[buffer(8)]],
    device const uchar* edge_active [[buffer(9)]],
    device const uchar* edge_layers [[buffer(10)]],
    device const long* edge_types [[buffer(11)]],
    device const uchar* relationship_masks [[buffer(12)]],
    device const uint* source_paths [[buffer(13)]],
    device uint* destination_paths [[buffer(14)]],
    device const uint* offsets [[buffer(15)]],
    device atomic_uint* control [[buffer(16)]],
    device const uint* outgoing_overlay [[buffer(17)]],
    device const uint* incoming_overlay [[buffer(18)]],
    constant VariablePathArgs& args [[buffer(19)]],
    constant VariablePathStepArgs& step [[buffer(20)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint parents = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PARENT_COUNT], memory_order_relaxed);
    if (path >= parents) return;
    uint source = source_paths[args.frontier_capacity + path];
    ulong descriptor = ig_variable_path_segment_base(packet, step.segment);
    uint direction = uint(ig_variable_path_word(packet, descriptor));
    bool corrupt = false;
    uint write = offsets[path];
    if (direction == 0u || direction == 2u) {
        write = ig_variable_path_scatter_orientation(
            packet, outgoing_offsets, outgoing_neighbors, outgoing_edges,
            outgoing_overlay, args.outgoing_overlay_count,
            node_active, node_layers, edge_active, edge_layers, edge_types,
            relationship_masks, source_paths, destination_paths, path, source,
            step.segment, write, false, args, corrupt);
    }
    if (!corrupt && (direction == 1u || direction == 2u)) {
        write = ig_variable_path_scatter_orientation(
            packet, incoming_offsets, incoming_neighbors, incoming_edges,
            incoming_overlay, args.incoming_overlay_count,
            node_active, node_layers, edge_active, edge_layers, edge_types,
            relationship_masks, source_paths, destination_paths, path, source,
            step.segment, write, direction == 2u, args, corrupt);
    }
    if (corrupt) ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
}

kernel void ig_variable_path_accept_prepare(
    device atomic_uint* control [[buffer(0)]],
    constant VariablePathArgs& args [[buffer(1)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
                != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint accepted = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT], memory_order_relaxed);
    uint frontier = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    if (accepted > args.frontier_capacity || frontier > args.frontier_capacity - accepted) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_FRONTIER_CAPACITY);
        return;
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_COUNT], frontier, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_DESTINATION], accepted, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT],
        accepted + frontier,
        memory_order_relaxed);
}

kernel void ig_variable_path_segment_finish(
    device atomic_uint* control [[buffer(0)]],
    constant VariablePathArgs& args [[buffer(1)]],
    constant VariablePathStepArgs& step [[buffer(2)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
                != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    if (step.segment >= args.segment_count) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    uint input = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_SEGMENT_INPUT], memory_order_relaxed);
    uint output = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT], memory_order_relaxed);
    uint card = IG_VARIABLE_PATH_CONTROL_CARDINALITIES
        + args.multiplicity_scan_count + args.bound_terminal_mode
        + step.segment * 2u;
    atomic_store_explicit(&control[card], input, memory_order_relaxed);
    atomic_store_explicit(&control[card + 1u], output, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], output, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_COUNT], output, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COPY_DESTINATION], 0u, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_ACCEPTED_COUNT], 0u, memory_order_relaxed);
}

// Finalization is a device-only stable filter over the completed candidate frontier. The row map
// uses two AoS words per publication row: [parent_row, candidate_index_or_u32_MAX].
kernel void ig_variable_path_finalize_clear(
    device atomic_uint* parent_matches [[buffer(0)]],
    device uint* counts [[buffer(1)]],
    device uint* offsets [[buffer(2)]],
    device atomic_uint* control [[buffer(3)]],
    constant VariablePathArgs& args [[buffer(4)]],
    uint tid [[thread_position_in_grid]]) {
    if (atomic_load_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint candidate_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    uint parent_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COMBINED_STARTS], memory_order_relaxed);
    if (candidate_count > args.frontier_capacity || parent_count > args.frontier_capacity) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    if (tid < parent_count) {
        atomic_store_explicit(&parent_matches[tid], 0u, memory_order_relaxed);
    }
    if (tid < candidate_count) {
        counts[tid] = 0u;
        offsets[tid] = 0u;
    }
    if (tid == 0u) {
        atomic_store_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_PRE_FINAL_COUNT],
            candidate_count,
            memory_order_relaxed);
        atomic_store_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_KEPT_COUNT], 0u, memory_order_relaxed);
        atomic_store_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_NULL_COUNT], 0u, memory_order_relaxed);
    }
}

kernel void ig_variable_path_finalize_count(
    device const uint* paths [[buffer(0)]],
    device const uint* parent_table [[buffer(1)]],
    device uint* keep_flags [[buffer(2)]],
    device atomic_uint* parent_matches [[buffer(3)]],
    device atomic_uint* control [[buffer(4)]],
    constant VariablePathArgs& args [[buffer(5)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint candidate_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PRE_FINAL_COUNT], memory_order_relaxed);
    if (path >= candidate_count) return;
    uint parent_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COMBINED_STARTS], memory_order_relaxed);
    uint start = paths[path];
    uint end = paths[args.frontier_capacity + path];
    uint length = paths[2u * args.frontier_capacity + path];
    uint parent = paths[3u * args.frontier_capacity + path];
    if (parent >= parent_count || start >= args.node_count || end >= args.node_count
            || length > args.edge_count
            || parent_table[ulong(parent) * 2ul] != start) {
        keep_flags[path] = 0u;
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_PATH_SHAPE);
        return;
    }
    uint terminal = parent_table[ulong(parent) * 2ul + 1ul];
    if ((args.bound_terminal_mode == 0u && terminal != IG_VARIABLE_PATH_NULL_ROW)
            || (args.bound_terminal_mode != 0u && terminal >= args.node_count)) {
        keep_flags[path] = 0u;
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    uint keep = args.bound_terminal_mode == 0u || end == terminal ? 1u : 0u;
    keep_flags[path] = keep;
    if (keep != 0u) {
        atomic_store_explicit(&parent_matches[parent], 1u, memory_order_relaxed);
    }
}

kernel void ig_variable_path_finalize_prefix(
    device uint* keep_flags [[buffer(0)]],
    device uint* offsets [[buffer(1)]],
    device atomic_uint* control [[buffer(2)]],
    constant VariablePathArgs& args [[buffer(3)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(
                &control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
                != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint candidate_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PRE_FINAL_COUNT], memory_order_relaxed);
    if (candidate_count > args.frontier_capacity) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    ulong kept = 0ul;
    for (uint path = 0u; path < candidate_count; ++path) {
        uint keep = keep_flags[path];
        if (keep > 1u) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
            return;
        }
        if (keep != 0u && kept >= ulong(args.output_limit)) {
            keep = 0u;
            keep_flags[path] = 0u;
        }
        offsets[path] = uint(kept);
        kept += ulong(keep);
        if (kept > ulong(args.output_capacity)) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_OUTPUT_CAPACITY);
            return;
        }
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_KEPT_COUNT], uint(kept), memory_order_relaxed);
}

kernel void ig_variable_path_finalize_scatter(
    device const uint* paths [[buffer(0)]],
    device const uint* keep_flags [[buffer(1)]],
    device const uint* offsets [[buffer(2)]],
    device uint* row_map [[buffer(3)]],
    device atomic_uint* control [[buffer(4)]],
    constant VariablePathArgs& args [[buffer(5)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
            != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint candidate_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PRE_FINAL_COUNT], memory_order_relaxed);
    if (path >= candidate_count || keep_flags[path] == 0u) return;
    uint kept = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_KEPT_COUNT], memory_order_relaxed);
    uint write = offsets[path];
    uint parent = paths[3u * args.frontier_capacity + path];
    uint parent_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COMBINED_STARTS], memory_order_relaxed);
    if (keep_flags[path] != 1u || write >= kept || write >= args.output_capacity
            || parent >= parent_count) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    row_map[ulong(write) * 2ul] = parent;
    row_map[ulong(write) * 2ul + 1ul] = path;
}

kernel void ig_variable_path_finalize_nulls(
    device const uint* parent_table [[buffer(0)]],
    device const atomic_uint* parent_matches [[buffer(1)]],
    device uint* row_map [[buffer(2)]],
    device atomic_uint* control [[buffer(3)]],
    constant VariablePathArgs& args [[buffer(4)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(
                &control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed)
                != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    uint parent_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COMBINED_STARTS], memory_order_relaxed);
    uint output = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_KEPT_COUNT], memory_order_relaxed);
    if (parent_count > args.frontier_capacity || output > args.output_capacity) {
        ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
        return;
    }
    uint null_count = 0u;
    for (uint parent = 0u; parent < parent_count; ++parent) {
        uint start = parent_table[ulong(parent) * 2ul];
        uint terminal = parent_table[ulong(parent) * 2ul + 1ul];
        uint matched = atomic_load_explicit(&parent_matches[parent], memory_order_relaxed);
        if (start >= args.node_count || matched > 1u
                || (args.bound_terminal_mode == 0u
                    && terminal != IG_VARIABLE_PATH_NULL_ROW)
                || (args.bound_terminal_mode != 0u && terminal >= args.node_count)) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_CORRUPT);
            return;
        }
        if (args.optional_mode == 0u || matched != 0u) continue;
        if (output >= args.output_capacity) {
            ig_variable_path_fail(control, IG_VARIABLE_PATH_STATUS_OUTPUT_CAPACITY);
            return;
        }
        row_map[ulong(output) * 2ul] = parent;
        row_map[ulong(output) * 2ul + 1ul] = IG_VARIABLE_PATH_NULL_ROW;
        ++output;
        ++null_count;
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_NULL_COUNT], null_count, memory_order_relaxed);
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], output, memory_order_relaxed);
}

inline void ig_variable_path_write_receipt(
    device long* output,
    uint receipt,
    ulong obligation_id,
    ulong metadata,
    ulong input,
    ulong result,
    constant VariablePathArgs& args) {
    ulong base = ulong(IG_VARIABLE_PATH_OUTPUT_HEADER_WORDS)
        + ulong(receipt) * ulong(IG_VARIABLE_PATH_RECEIPT_WORDS);
    output[base] = as_type<long>(args.execution_high);
    output[base + 1ul] = as_type<long>(args.execution_low);
    output[base + 2ul] = as_type<long>(obligation_id);
    output[base + 3ul] = as_type<long>(metadata);
    output[base + 4ul] = as_type<long>(input);
    output[base + 5ul] = as_type<long>(result);
    output[base + 6ul] = as_type<long>(2ul);
}

inline uint ig_variable_path_next_parent_publication(
    device const uint* row_map,
    uint publication_count,
    uint parent,
    uint cursor) {
    for (uint row = cursor; row < publication_count; ++row) {
        if (row_map[ulong(row) * 2ul] == parent
                && row_map[ulong(row) * 2ul + 1ul] != IG_VARIABLE_PATH_NULL_ROW) {
            return row;
        }
    }
    return IG_VARIABLE_PATH_NULL_ROW;
}

inline bool ig_variable_path_output_paths_equal(
    device const long* output,
    uint left,
    uint right,
    ulong descriptor_base,
    ulong edge_base,
    ulong node_base,
    constant VariablePathArgs& args) {
    ulong left_descriptor = descriptor_base + ulong(left) * 3ul;
    ulong right_descriptor = descriptor_base + ulong(right) * 3ul;
    ulong length = as_type<ulong>(output[left_descriptor + 2ul]);
    if (output[left_descriptor] != output[right_descriptor]
            || output[left_descriptor + 1ul] != output[right_descriptor + 1ul]
            || output[left_descriptor + 2ul] != output[right_descriptor + 2ul]
            || length > ulong(args.edge_count)) {
        return false;
    }
    for (ulong hop = 0ul; hop < length; ++hop) {
        if (output[edge_base + ulong(left) * ulong(args.edge_count) + hop]
                != output[edge_base + ulong(right) * ulong(args.edge_count) + hop]) {
            return false;
        }
    }
    ulong node_stride = ulong(ig_variable_path_node_stride(args));
    for (ulong node = 0ul; node <= length; ++node) {
        if (output[node_base + ulong(left) * node_stride + node]
                != output[node_base + ulong(right) * node_stride + node]) {
            return false;
        }
    }
    return true;
}

inline bool ig_variable_path_parent_lists_equal(
    device const uint* row_map,
    device const long* output,
    uint publication_count,
    uint left_parent,
    uint right_parent,
    ulong descriptor_base,
    ulong edge_base,
    ulong node_base,
    constant VariablePathArgs& args) {
    uint left_cursor = 0u;
    uint right_cursor = 0u;
    while (true) {
        uint left = ig_variable_path_next_parent_publication(
            row_map, publication_count, left_parent, left_cursor);
        uint right = ig_variable_path_next_parent_publication(
            row_map, publication_count, right_parent, right_cursor);
        if (left == IG_VARIABLE_PATH_NULL_ROW || right == IG_VARIABLE_PATH_NULL_ROW) {
            return left == right;
        }
        if (!ig_variable_path_output_paths_equal(
                output, left, right, descriptor_base, edge_base, node_base, args)) {
            return false;
        }
        left_cursor = left + 1u;
        right_cursor = right + 1u;
    }
}

// Returns 2 for corrupt resident metadata, 1 for a visible selected node, and 0 otherwise.
inline uint ig_variable_path_final_node_selected(
    uint node,
    bool apply_selection,
    device const uchar* final_node_mask,
    device const uchar* node_active,
    device const uchar* node_layers,
    constant VariablePathArgs& args) {
    if (node >= args.node_count) return 2u;
    uchar active = node_active[node];
    uchar layer = node_layers[node];
    uchar selected = apply_selection ? final_node_mask[node] : 1u;
    if (active > 1u || layer > IG_MAX_LAYER || selected > 1u) return 2u;
    return active != 0u
            && (args.layer_mask & (1u << uint(layer))) != 0u
            && selected != 0u
        ? 1u
        : 0u;
}

// Returns 2 for corrupt resident metadata, 1 for a visible adjacency row, and 0 otherwise.
inline uint ig_variable_path_final_adjacency_selected(
    uint neighbor,
    uint edge,
    bool apply_neighbor_selection,
    device const uchar* final_node_mask,
    device const uchar* node_active,
    device const uchar* node_layers,
    device const uchar* edge_active,
    device const uchar* edge_layers,
    constant VariablePathArgs& args) {
    uint node_selected = ig_variable_path_final_node_selected(
        neighbor, apply_neighbor_selection, final_node_mask, node_active, node_layers, args);
    if (node_selected == 2u || edge >= args.edge_count) return 2u;
    uchar active = edge_active[edge];
    uchar layer = edge_layers[edge];
    if (active > 1u || layer > IG_MAX_LAYER) return 2u;
    return node_selected != 0u
            && active != 0u
            && (args.layer_mask & (1u << uint(layer))) != 0u
        ? 1u
        : 0u;
}

// Convert the non-negative path-length sum with the same round-to-nearest-even semantics as
// Rust's `u64 as f64`. The scalar helper is signed and therefore cannot represent the full
// bounded `u32 publication_count * u32 path_length` domain.
inline ulong ig_variable_path_u64_to_f64(ulong magnitude) {
    if (magnitude == 0ul) return 0ul;
    uint most_significant = 0u;
    for (ulong value = magnitude; value > 1ul; value >>= 1u) ++most_significant;
    ulong significand = 0ul;
    uint exponent = most_significant + 1023u;
    if (most_significant <= 52u) {
        significand = magnitude << (52u - most_significant);
    } else {
        uint shift = most_significant - 52u;
        significand = magnitude >> shift;
        ulong remainder_mask = (1ul << shift) - 1ul;
        ulong remainder = magnitude & remainder_mask;
        ulong halfway = 1ul << (shift - 1u);
        if (remainder > halfway || (remainder == halfway && (significand & 1ul) != 0ul)) {
            ++significand;
            if (significand == 0x0020000000000000ul) {
                significand >>= 1u;
                ++exponent;
            }
        }
    }
    return (ulong(exponent) << 52u) | (significand & 0x000ffffffffffffful);
}

// Return the minimum path length for the first publication of one non-self endpoint pair. Later
// publications of that pair and self-pairs return false, allowing deterministic pair reduction
// without a host-authored hash table.
inline bool ig_variable_path_first_pair_minimum(
    device const long* output,
    ulong descriptor_base,
    uint row,
    uint publication_count,
    thread uint& minimum) {
    ulong descriptor = descriptor_base + ulong(row) * 3ul;
    uint start = uint(as_type<ulong>(output[descriptor]));
    uint end = uint(as_type<ulong>(output[descriptor + 1ul]));
    if (start == end) return false;
    for (uint prior = 0u; prior < row; ++prior) {
        ulong prior_descriptor = descriptor_base + ulong(prior) * 3ul;
        if (uint(as_type<ulong>(output[prior_descriptor])) == start
                && uint(as_type<ulong>(output[prior_descriptor + 1ul])) == end) {
            return false;
        }
    }
    minimum = uint(as_type<ulong>(output[descriptor + 2ul]));
    for (uint candidate = row + 1u; candidate < publication_count; ++candidate) {
        ulong candidate_descriptor = descriptor_base + ulong(candidate) * 3ul;
        if (uint(as_type<ulong>(output[candidate_descriptor])) == start
                && uint(as_type<ulong>(output[candidate_descriptor + 1ul])) == end) {
            minimum = min(
                minimum,
                uint(as_type<ulong>(output[candidate_descriptor + 2ul])));
        }
    }
    return true;
}

kernel void ig_variable_path_publish(
    device const long* packet [[buffer(0)]],
    device const uint* paths [[buffer(1)]],
    device const uint* parent_table [[buffer(2)]],
    device const uint* row_map [[buffer(3)]],
    device atomic_uint* control [[buffer(4)]],
    device long* output [[buffer(5)]],
    constant VariablePathArgs& args [[buffer(6)]],
    device const uchar* final_node_mask [[buffer(7)]],
    device const long* final_property_values [[buffer(8)]],
    device const uchar* final_property_validity [[buffer(9)]],
    device const uint* outgoing_offsets [[buffer(10)]],
    device const uint* outgoing_neighbors [[buffer(11)]],
    device const uint* outgoing_edges [[buffer(12)]],
    device const uint* incoming_offsets [[buffer(13)]],
    device const uint* incoming_neighbors [[buffer(14)]],
    device const uint* incoming_edges [[buffer(15)]],
    device const uchar* node_active [[buffer(16)]],
    device const uchar* node_layers [[buffer(17)]],
    device const uchar* edge_active [[buffer(18)]],
    device const uchar* edge_layers [[buffer(19)]],
    device const long* edge_types [[buffer(20)]],
    device const uint* outgoing_overlay [[buffer(21)]],
    device const uint* incoming_overlay [[buffer(22)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u) return;
    for (ulong word = 0ul; word < args.output_word_count; ++word) output[word] = 0l;
    uint status = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_STATUS], memory_order_relaxed);
    uint phase = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PHASE], memory_order_relaxed);
    output[0] = as_type<long>(IG_VARIABLE_PATH_ABI);
    output[1] = as_type<long>(ulong(status) | (ulong(phase) << 32u));
    if (status != IG_VARIABLE_PATH_STATUS_RUNNING) return;
    if (!ig_variable_path_packet_valid(packet, args)) {
        output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
            | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
        return;
    }
    uint publication_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_FRONTIER_COUNT], memory_order_relaxed);
    uint parent_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_COMBINED_STARTS], memory_order_relaxed);
    uint pre_final_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PRE_FINAL_COUNT], memory_order_relaxed);
    uint kept_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_KEPT_COUNT], memory_order_relaxed);
    uint null_count = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_NULL_COUNT], memory_order_relaxed);
    if (publication_count > args.output_capacity) {
        output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_OUTPUT_CAPACITY)
            | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
        return;
    }
    if (parent_count > args.frontier_capacity
            || pre_final_count > args.frontier_capacity
            || kept_count > publication_count
            || null_count != publication_count - kept_count
            || (args.optional_mode == 0u && null_count != 0u)) {
        output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
            | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
        return;
    }
    output[2] = as_type<long>(args.execution_high);
    output[3] = as_type<long>(args.execution_low);
    output[4] = as_type<long>(args.bookmark_term);
    output[5] = as_type<long>(args.bookmark_index);
    output[6] = as_type<long>(args.graph_revision);
    output[7] = as_type<long>(args.layout_version);
    for (uint lane = 0u; lane < 4u; ++lane) output[8u + lane] = packet[3u + lane];
    uint selected = atomic_load_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_SELECTED_STARTS], memory_order_relaxed);
    output[12] = as_type<long>(ulong(parent_count));
    output[13] = as_type<long>(ulong(publication_count));
    output[14] = as_type<long>(ulong(args.output_capacity));
    output[15] = as_type<long>(ulong(args.edge_count));
    output[16] = as_type<long>(ulong(args.receipt_count));
    output[17] = as_type<long>(2ul);
    output[18] = as_type<long>(2ul);
    output[19] = as_type<long>(ulong(args.bound_terminal_mode)
        | (ulong(args.optional_mode) << 32u));
    output[20] = as_type<long>(ulong(args.final_projection_mode));
    output[23] = as_type<long>(args.final_projection_argument);

    uint receipt = 0u;
    for (uint scan = 0u; scan < args.multiplicity_scan_count; ++scan) {
        uint visible = atomic_load_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_CARDINALITIES + scan], memory_order_relaxed);
        ig_variable_path_write_receipt(
            output, receipt++,
            ig_variable_path_word(
                packet, ulong(IG_VARIABLE_PATH_PACKET_HEADER_WORDS + scan)),
            7ul | (6ul << 8u), ulong(args.node_count), ulong(visible), args);
    }
    if (args.bound_terminal_mode != 0u) {
        uint terminals = atomic_load_explicit(
            &control[IG_VARIABLE_PATH_CONTROL_SELECTED_TERMINALS], memory_order_relaxed);
        ig_variable_path_write_receipt(
            output, receipt++, args.bound_terminal_obligation_id,
            7ul | (6ul << 8u), ulong(args.node_count), ulong(terminals), args);
    }
    if (args.source_mode == 1u) {
        ig_variable_path_write_receipt(
            output, receipt++, args.scan_obligation_id,
            7ul | (6ul << 8u), ulong(args.node_count), ulong(selected), args);
    }
    if (args.cartesian_obligation_id != 0ul) {
        ig_variable_path_write_receipt(
            output, receipt++, args.cartesian_obligation_id,
            8ul | (9ul << 8u), ulong(parent_count), ulong(parent_count), args);
    }
    for (uint segment = 0u; segment < args.segment_count; ++segment) {
        ulong descriptor = ig_variable_path_segment_base(packet, segment);
        uint card = IG_VARIABLE_PATH_CONTROL_CARDINALITIES
            + args.multiplicity_scan_count + args.bound_terminal_mode
            + segment * 2u;
        uint input = atomic_load_explicit(&control[card], memory_order_relaxed);
        uint result = atomic_load_explicit(&control[card + 1u], memory_order_relaxed);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, descriptor + 6ul),
            5ul | (4ul << 8u) | (ulong(segment) << 16u),
            ulong(input), ulong(result), args);
    }
    ig_variable_path_write_receipt(
        output, receipt++, args.final_obligation_id,
        6ul | (5ul << 8u), ulong(pre_final_count), ulong(publication_count), args);
    uint pending_projection_receipt = args.final_projection_obligation_count;
    if (receipt + pending_projection_receipt != args.receipt_count) {
        output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
            | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
        return;
    }

    ulong descriptor_base = ulong(IG_VARIABLE_PATH_OUTPUT_HEADER_WORDS)
        + ulong(args.receipt_count) * ulong(IG_VARIABLE_PATH_RECEIPT_WORDS);
    ulong output_edge_base = descriptor_base + ulong(args.output_capacity) * 3ul;
    ulong output_node_base = output_edge_base
        + ulong(args.output_capacity) * ulong(args.edge_count);
    ulong output_segment_base = output_node_base
        + ulong(args.output_capacity) * ulong(args.edge_count + 1u);
    ulong output_metadata_base = output_segment_base
        + ulong(args.output_capacity) * ulong(args.segment_count);
    ulong final_descriptor_base = output_metadata_base
        + ulong(args.output_capacity) * 3ul;
    ulong final_map_base = final_descriptor_base
        + ulong(args.output_capacity) * 4ul;
    ulong source_edge_base = ig_variable_path_edge_base(args);
    ulong source_node_base = ig_variable_path_node_base(args);
    ulong source_segment_base = ig_variable_path_segment_end_base(args);
    ulong node_stride = ulong(ig_variable_path_node_stride(args));
    uint previous_candidate = 0u;
    uint previous_null_parent = 0u;
    for (uint row = 0u; row < publication_count; ++row) {
        uint parent = row_map[ulong(row) * 2ul];
        uint candidate = row_map[ulong(row) * 2ul + 1ul];
        if (parent >= parent_count) {
            output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
                | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
            return;
        }
        uint start = parent_table[ulong(parent) * 2ul];
        uint terminal = parent_table[ulong(parent) * 2ul + 1ul];
        if (start >= args.node_count
                || (args.bound_terminal_mode == 0u
                    && terminal != IG_VARIABLE_PATH_NULL_ROW)
                || (args.bound_terminal_mode != 0u && terminal >= args.node_count)) {
            output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
                | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
            return;
        }
        ulong metadata = output_metadata_base + ulong(row) * 3ul;
        output[metadata] = as_type<long>(ulong(parent));
        output[metadata + 1ul] = as_type<long>(ulong(terminal));
        ulong descriptor = descriptor_base + ulong(row) * 3ul;
        if (candidate == IG_VARIABLE_PATH_NULL_ROW) {
            if (args.optional_mode == 0u || row < kept_count
                    || (row != kept_count && parent <= previous_null_parent)) {
                output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
                    | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                return;
            }
            previous_null_parent = parent;
            output[descriptor] = as_type<long>(ulong(start));
            output[descriptor + 1ul] = as_type<long>(ulong(IG_VARIABLE_PATH_NULL_ROW));
            output[descriptor + 2ul] = 0l;
            output[metadata + 2ul] = 0l;
            continue;
        }
        if (row >= kept_count || candidate >= pre_final_count
                || (row != 0u && candidate <= previous_candidate)) {
            output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
                | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
            return;
        }
        previous_candidate = candidate;
        uint path_parent = paths[3u * args.frontier_capacity + candidate];
        uint path_start = paths[candidate];
        uint path_end = paths[args.frontier_capacity + candidate];
        uint length = paths[2u * args.frontier_capacity + candidate];
        if (path_parent != parent || path_start != start || path_end >= args.node_count
                || length > args.edge_count
                || (args.bound_terminal_mode != 0u && path_end != terminal)) {
            output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_PATH_SHAPE)
                | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
            return;
        }
        output[descriptor] = as_type<long>(ulong(path_start));
        output[descriptor + 1ul] = as_type<long>(ulong(path_end));
        output[descriptor + 2ul] = as_type<long>(ulong(length));
        output[metadata + 2ul] = 1l;
        for (uint hop = 0u; hop < length; ++hop) {
            output[output_edge_base + ulong(row) * ulong(args.edge_count) + ulong(hop)]
                = as_type<long>(ulong(paths[
                    source_edge_base
                        + ulong(candidate) * ulong(args.edge_count) + ulong(hop)]));
        }
        for (uint node = 0u; node <= length; ++node) {
            output[output_node_base + ulong(row) * node_stride + ulong(node)]
                = as_type<long>(ulong(paths[
                    source_node_base + ulong(candidate) * node_stride + ulong(node)]));
        }
        for (uint segment = 0u; segment < args.segment_count; ++segment) {
            output[output_segment_base
                    + ulong(row) * ulong(args.segment_count) + ulong(segment)]
                = as_type<long>(ulong(paths[source_segment_base
                    + ulong(candidate) * ulong(args.segment_count) + ulong(segment)]));
        }
    }

    ulong final_relation_cardinality = ulong(publication_count);
    ulong final_relation_value = 0ul;
    ulong final_relation_secondary_value = 0ul;
    if (args.final_projection_mode == 1u) {
        ulong count = 0ul;
        uint segment = uint(args.final_projection_argument);
        for (uint row = 0u; row < publication_count; ++row) {
            uint candidate = row_map[ulong(row) * 2ul + 1ul];
            if (candidate == IG_VARIABLE_PATH_NULL_ROW || candidate >= pre_final_count) {
                output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
                    | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                return;
            }
            uint length = paths[2u * args.frontier_capacity + candidate];
            uint end = paths[source_segment_base
                + ulong(candidate) * ulong(args.segment_count) + ulong(segment)];
            uint start = segment == 0u ? 0u : paths[source_segment_base
                + ulong(candidate) * ulong(args.segment_count) + ulong(segment - 1u)];
            if (start == 0xffffffffu || end != start + 1u || end > length) {
                output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_PATH_SHAPE)
                    | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                return;
            }
            uint source = paths[source_node_base + ulong(candidate) * node_stride + ulong(start)];
            uint target = paths[source_node_base + ulong(candidate) * node_stride + ulong(end)];
            count += source == target ? 1ul : 2ul;
        }
        final_relation_cardinality = 1ul;
        final_relation_value = count;
    } else if (args.final_projection_mode == 2u) {
        uint group_count = 0u;
        uint map_count = 0u;
        for (uint parent = 0u; parent < parent_count; ++parent) {
            uint selected_group = IG_VARIABLE_PATH_NULL_ROW;
            for (uint group = 0u; group < group_count; ++group) {
                ulong descriptor = final_descriptor_base + ulong(group) * 4ul;
                uint representative = uint(as_type<ulong>(output[descriptor]));
                if (ig_variable_path_parent_lists_equal(
                        row_map, output, publication_count, parent, representative,
                        descriptor_base, output_edge_base, output_node_base, args)) {
                    selected_group = group;
                    break;
                }
            }
            if (selected_group != IG_VARIABLE_PATH_NULL_ROW) {
                ulong descriptor = final_descriptor_base + ulong(selected_group) * 4ul;
                ulong members = as_type<ulong>(output[descriptor + 3ul]);
                output[descriptor + 3ul] = as_type<long>(members + 1ul);
                continue;
            }
            if (group_count >= args.output_capacity) {
                output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_OUTPUT_CAPACITY)
                    | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                return;
            }
            ulong descriptor = final_descriptor_base + ulong(group_count) * 4ul;
            output[descriptor] = as_type<long>(ulong(parent));
            output[descriptor + 1ul] = as_type<long>(ulong(map_count));
            uint path_count = 0u;
            for (uint row = 0u; row < publication_count; ++row) {
                if (row_map[ulong(row) * 2ul] != parent
                        || row_map[ulong(row) * 2ul + 1ul] == IG_VARIABLE_PATH_NULL_ROW) {
                    continue;
                }
                if (map_count >= args.output_capacity) {
                    output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_OUTPUT_CAPACITY)
                        | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                    return;
                }
                output[final_map_base + ulong(map_count)] = as_type<long>(ulong(row));
                ++map_count;
                ++path_count;
            }
            output[descriptor + 2ul] = as_type<long>(ulong(path_count));
            output[descriptor + 3ul] = as_type<long>(1ul);
            ++group_count;
        }
        final_relation_cardinality = ulong(group_count);
        final_relation_value = ulong(map_count);
    } else if (args.final_projection_mode == 3u) {
        uint selected_count = 0u;
        for (uint row = 0u; row < publication_count; ++row) {
            ulong descriptor = descriptor_base + ulong(row) * 3ul;
            ulong metadata = output_metadata_base + ulong(row) * 3ul;
            bool keep = args.final_projection_argument == 0ul;
            if (args.final_projection_argument == 1ul) {
                keep = output[metadata + 2ul] != 0l
                    && output[descriptor] == output[descriptor + 1ul];
            } else if (args.final_projection_argument == 2ul) {
                keep = output[metadata + 2ul] == 0l
                    && output[descriptor] != output[metadata + 1ul];
            }
            if (!keep) continue;
            if (selected_count >= args.output_capacity) {
                output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_OUTPUT_CAPACITY)
                    | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                return;
            }
            output[final_map_base + ulong(selected_count)] = as_type<long>(ulong(row));
            ++selected_count;
        }
        final_relation_cardinality = ulong(selected_count);
        final_relation_value = ulong(selected_count);
    } else if (args.final_projection_mode == 4u) {
        ulong inner_count = 0ul;
        bool apply_label = (args.final_projection_flags & 1ul) != 0ul;
        for (uint row = 0u; row < publication_count; ++row) {
            ulong descriptor = descriptor_base + ulong(row) * 3ul;
            ulong metadata = output_metadata_base + ulong(row) * 3ul;
            if (output[metadata + 2ul] == 0l || as_type<ulong>(output[descriptor + 2ul]) != 1ul) {
                output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_PATH_SHAPE)
                    | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                return;
            }
            ulong count_descriptor = final_descriptor_base + ulong(row) * 3ul;
            output[count_descriptor] = as_type<long>(ulong(row));
            for (uint lane = 0u; lane < 2u; ++lane) {
                uint source = uint(as_type<ulong>(output[
                    output_node_base + ulong(row) * node_stride + ulong(lane)]));
                if (source >= args.node_count) {
                    output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_PATH_SHAPE)
                        | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                    return;
                }
                IgVariablePathCsrRow adjacency = ig_variable_path_csr_row(
                    outgoing_offsets, outgoing_overlay,
                    args.outgoing_overlay_count, source);
                uint adjacency_bound = adjacency.overlay == 0u ? args.edge_count
                    : outgoing_overlay[args.outgoing_overlay_count * 2u];
                if (adjacency.begin > adjacency.end || adjacency.end > adjacency_bound) {
                    output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
                        | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                    return;
                }
                ulong count = 0ul;
                for (uint position = adjacency.begin; position < adjacency.end; ++position) {
                    uint neighbor = ig_variable_path_csr_neighbor(
                        outgoing_neighbors, outgoing_overlay,
                        args.outgoing_overlay_count, adjacency, position);
                    uint edge = ig_variable_path_csr_edge(
                        outgoing_edges, outgoing_overlay,
                        args.outgoing_overlay_count, adjacency, position);
                    uint visible = ig_variable_path_final_adjacency_selected(
                        neighbor, edge, apply_label,
                        final_node_mask, node_active, node_layers, edge_active, edge_layers, args);
                    if (visible == 2u) {
                        output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
                            | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
                        return;
