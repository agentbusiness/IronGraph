inline IgQU128 ig_q_u128_add(IgQU128 left, IgQU128 right) {
    IgQU128 result;
    result.low = left.low + right.low;
    result.high = left.high + right.high + (result.low < left.low ? 1ul : 0ul);
    return result;
}

inline IgQU128 ig_q_u128_add_u64(IgQU128 value, ulong addend) {
    IgQU128 result;
    result.low = value.low + addend;
    result.high = value.high + (result.low < value.low ? 1ul : 0ul);
    return result;
}

inline IgQU128 ig_q_u128_shift_left(IgQU128 value, uint shift) {
    if (shift == 0u) return value;
    IgQU128 result;
    if (shift < 64u) {
        result.low = value.low << shift;
        result.high = (value.high << shift) | (value.low >> (64u - shift));
    } else if (shift == 64u) {
        result.low = 0ul;
        result.high = value.low;
    } else {
        result.low = 0ul;
        result.high = value.low << (shift - 64u);
    }
    return result;
}

inline IgQU128 ig_q_u128_shift_right(IgQU128 value, uint shift) {
    if (shift == 0u) return value;
    IgQU128 result;
    if (shift < 64u) {
        result.low = (value.low >> shift) | (value.high << (64u - shift));
        result.high = value.high >> shift;
    } else if (shift == 64u) {
        result.low = value.high;
        result.high = 0ul;
    } else {
        result.low = value.high >> (shift - 64u);
        result.high = 0ul;
    }
    return result;
}

inline IgQU128 ig_q_u128_mul64(ulong left, ulong right) {
    ulong left_low = ulong(uint(left));
    ulong left_high = left >> 32u;
    ulong right_low = ulong(uint(right));
    ulong right_high = right >> 32u;
    ulong low_low = left_low * right_low;
    ulong low_high = left_low * right_high;
    ulong high_low = left_high * right_low;
    ulong high_high = left_high * right_high;

    IgQU128 result;
    result.low = low_low;
    ulong previous = result.low;
    result.low += low_high << 32u;
    ulong carry = result.low < previous ? 1ul : 0ul;
    previous = result.low;
    result.low += high_low << 32u;
    carry += result.low < previous ? 1ul : 0ul;
    result.high = high_high + (low_high >> 32u) + (high_low >> 32u) + carry;
    return result;
}

inline int ig_q_pow5_bits(int exponent) {
    return int((uint(exponent) * 1217359u) >> 19u) + 1;
}

inline uint ig_q_log10_pow2(int exponent) {
    return (uint(exponent) * 78913u) >> 18u;
}

inline uint ig_q_log10_pow5(int exponent) {
    return (uint(exponent) * 732923u) >> 20u;
}

inline IgQU128 ig_q_compute_pow5(uint exponent) {
    uint base = exponent / 26u;
    uint base_exponent = base * 26u;
    uint offset = exponent - base_exponent;
    IgQU128 multiplier = IG_Q_DOUBLE_POW5_SPLIT2[base];
    if (offset == 0u) return multiplier;
    ulong small_power = IG_Q_DOUBLE_POW5_TABLE[offset];
    IgQU128 low_product = ig_q_u128_mul64(small_power, multiplier.low);
    IgQU128 high_product = ig_q_u128_mul64(small_power, multiplier.high);
    uint delta = uint(ig_q_pow5_bits(int(exponent))
        - ig_q_pow5_bits(int(base_exponent)));
    IgQU128 sum = ig_q_u128_add(
        ig_q_u128_shift_right(low_product, delta),
        ig_q_u128_shift_left(high_product, 64u - delta));
    uint correction = (IG_Q_POW5_OFFSETS[exponent / 16u]
        >> ((exponent % 16u) * 2u)) & 3u;
    return ig_q_u128_add_u64(sum, ulong(correction));
}

inline IgQU128 ig_q_compute_inv_pow5(uint exponent) {
    uint base = (exponent + 25u) / 26u;
    uint base_exponent = base * 26u;
    uint offset = base_exponent - exponent;
    IgQU128 multiplier = IG_Q_DOUBLE_POW5_INV_SPLIT2[base];
    if (offset == 0u) return multiplier;
    ulong small_power = IG_Q_DOUBLE_POW5_TABLE[offset];
    IgQU128 low_product = ig_q_u128_mul64(small_power, multiplier.low - 1ul);
    IgQU128 high_product = ig_q_u128_mul64(small_power, multiplier.high);
    uint delta = uint(ig_q_pow5_bits(int(base_exponent))
        - ig_q_pow5_bits(int(exponent)));
    IgQU128 sum = ig_q_u128_add(
        ig_q_u128_shift_right(low_product, delta),
        ig_q_u128_shift_left(high_product, 64u - delta));
    uint correction = (IG_Q_POW5_INV_OFFSETS[exponent / 16u]
        >> ((exponent % 16u) * 2u)) & 3u;
    return ig_q_u128_add_u64(sum, 1ul + ulong(correction));
}

inline ulong ig_q_mul_shift_64(ulong value, IgQU128 multiplier, uint shift) {
    IgQU128 low_product = ig_q_u128_mul64(value, multiplier.low);
    IgQU128 high_product = ig_q_u128_mul64(value, multiplier.high);
    IgQU128 sum = ig_q_u128_add_u64(high_product, low_product.high);
    return ig_q_u128_shift_right(sum, shift - 64u).low;
}

inline ulong ig_q_mul_shift_all_64(
    ulong value,
    IgQU128 multiplier,
    uint shift,
    uint lower_shift,
    thread ulong& upper,
    thread ulong& lower) {
    upper = ig_q_mul_shift_64(4ul * value + 2ul, multiplier, shift);
    lower = ig_q_mul_shift_64(4ul * value - 1ul - ulong(lower_shift), multiplier, shift);
    return ig_q_mul_shift_64(4ul * value, multiplier, shift);
}

inline bool ig_q_multiple_of_power_of_5(ulong value, uint power) {
    for (uint index = 0u; index < power; ++index) {
        if (value % 5ul != 0ul) return false;
        value /= 5ul;
    }
    return true;
}

inline bool ig_q_multiple_of_power_of_2(ulong value, uint power) {
    return power == 0u || (value & ((1ul << power) - 1ul)) == 0ul;
}

inline bool ig_q_binary64_shortest(
    ulong bits,
    thread ulong& output,
    thread int& output_exponent) {
    ulong ieee_mantissa = bits & 0x000ffffffffffffful;
    uint ieee_exponent = uint((bits >> 52u) & 0x7fful);
    if (ieee_exponent == 0x7ffu || (ieee_exponent == 0u && ieee_mantissa == 0ul)) {
        return false;
    }
    int binary_exponent;
    ulong binary_mantissa;
    if (ieee_exponent == 0u) {
        binary_exponent = 1 - 1023 - 52 - 2;
        binary_mantissa = ieee_mantissa;
    } else {
        binary_exponent = int(ieee_exponent) - 1023 - 52 - 2;
        binary_mantissa = (1ul << 52u) | ieee_mantissa;
    }
    bool accept_bounds = (binary_mantissa & 1ul) == 0ul;
    ulong middle = 4ul * binary_mantissa;
    uint lower_shift = ieee_mantissa != 0ul || ieee_exponent <= 1u ? 1u : 0u;
    ulong rounded;
    ulong upper;
    ulong lower;
    int decimal_exponent;
    bool lower_trailing_zeros = false;
    bool rounded_trailing_zeros = false;

    if (binary_exponent >= 0) {
        uint q = ig_q_log10_pow2(binary_exponent)
            - (binary_exponent > 3 ? 1u : 0u);
        decimal_exponent = int(q);
        int k = 125 + ig_q_pow5_bits(int(q)) - 1;
        uint shift = uint(-binary_exponent + int(q) + k);
        rounded = ig_q_mul_shift_all_64(
            binary_mantissa, ig_q_compute_inv_pow5(q), shift,
            lower_shift, upper, lower);
        if (q <= 21u) {
            uint middle_mod5 = uint(middle) - 5u * uint(middle / 5ul);
            if (middle_mod5 == 0u) {
                rounded_trailing_zeros = ig_q_multiple_of_power_of_5(middle, q);
            } else if (accept_bounds) {
                lower_trailing_zeros = ig_q_multiple_of_power_of_5(
                    middle - 1ul - ulong(lower_shift), q);
            } else if (ig_q_multiple_of_power_of_5(middle + 2ul, q)) {
                upper -= 1ul;
            }
        }
    } else {
        uint q = ig_q_log10_pow5(-binary_exponent)
            - (-binary_exponent > 1 ? 1u : 0u);
        decimal_exponent = int(q) + binary_exponent;
        int power = -binary_exponent - int(q);
        int k = ig_q_pow5_bits(power) - 125;
        uint shift = uint(int(q) - k);
        rounded = ig_q_mul_shift_all_64(
            binary_mantissa, ig_q_compute_pow5(uint(power)), shift,
            lower_shift, upper, lower);
        if (q <= 1u) {
            rounded_trailing_zeros = true;
            if (accept_bounds) {
                lower_trailing_zeros = lower_shift == 1u;
            } else {
                upper -= 1ul;
            }
        } else if (q < 63u) {
            rounded_trailing_zeros = ig_q_multiple_of_power_of_2(middle, q);
        }
    }

    int removed = 0;
    uint last_removed_digit = 0u;
    if (lower_trailing_zeros || rounded_trailing_zeros) {
        while (true) {
            ulong upper_div10 = upper / 10ul;
            ulong lower_div10 = lower / 10ul;
            if (upper_div10 <= lower_div10) break;
            uint lower_mod10 = uint(lower - 10ul * lower_div10);
            ulong rounded_div10 = rounded / 10ul;
            uint rounded_mod10 = uint(rounded - 10ul * rounded_div10);
            lower_trailing_zeros = lower_trailing_zeros && lower_mod10 == 0u;
            rounded_trailing_zeros = rounded_trailing_zeros && last_removed_digit == 0u;
            last_removed_digit = rounded_mod10;
            rounded = rounded_div10;
            upper = upper_div10;
            lower = lower_div10;
            ++removed;
        }
        if (lower_trailing_zeros) {
            while (true) {
                ulong lower_div10 = lower / 10ul;
                uint lower_mod10 = uint(lower - 10ul * lower_div10);
                if (lower_mod10 != 0u) break;
                ulong upper_div10 = upper / 10ul;
                ulong rounded_div10 = rounded / 10ul;
                uint rounded_mod10 = uint(rounded - 10ul * rounded_div10);
                rounded_trailing_zeros = rounded_trailing_zeros
                    && last_removed_digit == 0u;
                last_removed_digit = rounded_mod10;
                rounded = rounded_div10;
                upper = upper_div10;
                lower = lower_div10;
                ++removed;
            }
        }
        // Rust's pinned Display formatter uses Grisu/Dragon and chooses the greatest shortest
        // representation when the exact value is midway between two same-width decimals.  Ryū's
        // reference core rounds that one ambiguity to an even last digit instead; retaining 5 here
        // selects Rust's upper representation (for example `...991.3`, not `...991.2`).
        output = rounded + ((rounded == lower
            && (!accept_bounds || !lower_trailing_zeros))
            || last_removed_digit >= 5u ? 1ul : 0ul);
    } else {
        bool round_up = false;
        ulong upper_div100 = upper / 100ul;
        ulong lower_div100 = lower / 100ul;
        if (upper_div100 > lower_div100) {
            ulong rounded_div100 = rounded / 100ul;
            uint rounded_mod100 = uint(rounded - 100ul * rounded_div100);
            round_up = rounded_mod100 >= 50u;
            rounded = rounded_div100;
            upper = upper_div100;
            lower = lower_div100;
            removed += 2;
        }
        while (true) {
            ulong upper_div10 = upper / 10ul;
            ulong lower_div10 = lower / 10ul;
            if (upper_div10 <= lower_div10) break;
            ulong rounded_div10 = rounded / 10ul;
            uint rounded_mod10 = uint(rounded - 10ul * rounded_div10);
            round_up = rounded_mod10 >= 5u;
            rounded = rounded_div10;
            upper = upper_div10;
            lower = lower_div10;
            ++removed;
        }
        output = rounded + (rounded == lower || round_up ? 1ul : 0ul);
    }
    output_exponent = decimal_exponent + removed;
    return true;
}

inline uint ig_q_decimal_length17(ulong value) {
    uint length = 1u;
    while (value >= 10ul) {
        value /= 10ul;
        ++length;
    }
    return length;
}

inline uint ig_q_render_f64(ulong bits, thread uchar* rendered) {
    bool negative = (bits >> 63u) != 0ul;
    ulong magnitude_bits = bits & 0x7ffffffffffffffful;
    uint ieee_exponent = uint((magnitude_bits >> 52u) & 0x7fful);
    ulong ieee_mantissa = magnitude_bits & 0x000ffffffffffffful;
    if (ieee_exponent == 0x7ffu) {
        if (ieee_mantissa != 0ul) {
            rendered[0] = uchar('N');
            rendered[1] = uchar('a');
            rendered[2] = uchar('N');
            return 3u;
        }
        uint cursor = 0u;
        if (negative) rendered[cursor++] = uchar('-');
        rendered[cursor++] = uchar('i');
        rendered[cursor++] = uchar('n');
        rendered[cursor++] = uchar('f');
        return cursor;
    }
    if (magnitude_bits == 0ul) {
        uint cursor = 0u;
        if (negative) rendered[cursor++] = uchar('-');
        rendered[cursor++] = uchar('0');
        return cursor;
    }

    ulong mantissa = 0ul;
    int exponent = 0;
    if (!ig_q_binary64_shortest(magnitude_bits, mantissa, exponent)) return 0u;
    uint digit_count = ig_q_decimal_length17(mantissa);
    thread uchar digits[17];
    ulong remaining = mantissa;
    for (uint index = digit_count; index > 0u; --index) {
        digits[index - 1u] = uchar('0') + uchar(remaining % 10ul);
        remaining /= 10ul;
    }
    int decimal_point = int(digit_count) + exponent;
    uint cursor = 0u;
    if (negative) rendered[cursor++] = uchar('-');
    if (decimal_point <= 0) {
        rendered[cursor++] = uchar('0');
        rendered[cursor++] = uchar('.');
        for (int zero = 0; zero < -decimal_point; ++zero) rendered[cursor++] = uchar('0');
        for (uint index = 0u; index < digit_count; ++index) rendered[cursor++] = digits[index];
    } else if (decimal_point < int(digit_count)) {
        for (uint index = 0u; index < uint(decimal_point); ++index) {
            rendered[cursor++] = digits[index];
        }
        rendered[cursor++] = uchar('.');
        for (uint index = uint(decimal_point); index < digit_count; ++index) {
            rendered[cursor++] = digits[index];
        }
    } else {
        for (uint index = 0u; index < digit_count; ++index) rendered[cursor++] = digits[index];
        for (int zero = int(digit_count); zero < decimal_point; ++zero) {
            rendered[cursor++] = uchar('0');
        }
    }
    return cursor;
}

inline ulong ig_q_string_result(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong byte_base,
    ulong count);

[[clang::noinline]] ulong ig_q_to_string(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    device const ulong* value) {
    if (value[0] == IG_Q_TAG_NULL || value[0] == IG_Q_TAG_STRING) {
        return IG_Q_INVALID;
    }
    thread uchar rendered[327];
    uint length = 0u;
    if (value[0] == IG_Q_TAG_BOOLEAN) {
        if (value[1] > 1ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return IG_Q_INVALID;
        }
        if (value[1] == 0ul) {
            rendered[0] = uchar('f'); rendered[1] = uchar('a');
            rendered[2] = uchar('l'); rendered[3] = uchar('s');
            rendered[4] = uchar('e'); length = 5u;
        } else {
            rendered[0] = uchar('t'); rendered[1] = uchar('r');
            rendered[2] = uchar('u'); rendered[3] = uchar('e'); length = 4u;
        }
    } else if (value[0] == IG_Q_TAG_INTEGER) {
        bool negative = (value[1] >> 63u) != 0ul;
        ulong magnitude = negative ? (0ul - value[1]) : value[1];
        thread uchar reversed[20];
        do {
            reversed[length++] = uchar('0') + uchar(magnitude % 10ul);
            magnitude /= 10ul;
        } while (magnitude != 0ul && length < 20u);
        if (magnitude != 0ul || (negative && length == 20u)) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return IG_Q_INVALID;
        }
        uint digits = length;
        length = 0u;
        if (negative) rendered[length++] = uchar('-');
        while (digits != 0u) rendered[length++] = reversed[--digits];
    } else if (value[0] == IG_Q_TAG_FLOAT) {
        length = ig_q_render_f64(value[1], rendered);
        if (length == 0u || length > 327u) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return IG_Q_INVALID;
        }
    } else {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return IG_Q_INVALID;
    }
    ulong byte_base = ig_q_lane_alloc_bytes(scratch, args, allocator, ulong(length));
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
    for (uint index = 0u; index < length; ++index) {
        ig_q_store_packed_byte(scratch, args.dynamic_byte_base,
            byte_base + ulong(index), rendered[index]);
    }
    return ig_q_string_result(scratch, args, allocator, byte_base, ulong(length));
}

// Cypher scalar equality. Structural list/map equality is deliberately rejected by admission for
// this first graph-free tranche; the 64 exact programs compare scalar predicate results only.
[[clang::noinline]] long ig_q_equal_scalar(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong left_handle,
    ulong right_handle,
    bool strict) {
    device const ulong* left = ig_q_cell(program, scratch, args, left_handle);
    device const ulong* right = ig_q_cell(program, scratch, args, right_handle);
    if (strict) {
        if (left[0] != right[0]) return 0L;
        if (left[0] == IG_Q_TAG_NULL) return 1L;
    } else if (left[0] == IG_Q_TAG_NULL || right[0] == IG_Q_TAG_NULL) {
        return -1L;
    }
    if (left[0] == IG_Q_TAG_LIST || left[0] == IG_Q_TAG_MAP
            || right[0] == IG_Q_TAG_LIST || right[0] == IG_Q_TAG_MAP) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return -1L;
    }
    if (!strict && left[0] == IG_Q_TAG_INTEGER && right[0] == IG_Q_TAG_FLOAT) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return -1L;
    }
    if (!strict && left[0] == IG_Q_TAG_FLOAT && right[0] == IG_Q_TAG_INTEGER) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return -1L;
    }
    if (left[0] != right[0]) return 0L;
    switch (left[0]) {
        case IG_Q_TAG_NULL: return strict ? 1L : -1L;
        case IG_Q_TAG_BOOLEAN:
        case IG_Q_TAG_INTEGER: return left[1] == right[1] ? 1L : 0L;
        case IG_Q_TAG_FLOAT:
            if (strict) return left[1] == right[1] ? 1L : 0L;
            if (ig_q_float_nan(left[1]) || ig_q_float_nan(right[1])) return 0L;
            return ig_q_float_compare(left[1], right[1]) == 0 ? 1L : 0L;
        case IG_Q_TAG_STRING:
            return ig_q_string_equal(program, scratch, args, left, right) ? 1L : 0L;
        default:
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return -1L;
    }
}

[[clang::noinline]] int ig_q_compare_scalar(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong left_handle,
    ulong right_handle) {
    if (!ig_q_handle_valid(args, left_handle)
            || !ig_q_handle_valid(args, right_handle)) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return 0;
    }
    device const ulong* left = ig_q_cell(program, scratch, args, left_handle);
    device const ulong* right = ig_q_cell(program, scratch, args, right_handle);
    if (left[0] != right[0]) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return 0;
    }
    if (left[0] == IG_Q_TAG_LIST) {
        ulong left_capacity = left[3] == 0ul
            ? args.immutable_item_count : args.dynamic_item_capacity;
        ulong right_capacity = right[3] == 0ul
            ? args.immutable_item_count : args.dynamic_item_capacity;
        if (left[3] > 1ul || right[3] > 1ul
                || left[2] > args.max_list_items || right[2] > args.max_list_items
                || left[2] > left_capacity || left[1] > left_capacity - left[2]
                || right[2] > right_capacity || right[1] > right_capacity - right[2]) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return 0;
        }
        ulong width = min(left[2], right[2]);
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < width; ++index) {
            ulong left_item = ig_q_item(program, scratch, args, left, index);
            ulong right_item = ig_q_item(program, scratch, args, right, index);
            if (!ig_q_handle_valid(args, left_item)
                    || !ig_q_handle_valid(args, right_item)) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                return 0;
            }
            device const ulong* left_value = ig_q_cell(
                program, scratch, args, left_item);
            device const ulong* right_value = ig_q_cell(
                program, scratch, args, right_item);
            if (left_value[0] != IG_Q_TAG_INTEGER
                    || right_value[0] != IG_Q_TAG_INTEGER
                    || left_value[2] != 0ul || right_value[2] != 0ul
                    || left_value[3] > 1ul || right_value[3] > 1ul) {
                // This route intentionally excludes NULL, mixed, temporal, and deeper list
                // values.  A malformed program cannot turn any of them into an order key.
                ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
                return 0;
            }
            long l = as_type<long>(left_value[1]);
            long r = as_type<long>(right_value[1]);
            if (l < r) return -1;
            if (l > r) return 1;
        }
        return left[2] < right[2] ? -1 : (left[2] > right[2] ? 1 : 0);
    }
    if (left[0] == IG_Q_TAG_INTEGER) {
        long l = as_type<long>(left[1]);
        long r = as_type<long>(right[1]);
        return l < r ? -1 : (l > r ? 1 : 0);
    }
    if (left[0] == IG_Q_TAG_FLOAT) return ig_q_float_compare(left[1], right[1]);
    if (left[0] == IG_Q_TAG_BOOLEAN) {
        return left[1] < right[1] ? -1 : (left[1] > right[1] ? 1 : 0);
    }
    if (left[0] == IG_Q_TAG_STRING) {
        ulong width = min(left[2], right[2]);
        for (ulong index = 0ul; index < width; ++index) {
            uchar l = ig_q_byte(program, scratch, args, left, index);
            uchar r = ig_q_byte(program, scratch, args, right, index);
            if (l < r) return -1;
            if (l > r) return 1;
        }
        return left[2] < right[2] ? -1 : (left[2] > right[2] ? 1 : 0);
    }
    ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
    return 0;
}

inline ulong ig_q_child(
    device const ulong* program,
    constant MetalQuantifierArgs& args,
    device const ulong* node,
    ulong index) {
    return program[args.child_base + node[4] + index];
}

inline void ig_q_init_frame(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    ulong depth,
    ulong node,
    ulong context) {
    ulong base = frame_root + depth * IG_Q_FRAME_WORDS;
    for (ulong word = 0ul; word < IG_Q_FRAME_WORDS; ++word) scratch[base + word] = 0ul;
    scratch[base] = node;
    scratch[base + 7ul] = IG_Q_INVALID;
    scratch[base + 8ul] = context;
}

inline bool ig_q_push(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread ulong& depth,
    ulong node,
    ulong context) {
    if (depth >= args.frame_capacity) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return false;
    }
    ig_q_init_frame(scratch, args, frame_root, depth, node, context);
    depth += 1ul;
    return true;
}

inline void ig_q_return(thread ulong& depth, thread ulong& last, ulong value) {
    last = value;
    depth -= 1ul;
}

inline ulong ig_q_row_slot(
    device const ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong row_base,
    ulong row,
    ulong slot) {
    return scratch[row_base + row * args.slot_count + slot];
}

inline void ig_q_set_row_slot(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong row_base,
    ulong row,
    ulong slot,
    ulong value) {
    scratch[row_base + row * args.slot_count + slot] = value;
}

inline ulong ig_q_list_result(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong item_base,
    ulong count) {
    return ig_q_lane_alloc_cell(
        scratch, args, allocator, IG_Q_TAG_LIST, item_base, count, 1ul);
}

inline ulong ig_q_string_result(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong byte_base,
    ulong count) {
    return ig_q_lane_alloc_cell(
        scratch, args, allocator, IG_Q_TAG_STRING, byte_base, count, 1ul);
}

[[clang::noinline]] ulong ig_q_reverse_string(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    device const ulong* source) {
    ulong output_base = ig_q_lane_alloc_bytes(scratch, args, allocator, source[2]);
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
    ulong output = 0ul;
    ulong end = source[2];
    #pragma clang loop unroll(disable)
    while (end != 0ul) {
        ulong start = end - 1ul;
        #pragma clang loop unroll(disable)
        while (start != 0ul
                && (ig_q_byte(program, scratch, args, source, start) & 0xc0u) == 0x80u) {
            start -= 1ul;
        }
        #pragma clang loop unroll(disable)
        for (ulong index = start; index < end; ++index) {
            ig_q_store_packed_byte(
                scratch, args.dynamic_byte_base, output_base + output,
                ig_q_byte(program, scratch, args, source, index));
            output += 1ul;
        }
        end = start;
    }
    return ig_q_string_result(scratch, args, allocator, output_base, source[2]);
}

inline bool ig_q_string_range_valid(
    constant MetalQuantifierArgs& args,
    device const ulong* value) {
    if (value[3] > 1ul) return false;
    ulong capacity = value[3] == 0ul
        ? args.immutable_byte_count : args.dynamic_byte_capacity;
    return value[1] <= capacity && value[2] <= capacity - value[1];
}

inline bool ig_q_split_match_at(
    device const ulong* program,
    device const ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* source,
    device const ulong* separator,
    ulong position) {
    if (position > source[2] || separator[2] > source[2] - position) return false;
    #pragma clang loop unroll(disable)
    for (ulong index = 0ul; index < separator[2]; ++index) {
        if (ig_q_byte(program, scratch, args, source, position + index)
                != ig_q_byte(program, scratch, args, separator, index)) return false;
    }
    return true;
}

inline ulong ig_q_split_substring(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    device const ulong* source,
    ulong start,
    ulong length) {
    return ig_q_lane_alloc_cell(
        scratch, args, allocator, IG_Q_TAG_STRING,
        source[1] + start, length, source[3]);
}

// Cypher substring indexes Unicode scalar values, while resident strings retain UTF-8 bytes.
// Scan only code-point boundaries and publish a new cell that references the source arena; no
// payload bytes are copied. The caller has already established STRING/INTEGER runtime tags.
inline ulong ig_q_substring_string(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    device const ulong* source,
    device const ulong* start,
    device const ulong* length,
    bool has_length) {
    if (!ig_q_string_range_valid(args, source)) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return IG_Q_INVALID;
    }
    long signed_start = as_type<long>(start[1]);
    long signed_length = has_length ? as_type<long>(length[1]) : 0L;
    if (signed_start < 0L || (has_length && signed_length < 0L)) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return IG_Q_INVALID;
    }

    ulong byte_start = 0ul;
    ulong skipped = 0ul;
    ulong requested_start = ulong(signed_start);
    while (byte_start < source[2] && skipped < requested_start) {
        byte_start += 1ul;
        while (byte_start < source[2]
                && (ig_q_byte(program, scratch, args, source, byte_start) & 0xc0u) == 0x80u) {
            byte_start += 1ul;
        }
        skipped += 1ul;
    }

    ulong byte_end = source[2];
    if (has_length) {
        byte_end = byte_start;
        ulong selected = 0ul;
        ulong requested_length = ulong(signed_length);
        while (byte_end < source[2] && selected < requested_length) {
            byte_end += 1ul;
            while (byte_end < source[2]
                    && (ig_q_byte(program, scratch, args, source, byte_end) & 0xc0u) == 0x80u) {
                byte_end += 1ul;
            }
            selected += 1ul;
        }
    }
    return ig_q_split_substring(
        scratch, args, allocator, source, byte_start, byte_end - byte_start);
}

// Rust/Cypher split semantics over valid UTF-8. Non-empty separators are matched as ordered,
// non-overlapping byte strings. The empty separator emits both boundary empties and one item per
// Unicode scalar; continuation-byte scanning preserves exact UTF-8 slices without copying bytes.
[[clang::noinline]] ulong ig_q_split_string(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    device const ulong* source,
    device const ulong* separator) {
    if (!ig_q_string_range_valid(args, source)
            || !ig_q_string_range_valid(args, separator)) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return IG_Q_INVALID;
    }
    ulong count = 0ul;
    if (separator[2] == 0ul) {
        count = 2ul;
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < source[2]; ++index) {
            if ((ig_q_byte(program, scratch, args, source, index) & 0xc0u) != 0x80u) {
                if (count == args.max_list_items) {
                    ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
                    return IG_Q_INVALID;
                }
                count += 1ul;
            }
        }
    } else {
        count = 1ul;
        ulong search = 0ul;
        while (search <= source[2] && separator[2] <= source[2] - search) {
            if (ig_q_split_match_at(
                    program, scratch, args, source, separator, search)) {
                if (count == args.max_list_items) {
                    ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
                    return IG_Q_INVALID;
                }
                count += 1ul;
                search += separator[2];
            } else {
                search += 1ul;
            }
        }
    }
    if (count > args.max_list_items) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return IG_Q_INVALID;
    }
    ulong item_base = ig_q_lane_alloc_items(scratch, args, allocator, count);
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
    ulong item = 0ul;
    if (separator[2] == 0ul) {
        ulong empty = ig_q_split_substring(scratch, args, allocator, source, 0ul, 0ul);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
        scratch[args.dynamic_item_base + item_base + item++] = empty;
        ulong start = 0ul;
        while (start < source[2]) {
            ulong end = start + 1ul;
            while (end < source[2]
                    && (ig_q_byte(program, scratch, args, source, end) & 0xc0u) == 0x80u) {
                end += 1ul;
            }
            ulong value = ig_q_split_substring(
                scratch, args, allocator, source, start, end - start);
            if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
            scratch[args.dynamic_item_base + item_base + item++] = value;
            start = end;
        }
        empty = ig_q_split_substring(
            scratch, args, allocator, source, source[2], 0ul);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
        scratch[args.dynamic_item_base + item_base + item++] = empty;
    } else {
        ulong segment = 0ul;
        ulong search = 0ul;
        while (search <= source[2] && separator[2] <= source[2] - search) {
            if (ig_q_split_match_at(
                    program, scratch, args, source, separator, search)) {
                ulong value = ig_q_split_substring(
                    scratch, args, allocator, source, segment, search - segment);
                if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
                scratch[args.dynamic_item_base + item_base + item++] = value;
                search += separator[2];
                segment = search;
            } else {
                search += 1ul;
            }
        }
        ulong value = ig_q_split_substring(
            scratch, args, allocator, source, segment, source[2] - segment);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
        scratch[args.dynamic_item_base + item_base + item++] = value;
    }
    if (item != count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return IG_Q_INVALID;
    }
    return ig_q_list_result(scratch, args, allocator, item_base, count);
}

[[clang::noinline]] ulong ig_q_apply_binary(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong operation,
    ulong left_handle,
    ulong right_handle) {
    if (!ig_q_handle_valid(args, left_handle)
            || !ig_q_handle_valid(args, right_handle)) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return IG_Q_INVALID;
    }
    device const ulong* left = ig_q_cell(program, scratch, args, left_handle);
    device const ulong* right = ig_q_cell(program, scratch, args, right_handle);
    if (operation == 1ul || operation == 2ul || operation == 3ul) {
        long l = ig_q_truth(program, scratch, args, left_handle);
        // Cypher AND/OR are not ordinary null-propagating binary operators.  A decisive
        // left operand short-circuits, while NULL must still inspect the right operand because
        // `null AND false` is false and `null OR true` is true.  Keep this before the generic
        // NULL rule below so operand order cannot change the three-valued result.
        if ((operation == 3ul && l == 0L) || (operation == 1ul && l == 1L)) {
            return IG_Q_IMMUTABLE | ulong(l != 0L ? 2ul : 1ul);
        }
        long r = ig_q_truth(program, scratch, args, right_handle);
        if (operation == 2ul) {
            return (l < 0L || r < 0L) ? IG_Q_IMMUTABLE
                : (IG_Q_IMMUTABLE | ulong((l != r) ? 2ul : 1ul));
        }
        long result = operation == 3ul
            ? ((l == 0L || r == 0L) ? 0L : ((l == 1L && r == 1L) ? 1L : -1L))
            : ((l == 1L || r == 1L) ? 1L : ((l == 0L && r == 0L) ? 0L : -1L));
        return result < 0L ? IG_Q_IMMUTABLE
            : (IG_Q_IMMUTABLE | ulong(result != 0L ? 2ul : 1ul));
    }
    if (left[0] == IG_Q_TAG_NULL || right[0] == IG_Q_TAG_NULL) {
        return IG_Q_IMMUTABLE;
    }
    if (operation == 4ul || operation == 5ul) {
        long equal = ig_q_equal_scalar(program, scratch, args, left_handle, right_handle, false);
        if (equal < 0L) return IG_Q_IMMUTABLE;
        bool value = operation == 4ul ? equal != 0L : equal == 0L;
        return IG_Q_IMMUTABLE | (value ? 2ul : 1ul);
    }
    if (operation >= 6ul && operation <= 9ul) {
        int order = ig_q_compare_scalar(program, scratch, args, left_handle, right_handle);
        bool value = operation == 6ul ? order < 0
            : (operation == 7ul ? order <= 0
                : (operation == 8ul ? order > 0 : order >= 0));
        return IG_Q_IMMUTABLE | (value ? 2ul : 1ul);
    }
    if (operation >= 15ul && operation <= 17ul) {
        if (left[0] != IG_Q_TAG_STRING || right[0] != IG_Q_TAG_STRING) {
            return IG_Q_IMMUTABLE;
        }
        bool value = ig_q_string_predicate(
            program, scratch, args, left, right, operation);
        return IG_Q_IMMUTABLE | (value ? 2ul : 1ul);
    }
    if (operation == 10ul && (left[0] == IG_Q_TAG_LIST || right[0] == IG_Q_TAG_LIST)) {
        ulong left_count = left[0] == IG_Q_TAG_LIST ? left[2] : 1ul;
        ulong right_count = right[0] == IG_Q_TAG_LIST ? right[2] : 1ul;
        if (left_count > args.max_list_items
                || right_count > args.max_list_items
                || left_count > args.max_list_items - right_count) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
            return IG_Q_INVALID;
        }
        ulong base = ig_q_lane_alloc_items(
            scratch, args, allocator, left_count + right_count);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < left_count; ++index) {
            scratch[args.dynamic_item_base + base + index] = left[0] == IG_Q_TAG_LIST
                ? ig_q_item(program, scratch, args, left, index) : left_handle;
        }
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < right_count; ++index) {
            scratch[args.dynamic_item_base + base + left_count + index]
                = right[0] == IG_Q_TAG_LIST
                    ? ig_q_item(program, scratch, args, right, index) : right_handle;
        }
        return ig_q_list_result(
            scratch, args, allocator, base, left_count + right_count);
    }
    if (operation == 10ul && left[0] == IG_Q_TAG_STRING && right[0] == IG_Q_TAG_STRING) {
        ulong length = left[2] + right[2];
        if (length < left[2]) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
            return IG_Q_INVALID;
        }
        ulong base = ig_q_lane_alloc_bytes(scratch, args, allocator, length);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return IG_Q_INVALID;
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < left[2]; ++index) {
            ig_q_store_packed_byte(scratch, args.dynamic_byte_base, base + index,
                ig_q_byte(program, scratch, args, left, index));
        }
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < right[2]; ++index) {
            ig_q_store_packed_byte(scratch, args.dynamic_byte_base, base + left[2] + index,
                ig_q_byte(program, scratch, args, right, index));
        }
        return ig_q_string_result(scratch, args, allocator, base, length);
    }
    bool left_numeric = left[0] == IG_Q_TAG_INTEGER || left[0] == IG_Q_TAG_FLOAT;
    bool right_numeric = right[0] == IG_Q_TAG_INTEGER || right[0] == IG_Q_TAG_FLOAT;
    if (!left_numeric || !right_numeric) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return IG_Q_INVALID;
    }
    if (left[0] == IG_Q_TAG_FLOAT || right[0] == IG_Q_TAG_FLOAT) {
        if (operation != 13ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return IG_Q_INVALID;
        }
        ulong l = left[0] == IG_Q_TAG_INTEGER
            ? ig_q_i64_to_f64(left[1]) : left[1];
        ulong r = right[0] == IG_Q_TAG_INTEGER
            ? ig_q_i64_to_f64(right[1]) : right[1];
        ulong value = ig_q_float_divide(l, r);
        return ig_q_lane_alloc_cell(
            scratch, args, allocator, IG_Q_TAG_FLOAT, value, 0ul, 1ul);
    }
    long l = as_type<long>(left[1]);
    long r = as_type<long>(right[1]);
    long value = 0L;
    if (operation == 10ul) {
        if ((r > 0L && l > 9223372036854775807L - r)
                || (r < 0L && l < (-9223372036854775807L - 1L) - r)) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return IG_Q_INVALID;
        }
        value = l + r;
    } else if (operation == 11ul) {
        if ((r > 0L && l < (-9223372036854775807L - 1L) + r)
                || (r < 0L && l > 9223372036854775807L + r)) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return IG_Q_INVALID;
        }
        value = l - r;
    } else if (operation == 12ul) {
        bool overflow = l > 0L
            ? (r > 0L ? l > 9223372036854775807L / r
                : (r < 0L && r < (-9223372036854775807L - 1L) / l))
            : (l < 0L
                ? (r > 0L ? l < (-9223372036854775807L - 1L) / r
                    : (r < 0L && r < 9223372036854775807L / l))
                : false);
        if (overflow) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return IG_Q_INVALID;
        }
        value = l * r;
    } else if (operation == 13ul || operation == 14ul) {
        if (r == 0L) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return IG_Q_INVALID;
        }
        if (l == (-9223372036854775807L - 1L) && r == -1L) {
            if (operation == 14ul) value = 0L;
            else {
                ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
                return IG_Q_INVALID;
            }
        } else {
            value = operation == 13ul ? l / r : l % r;
        }
    } else {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return IG_Q_INVALID;
    }
    return ig_q_lane_alloc_cell(
        scratch, args, allocator,
        IG_Q_TAG_INTEGER, as_type<ulong>(value), 0ul, 1ul);
}

[[clang::noinline]] void ig_q_eval_leaf_property(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread IgQAllocator& allocator,
    device const ulong* node,
    device ulong* frame,
    ulong node_index,
    ulong opcode,
    ulong state,
    ulong child_count,
    ulong row_base,
    ulong row,
    thread ulong& depth,
    thread ulong& last) {
    if (opcode == 1ul) {
        if (node[1] >= args.slot_count) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        ulong value = ig_q_row_slot(scratch, args, row_base, row, node[1]);
        if (value == IG_Q_INVALID) ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        else ig_q_return(depth, last, value);
        return;
    }
    if (opcode == 2ul) {
        ulong index = node[1] & ~IG_Q_IMMUTABLE;
        if ((node[1] & IG_Q_IMMUTABLE) == 0ul || index >= args.immutable_cell_count) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        } else {
            ig_q_return(depth, last, node[1]);
        }
        return;
    }
    if (opcode != 3ul || child_count != 1ul) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (state == 0ul) {
        frame[1] = 1ul;
        ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
            ig_q_context(frame[8], node_index, 0ul));
        return;
    }
    device const ulong* source = ig_q_cell(program, scratch, args, last);
    if (source[0] == IG_Q_TAG_NULL) {
        ig_q_return(depth, last, IG_Q_IMMUTABLE);
        return;
    }
    if (source[0] != IG_Q_TAG_MAP) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return;
    }
    device const ulong* key = ig_q_cell(program, scratch, args, node[1]);
    if (key[0] != IG_Q_TAG_STRING) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong value = IG_Q_IMMUTABLE;
    #pragma clang loop unroll(disable)
    for (ulong entry = 0ul; entry < source[2]; ++entry) {
        ulong candidate_handle = ig_q_item(program, scratch, args, source, entry * 2ul);
        device const ulong* candidate = ig_q_cell(program, scratch, args, candidate_handle);
        if (candidate[0] != IG_Q_TAG_STRING) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            break;
        }
        if (ig_q_string_equal(program, scratch, args, key, candidate)) {
            value = ig_q_item(program, scratch, args, source, entry * 2ul + 1ul);
            break;
        }
    }
    if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) ig_q_return(depth, last, value);
}

[[clang::noinline]] void ig_q_eval_list_map(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread IgQAllocator& allocator,
    device const ulong* node,
    device ulong* frame,
    ulong node_index,
    ulong opcode,
    ulong state,
    ulong child_count,
    thread ulong& depth,
    thread ulong& last) {
    ulong width = opcode == 4ul ? 1ul : 2ul;
    if ((opcode != 4ul && opcode != 5ul)
            || (opcode == 5ul && (child_count & 1ul) != 0ul)) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong count = child_count / width;
    if (state == 0ul) {
        ulong item_base = ig_q_lane_alloc_items(scratch, args, allocator, child_count);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
        frame[3] = item_base;
        frame[2] = 0ul;
        if (count == 0ul) {
            ulong value = ig_q_lane_alloc_cell(scratch, args, allocator,
                opcode == 4ul ? IG_Q_TAG_LIST : IG_Q_TAG_MAP,
                item_base, 0ul, 1ul);
            if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                ig_q_return(depth, last, value);
            }
            return;
        }
        frame[1] = 1ul;
        if (opcode == 5ul) {
            scratch[args.dynamic_item_base + item_base]
                = ig_q_child(program, args, node, 0ul);
        }
        ulong child = ig_q_child(program, args, node, opcode == 4ul ? 0ul : 1ul);
        ig_q_push(scratch, args, frame_root, depth, child,
            ig_q_context(frame[8], node_index, 0ul));
        return;
    }
    ulong cursor = frame[2];
    ulong item_base = frame[3];
    if (opcode == 4ul) {
        scratch[args.dynamic_item_base + item_base + cursor] = last;
    } else {
        scratch[args.dynamic_item_base + item_base + cursor * 2ul + 1ul] = last;
    }
    cursor += 1ul;
    frame[2] = cursor;
    if (cursor < count) {
        if (opcode == 5ul) {
            scratch[args.dynamic_item_base + item_base + cursor * 2ul]
                = ig_q_child(program, args, node, cursor * 2ul);
        }
        ulong child = ig_q_child(program, args, node,
            opcode == 4ul ? cursor : cursor * 2ul + 1ul);
        ig_q_push(scratch, args, frame_root, depth, child,
            ig_q_context(frame[8], node_index, cursor));
    } else {
        ulong value = ig_q_lane_alloc_cell(scratch, args, allocator,
            opcode == 4ul ? IG_Q_TAG_LIST : IG_Q_TAG_MAP,
            item_base, count, 1ul);
        if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
            ig_q_return(depth, last, value);
        }
    }
}

[[clang::noinline]] void ig_q_eval_case(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread IgQAllocator& allocator,
    device const ulong* node,
    device ulong* frame,
    ulong node_index,
    ulong state,
    ulong child_count,
    thread ulong& depth,
    thread ulong& last) {
    ulong operand_count = node[1];
    ulong alternatives = node[2];
    ulong has_default = node[3];
    if (child_count != operand_count + alternatives * 2ul + has_default
            || operand_count > 1ul || has_default > 1ul) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (state == 0ul) {
        frame[2] = 0ul;
        if (operand_count != 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
        } else {
            frame[1] = 2ul;
        }
        return;
    }
    if (state == 1ul) {
        frame[3] = last;
        frame[1] = 2ul;
        return;
    }
    if (state == 2ul) {
        ulong cursor = frame[2];
        if (cursor >= alternatives) {
            if (has_default != 0ul) {
                frame[1] = 5ul;
                ig_q_push(scratch, args, frame_root, depth,
                    ig_q_child(program, args, node, operand_count + alternatives * 2ul),
                    ig_q_context(frame[8], node_index, alternatives * 2ul + 1ul));
            } else {
                ig_q_return(depth, last, IG_Q_IMMUTABLE);
            }
        } else {
            frame[1] = 3ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node, operand_count + cursor * 2ul),
                ig_q_context(frame[8], node_index, cursor * 2ul + 1ul));
        }
        return;
    }
    if (state == 3ul) {
        bool matches = operand_count != 0ul
            ? ig_q_equal_scalar(program, scratch, args, frame[3], last, false) == 1L
            : ig_q_truth(program, scratch, args, last) == 1L;
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
        if (matches) {
            frame[1] = 4ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node,
                    operand_count + frame[2] * 2ul + 1ul),
                ig_q_context(frame[8], node_index, frame[2] * 2ul + 2ul));
        } else {
            frame[2] += 1ul;
            frame[1] = 2ul;
        }
        return;
    }
    if (state == 4ul || state == 5ul) {
        ig_q_return(depth, last, last);
        return;
    }
    ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
}

[[clang::noinline]]
void ig_q_eval_list_comprehension(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread IgQAllocator& allocator,
    device const ulong* node,
    device ulong* frame,
    ulong node_index,
    ulong state,
    ulong child_count,
    ulong row_base,
    ulong row,
    thread ulong& depth,
    thread ulong& last) {
    bool has_predicate = node[2] != 0ul;
    bool has_projection = node[3] != 0ul;
    if (child_count != 1ul + ulong(has_predicate) + ulong(has_projection)
            || node[1] >= args.slot_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (state == 0ul) {
        frame[1] = 1ul;
        ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
            ig_q_context(frame[8], node_index, 0ul));
        return;
    }
    if (state == 1ul) {
        device const ulong* list = ig_q_cell(program, scratch, args, last);
        if (list[0] == IG_Q_TAG_NULL) {
            ig_q_return(depth, last, IG_Q_IMMUTABLE);
            return;
        }
        if (list[0] != IG_Q_TAG_LIST || list[2] > args.max_list_items) {
            ig_q_status(scratch, args,
                list[0] == IG_Q_TAG_LIST ? IG_Q_STATUS_BUDGET : IG_Q_STATUS_TYPE);
            return;
        }
        frame[3] = last;
        frame[4] = ig_q_lane_alloc_items(scratch, args, allocator, list[2]);
        frame[5] = list[2];
        frame[6] = 0ul;
        frame[7] = ig_q_row_slot(scratch, args, row_base, row, node[1]);
        frame[2] = 0ul;
        frame[1] = 2ul;
        return;
    }
    if (state == 2ul) {
        if (frame[2] >= frame[5]) {
            ig_q_set_row_slot(scratch, args, row_base, row, node[1], frame[7]);
            ulong value = ig_q_list_result(scratch, args, allocator, frame[4], frame[6]);
            if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                ig_q_return(depth, last, value);
            }
            return;
        }
        device const ulong* list = ig_q_cell(program, scratch, args, frame[3]);
        ulong element = ig_q_item(program, scratch, args, list, frame[2]);
        ig_q_set_row_slot(scratch, args, row_base, row, node[1], element);
        if (has_predicate) {
            frame[1] = 3ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 1ul),
                ig_q_context(frame[8], node_index, frame[2] + 1ul));
        } else {
            frame[1] = 4ul;
        }
        return;
    }
    if (state == 3ul) {
        long keep = ig_q_truth(program, scratch, args, last);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
        if (keep == 1L) frame[1] = 4ul;
        else {
            frame[2] += 1ul;
            frame[1] = 2ul;
        }
        return;
    }
    if (state == 4ul) {
        if (has_projection) {
            frame[1] = 5ul;
            ulong child = has_predicate ? 2ul : 1ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, child),
                ig_q_context(frame[8], node_index, frame[2] + 0x10001ul));
        } else {
            device const ulong* list = ig_q_cell(program, scratch, args, frame[3]);
            scratch[args.dynamic_item_base + frame[4] + frame[6]]
                = ig_q_item(program, scratch, args, list, frame[2]);
            frame[6] += 1ul;
            frame[2] += 1ul;
            frame[1] = 2ul;
        }
        return;
    }
    if (state == 5ul) {
        scratch[args.dynamic_item_base + frame[4] + frame[6]] = last;
        frame[6] += 1ul;
        frame[2] += 1ul;
        frame[1] = 2ul;
        return;
    }
    ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
}

[[clang::noinline]]
void ig_q_eval_quantifier(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread IgQAllocator& allocator,
    device const ulong* node,
    device ulong* frame,
    ulong node_index,
    ulong state,
    ulong child_count,
    ulong row_base,
    ulong row,
    thread ulong& depth,
    thread ulong& last) {
    if (child_count != 2ul || node[1] < 1ul || node[1] > 4ul
            || node[2] >= args.slot_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (state == 0ul) {
        frame[1] = 1ul;
        ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
            ig_q_context(frame[8], node_index, 0ul));
        return;
    }
    if (state == 1ul) {
        device const ulong* list = ig_q_cell(program, scratch, args, last);
        if (list[0] == IG_Q_TAG_NULL) {
            ig_q_return(depth, last, IG_Q_IMMUTABLE);
            return;
        }
        if (list[0] != IG_Q_TAG_LIST) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return;
        }
        frame[3] = last;
        frame[5] = list[2];
        frame[7] = ig_q_row_slot(scratch, args, row_base, row, node[2]);
        frame[2] = 0ul;
        frame[9] = 0ul;
        frame[10] = 0ul;
        frame[11] = 0ul;
        frame[1] = 2ul;
        return;
    }
    if (state == 2ul) {
        if (frame[2] >= frame[5]) {
            ig_q_set_row_slot(scratch, args, row_base, row, node[2], frame[7]);
            long result = -1L;
            if (node[1] == 1ul) {
                result = frame[10] != 0ul ? 0L : (frame[11] != 0ul ? -1L : 1L);
            } else if (node[1] == 2ul) {
                result = frame[9] != 0ul ? 1L : (frame[11] != 0ul ? -1L : 0L);
            } else if (node[1] == 3ul) {
                result = frame[9] != 0ul ? 0L : (frame[11] != 0ul ? -1L : 1L);
            } else {
                result = frame[9] > 1ul ? 0L
                    : (frame[11] != 0ul ? -1L : (frame[9] == 1ul ? 1L : 0L));
            }
            ig_q_return(depth, last, result < 0L ? IG_Q_IMMUTABLE
                : (IG_Q_IMMUTABLE | ulong(result != 0L ? 2ul : 1ul)));
            return;
        }
        device const ulong* list = ig_q_cell(program, scratch, args, frame[3]);
        ig_q_set_row_slot(scratch, args, row_base, row, node[2],
            ig_q_item(program, scratch, args, list, frame[2]));
        frame[1] = 3ul;
        ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 1ul),
            ig_q_context(frame[8], node_index, frame[2] + 1ul));
        return;
    }
    if (state == 3ul) {
        long truth = ig_q_truth(program, scratch, args, last);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
        if (truth == 1L) frame[9] += 1ul;
        else if (truth == 0L) frame[10] += 1ul;
        else frame[11] = 1ul;
        frame[2] += 1ul;
        frame[1] = 2ul;
        return;
    }
    ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
}

[[clang::noinline]]
void ig_q_eval_function(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread IgQAllocator& allocator,
    device const ulong* node,
    device ulong* frame,
    ulong node_index,
    ulong state,
    ulong child_count,
    ulong row,
    thread ulong& depth,
    thread ulong& last) {
    if (node[1] == 1ul) {
        if (child_count != 0ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        ulong bits = ig_q_random_double_bits(args.random_seed,
            ig_q_context(frame[8], node_index, row));
        ulong value = ig_q_lane_alloc_cell(scratch, args, allocator, IG_Q_TAG_FLOAT, bits, 0ul, 1ul);
        if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) ig_q_return(depth, last, value);
        return;
    }
    if (node[1] == 4ul) {
        if (state == 0ul) {
            frame[2] = 0ul;
            frame[1] = 2ul;
            return;
        }
        if (state == 2ul) {
            if (frame[2] >= child_count) {
                ig_q_return(depth, last, IG_Q_IMMUTABLE);
            } else {
                frame[1] = 3ul;
                ig_q_push(scratch, args, frame_root, depth,
                    ig_q_child(program, args, node, frame[2]),
                    ig_q_context(frame[8], node_index, frame[2]));
            }
            return;
        }
        if (state == 3ul) {
            device const ulong* value = ig_q_cell(program, scratch, args, last);
            if (value[0] != IG_Q_TAG_NULL) ig_q_return(depth, last, last);
            else {
                frame[2] += 1ul;
                frame[1] = 2ul;
            }
            return;
        }
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (node[1] == 5ul) {
        if (child_count != 2ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        if (state == 1ul) {
            frame[3] = last;
            frame[1] = 2ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node, 1ul),
                ig_q_context(frame[8], node_index, 1ul));
            return;
        }
        if (state == 2ul) {
            device const ulong* source = ig_q_cell(program, scratch, args, frame[3]);
            device const ulong* separator = ig_q_cell(program, scratch, args, last);
            if (source[0] == IG_Q_TAG_NULL || separator[0] == IG_Q_TAG_NULL) {
                ig_q_return(depth, last, IG_Q_IMMUTABLE);
                return;
            }
            if (source[0] != IG_Q_TAG_STRING || separator[0] != IG_Q_TAG_STRING) {
                ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
                return;
            }
            ulong result = ig_q_split_string(
                program, scratch, args, allocator, source, separator);
            if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                ig_q_return(depth, last, result);
            }
            return;
        }
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (node[1] == 6ul) {
        if (child_count != 1ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        if (state != 1ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        device const ulong* value = ig_q_cell(program, scratch, args, last);
        if (value[0] == IG_Q_TAG_NULL || value[0] == IG_Q_TAG_STRING) {
            ig_q_return(depth, last, last);
        } else {
            ulong result = ig_q_to_string(program, scratch, args, allocator, value);
            if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                ig_q_return(depth, last, result);
            }
        }
        return;
    }
    if (node[1] == 7ul) {
        if (child_count < 2ul || child_count > 3ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        if (state == 1ul) {
            frame[3] = last;
            frame[1] = 2ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node, 1ul),
                ig_q_context(frame[8], node_index, 1ul));
            return;
        }
        if (state == 2ul) {
            frame[4] = last;
            if (child_count == 3ul) {
                frame[1] = 3ul;
                ig_q_push(scratch, args, frame_root, depth,
                    ig_q_child(program, args, node, 2ul),
                    ig_q_context(frame[8], node_index, 2ul));
                return;
            }
        } else if (state != 3ul || child_count != 3ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }

        device const ulong* source = ig_q_cell(program, scratch, args, frame[3]);
        device const ulong* start = ig_q_cell(program, scratch, args, frame[4]);
        // The helper ignores this pointer when the optional length is absent.
        device const ulong* length = child_count == 3ul
            ? ig_q_cell(program, scratch, args, last) : start;
        if (source[0] == IG_Q_TAG_NULL || start[0] == IG_Q_TAG_NULL
                || (child_count == 3ul && length[0] == IG_Q_TAG_NULL)) {
            ig_q_return(depth, last, IG_Q_IMMUTABLE);
            return;
        }
        if (source[0] != IG_Q_TAG_STRING || start[0] != IG_Q_TAG_INTEGER
                || (child_count == 3ul && length[0] != IG_Q_TAG_INTEGER)) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return;
        }
        ulong result = ig_q_substring_string(
            program, scratch, args, allocator, source, start, length, child_count == 3ul);
        if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
            ig_q_return(depth, last, result);
        }
        return;
    }
    if (node[1] == 9ul && child_count == 1ul) {
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth,
                ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        if (state != 1ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        device const ulong* value = ig_q_cell(program, scratch, args, last);
        if (value[0] == IG_Q_TAG_NULL) {
            ig_q_return(depth, last, IG_Q_IMMUTABLE);
            return;
        }
        if (value[0] != IG_Q_TAG_LIST) {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return;
        }
        ulong count = value[2] == 0ul ? 0ul : value[2] - 1ul;
        ulong base = ig_q_lane_alloc_items(scratch, args, allocator, count);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < count; ++index) {
            scratch[args.dynamic_item_base + base + index]
                = ig_q_item(program, scratch, args, value, index + 1ul);
        }
        ulong result = ig_q_list_result(scratch, args, allocator, base, count);
        if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
            ig_q_return(depth, last, result);
        }
        return;
    }
    if ((node[1] == 2ul || node[1] == 3ul) && child_count == 1ul) {
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        device const ulong* value = ig_q_cell(program, scratch, args, last);
        if (value[0] == IG_Q_TAG_NULL) {
            ig_q_return(depth, last, IG_Q_IMMUTABLE);
            return;
        }
        if (node[1] == 2ul) {
            if (value[0] == IG_Q_TAG_LIST) {
                ulong base = ig_q_lane_alloc_items(scratch, args, allocator, value[2]);
                if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
                #pragma clang loop unroll(disable)
                for (ulong index = 0ul; index < value[2]; ++index) {
                    scratch[args.dynamic_item_base + base + index]
                        = ig_q_item(program, scratch, args, value, value[2] - index - 1ul);
                }
                ulong result = ig_q_list_result(scratch, args, allocator, base, value[2]);
                if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                    ig_q_return(depth, last, result);
                }
            } else if (value[0] == IG_Q_TAG_STRING) {
                ulong result = ig_q_reverse_string(program, scratch, args, allocator, value);
                if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                    ig_q_return(depth, last, result);
                }
            } else {
                ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            }
            return;
        }
        ulong count = 0ul;
        if (value[0] == IG_Q_TAG_LIST || value[0] == IG_Q_TAG_MAP) {
            count = value[2];
        } else if (value[0] == IG_Q_TAG_STRING) {
            #pragma clang loop unroll(disable)
            for (ulong index = 0ul; index < value[2]; ++index) {
                if ((ig_q_byte(program, scratch, args, value, index) & 0xc0u) != 0x80u) {
                    count += 1ul;
                }
            }
        } else {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            return;
        }
        if (count > 0x7ffffffffffffffful) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
            return;
        }
        ulong result = ig_q_lane_alloc_cell(
            scratch, args, allocator, IG_Q_TAG_INTEGER, count, 0ul, 1ul);
        if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) ig_q_return(depth, last, result);
        return;
    }
    ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
}

[[clang::noinline]] void ig_q_eval_unary_binary_null(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong frame_root,
    thread IgQAllocator& allocator,
    device const ulong* node,
    device ulong* frame,
    ulong node_index,
    ulong opcode,
    ulong state,
    ulong child_count,
    thread ulong& depth,
    thread ulong& last) {
    if (opcode == 10ul) {
        if (child_count != 1ul || node[1] < 1ul || node[1] > 3ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        device const ulong* value = ig_q_cell(program, scratch, args, last);
        if (node[1] == 1ul) {
            long truth = ig_q_truth(program, scratch, args, last);
            if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                ig_q_return(depth, last, truth < 0L ? IG_Q_IMMUTABLE
                    : (IG_Q_IMMUTABLE | ulong(truth == 0L ? 2ul : 1ul)));
            }
        } else if (node[1] == 2ul || value[0] == IG_Q_TAG_NULL) {
            ig_q_return(depth, last, last);
        } else if (value[0] == IG_Q_TAG_INTEGER) {
            long integer = as_type<long>(value[1]);
            if (integer == (-9223372036854775807L - 1L)) {
                ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
            } else {
                ulong result = ig_q_lane_alloc_cell(scratch, args, allocator, IG_Q_TAG_INTEGER,
                    as_type<ulong>(-integer), 0ul, 1ul);
                if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                    ig_q_return(depth, last, result);
                }
            }
        } else if (value[0] == IG_Q_TAG_FLOAT) {
            // IEEE-754 unary negation changes only the sign bit. Keeping this operation in the
            // packed domain preserves signed zero, infinities, and the exact NaN payload.
            ulong result = ig_q_lane_alloc_cell(scratch, args, allocator, IG_Q_TAG_FLOAT,
                value[1] ^ 0x8000000000000000ul, 0ul, 1ul);
            if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
                ig_q_return(depth, last, result);
            }
        } else {
            ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        }
        return;
    }
    if (opcode == 11ul) {
        if (child_count != 2ul || node[1] < 1ul || node[1] > 17ul) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        if (state == 1ul) {
            frame[3] = last;
            if (node[1] == 3ul || node[1] == 1ul) {
                long truth = ig_q_truth(program, scratch, args, last);
                if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
                if ((node[1] == 3ul && truth == 0L)
                        || (node[1] == 1ul && truth == 1L)) {
                    ig_q_return(depth, last,
                        IG_Q_IMMUTABLE | (node[1] == 1ul ? 2ul : 1ul));
                    return;
                }
            }
            frame[1] = 2ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 1ul),
                ig_q_context(frame[8], node_index, 1ul));
            return;
        }
        ulong result = ig_q_apply_binary(
            program, scratch, args, allocator, node[1], frame[3], last);
        if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) ig_q_return(depth, last, result);
        return;
    }
    if (opcode == 12ul && child_count == 1ul && node[1] <= 1ul) {
        if (state == 0ul) {
            frame[1] = 1ul;
            ig_q_push(scratch, args, frame_root, depth, ig_q_child(program, args, node, 0ul),
                ig_q_context(frame[8], node_index, 0ul));
            return;
        }
        bool is_null = ig_q_cell(program, scratch, args, last)[0] == IG_Q_TAG_NULL;
        bool value = is_null != (node[1] != 0ul);
        ig_q_return(depth, last, IG_Q_IMMUTABLE | (value ? 2ul : 1ul));
        return;
    }
    ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
}

[[clang::noinline]] ulong ig_q_evaluate_with_allocator(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong root,
    ulong row_base,
    ulong row,
    ulong root_context) {
    if (row >= args.eval_lane_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return IG_Q_INVALID;
    }
    ulong frame_root = args.eval_frame_base
        + row * args.frame_capacity * IG_Q_FRAME_WORDS;
    ulong depth = 0ul;
    ulong last = IG_Q_INVALID;
    if (!ig_q_push(scratch, args, frame_root, depth, root, root_context)) return IG_Q_INVALID;
    #pragma clang loop unroll(disable)
    while (depth != 0ul && ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
        ulong frame_base = frame_root + (depth - 1ul) * IG_Q_FRAME_WORDS;
        device ulong* frame = scratch + frame_base;
        ulong node_index = frame[0];
        if (node_index >= args.expression_count) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            break;
        }
        device const ulong* node = program
            + args.expression_base + node_index * IG_Q_EXPRESSION_WORDS;
        ulong opcode = node[0];
        ulong child_count = node[5];
        if (node[4] > args.child_count || child_count > args.child_count - node[4]) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            break;
        }
        ulong state = frame[1];
        if (opcode >= 1ul && opcode <= 3ul) {
            ig_q_eval_leaf_property(program, scratch, args, frame_root, allocator,
                node, frame, node_index,
                opcode, state, child_count, row_base, row, depth, last);
        } else if (opcode == 4ul || opcode == 5ul) {
            ig_q_eval_list_map(program, scratch, args, frame_root, allocator,
                node, frame, node_index,
                opcode, state, child_count, depth, last);
        } else if (opcode == 6ul) {
            ig_q_eval_case(program, scratch, args, frame_root, allocator,
                node, frame, node_index,
                state, child_count, depth, last);
        } else if (opcode == 7ul) {
            ig_q_eval_list_comprehension(program, scratch, args, frame_root, allocator,
                node, frame, node_index,
                state, child_count, row_base, row, depth, last);
        } else if (opcode == 8ul) {
            ig_q_eval_quantifier(program, scratch, args, frame_root, allocator,
                node, frame, node_index,
                state, child_count, row_base, row, depth, last);
        } else if (opcode == 9ul) {
            ig_q_eval_function(program, scratch, args, frame_root, allocator,
                node, frame, node_index,
                state, child_count, row, depth, last);
        } else if (opcode >= 10ul && opcode <= 12ul) {
            ig_q_eval_unary_binary_null(program, scratch, args, frame_root, allocator,
                node, frame, node_index,
                opcode, state, child_count, depth, last);
        } else {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        }
    }
    return ig_q_status_load(scratch, args) == IG_Q_STATUS_OK ? last : IG_Q_INVALID;
}

[[clang::noinline]] ulong ig_q_evaluate(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong root,
    ulong row_base,
    ulong row,
    ulong root_context) {
    IgQAllocator allocator = {
        args.control_base,
        args.dynamic_cell_capacity,
        args.dynamic_item_capacity,
        args.dynamic_byte_capacity,
    };
    return ig_q_evaluate_with_allocator(
        program, scratch, args, allocator,
        root, row_base, row, root_context);
}

[[clang::noinline]] void ig_q_copy_row(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong source_base,
    ulong source_row,
    ulong target_base,
    ulong target_row) {
    #pragma clang loop unroll(disable)
    for (ulong slot = 0ul; slot < args.slot_count; ++slot) {
        scratch[target_base + target_row * args.slot_count + slot]
            = scratch[source_base + source_row * args.slot_count + slot];
    }
}

[[clang::noinline]] void ig_q_clear_row(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong base,
    ulong row) {
    #pragma clang loop unroll(disable)
    for (ulong slot = 0ul; slot < args.slot_count; ++slot) {
        scratch[base + row * args.slot_count + slot] = IG_Q_INVALID;
    }
}

[[clang::noinline]] ulong ig_q_scalar_hash(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong handle) {
    device const ulong* cell = ig_q_cell(program, scratch, args, handle);
    if (cell[0] == IG_Q_TAG_LIST || cell[0] == IG_Q_TAG_MAP) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return 0ul;
    }
    ulong hash = ig_q_mix(cell[0] + 1ul);
    if (cell[0] == IG_Q_TAG_STRING) {
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < cell[2]; ++index) {
            hash = ig_q_mix(hash ^ ulong(ig_q_byte(program, scratch, args, cell, index)));
        }
        return hash;
    }
    return ig_q_mix(hash ^ cell[1]);
}

inline void ig_q_write_receipt(
    device const ulong* program,
    device ulong* output,
    constant MetalQuantifierArgs& args,
    ulong receipt,
    ulong input_rows,
    ulong output_rows) {
    ulong descriptor = args.receipt_descriptor_base + receipt * 4ul;
    ulong base = args.receipt_base + receipt * IG_Q_RECEIPT_WORDS;
    output[base] = args.execution_high;
    output[base + 1ul] = args.execution_low;
    output[base + 2ul] = program[descriptor];
    output[base + 3ul] = program[descriptor + 1ul];
    output[base + 4ul] = program[descriptor + 2ul];
    output[base + 5ul] = program[descriptor + 3ul];
    output[base + 6ul] = input_rows;
    output[base + 7ul] = output_rows;
    output[base + 8ul] = 2ul;
}

inline bool ig_q_output_alloc_cell(
    constant MetalQuantifierArgs& args,
    thread ulong& cursor,
    thread ulong& index) {
    if (cursor >= args.output_cell_capacity) return false;
    index = cursor++;
    return true;
}

inline bool ig_q_output_alloc_items(
    constant MetalQuantifierArgs& args,
    ulong count,
    thread ulong& cursor,
    thread ulong& offset) {
    if (count > args.output_item_capacity
            || cursor > args.output_item_capacity - count) return false;
    offset = cursor;
    cursor += count;
    return true;
}

inline bool ig_q_output_alloc_bytes(
    constant MetalQuantifierArgs& args,
    ulong count,
    thread ulong& cursor,
    thread ulong& offset) {
    if (count > args.output_byte_capacity
            || cursor > args.output_byte_capacity - count) return false;
    offset = cursor;
    cursor += count;
    return true;
}

[[clang::noinline]] ulong ig_q_publish_value(
    device const ulong* program,
    device ulong* scratch,
    device ulong* output,
    constant MetalQuantifierArgs& args,
    ulong source_handle,
    thread ulong& cell_cursor,
    thread ulong& item_cursor,
    thread ulong& byte_cursor) {
    ulong root = 0ul;
    if (!ig_q_output_alloc_cell(args, cell_cursor, root)) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return IG_Q_INVALID;
    }
    ulong depth = 1ul;
    ulong first = args.compare_frame_base;
    scratch[first] = source_handle;
    scratch[first + 1ul] = root;
    scratch[first + 2ul] = 0ul;
    scratch[first + 3ul] = 0ul;
    scratch[first + 4ul] = 0ul;
    scratch[first + 5ul] = 0ul;
    #pragma clang loop unroll(disable)
    while (depth != 0ul && ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
        ulong frame_base = args.compare_frame_base
            + (depth - 1ul) * IG_Q_COMPARE_FRAME_WORDS;
        device ulong* frame = scratch + frame_base;
        device const ulong* source = ig_q_cell(program, scratch, args, frame[0]);
        ulong destination = args.output_cell_base + frame[1] * IG_Q_VALUE_WORDS;
        if (frame[2] == 0ul) {
            output[destination] = source[0];
            if (source[0] <= IG_Q_TAG_FLOAT) {
                output[destination + 1ul] = source[1];
                output[destination + 2ul] = 0ul;
                output[destination + 3ul] = 0ul;
                depth -= 1ul;
                continue;
            }
            if (source[0] == IG_Q_TAG_STRING) {
                ulong offset = 0ul;
                if (!ig_q_output_alloc_bytes(args, source[2], byte_cursor, offset)) {
                    ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
                    continue;
                }
                output[destination + 1ul] = offset;
                output[destination + 2ul] = source[2];
                output[destination + 3ul] = 2ul;
                #pragma clang loop unroll(disable)
                for (ulong index = 0ul; index < source[2]; ++index) {
                    ig_q_store_packed_byte(output, args.output_byte_base, offset + index,
                        ig_q_byte(program, scratch, args, source, index));
                }
                depth -= 1ul;
                continue;
            }
            if (source[0] != IG_Q_TAG_LIST && source[0] != IG_Q_TAG_MAP) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                continue;
            }
            ulong width = source[0] == IG_Q_TAG_LIST ? 1ul : 2ul;
            ulong handles = source[2] * width;
            if (width != 0ul && handles / width != source[2]) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                continue;
            }
            ulong offset = 0ul;
            if (!ig_q_output_alloc_items(args, handles, item_cursor, offset)) {
                ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
                continue;
            }
            output[destination + 1ul] = offset;
            output[destination + 2ul] = source[2];
            output[destination + 3ul] = 2ul;
            frame[2] = 1ul;
            frame[3] = 0ul;
            frame[4] = handles;
            frame[5] = offset;
            if (handles == 0ul) depth -= 1ul;
            continue;
        }
        if (frame[3] >= frame[4]) {
            depth -= 1ul;
            continue;
        }
        if (depth >= args.frame_capacity) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            continue;
        }
        ulong child_source = ig_q_item(program, scratch, args, source, frame[3]);
        ulong child_destination = 0ul;
        if (!ig_q_output_alloc_cell(args, cell_cursor, child_destination)) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
            continue;
        }
        output[args.output_item_base + frame[5] + frame[3]] = child_destination;
        frame[3] += 1ul;
        ulong child_frame = args.compare_frame_base + depth * IG_Q_COMPARE_FRAME_WORDS;
        scratch[child_frame] = child_source;
        scratch[child_frame + 1ul] = child_destination;
        scratch[child_frame + 2ul] = 0ul;
        scratch[child_frame + 3ul] = 0ul;
        scratch[child_frame + 4ul] = 0ul;
        scratch[child_frame + 5ul] = 0ul;
        depth += 1ul;
    }
    return ig_q_status_load(scratch, args) == IG_Q_STATUS_OK ? root : IG_Q_INVALID;
}

[[clang::noinline]] bool ig_q_program_contract(
    device const ulong* program,
    constant MetalQuantifierArgs& args) {
    bool unit_source = args.source_kind == 0ul
        && args.source_receipt_count == 0ul
        && args.source_output_slot == IG_Q_INVALID
        && args.source_row_bound == 1ul
        && args.range_start == 0ul
        && args.range_end == 0ul
        && args.range_step == 0ul
        && args.range_integer_mask == 0ul;
    bool range_source = args.source_kind == 1ul
        && args.source_receipt_count == 1ul
        && args.source_output_slot < args.slot_count
        && args.source_row_bound == args.max_rows
        && args.source_row_bound <= args.dynamic_cell_capacity
        && (args.range_integer_mask & ~7ul) == 0ul;
    ulong immutable_byte_words = (args.immutable_byte_count + 7ul) / 8ul;
    ulong expected_stage_data = args.stage_base + args.stage_count * IG_Q_STAGE_WORDS;
    ulong expected_expression = expected_stage_data + args.stage_data_count;
    ulong expected_child = expected_expression
        + args.expression_count * IG_Q_EXPRESSION_WORDS;
    ulong expected_cells = expected_child + args.child_count;
    ulong expected_items = expected_cells
        + args.immutable_cell_count * IG_Q_VALUE_WORDS;
    ulong expected_bytes = expected_items + args.immutable_item_count;
    ulong expected_outputs = expected_bytes + immutable_byte_words;
    ulong expected_receipts = expected_outputs + args.output_count;
    ulong expected_words = expected_receipts + args.receipt_count * 4ul;
    return program[0] == IG_Q_PROGRAM_MAGIC
        && program[1] == args.program_words
        && program[2] == args.stage_count
        && program[3] == args.stage_data_count
        && program[4] == args.expression_count
        && program[5] == args.child_count
        && program[6] == args.immutable_cell_count
        && program[7] == args.immutable_item_count
        && program[8] == args.immutable_byte_count
        && program[9] == args.output_count
        && program[10] == args.receipt_count
        && program[11] == args.slot_count
        && program[12] == args.max_rows
        && program[13] == args.max_list_items
        && program[14] == args.random_seed
        && program[15] == args.fingerprint_0
        && program[16] == args.fingerprint_1
        && program[17] == args.fingerprint_2
        && program[18] == args.fingerprint_3
        && program[19] == args.execution_high
        && program[20] == args.execution_low
        && program[21] == args.scratch_words
        && program[22] == args.output_words
        && program[23] == args.final_row_bound
        && args.stage_base == 24ul
        && args.stage_data_base == expected_stage_data
        && args.expression_base == expected_expression
        && args.child_base == expected_child
        && args.immutable_cell_base == expected_cells
        && args.immutable_item_base == expected_items
        && args.immutable_byte_base == expected_bytes
        && args.output_source_base == expected_outputs
        && args.receipt_descriptor_base == expected_receipts
        && args.program_words == expected_words
        && (unit_source || range_source)
        && args.receipt_count
            == args.source_receipt_count + args.stage_count + 1ul
        && args.frame_capacity > args.expression_count
        && args.eval_lane_count >= max(args.final_row_bound, 1ul)
        && args.eval_lane_count <= args.max_rows
        && args.final_row_bound <= args.max_rows;
}

[[clang::noinline]] ulong ig_q_stage_project(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong stage_index,
    ulong input_rows,
    ulong current_base,
    ulong next_base,
    ulong current_lineage,
    ulong next_lineage) {
    ulong data_base = stage[2];
    ulong binding_count = stage[3];
    if (data_base > args.stage_data_count
            || binding_count > (args.stage_data_count - data_base) / 2ul) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return input_rows;
    }
    #pragma clang loop unroll(disable)
    for (ulong row = 0ul; row < input_rows; ++row) {
        if (stage[1] != 0ul) {
            ig_q_copy_row(scratch, args, current_base, row, next_base, row);
        } else {
            ig_q_clear_row(scratch, args, next_base, row);
        }
        scratch[next_lineage + row] = scratch[current_lineage + row];
        #pragma clang loop unroll(disable)
        for (ulong binding = 0ul; binding < binding_count; ++binding) {
            ulong slot = program[args.stage_data_base + data_base + binding * 2ul];
            ulong expression = program[
                args.stage_data_base + data_base + binding * 2ul + 1ul];
            if (slot >= args.slot_count) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                break;
            }
            ulong context = ig_q_context(
                scratch[current_lineage + row], stage_index, binding);
            ulong value = ig_q_evaluate(
                program, scratch, args, expression, current_base, row, context);
            if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
            ig_q_set_row_slot(scratch, args, next_base, row, slot, value);
        }
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
    }
    return input_rows;
}

[[clang::noinline]] ulong ig_q_stage_filter(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong stage_index,
    ulong input_rows,
    ulong current_base,
    ulong next_base,
    ulong current_lineage,
    ulong next_lineage) {
    ulong data_base = stage[2];
    if (stage[3] != 1ul || data_base >= args.stage_data_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return 0ul;
    }
    ulong expression = program[args.stage_data_base + data_base];
    ulong row_count = 0ul;
    #pragma clang loop unroll(disable)
    for (ulong row = 0ul; row < input_rows; ++row) {
        ulong value = ig_q_evaluate(program, scratch, args, expression,
            current_base, row,
            ig_q_context(scratch[current_lineage + row], stage_index, 0ul));
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
        long truth = ig_q_truth(program, scratch, args, value);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
        if (truth == 1L) {
            ig_q_copy_row(scratch, args, current_base, row, next_base, row_count);
            scratch[next_lineage + row_count] = scratch[current_lineage + row];
            row_count += 1ul;
        }
    }
    return row_count;
}

[[clang::noinline]] ulong ig_q_group_row_hash(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong row_base,
    ulong row) {
    ulong hash = ig_q_mix(stage[3] + 0x47524f5550ul);
    #pragma clang loop unroll(disable)
    for (ulong group = 0ul; group < stage[3]; ++group) {
        ulong slot = program[args.stage_data_base + stage[2] + group * 2ul];
        hash = ig_q_mix(hash ^ ig_q_scalar_hash(
            program, scratch, args,
            ig_q_row_slot(scratch, args, row_base, row, slot)));
    }
    return hash;
}

[[clang::noinline]] bool ig_q_group_rows_equal(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong row_base,
    ulong left,
    ulong right) {
    #pragma clang loop unroll(disable)
    for (ulong group = 0ul; group < stage[3]; ++group) {
        ulong slot = program[args.stage_data_base + stage[2] + group * 2ul];
        if (ig_q_equal_scalar(
                program, scratch, args,
                ig_q_row_slot(scratch, args, row_base, left, slot),
                ig_q_row_slot(scratch, args, row_base, right, slot),
                true) != 1L) return false;
    }
    return true;
}

[[clang::noinline]] int ig_q_group_handle_compare(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong left_handle,
    ulong right_handle) {
    device const ulong* left = ig_q_cell(program, scratch, args, left_handle);
    device const ulong* right = ig_q_cell(program, scratch, args, right_handle);
    if (left[0] != right[0]) return left[0] < right[0] ? -1 : 1;
    if (left[0] == IG_Q_TAG_NULL) return 0;
    if (left[0] == IG_Q_TAG_BOOLEAN) {
        return left[1] < right[1] ? -1 : (left[1] > right[1] ? 1 : 0);
    }
    if (left[0] == IG_Q_TAG_INTEGER) {
        long l = as_type<long>(left[1]);
        long r = as_type<long>(right[1]);
        return l < r ? -1 : (l > r ? 1 : 0);
    }
    if (left[0] == IG_Q_TAG_FLOAT) return ig_q_float_compare(left[1], right[1]);
    if (left[0] == IG_Q_TAG_STRING) {
        ulong width = min(left[2], right[2]);
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < width; ++index) {
            uchar l = ig_q_byte(program, scratch, args, left, index);
            uchar r = ig_q_byte(program, scratch, args, right, index);
            if (l != r) return l < r ? -1 : 1;
        }
        return left[2] < right[2] ? -1 : (left[2] > right[2] ? 1 : 0);
    }
    ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
    return 0;
}

[[clang::noinline]] int ig_q_group_row_compare(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong row_base,
    ulong left,
    ulong right) {
    #pragma clang loop unroll(disable)
    for (ulong group = 0ul; group < stage[3]; ++group) {
        ulong slot = program[args.stage_data_base + stage[2] + group * 2ul];
        int order = ig_q_group_handle_compare(
            program, scratch, args,
            ig_q_row_slot(scratch, args, row_base, left, slot),
            ig_q_row_slot(scratch, args, row_base, right, slot));
        if (order != 0) return order;
    }
    return 0;
}

[[clang::noinline]] void ig_q_group_swap_rows(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong row_base,
    ulong left,
    ulong right) {
    if (left == right) return;
    #pragma clang loop unroll(disable)
    for (ulong slot = 0ul; slot < args.slot_count; ++slot) {
        ulong l = ig_q_row_slot(scratch, args, row_base, left, slot);
        ulong r = ig_q_row_slot(scratch, args, row_base, right, slot);
        ig_q_set_row_slot(scratch, args, row_base, left, slot, r);
        ig_q_set_row_slot(scratch, args, row_base, right, slot, l);
    }
}

[[clang::noinline]] void ig_q_group_sift_down(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong row_base,
    ulong root,
    ulong end) {
    if (end < 2ul) return;
    while (root <= (end - 2ul) / 2ul) {
        ulong child = root * 2ul + 1ul;
        if (child + 1ul < end && ig_q_group_row_compare(
                program, scratch, args, stage, row_base, child, child + 1ul) < 0) {
            child += 1ul;
        }
        if (ig_q_group_row_compare(
                program, scratch, args, stage, row_base, root, child) >= 0) return;
        ig_q_group_swap_rows(scratch, args, row_base, root, child);
        root = child;
    }
}

[[clang::noinline]] void ig_q_group_sort_rows(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong row_base,
    ulong row_count) {
    if (row_count < 2ul) return;
    for (ulong start = row_count / 2ul; start != 0ul; --start) {
        ig_q_group_sift_down(
            program, scratch, args, stage, row_base, start - 1ul, row_count);
    }
    for (ulong end = row_count; end > 1ul; --end) {
        ig_q_group_swap_rows(scratch, args, row_base, 0ul, end - 1ul);
        ig_q_group_sift_down(
            program, scratch, args, stage, row_base, 0ul, end - 1ul);
    }
}

[[clang::noinline]]
ulong ig_q_stage_group(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* stage,
    ulong stage_index,
    ulong input_rows,
    ulong current_base,
    ulong next_base,
    ulong current_lineage,
    ulong next_lineage) {
    ulong data_base = stage[2];
    ulong group_count = stage[3];
    ulong count_base = stage[4];
    ulong count_outputs = stage[5];
    if (data_base > args.stage_data_count
            || group_count > (args.stage_data_count - data_base) / 2ul
            || count_base > args.stage_data_count
            || count_outputs > args.stage_data_count - count_base) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return 0ul;
    }
    #pragma clang loop unroll(disable)
    for (ulong row = 0ul; row < input_rows; ++row) {
        ig_q_clear_row(scratch, args, next_base, row);
        scratch[next_lineage + row] = scratch[current_lineage + row];
        #pragma clang loop unroll(disable)
        for (ulong group = 0ul; group < group_count; ++group) {
            ulong slot = program[args.stage_data_base + data_base + group * 2ul];
            ulong expression = program[
                args.stage_data_base + data_base + group * 2ul + 1ul];
            if (slot >= args.slot_count) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                break;
            }
            ulong value = ig_q_evaluate(program, scratch, args, expression,
                current_base, row,
                ig_q_context(scratch[current_lineage + row], stage_index, group));
            if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
            ig_q_set_row_slot(scratch, args, next_base, row, slot, value);
        }
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
    }
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return 0ul;

    ulong row_count = 0ul;
    ulong table_base = args.lineage_a_base;
    ulong table_capacity = args.max_rows * 2ul;
    if (args.max_rows > 0xfffffffful || table_capacity < args.max_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return 0ul;
    }
    #pragma clang loop unroll(disable)
    for (ulong slot = 0ul; slot < table_capacity; ++slot) {
        scratch[table_base + slot] = 0ul;
    }
    #pragma clang loop unroll(disable)
    for (ulong candidate = 0ul; candidate < input_rows; ++candidate) {
        ulong hash = ig_q_group_row_hash(
            program, scratch, args, stage, next_base, candidate);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
        ulong table_slot = hash % table_capacity;
        bool placed = false;
        #pragma clang loop unroll(disable)
        for (ulong probe = 0ul; probe < table_capacity; ++probe) {
            ulong entry = scratch[table_base + table_slot];
            if (entry == 0ul) {
                scratch[table_base + table_slot] = (1ul << 32ul) | (candidate + 1ul);
                placed = true;
                break;
            }
            ulong representative = (entry & 0xfffffffful) - 1ul;
            if (representative >= input_rows) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                break;
            }
            if (hash == ig_q_group_row_hash(
                    program, scratch, args, stage, next_base, representative)
                    && ig_q_group_rows_equal(
                        program, scratch, args, stage, next_base,
                        representative, candidate)) {
                ulong count = entry >> 32ul;
                if (count >= 0x7ffffffful) {
                    ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
                } else {
                    scratch[table_base + table_slot] =
                        ((count + 1ul) << 32ul) | (representative + 1ul);
                }
                placed = true;
                break;
            }
            table_slot += 1ul;
            if (table_slot == table_capacity) table_slot = 0ul;
        }
        if (!placed && ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        }
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
    }
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return 0ul;

    #pragma clang loop unroll(disable)
    for (ulong table_slot = 0ul; table_slot < table_capacity; ++table_slot) {
        ulong entry = scratch[table_base + table_slot];
        if (entry == 0ul) continue;
        if (row_count >= args.max_rows) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
            break;
        }
        ulong representative = (entry & 0xfffffffful) - 1ul;
        ulong count_value = entry >> 32ul;
        ig_q_clear_row(scratch, args, current_base, row_count);
        #pragma clang loop unroll(disable)
        for (ulong group = 0ul; group < group_count; ++group) {
            ulong slot = program[args.stage_data_base + data_base + group * 2ul];
            ig_q_set_row_slot(
                scratch, args, current_base, row_count, slot,
                ig_q_row_slot(scratch, args, next_base, representative, slot));
        }
        #pragma clang loop unroll(disable)
        for (ulong count = 0ul; count < count_outputs; ++count) {
            ulong slot = program[args.stage_data_base + count_base + count];
            if (slot >= args.slot_count) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                break;
            }
            ulong value = ig_q_alloc_cell(
                scratch, args, IG_Q_TAG_INTEGER, count_value, 0ul, 1ul);
            if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
            ig_q_set_row_slot(scratch, args, current_base, row_count, slot, value);
        }
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
        row_count += 1ul;
    }
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return 0ul;

    ig_q_group_sort_rows(program, scratch, args, stage, current_base, row_count);
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return 0ul;
    #pragma clang loop unroll(disable)
    for (ulong row = 0ul; row < row_count; ++row) {
        ulong lineage = ig_q_mix(stage_index);
        #pragma clang loop unroll(disable)
        for (ulong group = 0ul; group < group_count; ++group) {
            ulong slot = program[args.stage_data_base + data_base + group * 2ul];
            lineage = ig_q_mix(lineage ^ ig_q_scalar_hash(
                program, scratch, args,
                ig_q_row_slot(scratch, args, current_base, row, slot)));
        }
        scratch[current_lineage + row] = lineage;
    }
    if (input_rows == 0ul && group_count == 0ul
            && ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
        row_count = 1ul;
        ig_q_clear_row(scratch, args, current_base, 0ul);
        scratch[current_lineage] = ig_q_mix(stage_index);
        #pragma clang loop unroll(disable)
        for (ulong count = 0ul; count < count_outputs; ++count) {
            ulong slot = program[args.stage_data_base + count_base + count];
            if (slot >= args.slot_count) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                break;
            }
            ulong value = ig_q_alloc_cell(
                scratch, args, IG_Q_TAG_INTEGER, 0ul, 0ul, 1ul);
            if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
            ig_q_set_row_slot(scratch, args, current_base, 0ul, slot, value);
        }
    }
    return row_count;
}

[[clang::noinline]] bool ig_q_publish_rows(
    device const ulong* program,
    device ulong* scratch,
    device ulong* output,
    constant MetalQuantifierArgs& args,
    ulong current_base,
    ulong row_count) {
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return false;
    if (row_count > args.final_row_bound) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return false;
    }
    ulong cell_cursor = 0ul;
    ulong item_cursor = 0ul;
    ulong byte_cursor = 0ul;
    ulong root_cursor = 0ul;
    #pragma clang loop unroll(disable)
    for (ulong row = 0ul; row < row_count; ++row) {
        #pragma clang loop unroll(disable)
        for (ulong column = 0ul; column < args.output_count; ++column) {
            ulong slot = program[args.output_source_base + column];
            if (slot >= args.slot_count || root_cursor >= args.root_capacity) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                break;
            }
            ulong source = ig_q_row_slot(scratch, args, current_base, row, slot);
            if (source == IG_Q_INVALID) {
                ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
                break;
            }
            output[args.root_base + root_cursor++] = ig_q_publish_value(
                program, scratch, output, args, source,
                cell_cursor, item_cursor, byte_cursor);
            if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
        }
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
    }
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return false;
    ig_q_write_receipt(
        program, output, args,
        args.source_receipt_count + args.stage_count,
        row_count, row_count);
    output[18] = row_count;
    output[25] = root_cursor;
    output[26] = cell_cursor;
    output[27] = item_cursor;
    output[28] = byte_cursor;
    output[1] = IG_Q_STATUS_OK;
    return true;
}

constant ulong IG_Q_ENTITY_SOURCE_MAGIC = 0x4947515545535031ul;
constant ulong IG_Q_ENTITY_OUTPUT_MAGIC = 0x4947515545535231ul;
constant ulong IG_Q_ENTITY_OUTPUT_HEADER_WORDS = 18ul;
constant ulong IG_Q_ENTITY_LIST_HANDLE = 0x4000000000000000ul;
constant uint IG_Q_ENTITY_STATUS_OK = 0u;
constant uint IG_Q_ENTITY_STATUS_BUDGET = 1u;
constant uint IG_Q_ENTITY_STATUS_TYPE = 2u;
constant uint IG_Q_ENTITY_STATUS_CORRUPT = 3u;
constant uint IG_Q_ENTITY_STATUS_ADMISSION = 4u;
constant uint IG_Q_ENTITY_CONTROL_STATUS = 0u;
constant uint IG_Q_ENTITY_CONTROL_PATH_COUNT = 1u;
constant uint IG_Q_ENTITY_CONTROL_FINAL_COUNT = 2u;
constant uint IG_Q_ENTITY_CONTROL_DEPENDENCY_COUNT = 3u;
constant uint IG_Q_ENTITY_CONTROL_PROPERTY_PRESENT = 4u;
constant uint IG_Q_ENTITY_CONTROL_PROPERTY_KINDS = 5u;
constant uint IG_Q_ENTITY_CONTROL_PROPERTY_MAX_STRING = 6u;
constant uint IG_Q_ENTITY_CONTROL_ENTITY_OUTPUT_COUNT = 7u;
constant uint IG_Q_ENTITY_CONTROL_WORDS = 16u;

struct MetalQuantifierEntityArgs {
    ulong source_base;
    ulong binding_base;
    ulong path_packet_base;
    ulong scalar_output_words;
    ulong entity_output_base;
    ulong path_descriptor_base;
    ulong path_edge_base;
    ulong path_node_base;
    ulong path_segment_base;
    ulong entity_descriptor_base;
    ulong entity_item_base;
    ulong dependency_base;
    ulong property_id;
    uint source_receipt_count;
    uint path_receipt_count;
    uint binding_count;
    uint group_enabled;
    uint entity_kind;
    uint skip;
    uint maximum_items;
    uint property_shape;
    uint property_storage_shape;
    uint maximum_string_bytes;
    uint entity_rows;
    uint node_rows;
    uint edge_rows;
    uint dependency_rows;
    uint property_offset_count;
    uint property_byte_count;
    uint path_capacity;
    uint edge_slots;
    uint segment_count;
    uint path_output_words;
    uint entity_output_capacity;
    uint entity_item_capacity;
    uint dependency_capacity;
    uint group_table_capacity;
    uint group_sort_capacity;
};

inline void ig_q_entity_fail(device atomic_uint* control, uint status) {
    uint prior = IG_Q_ENTITY_STATUS_OK;
    while (prior == IG_Q_ENTITY_STATUS_OK
            && !atomic_compare_exchange_weak_explicit(
                &control[IG_Q_ENTITY_CONTROL_STATUS], &prior, status,
                memory_order_relaxed, memory_order_relaxed)) {}
}

inline ulong ig_q_entity_path_descriptor_base(
    constant MetalQuantifierEntityArgs& args) {
    return IG_QUANTIFIER_VARIABLE_PATH_OUTPUT_HEADER_WORDS
        + ulong(args.path_receipt_count) * IG_QUANTIFIER_VARIABLE_PATH_RECEIPT_WORDS;
}

inline ulong ig_q_entity_path_edge_input_base(
    constant MetalQuantifierEntityArgs& args) {
    return ig_q_entity_path_descriptor_base(args) + ulong(args.path_capacity) * 3ul;
}

inline ulong ig_q_entity_path_node_input_base(
    constant MetalQuantifierEntityArgs& args) {
    return ig_q_entity_path_edge_input_base(args)
        + ulong(args.path_capacity) * ulong(args.edge_slots);
}

inline ulong ig_q_entity_path_segment_input_base(
    constant MetalQuantifierEntityArgs& args) {
    return ig_q_entity_path_node_input_base(args)
        + ulong(args.path_capacity) * ulong(args.edge_slots + 1u);
}

inline uint ig_q_entity_path_length(
    device const ulong* path_output,
    uint path,
    constant MetalQuantifierEntityArgs& args) {
    return uint(path_output[ig_q_entity_path_descriptor_base(args)
        + ulong(path) * 3ul + 2ul]);
}

inline uint ig_q_entity_list_length(
    device const ulong* path_output,
    uint path,
    constant MetalQuantifierEntityArgs& args) {
    uint length = ig_q_entity_path_length(path_output, path, args);
    uint full = args.entity_kind == 1u ? length + 1u : length;
    return full > args.skip ? full - args.skip : 0u;
}

inline uint ig_q_entity_list_item(
    device const ulong* path_output,
    uint path,
    uint item,
    constant MetalQuantifierEntityArgs& args) {
    ulong index = ulong(args.skip + item);
    if (args.entity_kind == 1u) {
        return uint(path_output[ig_q_entity_path_node_input_base(args)
            + ulong(path) * ulong(args.edge_slots + 1u) + index]);
    }
    return uint(path_output[ig_q_entity_path_edge_input_base(args)
        + ulong(path) * ulong(args.edge_slots) + index]);
}

inline bool ig_q_entity_lists_equal(
    device const ulong* path_output,
    uint left,
    uint right,
    constant MetalQuantifierEntityArgs& args) {
    uint left_count = ig_q_entity_list_length(path_output, left, args);
    uint right_count = ig_q_entity_list_length(path_output, right, args);
    if (left_count != right_count) return false;
    for (uint item = 0u; item < left_count; ++item) {
        if (ig_q_entity_list_item(path_output, left, item, args)
                != ig_q_entity_list_item(path_output, right, item, args)) return false;
    }
    return true;
}

inline ulong ig_q_entity_load_u64_le(
    device const uchar* bytes,
    ulong offset) {
    ulong value = 0ul;
    for (uint lane = 0u; lane < 8u; ++lane) {
        value |= ulong(bytes[offset + ulong(lane)]) << (lane * 8u);
    }
    return value;
}

inline bool ig_q_entity_source_contract(
    device const ulong* program,
    constant MetalQuantifierArgs& q,
    constant MetalQuantifierEntityArgs& args) {
    if (program[0] != IG_Q_PROGRAM_MAGIC
            || program[1] != q.program_words
            || program[2] != q.stage_count
            || program[10] != q.receipt_count
            || program[19] != q.execution_high
            || program[20] != q.execution_low
            || program[21] != q.scratch_words
            || program[22] != q.output_words
            || args.source_base >= q.program_words
            || program[args.source_base] != IG_Q_ENTITY_SOURCE_MAGIC
            || program[args.source_base + 2ul] != ulong(args.entity_kind)
            || program[args.source_base + 4ul] != ulong(args.skip)
            || program[args.source_base + 6ul] != ulong(args.property_shape)
            || program[args.source_base + 7ul] != ulong(args.maximum_string_bytes)
            || program[args.source_base + 8ul] != args.path_packet_base
            || program[args.source_base + 10ul] != ulong(args.source_receipt_count)
            || program[args.source_base + 13ul] != ulong(args.binding_count)
            || program[args.source_base + 14ul] != args.binding_base
            || program[args.source_base + 15ul] != ulong(args.maximum_items)
            || program[args.source_base + 16ul] != args.property_id
            || q.receipt_count != ulong(args.source_receipt_count) + q.stage_count + 1ul
            || args.source_receipt_count != args.path_receipt_count + 2u
            || args.entity_kind < 1u || args.entity_kind > 2u
            || args.skip != 1u || args.path_capacity == 0u
            || args.segment_count == 0u
            || args.group_table_capacity == 0u
            || args.group_sort_capacity < args.path_capacity
            || ulong(args.node_rows) + ulong(args.edge_rows)
                != ulong(args.dependency_rows)
            || (args.group_enabled != 0u
                && ((args.group_table_capacity
                        & (args.group_table_capacity - 1u)) != 0u
                    || (args.group_sort_capacity
                        & (args.group_sort_capacity - 1u)) != 0u
                    || ulong(args.group_table_capacity)
                        < ulong(args.path_capacity) * 2ul))
            || q.root_capacity != q.final_row_bound * q.output_count
            || args.scalar_output_words != args.entity_output_base
            || args.entity_output_base > q.output_words
            || args.path_descriptor_base
                != args.entity_output_base + IG_Q_ENTITY_OUTPUT_HEADER_WORDS
            || args.path_edge_base
                != args.path_descriptor_base + ulong(args.path_capacity) * 3ul
            || args.path_node_base
                != args.path_edge_base
                    + ulong(args.path_capacity) * ulong(args.edge_slots)
            || args.path_segment_base
                != args.path_node_base
                    + ulong(args.path_capacity) * ulong(args.edge_slots + 1u)
            || args.entity_descriptor_base
                != args.path_segment_base
                    + ulong(args.path_capacity) * ulong(args.segment_count)
            || args.entity_item_base
                != args.entity_descriptor_base
                    + ulong(args.entity_output_capacity) * 4ul
            || args.dependency_base
                != args.entity_item_base
                    + ulong(args.entity_item_capacity) * 2ul
            || q.output_words
                != args.dependency_base + ulong(args.dependency_capacity) * 4ul
            || args.path_packet_base >= q.program_words
            || program[args.path_packet_base] != IG_QUANTIFIER_VARIABLE_PATH_ABI
            || args.path_packet_base + 1ul >= q.program_words
            || program[args.path_packet_base + 1ul] != ulong(args.segment_count)) return false;
    return true;
}

kernel void ig_quantifier_entity_clear(
    device ulong* scratch [[buffer(0)]],
    device ulong* output [[buffer(1)]],
    device atomic_uint* entity_control [[buffer(2)]],
    device uint* group_flags [[buffer(3)]],
    device uint* group_ranks [[buffer(4)]],
    device uint* group_counts [[buffer(5)]],
    device atomic_uint* canonical_counts [[buffer(6)]],
    device uint* final_paths [[buffer(7)]],
    device atomic_uint* group_table [[buffer(8)]],
    device atomic_uint* node_dependencies [[buffer(9)]],
    device atomic_uint* edge_dependencies [[buffer(10)]],
    device atomic_uint* property_dependencies [[buffer(11)]],
    constant MetalQuantifierArgs& q [[buffer(12)]],
    constant MetalQuantifierEntityArgs& args [[buffer(13)]],
    uint tid [[thread_position_in_grid]]) {
    if (ulong(tid) < q.scratch_words) scratch[tid] = 0ul;
    if (ulong(tid) < q.output_words) output[tid] = 0ul;
    if (tid < IG_Q_ENTITY_CONTROL_WORDS) {
        atomic_store_explicit(&entity_control[tid], 0u, memory_order_relaxed);
    }
    if (tid < args.path_capacity) {
        group_flags[tid] = 0u;
        group_ranks[tid] = 0u;
        group_counts[tid] = 0u;
        atomic_store_explicit(&canonical_counts[tid], 0u, memory_order_relaxed);
    }
    if (tid < args.group_sort_capacity) {
        final_paths[tid] = 0xffffffffu;
    }
    if (tid < args.group_table_capacity) {
        atomic_store_explicit(&group_table[tid], 0u, memory_order_relaxed);
    }
    if (tid < args.node_rows) {
        atomic_store_explicit(&node_dependencies[tid], 0u, memory_order_relaxed);
    }
    if (tid < args.edge_rows) {
        atomic_store_explicit(&edge_dependencies[tid], 0u, memory_order_relaxed);
    }
    if (tid < args.entity_rows) {
        atomic_store_explicit(&property_dependencies[tid], 0u, memory_order_relaxed);
    }
}

kernel void ig_quantifier_entity_validate_property(
    device const ulong* program [[buffer(0)]],
    device const uchar* active [[buffer(1)]],
    device const uchar* property_u8 [[buffer(2)]],
    device const long* property_i64 [[buffer(3)]],
    device const uint* property_u32 [[buffer(4)]],
    device const uchar* validity [[buffer(5)]],
    device const uint* offsets [[buffer(6)]],
    device const uchar* bytes [[buffer(7)]],
    device atomic_uint* control [[buffer(8)]],
    constant MetalQuantifierArgs& q [[buffer(9)]],
    constant MetalQuantifierEntityArgs& args [[buffer(10)]],
    uint row [[thread_position_in_grid]]) {
    if (row >= args.entity_rows
            || atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
                != IG_Q_ENTITY_STATUS_OK) return;
    if (!ig_q_entity_source_contract(program, q, args)) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    uchar is_active = active[row];
    if (is_active > 1u) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    if (is_active == 0u || args.property_storage_shape == 0u) return;
    uchar present = validity[row];
    if (present > 1u) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    if (present == 0u) return;
    uint kind = 0u;
    uint string_bytes = 0u;
    if (args.property_storage_shape == 1u) {
        if (property_u8[row] > 1u) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        kind = 1u;
    } else if (args.property_storage_shape == 2u) {
        (void)property_i64[row];
        kind = 2u;
    } else if (args.property_storage_shape == 3u) {
        (void)property_i64[row];
        kind = 4u;
    } else if (args.property_storage_shape == 4u) {
        uint id = property_u32[row];
        if (args.property_offset_count == 0u
                || id + 1u >= args.property_offset_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        uint begin = offsets[id];
        uint end = offsets[id + 1u];
        if (begin > end || end > args.property_byte_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        kind = 8u;
        string_bytes = end - begin;
    } else if (args.property_storage_shape == 5u) {
        if (row + 1u >= args.property_offset_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        uint begin = offsets[row];
        uint end = offsets[row + 1u];
        if (begin >= end || end > args.property_byte_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        uchar tag = bytes[begin];
        uint payload = end - begin - 1u;
        if (tag == 1u && payload == 1u && bytes[begin + 1u] <= 1u) kind = 1u;
        else if (tag == 2u && payload == 8u) kind = 2u;
        else if (tag == 3u && payload == 8u) kind = 4u;
        else if (tag == 4u) {
            kind = 8u;
            string_bytes = payload;
        } else {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_ADMISSION);
            return;
        }
    } else {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    atomic_fetch_add_explicit(
        &control[IG_Q_ENTITY_CONTROL_PROPERTY_PRESENT], 1u, memory_order_relaxed);
    atomic_fetch_or_explicit(
        &control[IG_Q_ENTITY_CONTROL_PROPERTY_KINDS], kind, memory_order_relaxed);
    atomic_fetch_max_explicit(
        &control[IG_Q_ENTITY_CONTROL_PROPERTY_MAX_STRING],
        string_bytes,
        memory_order_relaxed);
}

kernel void ig_quantifier_entity_finalize_property(
    device const ulong* program [[buffer(0)]],
    device atomic_uint* control [[buffer(1)]],
    constant MetalQuantifierArgs& q [[buffer(2)]],
    constant MetalQuantifierEntityArgs& args [[buffer(3)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
                != IG_Q_ENTITY_STATUS_OK) return;
    if (!ig_q_entity_source_contract(program, q, args)) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    uint present = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PROPERTY_PRESENT], memory_order_relaxed);
    uint kinds = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PROPERTY_KINDS], memory_order_relaxed);
    uint maximum = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PROPERTY_MAX_STRING], memory_order_relaxed);
    bool exact = args.property_shape == 0u
        ? (present == 0u && kinds == 0u && maximum == 0u)
        : (args.property_shape == 1u
            ? (present != 0u && kinds == 1u && maximum == 0u)
            : (args.property_shape == 2u
                ? (present != 0u && kinds == 2u && maximum == 0u)
                : (args.property_shape == 3u
                    ? (present != 0u && kinds == 4u && maximum == 0u)
                    : (args.property_shape == 4u
                        ? (present != 0u && kinds == 8u
                            && maximum == args.maximum_string_bytes)
                        : (args.property_shape == 5u && present != 0u
                            && kinds != 0u && (kinds & (kinds - 1u)) != 0u
                            && maximum == args.maximum_string_bytes)))));
    if (!exact) ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_ADMISSION);
}

kernel void ig_quantifier_entity_begin_source(
    device const ulong* path_output [[buffer(0)]],
    device atomic_uint* control [[buffer(1)]],
    constant MetalQuantifierArgs& q [[buffer(2)]],
    constant MetalQuantifierEntityArgs& args [[buffer(3)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
                != IG_Q_ENTITY_STATUS_OK) return;
    ulong path_status = path_output[1];
    uint status = uint(path_status);
    uint phase = uint(path_status >> 32u);
    // The quantifier source is compiled as an isolated Metal library. Its loader injects the
    // current sealed variable-path ABI word from the Rust producer contract so this consumer
    // cannot retain an older mirrored version when that packet evolves.
    if (path_output[0] != IG_QUANTIFIER_VARIABLE_PATH_ABI
            || status != 1u || phase != 3u
            || path_output[16] != ulong(args.path_receipt_count)
            || path_output[17] != 2ul || path_output[18] != 2ul
            || path_output[19] != 0ul) {
        ig_q_entity_fail(
            control,
            status == 3u || status == 4u
                ? IG_Q_ENTITY_STATUS_BUDGET
                : (status == 6u ? IG_Q_ENTITY_STATUS_ADMISSION
                    : IG_Q_ENTITY_STATUS_CORRUPT));
        return;
    }
    uint path_count = uint(path_output[13]);
    if (path_count > args.path_capacity
            || ulong(path_count) > q.max_rows
            || path_output[14] != ulong(args.path_capacity)
            || path_output[15] != ulong(args.edge_slots)) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    atomic_store_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], path_count, memory_order_relaxed);
}

kernel void ig_quantifier_entity_materialize_source(
    device const ulong* path_output [[buffer(0)]],
    device ulong* output [[buffer(1)]],
    device atomic_uint* control [[buffer(2)]],
    device atomic_uint* node_dependencies [[buffer(3)]],
    device atomic_uint* edge_dependencies [[buffer(4)]],
    device atomic_uint* property_dependencies [[buffer(5)]],
    constant MetalQuantifierArgs& q [[buffer(6)]],
    constant MetalQuantifierEntityArgs& args [[buffer(7)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    if (path >= path_count) return;
    ulong input_descriptor = ig_q_entity_path_descriptor_base(args) + ulong(path) * 3ul;
    uint start = uint(path_output[input_descriptor]);
    uint end = uint(path_output[input_descriptor + 1ul]);
    uint length = uint(path_output[input_descriptor + 2ul]);
    if (length > args.edge_slots || start >= args.node_rows || end >= args.node_rows) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    ulong descriptor = args.path_descriptor_base + ulong(path) * 3ul;
    output[descriptor] = ulong(start);
    output[descriptor + 1ul] = ulong(end);
    output[descriptor + 2ul] = ulong(length);
    ulong input_edges = ig_q_entity_path_edge_input_base(args)
        + ulong(path) * ulong(args.edge_slots);
    ulong input_nodes = ig_q_entity_path_node_input_base(args)
        + ulong(path) * ulong(args.edge_slots + 1u);
    ulong input_segments = ig_q_entity_path_segment_input_base(args)
        + ulong(path) * ulong(args.segment_count);
    ulong output_edges = args.path_edge_base + ulong(path) * ulong(args.edge_slots);
    ulong output_nodes = args.path_node_base + ulong(path) * ulong(args.edge_slots + 1u);
    ulong output_segments = args.path_segment_base
        + ulong(path) * ulong(args.segment_count);
    for (uint node = 0u; node <= length; ++node) {
        uint dense = uint(path_output[input_nodes + ulong(node)]);
        if (dense >= args.node_rows) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        output[output_nodes + ulong(node)] = ulong(dense);
        atomic_store_explicit(&node_dependencies[dense], 1u, memory_order_relaxed);
    }
    for (uint hop = 0u; hop < length; ++hop) {
        uint dense = uint(path_output[input_edges + ulong(hop)]);
        if (dense >= args.edge_rows) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        output[output_edges + ulong(hop)] = ulong(dense);
        atomic_store_explicit(&edge_dependencies[dense], 1u, memory_order_relaxed);
    }
    uint preceding = 0u;
    for (uint segment = 0u; segment < args.segment_count; ++segment) {
        uint boundary = uint(path_output[input_segments + ulong(segment)]);
        if (boundary < preceding || boundary > length) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        output[output_segments + ulong(segment)] = ulong(boundary);
        preceding = boundary;
    }
    if (preceding != length) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
        return;
    }
    if (args.property_id != 0xfffffffffffffffful) {
        uint items = ig_q_entity_list_length(path_output, path, args);
        if (items > args.maximum_items) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_BUDGET);
            return;
        }
        for (uint item = 0u; item < items; ++item) {
            uint dense = ig_q_entity_list_item(path_output, path, item, args);
            if (dense >= args.entity_rows) {
                ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
                return;
            }
            atomic_store_explicit(&property_dependencies[dense], 1u, memory_order_relaxed);
        }
    }
    (void)q;
}

kernel void ig_quantifier_entity_group_hash(
    device const ulong* path_output [[buffer(0)]],
    device const atomic_uint* control [[buffer(1)]],
    device ulong* hashes [[buffer(2)]],
    constant MetalQuantifierEntityArgs& args [[buffer(3)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    if (path >= path_count) return;
    ulong hash = ig_q_mix(ulong(args.entity_kind) ^ ulong(ig_q_entity_list_length(
        path_output, path, args)));
    uint items = ig_q_entity_list_length(path_output, path, args);
    for (uint item = 0u; item < items; ++item) {
        hash = ig_q_mix(hash ^ (ulong(ig_q_entity_list_item(
            path_output, path, item, args)) + 0x9e3779b97f4a7c15ul * ulong(item + 1u)));
    }
    hashes[path] = hash;
}

kernel void ig_quantifier_entity_group_insert(
    device const ulong* path_output [[buffer(0)]],
    device atomic_uint* control [[buffer(1)]],
    device const ulong* hashes [[buffer(2)]],
    device atomic_uint* table [[buffer(3)]],
    constant MetalQuantifierEntityArgs& args [[buffer(4)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    if (path >= path_count) return;
    uint mask = args.group_table_capacity - 1u;
    uint slot = uint(hashes[path]) & mask;
    for (uint probe = 0u; probe < args.group_table_capacity; ++probe) {
        uint entry = atomic_load_explicit(&table[slot], memory_order_relaxed);
        while (entry == 0u) {
            uint expected = 0u;
            if (atomic_compare_exchange_weak_explicit(
                    &table[slot], &expected, path + 1u,
                    memory_order_relaxed, memory_order_relaxed)) return;
            entry = expected;
        }
        uint representative = entry - 1u;
        if (representative >= path_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        if (hashes[representative] == hashes[path]
                && ig_q_entity_lists_equal(
                    path_output, representative, path, args)) {
            atomic_fetch_min_explicit(
                &table[slot], path + 1u, memory_order_relaxed);
            return;
        }
        slot = (slot + 1u) & mask;
    }
    ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_BUDGET);
}

kernel void ig_quantifier_entity_group_mark(
    device const ulong* path_output [[buffer(0)]],
    device atomic_uint* control [[buffer(1)]],
    device const ulong* hashes [[buffer(2)]],
    device const atomic_uint* table [[buffer(3)]],
    device uint* group_flags [[buffer(4)]],
    device atomic_uint* group_counts [[buffer(5)]],
    constant MetalQuantifierEntityArgs& args [[buffer(6)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    if (path >= path_count) return;
    if (args.group_enabled == 0u) {
        group_flags[path] = 1u;
        atomic_store_explicit(&group_counts[path], 1u, memory_order_relaxed);
        return;
    }
    uint mask = args.group_table_capacity - 1u;
    uint slot = uint(hashes[path]) & mask;
    for (uint probe = 0u; probe < args.group_table_capacity; ++probe) {
        uint entry = atomic_load_explicit(&table[slot], memory_order_relaxed);
        if (entry == 0u) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        uint representative = entry - 1u;
        if (representative >= path_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        if (hashes[representative] == hashes[path]
                && ig_q_entity_lists_equal(
                    path_output, representative, path, args)) {
            group_flags[path] = uint(path == representative);
            atomic_fetch_add_explicit(
                &group_counts[representative], 1u, memory_order_relaxed);
            return;
        }
        slot = (slot + 1u) & mask;
    }
    ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
}

kernel void ig_quantifier_entity_group_prefix_initialize(
    device const uint* group_flags [[buffer(0)]],
    device uint* group_ranks [[buffer(1)]],
    device const atomic_uint* control [[buffer(2)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    if (path < path_count) group_ranks[path] = group_flags[path];
}

struct IgQuantifierEntityScanStep {
    uint stride;
};

kernel void ig_quantifier_entity_group_prefix_step(
    device const uint* input [[buffer(0)]],
    device uint* output [[buffer(1)]],
    device const atomic_uint* control [[buffer(2)]],
    constant IgQuantifierEntityScanStep& step [[buffer(3)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    if (path < path_count) {
        output[path] = input[path] + (path >= step.stride ? input[path - step.stride] : 0u);
    }
}

kernel void ig_quantifier_entity_group_prefix_finalize(
    device const uint* group_ranks [[buffer(0)]],
    device atomic_uint* control [[buffer(1)]],
    constant MetalQuantifierArgs& q [[buffer(2)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
                != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    uint groups = path_count == 0u ? 0u : group_ranks[path_count - 1u];
    if (ulong(groups) > q.final_row_bound) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_BUDGET);
        return;
    }
    atomic_store_explicit(
        &control[IG_Q_ENTITY_CONTROL_FINAL_COUNT], groups, memory_order_relaxed);
}

kernel void ig_quantifier_entity_group_scatter(
    device const uint* group_flags [[buffer(0)]],
    device const uint* group_ranks [[buffer(1)]],
    device uint* final_paths [[buffer(2)]],
    device const atomic_uint* control [[buffer(3)]],
    uint path [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    if (path < path_count && group_flags[path] != 0u) {
        final_paths[group_ranks[path] - 1u] = path;
    }
}

inline int ig_q_entity_lists_order(
    device const ulong* path_output,
    uint left,
    uint right,
    constant MetalQuantifierEntityArgs& args) {
    uint left_count = ig_q_entity_list_length(path_output, left, args);
    uint right_count = ig_q_entity_list_length(path_output, right, args);
    uint common = min(left_count, right_count);
    for (uint item = 0u; item < common; ++item) {
        uint left_entity = ig_q_entity_list_item(path_output, left, item, args);
        uint right_entity = ig_q_entity_list_item(path_output, right, item, args);
        if (left_entity < right_entity) return -1;
        if (left_entity > right_entity) return 1;
    }
    if (left_count < right_count) return -1;
    if (left_count > right_count) return 1;
    return left < right ? -1 : (left > right ? 1 : 0);
}

struct IgQuantifierEntitySortStep {
    uint level;
    uint stride;
};

kernel void ig_quantifier_entity_group_sort(
    device uint* final_paths [[buffer(0)]],
    device const ulong* path_output [[buffer(1)]],
    device const atomic_uint* control [[buffer(2)]],
    constant MetalQuantifierEntityArgs& args [[buffer(3)]],
    constant IgQuantifierEntitySortStep& step [[buffer(4)]],
    uint index [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK || index >= args.group_sort_capacity) return;
    uint partner = index ^ step.stride;
    if (partner <= index || partner >= args.group_sort_capacity) return;
    uint left = final_paths[index];
    uint right = final_paths[partner];
    int order = left == 0xffffffffu
        ? (right == 0xffffffffu ? 0 : 1)
        : (right == 0xffffffffu ? -1
            : ig_q_entity_lists_order(path_output, left, right, args));
    bool ascending = (index & step.level) == 0u;
    if ((ascending && order > 0) || (!ascending && order < 0)) {
        final_paths[index] = right;
        final_paths[partner] = left;
    }
}

struct IgQuantifierEntityScalar {
    uint tag;
    ulong bits;
    uint offset;
    uint length;
};

inline IgQuantifierEntityScalar ig_q_entity_property_scalar(
    uint row,
    device const uchar* property_u8,
    device const long* property_i64,
    device const uint* property_u32,
    device const uchar* validity,
    device const uint* offsets,
    device const uchar* bytes,
    constant MetalQuantifierEntityArgs& args) {
    IgQuantifierEntityScalar value { 0u, 0ul, 0u, 0u };
    if (args.property_storage_shape == 0u || validity[row] == 0u) return value;
    if (args.property_storage_shape == 1u) {
        value.tag = 1u;
        value.bits = ulong(property_u8[row]);
    } else if (args.property_storage_shape == 2u) {
        value.tag = 2u;
        value.bits = as_type<ulong>(property_i64[row]);
    } else if (args.property_storage_shape == 3u) {
        value.tag = 3u;
        value.bits = as_type<ulong>(property_i64[row]);
    } else if (args.property_storage_shape == 4u) {
        uint id = property_u32[row];
        value.tag = 4u;
        value.offset = offsets[id];
        value.length = offsets[id + 1u] - value.offset;
    } else {
        uint begin = offsets[row];
        uint end = offsets[row + 1u];
        uchar tag = bytes[begin];
        value.tag = uint(tag);
        if (tag == 1u) value.bits = ulong(bytes[begin + 1u]);
        else if (tag == 2u || tag == 3u) {
            value.bits = ig_q_entity_load_u64_le(bytes, ulong(begin + 1u));
        } else {
            value.offset = begin + 1u;
            value.length = end - begin - 1u;
        }
    }
    return value;
}

inline int ig_q_entity_string_order(
    device const uchar* property_bytes,
    IgQuantifierEntityScalar property,
    device const ulong* program,
    device const ulong* scratch,
    constant MetalQuantifierArgs& q,
    device const ulong* literal) {
    uint width = min(property.length, uint(literal[2]));
    for (uint index = 0u; index < width; ++index) {
        uchar left = property_bytes[ulong(property.offset) + ulong(index)];
        uchar right = ig_q_byte(program, scratch, q, literal, ulong(index));
        if (left < right) return -1;
        if (left > right) return 1;
    }
    return property.length < literal[2] ? -1 : (ulong(property.length) > literal[2] ? 1 : 0);
}

inline long ig_q_entity_compare_property(
    uint row,
    ulong operation,
    bool reversed,
    ulong literal_handle,
    device const ulong* program,
    device ulong* scratch,
    device const uchar* property_u8,
    device const long* property_i64,
    device const uint* property_u32,
    device const uchar* validity,
    device const uint* offsets,
    device const uchar* bytes,
    constant MetalQuantifierArgs& q,
    constant MetalQuantifierEntityArgs& args) {
    IgQuantifierEntityScalar property = ig_q_entity_property_scalar(
        row, property_u8, property_i64, property_u32, validity, offsets, bytes, args);
    device const ulong* literal = ig_q_cell(program, scratch, q, literal_handle);
    if (property.tag == 0u || literal[0] == IG_Q_TAG_NULL) return -1L;
    bool equal = false;
    bool comparable = true;
    int order = 0;
    if ((property.tag == 2u || property.tag == 3u)
            && (literal[0] == IG_Q_TAG_INTEGER || literal[0] == IG_Q_TAG_FLOAT)) {
        if (property.tag == 2u && literal[0] == IG_Q_TAG_INTEGER) {
            long left = as_type<long>(property.bits);
            long right = as_type<long>(literal[1]);
            order = left < right ? -1 : (left > right ? 1 : 0);
            equal = left == right;
        } else {
            ulong left = property.tag == 2u
                ? ig_q_i64_to_f64(property.bits) : property.bits;
            ulong right = literal[0] == IG_Q_TAG_INTEGER
                ? ig_q_i64_to_f64(literal[1]) : literal[1];
            bool nan = ig_q_float_nan(left) || ig_q_float_nan(right);
            order = ig_q_float_compare(left, right);
            equal = !nan && order == 0;
        }
    } else if (property.tag == 1u && literal[0] == IG_Q_TAG_BOOLEAN) {
        order = property.bits < literal[1] ? -1 : (property.bits > literal[1] ? 1 : 0);
        equal = property.bits == literal[1];
    } else if (property.tag == 4u && literal[0] == IG_Q_TAG_STRING) {
        order = ig_q_entity_string_order(bytes, property, program, scratch, q, literal);
        equal = order == 0;
    } else {
        comparable = false;
    }
    if (operation == 4ul || operation == 5ul) {
        bool result = operation == 4ul ? equal : !equal;
        return result ? 1L : 0L;
    }
    if (!comparable) return -1L;
    if (reversed) order = -order;
    bool result = operation == 6ul ? order < 0
        : (operation == 7ul ? order <= 0
            : (operation == 8ul ? order > 0 : order >= 0));
    return result ? 1L : 0L;
}

kernel void ig_quantifier_entity_project(
    device const ulong* program [[buffer(0)]],
    device const ulong* path_output [[buffer(1)]],
    device ulong* scratch [[buffer(2)]],
    device const uint* final_paths [[buffer(3)]],
    device atomic_uint* control [[buffer(4)]],
    device const atomic_uint* group_counts [[buffer(5)]],
    device const uchar* property_u8 [[buffer(6)]],
    device const long* property_i64 [[buffer(7)]],
    device const uint* property_u32 [[buffer(8)]],
    device const uchar* validity [[buffer(9)]],
    device const uint* offsets [[buffer(10)]],
    device const uchar* bytes [[buffer(11)]],
    constant MetalQuantifierArgs& q [[buffer(12)]],
    constant MetalQuantifierEntityArgs& args [[buffer(13)]],
    uint row [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint row_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_FINAL_COUNT], memory_order_relaxed);
    if (row >= row_count) return;
    uint path = final_paths[row];
    uint item_count = ig_q_entity_list_length(path_output, path, args);
    if (item_count > args.maximum_items) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_BUDGET);
        return;
    }
    for (uint binding = 0u; binding < args.binding_count; ++binding) {
        device const ulong* descriptor = program
            + args.binding_base + ulong(binding) * 8ul;
        uint output_slot = uint(descriptor[0]);
        if (output_slot >= q.slot_count || descriptor[2] >= q.slot_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        ulong mode = descriptor[1];
        ulong value = IG_Q_ENTITY_LIST_HANDLE | ulong(path);
        if (mode == 2ul) {
            if (args.group_enabled == 0u) {
                ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
                return;
            }
            value = ulong(atomic_load_explicit(
                &group_counts[path], memory_order_relaxed));
        } else if (mode == 1ul) {
            if (descriptor[4] != 0ul || descriptor[3] < 1ul || descriptor[3] > 4ul
                    || descriptor[5] < 4ul || descriptor[5] > 9ul) {
                ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
                return;
            }
            uint true_count = 0u;
            uint false_count = 0u;
            bool unknown = false;
            for (uint item = 0u; item < item_count; ++item) {
                uint dense = ig_q_entity_list_item(path_output, path, item, args);
                if (dense >= args.entity_rows) {
                    ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
                    return;
                }
                long predicate = ig_q_entity_compare_property(
                    dense, descriptor[5], descriptor[7] != 0ul, descriptor[6],
                    program, scratch, property_u8, property_i64, property_u32,
                    validity, offsets, bytes, q, args);
                if (predicate < 0L) unknown = true;
                else if (predicate == 0L) ++false_count;
                else ++true_count;
            }
            long reduced = descriptor[3] == 1ul
                ? (false_count != 0u ? 0L : (unknown ? -1L : 1L))
                : (descriptor[3] == 2ul
                    ? (true_count != 0u ? 1L : (unknown ? -1L : 0L))
                    : (descriptor[3] == 3ul
                        ? (true_count != 0u ? 0L : (unknown ? -1L : 1L))
                        : (true_count > 1u ? 0L
                            : (unknown ? -1L : long(true_count == 1u)))));
            value = reduced < 0L ? 0ul : ulong(reduced + 1L);
        } else if (mode != 0ul) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        scratch[q.row_a_base + ulong(row) * q.slot_count + ulong(output_slot)] = value;
    }
}

kernel void ig_quantifier_entity_dependency_counts(
    device const atomic_uint* node_dependencies [[buffer(0)]],
    device const atomic_uint* edge_dependencies [[buffer(1)]],
    device const atomic_uint* property_dependencies [[buffer(2)]],
    device uint* counts [[buffer(3)]],
    device const atomic_uint* control [[buffer(4)]],
    constant MetalQuantifierEntityArgs& args [[buffer(5)]],
    uint entity [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint total = args.dependency_rows;
    if (entity >= total) return;
    bool node = entity < args.node_rows;
    uint dense = node ? entity : entity - args.node_rows;
    uint identity = atomic_load_explicit(
        node ? &node_dependencies[dense] : &edge_dependencies[dense], memory_order_relaxed);
    uint property = args.property_id == 0xfffffffffffffffful
        || (node ? args.entity_kind != 1u : args.entity_kind != 2u)
        ? 0u
        : atomic_load_explicit(&property_dependencies[dense], memory_order_relaxed);
    counts[entity] = uint(identity != 0u) + uint(property != 0u);
}

kernel void ig_quantifier_entity_dependency_prefix_step(
    device const uint* input [[buffer(0)]],
    device uint* output [[buffer(1)]],
    device const atomic_uint* control [[buffer(2)]],
    constant MetalQuantifierEntityArgs& args [[buffer(3)]],
    constant IgQuantifierEntityScanStep& step [[buffer(4)]],
    uint entity [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint total = args.dependency_rows;
    if (entity < total) {
        output[entity] = input[entity]
            + (entity >= step.stride ? input[entity - step.stride] : 0u);
    }
}

kernel void ig_quantifier_entity_dependency_prefix_finalize(
    device const uint* prefix [[buffer(0)]],
    device atomic_uint* control [[buffer(1)]],
    constant MetalQuantifierEntityArgs& args [[buffer(2)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u
            || atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
                != IG_Q_ENTITY_STATUS_OK) return;
    uint total = args.dependency_rows;
    uint written = total == 0u ? 0u : prefix[total - 1u];
    if (written > args.dependency_capacity) {
        ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_BUDGET);
        return;
    }
    atomic_store_explicit(
        &control[IG_Q_ENTITY_CONTROL_DEPENDENCY_COUNT], written, memory_order_relaxed);
}

kernel void ig_quantifier_entity_dependency_scatter(
    device const atomic_uint* node_dependencies [[buffer(0)]],
    device const atomic_uint* edge_dependencies [[buffer(1)]],
    device const atomic_uint* property_dependencies [[buffer(2)]],
    device const uint* prefix [[buffer(3)]],
    device ulong* output [[buffer(4)]],
    device const atomic_uint* control [[buffer(5)]],
    constant MetalQuantifierEntityArgs& args [[buffer(6)]],
    uint entity [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint total = args.dependency_rows;
    if (entity >= total) return;
    bool node = entity < args.node_rows;
    uint dense = node ? entity : entity - args.node_rows;
    bool identity = atomic_load_explicit(
        node ? &node_dependencies[dense] : &edge_dependencies[dense], memory_order_relaxed) != 0u;
    bool property = args.property_id != 0xfffffffffffffffful
        && (node ? args.entity_kind == 1u : args.entity_kind == 2u)
        && atomic_load_explicit(&property_dependencies[dense], memory_order_relaxed) != 0u;
    uint write = (entity == 0u ? 0u : prefix[entity - 1u]);
    if (identity) {
        ulong base = args.dependency_base + ulong(write++) * 4ul;
        output[base] = node ? 1ul : 2ul;
        output[base + 1ul] = ulong(dense);
        output[base + 2ul] = 0ul;
        output[base + 3ul] = 0xfffffffffffffffful;
    }
    if (property) {
        ulong base = args.dependency_base + ulong(write) * 4ul;
        output[base] = node ? 1ul : 2ul;
        output[base + 1ul] = ulong(dense);
        output[base + 2ul] = 1ul;
        output[base + 3ul] = args.property_id;
    }
}

inline uint ig_q_entity_binding_mode(
    device const ulong* program,
    ulong output_slot,
    constant MetalQuantifierEntityArgs& args) {
    for (uint binding = 0u; binding < args.binding_count; ++binding) {
        device const ulong* descriptor = program
            + args.binding_base + ulong(binding) * 8ul;
        if (descriptor[0] == output_slot) return uint(descriptor[1]);
    }
    return 0xffffffffu;
}

inline bool ig_q_entity_binding_is_list(
    device const ulong* program,
    ulong output_slot,
    constant MetalQuantifierEntityArgs& args) {
    return ig_q_entity_binding_mode(program, output_slot, args) == 0u;
}

kernel void ig_quantifier_entity_publish_rows(
    device const ulong* program [[buffer(0)]],
    device const ulong* path_output [[buffer(1)]],
    device const ulong* scratch [[buffer(2)]],
    device const uint* final_paths [[buffer(3)]],
    device ulong* output [[buffer(4)]],
    device atomic_uint* control [[buffer(5)]],
    constant MetalQuantifierArgs& q [[buffer(6)]],
    constant MetalQuantifierEntityArgs& args [[buffer(7)]],
    uint row [[thread_position_in_grid]]) {
    if (atomic_load_explicit(&control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed)
            != IG_Q_ENTITY_STATUS_OK) return;
    uint row_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_FINAL_COUNT], memory_order_relaxed);
    if (row >= row_count) return;
    uint entity_columns = 0u;
    for (ulong column = 0ul; column < q.output_count; ++column) {
        ulong output_slot = program[q.output_source_base + column];
        entity_columns += uint(ig_q_entity_binding_is_list(program, output_slot, args));
    }
    uint entity_ordinal = 0u;
    uint path = final_paths[row];
    for (ulong column = 0ul; column < q.output_count; ++column) {
        ulong root = ulong(row) * q.output_count + column;
        if (root >= q.root_capacity || root >= q.output_cell_capacity) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_BUDGET);
            return;
        }
        ulong output_slot = program[q.output_source_base + column];
        if (output_slot >= q.slot_count) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        ulong value = scratch[q.row_a_base + ulong(row) * q.slot_count + output_slot];
        uint mode = ig_q_entity_binding_mode(program, output_slot, args);
        if (mode > 2u) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
        output[q.root_base + root] = root;
        ulong cell = q.output_cell_base + root * IG_Q_VALUE_WORDS;
        output[cell] = 0ul;
        output[cell + 1ul] = 0ul;
        output[cell + 2ul] = 0ul;
        output[cell + 3ul] = 2ul;
        if (mode == 0u) {
            if ((value & IG_Q_ENTITY_LIST_HANDLE) == 0ul
                    || uint(value & ~IG_Q_ENTITY_LIST_HANDLE) != path) {
                ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
                return;
            }
            uint descriptor_index = row * entity_columns + entity_ordinal++;
            uint item_count = ig_q_entity_list_length(path_output, path, args);
            ulong item_offset = ulong(descriptor_index) * ulong(args.maximum_items);
            if (descriptor_index >= args.entity_output_capacity
                    || item_offset + ulong(item_count) > ulong(args.entity_item_capacity)) {
                ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_BUDGET);
                return;
            }
            ulong descriptor = args.entity_descriptor_base
                + ulong(descriptor_index) * 4ul;
            output[descriptor] = ulong(row);
            output[descriptor + 1ul] = column;
            output[descriptor + 2ul] = item_offset;
            output[descriptor + 3ul] = ulong(item_count);
            for (uint item = 0u; item < item_count; ++item) {
                ulong destination = args.entity_item_base
                    + (item_offset + ulong(item)) * 2ul;
                output[destination] = ulong(args.entity_kind);
                output[destination + 1ul] = ulong(
                    ig_q_entity_list_item(path_output, path, item, args));
            }
        } else if (mode == 1u && (value == 1ul || value == 2ul)) {
            output[cell] = IG_Q_TAG_BOOLEAN;
            output[cell + 1ul] = value - 1ul;
        } else if (mode == 2u) {
            output[cell] = IG_Q_TAG_INTEGER;
            output[cell + 1ul] = value;
        } else if (value != 0ul) {
            ig_q_entity_fail(control, IG_Q_ENTITY_STATUS_CORRUPT);
            return;
        }
    }
}

kernel void ig_quantifier_entity_finalize(
    device const ulong* program [[buffer(0)]],
    device const ulong* path_output [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    device atomic_uint* control [[buffer(3)]],
    constant MetalQuantifierArgs& q [[buffer(4)]],
    constant MetalQuantifierEntityArgs& args [[buffer(5)]],
    uint tid [[thread_position_in_grid]]) {
    if (tid != 0u) return;
    uint status = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_STATUS], memory_order_relaxed);
    uint path_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_PATH_COUNT], memory_order_relaxed);
    uint row_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_FINAL_COUNT], memory_order_relaxed);
    uint dependency_count = atomic_load_explicit(
        &control[IG_Q_ENTITY_CONTROL_DEPENDENCY_COUNT], memory_order_relaxed);
    uint entity_columns = 0u;
    for (ulong column = 0ul; column < q.output_count; ++column) {
        entity_columns += uint(ig_q_entity_binding_is_list(
            program, program[q.output_source_base + column], args));
    }
    ulong entity_output_count = ulong(row_count) * ulong(entity_columns);
    if (!ig_q_entity_source_contract(program, q, args)
            || entity_output_count > ulong(args.entity_output_capacity)
            || dependency_count > args.dependency_capacity
            || (args.group_enabled != 0u ? q.stage_count != 2ul : q.stage_count != 1ul)) {
        status = IG_Q_ENTITY_STATUS_CORRUPT;
    }
    output[0] = IG_Q_OUTPUT_MAGIC;
    output[1] = ulong(status);
    output[2] = q.project_high;
    output[3] = q.project_low;
    output[4] = q.bookmark_term;
    output[5] = q.bookmark_index;
    output[6] = q.graph_revision;
    output[7] = q.layout_version;
    output[8] = q.catalog_0;
    output[9] = q.catalog_1;
    output[10] = q.catalog_2;
    output[11] = q.catalog_3;
    output[12] = q.execution_high;
    output[13] = q.execution_low;
    output[14] = q.fingerprint_0;
    output[15] = q.fingerprint_1;
    output[16] = q.fingerprint_2;
    output[17] = q.fingerprint_3;
    output[18] = status == IG_Q_ENTITY_STATUS_OK ? ulong(row_count) : 0ul;
    output[19] = q.output_count;
    output[20] = q.receipt_count;
    output[21] = 2ul;
    output[22] = q.scratch_words;
    output[23] = q.program_words;
    output[24] = q.output_words;
    output[25] = status == IG_Q_ENTITY_STATUS_OK
        ? ulong(row_count) * q.output_count : 0ul;
    output[26] = output[25];
    output[27] = 0ul;
    output[28] = 0ul;
    output[29] = q.output_cell_capacity;
    output[30] = q.output_item_capacity;
    output[31] = q.output_byte_capacity;

    if (status == IG_Q_ENTITY_STATUS_OK) {
        uint receipt = 0u;
        for (; receipt < args.path_receipt_count; ++receipt) {
            ulong base = IG_QUANTIFIER_VARIABLE_PATH_OUTPUT_HEADER_WORDS
                + ulong(receipt) * IG_QUANTIFIER_VARIABLE_PATH_RECEIPT_WORDS;
            ig_q_write_receipt(
                program, output, q, ulong(receipt), path_output[base + 4ul], path_output[base + 5ul]);
        }
        ig_q_write_receipt(program, output, q, ulong(receipt++), path_count, path_count);
        ig_q_write_receipt(
            program, output, q, ulong(receipt++), path_count, dependency_count);
        if (args.group_enabled != 0u) {
            ig_q_write_receipt(program, output, q, ulong(receipt++), path_count, row_count);
        }
        ig_q_write_receipt(program, output, q, ulong(receipt++), row_count, row_count);
        ig_q_write_receipt(program, output, q, ulong(receipt), row_count, row_count);
    }

    ulong base = args.entity_output_base;
    output[base] = IG_Q_ENTITY_OUTPUT_MAGIC;
    output[base + 1ul] = status == IG_Q_ENTITY_STATUS_OK ? 0x5345414c45445155ul : ulong(status);
    output[base + 2ul] = status == IG_Q_ENTITY_STATUS_OK ? ulong(path_count) : 0ul;
    output[base + 3ul] = status == IG_Q_ENTITY_STATUS_OK ? entity_output_count : 0ul;
    output[base + 4ul] = status == IG_Q_ENTITY_STATUS_OK ? ulong(dependency_count) : 0ul;
    output[base + 5ul] = args.path_descriptor_base;
    output[base + 6ul] = args.path_edge_base;
    output[base + 7ul] = args.path_node_base;
    output[base + 8ul] = args.entity_descriptor_base;
    output[base + 9ul] = args.entity_item_base;
    output[base + 10ul] = args.dependency_base;
    output[base + 11ul] = status == IG_Q_ENTITY_STATUS_OK
        ? entity_output_count * ulong(args.maximum_items) : 0ul;
    output[base + 12ul] = ulong(args.path_capacity);
    output[base + 13ul] = ulong(args.edge_slots);
    output[base + 14ul] = ulong(args.entity_kind);
    output[base + 15ul] = ulong(args.maximum_items);
    output[base + 16ul] = args.path_segment_base;
    output[base + 17ul] = ulong(args.segment_count);
}

[[clang::noinline]] bool ig_q_initialize_program(
    device const ulong* program,
    device ulong* scratch,
    device ulong* output,
    constant MetalQuantifierArgs& args) {
    output[0] = IG_Q_OUTPUT_MAGIC;
    output[1] = IG_Q_STATUS_CORRUPT;
    output[2] = args.project_high;
    output[3] = args.project_low;
    output[4] = args.bookmark_term;
    output[5] = args.bookmark_index;
    output[6] = args.graph_revision;
    output[7] = args.layout_version;
    output[8] = args.catalog_0;
    output[9] = args.catalog_1;
    output[10] = args.catalog_2;
    output[11] = args.catalog_3;
    output[12] = args.execution_high;
    output[13] = args.execution_low;
    output[14] = args.fingerprint_0;
    output[15] = args.fingerprint_1;
    output[16] = args.fingerprint_2;
    output[17] = args.fingerprint_3;
    output[19] = args.output_count;
    output[20] = args.receipt_count;
    output[21] = 2ul;
    output[22] = args.scratch_words;
    output[23] = args.program_words;
    output[24] = args.output_words;
    output[29] = args.output_cell_capacity;
    output[30] = args.output_item_capacity;
    output[31] = args.output_byte_capacity;

    if (args.scratch_words == 0ul || args.output_words < IG_Q_HEADER_WORDS
            || args.slot_count == 0ul || args.max_rows == 0ul
            || args.dynamic_cell_capacity == 0ul || args.dynamic_item_capacity == 0ul
            || args.dynamic_byte_capacity == 0ul || args.output_cell_capacity == 0ul
            || args.output_item_capacity == 0ul || args.output_byte_capacity == 0ul
            || !ig_q_program_contract(program, args)) return false;

    ulong slot_cells = args.max_rows * args.slot_count;
    ulong expected_row_b = args.row_a_base + slot_cells;
    ulong expected_lineage_a = expected_row_b + slot_cells;
    ulong expected_lineage_b = expected_lineage_a + args.max_rows;
    ulong expected_dynamic_cells = expected_lineage_b + args.max_rows;
    ulong expected_dynamic_items = expected_dynamic_cells
        + args.dynamic_cell_capacity * IG_Q_VALUE_WORDS;
    ulong expected_dynamic_bytes = expected_dynamic_items + args.dynamic_item_capacity;
    ulong expected_frames = expected_dynamic_bytes
        + (args.dynamic_byte_capacity + 7ul) / 8ul;
    ulong expected_compare = expected_frames
        + args.eval_lane_count * args.frame_capacity * IG_Q_FRAME_WORDS;
    ulong expected_filter_flags = expected_compare
        + args.frame_capacity * IG_Q_COMPARE_FRAME_WORDS;
    ulong expected_filter_ranks = expected_filter_flags + args.eval_lane_count;
    ulong expected_control = expected_filter_ranks + args.eval_lane_count;
    ulong expected_scratch = expected_control + 64ul;
    ulong expected_root = IG_Q_HEADER_WORDS + args.receipt_count * IG_Q_RECEIPT_WORDS;
    ulong expected_output_cells = expected_root + args.root_capacity;
    ulong expected_output_items = expected_output_cells
        + args.output_cell_capacity * IG_Q_VALUE_WORDS;
    ulong expected_output_bytes = expected_output_items + args.output_item_capacity;
    ulong expected_output_words = expected_output_bytes
        + (args.output_byte_capacity + 7ul) / 8ul;
    if (args.row_a_base != 0ul || args.row_b_base != expected_row_b
            || args.lineage_a_base != expected_lineage_a
            || args.lineage_b_base != expected_lineage_b
            || args.dynamic_cell_base != expected_dynamic_cells
            || args.dynamic_item_base != expected_dynamic_items
            || args.dynamic_byte_base != expected_dynamic_bytes
            || args.eval_frame_base != expected_frames
            || args.compare_frame_base != expected_compare
            || args.filter_flag_base != expected_filter_flags
            || args.filter_rank_base != expected_filter_ranks
            || args.control_base != expected_control
            || args.scratch_words != expected_scratch
            || args.receipt_base != IG_Q_HEADER_WORDS
            || args.root_base != expected_root
            || args.output_cell_base != expected_output_cells
            || args.output_item_base != expected_output_items
            || args.output_byte_base != expected_output_bytes
            || args.output_words != expected_output_words
            || args.root_capacity != args.final_row_bound * args.output_count) return false;

    device atomic_uint* control = reinterpret_cast<device atomic_uint*>(
        scratch + args.control_base);
    atomic_store_explicit(control, uint(IG_Q_STATUS_OK), memory_order_relaxed);
    atomic_store_explicit(
        control + 2u,
        args.source_kind == 1ul ? uint(args.source_row_bound) : 0u,
        memory_order_relaxed);
    atomic_store_explicit(control + 4u, 0u, memory_order_relaxed);
    atomic_store_explicit(control + 6u, 0u, memory_order_relaxed);
    scratch[args.control_base + 4ul] = args.source_kind == 0ul ? 1ul : 0ul;
    if (args.source_kind == 0ul) {
        scratch[args.lineage_a_base] = ig_q_mix(args.random_seed ^ args.execution_low);
    }
    return true;
}

kernel void ig_quantifier_clear(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)program;
    ulong index = ulong(thread_index);
    ulong slot_cells = args.max_rows * args.slot_count;
    if (index < args.scratch_words) {
        scratch[index] = index < slot_cells * 2ul ? IG_Q_INVALID : 0ul;
    }
    if (index < args.output_words) output[index] = 0ul;
}

kernel void ig_quantifier_initialize(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    ig_q_initialize_program(program, scratch, output, args);
}

kernel void ig_quantifier_range_source(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
    if (args.source_kind != 1ul || args.source_receipt_count != 1ul
            || args.source_output_slot >= args.slot_count
            || args.source_row_bound != args.max_rows
            || args.source_row_bound > args.dynamic_cell_capacity) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (args.range_integer_mask != 7ul || args.range_step == 0ul) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return;
    }
    long start = as_type<long>(args.range_start);
    long end = as_type<long>(args.range_end);
    long step = as_type<long>(args.range_step);
    ulong count = 0ul;
    if (!((step > 0L && start > end) || (step < 0L && start < end))) {
        ulong distance = step > 0L
            ? args.range_end - args.range_start
            : args.range_start - args.range_end;
        ulong magnitude = step > 0L
            ? args.range_step : 0ul - args.range_step;
        ulong quotient = distance / magnitude;
        if (quotient >= args.source_row_bound) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
            return;
        }
        count = quotient + 1ul;
    }
    if (thread_index == 0u) {
        scratch[args.control_base + 4ul] = count;
        ig_q_write_receipt(program, output, args, 0ul, 1ul, count);
    }
    ulong row = ulong(thread_index);
    if (row >= count) return;
    ulong cell = args.dynamic_cell_base + row * IG_Q_VALUE_WORDS;
    scratch[cell] = IG_Q_TAG_INTEGER;
    scratch[cell + 1ul] = args.range_start + row * args.range_step;
    scratch[cell + 2ul] = 0ul;
    scratch[cell + 3ul] = 1ul;
    ig_q_set_row_slot(
        scratch, args, args.row_a_base, row, args.source_output_slot, row);
    scratch[args.lineage_a_base + row] = ig_q_context(
        ig_q_mix(args.random_seed ^ args.execution_low), 0ul, row);
}

kernel void ig_quantifier_project_parallel(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    device const ulong* stage = program
        + args.stage_base + step.stage_index * IG_Q_STAGE_WORDS;
    ulong data_base = stage[2];
    ulong binding_count = stage[3];
    if (stage[0] != 1ul || data_base > args.stage_data_count
            || binding_count > (args.stage_data_count - data_base) / 2ul) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (input_rows == 0ul) {
        if (thread_index == 0u) {
            ig_q_write_receipt(
                program, output, args,
                args.source_receipt_count + step.stage_index, 0ul, 0ul);
        }
        return;
    }
    ulong row = ulong(thread_index);
    if (row >= input_rows) return;
    ulong cell_base = ig_q_reserve_arena(
        scratch, args, 1ul, stage[5], args.dynamic_cell_capacity);
    ulong item_base = ig_q_reserve_arena(
        scratch, args, 2ul, stage[6], args.dynamic_item_capacity);
    ulong byte_base = ig_q_reserve_arena(
        scratch, args, 3ul, stage[7], args.dynamic_byte_capacity);
    if (cell_base == IG_Q_INVALID || item_base == IG_Q_INVALID
            || byte_base == IG_Q_INVALID) return;
    ulong lane_control = args.eval_frame_base
        + row * args.frame_capacity * IG_Q_FRAME_WORDS
        + (args.frame_capacity - 1ul) * IG_Q_FRAME_WORDS;
    scratch[lane_control + 1ul] = cell_base;
    scratch[lane_control + 2ul] = item_base;
    scratch[lane_control + 3ul] = byte_base;
    IgQAllocator allocator = {
        lane_control,
        cell_base + stage[5],
        item_base + stage[6],
        byte_base + stage[7],
    };
    if (stage[1] != 0ul) {
        ig_q_copy_row(scratch, args, step.current_base, row, step.next_base, row);
    } else {
        ig_q_clear_row(scratch, args, step.next_base, row);
    }
    scratch[step.next_lineage + row] = scratch[step.current_lineage + row];
    #pragma clang loop unroll(disable)
    for (ulong binding = 0ul; binding < binding_count; ++binding) {
        ulong slot = program[args.stage_data_base + data_base + binding * 2ul];
        ulong expression = program[
            args.stage_data_base + data_base + binding * 2ul + 1ul];
        if (slot >= args.slot_count) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            break;
        }
        ulong context = ig_q_context(
            scratch[step.current_lineage + row], step.stage_index, binding);
        ulong value = ig_q_evaluate_with_allocator(
            program, scratch, args, allocator,
            expression, step.current_base, row, context);
        if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) break;
        ig_q_set_row_slot(scratch, args, step.next_base, row, slot, value);
    }
    if (thread_index == 0u) {
        ig_q_write_receipt(
            program, output, args,
            args.source_receipt_count + step.stage_index,
            input_rows, input_rows);
    }
}

inline bool ig_q_unwind_scan_base(
    constant MetalQuantifierArgs& args,
    constant MetalQuantifierStageStep& step,
    ulong base) {
    bool lineage = step.next_lineage == args.lineage_a_base
        || step.next_lineage == args.lineage_b_base;
    return lineage && (base == args.filter_rank_base || base == step.next_lineage);
}

inline bool ig_q_unwind_list_length(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong handle,
    thread ulong& length) {
    ulong index = (handle & IG_Q_IMMUTABLE) != 0ul
        ? handle & ~IG_Q_IMMUTABLE : handle;
    ulong capacity = (handle & IG_Q_IMMUTABLE) != 0ul
        ? args.immutable_cell_count : args.dynamic_cell_capacity;
    if (index >= capacity) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return false;
    }
    device const ulong* value = ig_q_cell(program, scratch, args, handle);
    if (value[0] == IG_Q_TAG_NULL) {
        length = 0ul;
        return true;
    }
    if (value[0] != IG_Q_TAG_LIST) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return false;
    }
    length = value[2];
    if (length > args.max_list_items) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return false;
    }
    ulong item_capacity = value[3] == 0ul
        ? args.immutable_item_count : args.dynamic_item_capacity;
    if (value[3] > 1ul || length > item_capacity
            || value[1] > item_capacity - length) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return false;
    }
    return true;
}

kernel void ig_quantifier_unwind_evaluate(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)output;
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    device const ulong* stage = program
        + args.stage_base + step.stage_index * IG_Q_STAGE_WORDS;
    ulong data_base = stage[2];
    if (stage[0] != 2ul || stage[3] != 2ul
            || data_base > args.stage_data_count
            || args.stage_data_count - data_base < 2ul
            || input_rows > args.eval_lane_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong row = ulong(thread_index);
    if (row >= input_rows) return;
    ulong cell_base = ig_q_reserve_arena(
        scratch, args, 1ul, stage[5], args.dynamic_cell_capacity);
    ulong item_base = ig_q_reserve_arena(
        scratch, args, 2ul, stage[6], args.dynamic_item_capacity);
    ulong byte_base = ig_q_reserve_arena(
        scratch, args, 3ul, stage[7], args.dynamic_byte_capacity);
    if (cell_base == IG_Q_INVALID || item_base == IG_Q_INVALID
            || byte_base == IG_Q_INVALID) return;
    ulong lane_control = args.eval_frame_base
        + row * args.frame_capacity * IG_Q_FRAME_WORDS
        + (args.frame_capacity - 1ul) * IG_Q_FRAME_WORDS;
    scratch[lane_control + 1ul] = cell_base;
    scratch[lane_control + 2ul] = item_base;
    scratch[lane_control + 3ul] = byte_base;
    IgQAllocator allocator = {
        lane_control,
        cell_base + stage[5],
        item_base + stage[6],
        byte_base + stage[7],
    };
    ulong expression = program[args.stage_data_base + data_base];
    ulong value = ig_q_evaluate_with_allocator(
        program, scratch, args, allocator, expression, step.current_base, row,
        ig_q_context(scratch[step.current_lineage + row], step.stage_index, 0ul));
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
    ulong length = 0ul;
    if (!ig_q_unwind_list_length(program, scratch, args, value, length)) return;
    scratch[args.filter_flag_base + row] = value;
    scratch[args.filter_rank_base + row] = length;
}

kernel void ig_quantifier_unwind_prefix_step(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    constant MetalQuantifierScanStep& scan [[buffer(5)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)output;
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    ulong row = ulong(thread_index);
    if (program[args.stage_base + step.stage_index * IG_Q_STAGE_WORDS] != 2ul
            || input_rows > args.eval_lane_count || scan.stride == 0ul
            || scan.input_base == scan.output_base
            || !ig_q_unwind_scan_base(args, step, scan.input_base)
            || !ig_q_unwind_scan_base(args, step, scan.output_base)) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (row >= input_rows) return;
    ulong value = scratch[scan.input_base + row];
    if (row >= scan.stride) {
        ulong prior = scratch[scan.input_base + row - scan.stride];
        if (prior > args.max_rows || value > args.max_rows - prior) {
            ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
            return;
        }
        value += prior;
    }
    scratch[scan.output_base + row] = value;
}

kernel void ig_quantifier_unwind_prefix_finalize(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    constant MetalQuantifierScanStep& scan [[buffer(5)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)output;
    if (thread_index != 0u
            || ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    if (program[args.stage_base + step.stage_index * IG_Q_STAGE_WORDS] != 2ul
            || input_rows > args.eval_lane_count
            || !ig_q_unwind_scan_base(args, step, scan.input_base)
            || scan.stride > args.max_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong output_rows = input_rows == 0ul
        ? 0ul : scratch[scan.input_base + input_rows - 1ul];
    if (output_rows > args.max_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return;
    }
    if (output_rows > scan.stride) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    scratch[args.control_base + 5ul] = output_rows;
}

kernel void ig_quantifier_unwind_prefix_exclusive(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    constant MetalQuantifierScanStep& scan [[buffer(5)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)output;
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    ulong row = ulong(thread_index);
    if (program[args.stage_base + step.stage_index * IG_Q_STAGE_WORDS] != 2ul
            || input_rows > args.eval_lane_count
            || !ig_q_unwind_scan_base(args, step, scan.input_base)) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    if (row >= input_rows) return;
    ulong length = 0ul;
    if (!ig_q_unwind_list_length(
            program, scratch, args,
            scratch[args.filter_flag_base + row], length)) return;
    ulong inclusive = scratch[scan.input_base + row];
    if (inclusive < length) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    scratch[args.filter_rank_base + row] = inclusive - length;
}

kernel void ig_quantifier_unwind_scatter(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)output;
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong output_rows = scratch[args.control_base + 5ul];
    ulong destination = ulong(thread_index);
    if (destination >= output_rows) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    device const ulong* stage = program
        + args.stage_base + step.stage_index * IG_Q_STAGE_WORDS;
    ulong data_base = stage[2];
    if (stage[0] != 2ul || stage[3] != 2ul
            || data_base > args.stage_data_count
            || args.stage_data_count - data_base < 2ul
            || input_rows > args.eval_lane_count || output_rows > args.max_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong low = 0ul;
    ulong high = input_rows;
    while (low < high) {
        ulong middle = low + (high - low) / 2ul;
        ulong length = 0ul;
        if (!ig_q_unwind_list_length(
                program, scratch, args,
                scratch[args.filter_flag_base + middle], length)) return;
        ulong begin = scratch[args.filter_rank_base + middle];
        if (begin > output_rows || length > output_rows - begin) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        if (begin + length <= destination) low = middle + 1ul;
        else high = middle;
    }
    if (low >= input_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong source = low;
    ulong length = 0ul;
    ulong handle = scratch[args.filter_flag_base + source];
    if (!ig_q_unwind_list_length(program, scratch, args, handle, length)) return;
    ulong begin = scratch[args.filter_rank_base + source];
    if (destination < begin || destination - begin >= length) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong slot = program[args.stage_data_base + data_base + 1ul];
    if (slot >= args.slot_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ig_q_copy_row(
        scratch, args, step.current_base, source, step.next_base, destination);
    device const ulong* list = ig_q_cell(program, scratch, args, handle);
    ulong item = destination - begin;
    ig_q_set_row_slot(
        scratch, args, step.next_base, destination, slot,
        ig_q_item(program, scratch, args, list, item));
    scratch[step.next_lineage + destination] = ig_q_context(
        scratch[step.current_lineage + source], step.stage_index, item);
}

kernel void ig_quantifier_unwind_finalize(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u
            || ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    ulong output_rows = scratch[args.control_base + 5ul];
    if (program[args.stage_base + step.stage_index * IG_Q_STAGE_WORDS] != 2ul
            || input_rows > args.eval_lane_count || output_rows > args.max_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    scratch[args.control_base + 4ul] = output_rows;
    ig_q_write_receipt(
        program, output, args,
        args.source_receipt_count + step.stage_index,
        input_rows, output_rows);
}

kernel void ig_quantifier_filter_evaluate(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)output;
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    ulong row = ulong(thread_index);
    if (row >= input_rows) return;
    device const ulong* stage = program
        + args.stage_base + step.stage_index * IG_Q_STAGE_WORDS;
    ulong data_base = stage[2];
    if (stage[0] != 3ul || stage[3] != 1ul
            || data_base >= args.stage_data_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong cell_base = ig_q_reserve_arena(
        scratch, args, 1ul, stage[5], args.dynamic_cell_capacity);
    ulong item_base = ig_q_reserve_arena(
        scratch, args, 2ul, stage[6], args.dynamic_item_capacity);
    ulong byte_base = ig_q_reserve_arena(
        scratch, args, 3ul, stage[7], args.dynamic_byte_capacity);
    if (cell_base == IG_Q_INVALID || item_base == IG_Q_INVALID
            || byte_base == IG_Q_INVALID) return;
    ulong lane_control = args.eval_frame_base
        + row * args.frame_capacity * IG_Q_FRAME_WORDS
        + (args.frame_capacity - 1ul) * IG_Q_FRAME_WORDS;
    scratch[lane_control + 1ul] = cell_base;
    scratch[lane_control + 2ul] = item_base;
    scratch[lane_control + 3ul] = byte_base;
    IgQAllocator allocator = {
        lane_control,
        cell_base + stage[5],
        item_base + stage[6],
        byte_base + stage[7],
    };
    ulong expression = program[args.stage_data_base + data_base];
    ulong value = ig_q_evaluate_with_allocator(
        program, scratch, args, allocator, expression, step.current_base, row,
        ig_q_context(scratch[step.current_lineage + row], step.stage_index, 0ul));
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
    long truth = ig_q_truth(program, scratch, args, value);
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
    scratch[args.filter_flag_base + row] = truth == 1L ? 1ul : 0ul;
}

kernel void ig_quantifier_filter_prefix(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)program;
    (void)output;
    (void)step;
    if (thread_index != 0u
            || ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    if (input_rows > args.eval_lane_count) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ulong retained = 0ul;
    #pragma clang loop unroll(disable)
    for (ulong row = 0ul; row < input_rows; ++row) {
        scratch[args.filter_rank_base + row] = retained;
        ulong flag = scratch[args.filter_flag_base + row];
        if (flag > 1ul || (flag == 1ul && retained == args.max_rows)) {
            ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
            return;
        }
        retained += flag;
    }
    scratch[args.control_base + 5ul] = retained;
}

kernel void ig_quantifier_filter_compact(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    (void)program;
    (void)output;
    if (ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    ulong row = ulong(thread_index);
    if (row >= input_rows || scratch[args.filter_flag_base + row] == 0ul) return;
    ulong destination = scratch[args.filter_rank_base + row];
    ulong retained = scratch[args.control_base + 5ul];
    if (destination >= retained || retained > args.max_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    ig_q_copy_row(
        scratch, args, step.current_base, row, step.next_base, destination);
    scratch[step.next_lineage + destination] = scratch[step.current_lineage + row];
}

kernel void ig_quantifier_filter_finalize(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u
            || ig_q_status_load(scratch, args) != IG_Q_STATUS_OK) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    ulong retained = scratch[args.control_base + 5ul];
    if (retained > input_rows) {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
        return;
    }
    scratch[args.control_base + 4ul] = retained;
    ig_q_write_receipt(
        program, output, args,
        args.source_receipt_count + step.stage_index,
        input_rows, retained);
}

kernel void ig_quantifier_group_serial(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || ig_q_status_load(scratch, args) != IG_Q_STATUS_OK
            || step.stage_index >= args.stage_count) return;
    ulong input_rows = scratch[args.control_base + 4ul];
    ulong row_count = input_rows;
    device const ulong* stage = program
        + args.stage_base + step.stage_index * IG_Q_STAGE_WORDS;
    if (stage[0] == 4ul) {
        row_count = ig_q_stage_group(
            program, scratch, args, stage, step.stage_index, input_rows,
            step.current_base, step.next_base,
            step.current_lineage, step.next_lineage);
    } else {
        ig_q_status(scratch, args, IG_Q_STATUS_CORRUPT);
    }
    scratch[args.control_base + 4ul] = row_count;
    if (ig_q_status_load(scratch, args) == IG_Q_STATUS_OK) {
        ig_q_write_receipt(
            program, output, args,
            args.source_receipt_count + step.stage_index,
            input_rows, row_count);
    }
}

kernel void ig_quantifier_publish(
    device const ulong* program [[buffer(0)]],
    device ulong* scratch [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant MetalQuantifierArgs& args [[buffer(3)]],
    constant MetalQuantifierStageStep& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    ulong row_count = scratch[args.control_base + 4ul];
    if (!ig_q_publish_rows(program, scratch, output, args, step.current_base, row_count)) {
        output[1] = ulong(ig_q_status_load(scratch, args));
    }
}

struct MetalBoundValueGroupArgs {
    ulong row_count;
    ulong table_capacity;
    ulong direction;
    ulong quantifier_output_count;
    ulong root_base;
    ulong cell_base;
    ulong item_base;
    ulong byte_base;
    ulong cell_capacity;
    ulong item_capacity;
    ulong byte_capacity;
    ulong column_count;
    ulong packet_words;
    ulong output_words;
    ulong active_row;
    ulong active_column;
};

inline uchar ig_bv_byte(
    device const ulong* packet,
    constant MetalBoundValueGroupArgs& args,
    ulong offset) {
    ulong word = packet[args.byte_base + offset / 8ul];
    return uchar((word >> ((offset & 7ul) * 8ul)) & 0xfful);
}

inline device const ulong* ig_bv_cell(
    device const ulong* packet,
    constant MetalBoundValueGroupArgs& args,
    ulong cell_count,
    ulong handle,
    thread bool& valid) {
    if (handle >= cell_count || handle >= args.cell_capacity) {
        valid = false;
        return packet + args.cell_base;
    }
    return packet + args.cell_base + handle * IG_Q_VALUE_WORDS;
}

inline bool ig_bv_shape(
    device const ulong* cell,
    ulong item_count,
    ulong byte_count,
    thread ulong& child_count) {
    child_count = 0ul;
    if (cell[0] == IG_Q_TAG_NULL) {
        return cell[1] == 0ul && cell[2] == 0ul && cell[3] == 0ul;
    }
    if (cell[0] == IG_Q_TAG_BOOLEAN) {
        return cell[1] <= 1ul && cell[2] == 0ul && cell[3] == 0ul;
    }
    if (cell[0] == IG_Q_TAG_INTEGER || cell[0] == IG_Q_TAG_FLOAT) {
        return cell[2] == 0ul && cell[3] == 0ul;
    }
    if (cell[0] == IG_Q_TAG_STRING) {
        return cell[3] == 2ul
            && cell[1] <= byte_count
            && cell[2] <= byte_count - cell[1];
    }
    if (cell[0] != IG_Q_TAG_LIST && cell[0] != IG_Q_TAG_MAP) return false;
    if (cell[3] != 2ul) return false;
    if (cell[0] == IG_Q_TAG_MAP && cell[2] > item_count / 2ul) return false;
    child_count = cell[0] == IG_Q_TAG_LIST ? cell[2] : cell[2] * 2ul;
    return cell[1] <= item_count && child_count <= item_count - cell[1];
}

inline ulong ig_bv_float_key(ulong bits) {
    const ulong exponent_mask = 0x7ff0000000000000ul;
    const ulong fraction_mask = 0x000ffffffffffffful;
    // Metal does not guarantee FP64 support. Normalize canonical Cypher FLOAT equality classes
    // directly from the IEEE-754 bits: all NaNs share one key, and signed zeroes compare equal.
    if ((bits & exponent_mask) == exponent_mask && (bits & fraction_mask) != 0ul) {
        return 0x7ff8000000000000ul;
    }
    if ((bits & ~0x8000000000000000ul) == 0ul) return 0ul;
    return bits;
}

inline bool ig_bv_scalar_equal(device const ulong* left, device const ulong* right) {
    if (left[0] != right[0]) return false;
    if (left[0] == IG_Q_TAG_NULL) return true;
    if (left[0] == IG_Q_TAG_FLOAT) {
        return ig_bv_float_key(left[1]) == ig_bv_float_key(right[1]);
    }
    return left[1] == right[1];
}

// UTF-8 preserves Unicode scalar order under unsigned byte comparison. The quantifier publisher
// receives valid Rust strings, so this strict byte order is also the canonical BTreeMap key order.
inline bool ig_bv_string_strict_less(
    device const ulong* packet,
    constant MetalBoundValueGroupArgs& args,
    device const ulong* left,
    device const ulong* right) {
    ulong width = left[2] < right[2] ? left[2] : right[2];
    #pragma clang loop unroll(disable)
    for (ulong index = 0ul; index < width; ++index) {
        uchar left_byte = ig_bv_byte(packet, args, left[1] + index);
        uchar right_byte = ig_bv_byte(packet, args, right[1] + index);
        if (left_byte < right_byte) return true;
        if (left_byte > right_byte) return false;
    }
    return left[2] < right[2];
}

// Returns 0 for unequal, 1 for equal, and 2 for corrupt metadata. A preceding packet-validation
// pass proves that each output root owns one contiguous canonical DFS-preorder cell span and that
// `subtree_ends` describes the same relative child topology. Equality therefore needs no recursion,
// private stack, or nesting-depth limit.
inline uchar ig_bv_flat_equal(
    device const ulong* packet,
    device const ulong* subtree_ends,
    constant MetalBoundValueGroupArgs& args,
    ulong cell_count,
    ulong item_count,
    ulong byte_count,
    ulong left_root,
    ulong right_root) {
    if (left_root >= cell_count || right_root >= cell_count
            || left_root >= args.cell_capacity || right_root >= args.cell_capacity) return 2;
    ulong left_end = subtree_ends[left_root];
    ulong right_end = subtree_ends[right_root];
    if (left_end <= left_root || left_end > cell_count
            || right_end <= right_root || right_end > cell_count) return 2;
    ulong cell_width = left_end - left_root;
    if (cell_width != right_end - right_root) return 0;

    #pragma clang loop unroll(disable)
    for (ulong offset = 0ul; offset < cell_width; ++offset) {
        bool valid = true;
        device const ulong* left = ig_bv_cell(
            packet, args, cell_count, left_root + offset, valid);
        device const ulong* right = ig_bv_cell(
            packet, args, cell_count, right_root + offset, valid);
        if (!valid) return 2;
        ulong left_children = 0ul;
        ulong right_children = 0ul;
        if (!ig_bv_shape(left, item_count, byte_count, left_children)
                || !ig_bv_shape(right, item_count, byte_count, right_children)) {
            return 2;
        }
        if (left[0] != right[0] || left_children != right_children) return 0;
        if (left[0] <= IG_Q_TAG_FLOAT) {
            if (!ig_bv_scalar_equal(left, right)) return 0;
        } else if (left[0] == IG_Q_TAG_STRING) {
            if (left[2] != right[2]) return 0;
            #pragma clang loop unroll(disable)
            for (ulong index = 0ul; index < left[2]; ++index) {
                if (ig_bv_byte(packet, args, left[1] + index)
                        != ig_bv_byte(packet, args, right[1] + index)) return 0;
            }
        } else if (left[2] != right[2]) {
            return 0;
        }

        #pragma clang loop unroll(disable)
        for (ulong child = 0ul; child < left_children; ++child) {
            ulong left_handle = packet[args.item_base + left[1] + child];
            ulong right_handle = packet[args.item_base + right[1] + child];
            if (left_handle < left_root || left_handle >= left_end
                    || right_handle < right_root || right_handle >= right_end) return 2;
            if (left_handle - left_root != right_handle - right_root) return 0;
        }
    }
    return 1;
}

inline void ig_bv_endpoints(
    device const long* sources,
    device const long* targets,
    constant MetalBoundValueGroupArgs& args,
    ulong row,
    thread ulong& source,
    thread ulong& target) {
    source = as_type<ulong>(sources[row]);
    target = as_type<ulong>(targets[row]);
    if (args.direction == 1ul && target < source) {
        ulong swap = source;
        source = target;
        target = swap;
    }
}

kernel void ig_quantifier_bound_value_clear(
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    #pragma clang loop unroll(disable)
    for (ulong word = 0ul; word < args.output_words; ++word) output[word] = 0ul;
}

// Contract validation is split into small serial PSOs because the AGX pipeline compiler cannot
// reliably lower the former monolithic validation kernel. Values 6-9 are transient phases; phase
// 1 remains the unchanged handoff expected by the subtree builder.
constant ulong IG_BV_PHASE_GROUP_LAYOUT = 6ul;
constant ulong IG_BV_PHASE_PACKET_HEADER = 7ul;
constant ulong IG_BV_PHASE_PACKET_ARENAS = 8ul;
constant ulong IG_BV_PHASE_ROOT_BOUNDS = 9ul;

kernel void ig_quantifier_bound_value_validate_group_layout(
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    if (args.row_count == 0ul || args.column_count == 0ul
            || args.quantifier_output_count == 0ul || args.direction > 1ul
            || args.packet_words < IG_Q_HEADER_WORDS) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (args.table_capacity == 0ul
            || args.row_count > args.table_capacity / 2ul
            || (args.table_capacity & (args.table_capacity - 1ul)) != 0ul) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }

    ulong table_base = 2ul + args.row_count * 2ul;
    ulong control_base = table_base + args.table_capacity;
    ulong subtree_base = control_base + 6ul;
    if (table_base > args.output_words
            || args.table_capacity > args.output_words - table_base
            || control_base > args.output_words
            || 6ul > args.output_words - control_base
            || subtree_base > args.output_words
            || args.cell_capacity > args.output_words - subtree_base) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (output[control_base] != 0ul) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    output[control_base] = IG_BV_PHASE_GROUP_LAYOUT;
}

kernel void ig_quantifier_bound_value_validate_packet_header(
    device const ulong* packet [[buffer(0)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong progress_base = 2ul + args.row_count * 2ul + args.table_capacity;
    if (output[progress_base] != IG_BV_PHASE_GROUP_LAYOUT) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (packet[0] != IG_Q_OUTPUT_MAGIC || packet[1] != IG_Q_STATUS_OK
            || packet[18] == 0ul
            || packet[19] != args.quantifier_output_count
            || packet[24] != args.packet_words) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (packet[26] == 0ul || packet[26] > args.cell_capacity
            || packet[27] > args.item_capacity || packet[28] > args.byte_capacity
            || packet[29] != args.cell_capacity
            || packet[30] != args.item_capacity || packet[31] != args.byte_capacity) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    output[progress_base] = IG_BV_PHASE_PACKET_HEADER;
}

kernel void ig_quantifier_bound_value_validate_packet_arenas(
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong progress_base = 2ul + args.row_count * 2ul + args.table_capacity;
    if (output[progress_base] != IG_BV_PHASE_PACKET_HEADER) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (args.root_base > args.packet_words || args.cell_base > args.packet_words) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (args.cell_capacity > (args.packet_words - args.cell_base) / IG_Q_VALUE_WORDS
            || args.item_base > args.packet_words) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (args.item_capacity > args.packet_words - args.item_base
            || args.byte_base > args.packet_words) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong packed_byte_words = args.byte_capacity / 8ul
        + ((args.byte_capacity & 7ul) == 0ul ? 0ul : 1ul);
    if (packed_byte_words > args.packet_words - args.byte_base) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    output[progress_base] = IG_BV_PHASE_PACKET_ARENAS;
}

inline bool ig_bv_mul_u64_exact(
    ulong left,
    ulong right,
    thread ulong& low_product) {
    uint left_low = uint(left);
    uint left_high = uint(left >> 32ul);
    uint right_low = uint(right);
    uint right_high = uint(right >> 32ul);
    ulong low_low = ulong(left_low) * ulong(right_low);
    ulong low_high = ulong(left_low) * ulong(right_high);
    ulong high_low = ulong(left_high) * ulong(right_low);
    ulong high_high = ulong(left_high) * ulong(right_high);

    // Accumulate the base-2^32 limbs without overflowing an intermediate. `middle` is at most
    // three 32-bit limbs, and the final high half is the exact upper half of the 128-bit product.
    ulong middle = (low_low >> 32ul)
        + ulong(uint(low_high)) + ulong(uint(high_low));
    low_product = (middle << 32ul) | ulong(uint(low_low));
    ulong high_product = high_high + (low_high >> 32ul)
        + (high_low >> 32ul) + (middle >> 32ul);
    return high_product == 0ul;
}

kernel void ig_quantifier_bound_value_validate_root_bounds(
    device const ulong* packet [[buffer(0)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong progress_base = 2ul + args.row_count * 2ul + args.table_capacity;
    if (output[progress_base] != IG_BV_PHASE_PACKET_ARENAS) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong root_count = 0ul;
    if (!ig_bv_mul_u64_exact(packet[18], args.quantifier_output_count, root_count)
            || packet[25] != root_count
            || root_count > args.packet_words - args.root_base) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    output[progress_base] = IG_BV_PHASE_ROOT_BOUNDS;
}

kernel void ig_quantifier_bound_value_validate_columns(
    device const uint* columns [[buffer(5)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong progress_base = 2ul + args.row_count * 2ul + args.table_capacity;
    if (output[progress_base] != IG_BV_PHASE_ROOT_BOUNDS) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    #pragma clang loop unroll(disable)
    for (ulong column = 0ul; column < args.column_count; ++column) {
        if (ulong(columns[column]) >= args.quantifier_output_count) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
    }
    output[progress_base] = 1ul;
}

kernel void ig_quantifier_bound_value_build_subtrees(
    device const ulong* packet [[buffer(0)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong subtree_base = 2ul + args.row_count * 2ul + args.table_capacity + 6ul;
    ulong progress_base = subtree_base - 6ul;
    if (output[progress_base] != 1ul) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong cell_count = packet[26];
    ulong item_count = packet[27];
    ulong byte_count = packet[28];
    device ulong* subtree_ends = output + subtree_base;
    #pragma clang loop unroll(disable)
    for (ulong remaining = cell_count; remaining != 0ul;) {
        ulong cell_index = --remaining;
        bool valid = true;
        device const ulong* cell = ig_bv_cell(
            packet, args, cell_count, cell_index, valid);
        ulong child_count = 0ul;
        if (!valid || !ig_bv_shape(cell, item_count, byte_count, child_count)) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }

        ulong subtree_end = cell_index + 1ul;
        #pragma clang loop unroll(disable)
        for (ulong child = 0ul; child < child_count; ++child) {
            if (subtree_end >= cell_count) {
                output[0] = IG_Q_STATUS_CORRUPT;
                return;
            }
            ulong child_handle = packet[args.item_base + cell[1] + child];
            if (child_handle != subtree_end) {
                output[0] = IG_Q_STATUS_CORRUPT;
                return;
            }
            ulong child_end = subtree_ends[child_handle];
            if (child_end <= child_handle || child_end > cell_count) {
                output[0] = IG_Q_STATUS_CORRUPT;
                return;
            }
            subtree_end = child_end;
        }
        subtree_ends[cell_index] = subtree_end;
    }
    output[progress_base] = 2ul;
}

kernel void ig_quantifier_bound_value_validate_maps(
    device const ulong* packet [[buffer(0)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong subtree_base = 2ul + args.row_count * 2ul + args.table_capacity + 6ul;
    ulong progress_base = subtree_base - 6ul;
    if (output[progress_base] != 2ul) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong cell_count = packet[26];
    device const ulong* subtree_ends = output + subtree_base;
    #pragma clang loop unroll(disable)
    for (ulong cell_index = 0ul; cell_index < cell_count; ++cell_index) {
        bool valid = true;
        device const ulong* cell = ig_bv_cell(
            packet, args, cell_count, cell_index, valid);
        if (!valid) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
        if (cell[0] != IG_Q_TAG_MAP) continue;
        #pragma clang loop unroll(disable)
        for (ulong entry = 0ul; entry < cell[2]; ++entry) {
            ulong key_handle = packet[args.item_base + cell[1] + entry * 2ul];
            valid = true;
            device const ulong* key = ig_bv_cell(
                packet, args, cell_count, key_handle, valid);
            if (!valid || key[0] != IG_Q_TAG_STRING
                    || subtree_ends[key_handle] != key_handle + 1ul) {
                output[0] = IG_Q_STATUS_CORRUPT;
                return;
            }
            if (entry != 0ul) {
                ulong prior_handle = packet[
                    args.item_base + cell[1] + (entry - 1ul) * 2ul];
                valid = true;
                device const ulong* prior = ig_bv_cell(
                    packet, args, cell_count, prior_handle, valid);
                if (!valid || !ig_bv_string_strict_less(packet, args, prior, key)) {
                    output[0] = IG_Q_STATUS_CORRUPT;
                    return;
                }
            }
        }
    }
    output[progress_base] = 3ul;
}

kernel void ig_quantifier_bound_value_validate_arenas(
    device const ulong* packet [[buffer(0)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong progress_base = 2ul + args.row_count * 2ul + args.table_capacity;
    if (output[progress_base] != 3ul) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong cell_count = packet[26];
    ulong item_count = packet[27];
    ulong byte_count = packet[28];
    // Publication allocates item ranges and packed-string ranges in the same DFS-preorder as its
    // cells. Exact cursor equality rejects overlap, aliasing, gaps, and unused trailing payload.
    ulong item_cursor = 0ul;
    ulong byte_cursor = 0ul;
    #pragma clang loop unroll(disable)
    for (ulong cell_index = 0ul; cell_index < cell_count; ++cell_index) {
        bool valid = true;
        device const ulong* cell = ig_bv_cell(
            packet, args, cell_count, cell_index, valid);
        ulong child_count = 0ul;
        if (!valid || !ig_bv_shape(cell, item_count, byte_count, child_count)) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
        if (cell[0] == IG_Q_TAG_STRING) {
            if (cell[1] != byte_cursor) {
                output[0] = IG_Q_STATUS_CORRUPT;
                return;
            }
            byte_cursor += cell[2];
        } else if (cell[0] == IG_Q_TAG_LIST || cell[0] == IG_Q_TAG_MAP) {
            if (cell[1] != item_cursor) {
                output[0] = IG_Q_STATUS_CORRUPT;
                return;
            }
            item_cursor += child_count;
        }
    }
    if (item_cursor != item_count || byte_cursor != byte_count) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    output[progress_base] = 4ul;
}

kernel void ig_quantifier_bound_value_validate_roots(
    device const ulong* packet [[buffer(0)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong subtree_base = 2ul + args.row_count * 2ul + args.table_capacity + 6ul;
    ulong progress_base = subtree_base - 6ul;
    if (output[progress_base] != 4ul) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong cell_count = packet[26];
    ulong root_count = packet[25];
    device const ulong* subtree_ends = output + subtree_base;
    // Every published root is a private tree copied immediately after its predecessor. Together
    // the row-major root table must therefore partition the complete used cell arena exactly.
    ulong expected_root = 0ul;
    #pragma clang loop unroll(disable)
    for (ulong root_index = 0ul; root_index < root_count; ++root_index) {
        ulong root = packet[args.root_base + root_index];
        if (root != expected_root || root >= cell_count) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
        ulong root_end = subtree_ends[root];
        if (root_end <= root || root_end > cell_count) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
        expected_root = root_end;
    }
    if (expected_root != cell_count) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    output[progress_base] = 5ul;
}

kernel void ig_quantifier_bound_value_validate_selected(
    device const ulong* packet [[buffer(0)]],
    device const uint* value_rows [[buffer(4)]],
    device const uint* columns [[buffer(5)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong progress_base = 2ul + args.row_count * 2ul + args.table_capacity;
    if (output[progress_base] != 5ul) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    // Only grouping-key roots reject NULL. Nested NULL values remain valid list/map content.
    #pragma clang loop unroll(disable)
    for (ulong row = 0ul; row < args.row_count; ++row) {
        ulong value_row = ulong(value_rows[row]);
        if (value_row >= packet[18]) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
        #pragma clang loop unroll(disable)
        for (ulong column = 0ul; column < args.column_count; ++column) {
            ulong output_column = ulong(columns[column]);
            ulong root = packet[
                args.root_base + value_row * args.quantifier_output_count + output_column];
            if (packet[args.cell_base + root * IG_Q_VALUE_WORDS] == IG_Q_TAG_NULL) {
                output[0] = IG_Q_STATUS_TYPE;
                return;
            }
        }
    }
    output[progress_base] = 0ul;
}

kernel void ig_quantifier_bound_value_begin_step(
    device const ulong* packet [[buffer(0)]],
    device const uint* parents [[buffer(1)]],
    device const long* sources [[buffer(2)]],
    device const long* targets [[buffer(3)]],
    device const uint* value_rows [[buffer(4)]],
    device const uint* columns [[buffer(5)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong leader_base = 2ul;
    ulong ordinal_base = leader_base + args.row_count;
    ulong table_base = ordinal_base + args.row_count;
    ulong progress_base = table_base + args.table_capacity;
    ulong state_base = progress_base + 1ul;
    ulong slot_base = progress_base + 2ul;
    ulong probe_base = progress_base + 3ul;
    ulong candidate_base = progress_base + 4ul;
    ulong cursor_base = progress_base + 5ul;
    if (args.active_row >= args.row_count || args.column_count == 0ul
            || args.table_capacity < args.row_count * 2ul
            || (args.table_capacity & (args.table_capacity - 1ul)) != 0ul
            || table_base > args.output_words
            || args.table_capacity > args.output_words - table_base
            || progress_base > args.output_words
            || 6ul > args.output_words - progress_base) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong row = args.active_row;
    ulong prior_state = output[state_base];
    if (output[progress_base] != row || output[cursor_base] != 0ul
            || (row == 0ul && prior_state != 0ul)
            || (row != 0ul && prior_state != 3ul)
            || output[1] > row) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong source = 0ul;
    ulong target = 0ul;
    ig_bv_endpoints(sources, targets, args, row, source, target);
    output[state_base] = 1ul;
    output[slot_base] = ig_q_mix(source ^ ig_q_mix(target))
        & (args.table_capacity - 1ul);
    output[probe_base] = 0ul;
    output[candidate_base] = 0ul;
    output[cursor_base] = 0ul;
}

kernel void ig_quantifier_bound_value_probe(
    device const ulong* packet [[buffer(0)]],
    device const uint* parents [[buffer(1)]],
    device const long* sources [[buffer(2)]],
    device const long* targets [[buffer(3)]],
    device const uint* value_rows [[buffer(4)]],
    device const uint* columns [[buffer(5)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong leader_base = 2ul;
    ulong ordinal_base = leader_base + args.row_count;
    ulong table_base = ordinal_base + args.row_count;
    ulong progress_base = table_base + args.table_capacity;
    ulong state_base = progress_base + 1ul;
    ulong slot_base = progress_base + 2ul;
    ulong probe_base = progress_base + 3ul;
    ulong candidate_base = progress_base + 4ul;
    ulong cursor_base = progress_base + 5ul;
    if (args.active_row >= args.row_count
            || table_base > args.output_words
            || args.table_capacity > args.output_words - table_base
            || progress_base > args.output_words
            || 6ul > args.output_words - progress_base) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (output[state_base] != 1ul) return;
    ulong row = args.active_row;
    ulong slot = output[slot_base];
    ulong probes = output[probe_base];
    if (output[progress_base] != row || output[cursor_base] != 0ul
            || slot >= args.table_capacity
            || probes >= args.table_capacity || output[1] > row) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong existing = output[table_base + slot];
    if (existing == 0ul) {
        ulong groups = output[1] + 1ul;
        if (groups == 0ul || groups > row + 1ul) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
        output[table_base + slot] = row + 1ul;
        output[leader_base + row] = ulong(parents[row]);
        output[ordinal_base + row] = groups;
        output[1] = groups;
        output[progress_base] = row + 1ul;
        output[state_base] = 3ul;
        output[cursor_base] = 0ul;
        return;
    }
    ulong candidate = existing - 1ul;
    if (candidate >= row) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong source = 0ul;
    ulong target = 0ul;
    ulong candidate_source = 0ul;
    ulong candidate_target = 0ul;
    ig_bv_endpoints(sources, targets, args, row, source, target);
    ig_bv_endpoints(
        sources, targets, args, candidate, candidate_source, candidate_target);
    probes += 1ul;
    output[probe_base] = probes;
    if (source == candidate_source && target == candidate_target) {
        output[candidate_base] = candidate + 1ul;
        output[state_base] = 2ul;
        output[cursor_base] = 0ul;
    } else if (probes == args.table_capacity) {
        output[0] = IG_Q_STATUS_BUDGET;
    } else {
        output[slot_base] = (slot + 1ul) & (args.table_capacity - 1ul);
    }
}

kernel void ig_quantifier_bound_value_compare_one(
    device const ulong* packet [[buffer(0)]],
    device const uint* parents [[buffer(1)]],
    device const long* sources [[buffer(2)]],
    device const long* targets [[buffer(3)]],
    device const uint* value_rows [[buffer(4)]],
    device const uint* columns [[buffer(5)]],
    device ulong* output [[buffer(6)]],
    constant MetalBoundValueGroupArgs& args [[buffer(7)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || output[0] != IG_Q_STATUS_OK) return;
    ulong leader_base = 2ul;
    ulong ordinal_base = leader_base + args.row_count;
    ulong table_base = ordinal_base + args.row_count;
    ulong progress_base = table_base + args.table_capacity;
    ulong state_base = progress_base + 1ul;
    ulong slot_base = progress_base + 2ul;
    ulong probe_base = progress_base + 3ul;
    ulong candidate_base = progress_base + 4ul;
    ulong cursor_base = progress_base + 5ul;
    ulong subtree_base = progress_base + 6ul;
    if (args.active_row >= args.row_count || args.active_column >= args.column_count
            || table_base > args.output_words
            || args.table_capacity > args.output_words - table_base
            || progress_base > args.output_words
            || 6ul > args.output_words - progress_base
            || subtree_base > args.output_words
            || args.cell_capacity > args.output_words - subtree_base) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (output[state_base] != 2ul) return;
    ulong row = args.active_row;
    ulong candidate_word = output[candidate_base];
    if (output[progress_base] != row || output[cursor_base] != args.active_column
            || candidate_word == 0ul || candidate_word > row) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong candidate = candidate_word - 1ul;
    ulong value_row = ulong(value_rows[row]);
    ulong candidate_value_row = ulong(value_rows[candidate]);
    ulong output_column = ulong(columns[args.active_column]);
    if (value_row >= packet[18] || candidate_value_row >= packet[18]
            || output_column >= args.quantifier_output_count) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    ulong left = packet[
        args.root_base + value_row * args.quantifier_output_count + output_column];
    ulong right = packet[
        args.root_base + candidate_value_row * args.quantifier_output_count + output_column];
    uchar comparison = ig_bv_flat_equal(
        packet, output + subtree_base, args,
        packet[26], packet[27], packet[28], left, right);
    if (comparison == 2u) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    if (comparison == 0u) {
        ulong probes = output[probe_base];
        ulong slot = output[slot_base];
        if (probes >= args.table_capacity) {
            output[0] = IG_Q_STATUS_BUDGET;
            return;
        }
        if (slot >= args.table_capacity) {
            output[0] = IG_Q_STATUS_CORRUPT;
            return;
        }
        output[slot_base] = (slot + 1ul) & (args.table_capacity - 1ul);
        output[candidate_base] = 0ul;
        output[cursor_base] = 0ul;
        output[state_base] = 1ul;
        return;
    }
    if (args.active_column + 1ul < args.column_count) {
        output[cursor_base] = args.active_column + 1ul;
        return;
    }
    ulong ordinal = output[ordinal_base + candidate];
    if (ordinal == 0ul || ordinal > output[1]) {
        output[0] = IG_Q_STATUS_CORRUPT;
        return;
    }
    output[leader_base + row] = output[leader_base + candidate];
    output[ordinal_base + row] = ordinal;
    output[progress_base] = row + 1ul;
    output[candidate_base] = 0ul;
    output[cursor_base] = 0ul;
    output[state_base] = 3ul;
}

#endif
// IG_QUANTIFIER_PROGRAM_SOURCE_END

// First-class row-driven node MERGE. Graph, program, and result packets are homogeneous arrays of
// signed 64-bit lanes whose contents are interpreted exclusively as unsigned bit patterns. UTF-8
// arenas use one byte per lane; this keeps every offset/count in the same checked address space.
constant ulong IG_ROW_MUTATION_GRAPH_MAGIC = 0x475243524f574d31ul;
constant ulong IG_ROW_MUTATION_PROGRAM_MAGIC = 0x505243524f574d31ul;
constant ulong IG_ROW_MUTATION_PROGRAM_VERSION = 1ul;
constant ulong IG_ROW_MUTATION_PROGRAM_HEADER_WORDS = 32ul;
constant ulong IG_ROW_MUTATION_ENTRY_WORDS = 5ul;
constant ulong IG_ROW_MUTATION_OUTPUT_MAGIC = 0x4f5243524f574d31ul;
constant ulong IG_ROW_MUTATION_OUTPUT_VERSION = 1ul;
constant ulong IG_ROW_MUTATION_OUTPUT_HEADER_WORDS = 40ul;
constant ulong IG_ROW_MUTATION_RECEIPT_WORDS = 9ul;
constant ulong IG_ROW_MUTATION_CONTROL_WORDS = 8ul;
constant ulong IG_ROW_MUTATION_SEALED = 0x5345414c4544524dul;

struct RowMutationArgs {
    ulong execution_high;
    ulong execution_low;
    ulong project_high;
    ulong project_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong catalog_0;
    ulong catalog_1;
    ulong catalog_2;
    ulong catalog_3;
    ulong fingerprint_0;
    ulong fingerprint_1;
    ulong fingerprint_2;
    ulong fingerprint_3;
    ulong graph_word_count;
    ulong program_word_count;
    ulong output_word_count;
    ulong row_count;
    ulong node_count;
    ulong label_count;
    ulong output_count;
    ulong receipt_count;
    ulong first_node_id;
    ulong layers;
    ulong graph_node_active_base;
    ulong graph_node_layer_base;
    ulong graph_node_id_base;
    ulong graph_label_base;
    ulong graph_property_value_base;
    ulong graph_property_validity_base;
    ulong graph_dictionary_offset_base;
    ulong graph_dictionary_offset_count;
    ulong graph_dictionary_byte_base;
    ulong graph_dictionary_byte_count;
    ulong program_map_offset_base;
    ulong program_entry_base;
    ulong program_key_byte_base;
    ulong program_key_byte_count;
    ulong program_value_byte_base;
    ulong program_value_byte_count;
    ulong program_obligation_base;
    ulong program_output_source_base;
    ulong output_receipt_base;
    ulong output_target_id_base;
    ulong output_target_dense_base;
    ulong output_target_created_base;
    ulong output_merge_ref_base;
    ulong output_set_ref_base;
    ulong output_row_status_base;
    ulong output_row_match_base;
    ulong output_dependency_base;
    ulong output_final_ref_base;
    ulong output_create_base;
    ulong output_control_base;
};

struct RowMutationDispatchArgs {
    ulong logical_base;
};

inline ulong ig_row_mutation_word(device const long* words, ulong index) {
    return as_type<ulong>(words[index]);
}

inline void ig_row_mutation_store(device long* words, ulong index, ulong value) {
    words[index] = as_type<long>(value);
}

inline bool ig_row_mutation_range(ulong base, ulong count, ulong total) {
    return base <= total && count <= total - base;
}

inline bool ig_row_mutation_add(ulong left, ulong right, thread ulong& result) {
    if (right > ~0ul - left) return false;
    result = left + right;
    return true;
}

inline bool ig_row_mutation_product(ulong left, ulong right, thread ulong& result) {
    if (left != 0ul && right > ~0ul / left) return false;
    result = left * right;
    return true;
}

inline bool ig_row_mutation_advance(
    thread ulong& cursor,
    ulong expected,
    ulong count,
    ulong total) {
    if (cursor != expected || !ig_row_mutation_range(cursor, count, total)) return false;
    cursor += count;
    return true;
}

[[clang::noinline]] bool ig_row_mutation_output_layout(constant RowMutationArgs& args) {
    if (args.output_word_count < IG_ROW_MUTATION_OUTPUT_HEADER_WORDS) return false;
    ulong cursor = IG_ROW_MUTATION_OUTPUT_HEADER_WORDS;
    ulong words = 0ul;
    if (!ig_row_mutation_product(
            args.receipt_count, IG_ROW_MUTATION_RECEIPT_WORDS, words)
        || !ig_row_mutation_advance(
            cursor, args.output_receipt_base, words, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_target_id_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_target_dense_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_target_created_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_merge_ref_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_set_ref_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_row_status_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_row_match_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_dependency_base, args.node_count, args.output_word_count)
        || !ig_row_mutation_product(args.row_count, args.output_count, words)
        || !ig_row_mutation_advance(
            cursor, args.output_final_ref_base, words, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_create_base, args.row_count, args.output_word_count)
        || !ig_row_mutation_advance(
            cursor, args.output_control_base,
            IG_ROW_MUTATION_CONTROL_WORDS, args.output_word_count)) {
        return false;
    }
    return cursor == args.output_word_count;
}

[[clang::noinline]] bool ig_row_mutation_graph_layout(
    device const long* graph,
    constant RowMutationArgs& args) {
    if (!ig_row_mutation_range(0ul, 1ul, args.graph_word_count)
            || ig_row_mutation_word(graph, 0ul) != IG_ROW_MUTATION_GRAPH_MAGIC
            || args.graph_dictionary_offset_count == 0ul) {
        return false;
    }
    ulong cursor = 1ul;
    ulong words = 0ul;
    if (!ig_row_mutation_advance(
            cursor, args.graph_node_active_base, args.node_count, args.graph_word_count)
        || !ig_row_mutation_advance(
            cursor, args.graph_node_layer_base, args.node_count, args.graph_word_count)
        || !ig_row_mutation_advance(
            cursor, args.graph_node_id_base, args.node_count, args.graph_word_count)
        || !ig_row_mutation_product(args.label_count, args.node_count, words)
        || !ig_row_mutation_advance(
            cursor, args.graph_label_base, words, args.graph_word_count)
        || !ig_row_mutation_advance(
            cursor, args.graph_property_value_base, args.node_count, args.graph_word_count)
        || !ig_row_mutation_advance(
            cursor, args.graph_property_validity_base, args.node_count, args.graph_word_count)
        || !ig_row_mutation_advance(
            cursor, args.graph_dictionary_offset_base,
            args.graph_dictionary_offset_count, args.graph_word_count)
        || !ig_row_mutation_advance(
            cursor, args.graph_dictionary_byte_base,
            args.graph_dictionary_byte_count, args.graph_word_count)) {
        return false;
    }
    return cursor == args.graph_word_count;
}

[[clang::noinline]] bool ig_row_mutation_program_layout(
    device const long* program,
    constant RowMutationArgs& args) {
    if (!ig_row_mutation_range(
            0ul, IG_ROW_MUTATION_PROGRAM_HEADER_WORDS, args.program_word_count)) {
        return false;
    }
    ulong map_words = 0ul;
    ulong entry_words = 0ul;
    ulong obligation_words = 0ul;
    ulong candidate_end = 0ul;
    if (!ig_row_mutation_add(args.row_count, 1ul, map_words)
        || !ig_row_mutation_product(
            ig_row_mutation_word(program, 3ul), IG_ROW_MUTATION_ENTRY_WORDS, entry_words)
        || !ig_row_mutation_product(args.receipt_count, 4ul, obligation_words)
        || !ig_row_mutation_add(args.first_node_id, args.row_count, candidate_end)) {
        return false;
    }
    (void)candidate_end;
    if (ig_row_mutation_word(program, 0ul) != IG_ROW_MUTATION_PROGRAM_MAGIC
        || ig_row_mutation_word(program, 1ul) != IG_ROW_MUTATION_PROGRAM_VERSION
        || ig_row_mutation_word(program, 2ul) != args.row_count
        || ig_row_mutation_word(program, 4ul) != args.program_map_offset_base
        || ig_row_mutation_word(program, 5ul) != args.program_entry_base
        || ig_row_mutation_word(program, 6ul) != args.program_key_byte_base
        || ig_row_mutation_word(program, 7ul) != args.program_key_byte_count
        || ig_row_mutation_word(program, 8ul) != args.program_value_byte_base
        || ig_row_mutation_word(program, 9ul) != args.program_value_byte_count
        || ig_row_mutation_word(program, 14ul) != args.output_count
        || ig_row_mutation_word(program, 15ul) != args.receipt_count
        || ig_row_mutation_word(program, 16ul) != args.program_obligation_base
        || ig_row_mutation_word(program, 17ul) != args.program_output_source_base
        || ig_row_mutation_word(program, 18ul) != args.first_node_id
        || ig_row_mutation_word(program, 19ul) != args.layers
        || ig_row_mutation_word(program, 20ul) != args.label_count
        || ig_row_mutation_word(program, 21ul) != 1ul
        || ig_row_mutation_word(program, 22ul) != IG_ROW_MUTATION_ENTRY_WORDS
        || ig_row_mutation_word(program, 31ul) != IG_ROW_MUTATION_SEALED
        || (args.execution_high == 0ul && args.execution_low == 0ul)
        || args.first_node_id == 0ul
        || args.layers == 0ul
        || args.label_count == 0ul
        || args.output_count == 0ul
        || args.receipt_count != 7ul) {
        return false;
    }
    for (ulong reserved = 23ul; reserved < 31ul; ++reserved) {
        if (ig_row_mutation_word(program, reserved) != 0ul) return false;
    }
    ulong cursor = IG_ROW_MUTATION_PROGRAM_HEADER_WORDS;
    if (!ig_row_mutation_advance(
            cursor, args.program_map_offset_base, map_words, args.program_word_count)
        || !ig_row_mutation_advance(
            cursor, args.program_entry_base, entry_words, args.program_word_count)
        || !ig_row_mutation_advance(
            cursor, args.program_key_byte_base,
            args.program_key_byte_count, args.program_word_count)
        || !ig_row_mutation_advance(
            cursor, args.program_value_byte_base,
            args.program_value_byte_count, args.program_word_count)
        || !ig_row_mutation_advance(
            cursor, args.program_obligation_base, obligation_words, args.program_word_count)
        || !ig_row_mutation_advance(
            cursor, args.program_output_source_base,
            args.output_count, args.program_word_count)) {
        return false;
    }
    if (cursor != args.program_word_count) return false;
    ulong merge_offset = ig_row_mutation_word(program, 10ul);
    ulong merge_length = ig_row_mutation_word(program, 11ul);
    ulong set_offset = ig_row_mutation_word(program, 12ul);
    ulong set_length = ig_row_mutation_word(program, 13ul);
    return merge_length != 0ul
        && set_length != 0ul
        && ig_row_mutation_range(
            merge_offset, merge_length, args.program_key_byte_count)
        && ig_row_mutation_range(
            set_offset, set_length, args.program_key_byte_count);
}

[[clang::noinline]] bool ig_row_mutation_entry_base(
    device const long* program,
    constant RowMutationArgs& args,
    ulong entry,
    thread ulong& base) {
    ulong entry_count = ig_row_mutation_word(program, 3ul);
    ulong relative = 0ul;
    return entry < entry_count
        && ig_row_mutation_product(entry, IG_ROW_MUTATION_ENTRY_WORDS, relative)
        && ig_row_mutation_add(args.program_entry_base, relative, base)
        && ig_row_mutation_range(
            base, IG_ROW_MUTATION_ENTRY_WORDS, args.program_word_count);
}

[[clang::noinline]] bool ig_row_mutation_lane_bytes_equal(
    device const long* words,
    ulong left_base,
    ulong left_offset,
    ulong right_base,
    ulong right_offset,
    ulong length,
    ulong total_words) {
    ulong left = 0ul;
    ulong right = 0ul;
    if (!ig_row_mutation_add(left_base, left_offset, left)
        || !ig_row_mutation_add(right_base, right_offset, right)
        || !ig_row_mutation_range(left, length, total_words)
        || !ig_row_mutation_range(right, length, total_words)) {
        return false;
    }
    for (ulong index = 0ul; index < length; ++index) {
        ulong left_byte = ig_row_mutation_word(words, left + index);
        ulong right_byte = ig_row_mutation_word(words, right + index);
        if (left_byte > 255ul || right_byte > 255ul || left_byte != right_byte) return false;
    }
    return true;
}

[[clang::noinline]] bool ig_row_mutation_key_before(
    device const long* program,
    constant RowMutationArgs& args,
    ulong left_offset,
    ulong left_length,
    ulong right_offset,
    ulong right_length,
    thread bool& valid) {
    valid = ig_row_mutation_range(
            left_offset, left_length, args.program_key_byte_count)
        && ig_row_mutation_range(
            right_offset, right_length, args.program_key_byte_count);
    if (!valid) return false;
    ulong shared = min(left_length, right_length);
    for (ulong index = 0ul; index < shared; ++index) {
        ulong left = ig_row_mutation_word(
            program, args.program_key_byte_base + left_offset + index);
        ulong right = ig_row_mutation_word(
            program, args.program_key_byte_base + right_offset + index);
        if (left > 255ul || right > 255ul) {
            valid = false;
            return false;
        }
        if (left != right) return left < right;
    }
    return left_length < right_length;
}

[[clang::noinline]] bool ig_row_mutation_validate_program_payload(
    device const long* program,
    constant RowMutationArgs& args) {
    ulong entry_count = ig_row_mutation_word(program, 3ul);
    ulong prior_offset = 0ul;
    for (ulong row = 0ul; row <= args.row_count; ++row) {
        ulong offset = ig_row_mutation_word(program, args.program_map_offset_base + row);
        if (offset < prior_offset || offset > entry_count
                || (row == 0ul && offset != 0ul)) {
            return false;
        }
        prior_offset = offset;
    }
    if (prior_offset != entry_count) return false;

    for (ulong index = 0ul; index < args.program_key_byte_count; ++index) {
        if (ig_row_mutation_word(program, args.program_key_byte_base + index) > 255ul) {
            return false;
        }
    }
    for (ulong index = 0ul; index < args.program_value_byte_count; ++index) {
        if (ig_row_mutation_word(program, args.program_value_byte_base + index) > 255ul) {
            return false;
        }
    }
    for (ulong entry = 0ul; entry < entry_count; ++entry) {
        ulong base = 0ul;
        if (!ig_row_mutation_entry_base(program, args, entry, base)) return false;
        ulong key_offset = ig_row_mutation_word(program, base);
        ulong key_length = ig_row_mutation_word(program, base + 1ul);
        ulong tag = ig_row_mutation_word(program, base + 2ul);
        ulong value_offset = ig_row_mutation_word(program, base + 3ul);
        ulong value_length = ig_row_mutation_word(program, base + 4ul);
        if (key_length == 0ul
            || !ig_row_mutation_range(
                key_offset, key_length, args.program_key_byte_count)
            || tag > 1ul
            || !ig_row_mutation_range(
                value_offset, value_length, args.program_value_byte_count)
            || (tag == 0ul && value_length != 0ul)) {
            return false;
        }
    }
    for (ulong row = 0ul; row < args.row_count; ++row) {
        ulong begin = ig_row_mutation_word(program, args.program_map_offset_base + row);
        ulong end = ig_row_mutation_word(program, args.program_map_offset_base + row + 1ul);
        for (ulong entry = begin + ulong(begin < end); entry < end; ++entry) {
            ulong left = 0ul;
            ulong right = 0ul;
            if (!ig_row_mutation_entry_base(program, args, entry - 1ul, left)
                || !ig_row_mutation_entry_base(program, args, entry, right)) {
                return false;
            }
            bool valid = false;
            if (!ig_row_mutation_key_before(
                    program, args,
                    ig_row_mutation_word(program, left),
                    ig_row_mutation_word(program, left + 1ul),
                    ig_row_mutation_word(program, right),
                    ig_row_mutation_word(program, right + 1ul),
                    valid)
                || !valid) {
                return false;
            }
        }
    }
    for (ulong receipt = 0ul; receipt < args.receipt_count; ++receipt) {
        ulong base = args.program_obligation_base + receipt * 4ul;
        if (ig_row_mutation_word(program, base) == 0ul) return false;
        for (ulong prior = 0ul; prior < receipt; ++prior) {
            if (ig_row_mutation_word(program, args.program_obligation_base + prior * 4ul)
                == ig_row_mutation_word(program, base)) {
                return false;
            }
        }
    }
    for (ulong column = 0ul; column < args.output_count; ++column) {
        if (ig_row_mutation_word(program, args.program_output_source_base + column) > 1ul) {
            return false;
        }
    }
    return true;
}

[[clang::noinline]] bool ig_row_mutation_validate_graph_payload(
    device const long* graph,
    constant RowMutationArgs& args) {
    ulong prior = 0ul;
    for (ulong index = 0ul; index < args.graph_dictionary_offset_count; ++index) {
        ulong offset = ig_row_mutation_word(graph, args.graph_dictionary_offset_base + index);
        if (offset < prior || offset > args.graph_dictionary_byte_count
                || (index == 0ul && offset != 0ul)) {
            return false;
        }
        prior = offset;
    }
    if (prior != args.graph_dictionary_byte_count) return false;
    for (ulong index = 0ul; index < args.graph_dictionary_byte_count; ++index) {
        if (ig_row_mutation_word(graph, args.graph_dictionary_byte_base + index) > 255ul) {
            return false;
        }
    }
    return true;
}

inline device atomic_uint* ig_row_mutation_corrupt_word(
    device long* output,
    constant RowMutationArgs& args) {
    return reinterpret_cast<device atomic_uint*>(output + args.output_control_base);
}

inline bool ig_row_mutation_control_layout(constant RowMutationArgs& args) {
    return ig_row_mutation_range(
        args.output_control_base,
        IG_ROW_MUTATION_CONTROL_WORDS,
        args.output_word_count);
}

[[clang::noinline]] void ig_row_mutation_fail(
    device long* output,
    constant RowMutationArgs& args) {
    if (!ig_row_mutation_control_layout(args)) return;
    atomic_store_explicit(
        ig_row_mutation_corrupt_word(output, args), 1u, memory_order_relaxed);
}

[[clang::noinline]] bool ig_row_mutation_corrupt(
    device long* output,
    constant RowMutationArgs& args) {
    if (!ig_row_mutation_control_layout(args)) return true;
    return atomic_load_explicit(
        ig_row_mutation_corrupt_word(output, args), memory_order_relaxed) != 0u;
}

[[clang::noinline]] bool ig_row_mutation_ready(
    device const long* graph,
    device const long* program,
    device long* output,
    constant RowMutationArgs& args) {
    (void)graph;
    (void)program;
    if (ig_row_mutation_corrupt(output, args)) return false;
    if (ig_row_mutation_word(output, args.output_control_base + 1ul)
            != IG_ROW_MUTATION_SEALED) {
        ig_row_mutation_fail(output, args);
        return false;
    }
    return true;
}

// Returns zero for invisible, one for visible, and two for corrupt graph lanes.
[[clang::noinline]] uint ig_row_mutation_node_visible(
    device const long* graph,
    constant RowMutationArgs& args,
    ulong node) {
    if (node >= args.node_count) return 2u;
    ulong active = ig_row_mutation_word(graph, args.graph_node_active_base + node);
    ulong layer = ig_row_mutation_word(graph, args.graph_node_layer_base + node);
    if (active > 1ul || layer >= 64ul) return 2u;
    if (active == 0ul || ((args.layers >> layer) & 1ul) == 0ul) return 0u;
    for (ulong label = 0ul; label < args.label_count; ++label) {
        ulong lane = 0ul;
        ulong position = 0ul;
        if (!ig_row_mutation_product(label, args.node_count, lane)
            || !ig_row_mutation_add(args.graph_label_base, lane, position)
            || !ig_row_mutation_add(position, node, position)
            || !ig_row_mutation_range(position, 1ul, args.graph_word_count)) {
            return 2u;
        }
        ulong member = ig_row_mutation_word(graph, position);
        if (member > 1ul) return 2u;
        if (member == 0ul) return 0u;
    }
    return 1u;
}

// Returns zero for missing, one for found, and two for corrupt packet state.
[[clang::noinline]] uint ig_row_mutation_find_entry(
    device const long* program,
    constant RowMutationArgs& args,
    ulong row,
    ulong key_offset,
    ulong key_length,
    thread ulong& entry) {
    if (row >= args.row_count
        || !ig_row_mutation_range(
            key_offset, key_length, args.program_key_byte_count)) {
        return 2u;
    }
    ulong next = 0ul;
    if (!ig_row_mutation_add(row, 1ul, next)
        || !ig_row_mutation_range(
            args.program_map_offset_base + row, 1ul, args.program_word_count)
        || !ig_row_mutation_range(
            args.program_map_offset_base + next, 1ul, args.program_word_count)) {
        return 2u;
    }
    ulong begin = ig_row_mutation_word(program, args.program_map_offset_base + row);
    ulong end = ig_row_mutation_word(program, args.program_map_offset_base + next);
    ulong entry_count = ig_row_mutation_word(program, 3ul);
    if (begin > end || end > entry_count) return 2u;
    for (ulong candidate = begin; candidate < end; ++candidate) {
        ulong base = 0ul;
        if (!ig_row_mutation_entry_base(program, args, candidate, base)) return 2u;
        ulong candidate_offset = ig_row_mutation_word(program, base);
        ulong candidate_length = ig_row_mutation_word(program, base + 1ul);
        if (candidate_length == key_length
            && ig_row_mutation_lane_bytes_equal(
                program,
                args.program_key_byte_base, candidate_offset,
                args.program_key_byte_base, key_offset,
                key_length, args.program_word_count)) {
            entry = candidate;
            return 1u;
        }
    }
    return 0u;
}

[[clang::noinline]] bool ig_row_mutation_entry_value(
    device const long* program,
    constant RowMutationArgs& args,
    ulong entry,
    thread ulong& tag,
    thread ulong& offset,
    thread ulong& length) {
    ulong base = 0ul;
    if (!ig_row_mutation_entry_base(program, args, entry, base)) return false;
    tag = ig_row_mutation_word(program, base + 2ul);
    offset = ig_row_mutation_word(program, base + 3ul);
    length = ig_row_mutation_word(program, base + 4ul);
    return tag <= 1ul
        && ig_row_mutation_range(offset, length, args.program_value_byte_count)
        && (tag != 0ul || length == 0ul);
}

[[clang::noinline]] bool ig_row_mutation_nullable_string_reference(
    device const long* program,
    constant RowMutationArgs& args,
    ulong row,
    ulong key_offset,
    ulong key_length,
    thread ulong& reference) {
    reference = 0ul;
    ulong entry = 0ul;
    uint found = ig_row_mutation_find_entry(
        program, args, row, key_offset, key_length, entry);
    if (found == 2u) return false;
    if (found == 0u) return true;
    ulong tag = 0ul;
    ulong offset = 0ul;
    ulong length = 0ul;
    if (!ig_row_mutation_entry_value(program, args, entry, tag, offset, length)) {
        return false;
    }
    if (tag == 0ul) return true;
    if (entry == ~0ul) return false;
    reference = entry + 1ul;
    return true;
}

[[clang::noinline]] bool ig_row_mutation_entry_strings_equal(
    device const long* program,
    constant RowMutationArgs& args,
    ulong left_reference,
    ulong right_reference,
    thread bool& equal) {
    equal = false;
    if (left_reference == 0ul || right_reference == 0ul) return false;
    ulong left_tag = 0ul;
    ulong left_offset = 0ul;
    ulong left_length = 0ul;
    ulong right_tag = 0ul;
    ulong right_offset = 0ul;
    ulong right_length = 0ul;
    if (!ig_row_mutation_entry_value(
            program, args, left_reference - 1ul,
            left_tag, left_offset, left_length)
        || !ig_row_mutation_entry_value(
            program, args, right_reference - 1ul,
            right_tag, right_offset, right_length)
        || left_tag != 1ul || right_tag != 1ul) {
        return false;
    }
    equal = left_length == right_length
        && ig_row_mutation_lane_bytes_equal(
            program,
            args.program_value_byte_base, left_offset,
            args.program_value_byte_base, right_offset,
            left_length, args.program_word_count);
    return true;
}

[[clang::noinline]] bool ig_row_mutation_node_property_matches(
    device const long* graph,
    device const long* program,
    constant RowMutationArgs& args,
    ulong node,
    ulong entry,
    thread bool& matches) {
    matches = false;
    if (node >= args.node_count) return false;
    ulong tag = 0ul;
    ulong input_offset = 0ul;
    ulong input_length = 0ul;
    if (!ig_row_mutation_entry_value(
            program, args, entry, tag, input_offset, input_length)
        || tag != 1ul) {
        return false;
    }
    ulong validity = ig_row_mutation_word(
        graph, args.graph_property_validity_base + node);
    if (validity > 1ul) return false;
    if (validity == 0ul) return true;
    ulong value_id = ig_row_mutation_word(
        graph, args.graph_property_value_base + node);
    if (args.graph_dictionary_offset_count == 0ul
        || value_id >= args.graph_dictionary_offset_count - 1ul) {
        return false;
    }
    ulong next_id = value_id + 1ul;
    ulong start = ig_row_mutation_word(
        graph, args.graph_dictionary_offset_base + value_id);
    ulong end = ig_row_mutation_word(
        graph, args.graph_dictionary_offset_base + next_id);
    if (start > end || end > args.graph_dictionary_byte_count) return false;
    ulong width = end - start;
    if (width != input_length) return true;
    ulong graph_start = 0ul;
    ulong input_start = 0ul;
    if (!ig_row_mutation_add(args.graph_dictionary_byte_base, start, graph_start)
        || !ig_row_mutation_add(args.program_value_byte_base, input_offset, input_start)
        || !ig_row_mutation_range(graph_start, width, args.graph_word_count)
        || !ig_row_mutation_range(input_start, width, args.program_word_count)) {
        return false;
    }
    for (ulong index = 0ul; index < width; ++index) {
        ulong graph_byte = ig_row_mutation_word(graph, graph_start + index);
        ulong input_byte = ig_row_mutation_word(program, input_start + index);
        if (graph_byte > 255ul || input_byte > 255ul) return false;
        if (graph_byte != input_byte) return true;
    }
    matches = true;
    return true;
}

kernel void ig_row_mutation_initialize(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    (void)program;
    ulong index = dispatch.logical_base + ulong(gid);
    if (index < args.output_word_count) ig_row_mutation_store(output, index, 0ul);
}

kernel void ig_row_mutation_validate(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    (void)program;
    if (dispatch.logical_base + ulong(gid) != 0ul) return;
    ig_row_mutation_store(
        output, args.output_control_base + 1ul, IG_ROW_MUTATION_SEALED);
}

kernel void ig_row_mutation_dependencies(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)program;
    ulong node = dispatch.logical_base + ulong(gid);
    if (args.row_count == 0ul || node >= args.node_count) return;
    if (ig_row_mutation_corrupt(output, args)) return;
    if (ig_row_mutation_word(output, args.output_control_base + 1ul)
            != IG_ROW_MUTATION_SEALED) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong active = ig_row_mutation_word(graph, args.graph_node_active_base + node);
    ulong layer = ig_row_mutation_word(graph, args.graph_node_layer_base + node);
    if (active > 1ul || layer >= 64ul) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong visible = active == 1ul && ((args.layers >> layer) & 1ul) == 1ul ? 1ul : 0ul;
    for (ulong label = 0ul; visible == 1ul && label < args.label_count; ++label) {
        ulong member = ig_row_mutation_word(
            graph, args.graph_label_base + label * args.node_count + node);
        if (member > 1ul) {
            ig_row_mutation_fail(output, args);
            return;
        }
        if (member == 0ul) visible = 0ul;
    }
    ig_row_mutation_store(
        output, args.output_dependency_base + node, visible);
}

kernel void ig_row_mutation_probe(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    ulong row = dispatch.logical_base + ulong(gid);
    if (row >= args.row_count || ig_row_mutation_corrupt(output, args)) return;
    if (ig_row_mutation_word(output, args.output_control_base + 1ul)
            != IG_ROW_MUTATION_SEALED) {
        ig_row_mutation_fail(output, args);
        return;
    }

    ulong merge_key_offset = ig_row_mutation_word(program, 10ul);
    ulong merge_key_length = ig_row_mutation_word(program, 11ul);
    ulong entry_count = ig_row_mutation_word(program, 3ul);
    ulong begin = ig_row_mutation_word(program, args.program_map_offset_base + row);
    ulong end = ig_row_mutation_word(program, args.program_map_offset_base + row + 1ul);
    if (merge_key_length == 0ul
        || merge_key_offset > args.program_key_byte_count
        || merge_key_length > args.program_key_byte_count - merge_key_offset
        || begin > end || end > entry_count) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong entry = ~0ul;
    for (ulong candidate = begin; candidate < end; ++candidate) {
        ulong base = args.program_entry_base + candidate * IG_ROW_MUTATION_ENTRY_WORDS;
        if (base > args.program_word_count
            || IG_ROW_MUTATION_ENTRY_WORDS > args.program_word_count - base) {
            ig_row_mutation_fail(output, args);
            return;
        }
        ulong candidate_offset = ig_row_mutation_word(program, base);
        ulong candidate_length = ig_row_mutation_word(program, base + 1ul);
        if (candidate_offset > args.program_key_byte_count
            || candidate_length > args.program_key_byte_count - candidate_offset) {
            ig_row_mutation_fail(output, args);
            return;
        }
        if (candidate_length != merge_key_length) continue;
        bool equal = true;
        for (ulong index = 0ul; index < merge_key_length; ++index) {
            ulong candidate_byte = ig_row_mutation_word(
                program, args.program_key_byte_base + candidate_offset + index);
            ulong required_byte = ig_row_mutation_word(
                program, args.program_key_byte_base + merge_key_offset + index);
            if (candidate_byte > 255ul || required_byte > 255ul) {
                ig_row_mutation_fail(output, args);
                return;
            }
            if (candidate_byte != required_byte) {
                equal = false;
                break;
            }
        }
        if (equal) {
            entry = candidate;
            break;
        }
    }
    if (entry == ~0ul) {
        ig_row_mutation_store(output, args.output_row_status_base + row, 1ul);
        return;
    }
    ulong entry_base = args.program_entry_base + entry * IG_ROW_MUTATION_ENTRY_WORDS;
    ulong tag = ig_row_mutation_word(program, entry_base + 2ul);
    ulong offset = ig_row_mutation_word(program, entry_base + 3ul);
    ulong length = ig_row_mutation_word(program, entry_base + 4ul);
    if (tag > 1ul || offset > args.program_value_byte_count
        || length > args.program_value_byte_count - offset
        || (tag == 0ul && length != 0ul)) {
        ig_row_mutation_fail(output, args);
        return;
    }
    if (tag == 0ul) {
        ig_row_mutation_store(output, args.output_row_status_base + row, 1ul);
        return;
    }
    ig_row_mutation_store(output, args.output_merge_ref_base + row, entry + 1ul);

    ulong match_count = 0ul;
    ulong match_id = 0ul;
    ulong match_dense = 0ul;
    for (ulong node = 0ul; node < args.node_count; ++node) {
        ulong active = ig_row_mutation_word(graph, args.graph_node_active_base + node);
        ulong layer = ig_row_mutation_word(graph, args.graph_node_layer_base + node);
        if (active > 1ul || layer >= 64ul) {
            ig_row_mutation_fail(output, args);
            return;
        }
        if (active == 0ul || ((args.layers >> layer) & 1ul) == 0ul) continue;
        bool visible = true;
        for (ulong label = 0ul; visible && label < args.label_count; ++label) {
            ulong member = ig_row_mutation_word(
                graph, args.graph_label_base + label * args.node_count + node);
            if (member > 1ul) {
                ig_row_mutation_fail(output, args);
                return;
            }
            if (member == 0ul) visible = false;
        }
        if (!visible) continue;
        ulong validity = ig_row_mutation_word(
            graph, args.graph_property_validity_base + node);
        if (validity > 1ul) {
            ig_row_mutation_fail(output, args);
            return;
        }
        if (validity == 0ul) continue;
        ulong value_id = ig_row_mutation_word(
            graph, args.graph_property_value_base + node);
        if (args.graph_dictionary_offset_count == 0ul
            || value_id >= args.graph_dictionary_offset_count - 1ul) {
            ig_row_mutation_fail(output, args);
            return;
        }
        ulong start = ig_row_mutation_word(
            graph, args.graph_dictionary_offset_base + value_id);
        ulong finish = ig_row_mutation_word(
            graph, args.graph_dictionary_offset_base + value_id + 1ul);
        if (start > finish || finish > args.graph_dictionary_byte_count) {
            ig_row_mutation_fail(output, args);
            return;
        }
        ulong width = finish - start;
        if (width != length) continue;
        bool matches = true;
        for (ulong index = 0ul; index < width; ++index) {
            ulong graph_byte = ig_row_mutation_word(
                graph, args.graph_dictionary_byte_base + start + index);
            ulong input_byte = ig_row_mutation_word(
                program, args.program_value_byte_base + offset + index);
            if (graph_byte > 255ul || input_byte > 255ul) {
                ig_row_mutation_fail(output, args);
                return;
            }
            if (graph_byte != input_byte) {
                matches = false;
                break;
            }
        }
        if (!matches) continue;
        if (match_count == ~0ul) {
            ig_row_mutation_fail(output, args);
            return;
        }
        ++match_count;
        if (match_count == 1ul) {
            match_id = ig_row_mutation_word(graph, args.graph_node_id_base + node);
            if (match_id == 0ul) {
                ig_row_mutation_fail(output, args);
                return;
            }
            match_dense = node + 1ul;
        }
    }
    ig_row_mutation_store(output, args.output_row_match_base + row, match_count);
    if (match_count > 1ul) {
        ig_row_mutation_store(output, args.output_row_status_base + row, 2ul);
    } else if (match_count == 1ul) {
        ig_row_mutation_store(output, args.output_target_id_base + row, match_id);
        ig_row_mutation_store(output, args.output_target_dense_base + row, match_dense);
    }
}

kernel void ig_row_mutation_resolve(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    ulong row = dispatch.logical_base + ulong(gid);
    if (row >= args.row_count
        || !ig_row_mutation_ready(graph, program, output, args)
        || ig_row_mutation_word(output, args.output_row_status_base + row) != 0ul) {
        return;
    }
    if (ig_row_mutation_word(output, args.output_target_dense_base + row) != 0ul) {
        if (ig_row_mutation_word(output, args.output_target_id_base + row) == 0ul
            || ig_row_mutation_word(output, args.output_target_created_base + row) != 0ul) {
            ig_row_mutation_fail(output, args);
        }
        return;
    }
    ulong own_reference = ig_row_mutation_word(output, args.output_merge_ref_base + row);
    if (own_reference == 0ul) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong leader = row;
    for (ulong prior = 0ul; prior < row; ++prior) {
        if (ig_row_mutation_word(output, args.output_row_status_base + prior) != 0ul) continue;
        ulong prior_reference = ig_row_mutation_word(
            output, args.output_merge_ref_base + prior);
        if (prior_reference == 0ul) {
            ig_row_mutation_fail(output, args);
            return;
        }
        bool equal = false;
        if (!ig_row_mutation_entry_strings_equal(
                program, args, own_reference, prior_reference, equal)) {
            ig_row_mutation_fail(output, args);
            return;
        }
        if (equal) {
            leader = prior;
            break;
        }
    }
    ulong target_id = 0ul;
    ulong created = 0ul;
    if (!ig_row_mutation_add(args.first_node_id, leader, target_id)
        || !ig_row_mutation_add(leader, 1ul, created)
        || target_id == 0ul) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ig_row_mutation_store(output, args.output_target_id_base + row, target_id);
    ig_row_mutation_store(output, args.output_target_created_base + row, created);
}

kernel void ig_row_mutation_finalize(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    ulong row = dispatch.logical_base + ulong(gid);
    if (row >= args.row_count || ig_row_mutation_corrupt(output, args)
        || ig_row_mutation_word(output, args.output_row_status_base + row) != 0ul) {
        return;
    }
    if (ig_row_mutation_word(output, args.output_control_base + 1ul)
            != IG_ROW_MUTATION_SEALED) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong target_id = ig_row_mutation_word(output, args.output_target_id_base + row);
    if (target_id == 0ul) {
        ig_row_mutation_fail(output, args);
        return;
    }

    ulong set_key_offset = ig_row_mutation_word(program, 12ul);
    ulong set_key_length = ig_row_mutation_word(program, 13ul);
    ulong entry_count = ig_row_mutation_word(program, 3ul);
    ulong begin = ig_row_mutation_word(program, args.program_map_offset_base + row);
    ulong end = ig_row_mutation_word(program, args.program_map_offset_base + row + 1ul);
    if (set_key_length == 0ul
        || set_key_offset > args.program_key_byte_count
        || set_key_length > args.program_key_byte_count - set_key_offset
        || begin > end || end > entry_count) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong set_reference = 0ul;
    for (ulong candidate = begin; candidate < end; ++candidate) {
        ulong base = args.program_entry_base + candidate * IG_ROW_MUTATION_ENTRY_WORDS;
        if (base > args.program_word_count
            || IG_ROW_MUTATION_ENTRY_WORDS > args.program_word_count - base) {
            ig_row_mutation_fail(output, args);
            return;
        }
        ulong candidate_offset = ig_row_mutation_word(program, base);
        ulong candidate_length = ig_row_mutation_word(program, base + 1ul);
        if (candidate_offset > args.program_key_byte_count
            || candidate_length > args.program_key_byte_count - candidate_offset) {
            ig_row_mutation_fail(output, args);
            return;
        }
        if (candidate_length != set_key_length) continue;
        bool equal = true;
        for (ulong index = 0ul; index < set_key_length; ++index) {
            ulong candidate_byte = ig_row_mutation_word(
                program, args.program_key_byte_base + candidate_offset + index);
            ulong required_byte = ig_row_mutation_word(
                program, args.program_key_byte_base + set_key_offset + index);
            if (candidate_byte > 255ul || required_byte > 255ul) {
                ig_row_mutation_fail(output, args);
                return;
            }
            if (candidate_byte != required_byte) {
                equal = false;
                break;
            }
        }
        if (!equal) continue;
        ulong tag = ig_row_mutation_word(program, base + 2ul);
        ulong value_offset = ig_row_mutation_word(program, base + 3ul);
        ulong value_length = ig_row_mutation_word(program, base + 4ul);
        if (tag > 1ul || value_offset > args.program_value_byte_count
            || value_length > args.program_value_byte_count - value_offset
            || (tag == 0ul && value_length != 0ul)) {
            ig_row_mutation_fail(output, args);
            return;
        }
        if (tag == 1ul) set_reference = candidate + 1ul;
        break;
    }
    ig_row_mutation_store(output, args.output_set_ref_base + row, set_reference);
    if (row == ~0ul) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong own_created = row + 1ul;
    ig_row_mutation_store(
        output, args.output_create_base + row,
        ig_row_mutation_word(output, args.output_target_created_base + row) == own_created
            ? 1ul : 0ul);
}

kernel void ig_row_mutation_outputs(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    ulong row = dispatch.logical_base + ulong(gid);
    if (row >= args.row_count || ig_row_mutation_corrupt(output, args)
        || ig_row_mutation_word(output, args.output_row_status_base + row) != 0ul) {
        return;
    }
    if (ig_row_mutation_word(output, args.output_control_base + 1ul)
            != IG_ROW_MUTATION_SEALED) {
        ig_row_mutation_fail(output, args);
        return;
    }
    ulong target_id = ig_row_mutation_word(output, args.output_target_id_base + row);
    if (target_id == 0ul) {
        ig_row_mutation_fail(output, args);
        return;
    }
    for (ulong column = 0ul; column < args.output_count; ++column) {
        ulong source = ig_row_mutation_word(
            program, args.program_output_source_base + column);
        ulong reference = 0ul;
        if (source == 0ul) {
            reference = ig_row_mutation_word(output, args.output_merge_ref_base + row);
        } else if (source == 1ul) {
            for (ulong candidate = 0ul; candidate < args.row_count; ++candidate) {
                if (ig_row_mutation_word(
                        output, args.output_row_status_base + candidate) == 0ul
                    && ig_row_mutation_word(
                        output, args.output_target_id_base + candidate) == target_id) {
                    reference = ig_row_mutation_word(
                        output, args.output_set_ref_base + candidate);
                }
            }
        } else {
            ig_row_mutation_fail(output, args);
            return;
        }
        ulong destination = args.output_final_ref_base
            + row * args.output_count + column;
        if (destination >= args.output_word_count) {
            ig_row_mutation_fail(output, args);
            return;
        }
        ig_row_mutation_store(output, destination, reference);
    }
}

kernel void ig_row_mutation_publish(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMutationArgs& args [[buffer(3)]],
    constant RowMutationDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    if (dispatch.logical_base + ulong(gid) != 0ul) return;
    bool program_safe = ig_row_mutation_word(
        output, args.output_control_base + 1ul) == IG_ROW_MUTATION_SEALED;
    bool corrupt = ig_row_mutation_corrupt(output, args)
        || !program_safe;
    ulong status = corrupt ? 3ul : 0ul;
    ulong status_row = 0ul;
    ulong status_detail = 0ul;
    if (!corrupt) {
        for (ulong row = 0ul; row < args.row_count; ++row) {
            ulong row_status = ig_row_mutation_word(
                output, args.output_row_status_base + row);
            if (row_status > 2ul) {
                status = 3ul;
                break;
            }
        }
        if (status == 0ul) {
            for (ulong row = 0ul; row < args.row_count; ++row) {
                if (ig_row_mutation_word(
                        output, args.output_row_status_base + row) == 1ul) {
                    status = 1ul;
                    status_row = row;
                    break;
                }
            }
        }
        if (status == 0ul) {
            for (ulong row = 0ul; row < args.row_count; ++row) {
                if (ig_row_mutation_word(
                        output, args.output_row_status_base + row) != 2ul) continue;
                status = 2ul;
                status_row = row;
                status_detail = ig_row_mutation_word(
                    output, args.output_row_match_base + row);
                if (status_detail <= 1ul) status = 3ul;
                break;
            }
        }
    }

    ulong intent_count = 0ul;
    ulong dependency_count = 0ul;
    if (status == 0ul) {
        intent_count = args.row_count;
        for (ulong row = 0ul; row < args.row_count; ++row) {
            ulong create = ig_row_mutation_word(output, args.output_create_base + row);
            if (create > 1ul || (create == 1ul && intent_count == ~0ul)) {
                status = 3ul;
                intent_count = 0ul;
                break;
            }
            intent_count += create;
        }
        if (status == 0ul) {
            for (ulong node = 0ul; node < args.node_count; ++node) {
                ulong dependency = ig_row_mutation_word(
                    output, args.output_dependency_base + node);
                if (dependency > 1ul
                    || (dependency == 1ul && dependency_count == ~0ul)) {
                    status = 3ul;
                    intent_count = 0ul;
                    dependency_count = 0ul;
                    break;
                }
                dependency_count += dependency;
            }
        }
    }
    if (status != 0ul) {
        intent_count = 0ul;
        dependency_count = 0ul;
    }

    for (ulong header = 0ul; header < IG_ROW_MUTATION_OUTPUT_HEADER_WORDS; ++header) {
        ig_row_mutation_store(output, header, 0ul);
    }
    ig_row_mutation_store(output, 0ul, IG_ROW_MUTATION_OUTPUT_MAGIC);
    ig_row_mutation_store(output, 1ul, IG_ROW_MUTATION_OUTPUT_VERSION);
    ig_row_mutation_store(output, 2ul, status);
    ig_row_mutation_store(output, 3ul, 2ul);
    ig_row_mutation_store(output, 4ul, args.execution_high);
    ig_row_mutation_store(output, 5ul, args.execution_low);
    ig_row_mutation_store(output, 6ul, args.project_high);
    ig_row_mutation_store(output, 7ul, args.project_low);
    ig_row_mutation_store(output, 8ul, args.bookmark_term);
    ig_row_mutation_store(output, 9ul, args.bookmark_index);
    ig_row_mutation_store(output, 10ul, args.graph_revision);
    ig_row_mutation_store(output, 11ul, args.layout_version);
    ig_row_mutation_store(output, 12ul, args.fingerprint_0);
    ig_row_mutation_store(output, 13ul, args.fingerprint_1);
    ig_row_mutation_store(output, 14ul, args.fingerprint_2);
    ig_row_mutation_store(output, 15ul, args.fingerprint_3);
    ig_row_mutation_store(output, 16ul, args.row_count);
    ig_row_mutation_store(output, 17ul, intent_count);
    ig_row_mutation_store(output, 18ul, dependency_count);
    ig_row_mutation_store(output, 19ul, args.receipt_count);
    ig_row_mutation_store(output, 20ul, args.output_count);
    ig_row_mutation_store(output, 21ul, args.program_word_count);
    ig_row_mutation_store(output, 22ul, args.graph_word_count);
    ig_row_mutation_store(output, 23ul, args.output_word_count);
    ig_row_mutation_store(output, 24ul, args.first_node_id);
    ig_row_mutation_store(output, 25ul, args.layers);
    ig_row_mutation_store(output, 27ul, status_row);
    ig_row_mutation_store(output, 28ul, status_detail);
    ig_row_mutation_store(output, 29ul, args.node_count);
    ig_row_mutation_store(output, 30ul, args.label_count);
    ig_row_mutation_store(output, 31ul, 1ul);
    ig_row_mutation_store(output, 32ul, args.catalog_0);
    ig_row_mutation_store(output, 33ul, args.catalog_1);
    ig_row_mutation_store(output, 34ul, args.catalog_2);
    ig_row_mutation_store(output, 35ul, args.catalog_3);

    for (ulong receipt = 0ul; receipt < args.receipt_count; ++receipt) {
        ulong target = args.output_receipt_base
            + receipt * IG_ROW_MUTATION_RECEIPT_WORDS;
        ig_row_mutation_store(output, target, args.execution_high);
        ig_row_mutation_store(output, target + 1ul, args.execution_low);
        if (program_safe) {
            ulong source = args.program_obligation_base + receipt * 4ul;
            ig_row_mutation_store(
                output, target + 2ul, ig_row_mutation_word(program, source));
            ig_row_mutation_store(
                output, target + 3ul, ig_row_mutation_word(program, source + 1ul));
            ig_row_mutation_store(
                output, target + 4ul, ig_row_mutation_word(program, source + 2ul));
            ig_row_mutation_store(
                output, target + 5ul, ig_row_mutation_word(program, source + 3ul));
        } else {
            for (ulong word = 2ul; word <= 5ul; ++word) {
                ig_row_mutation_store(output, target + word, 0ul);
            }
        }
        ig_row_mutation_store(
            output, target + 6ul, receipt == 0ul ? 1ul : args.row_count);
        ig_row_mutation_store(
            output, target + 7ul,
            receipt == 0ul || status == 0ul ? args.row_count : 0ul);
        ig_row_mutation_store(output, target + 8ul, 2ul);
    }
    // A host decoder may trust no prior field until this final publication word is visible.
    ig_row_mutation_store(output, 26ul, IG_ROW_MUTATION_SEALED);
}

// Specialized generalized row mutation:
// UNWIND -> correlated node MATCH -> node MERGE -> relationship MERGE -> integer ORDER BY.
// This v2 ABI is intentionally independent from the v1 ig_row_mutation_* path above.
constant ulong IG_ROW_MMR_GRAPH_MAGIC = 0x475243524d4d5232ul;
constant ulong IG_ROW_MMR_PROGRAM_MAGIC = 0x505243524d4d5232ul;
constant ulong IG_ROW_MMR_PROGRAM_VERSION = 2ul;
constant ulong IG_ROW_MMR_PROGRAM_HEADER_WORDS = 32ul;
constant ulong IG_ROW_MMR_ENTRY_WORDS = 5ul;
constant ulong IG_ROW_MMR_OUTPUT_MAGIC = 0x4f5243524d4d5232ul;
constant ulong IG_ROW_MMR_OUTPUT_VERSION = 2ul;
constant ulong IG_ROW_MMR_OUTPUT_HEADER_WORDS = 48ul;
constant ulong IG_ROW_MMR_RECEIPT_WORDS = 9ul;
constant ulong IG_ROW_MMR_CONTROL_WORDS = 16ul;
constant ulong IG_ROW_MMR_SEALED = 0x5345414c4d4d5232ul;
constant ulong IG_ROW_MMR_COMPLETION_METAL = 2ul;

constant ulong IG_ROW_MMR_STATUS_SUCCESS = 0ul;
constant ulong IG_ROW_MMR_STATUS_NULL_NODE_KEY = 1ul;
constant ulong IG_ROW_MMR_STATUS_UNSUPPORTED_NODE_KEY = 2ul;
constant ulong IG_ROW_MMR_STATUS_MULTIPLE_NODE_MATCHES = 3ul;
constant ulong IG_ROW_MMR_STATUS_MULTIPLE_RELATIONSHIP_MATCHES = 4ul;
constant ulong IG_ROW_MMR_STATUS_CORRUPT_PACKET = 5ul;
constant ulong IG_ROW_MMR_STATUS_OUTPUT_BUDGET = 6ul;
constant ulong IG_ROW_MMR_STATUS_ID_COLLISION = 7ul;

struct RowMmrArgs {
    ulong execution_high;
    ulong execution_low;
    ulong project_high;
    ulong project_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong catalog_0;
    ulong catalog_1;
    ulong catalog_2;
    ulong catalog_3;
    ulong fingerprint_0;
    ulong fingerprint_1;
    ulong fingerprint_2;
    ulong fingerprint_3;
    ulong graph_word_count;
    ulong program_word_count;
    ulong output_word_count;
    ulong source_count;
    ulong node_count;
    ulong edge_count;
    ulong pair_count;
    ulong maximum_work_rows;
    ulong receipt_count;
    ulong first_node_id;
    ulong first_edge_id;
    ulong layers;
    ulong relationship_type_present;
    ulong relationship_type_token;
    ulong graph_node_active_base;
    ulong graph_node_layer_base;
    ulong graph_node_id_base;
    ulong graph_matched_label_base;
    ulong graph_merged_label_base;
    ulong graph_matched_value_base;
    ulong graph_matched_validity_base;
    ulong graph_merged_value_base;
    ulong graph_merged_validity_base;
    ulong graph_edge_active_base;
    ulong graph_edge_layer_base;
    ulong graph_edge_id_base;
    ulong graph_edge_source_base;
    ulong graph_edge_target_base;
    ulong graph_edge_type_base;
    ulong program_map_offset_base;
    ulong program_entry_base;
    ulong program_key_byte_base;
    ulong program_key_byte_count;
    ulong program_match_key_offset;
    ulong program_match_key_length;
    ulong program_merge_key_offset;
    ulong program_merge_key_length;
    ulong program_obligation_base;
    ulong output_receipt_base;
    ulong output_pair_active_base;
    ulong output_work_source_base;
    ulong output_matched_id_base;
    ulong output_matched_dense_base;
    ulong output_merged_id_base;
    ulong output_merged_dense_base;
    ulong output_merged_created_base;
    ulong output_relationship_id_base;
    ulong output_relationship_dense_base;
    ulong output_relationship_created_base;
    ulong output_node_create_base;
    ulong output_relationship_create_base;
    ulong output_node_dependency_base;
    ulong output_relationship_dependency_base;
    ulong output_sorted_value_base;
    ulong output_sorted_work_base;
    ulong output_control_base;
};

struct RowMmrDispatchArgs {
    ulong logical_base;
};

inline ulong ig_row_mmr_word(device const long* words, ulong index) {
    return as_type<ulong>(words[index]);
}

inline void ig_row_mmr_store(device long* words, ulong index, ulong value) {
    words[index] = as_type<long>(value);
}

inline bool ig_row_mmr_range(ulong base, ulong count, ulong total) {
    return base <= total && count <= total - base;
}

inline bool ig_row_mmr_add(ulong left, ulong right, thread ulong& result) {
    if (right > ~0ul - left) return false;
    result = left + right;
    return true;
}

inline bool ig_row_mmr_product(ulong left, ulong right, thread ulong& result) {
    if (left != 0ul && right > ~0ul / left) return false;
    result = left * right;
    return true;
}

inline bool ig_row_mmr_take(
    thread ulong& cursor,
    ulong expected,
    ulong count,
    ulong total) {
    if (cursor != expected || !ig_row_mmr_range(cursor, count, total)) return false;
    cursor += count;
    return true;
}

inline device atomic_uint* ig_row_mmr_corruption_word(
    device long* output,
    constant RowMmrArgs& args) {
    return reinterpret_cast<device atomic_uint*>(
        output + args.output_control_base + 1ul);
}

inline void ig_row_mmr_mark_corrupt(
    device long* output,
    constant RowMmrArgs& args) {
    if (ig_row_mmr_range(
            args.output_control_base,
            IG_ROW_MMR_CONTROL_WORDS,
            args.output_word_count)) {
        atomic_fetch_or_explicit(
            ig_row_mmr_corruption_word(output, args), 1u, memory_order_relaxed);
        return;
    }
    // A malformed control base must not turn packet validation into an out-of-bounds write.
    if (args.output_word_count >= IG_ROW_MMR_CONTROL_WORDS) {
        ulong fallback = args.output_word_count - IG_ROW_MMR_CONTROL_WORDS + 1ul;
        device atomic_uint* word =
            reinterpret_cast<device atomic_uint*>(output + fallback);
        atomic_fetch_or_explicit(word, 1u, memory_order_relaxed);
    }
}

inline bool ig_row_mmr_is_corrupt(
    device long* output,
    constant RowMmrArgs& args) {
    if (!ig_row_mmr_range(
            args.output_control_base,
            IG_ROW_MMR_CONTROL_WORDS,
            args.output_word_count)) {
        return true;
    }
    return atomic_load_explicit(
        ig_row_mmr_corruption_word(output, args), memory_order_relaxed) != 0u;
}

// Returns 0 for missing/NULL, 1 for integer, 2 for another type, and 3 for corruption.
inline uint ig_row_mmr_map_integer(
    device const long* program,
    constant RowMmrArgs& args,
    ulong source,
    ulong required_offset,
    ulong required_length,
    thread ulong& value_bits) {
    value_bits = 0ul;
    if (source >= args.source_count || required_length == 0ul
        || !ig_row_mmr_range(
            required_offset, required_length, args.program_key_byte_count)) {
        return 3u;
    }
    ulong entry_count = ig_row_mmr_word(program, 3ul);
    ulong begin = ig_row_mmr_word(program, args.program_map_offset_base + source);
    ulong end = ig_row_mmr_word(program, args.program_map_offset_base + source + 1ul);
    if (begin > end || end > entry_count) return 3u;
    for (ulong entry = begin; entry < end; ++entry) {
        ulong relative = 0ul;
        ulong base = 0ul;
        if (!ig_row_mmr_product(entry, IG_ROW_MMR_ENTRY_WORDS, relative)
            || !ig_row_mmr_add(args.program_entry_base, relative, base)
            || !ig_row_mmr_range(
                base, IG_ROW_MMR_ENTRY_WORDS, args.program_word_count)) {
            return 3u;
        }
        ulong candidate_offset = ig_row_mmr_word(program, base);
        ulong candidate_length = ig_row_mmr_word(program, base + 1ul);
        if (!ig_row_mmr_range(
                candidate_offset,
                candidate_length,
                args.program_key_byte_count)
            || ig_row_mmr_word(program, base + 4ul) != 0ul) {
            return 3u;
        }
        if (candidate_length != required_length) continue;
        bool equal = true;
        for (ulong index = 0ul; index < required_length; ++index) {
            ulong candidate = ig_row_mmr_word(
                program,
                args.program_key_byte_base + candidate_offset + index);
            ulong required = ig_row_mmr_word(
                program,
                args.program_key_byte_base + required_offset + index);
            if (candidate > 255ul || required > 255ul) return 3u;
            if (candidate != required) {
                equal = false;
                break;
            }
        }
        if (!equal) continue;
        ulong tag = ig_row_mmr_word(program, base + 2ul);
        value_bits = ig_row_mmr_word(program, base + 3ul);
        if (tag == 0ul) return value_bits == 0ul ? 0u : 3u;
        return tag == 2ul ? 1u : 2u;
    }
    return 0u;
}

kernel void ig_row_mmr_initialize(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    (void)program;
    ulong local = ulong(gid);
    if (local > ~0ul - dispatch.logical_base) return;
    ulong index = dispatch.logical_base + local;
    if (index < args.output_word_count) ig_row_mmr_store(output, index, 0ul);
}

kernel void ig_row_mmr_validate_output(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    (void)program;
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    // The host custom op has already checked every packet base and exact byte count before this
    // command buffer exists. Keep the device handshake deliberately small: older Apple drivers
    // terminate their compiler service when one kernel references the complete 72-word ABI.
    // Data lanes, map ordering, graph values, and final lineage are still validated by the later
    // split kernels before publication.
    if (args.output_control_base > args.output_word_count
        || IG_ROW_MMR_CONTROL_WORDS
            > args.output_word_count - args.output_control_base) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ig_row_mmr_store(output, args.output_control_base + 6ul, 4ul);
}

kernel void ig_row_mmr_validate_graph(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)program;
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    bool valid = !ig_row_mmr_is_corrupt(output, args)
        && ig_row_mmr_range(
            args.output_control_base,
            IG_ROW_MMR_CONTROL_WORDS,
            args.output_word_count)
        && ig_row_mmr_word(output, args.output_control_base) == 0ul
        && ig_row_mmr_word(output, args.output_control_base + 6ul) == 4ul;

    ulong graph_cursor = 1ul;
    if (valid && (ig_row_mmr_word(graph, 0ul) != IG_ROW_MMR_GRAPH_MAGIC
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_node_active_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_node_layer_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_node_id_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_matched_label_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_merged_label_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_matched_value_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_matched_validity_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_merged_value_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_merged_validity_base,
            args.node_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_edge_active_base,
            args.edge_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_edge_layer_base,
            args.edge_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_edge_id_base,
            args.edge_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_edge_source_base,
            args.edge_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_edge_target_base,
            args.edge_count,
            args.graph_word_count)
        || !ig_row_mmr_take(
            graph_cursor,
            args.graph_edge_type_base,
            args.edge_count,
            args.graph_word_count)
        || graph_cursor != args.graph_word_count)) {
        valid = false;
    }

    if (!valid) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ig_row_mmr_store(output, args.output_control_base + 6ul, 5ul);
}

kernel void ig_row_mmr_validate_program(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    bool valid = !ig_row_mmr_is_corrupt(output, args)
        && ig_row_mmr_range(
            args.output_control_base,
            IG_ROW_MMR_CONTROL_WORDS,
            args.output_word_count)
        && ig_row_mmr_word(output, args.output_control_base) == 0ul
        && ig_row_mmr_word(output, args.output_control_base + 6ul) == 5ul;

    ulong entry_count = valid ? ig_row_mmr_word(program, 3ul) : 0ul;
    ulong map_words = 0ul;
    ulong entry_words = 0ul;
    ulong obligation_words = 0ul;
    if (!ig_row_mmr_add(args.source_count, 1ul, map_words)
        || !ig_row_mmr_product(entry_count, IG_ROW_MMR_ENTRY_WORDS, entry_words)
        || !ig_row_mmr_product(args.receipt_count, 4ul, obligation_words)) {
        valid = false;
    }
    if (valid && (ig_row_mmr_word(program, 0ul) != IG_ROW_MMR_PROGRAM_MAGIC
        || ig_row_mmr_word(program, 1ul) != IG_ROW_MMR_PROGRAM_VERSION
        || ig_row_mmr_word(program, 2ul) != args.source_count
        || ig_row_mmr_word(program, 4ul) != args.program_map_offset_base
        || ig_row_mmr_word(program, 5ul) != args.program_entry_base
        || ig_row_mmr_word(program, 6ul) != args.program_key_byte_base
        || ig_row_mmr_word(program, 7ul) != args.program_key_byte_count
        || ig_row_mmr_word(program, 8ul) != args.program_match_key_offset
        || ig_row_mmr_word(program, 9ul) != args.program_match_key_length
        || ig_row_mmr_word(program, 10ul) != args.program_merge_key_offset
        || ig_row_mmr_word(program, 11ul) != args.program_merge_key_length
        || ig_row_mmr_word(program, 12ul) != args.receipt_count
        || ig_row_mmr_word(program, 13ul) != args.program_obligation_base
        || ig_row_mmr_word(program, 14ul) != args.first_node_id
        || ig_row_mmr_word(program, 15ul) != args.first_edge_id
        || ig_row_mmr_word(program, 16ul) != args.layers
        || ig_row_mmr_word(program, 17ul) != args.maximum_work_rows
        || ig_row_mmr_word(program, 18ul) != IG_ROW_MMR_SEALED
        || args.program_match_key_length == 0ul
        || args.program_merge_key_length == 0ul
        || !ig_row_mmr_range(
            args.program_match_key_offset,
            args.program_match_key_length,
            args.program_key_byte_count)
        || !ig_row_mmr_range(
            args.program_merge_key_offset,
            args.program_merge_key_length,
            args.program_key_byte_count))) {
        valid = false;
    }
    if (valid) {
        for (ulong reserved = 19ul; reserved < IG_ROW_MMR_PROGRAM_HEADER_WORDS; ++reserved) {
            if (ig_row_mmr_word(program, reserved) != 0ul) {
                valid = false;
                break;
            }
        }
    }
    ulong program_cursor = IG_ROW_MMR_PROGRAM_HEADER_WORDS;
    if (valid && (!ig_row_mmr_take(
            program_cursor,
            args.program_map_offset_base,
            map_words,
            args.program_word_count)
        || !ig_row_mmr_take(
            program_cursor,
            args.program_entry_base,
            entry_words,
            args.program_word_count)
        || !ig_row_mmr_take(
            program_cursor,
            args.program_key_byte_base,
            args.program_key_byte_count,
            args.program_word_count)
        || !ig_row_mmr_take(
            program_cursor,
            args.program_obligation_base,
            obligation_words,
            args.program_word_count)
        || program_cursor != args.program_word_count)) {
        valid = false;
    }

    if (valid) {
        ulong prior = 0ul;
        for (ulong row = 0ul; row <= args.source_count; ++row) {
            ulong offset = ig_row_mmr_word(
                program, args.program_map_offset_base + row);
            if (offset < prior || offset > entry_count
                || (row == 0ul && offset != 0ul)) {
                valid = false;
                break;
            }
            prior = offset;
        }
        if (prior != entry_count) valid = false;
    }
    if (valid) {
        for (ulong index = 0ul; index < args.program_key_byte_count; ++index) {
            if (ig_row_mmr_word(
                    program, args.program_key_byte_base + index) > 255ul) {
                valid = false;
                break;
            }
        }
    }
    if (valid) {
        for (ulong entry = 0ul; entry < entry_count; ++entry) {
            ulong base = args.program_entry_base + entry * IG_ROW_MMR_ENTRY_WORDS;
            ulong key_offset = ig_row_mmr_word(program, base);
            ulong key_length = ig_row_mmr_word(program, base + 1ul);
            ulong tag = ig_row_mmr_word(program, base + 2ul);
            ulong value_bits = ig_row_mmr_word(program, base + 3ul);
            if (key_length == 0ul
                || !ig_row_mmr_range(
                    key_offset, key_length, args.program_key_byte_count)
                || ig_row_mmr_word(program, base + 4ul) != 0ul
                || tag > 13ul
                || (tag == 0ul && value_bits != 0ul)
                || (tag == 1ul && value_bits > 1ul)
                || ((tag == 4ul || tag == 5ul || tag >= 8ul)
                    && value_bits != 0ul)) {
                valid = false;
                break;
            }
        }
    }

    if (!valid) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ig_row_mmr_store(output, args.output_control_base + 6ul, 6ul);
}

kernel void ig_row_mmr_validate_semantics(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    bool valid = !ig_row_mmr_is_corrupt(output, args)
        && ig_row_mmr_range(
            args.output_control_base,
            IG_ROW_MMR_CONTROL_WORDS,
            args.output_word_count)
        && ig_row_mmr_word(output, args.output_control_base) == 0ul
        && ig_row_mmr_word(output, args.output_control_base + 6ul) == 6ul;
    // Every raw map is strictly key-ordered. This also proves that lookup cannot find two values.
    if (valid) {
        for (ulong row = 0ul; row < args.source_count && valid; ++row) {
            ulong begin = ig_row_mmr_word(
                program, args.program_map_offset_base + row);
            ulong end = ig_row_mmr_word(
                program, args.program_map_offset_base + row + 1ul);
            for (ulong entry = begin + ulong(begin < end); entry < end; ++entry) {
                ulong left = args.program_entry_base
                    + (entry - 1ul) * IG_ROW_MMR_ENTRY_WORDS;
                ulong right = args.program_entry_base
                    + entry * IG_ROW_MMR_ENTRY_WORDS;
                ulong left_offset = ig_row_mmr_word(program, left);
                ulong left_length = ig_row_mmr_word(program, left + 1ul);
                ulong right_offset = ig_row_mmr_word(program, right);
                ulong right_length = ig_row_mmr_word(program, right + 1ul);
                ulong shared = min(left_length, right_length);
                bool ordered = false;
                bool decided = false;
                for (ulong index = 0ul; index < shared; ++index) {
                    ulong left_byte = ig_row_mmr_word(
                        program,
                        args.program_key_byte_base + left_offset + index);
                    ulong right_byte = ig_row_mmr_word(
                        program,
                        args.program_key_byte_base + right_offset + index);
                    if (left_byte != right_byte) {
                        ordered = left_byte < right_byte;
                        decided = true;
                        break;
                    }
                }
                if (!decided) ordered = left_length < right_length;
                if (!ordered) {
                    valid = false;
                    break;
                }
            }
        }
    }
    if (valid) {
        for (ulong receipt = 0ul; receipt < args.receipt_count; ++receipt) {
            ulong base = args.program_obligation_base + receipt * 4ul;
            ulong id = ig_row_mmr_word(program, base);
            if (id == 0ul) {
                valid = false;
                break;
            }
            for (ulong prior = 0ul; prior < receipt; ++prior) {
                if (ig_row_mmr_word(
                        program,
                        args.program_obligation_base + prior * 4ul) == id) {
                    valid = false;
                    break;
                }
            }
            if (!valid) break;
        }
    }
    if (valid) {
        for (ulong word = 0ul; word < IG_ROW_MMR_CONTROL_WORDS; ++word) {
            if (word == 6ul) continue;
            if (ig_row_mmr_word(output, args.output_control_base + word) != 0ul) {
                valid = false;
                break;
            }
        }
    }
    if (!valid) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    // No later stage may trust any packet lane before this ready seal is visible.
    ig_row_mmr_store(output, args.output_control_base + 6ul, 0ul);
    ig_row_mmr_store(output, args.output_control_base, IG_ROW_MMR_SEALED);
}

kernel void ig_row_mmr_dependencies(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)program;
    ulong local = ulong(gid);
    if (local > ~0ul - dispatch.logical_base) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ulong row = dispatch.logical_base + local;
    if (row >= max(args.node_count, args.edge_count)) return;
    if (ig_row_mmr_is_corrupt(output, args)) return;
    if (ig_row_mmr_word(output, args.output_control_base) != IG_ROW_MMR_SEALED) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (ig_row_mmr_word(output, args.output_control_base + 2ul)
        != IG_ROW_MMR_STATUS_SUCCESS) {
        return;
    }
    if (row < args.node_count) {
        ulong active = ig_row_mmr_word(graph, args.graph_node_active_base + row);
        ulong layer = ig_row_mmr_word(graph, args.graph_node_layer_base + row);
        if (active > 1ul || layer >= 64ul) {
            ig_row_mmr_mark_corrupt(output, args);
        } else {
            ulong selected = active != 0ul && ((args.layers >> layer) & 1ul) != 0ul
                ? 1ul : 0ul;
            ig_row_mmr_store(
                output, args.output_node_dependency_base + row, selected);
        }
    }
    if (row < args.edge_count) {
        ulong active = ig_row_mmr_word(graph, args.graph_edge_active_base + row);
        ulong layer = ig_row_mmr_word(graph, args.graph_edge_layer_base + row);
        if (active > 1ul || layer >= 64ul) {
            ig_row_mmr_mark_corrupt(output, args);
        } else {
            ulong selected = active != 0ul && ((args.layers >> layer) & 1ul) != 0ul
                ? 1ul : 0ul;
            ig_row_mmr_store(
                output, args.output_relationship_dependency_base + row, selected);
        }
    }
}

kernel void ig_row_mmr_match(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    ulong local = ulong(gid);
    if (local > ~0ul - dispatch.logical_base) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ulong pair = dispatch.logical_base + local;
    if (pair >= args.pair_count) return;
    if (ig_row_mmr_is_corrupt(output, args)) return;
    if (ig_row_mmr_word(output, args.output_control_base) != IG_ROW_MMR_SEALED) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (ig_row_mmr_word(output, args.output_control_base + 2ul)
        != IG_ROW_MMR_STATUS_SUCCESS) {
        return;
    }
    if (args.node_count == 0ul) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ulong source = pair / args.node_count;
    ulong node = pair - source * args.node_count;
    ulong input_bits = 0ul;
    uint input_kind = ig_row_mmr_map_integer(
        program,
        args,
        source,
        args.program_match_key_offset,
        args.program_match_key_length,
        input_bits);
    if (input_kind == 3u) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    // NULL and non-integer MATCH operands have ordinary predicate semantics: no row survives.
    if (input_kind != 1u) return;

    ulong active = ig_row_mmr_word(graph, args.graph_node_active_base + node);
    ulong layer = ig_row_mmr_word(graph, args.graph_node_layer_base + node);
    ulong label = ig_row_mmr_word(graph, args.graph_matched_label_base + node);
    ulong validity = ig_row_mmr_word(graph, args.graph_matched_validity_base + node);
    if (active > 1ul || layer >= 64ul || label > 1ul || validity > 1ul) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (active == 0ul || ((args.layers >> layer) & 1ul) == 0ul
        || label == 0ul || validity == 0ul
        || ig_row_mmr_word(graph, args.graph_matched_value_base + node) != input_bits) {
        return;
    }
    if (ig_row_mmr_word(graph, args.graph_node_id_base + node) == 0ul
        || ig_row_mmr_word(output, args.output_node_dependency_base + node) != 1ul) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ig_row_mmr_store(output, args.output_pair_active_base + pair, 1ul);
}

kernel void ig_row_mmr_compact(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)program;
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    if (ig_row_mmr_is_corrupt(output, args)) return;
    if (ig_row_mmr_word(output, args.output_control_base) != IG_ROW_MMR_SEALED) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (ig_row_mmr_word(output, args.output_control_base + 2ul)
        != IG_ROW_MMR_STATUS_SUCCESS) {
        return;
    }
    ulong work_count = 0ul;
    ulong first_excess_source = 0ul;
    bool exceeded = false;
    for (ulong pair = 0ul; pair < args.pair_count; ++pair) {
        ulong active = ig_row_mmr_word(output, args.output_pair_active_base + pair);
        if (active > 1ul) {
            ig_row_mmr_mark_corrupt(output, args);
            return;
        }
        if (active == 0ul) continue;
        if (args.node_count == 0ul) {
            ig_row_mmr_mark_corrupt(output, args);
            return;
        }
        ulong source = pair / args.node_count;
        ulong node = pair - source * args.node_count;
        if (work_count < args.maximum_work_rows) {
            ulong target_id = ig_row_mmr_word(graph, args.graph_node_id_base + node);
            if (source >= args.source_count || node >= args.node_count || target_id == 0ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            ig_row_mmr_store(
                output, args.output_work_source_base + work_count, source);
            ig_row_mmr_store(
                output, args.output_matched_id_base + work_count, target_id);
            ig_row_mmr_store(
                output, args.output_matched_dense_base + work_count, node + 1ul);
        } else if (!exceeded) {
            exceeded = true;
            first_excess_source = source;
        }
        if (work_count == ~0ul) {
            ig_row_mmr_mark_corrupt(output, args);
            return;
        }
        ++work_count;
    }
    ig_row_mmr_store(output, args.output_control_base + 5ul, work_count);
    if (exceeded) {
        ig_row_mmr_store(
            output,
            args.output_control_base + 2ul,
            IG_ROW_MMR_STATUS_OUTPUT_BUDGET);
        ig_row_mmr_store(
            output, args.output_control_base + 3ul, first_excess_source);
        ig_row_mmr_store(output, args.output_control_base + 4ul, work_count);
    }
}

kernel void ig_row_mmr_node_merge(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    if (ig_row_mmr_is_corrupt(output, args)) return;
    if (ig_row_mmr_word(output, args.output_control_base) != IG_ROW_MMR_SEALED) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (ig_row_mmr_word(output, args.output_control_base + 2ul)
        != IG_ROW_MMR_STATUS_SUCCESS) {
        return;
    }
    ulong work_count = ig_row_mmr_word(output, args.output_control_base + 5ul);
    if (work_count > args.maximum_work_rows) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }

    // Cypher evaluates every surviving node-MERGE key before exposing any write effect.
    for (ulong work = 0ul; work < work_count; ++work) {
        ulong source = ig_row_mmr_word(output, args.output_work_source_base + work);
        ulong value_bits = 0ul;
        uint kind = ig_row_mmr_map_integer(
            program,
            args,
            source,
            args.program_merge_key_offset,
            args.program_merge_key_length,
            value_bits);
        (void)value_bits;
        if (kind == 3u || source >= args.source_count) {
            ig_row_mmr_mark_corrupt(output, args);
            return;
        }
        if (kind == 0u || kind == 2u) {
            ig_row_mmr_store(
                output,
                args.output_control_base + 2ul,
                kind == 0u ? IG_ROW_MMR_STATUS_NULL_NODE_KEY
                            : IG_ROW_MMR_STATUS_UNSUPPORTED_NODE_KEY);
            ig_row_mmr_store(output, args.output_control_base + 3ul, source);
            ig_row_mmr_store(output, args.output_control_base + 4ul, 0ul);
            return;
        }
    }

    for (ulong work = 0ul; work < work_count; ++work) {
        ulong source = ig_row_mmr_word(output, args.output_work_source_base + work);
        ulong merge_bits = 0ul;
        uint kind = ig_row_mmr_map_integer(
            program,
            args,
            source,
            args.program_merge_key_offset,
            args.program_merge_key_length,
            merge_bits);
        if (kind != 1u) {
            ig_row_mmr_mark_corrupt(output, args);
            return;
        }

        ulong match_count = 0ul;
        ulong target_id = 0ul;
        ulong target_dense = 0ul;
        ulong target_created = 0ul;
        for (ulong node = 0ul; node < args.node_count; ++node) {
            ulong active = ig_row_mmr_word(graph, args.graph_node_active_base + node);
            ulong layer = ig_row_mmr_word(graph, args.graph_node_layer_base + node);
            ulong label = ig_row_mmr_word(graph, args.graph_merged_label_base + node);
            ulong validity = ig_row_mmr_word(
                graph, args.graph_merged_validity_base + node);
            if (active > 1ul || layer >= 64ul || label > 1ul || validity > 1ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (active == 0ul || ((args.layers >> layer) & 1ul) == 0ul) continue;
            ulong node_id = ig_row_mmr_word(graph, args.graph_node_id_base + node);
            if (node_id == 0ul
                || ig_row_mmr_word(
                    output, args.output_node_dependency_base + node) != 1ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (label == 0ul || validity == 0ul
                || ig_row_mmr_word(graph, args.graph_merged_value_base + node)
                    != merge_bits) {
                continue;
            }
            if (match_count == ~0ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            ++match_count;
            if (match_count == 1ul) {
                target_id = node_id;
                target_dense = node + 1ul;
                target_created = 0ul;
            }
        }
        // Only creation leaders represent statement-local candidate nodes. Reused rows do not
        // multiply the same logical candidate.
        for (ulong prior = 0ul; prior < work; ++prior) {
            ulong create = ig_row_mmr_word(
                output, args.output_node_create_base + prior);
            if (create > 1ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (create == 0ul) continue;
            ulong prior_source = ig_row_mmr_word(
                output, args.output_work_source_base + prior);
            ulong prior_bits = 0ul;
            uint prior_kind = ig_row_mmr_map_integer(
                program,
                args,
                prior_source,
                args.program_merge_key_offset,
                args.program_merge_key_length,
                prior_bits);
            if (prior_kind != 1u) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (prior_bits != merge_bits) continue;
            ulong prior_id = ig_row_mmr_word(
                output, args.output_merged_id_base + prior);
            ulong prior_dense = ig_row_mmr_word(
                output, args.output_merged_dense_base + prior);
            ulong prior_created = ig_row_mmr_word(
                output, args.output_merged_created_base + prior);
            if (prior_id == 0ul || prior_dense != 0ul || prior_created != prior + 1ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (match_count == ~0ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            ++match_count;
            if (match_count == 1ul) {
                target_id = prior_id;
                target_dense = 0ul;
                target_created = prior_created;
            }
        }
        if (match_count > 1ul) {
            ig_row_mmr_store(
                output,
                args.output_control_base + 2ul,
                IG_ROW_MMR_STATUS_MULTIPLE_NODE_MATCHES);
            ig_row_mmr_store(output, args.output_control_base + 3ul, source);
            ig_row_mmr_store(output, args.output_control_base + 4ul, match_count);
            return;
        }
        if (match_count == 0ul) {
            if (work > ~0ul - args.first_node_id) {
                ig_row_mmr_store(
                    output,
                    args.output_control_base + 2ul,
                    IG_ROW_MMR_STATUS_ID_COLLISION);
                ig_row_mmr_store(output, args.output_control_base + 3ul, work);
                ig_row_mmr_store(output, args.output_control_base + 4ul, 0ul);
                return;
            }
            target_id = args.first_node_id + work;
            bool collision = target_id == 0ul;
            for (ulong node = 0ul; !collision && node < args.node_count; ++node) {
                collision = ig_row_mmr_word(
                    graph, args.graph_node_id_base + node) == target_id;
            }
            if (collision) {
                ig_row_mmr_store(
                    output,
                    args.output_control_base + 2ul,
                    IG_ROW_MMR_STATUS_ID_COLLISION);
                ig_row_mmr_store(output, args.output_control_base + 3ul, work);
                ig_row_mmr_store(output, args.output_control_base + 4ul, 0ul);
                return;
            }
            target_dense = 0ul;
            target_created = work + 1ul;
            ig_row_mmr_store(output, args.output_node_create_base + work, 1ul);
        }
        ig_row_mmr_store(output, args.output_merged_id_base + work, target_id);
        ig_row_mmr_store(output, args.output_merged_dense_base + work, target_dense);
        ig_row_mmr_store(
            output, args.output_merged_created_base + work, target_created);
    }
}

kernel void ig_row_mmr_relationship_merge(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)program;
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    if (ig_row_mmr_is_corrupt(output, args)) return;
    if (ig_row_mmr_word(output, args.output_control_base) != IG_ROW_MMR_SEALED) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (ig_row_mmr_word(output, args.output_control_base + 2ul)
        != IG_ROW_MMR_STATUS_SUCCESS) {
        return;
    }
    ulong work_count = ig_row_mmr_word(output, args.output_control_base + 5ul);
    if (work_count > args.maximum_work_rows) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    for (ulong work = 0ul; work < work_count; ++work) {
        ulong matched_id = ig_row_mmr_word(
            output, args.output_matched_id_base + work);
        ulong matched_dense = ig_row_mmr_word(
            output, args.output_matched_dense_base + work);
        ulong merged_id = ig_row_mmr_word(
            output, args.output_merged_id_base + work);
        ulong merged_dense = ig_row_mmr_word(
            output, args.output_merged_dense_base + work);
        if (matched_id == 0ul || matched_dense == 0ul
            || matched_dense > args.node_count || merged_id == 0ul
            || merged_dense > args.node_count) {
            ig_row_mmr_mark_corrupt(output, args);
            return;
        }

        ulong match_count = 0ul;
        ulong target_id = 0ul;
        ulong target_dense = 0ul;
        ulong target_created = 0ul;
        for (ulong edge = 0ul; edge < args.edge_count; ++edge) {
            ulong active = ig_row_mmr_word(graph, args.graph_edge_active_base + edge);
            ulong layer = ig_row_mmr_word(graph, args.graph_edge_layer_base + edge);
            if (active > 1ul || layer >= 64ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (active == 0ul || ((args.layers >> layer) & 1ul) == 0ul) continue;
            ulong edge_id = ig_row_mmr_word(graph, args.graph_edge_id_base + edge);
            ulong source_dense = ig_row_mmr_word(
                graph, args.graph_edge_source_base + edge);
            ulong target_dense_row = ig_row_mmr_word(
                graph, args.graph_edge_target_base + edge);
            if (edge_id == 0ul || source_dense >= args.node_count
                || target_dense_row >= args.node_count
                || ig_row_mmr_word(
                    output, args.output_relationship_dependency_base + edge) != 1ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (args.relationship_type_present == 0ul || merged_dense == 0ul
                || ig_row_mmr_word(graph, args.graph_edge_type_base + edge)
                    != args.relationship_type_token
                || source_dense + 1ul != merged_dense
                || target_dense_row + 1ul != matched_dense) {
                continue;
            }
            if (match_count == ~0ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            ++match_count;
            if (match_count == 1ul) {
                target_id = edge_id;
                target_dense = edge + 1ul;
                target_created = 0ul;
            }
        }
        for (ulong prior = 0ul; prior < work; ++prior) {
            ulong create = ig_row_mmr_word(
                output, args.output_relationship_create_base + prior);
            if (create > 1ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (create == 0ul) continue;
            ulong prior_source_id = ig_row_mmr_word(
                output, args.output_merged_id_base + prior);
            ulong prior_target_id = ig_row_mmr_word(
                output, args.output_matched_id_base + prior);
            if (prior_source_id != merged_id || prior_target_id != matched_id) continue;
            ulong prior_id = ig_row_mmr_word(
                output, args.output_relationship_id_base + prior);
            ulong prior_dense = ig_row_mmr_word(
                output, args.output_relationship_dense_base + prior);
            ulong prior_created = ig_row_mmr_word(
                output, args.output_relationship_created_base + prior);
            if (prior_id == 0ul || prior_dense != 0ul || prior_created != prior + 1ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            if (match_count == ~0ul) {
                ig_row_mmr_mark_corrupt(output, args);
                return;
            }
            ++match_count;
            if (match_count == 1ul) {
                target_id = prior_id;
                target_dense = 0ul;
                target_created = prior_created;
            }
        }
        if (match_count > 1ul) {
            ig_row_mmr_store(
                output,
                args.output_control_base + 2ul,
                IG_ROW_MMR_STATUS_MULTIPLE_RELATIONSHIP_MATCHES);
            ig_row_mmr_store(output, args.output_control_base + 3ul, work);
            ig_row_mmr_store(output, args.output_control_base + 4ul, match_count);
            return;
        }
        if (match_count == 0ul) {
            if (work > ~0ul - args.first_edge_id) {
                ig_row_mmr_store(
                    output,
                    args.output_control_base + 2ul,
                    IG_ROW_MMR_STATUS_ID_COLLISION);
                ig_row_mmr_store(output, args.output_control_base + 3ul, work);
                ig_row_mmr_store(output, args.output_control_base + 4ul, 1ul);
                return;
            }
            target_id = args.first_edge_id + work;
            bool collision = target_id == 0ul;
            for (ulong edge = 0ul; !collision && edge < args.edge_count; ++edge) {
                collision = ig_row_mmr_word(
                    graph, args.graph_edge_id_base + edge) == target_id;
            }
            if (collision) {
                ig_row_mmr_store(
                    output,
                    args.output_control_base + 2ul,
                    IG_ROW_MMR_STATUS_ID_COLLISION);
                ig_row_mmr_store(output, args.output_control_base + 3ul, work);
                ig_row_mmr_store(output, args.output_control_base + 4ul, 1ul);
                return;
            }
            target_dense = 0ul;
            target_created = work + 1ul;
            ig_row_mmr_store(
                output, args.output_relationship_create_base + work, 1ul);
        }
        ig_row_mmr_store(
            output, args.output_relationship_id_base + work, target_id);
        ig_row_mmr_store(
            output, args.output_relationship_dense_base + work, target_dense);
        ig_row_mmr_store(
            output,
            args.output_relationship_created_base + work,
            target_created);
    }
}

kernel void ig_row_mmr_sort(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    (void)graph;
    ulong local = ulong(gid);
    if (local > ~0ul - dispatch.logical_base) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ulong work = dispatch.logical_base + local;
    if (work >= args.maximum_work_rows) return;
    if (ig_row_mmr_is_corrupt(output, args)) return;
    if (ig_row_mmr_word(output, args.output_control_base) != IG_ROW_MMR_SEALED) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (ig_row_mmr_word(output, args.output_control_base + 2ul)
        != IG_ROW_MMR_STATUS_SUCCESS) {
        return;
    }
    ulong work_count = ig_row_mmr_word(output, args.output_control_base + 5ul);
    if (work_count > args.maximum_work_rows) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    if (work >= work_count) return;
    ulong source = ig_row_mmr_word(output, args.output_work_source_base + work);
    ulong value_bits = 0ul;
    uint kind = ig_row_mmr_map_integer(
        program,
        args,
        source,
        args.program_merge_key_offset,
        args.program_merge_key_length,
        value_bits);
    if (kind != 1u) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    long value = as_type<long>(value_bits);
    ulong rank = 0ul;
    for (ulong other = 0ul; other < work_count; ++other) {
        ulong other_source = ig_row_mmr_word(
            output, args.output_work_source_base + other);
        ulong other_bits = 0ul;
        uint other_kind = ig_row_mmr_map_integer(
            program,
            args,
            other_source,
            args.program_merge_key_offset,
            args.program_merge_key_length,
            other_bits);
        if (other_kind != 1u) {
            ig_row_mmr_mark_corrupt(output, args);
            return;
        }
        long other_value = as_type<long>(other_bits);
        if (other_value < value || (other_value == value && other < work)) {
            ++rank;
        }
    }
    if (rank >= work_count) {
        ig_row_mmr_mark_corrupt(output, args);
        return;
    }
    ig_row_mmr_store(output, args.output_sorted_value_base + rank, value_bits);
    ig_row_mmr_store(output, args.output_sorted_work_base + rank, work + 1ul);
}

kernel void ig_row_mmr_publish(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant RowMmrArgs& args [[buffer(3)]],
    constant RowMmrDispatchArgs& dispatch [[buffer(4)]],
    uint gid [[thread_position_in_grid]]) {
    if (dispatch.logical_base != 0ul || gid != 0u) return;
    if (args.output_word_count < IG_ROW_MMR_OUTPUT_HEADER_WORDS) return;

    bool control_safe = ig_row_mmr_range(
        args.output_control_base,
        IG_ROW_MMR_CONTROL_WORDS,
        args.output_word_count);
    bool ready = control_safe
        && ig_row_mmr_word(output, args.output_control_base) == IG_ROW_MMR_SEALED;
    bool corrupt = !ready || ig_row_mmr_is_corrupt(output, args);
    ulong status = corrupt
        ? IG_ROW_MMR_STATUS_CORRUPT_PACKET
        : ig_row_mmr_word(output, args.output_control_base + 2ul);
    ulong status_row = control_safe
        ? ig_row_mmr_word(output, args.output_control_base + 3ul) : 0ul;
    ulong detail = control_safe
        ? ig_row_mmr_word(output, args.output_control_base + 4ul) : 0ul;
    ulong work_count = control_safe
        ? ig_row_mmr_word(output, args.output_control_base + 5ul) : 0ul;
    if (status > IG_ROW_MMR_STATUS_ID_COLLISION) {
        status = IG_ROW_MMR_STATUS_CORRUPT_PACKET;
        status_row = 0ul;
        detail = 0ul;
        corrupt = true;
    }

    bool semantic_safe = true;
    if (!corrupt) {
        if ((status == IG_ROW_MMR_STATUS_NULL_NODE_KEY
                || status == IG_ROW_MMR_STATUS_UNSUPPORTED_NODE_KEY)
                && (status_row >= args.source_count || detail != 0ul)) {
            semantic_safe = false;
        } else if (status == IG_ROW_MMR_STATUS_MULTIPLE_NODE_MATCHES
                && (status_row >= args.source_count || detail <= 1ul)) {
            semantic_safe = false;
        } else if (status == IG_ROW_MMR_STATUS_MULTIPLE_RELATIONSHIP_MATCHES
                && (status_row >= work_count || detail <= 1ul)) {
            semantic_safe = false;
        } else if (status == IG_ROW_MMR_STATUS_OUTPUT_BUDGET
                && (work_count <= args.maximum_work_rows
                    || detail != work_count
                    || (args.source_count != 0ul && status_row >= args.source_count))) {
            semantic_safe = false;
        } else if (status == IG_ROW_MMR_STATUS_ID_COLLISION
                && (detail > 1ul || status_row >= work_count)) {
            semantic_safe = false;
        } else if (status == IG_ROW_MMR_STATUS_SUCCESS
                && work_count > args.maximum_work_rows) {
            semantic_safe = false;
        }
    }

    ulong intent_count = 0ul;
    ulong dependency_count = 0ul;
    if (!corrupt && semantic_safe && status == IG_ROW_MMR_STATUS_SUCCESS) {
        // Recompute every source-major pair predicate and prove that compaction retained exactly
        // the complete immutable MATCH relation in stable order.
        ulong ordinal = 0ul;
        for (ulong pair = 0ul; pair < args.pair_count && semantic_safe; ++pair) {
            ulong flag = ig_row_mmr_word(output, args.output_pair_active_base + pair);
            if (flag > 1ul || args.node_count == 0ul) {
                semantic_safe = false;
                break;
            }
            ulong source = pair / args.node_count;
            ulong node = pair - source * args.node_count;
            ulong input_bits = 0ul;
            uint input_kind = ig_row_mmr_map_integer(
                program,
                args,
                source,
                args.program_match_key_offset,
                args.program_match_key_length,
                input_bits);
            ulong active = ig_row_mmr_word(graph, args.graph_node_active_base + node);
            ulong layer = ig_row_mmr_word(graph, args.graph_node_layer_base + node);
            ulong label = ig_row_mmr_word(graph, args.graph_matched_label_base + node);
            ulong validity = ig_row_mmr_word(
                graph, args.graph_matched_validity_base + node);
            if (input_kind == 3u || active > 1ul || layer >= 64ul
                || label > 1ul || validity > 1ul) {
                semantic_safe = false;
                break;
            }
            bool expected = input_kind == 1u && active != 0ul
                && ((args.layers >> layer) & 1ul) != 0ul
                && label != 0ul && validity != 0ul
                && ig_row_mmr_word(graph, args.graph_matched_value_base + node)
                    == input_bits;
            if (flag != ulong(expected)) {
                semantic_safe = false;
                break;
            }
            if (!expected) continue;
            if (ordinal >= work_count || ordinal >= args.maximum_work_rows) {
                semantic_safe = false;
                break;
            }
            ulong node_id = ig_row_mmr_word(graph, args.graph_node_id_base + node);
            if (node_id == 0ul
                || ig_row_mmr_word(output, args.output_work_source_base + ordinal)
                    != source
                || ig_row_mmr_word(output, args.output_matched_id_base + ordinal)
                    != node_id
                || ig_row_mmr_word(output, args.output_matched_dense_base + ordinal)
                    != node + 1ul) {
                semantic_safe = false;
                break;
            }
            ++ordinal;
        }
        if (ordinal != work_count) semantic_safe = false;

        // Dependency flags cover every selected immutable row, not merely rows that matched.
        for (ulong node = 0ul; node < args.node_count && semantic_safe; ++node) {
            ulong active = ig_row_mmr_word(graph, args.graph_node_active_base + node);
            ulong layer = ig_row_mmr_word(graph, args.graph_node_layer_base + node);
            ulong matched_label = ig_row_mmr_word(
                graph, args.graph_matched_label_base + node);
            ulong merged_label = ig_row_mmr_word(
                graph, args.graph_merged_label_base + node);
            ulong matched_validity = ig_row_mmr_word(
                graph, args.graph_matched_validity_base + node);
            ulong merged_validity = ig_row_mmr_word(
                graph, args.graph_merged_validity_base + node);
            ulong dependency = ig_row_mmr_word(
                output, args.output_node_dependency_base + node);
            if (active > 1ul || layer >= 64ul || matched_label > 1ul
                || merged_label > 1ul || matched_validity > 1ul
                || merged_validity > 1ul || dependency > 1ul) {
                semantic_safe = false;
                break;
            }
            ulong expected = active != 0ul && ((args.layers >> layer) & 1ul) != 0ul
                ? 1ul : 0ul;
            if (dependency != expected
                || (active != 0ul
                    && ig_row_mmr_word(graph, args.graph_node_id_base + node) == 0ul)) {
                semantic_safe = false;
                break;
            }
            if (dependency != 0ul) {
                if (dependency_count == ~0ul) {
                    semantic_safe = false;
                    break;
                }
                ++dependency_count;
            }
        }
        for (ulong edge = 0ul; edge < args.edge_count && semantic_safe; ++edge) {
            ulong active = ig_row_mmr_word(graph, args.graph_edge_active_base + edge);
            ulong layer = ig_row_mmr_word(graph, args.graph_edge_layer_base + edge);
            ulong dependency = ig_row_mmr_word(
                output, args.output_relationship_dependency_base + edge);
            if (active > 1ul || layer >= 64ul || dependency > 1ul) {
                semantic_safe = false;
                break;
            }
            ulong expected = active != 0ul && ((args.layers >> layer) & 1ul) != 0ul
                ? 1ul : 0ul;
            ulong source_dense = ig_row_mmr_word(
                graph, args.graph_edge_source_base + edge);
            ulong target_dense = ig_row_mmr_word(
                graph, args.graph_edge_target_base + edge);
            if (dependency != expected
                || (active != 0ul
                    && (ig_row_mmr_word(graph, args.graph_edge_id_base + edge) == 0ul
                        || source_dense >= args.node_count
                        || target_dense >= args.node_count))) {
                semantic_safe = false;
                break;
            }
            if (dependency != 0ul) {
                if (dependency_count == ~0ul) {
                    semantic_safe = false;
                    break;
                }
                ++dependency_count;
            }
        }

        for (ulong work = 0ul; work < work_count && semantic_safe; ++work) {
            ulong source = ig_row_mmr_word(output, args.output_work_source_base + work);
            ulong matched_id = ig_row_mmr_word(
                output, args.output_matched_id_base + work);
            ulong matched_dense = ig_row_mmr_word(
                output, args.output_matched_dense_base + work);
            ulong merged_id = ig_row_mmr_word(
                output, args.output_merged_id_base + work);
            ulong merged_dense = ig_row_mmr_word(
                output, args.output_merged_dense_base + work);
            ulong merged_created = ig_row_mmr_word(
                output, args.output_merged_created_base + work);
            ulong relationship_id = ig_row_mmr_word(
                output, args.output_relationship_id_base + work);
            ulong relationship_dense = ig_row_mmr_word(
                output, args.output_relationship_dense_base + work);
            ulong relationship_created = ig_row_mmr_word(
                output, args.output_relationship_created_base + work);
            ulong node_create = ig_row_mmr_word(
                output, args.output_node_create_base + work);
            ulong relationship_create = ig_row_mmr_word(
                output, args.output_relationship_create_base + work);
            if (source >= args.source_count || matched_id == 0ul
                || matched_dense == 0ul || matched_dense > args.node_count
                || merged_id == 0ul || merged_dense > args.node_count
                || relationship_id == 0ul || relationship_dense > args.edge_count
                || node_create > 1ul || relationship_create > 1ul) {
                semantic_safe = false;
                break;
            }
            ulong matched_row = matched_dense - 1ul;
            if (ig_row_mmr_word(graph, args.graph_node_id_base + matched_row)
                != matched_id) {
                semantic_safe = false;
                break;
            }

            ulong merge_bits = 0ul;
            uint merge_kind = ig_row_mmr_map_integer(
                program,
                args,
                source,
                args.program_merge_key_offset,
                args.program_merge_key_length,
                merge_bits);
            if (merge_kind != 1u) {
                semantic_safe = false;
                break;
            }
            if (merged_dense != 0ul) {
                ulong merged_row = merged_dense - 1ul;
                if (merged_created != 0ul || node_create != 0ul
                    || ig_row_mmr_word(graph, args.graph_node_id_base + merged_row)
                        != merged_id
                    || ig_row_mmr_word(
                        graph, args.graph_merged_label_base + merged_row) != 1ul
                    || ig_row_mmr_word(
                        graph, args.graph_merged_validity_base + merged_row) != 1ul
                    || ig_row_mmr_word(
                        graph, args.graph_merged_value_base + merged_row) != merge_bits) {
                    semantic_safe = false;
                    break;
                }
            } else {
                if (merged_created == 0ul || merged_created > work + 1ul) {
                    semantic_safe = false;
                    break;
                }
                ulong leader = merged_created - 1ul;
                ulong leader_source = ig_row_mmr_word(
                    output, args.output_work_source_base + leader);
                ulong leader_bits = 0ul;
                uint leader_kind = ig_row_mmr_map_integer(
                    program,
                    args,
                    leader_source,
                    args.program_merge_key_offset,
                    args.program_merge_key_length,
                    leader_bits);
                ulong expected_id = 0ul;
                if (leader_kind != 1u || leader_bits != merge_bits
                    || !ig_row_mmr_add(args.first_node_id, leader, expected_id)
                    || expected_id == 0ul || expected_id != merged_id
                    || ig_row_mmr_word(
                        output, args.output_node_create_base + leader) != 1ul
                    || ig_row_mmr_word(
                        output, args.output_merged_created_base + leader) != leader + 1ul
                    || node_create != ulong(leader == work)) {
                    semantic_safe = false;
                    break;
                }
            }

            if (relationship_dense != 0ul) {
                ulong edge = relationship_dense - 1ul;
                ulong edge_source = ig_row_mmr_word(
                    graph, args.graph_edge_source_base + edge);
                ulong edge_target = ig_row_mmr_word(
                    graph, args.graph_edge_target_base + edge);
                if (relationship_created != 0ul || relationship_create != 0ul
                    || args.relationship_type_present == 0ul || merged_dense == 0ul
                    || ig_row_mmr_word(graph, args.graph_edge_id_base + edge)
                        != relationship_id
                    || ig_row_mmr_word(graph, args.graph_edge_type_base + edge)
                        != args.relationship_type_token
                    || edge_source + 1ul != merged_dense
                    || edge_target + 1ul != matched_dense) {
                    semantic_safe = false;
                    break;
                }
            } else {
                if (relationship_created == 0ul || relationship_created > work + 1ul) {
                    semantic_safe = false;
                    break;
                }
                ulong leader = relationship_created - 1ul;
                ulong expected_id = 0ul;
                if (!ig_row_mmr_add(args.first_edge_id, leader, expected_id)
                    || expected_id == 0ul || expected_id != relationship_id
                    || ig_row_mmr_word(
                        output, args.output_relationship_create_base + leader) != 1ul
                    || ig_row_mmr_word(
                        output,
                        args.output_relationship_created_base + leader) != leader + 1ul
                    || ig_row_mmr_word(
                        output, args.output_merged_id_base + leader) != merged_id
                    || ig_row_mmr_word(
                        output, args.output_matched_id_base + leader) != matched_id
                    || relationship_create != ulong(leader == work)) {
                    semantic_safe = false;
                    break;
                }
            }
            if (node_create != 0ul) {
                if (intent_count == ~0ul) {
                    semantic_safe = false;
                    break;
                }
                ++intent_count;
            }
            if (relationship_create != 0ul) {
                if (intent_count == ~0ul) {
                    semantic_safe = false;
                    break;
                }
                ++intent_count;
            }
        }

        long previous_value = 0;
        ulong previous_work = 0ul;
        for (ulong rank = 0ul; rank < work_count && semantic_safe; ++rank) {
            ulong encoded_work = ig_row_mmr_word(
                output, args.output_sorted_work_base + rank);
            if (encoded_work == 0ul || encoded_work > work_count) {
                semantic_safe = false;
                break;
            }
            ulong work = encoded_work - 1ul;
            for (ulong prior = 0ul; prior < rank; ++prior) {
                if (ig_row_mmr_word(
                        output, args.output_sorted_work_base + prior) == encoded_work) {
                    semantic_safe = false;
                    break;
                }
            }
            if (!semantic_safe) break;
            ulong source = ig_row_mmr_word(output, args.output_work_source_base + work);
            ulong expected_bits = 0ul;
            uint kind = ig_row_mmr_map_integer(
                program,
                args,
                source,
                args.program_merge_key_offset,
                args.program_merge_key_length,
                expected_bits);
            ulong actual_bits = ig_row_mmr_word(
                output, args.output_sorted_value_base + rank);
            long actual_value = as_type<long>(actual_bits);
            if (kind != 1u || actual_bits != expected_bits
                || (rank != 0ul
                    && (actual_value < previous_value
                        || (actual_value == previous_value && work < previous_work)))) {
                semantic_safe = false;
                break;
            }
            previous_value = actual_value;
            previous_work = work;
        }
    }

    if (!semantic_safe) {
        ig_row_mmr_mark_corrupt(output, args);
        status = IG_ROW_MMR_STATUS_CORRUPT_PACKET;
        status_row = 0ul;
        detail = 0ul;
    }
    if (status != IG_ROW_MMR_STATUS_SUCCESS) {
        intent_count = 0ul;
        dependency_count = 0ul;
    }

    ulong receipt_words = 0ul;
    bool receipt_layout_safe = ig_row_mmr_product(
            args.receipt_count, IG_ROW_MMR_RECEIPT_WORDS, receipt_words)
        && ig_row_mmr_range(
            args.output_receipt_base, receipt_words, args.output_word_count);
    if (!receipt_layout_safe) {
        status = IG_ROW_MMR_STATUS_CORRUPT_PACKET;
        status_row = 0ul;
        detail = 0ul;
        intent_count = 0ul;
        dependency_count = 0ul;
    }

    for (ulong header = 0ul; header < IG_ROW_MMR_OUTPUT_HEADER_WORDS; ++header) {
        ig_row_mmr_store(output, header, 0ul);
    }
    ig_row_mmr_store(output, 0ul, IG_ROW_MMR_OUTPUT_MAGIC);
    ig_row_mmr_store(output, 1ul, IG_ROW_MMR_OUTPUT_VERSION);
    ig_row_mmr_store(output, 2ul, status);
    ig_row_mmr_store(output, 3ul, IG_ROW_MMR_COMPLETION_METAL);
    ig_row_mmr_store(output, 4ul, args.execution_high);
    ig_row_mmr_store(output, 5ul, args.execution_low);
    ig_row_mmr_store(output, 6ul, args.project_high);
    ig_row_mmr_store(output, 7ul, args.project_low);
    ig_row_mmr_store(output, 8ul, args.bookmark_term);
    ig_row_mmr_store(output, 9ul, args.bookmark_index);
    ig_row_mmr_store(output, 10ul, args.graph_revision);
    ig_row_mmr_store(output, 11ul, args.layout_version);
    ig_row_mmr_store(output, 12ul, args.fingerprint_0);
    ig_row_mmr_store(output, 13ul, args.fingerprint_1);
    ig_row_mmr_store(output, 14ul, args.fingerprint_2);
    ig_row_mmr_store(output, 15ul, args.fingerprint_3);
    ig_row_mmr_store(output, 16ul, args.source_count);
    ig_row_mmr_store(output, 17ul, work_count);
    ig_row_mmr_store(output, 18ul, intent_count);
    ig_row_mmr_store(output, 19ul, dependency_count);
    ig_row_mmr_store(output, 20ul, args.receipt_count);
    ig_row_mmr_store(output, 21ul, args.program_word_count);
    ig_row_mmr_store(output, 22ul, args.graph_word_count);
    ig_row_mmr_store(output, 23ul, args.output_word_count);
    ig_row_mmr_store(output, 24ul, args.first_node_id);
    ig_row_mmr_store(output, 25ul, args.first_edge_id);
    ig_row_mmr_store(output, 27ul, status_row);
    ig_row_mmr_store(output, 28ul, detail);
    ig_row_mmr_store(output, 29ul, args.node_count);
    ig_row_mmr_store(output, 30ul, args.edge_count);
    ig_row_mmr_store(output, 31ul, args.maximum_work_rows);
    ig_row_mmr_store(output, 32ul, args.catalog_0);
    ig_row_mmr_store(output, 33ul, args.catalog_1);
    ig_row_mmr_store(output, 34ul, args.catalog_2);
    ig_row_mmr_store(output, 35ul, args.catalog_3);
    ig_row_mmr_store(output, 36ul, args.relationship_type_present);
    ig_row_mmr_store(output, 37ul, args.relationship_type_token);

    ulong failed_receipt = ~0ul;
    if (status == IG_ROW_MMR_STATUS_NULL_NODE_KEY
        || status == IG_ROW_MMR_STATUS_UNSUPPORTED_NODE_KEY
        || status == IG_ROW_MMR_STATUS_MULTIPLE_NODE_MATCHES) {
        failed_receipt = 2ul;
    } else if (status == IG_ROW_MMR_STATUS_MULTIPLE_RELATIONSHIP_MATCHES) {
        failed_receipt = 4ul;
    } else if (status == IG_ROW_MMR_STATUS_OUTPUT_BUDGET) {
        failed_receipt = 1ul;
    } else if (status == IG_ROW_MMR_STATUS_ID_COLLISION) {
        failed_receipt = detail == 0ul ? 3ul : 5ul;
    } else if (status != IG_ROW_MMR_STATUS_SUCCESS) {
        failed_receipt = 0ul;
    }

    if (receipt_layout_safe) {
        for (ulong receipt = 0ul; receipt < args.receipt_count; ++receipt) {
            ulong target = args.output_receipt_base
                + receipt * IG_ROW_MMR_RECEIPT_WORDS;
            ig_row_mmr_store(output, target, args.execution_high);
            ig_row_mmr_store(output, target + 1ul, args.execution_low);
            if (ready) {
                ulong source = args.program_obligation_base + receipt * 4ul;
                ig_row_mmr_store(
                    output, target + 2ul, ig_row_mmr_word(program, source));
                ig_row_mmr_store(
                    output, target + 3ul, ig_row_mmr_word(program, source + 1ul));
                ig_row_mmr_store(
                    output, target + 4ul, ig_row_mmr_word(program, source + 2ul));
                ig_row_mmr_store(
                    output, target + 5ul, ig_row_mmr_word(program, source + 3ul));
            } else {
                for (ulong word = 2ul; word <= 5ul; ++word) {
                    ig_row_mmr_store(output, target + word, 0ul);
                }
            }

            ulong input_cardinality = 0ul;
            ulong output_cardinality = 0ul;
            if (failed_receipt == ~0ul) {
                if (receipt == 0ul) {
                    input_cardinality = 1ul;
                    output_cardinality = args.source_count;
                } else if (receipt == 1ul) {
                    input_cardinality = args.source_count;
                    output_cardinality = work_count;
                } else {
                    input_cardinality = work_count;
                    output_cardinality = work_count;
                }
            } else if (receipt == 0ul) {
                input_cardinality = 1ul;
                output_cardinality = failed_receipt == 0ul ? 0ul : args.source_count;
            } else if (receipt == 1ul) {
                if (failed_receipt != 0ul) input_cardinality = args.source_count;
                if (failed_receipt > 1ul) output_cardinality = work_count;
            } else if (failed_receipt >= 2ul && receipt < failed_receipt) {
                input_cardinality = work_count;
                output_cardinality = work_count;
            } else if (receipt == failed_receipt) {
                input_cardinality = work_count;
                output_cardinality = 0ul;
            }
            ig_row_mmr_store(output, target + 6ul, input_cardinality);
            ig_row_mmr_store(output, target + 7ul, output_cardinality);
            ig_row_mmr_store(output, target + 8ul, IG_ROW_MMR_COMPLETION_METAL);
        }
    }
    // Publication is transactional: this is the only trustable final word and is written last.
    ig_row_mmr_store(output, 26ul, IG_ROW_MMR_SEALED);
}
