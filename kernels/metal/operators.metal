    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    for (ulong lane = 0ul; lane < args.node_property_count; ++lane) {
        for (ulong row = 0ul; row < args.node_count; ++row) {
            if (ig_delete_word(graph, args.node_property_validity_base + lane * args.node_count + row) > 1ul) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
        }
    }
    for (ulong lane = 0ul; lane < args.edge_property_count; ++lane) {
        for (ulong row = 0ul; row < args.edge_count; ++row) {
            if (ig_delete_word(graph, args.edge_property_validity_base + lane * args.edge_count + row) > 1ul) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
        }
    }
    output[args.control_base] |= 256ul;
    (void)program;
}

inline bool ig_delete_append_selected(
    device ulong* output,
    constant DeleteArgs& args,
    thread ulong& row,
    ulong start,
    ulong relationship,
    ulong end) {
    if (row >= args.selector_capacity) {
        ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
        return false;
    }
    output[args.start_row_base + row] = start;
    output[args.relationship_row_base + row] = relationship;
    output[args.end_row_base + row] = end;
    ++row;
    return true;
}

inline bool ig_delete_append_expansion_candidate(
    device const long* graph,
    device const long* program,
    device ulong* output,
    constant DeleteArgs& args,
    thread ulong& row,
    ulong start,
    ulong edge,
    ulong end) {
    if (!ig_delete_edge_matches(graph, program, args, edge)) return true;
    if (!ig_delete_node_matches(
            graph,
            program,
            args,
            end,
            ig_delete_word(program, 6ul),
            ig_delete_word(program, 7ul))) return true;
    if (ig_delete_word(program, 10ul) == 1ul && start != end) return true;
    return ig_delete_append_selected(output, args, row, start, edge, end);
}

inline ulong ig_delete_adjacency_begin(
    device const long* graph,
    constant DeleteArgs& args,
    ulong node,
    bool incoming) {
    return incoming
        ? ig_delete_word(graph, args.incoming_offset_base + node)
        : ig_delete_word(graph, args.outgoing_offset_base + node);
}

inline ulong ig_delete_adjacency_end(
    device const long* graph,
    constant DeleteArgs& args,
    ulong node,
    bool incoming) {
    return incoming
        ? ig_delete_word(graph, args.incoming_offset_base + node + 1ul)
        : ig_delete_word(graph, args.outgoing_offset_base + node + 1ul);
}

inline bool ig_delete_three_hop_candidate(
    device const long* graph,
    device const long* program,
    constant DeleteArgs& args,
    ulong node,
    bool incoming,
    ulong cursor,
    thread ulong& edge,
    thread ulong& end) {
    edge = incoming
        ? ig_delete_word(graph, args.incoming_edge_base + cursor)
        : ig_delete_word(graph, args.outgoing_edge_base + cursor);
    end = incoming
        ? ig_delete_word(graph, args.incoming_neighbor_base + cursor)
        : ig_delete_word(graph, args.outgoing_neighbor_base + cursor);
    if (incoming && end == node) return false;
    return ig_delete_edge_matches(graph, program, args, edge)
        && ig_delete_node_matches(
            graph,
            program,
            args,
            end,
            ig_delete_word(program, 6ul),
            ig_delete_word(program, 7ul));
}

inline bool ig_delete_append_three_hop_selected(
    device ulong* output,
    constant DeleteArgs& args,
    thread ulong& row,
    ulong node_0,
    ulong edge_0,
    ulong node_1,
    ulong edge_1,
    ulong node_2,
    ulong edge_2,
    ulong node_3) {
    if (row >= args.selector_capacity) {
        ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
        return false;
    }
    output[args.start_row_base + row] = node_0;
    output[args.start_row_base + args.selector_capacity + row] = node_1;
    output[args.start_row_base + 2ul * args.selector_capacity + row] = node_2;
    output[args.start_row_base + 3ul * args.selector_capacity + row] = node_3;
    output[args.relationship_row_base + row] = edge_0;
    output[args.relationship_row_base + args.selector_capacity + row] = edge_1;
    output[args.relationship_row_base + 2ul * args.selector_capacity + row] = edge_2;
    ++row;
    return true;
}

inline bool ig_delete_append_three_hop_from_start(
    device const long* graph,
    device const long* program,
    device ulong* output,
    constant DeleteArgs& args,
    thread ulong& row,
    ulong node_0) {
    bool incoming_0 = false;
    ulong begin_0 = ig_delete_adjacency_begin(graph, args, node_0, incoming_0);
    ulong end_0 = ig_delete_adjacency_end(graph, args, node_0, incoming_0);
    for (ulong cursor_0 = begin_0; cursor_0 < end_0; ++cursor_0) {
        ulong edge_0 = 0ul;
        ulong node_1 = 0ul;
        if (!ig_delete_three_hop_candidate(
                graph, program, args, node_0, incoming_0, cursor_0, edge_0, node_1)) continue;
        bool incoming_1 = false;
        ulong begin_1 = ig_delete_adjacency_begin(graph, args, node_1, incoming_1);
        ulong end_1 = ig_delete_adjacency_end(graph, args, node_1, incoming_1);
        for (ulong cursor_1 = begin_1; cursor_1 < end_1; ++cursor_1) {
            ulong edge_1 = 0ul;
            ulong node_2 = 0ul;
            if (!ig_delete_three_hop_candidate(
                    graph, program, args, node_1, incoming_1, cursor_1, edge_1, node_2)
                || edge_1 == edge_0) continue;
            bool incoming_2 = false;
            ulong begin_2 = ig_delete_adjacency_begin(graph, args, node_2, incoming_2);
            ulong end_2 = ig_delete_adjacency_end(graph, args, node_2, incoming_2);
            for (ulong cursor_2 = begin_2; cursor_2 < end_2; ++cursor_2) {
                ulong edge_2 = 0ul;
                ulong node_3 = 0ul;
                if (!ig_delete_three_hop_candidate(
                        graph,
                        program,
                        args,
                        node_2,
                        incoming_2,
                        cursor_2,
                        edge_2,
                        node_3)
                    || edge_2 == edge_0
                    || edge_2 == edge_1) continue;
                if (!ig_delete_append_three_hop_selected(
                        output,
                        args,
                        row,
                        node_0,
                        edge_0,
                        node_1,
                        edge_1,
                        node_2,
                        edge_2,
                        node_3)) return false;
            }
        }
    }
    return true;
}

kernel void ig_delete_select_scan(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    if (output[args.control_base] != 511ul) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    if (ig_delete_word(program, 30ul) != 0ul) return;
    ulong rows = output[16];
    for (ulong node = 0ul; node < args.node_count; ++node) {
        if (ig_delete_node_matches(
                graph,
                program,
                args,
                node,
                ig_delete_word(program, 4ul),
                ig_delete_word(program, 5ul))) {
            if (!ig_delete_append_selected(
                    output, args, rows, node, IG_DELETE_NULL_ROW, IG_DELETE_NULL_ROW)) return;
        }
    }
    if (rows == 0ul
        && ig_delete_word(program, 48ul) == 1ul
        && ig_delete_word(program, 49ul) == 0ul) {
        if (!ig_delete_append_selected(
                output,
                args,
                rows,
                IG_DELETE_NULL_ROW,
                IG_DELETE_NULL_ROW,
                IG_DELETE_NULL_ROW)) return;
    }
    output[16] = rows;
}

kernel void ig_delete_select_outgoing(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong direction = ig_delete_word(program, 3ul);
    if (ig_delete_word(program, 30ul) != 1ul || (direction != 1ul && direction != 3ul)) return;
    ulong rows = output[16];
    for (ulong node = 0ul; node < args.node_count; ++node) {
        if (!ig_delete_node_matches(
                graph,
                program,
                args,
                node,
                ig_delete_word(program, 4ul),
                ig_delete_word(program, 5ul))) continue;
        ulong begin = ig_delete_word(graph, args.outgoing_offset_base + node);
        ulong end = ig_delete_word(graph, args.outgoing_offset_base + node + 1ul);
        for (ulong cursor = begin; cursor < end; ++cursor) {
            ulong target = ig_delete_word(graph, args.outgoing_neighbor_base + cursor);
            ulong edge = ig_delete_word(graph, args.outgoing_edge_base + cursor);
            if (!ig_delete_append_expansion_candidate(
                    graph, program, output, args, rows, node, edge, target)) return;
        }
    }
    output[16] = rows;
}

kernel void ig_delete_select_incoming(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong direction = ig_delete_word(program, 3ul);
    if (ig_delete_word(program, 30ul) != 1ul || (direction != 2ul && direction != 3ul)) return;
    ulong rows = output[16];
    for (ulong node = 0ul; node < args.node_count; ++node) {
        if (!ig_delete_node_matches(
                graph,
                program,
                args,
                node,
                ig_delete_word(program, 4ul),
                ig_delete_word(program, 5ul))) continue;
        ulong begin = ig_delete_word(graph, args.incoming_offset_base + node);
        ulong end = ig_delete_word(graph, args.incoming_offset_base + node + 1ul);
        for (ulong cursor = begin; cursor < end; ++cursor) {
            ulong target = ig_delete_word(graph, args.incoming_neighbor_base + cursor);
            if (direction == 3ul && target == node) continue;
            ulong edge = ig_delete_word(graph, args.incoming_edge_base + cursor);
            if (!ig_delete_append_expansion_candidate(
                    graph, program, output, args, rows, node, edge, target)) return;
        }
    }
    output[16] = rows;
}

kernel void ig_delete_selection_publish(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong rows = output[16];
    if (ig_delete_word(program, 50ul) == 1ul) {
        if (rows != 0ul) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        for (ulong node = 0ul; node < args.node_count; ++node) {
            if (!ig_delete_node_matches(
                    graph,
                    program,
                    args,
                    node,
                    ig_delete_word(program, 4ul),
                    ig_delete_word(program, 5ul))) continue;
            if (!ig_delete_append_three_hop_from_start(
                    graph, program, output, args, rows, node)) return;
        }
    }
    if (ig_delete_word(program, 11ul) == 1ul) {
        ulong matched_rows = rows;
        for (ulong node = 0ul; node < args.node_count; ++node) {
            if (!ig_delete_node_matches(
                    graph,
                    program,
                    args,
                    node,
                    ig_delete_word(program, 4ul),
                    ig_delete_word(program, 5ul))) continue;
            bool matched = false;
            for (ulong row = 0ul; row < matched_rows; ++row) {
                if (output[args.start_row_base + row] == node) {
                    matched = true;
                    break;
                }
            }
            if (!matched && !ig_delete_append_selected(
                    output,
                    args,
                    rows,
                    node,
                    IG_DELETE_NULL_ROW,
                    IG_DELETE_NULL_ROW)) return;
        }
    }
    if (ig_delete_word(program, 49ul) == 1ul) {
        if (rows != 0ul) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
    }
    if (rows == 0ul && ig_delete_word(program, 48ul) == 1ul) {
        if (!ig_delete_append_selected(
                output,
                args,
                rows,
                IG_DELETE_NULL_ROW,
                IG_DELETE_NULL_ROW,
                IG_DELETE_NULL_ROW)) return;
    }
    output[16] = rows;
    output[17] = rows;
    ig_delete_write_receipt(
        output,
        args,
        0ul,
        ig_delete_word(program, 32ul),
        ig_delete_word(program, 33ul),
        ig_delete_word(program, 34ul),
        ig_delete_word(program, 35ul),
        rows,
        rows);
}

inline bool ig_delete_variable_path_frame(
    device const long* graph,
    device const long* program,
    device const long* path,
    constant DeleteArgs& args,
    thread ulong& parent_count,
    thread ulong& publication_count) {
    if (args.variable_path_mode != 1ul
            || args.variable_path_word_count > IG_DELETE_MAX_DIMENSION
            || args.variable_path_abi != IG_DELETE_VARIABLE_PATH_ABI
            || args.variable_path_output_header_words != 24ul
            || args.variable_path_publication_count_word != 13ul
            || args.variable_path_publication_capacity != args.selector_capacity
            || args.variable_path_receipt_base != 24ul
            || args.variable_path_receipt_count != 3ul
            || args.variable_path_receipt_words != 7ul
            || args.variable_path_descriptor_stride != 3ul
            || args.variable_path_edge_stride != args.edge_count
            || args.variable_path_node_stride != args.edge_count + 1ul
            || args.variable_path_node_stride > IG_DELETE_MAX_DIMENSION
            || args.variable_path_segment_stride != 1ul
            || args.variable_path_metadata_stride != 3ul
            || args.variable_path_final_relation_capacity != 0ul) return false;

    ulong section_words = 0ul;
    if (!ig_delete_product(
            args.variable_path_receipt_count,
            args.variable_path_receipt_words,
            section_words)
            || !ig_delete_range(
                args.variable_path_receipt_base,
                section_words,
                args.variable_path_word_count)
            || args.variable_path_descriptor_base
                != args.variable_path_receipt_base + section_words
            || !ig_delete_product(
                args.variable_path_publication_capacity,
                args.variable_path_descriptor_stride,
                section_words)
            || !ig_delete_range(
                args.variable_path_descriptor_base,
                section_words,
                args.variable_path_word_count)
            || args.variable_path_edge_base
                != args.variable_path_descriptor_base + section_words
            || !ig_delete_product(
                args.variable_path_publication_capacity,
                args.variable_path_edge_stride,
                section_words)
            || !ig_delete_range(
                args.variable_path_edge_base,
                section_words,
                args.variable_path_word_count)
            || args.variable_path_node_base != args.variable_path_edge_base + section_words
            || !ig_delete_product(
                args.variable_path_publication_capacity,
                args.variable_path_node_stride,
                section_words)
            || !ig_delete_range(
                args.variable_path_node_base,
                section_words,
                args.variable_path_word_count)
            || args.variable_path_segment_end_base
                != args.variable_path_node_base + section_words
            || !ig_delete_product(
                args.variable_path_publication_capacity,
                args.variable_path_segment_stride,
                section_words)
            || !ig_delete_range(
                args.variable_path_segment_end_base,
                section_words,
                args.variable_path_word_count)
            || args.variable_path_metadata_base
                != args.variable_path_segment_end_base + section_words
            || !ig_delete_product(
                args.variable_path_publication_capacity,
                args.variable_path_metadata_stride,
                section_words)
            || !ig_delete_range(
                args.variable_path_metadata_base,
                section_words,
                args.variable_path_word_count)
            || args.variable_path_final_relation_base
                != args.variable_path_metadata_base + section_words
            || args.variable_path_final_relation_base != args.variable_path_word_count) {
        return false;
    }

    ulong status = ig_delete_word(path, 1ul);
    parent_count = ig_delete_word(path, 12ul);
    publication_count = ig_delete_word(path, args.variable_path_publication_count_word);
    if (ig_delete_word(path, 0ul) != args.variable_path_abi
            || status != IG_DELETE_VARIABLE_PATH_SUCCESS
            || ig_delete_word(path, 2ul) != args.execution_high
            || ig_delete_word(path, 3ul) != args.execution_low
            || ig_delete_word(path, 4ul) != args.bookmark_term
            || ig_delete_word(path, 5ul) != args.bookmark_index
            || ig_delete_word(path, 6ul) != args.graph_revision
            || ig_delete_word(path, 7ul) != args.layout_version
            || ig_delete_word(path, 8ul) != args.variable_path_fingerprint_0
            || ig_delete_word(path, 9ul) != args.variable_path_fingerprint_1
            || ig_delete_word(path, 10ul) != args.variable_path_fingerprint_2
            || ig_delete_word(path, 11ul) != args.variable_path_fingerprint_3
            || parent_count > args.node_count
            || publication_count > args.variable_path_publication_capacity
            || ig_delete_word(path, 14ul) != args.variable_path_publication_capacity
            || ig_delete_word(path, 15ul) != args.edge_count
            || ig_delete_word(path, 16ul) != args.variable_path_receipt_count
            || ig_delete_word(path, 17ul) != 2ul
            || ig_delete_word(path, 18ul) != 2ul
            || ig_delete_word(path, 19ul) != 0ul
            || ig_delete_word(path, 20ul) != 0ul
            || ig_delete_word(path, 21ul) != publication_count
            || ig_delete_word(path, 22ul) != 0ul
            || ig_delete_word(path, 23ul) != 0xfffffffful) return false;

    ulong visible = 0ul;
    for (ulong node = 0ul; node < args.node_count; ++node) {
        if (ig_delete_node_matches(graph, program, args, node, 0ul, 0ul)) ++visible;
    }
    if (parent_count != visible) return false;

    ulong obligation_ids[3];
    for (ulong receipt = 0ul; receipt < args.variable_path_receipt_count; ++receipt) {
        ulong base = args.variable_path_receipt_base
            + receipt * args.variable_path_receipt_words;
        obligation_ids[receipt] = ig_delete_word(path, base + 2ul);
        if (ig_delete_word(path, base) != args.execution_high
                || ig_delete_word(path, base + 1ul) != args.execution_low
                || obligation_ids[receipt] == 0ul
                || ig_delete_word(path, base + 6ul) != 2ul) return false;
    }
    if (obligation_ids[0] == obligation_ids[1]
            || obligation_ids[0] == obligation_ids[2]
            || obligation_ids[1] == obligation_ids[2]) return false;
    ulong scan = args.variable_path_receipt_base;
    ulong segment = scan + args.variable_path_receipt_words;
    ulong final_receipt = segment + args.variable_path_receipt_words;
    return ig_delete_word(path, scan + 3ul) == (7ul | (6ul << 8u))
        && ig_delete_word(path, scan + 4ul) == args.node_count
        && ig_delete_word(path, scan + 5ul) == parent_count
        && ig_delete_word(path, segment + 3ul) == (5ul | (4ul << 8u))
        && ig_delete_word(path, segment + 4ul) == parent_count
        && ig_delete_word(path, segment + 5ul) == publication_count
        && ig_delete_word(path, final_receipt + 3ul) == (6ul | (5ul << 8u))
        && ig_delete_word(path, final_receipt + 4ul) == publication_count
        && ig_delete_word(path, final_receipt + 5ul) == publication_count;
}

inline bool ig_delete_variable_path_edge_connects(
    device const long* graph,
    constant DeleteArgs& args,
    ulong source,
    ulong target,
    ulong edge) {
    ulong begin = ig_delete_word(graph, args.outgoing_offset_base + source);
    ulong end = ig_delete_word(graph, args.outgoing_offset_base + source + 1ul);
    for (ulong cursor = begin; cursor < end; ++cursor) {
        if (ig_delete_word(graph, args.outgoing_neighbor_base + cursor) == target
                && ig_delete_word(graph, args.outgoing_edge_base + cursor) == edge) return true;
    }
    begin = ig_delete_word(graph, args.incoming_offset_base + source);
    end = ig_delete_word(graph, args.incoming_offset_base + source + 1ul);
    for (ulong cursor = begin; cursor < end; ++cursor) {
        if (ig_delete_word(graph, args.incoming_neighbor_base + cursor) == target
                && ig_delete_word(graph, args.incoming_edge_base + cursor) == edge) return true;
    }
    return false;
}

inline bool ig_delete_variable_path_row(
    device const long* graph,
    device const long* program,
    device const long* path,
    constant DeleteArgs& args,
    ulong parent_count,
    ulong row,
    thread ulong& start,
    thread ulong& end,
    thread ulong& length) {
    ulong descriptor = args.variable_path_descriptor_base
        + row * args.variable_path_descriptor_stride;
    ulong metadata = args.variable_path_metadata_base
        + row * args.variable_path_metadata_stride;
    start = ig_delete_word(path, descriptor);
    end = ig_delete_word(path, descriptor + 1ul);
    length = ig_delete_word(path, descriptor + 2ul);
    ulong parent = ig_delete_word(path, metadata);
    if (start >= args.node_count || end >= args.node_count
            || length == 0ul || length > args.edge_count
            || parent >= parent_count
            || ig_delete_word(path, metadata + 1ul) != 0xfffffffful
            || ig_delete_word(path, metadata + 2ul) != 1ul
            || ig_delete_word(
                path,
                args.variable_path_segment_end_base
                    + row * args.variable_path_segment_stride) != length) return false;

    ulong expected_parent = 0ul;
    ulong parent_start = IG_DELETE_NULL_ROW;
    for (ulong node = 0ul; node < args.node_count; ++node) {
        if (!ig_delete_node_matches(graph, program, args, node, 0ul, 0ul)) continue;
        if (expected_parent == parent) parent_start = node;
        ++expected_parent;
    }
    if (expected_parent != parent_count || parent_start != start) return false;

    ulong node_base = args.variable_path_node_base + row * args.variable_path_node_stride;
    ulong edge_base = args.variable_path_edge_base + row * args.variable_path_edge_stride;
    if (ig_delete_word(path, node_base) != start
            || ig_delete_word(path, node_base + length) != end) return false;
    for (ulong hop = 0ul; hop < length; ++hop) {
        ulong source = ig_delete_word(path, node_base + hop);
        ulong target = ig_delete_word(path, node_base + hop + 1ul);
        ulong edge = ig_delete_word(path, edge_base + hop);
        if (source >= args.node_count || target >= args.node_count || edge >= args.edge_count
                || !ig_delete_node_matches(graph, program, args, source, 0ul, 0ul)
                || !ig_delete_node_matches(graph, program, args, target, 0ul, 0ul)
                || !ig_delete_edge_matches(graph, program, args, edge)
                || !ig_delete_variable_path_edge_connects(
                    graph, args, source, target, edge)) return false;
        for (ulong prior = 0ul; prior < hop; ++prior) {
            if (ig_delete_word(path, edge_base + prior) == edge) return false;
        }
    }
    return true;
}

kernel void ig_delete_variable_path_selection(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    device const long* path [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong parent_count = 0ul;
    ulong publication_count = 0ul;
    if (!ig_delete_variable_path_frame(
            graph, program, path, args, parent_count, publication_count)) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    for (ulong row = 0ul; row < publication_count; ++row) {
        ulong start = 0ul;
        ulong end = 0ul;
        ulong length = 0ul;
        if (!ig_delete_variable_path_row(
                graph, program, path, args, parent_count, row, start, end, length)) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        output[args.start_row_base + row] = start;
        output[args.relationship_row_base + row] = IG_DELETE_NULL_ROW;
        output[args.end_row_base + row] = end;
        (void)length;
    }
    output[16] = publication_count;
    output[17] = publication_count;
    ig_delete_write_receipt(
        output,
        args,
        0ul,
        ig_delete_word(program, 32ul),
        ig_delete_word(program, 33ul),
        ig_delete_word(program, 34ul),
        ig_delete_word(program, 35ul),
        publication_count,
        publication_count);
}

kernel void ig_delete_selection_filter(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    constant DeleteStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    if (step.index >= args.filter_count || output[args.control_base + 1ul] != step.index) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    ulong base = ig_delete_word(program, 12ul) + step.index * IG_DELETE_FILTER_WORDS;
    ulong input_rows = output[17];
    ulong selected = 0ul;
    ulong property_mode = ig_delete_word(program, base + 2ul);
    ulong property_lane = ig_delete_word(program, base + 3ul);
    ulong operation = ig_delete_word(program, base + 4ul);
    long operand = as_type<long>(ig_delete_word(program, base + 5ul));
    for (ulong row = 0ul; row < input_rows; ++row) {
        ulong edge = output[args.relationship_row_base + row];
        bool keep = false;
        if (property_mode == IG_DELETE_PROPERTY_INTEGER && edge < args.edge_count
            && property_lane < args.edge_property_count) {
            ulong validity = ig_delete_word(
                graph,
                args.edge_property_validity_base + property_lane * args.edge_count + edge);
            if (validity > 1ul) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
            if (validity == 1ul) {
                long value = as_type<long>(ig_delete_word(
                    graph,
                    args.edge_property_value_base + property_lane * args.edge_count + edge));
                keep = ig_delete_compare(value, operation, operand);
            }
        }
        if (keep) {
            output[args.start_row_base + selected] = output[args.start_row_base + row];
            output[args.relationship_row_base + selected] = edge;
            output[args.end_row_base + selected] = output[args.end_row_base + row];
            ++selected;
        }
    }
    output[17] = selected;
    output[args.control_base + 1ul] = step.index + 1ul;
    ig_delete_write_receipt(
        output,
        args,
        1ul + step.index,
        ig_delete_word(program, base + 6ul),
        ig_delete_word(program, base + 7ul),
        ig_delete_word(program, base + 8ul),
        ig_delete_word(program, base + 9ul),
        input_rows,
        selected);
}

kernel void ig_delete_read_dependencies(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    if (output[args.control_base + 1ul] != args.filter_count) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    ulong selected_rows = output[17];
    ulong expansion_count = output[35];
    ulong count = 0ul;
    for (ulong dense = 0ul; dense < args.node_count; ++dense) {
        bool used = false;
        for (ulong row = 0ul; row < selected_rows && !used; ++row) {
            for (ulong column = 0ul; column <= expansion_count && !used; ++column) {
                used = output[
                    args.start_row_base + column * args.selector_capacity + row] == dense;
            }
        }
        if (used) {
            if (count >= args.dependency_capacity) {
                ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
                return;
            }
            ulong base = args.dependency_base + count * IG_DELETE_DEPENDENCY_WORDS;
            output[base] = 1ul;
            output[base + 1ul] = dense;
            ++count;
        }
    }
    if (expansion_count != 0ul) {
        for (ulong dense = 0ul; dense < args.edge_count; ++dense) {
            bool used = false;
            for (ulong row = 0ul; row < selected_rows && !used; ++row) {
                for (ulong column = 0ul; column < expansion_count && !used; ++column) {
                    used = output[
                        args.relationship_row_base + column * args.selector_capacity + row]
                        == dense;
                }
            }
            if (used) {
                if (count >= args.dependency_capacity) {
                    ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
                    return;
                }
                ulong base = args.dependency_base + count * IG_DELETE_DEPENDENCY_WORDS;
                output[base] = 2ul;
                output[base + 1ul] = dense;
                ++count;
            }
        }
    }
    output[20] = count;
    ig_delete_write_receipt(
        output,
        args,
        1ul + args.filter_count,
        ig_delete_word(program, 36ul),
        ig_delete_word(program, 37ul),
        ig_delete_word(program, 38ul),
        ig_delete_word(program, 39ul),
        count,
        count);
    (void)graph;
}

kernel void ig_delete_variable_path_read_dependencies(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    device const long* path [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    if (output[args.control_base + 1ul] != args.filter_count
            || args.filter_count != 0ul) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    ulong parent_count = 0ul;
    ulong publication_count = 0ul;
    if (!ig_delete_variable_path_frame(
            graph, program, path, args, parent_count, publication_count)
            || output[16] != publication_count
            || output[17] != publication_count) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    for (ulong row = 0ul; row < publication_count; ++row) {
        ulong start = 0ul;
        ulong end = 0ul;
        ulong length = 0ul;
        if (!ig_delete_variable_path_row(
                graph, program, path, args, parent_count, row, start, end, length)
                || output[args.start_row_base + row] != start
                || output[args.end_row_base + row] != end
                || output[args.relationship_row_base + row] != IG_DELETE_NULL_ROW) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
    }

    ulong count = 0ul;
    for (ulong dense = 0ul; dense < args.node_count; ++dense) {
        bool used = false;
        for (ulong row = 0ul; row < publication_count && !used; ++row) {
            ulong descriptor = args.variable_path_descriptor_base
                + row * args.variable_path_descriptor_stride;
            ulong length = ig_delete_word(path, descriptor + 2ul);
            ulong base = args.variable_path_node_base + row * args.variable_path_node_stride;
            for (ulong lane = 0ul; lane <= length && !used; ++lane) {
                used = ig_delete_word(path, base + lane) == dense;
            }
        }
        if (!used) continue;
        if (count >= args.dependency_capacity) {
            ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
            return;
        }
        ulong base = args.dependency_base + count * IG_DELETE_DEPENDENCY_WORDS;
        output[base] = 1ul;
        output[base + 1ul] = dense;
        ++count;
    }
    for (ulong dense = 0ul; dense < args.edge_count; ++dense) {
        bool used = false;
        for (ulong row = 0ul; row < publication_count && !used; ++row) {
            ulong descriptor = args.variable_path_descriptor_base
                + row * args.variable_path_descriptor_stride;
            ulong length = ig_delete_word(path, descriptor + 2ul);
            ulong base = args.variable_path_edge_base + row * args.variable_path_edge_stride;
            for (ulong lane = 0ul; lane < length && !used; ++lane) {
                used = ig_delete_word(path, base + lane) == dense;
            }
        }
        if (!used) continue;
        if (count >= args.dependency_capacity) {
            ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
            return;
        }
        ulong base = args.dependency_base + count * IG_DELETE_DEPENDENCY_WORDS;
        output[base] = 2ul;
        output[base + 1ul] = dense;
        ++count;
    }
    output[20] = count;
    ig_delete_write_receipt(
        output,
        args,
        1ul + args.filter_count,
        ig_delete_word(program, 36ul),
        ig_delete_word(program, 37ul),
        ig_delete_word(program, 38ul),
        ig_delete_word(program, 39ul),
        count,
        count);
}

inline bool ig_delete_intent_less(
    ulong left_kind,
    ulong left_id,
    ulong right_kind,
    ulong right_id) {
    return left_kind < right_kind || (left_kind == right_kind && left_id < right_id);
}

inline ulong ig_delete_find_intent(
    device ulong* output,
    constant DeleteArgs& args,
    ulong kind,
    ulong id) {
    ulong count = output[19];
    for (ulong index = 0ul; index < count; ++index) {
        ulong base = args.intent_base + index * IG_DELETE_INTENT_WORDS;
        if (output[base + 2ul] == kind && output[base + 3ul] == id) return index;
    }
    return 0xfffffffffffffffful;
}

inline bool ig_delete_insert_intent(
    device ulong* output,
    constant DeleteArgs& args,
    ulong source_row,
    ulong command,
    ulong kind,
    ulong id,
    ulong origin,
    ulong dense) {
    ulong count = output[19];
    if (ig_delete_find_intent(output, args, kind, id) != 0xfffffffffffffffful) return true;
    if (count >= args.intent_capacity) {
        ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
        return false;
    }
    ulong insert = count;
    for (ulong index = 0ul; index < count; ++index) {
        ulong base = args.intent_base + index * IG_DELETE_INTENT_WORDS;
        if (ig_delete_intent_less(kind, id, output[base + 2ul], output[base + 3ul])) {
            insert = index;
            break;
        }
    }
    for (ulong cursor = count; cursor > insert; --cursor) {
        ulong destination = args.intent_base + cursor * IG_DELETE_INTENT_WORDS;
        ulong source = destination - IG_DELETE_INTENT_WORDS;
        for (ulong field = 0ul; field < IG_DELETE_INTENT_WORDS; ++field) {
            output[destination + field] = output[source + field];
        }
        output[args.intent_dense_base + cursor] = output[args.intent_dense_base + cursor - 1ul];
        output[args.intent_processed_base + cursor] =
            output[args.intent_processed_base + cursor - 1ul];
    }
    ulong base = args.intent_base + insert * IG_DELETE_INTENT_WORDS;
    output[base] = source_row;
    output[base + 1ul] = command;
    output[base + 2ul] = kind;
    output[base + 3ul] = id;
    output[base + 4ul] = origin;
    output[args.intent_dense_base + insert] = dense;
    output[args.intent_processed_base + insert] = 0ul;
    output[19] = count + 1ul;
    return true;
}

inline bool ig_delete_edge_incident(
    device const long* graph,
    constant DeleteArgs& args,
    ulong node,
    ulong edge) {
    ulong begin = ig_delete_word(graph, args.outgoing_offset_base + node);
    ulong end = ig_delete_word(graph, args.outgoing_offset_base + node + 1ul);
    for (ulong cursor = begin; cursor < end; ++cursor) {
        if (ig_delete_word(graph, args.outgoing_edge_base + cursor) == edge) return true;
    }
    begin = ig_delete_word(graph, args.incoming_offset_base + node);
    end = ig_delete_word(graph, args.incoming_offset_base + node + 1ul);
    for (ulong cursor = begin; cursor < end; ++cursor) {
        if (ig_delete_word(graph, args.incoming_edge_base + cursor) == edge) return true;
    }
    return false;
}

kernel void ig_delete_explicit_intents(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong command_offset = ig_delete_word(program, 14ul);
    ulong selected_rows = output[17];
    for (ulong row = 0ul; row < selected_rows; ++row) {
        for (ulong command = 0ul; command < args.command_count; ++command) {
            ulong descriptor = command_offset + command * IG_DELETE_COMMAND_WORDS;
            ulong selector = ig_delete_word(program, descriptor + 11ul);
            ulong selector_index = ig_delete_word(program, descriptor + 12ul);
            if (selector == 1ul && row != selector_index) continue;
            ulong binding_kind = ig_delete_word(program, descriptor);
            ulong binding_index = ig_delete_word(program, descriptor + 1ul);
            ulong dense = 0ul;
            if (!ig_delete_binding_row(
                    output, args, binding_kind, binding_index, row, dense)) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
            if (dense == IG_DELETE_NULL_ROW) continue;
            ulong kind = binding_kind == IG_DELETE_BINDING_RELATIONSHIP ? 1ul : 2ul;
            ulong active = kind == 1ul
                ? ig_delete_word(graph, args.edge_active_base + dense)
                : ig_delete_word(graph, args.node_active_base + dense);
            if (active > 1ul) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
            if (active == 0ul) continue;
            ulong attempts = output[args.command_attempt_base + command];
            if (attempts == 0xfffffffffffffffful) {
                ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
                return;
            }
            output[args.command_attempt_base + command] = attempts + 1ul;
            ulong id = kind == 1ul
                ? ig_delete_word(graph, args.edge_id_base + dense)
                : ig_delete_word(graph, args.node_id_base + dense);
            if (!ig_delete_insert_intent(
                    output, args, row, command, kind, id, 1ul, dense)) return;
        }
    }
}

kernel void ig_delete_connectivity(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong command_offset = ig_delete_word(program, 14ul);
    ulong count = output[19];
    for (ulong index = 0ul; index < count; ++index) {
        ulong base = args.intent_base + index * IG_DELETE_INTENT_WORDS;
        if (output[base + 2ul] != 2ul) continue;
        ulong command = output[base + 1ul];
        if (command >= args.command_count) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        ulong descriptor = command_offset + command * IG_DELETE_COMMAND_WORDS;
        if (ig_delete_word(program, descriptor + 2ul) == 1ul) continue;
        ulong node = output[args.intent_dense_base + index];
        if (node >= args.node_count) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        for (ulong edge = 0ul; edge < args.edge_count; ++edge) {
            ulong active = ig_delete_word(graph, args.edge_active_base + edge);
            if (active == 0ul || !ig_delete_edge_incident(graph, args, node, edge)) continue;
            ulong id = ig_delete_word(graph, args.edge_id_base + edge);
            if (ig_delete_find_intent(output, args, 1ul, id) == 0xfffffffffffffffful) {
                ig_delete_fail(output, IG_DELETE_STATUS_CONNECTED);
                return;
            }
        }
    }
}

kernel void ig_delete_detach_incident(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong command_offset = ig_delete_word(program, 14ul);
    while (true) {
        ulong selected = 0xfffffffffffffffful;
        ulong count = output[19];
        for (ulong index = 0ul; index < count; ++index) {
            ulong base = args.intent_base + index * IG_DELETE_INTENT_WORDS;
            if (output[base + 2ul] == 2ul
                && output[args.intent_processed_base + index] == 0ul) {
                selected = index;
                break;
            }
        }
        if (selected == 0xfffffffffffffffful) break;
        ulong base = args.intent_base + selected * IG_DELETE_INTENT_WORDS;
        ulong source_row = output[base];
        ulong command = output[base + 1ul];
        ulong node = output[args.intent_dense_base + selected];
        output[args.intent_processed_base + selected] = 1ul;
        if (command >= args.command_count || node >= args.node_count) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        ulong descriptor = command_offset + command * IG_DELETE_COMMAND_WORDS;
        if (ig_delete_word(program, descriptor + 2ul) == 0ul) continue;
        for (ulong edge = 0ul; edge < args.edge_count; ++edge) {
            ulong active = ig_delete_word(graph, args.edge_active_base + edge);
            if (active > 1ul) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
            if (active == 0ul || !ig_delete_edge_incident(graph, args, node, edge)) continue;
            ulong id = ig_delete_word(graph, args.edge_id_base + edge);
            if (!ig_delete_insert_intent(
                    output, args, source_row, command, 1ul, id, 2ul, edge)) return;
        }
    }
}

kernel void ig_delete_prepare_continuation(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    if (ig_delete_word(program, 31ul) == 0ul) return;
    ulong rows = output[17];
    if (rows > args.selector_capacity) {
        ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
        return;
    }
    for (ulong row = 0ul; row < rows; ++row) output[args.position_base + row] = row;
    output[args.control_base + 2ul] = rows;
    output[args.control_base + 3ul] = 0ul;
    output[args.control_base + 6ul] = 0ul;
    output[args.control_base + 7ul] = 0ul;
    (void)graph;
}

kernel void ig_delete_continuation_stage(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    constant DeleteStepArgs& step [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    if (step.index >= args.stage_count || output[args.control_base + 3ul] != step.index) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    ulong base = ig_delete_word(program, 16ul) + step.index * IG_DELETE_STAGE_WORDS;
    ulong opcode = ig_delete_word(program, base);
    bool aggregate = output[args.control_base + 6ul] == 1ul;
    ulong cardinality = aggregate ? 1ul : output[args.control_base + 2ul];
    ulong input_cardinality = cardinality;
    if (opcode == 1ul) {
        // Projection is a semantic boundary but does not change the retained row lineage.
    } else if (opcode == 2ul) {
        if (aggregate) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        long divisor = as_type<long>(ig_delete_word(program, base + 7ul));
        long operand = as_type<long>(ig_delete_word(program, base + 8ul));
        if (divisor == 0) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        ulong selected = 0ul;
        for (ulong index = 0ul; index < cardinality; ++index) {
            ulong row = output[args.position_base + index];
            long value = 0;
            bool valid = false;
            uint status = ig_delete_source_value(
                graph,
                output,
                args,
                ig_delete_word(program, base + 1ul),
                ig_delete_word(program, base + 2ul),
                ig_delete_word(program, base + 3ul),
                ig_delete_word(program, base + 4ul),
                ig_delete_word(program, base + 5ul),
                ig_delete_word(program, base + 6ul),
                row,
                value,
                valid);
            if (status == 2u) {
                ig_delete_fail(output, IG_DELETE_STATUS_TYPE);
                return;
            }
            if (status != 0u) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
            if (valid && ig_delete_remainder(value, divisor) == operand) {
                output[args.position_base + selected] = row;
                ++selected;
            }
        }
        cardinality = selected;
        output[args.control_base + 2ul] = selected;
    } else if (opcode == 3ul) {
        if (aggregate) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        ulong skip = min(ig_delete_word(program, base + 7ul), cardinality);
        ulong remaining = cardinality - skip;
        for (ulong index = 0ul; index < remaining; ++index) {
            output[args.position_base + index] = output[args.position_base + skip + index];
        }
        cardinality = remaining;
        output[args.control_base + 2ul] = remaining;
    } else if (opcode == 4ul) {
        if (aggregate) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        cardinality = min(ig_delete_word(program, base + 7ul), cardinality);
        output[args.control_base + 2ul] = cardinality;
    } else if (opcode == 5ul) {
        if (aggregate) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        ulong sum_bits = 0ul;
        for (ulong index = 0ul; index < cardinality; ++index) {
            ulong row = output[args.position_base + index];
            long value = 0;
            bool valid = false;
            uint status = ig_delete_source_value(
                graph,
                output,
                args,
                ig_delete_word(program, base + 1ul),
                ig_delete_word(program, base + 2ul),
                ig_delete_word(program, base + 3ul),
                ig_delete_word(program, base + 4ul),
                ig_delete_word(program, base + 5ul),
                ig_delete_word(program, base + 6ul),
                row,
                value,
                valid);
            if (status == 2u) {
                ig_delete_fail(output, IG_DELETE_STATUS_TYPE);
                return;
            }
            if (status != 0u) {
                ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
                return;
            }
            if (!valid) continue;
            ulong value_bits = as_type<ulong>(value);
            ulong next = sum_bits + value_bits;
            ulong sign = 1ul << 63ul;
            if (((sum_bits ^ next) & (value_bits ^ next) & sign) != 0ul) {
                ig_delete_fail(output, IG_DELETE_STATUS_OVERFLOW);
                return;
            }
            sum_bits = next;
        }
        output[args.control_base + 6ul] = 1ul;
        output[args.control_base + 7ul] = sum_bits;
        cardinality = 1ul;
    } else if (opcode == 6ul) {
        if (aggregate || cardinality > 0x7ffffffffffffffful) {
            ig_delete_fail(output, aggregate ? IG_DELETE_STATUS_CORRUPT : IG_DELETE_STATUS_CAPACITY);
            return;
        }
        output[args.control_base + 6ul] = 1ul;
        output[args.control_base + 7ul] = cardinality;
        cardinality = 1ul;
    } else {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    ulong receipt = 2ul + args.filter_count + args.command_count * 2ul + step.index;
    ig_delete_write_receipt(
        output,
        args,
        receipt,
        ig_delete_word(program, base + 9ul),
        ig_delete_word(program, base + 10ul),
        ig_delete_word(program, base + 11ul),
        ig_delete_word(program, base + 12ul),
        input_cardinality,
        cardinality);
    output[args.control_base + 3ul] = step.index + 1ul;
}

kernel void ig_delete_final_relation(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    if (ig_delete_word(program, 31ul) == 0ul) {
        output[22] = 0ul;
        output[23] = 0ul;
        return;
    }
    if (output[args.control_base + 3ul] != args.stage_count) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    bool aggregate = output[args.control_base + 6ul] == 1ul;
    ulong cardinality = aggregate ? 1ul : output[args.control_base + 2ul];
    if (cardinality > args.final_capacity) {
        ig_delete_fail(output, IG_DELETE_STATUS_CAPACITY);
        return;
    }
    for (ulong index = 0ul; index < cardinality; ++index) {
        ulong row = aggregate ? 0ul : output[args.position_base + index];
        long value = 0;
        bool valid = false;
        uint status = ig_delete_source_value(
            graph,
            output,
            args,
            ig_delete_word(program, 18ul),
            ig_delete_word(program, 19ul),
            ig_delete_word(program, 20ul),
            ig_delete_word(program, 21ul),
            ig_delete_word(program, 22ul),
            ig_delete_word(program, 23ul),
            row,
            value,
            valid);
        if (status == 2u) {
            ig_delete_fail(output, IG_DELETE_STATUS_TYPE);
            return;
        }
        if (status != 0u) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
        output[args.final_value_base + index] = as_type<ulong>(value);
        output[args.final_validity_base + index] = valid ? 1ul : 0ul;
    }
    output[22] = cardinality;
    output[23] = 1ul;
    ulong receipt = 2ul + args.filter_count + args.command_count * 2ul + args.stage_count;
    ig_delete_write_receipt(
        output,
        args,
        receipt,
        ig_delete_word(program, 40ul),
        ig_delete_word(program, 41ul),
        ig_delete_word(program, 42ul),
        ig_delete_word(program, 43ul),
        cardinality,
        cardinality);
}

kernel void ig_delete_publish(
    device const long* graph [[buffer(0)]],
    device const long* program [[buffer(1)]],
    device ulong* output [[buffer(2)]],
    constant DeleteArgs& args [[buffer(3)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u || !ig_delete_ready(output)) return;
    ulong command_offset = ig_delete_word(program, 14ul);
    ulong selected_rows = output[17];
    ulong command_receipt = 2ul + args.filter_count;
    for (ulong command = 0ul; command < args.command_count; ++command) {
        ulong descriptor = command_offset + command * IG_DELETE_COMMAND_WORDS;
        ulong attempts = output[args.command_attempt_base + command];
        ulong effects = 0ul;
        for (ulong intent = 0ul; intent < output[19]; ++intent) {
            ulong base = args.intent_base + intent * IG_DELETE_INTENT_WORDS;
            if (output[base + 1ul] == command) ++effects;
        }
        ig_delete_write_receipt(
            output,
            args,
            command_receipt + command * 2ul,
            ig_delete_word(program, descriptor + 3ul),
            ig_delete_word(program, descriptor + 4ul),
            ig_delete_word(program, descriptor + 5ul),
            ig_delete_word(program, descriptor + 6ul),
            selected_rows,
            attempts);
        ig_delete_write_receipt(
            output,
            args,
            command_receipt + command * 2ul + 1ul,
            ig_delete_word(program, descriptor + 7ul),
            ig_delete_word(program, descriptor + 8ul),
            ig_delete_word(program, descriptor + 9ul),
            ig_delete_word(program, descriptor + 10ul),
            attempts,
            effects);
    }
    ulong expected = 2ul + args.filter_count + args.command_count * 2ul + args.stage_count
        + ig_delete_word(program, 31ul);
    if (expected != args.receipt_count) {
        ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
        return;
    }
    for (ulong receipt = 0ul; receipt < args.receipt_count; ++receipt) {
        ulong base = args.receipt_base + receipt * IG_DELETE_RECEIPT_WORDS;
        if (output[base] != args.execution_high
            || output[base + 1ul] != args.execution_low
            || output[base + 2ul] == 0ul
            || output[base + 8ul] != 2ul) {
            ig_delete_fail(output, IG_DELETE_STATUS_CORRUPT);
            return;
        }
    }
    output[3] = 2ul;
    output[34] = IG_DELETE_SEALED;
    (void)graph;
}

