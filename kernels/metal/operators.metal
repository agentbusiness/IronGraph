inline bool ig_temporal_register_source_string(
    device const uint* registers,
    thread const TemporalRegisterStepArgs& args,
    uint register_index,
    thread uint& base,
    thread uint& length) {
    if (register_index >= args.register_count || args.register_stride < 8u) return false;
    base = register_index * args.register_stride;
    if (registers[base] != 11u) return false;
    length = registers[base + 1u];
    return length <= args.string_capacity
        && length <= (args.register_stride - 2u) * 4u;
}

inline bool ig_temporal_register_string_push(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    uchar value) {
    if (length >= args.string_capacity) return false;
    uint word = 2u + length / 4u;
    if (word >= args.register_stride) return false;
    output[word] |= uint(value) << ((length % 4u) * 8u);
    ++length;
    return true;
}

inline bool ig_temporal_register_string_unsigned(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    ulong value,
    uint minimum_width) {
    ulong divisor = 1ul;
    uint digits = 1u;
    while (value / divisor >= 10ul) {
        divisor *= 10ul;
        ++digits;
    }
    for (uint padding = digits; padding < minimum_width; ++padding) {
        if (!ig_temporal_register_string_push(output, args, length, uchar('0'))) return false;
    }
    while (divisor != 0ul) {
        uchar digit = uchar('0' + uint(value / divisor));
        if (!ig_temporal_register_string_push(output, args, length, digit)) return false;
        value %= divisor;
        divisor /= 10ul;
    }
    return true;
}

inline bool ig_temporal_register_string_signed(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    long value) {
    ulong magnitude = value < 0L ? ulong(-(value + 1L)) + 1ul : ulong(value);
    return (value >= 0L
            || ig_temporal_register_string_push(output, args, length, uchar('-')))
        && ig_temporal_register_string_unsigned(output, args, length, magnitude, 1u);
}

inline bool ig_temporal_register_string_date(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    long epoch_days) {
    long year = 0L;
    uint month = 0u;
    uint day = 0u;
    if (!ig_temporal_civil_from_days(epoch_days, year, month, day)
            || year < -999999999L || year > 999999999L) return false;
    ulong magnitude = year < 0L ? ulong(-year) : ulong(year);
    if (year < 0L) {
        if (!ig_temporal_register_string_push(output, args, length, uchar('-'))) return false;
    } else if (year > 9999L) {
        if (!ig_temporal_register_string_push(output, args, length, uchar('+'))) return false;
    }
    return ig_temporal_register_string_unsigned(output, args, length, magnitude, 4u)
        && ig_temporal_register_string_push(output, args, length, uchar('-'))
        && ig_temporal_register_string_unsigned(output, args, length, ulong(month), 2u)
        && ig_temporal_register_string_push(output, args, length, uchar('-'))
        && ig_temporal_register_string_unsigned(output, args, length, ulong(day), 2u);
}

inline bool ig_temporal_register_string_time(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    long clock_nanos) {
    if (clock_nanos < 0L || clock_nanos >= 86400000000000L) return false;
    ulong seconds = ulong(clock_nanos / 1000000000L);
    uint nanos = uint(clock_nanos % 1000000000L);
    if (!ig_temporal_register_string_unsigned(output, args, length, seconds / 3600ul, 2u)
            || !ig_temporal_register_string_push(output, args, length, uchar(':'))
            || !ig_temporal_register_string_unsigned(
                output, args, length, (seconds / 60ul) % 60ul, 2u)
            || !ig_temporal_register_string_push(output, args, length, uchar(':'))
            || !ig_temporal_register_string_unsigned(
                output, args, length, seconds % 60ul, 2u)) return false;
    if (nanos == 0u) return true;
    if (!ig_temporal_register_string_push(output, args, length, uchar('.'))) return false;
    uint digits = 9u;
    while (nanos % 10u == 0u) {
        nanos /= 10u;
        --digits;
    }
    return ig_temporal_register_string_unsigned(
        output, args, length, ulong(nanos), digits);
}

inline bool ig_temporal_register_string_offset(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    int offset_seconds) {
    uint zone_length = ig_temporal_register_fixed_zone_length(offset_seconds);
    for (uint index = 0u; index < zone_length; ++index) {
        uchar value = 0;
        if (!ig_temporal_register_fixed_zone_char(offset_seconds, index, value)
                || !ig_temporal_register_string_push(output, args, length, value)) return false;
    }
    return true;
}

inline bool ig_temporal_register_string_local_datetime(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    long seconds,
    uint nanos,
    int offset_seconds) {
    if (nanos >= 1000000000u || offset_seconds < -86399 || offset_seconds > 86399) return false;
    long epoch_days = ig_temporal_register_floor_div(seconds, 86400L);
    long seconds_of_day = seconds - epoch_days * 86400L + long(offset_seconds);
    long day_adjustment = ig_temporal_register_floor_div(seconds_of_day, 86400L);
    epoch_days += day_adjustment;
    seconds_of_day -= day_adjustment * 86400L;
    long clock_nanos = seconds_of_day * 1000000000L + long(nanos);
    return ig_temporal_register_string_date(output, args, length, epoch_days)
        && ig_temporal_register_string_push(output, args, length, uchar('T'))
        && ig_temporal_register_string_time(output, args, length, clock_nanos);
}

inline bool ig_temporal_register_string_duration_seconds(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    long total_nanos) {
    ulong magnitude = total_nanos < 0L
        ? ulong(-(total_nanos + 1L)) + 1ul
        : ulong(total_nanos);
    if (total_nanos < 0L
            && !ig_temporal_register_string_push(output, args, length, uchar('-'))) return false;
    ulong seconds = magnitude / 1000000000ul;
    uint nanos = uint(magnitude % 1000000000ul);
    if (!ig_temporal_register_string_unsigned(output, args, length, seconds, 1u)) return false;
    if (nanos != 0u) {
        if (!ig_temporal_register_string_push(output, args, length, uchar('.'))) return false;
        uint digits = 9u;
        while (nanos % 10u == 0u) {
            nanos /= 10u;
            --digits;
        }
        if (!ig_temporal_register_string_unsigned(
                output, args, length, ulong(nanos), digits)) return false;
    }
    return ig_temporal_register_string_push(output, args, length, uchar('S'));
}

__attribute__((noinline)) bool ig_temporal_register_string_duration(
    device uint* output,
    thread const TemporalRegisterStepArgs& args,
    thread uint& length,
    long months,
    long days,
    long seconds,
    int nanos) {
    if (nanos <= -1000000000 || nanos >= 1000000000
            || !ig_temporal_register_string_push(output, args, length, uchar('P'))) return false;
    long years = months / 12L;
    long remaining_months = months % 12L;
    if (years != 0L
            && (!ig_temporal_register_string_signed(output, args, length, years)
                || !ig_temporal_register_string_push(output, args, length, uchar('Y')))) {
        return false;
    }
    if (remaining_months != 0L
            && (!ig_temporal_register_string_signed(output, args, length, remaining_months)
                || !ig_temporal_register_string_push(output, args, length, uchar('M')))) {
        return false;
    }
    if (days != 0L
            && (!ig_temporal_register_string_signed(output, args, length, days)
                || !ig_temporal_register_string_push(output, args, length, uchar('D')))) {
        return false;
    }

    long whole_seconds = seconds;
    long fractional_nanos = long(nanos);
    if (seconds > 0L && nanos < 0) {
        --whole_seconds;
        fractional_nanos += 1000000000L;
    } else if (seconds < 0L && nanos > 0) {
        ++whole_seconds;
        fractional_nanos -= 1000000000L;
    }
    bool has_time = whole_seconds != 0L || fractional_nanos != 0L;
    if (has_time) {
        if (!ig_temporal_register_string_push(output, args, length, uchar('T'))) return false;
        long hours = whole_seconds / 3600L;
        long after_hours = whole_seconds % 3600L;
        long minutes = after_hours / 60L;
        long second_nanos = (after_hours % 60L) * 1000000000L + fractional_nanos;
        if (hours != 0L
                && (!ig_temporal_register_string_signed(output, args, length, hours)
                    || !ig_temporal_register_string_push(output, args, length, uchar('H')))) {
            return false;
        }
        if (minutes != 0L
                && (!ig_temporal_register_string_signed(output, args, length, minutes)
                    || !ig_temporal_register_string_push(output, args, length, uchar('M')))) {
            return false;
        }
        if (second_nanos != 0L
                && !ig_temporal_register_string_duration_seconds(
                    output, args, length, second_nanos)) return false;
    } else if (years == 0L && remaining_months == 0L && days == 0L) {
        if (!ig_temporal_register_string_push(output, args, length, uchar('T'))
                || !ig_temporal_register_string_push(output, args, length, uchar('0'))
                || !ig_temporal_register_string_push(output, args, length, uchar('S'))) {
            return false;
        }
    }
    return true;
}

__attribute__((noinline)) bool ig_temporal_register_to_string(
    device const uchar* bytes,
    device const uint* registers,
    thread const TemporalRegisterStepArgs& args,
    device uint* output) {
    if (args.source_register >= args.register_count) return false;
    uint base = args.source_register * args.register_stride;
    uint tag = registers[base];
    if (tag == 0u) { output[0] = 0u; return true; }
    if (!ig_temporal_register_expected_comparison_tag(args.function, tag)) return false;
    uint length = 0u;
    bool rendered = false;
    if (tag == 1u) {
        rendered = ig_temporal_register_string_date(
            output, args, length, ig_temporal_register_read_long(registers, base, 1u));
    } else if (tag == 2u) {
        rendered = ig_temporal_register_string_time(
            output, args, length, ig_temporal_register_read_long(registers, base, 1u));
    } else if (tag == 3u) {
        rendered = ig_temporal_register_string_time(
                output, args, length, ig_temporal_register_read_long(registers, base, 1u))
            && ig_temporal_register_string_offset(
                output, args, length, as_type<int>(registers[base + 3u]));
    } else if (tag == 4u) {
        rendered = ig_temporal_register_string_local_datetime(
            output,
            args,
            length,
            ig_temporal_register_read_long(registers, base, 1u),
            registers[base + 3u],
            0);
    } else if (tag == 5u || tag == 8u) {
        int offset_seconds = 0;
        uint name_start = 0u;
        uint name_length = 0u;
        if (tag == 5u) {
            offset_seconds = as_type<int>(registers[base + 4u]);
        } else if (!ig_temporal_register_named_offset_at(
                bytes,
                args.zone_table_start,
                args.zone_table_end,
                args.zone_count,
                registers[base + 4u],
                ig_temporal_register_read_long(registers, base, 1u),
                offset_seconds)
                || !ig_temporal_register_zone_name_range(
                    bytes, args, registers[base + 4u], name_start, name_length)) {
            return false;
        }
        rendered = ig_temporal_register_string_local_datetime(
                output,
                args,
                length,
                ig_temporal_register_read_long(registers, base, 1u),
                registers[base + 3u],
                offset_seconds)
            && ig_temporal_register_string_offset(output, args, length, offset_seconds);
        if (rendered && tag == 8u) {
            rendered = ig_temporal_register_string_push(output, args, length, uchar('['));
            for (uint index = 0u; rendered && index < name_length; ++index) {
                rendered = ig_temporal_register_string_push(
                    output, args, length, bytes[name_start + index]);
            }
            rendered = rendered
                && ig_temporal_register_string_push(output, args, length, uchar(']'));
        }
    } else if (tag == 6u) {
        rendered = ig_temporal_register_string_duration(
            output,
            args,
            length,
            ig_temporal_register_read_long(registers, base, 1u),
            ig_temporal_register_read_long(registers, base, 3u),
            ig_temporal_register_read_long(registers, base, 5u),
            as_type<int>(registers[base + 7u]));
    }
    if (!rendered) return false;
    output[0] = 11u;
    output[1] = length;
    return true;
}

#endif // IG_INCLUDE_TEMPORAL_REGISTER_KERNELS

inline bool ig_temporal_register_timezone_text_order(
    device const uchar* bytes,
    device const uint* registers,
    thread const TemporalRegisterStepArgs& args,
    uint left_base,
    uint right_base,
    thread int& ordering) {
    uint left_tag = registers[left_base];
    uint right_tag = registers[right_base];
    uint left_start = 0u;
    uint right_start = 0u;
    uint left_length = 0u;
    uint right_length = 0u;
    int left_offset = 0;
    int right_offset = 0;
    if (left_tag == 5u) {
        left_offset = as_type<int>(registers[left_base + 4u]);
        if (left_offset < -86399 || left_offset > 86399) return false;
        left_length = ig_temporal_register_fixed_zone_length(left_offset);
    } else if (left_tag == 8u) {
        if (!ig_temporal_register_zone_name_range(
                bytes, args, registers[left_base + 4u], left_start, left_length)) return false;
    } else {
        return false;
    }
    if (right_tag == 5u) {
        right_offset = as_type<int>(registers[right_base + 4u]);
        if (right_offset < -86399 || right_offset > 86399) return false;
        right_length = ig_temporal_register_fixed_zone_length(right_offset);
    } else if (right_tag == 8u) {
        if (!ig_temporal_register_zone_name_range(
                bytes, args, registers[right_base + 4u], right_start, right_length)) return false;
    } else {
        return false;
    }
    uint shared = min(left_length, right_length);
    for (uint index = 0u; index < shared; ++index) {
        uchar left = 0u;
        uchar right = 0u;
        if (left_tag == 5u) {
            if (!ig_temporal_register_fixed_zone_char(left_offset, index, left)) return false;
        } else {
            left = bytes[left_start + index];
        }
        if (right_tag == 5u) {
            if (!ig_temporal_register_fixed_zone_char(right_offset, index, right)) return false;
        } else {
            right = bytes[right_start + index];
        }
        if (left != right) {
            ordering = left < right ? -1 : 1;
            return true;
        }
    }
    ordering = left_length < right_length ? -1 : (left_length > right_length ? 1 : 0);
    return true;
}

inline bool ig_temporal_register_value_order(
    device const uchar* bytes,
    device const uint* registers,
    thread const TemporalRegisterStepArgs& args,
    uint left_base,
    uint right_base,
    thread int& ordering) {
    uint left_tag = registers[left_base];
    uint right_tag = registers[right_base];
    bool zoned_datetimes = (left_tag == 5u || left_tag == 8u)
        && (right_tag == 5u || right_tag == 8u);
    if (left_tag != right_tag && !zoned_datetimes) return false;
    if (left_tag == 1u || left_tag == 2u) {
        long left = ig_temporal_register_read_long(registers, left_base, 1u);
        long right = ig_temporal_register_read_long(registers, right_base, 1u);
        ordering = left < right ? -1 : (left > right ? 1 : 0);
        return true;
    }
    if (left_tag == 3u) {
        long left_clock = ig_temporal_register_read_long(registers, left_base, 1u);
        long right_clock = ig_temporal_register_read_long(registers, right_base, 1u);
        int left_offset = as_type<int>(registers[left_base + 3u]);
        int right_offset = as_type<int>(registers[right_base + 3u]);
        if (left_offset < -86399 || left_offset > 86399
                || right_offset < -86399 || right_offset > 86399) return false;
        long left = left_clock - long(left_offset) * 1000000000L;
        long right = right_clock - long(right_offset) * 1000000000L;
        ordering = left < right ? -1 : (left > right ? 1
            : (left_offset < right_offset ? -1 : (left_offset > right_offset ? 1 : 0)));
        return true;
    }
    if (left_tag == 4u || zoned_datetimes) {
        long left_seconds = ig_temporal_register_read_long(registers, left_base, 1u);
        long right_seconds = ig_temporal_register_read_long(registers, right_base, 1u);
        if (left_seconds != right_seconds) {
            ordering = left_seconds < right_seconds ? -1 : 1;
            return true;
        }
        uint left_nanos = registers[left_base + 3u];
        uint right_nanos = registers[right_base + 3u];
        if (left_nanos >= 1000000000u || right_nanos >= 1000000000u) return false;
        if (left_nanos != right_nanos) {
            ordering = left_nanos < right_nanos ? -1 : 1;
            return true;
        }
        if (left_tag == 4u) {
            ordering = 0;
            return true;
        }
        return ig_temporal_register_timezone_text_order(
            bytes, registers, args, left_base, right_base, ordering);
    }
    return false;
}

inline bool ig_temporal_register_comparison_step(
    device const uchar* bytes,
    device const uint* registers,
    thread const TemporalRegisterStepArgs& args,
    device uint* output) {
    if (args.source_register >= args.register_count
            || args.right_register >= args.register_count
            || args.temporal_operation > 5u) return false;
    uint left_base = args.source_register * args.register_stride;
    uint right_base = args.right_register * args.register_stride;
    uint left_tag = registers[left_base];
    uint right_tag = registers[right_base];
    if (left_tag == 0u || right_tag == 0u) {
        output[0] = 0u;
        return true;
    }
    if (!ig_temporal_register_expected_comparison_tag(args.function, left_tag)
            || left_tag == 7u || right_tag == 7u
            || left_tag == 9u || right_tag == 9u
            || left_tag == 10u || right_tag == 10u
            || left_tag > 10u || right_tag > 10u) return false;
    if (args.temporal_operation <= 1u) {
        bool equal = false;
        if (left_tag == right_tag) {
            equal = true;
            for (uint word = 1u; word < 8u; ++word) {
                if (registers[left_base + word] != registers[right_base + word]) {
                    equal = false;
                    break;
                }
            }
        }
        output[0] = 10u;
        output[1] = uint(args.temporal_operation == 0u ? equal : !equal);
        return true;
    }
    bool zoned_datetimes = (left_tag == 5u || left_tag == 8u)
        && (right_tag == 5u || right_tag == 8u);
    if ((left_tag != right_tag && !zoned_datetimes) || left_tag == 6u) {
        output[0] = 0u;
        return true;
    }
    int ordering = 0;
    if (!ig_temporal_register_value_order(
            bytes, registers, args, left_base, right_base, ordering)) return false;
    bool result = args.temporal_operation == 2u ? ordering < 0
        : (args.temporal_operation == 3u ? ordering <= 0
            : (args.temporal_operation == 4u ? ordering > 0 : ordering >= 0));
    output[0] = 10u;
    output[1] = uint(result);
    return true;
}

inline bool ig_temporal_register_named_offset_at(
    device const uchar* bytes,
    uint zone_table_start,
    uint zone_table_end,
    uint zone_count,
    uint requested_zone,
    long seconds,
    thread int& offset_seconds) {
    if (requested_zone >= zone_count || zone_table_start >= zone_table_end) return false;
    uint cursor = zone_table_start;
    uint encoded_zone_count = 0u;
    if (!ig_named_datetime_read_u32(bytes, cursor, zone_table_end, encoded_zone_count)
            || encoded_zone_count != zone_count) return false;
    for (uint zone = 0u; zone < zone_count; ++zone) {
        uint name_length = 0u;
        if (!ig_named_datetime_read_u16(bytes, cursor, zone_table_end, name_length)
                || cursor > zone_table_end || zone_table_end - cursor < name_length) return false;
        cursor += name_length;
        uint interval_count = 0u;
        if (!ig_named_datetime_read_u32(bytes, cursor, zone_table_end, interval_count)) return false;
        for (uint interval = 0u; interval < interval_count; ++interval) {
            long interval_start = 0L;
            long interval_end = 0L;
            int interval_offset = 0;
            if (!ig_named_datetime_read_i64(bytes, cursor, zone_table_end, interval_start)
                    || !ig_named_datetime_read_i64(bytes, cursor, zone_table_end, interval_end)
                    || !ig_named_datetime_read_i32(bytes, cursor, zone_table_end, interval_offset)) {
                return false;
            }
            if (zone == requested_zone && seconds >= interval_start && seconds < interval_end) {
                offset_seconds = interval_offset;
                return true;
            }
        }
    }
    return false;
}

__attribute__((noinline)) bool ig_temporal_register_resolve_named_local(
    device const uchar* bytes,
    uint zone_table_start,
    uint zone_table_end,
    uint zone_count,
    uint requested_zone,
    long local_seconds,
    thread long& seconds) {
    if (requested_zone >= zone_count || zone_table_start >= zone_table_end) return false;
    uint cursor = zone_table_start;
    uint encoded_zone_count = 0u;
    if (!ig_named_datetime_read_u32(bytes, cursor, zone_table_end, encoded_zone_count)
            || encoded_zone_count != zone_count) return false;
    bool found = false;
    long found_seconds = 0L;
    for (uint zone = 0u; zone < zone_count; ++zone) {
        uint name_length = 0u;
        if (!ig_named_datetime_read_u16(bytes, cursor, zone_table_end, name_length)
                || cursor > zone_table_end || zone_table_end - cursor < name_length) return false;
        cursor += name_length;
        uint interval_count = 0u;
        if (!ig_named_datetime_read_u32(bytes, cursor, zone_table_end, interval_count)) return false;
        for (uint interval = 0u; interval < interval_count; ++interval) {
            long interval_start = 0L;
            long interval_end = 0L;
            int interval_offset = 0;
            if (!ig_named_datetime_read_i64(bytes, cursor, zone_table_end, interval_start)
                    || !ig_named_datetime_read_i64(bytes, cursor, zone_table_end, interval_end)
                    || !ig_named_datetime_read_i32(bytes, cursor, zone_table_end, interval_offset)) {
                return false;
            }
            if (zone != requested_zone) continue;
            long candidate = local_seconds - long(interval_offset);
            if (candidate >= interval_start && candidate < interval_end) {
                if (found) return false;
                found = true;
                found_seconds = candidate;
            }
        }
    }
    if (!found) return false;
    seconds = found_seconds;
    return true;
}

__attribute__((noinline)) bool ig_temporal_register_load_parts(
    device const uchar* bytes,
    device const uint* registers,
    thread const TemporalRegisterStepArgs& args,
    uint register_index,
    thread IgTemporalRegisterParts& parts,
    thread bool& is_null) {
    if (register_index >= args.register_count) return false;
    uint base = register_index * args.register_stride;
    uint tag = registers[base];
    is_null = tag == 0u;
    parts.has_date = 0u;
    parts.has_clock = 0u;
    parts.zone_kind = 0u;
    parts.has_instant = 0u;
    parts.epoch_days = 0L;
    parts.clock_nanos = 0L;
    parts.offset_seconds = 0;
    parts.zone_index = 0u;
    parts.seconds = 0L;
    parts.nanos = 0u;
    if (is_null) return true;
    if (tag == 1u) {
        parts.has_date = 1u;
        parts.epoch_days = as_type<long>(
            ulong(registers[base + 1u]) | (ulong(registers[base + 2u]) << 32));
        return true;
    }
    if (tag == 2u || tag == 3u) {
        parts.has_clock = 1u;
        parts.clock_nanos = as_type<long>(
            ulong(registers[base + 1u]) | (ulong(registers[base + 2u]) << 32));
        if (tag == 3u) {
            parts.zone_kind = 1u;
            parts.offset_seconds = as_type<int>(registers[base + 3u]);
        }
        return true;
    }
    if (tag != 4u && tag != 5u && tag != 8u) return false;
    long seconds = as_type<long>(
        ulong(registers[base + 1u]) | (ulong(registers[base + 2u]) << 32));
    uint nanos = registers[base + 3u];
    long local_seconds = seconds;
    if (tag == 5u) {
        parts.zone_kind = 1u;
        parts.offset_seconds = as_type<int>(registers[base + 4u]);
        local_seconds += long(parts.offset_seconds);
        parts.has_instant = 1u;
    } else if (tag == 8u) {
        parts.zone_kind = 2u;
        parts.zone_index = registers[base + 4u];
        int offset = 0;
        if (!ig_temporal_register_named_offset_at(
                bytes,
                args.zone_table_start,
                args.zone_table_end,
                args.zone_count,
                parts.zone_index,
                seconds,
                offset)) return false;
        local_seconds += long(offset);
        parts.has_instant = 1u;
    }
    long days = ig_temporal_register_floor_div(local_seconds, 86400L);
    parts.has_date = 1u;
    parts.has_clock = 1u;
