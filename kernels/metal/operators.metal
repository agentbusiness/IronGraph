inline ulong ig_nullable_word(device const long* words, ulong index) {
    return as_type<ulong>(words[index]);
}

struct IgNullableCsrResolvedRow {
    ulong begin;
    ulong end;
    ulong overlay;
};

// Delta path: binary-search only the rows changed since the cold CSR build. The
// overlay stores complete replacement rows as [ids][offsets][neighbors][edges].
inline IgNullableCsrResolvedRow ig_nullable_csr_resolve_row(
    device const long* graph,
    ulong offset_base,
    ulong overlay_base,
    ulong overlay_count,
    ulong row) {
    ulong low = 0ul;
    ulong high = overlay_count;
    while (low < high) {
        ulong middle = low + (high - low) / 2ul;
        ulong candidate = ig_nullable_word(graph, overlay_base + middle);
        if (candidate < row) low = middle + 1ul;
        else high = middle;
    }
    if (low < overlay_count
        && ig_nullable_word(graph, overlay_base + low) == row) {
        ulong offsets = overlay_base + overlay_count;
        return IgNullableCsrResolvedRow{
            ig_nullable_word(graph, offsets + low),
            ig_nullable_word(graph, offsets + low + 1ul),
            1ul};
    }
    return IgNullableCsrResolvedRow{
        ig_nullable_word(graph, offset_base + row),
        ig_nullable_word(graph, offset_base + row + 1ul),
        0ul};
}

inline ulong ig_nullable_csr_neighbor(
    device const long* graph,
    ulong base,
    ulong overlay_base,
    ulong overlay_count,
    IgNullableCsrResolvedRow row,
    ulong position) {
    if (row.overlay == 0ul) return ig_nullable_word(graph, base + position);
    return ig_nullable_word(
        graph, overlay_base + overlay_count * 2ul + 1ul + position);
}

inline ulong ig_nullable_csr_edge(
    device const long* graph,
    ulong base,
    ulong overlay_base,
    ulong overlay_count,
    IgNullableCsrResolvedRow row,
    ulong position) {
    if (row.overlay == 0ul) return ig_nullable_word(graph, base + position);
    ulong payload_count = ig_nullable_word(
        graph, overlay_base + overlay_count * 2ul);
    return ig_nullable_word(graph,
        overlay_base + overlay_count * 2ul + 1ul + payload_count + position);
}

inline IgNullableCsrResolvedRow ig_nullable_csr_resolve_orientation(
    device const long* graph,
    constant NullableRelationArgs& args,
    bool incoming,
    ulong row) {
    return ig_nullable_csr_resolve_row(graph,
        incoming ? args.incoming_offset_base : args.outgoing_offset_base,
        incoming ? args.incoming_overlay_base : args.outgoing_overlay_base,
        incoming ? args.incoming_overlay_row_count : args.outgoing_overlay_row_count,
        row);
}

inline ulong ig_nullable_csr_orientation_neighbor(
    device const long* graph,
    constant NullableRelationArgs& args,
    bool incoming,
    IgNullableCsrResolvedRow row,
    ulong position) {
    return ig_nullable_csr_neighbor(graph,
        incoming ? args.incoming_neighbor_base : args.outgoing_neighbor_base,
        incoming ? args.incoming_overlay_base : args.outgoing_overlay_base,
        incoming ? args.incoming_overlay_row_count : args.outgoing_overlay_row_count,
        row, position);
}

inline ulong ig_nullable_csr_orientation_edge(
    device const long* graph,
    constant NullableRelationArgs& args,
    bool incoming,
    IgNullableCsrResolvedRow row,
