inline void ig_q_status(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong status) {
    device atomic_uint* target = reinterpret_cast<device atomic_uint*>(
        scratch + args.control_base);
    uint prior = uint(IG_Q_STATUS_OK);
    while (prior == uint(IG_Q_STATUS_OK)
            && !atomic_compare_exchange_weak_explicit(
                target, &prior, uint(status),
                memory_order_relaxed, memory_order_relaxed)) {}
}

inline uint ig_q_status_load(
    device const ulong* scratch,
    constant MetalQuantifierArgs& args) {
    device const atomic_uint* target = reinterpret_cast<device const atomic_uint*>(
        scratch + args.control_base);
    return atomic_load_explicit(target, memory_order_relaxed);
}

inline ulong ig_q_mix(ulong value) {
    value += 0x9e3779b97f4a7c15ul;
    value = (value ^ (value >> 30ul)) * 0xbf58476d1ce4e5b9ul;
    value = (value ^ (value >> 27ul)) * 0x94d049bb133111ebul;
    return value ^ (value >> 31ul);
}

inline ulong ig_q_context(ulong parent, ulong node, ulong ordinal) {
    return ig_q_mix(parent ^ ig_q_mix(node + 0x51ed2705ul * (ordinal + 1ul)));
}

inline ulong ig_q_random_double_bits(ulong seed, ulong coordinate) {
    ulong fraction = ig_q_mix(seed ^ coordinate) >> 11ul;
    if (fraction == 0ul) return 0ul;
    uint leading = clz(fraction);
    uint highest = 63u - leading;
    ulong exponent = ulong(int(highest) - 53 + 1023);
    ulong mantissa = (fraction << (52u - highest)) & 0x000ffffffffffffful;
    return (exponent << 52ul) | mantissa;
}

inline device const ulong* ig_q_cell(
    device const ulong* program,
    device const ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong handle) {
    if ((handle & IG_Q_IMMUTABLE) != 0ul) {
        ulong index = handle & ~IG_Q_IMMUTABLE;
        return program + args.immutable_cell_base + index * IG_Q_VALUE_WORDS;
    }
    return scratch + args.dynamic_cell_base + handle * IG_Q_VALUE_WORDS;
}

inline ulong ig_q_item(
    device const ulong* program,
    device const ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* cell,
    ulong index) {
    return cell[3] == 0ul
        ? program[args.immutable_item_base + cell[1] + index]
        : scratch[args.dynamic_item_base + cell[1] + index];
}

inline uchar ig_q_byte(
    device const ulong* program,
    device const ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* cell,
    ulong index) {
    ulong byte_index = cell[1] + index;
    ulong word = cell[3] == 0ul
        ? program[args.immutable_byte_base + byte_index / 8ul]
        : scratch[args.dynamic_byte_base + byte_index / 8ul];
    return uchar((word >> ((byte_index & 7ul) * 8ul)) & 0xfful);
}

inline bool ig_q_handle_valid(
    constant MetalQuantifierArgs& args,
    ulong handle) {
    bool immutable = (handle & IG_Q_IMMUTABLE) != 0ul;
    ulong index = immutable ? handle & ~IG_Q_IMMUTABLE : handle;
    ulong capacity = immutable
        ? args.immutable_cell_count : args.dynamic_cell_capacity;
    return handle != IG_Q_INVALID && index < capacity;
}

inline void ig_q_store_packed_byte(
    device ulong* words,
    ulong base,
    ulong index,
    uchar value) {
    device uchar* bytes = reinterpret_cast<device uchar*>(words + base);
    bytes[index] = value;
}

inline ulong ig_q_alloc_cell(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong tag,
    ulong first,
    ulong second,
    ulong source) {
    device atomic_uint* cursor = reinterpret_cast<device atomic_uint*>(
        scratch + args.control_base + 1ul);
    ulong index = ulong(atomic_fetch_add_explicit(cursor, 1u, memory_order_relaxed));
    if (index >= args.dynamic_cell_capacity) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return IG_Q_INVALID;
    }
    ulong base = args.dynamic_cell_base + index * IG_Q_VALUE_WORDS;
    scratch[base] = tag;
    scratch[base + 1ul] = first;
    scratch[base + 2ul] = second;
    scratch[base + 3ul] = source;
    return index;
}

inline ulong ig_q_alloc_items(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong count) {
    if (count > 0xfffffffful) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return 0ul;
    }
    device atomic_uint* cursor = reinterpret_cast<device atomic_uint*>(
        scratch + args.control_base + 2ul);
    ulong offset = ulong(atomic_fetch_add_explicit(
        cursor, uint(count), memory_order_relaxed));
    if (count > args.dynamic_item_capacity
            || offset > args.dynamic_item_capacity - count) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return 0ul;
    }
    return offset;
}

inline ulong ig_q_alloc_bytes(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong count) {
    if (count > 0xfffffffful) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return 0ul;
    }
    device atomic_uint* cursor = reinterpret_cast<device atomic_uint*>(
        scratch + args.control_base + 3ul);
    ulong offset = ulong(atomic_fetch_add_explicit(
        cursor, uint(count), memory_order_relaxed));
    if (count > args.dynamic_byte_capacity
            || offset > args.dynamic_byte_capacity - count) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return 0ul;
    }
    return offset;
}

inline ulong ig_q_reserve_arena(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong control_word,
    ulong count,
    ulong capacity) {
    if (count > 0xfffffffful || count > capacity) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return IG_Q_INVALID;
    }
    device atomic_uint* cursor = reinterpret_cast<device atomic_uint*>(
        scratch + args.control_base + control_word);
    ulong offset = ulong(atomic_fetch_add_explicit(
        cursor, uint(count), memory_order_relaxed));
    if (offset > capacity - count) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return IG_Q_INVALID;
    }
    return offset;
}

struct IgQAllocator {
    ulong control_base;
    ulong cell_limit;
    ulong item_limit;
    ulong byte_limit;
};

inline ulong ig_q_lane_alloc_cell(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong tag,
    ulong first,
    ulong second,
    ulong source) {
    ulong index = scratch[allocator.control_base + 1ul];
    if (index >= allocator.cell_limit) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return IG_Q_INVALID;
    }
    scratch[allocator.control_base + 1ul] = index + 1ul;
    ulong base = args.dynamic_cell_base + index * IG_Q_VALUE_WORDS;
    scratch[base] = tag;
    scratch[base + 1ul] = first;
    scratch[base + 2ul] = second;
    scratch[base + 3ul] = source;
    return index;
}

inline ulong ig_q_lane_alloc_items(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong count) {
    ulong offset = scratch[allocator.control_base + 2ul];
    if (count > allocator.item_limit || offset > allocator.item_limit - count) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return 0ul;
    }
    scratch[allocator.control_base + 2ul] = offset + count;
    return offset;
}

inline ulong ig_q_lane_alloc_bytes(
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    thread IgQAllocator& allocator,
    ulong count) {
    ulong offset = scratch[allocator.control_base + 3ul];
    if (count > allocator.byte_limit || offset > allocator.byte_limit - count) {
        ig_q_status(scratch, args, IG_Q_STATUS_BUDGET);
        return 0ul;
    }
    scratch[allocator.control_base + 3ul] = offset + count;
    return offset;
}

inline long ig_q_truth(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    ulong handle) {
    device const ulong* cell = ig_q_cell(program, scratch, args, handle);
    if (cell[0] == IG_Q_TAG_NULL) return -1L;
    if (cell[0] != IG_Q_TAG_BOOLEAN || cell[1] > 1ul) {
        ig_q_status(scratch, args, IG_Q_STATUS_TYPE);
        return -1L;
    }
    return long(cell[1]);
}

inline bool ig_q_string_equal(
    device const ulong* program,
    device const ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* left,
    device const ulong* right) {
    if (left[2] != right[2]) return false;
    for (ulong index = 0ul; index < left[2]; ++index) {
        if (ig_q_byte(program, scratch, args, left, index)
                != ig_q_byte(program, scratch, args, right, index)) return false;
    }
    return true;
}

inline bool ig_q_string_predicate(
    device const ulong* program,
    device ulong* scratch,
    constant MetalQuantifierArgs& args,
    device const ulong* left,
    device const ulong* right,
    ulong operation) {
    if (operation == 15ul) {
        if (right[2] > left[2]) return false;
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < right[2]; ++index) {
            if (ig_q_byte(program, scratch, args, left, index)
                    != ig_q_byte(program, scratch, args, right, index)) return false;
        }
        return true;
    }
    if (operation == 16ul) {
        if (right[2] > left[2]) return false;
        ulong offset = left[2] - right[2];
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < right[2]; ++index) {
            if (ig_q_byte(program, scratch, args, left, offset + index)
                    != ig_q_byte(program, scratch, args, right, index)) return false;
        }
        return true;
    }
    if (right[2] == 0ul) return true;
    if (right[2] > left[2]) return false;
    #pragma clang loop unroll(disable)
    for (ulong start = 0ul; start <= left[2] - right[2]; ++start) {
        bool matched = true;
        #pragma clang loop unroll(disable)
        for (ulong index = 0ul; index < right[2]; ++index) {
            if (ig_q_byte(program, scratch, args, left, start + index)
                    != ig_q_byte(program, scratch, args, right, index)) {
                matched = false;
                break;
            }
        }
        if (matched) return true;
    }
    return false;
}

inline bool ig_q_float_nan(ulong bits) {
    return (bits & 0x7ff0000000000000ul) == 0x7ff0000000000000ul
        && (bits & 0x000ffffffffffffful) != 0ul;
}

inline int ig_q_float_compare(ulong left, ulong right) {
    if (ig_q_float_nan(left) || ig_q_float_nan(right)) return 0;
    if ((left << 1ul) == 0ul && (right << 1ul) == 0ul) return 0;
    bool left_negative = (left >> 63ul) != 0ul;
    bool right_negative = (right >> 63ul) != 0ul;
    if (left_negative != right_negative) return left_negative ? -1 : 1;
    if (left == right) return 0;
    if (left_negative) return left > right ? -1 : 1;
    return left < right ? -1 : 1;
}

inline ulong ig_q_i64_to_f64(ulong bits) {
    bool negative = (bits >> 63ul) != 0ul;
    ulong magnitude = negative ? (0ul - bits) : bits;
    if (magnitude == 0ul) return 0ul;
    uint most_significant = 0u;
    for (ulong value = magnitude; value > 1ul; value >>= 1ul) ++most_significant;
    ulong significand = 0ul;
    uint exponent = most_significant + 1023u;
    if (most_significant <= 52u) {
        significand = magnitude << (52u - most_significant);
    } else {
        uint shift = most_significant - 52u;
        significand = magnitude >> shift;
        ulong remainder_mask = (1ul << shift) - 1ul;
        ulong remainder = magnitude & remainder_mask;
        ulong halfway = 1ul << (shift - 1u);
        if (remainder > halfway
                || (remainder == halfway && (significand & 1ul) != 0ul)) {
            ++significand;
            if (significand == 0x0020000000000000ul) {
                significand >>= 1u;
                ++exponent;
            }
        }
    }
    return (negative ? 0x8000000000000000ul : 0ul)
        | (ulong(exponent) << 52ul)
        | (significand & 0x000ffffffffffffful);
}

inline bool ig_q_float_infinite(ulong bits) {
    return (bits & 0x7ffffffffffffffful) == 0x7ff0000000000000ul;
}

inline ulong ig_q_shift_right_jam(ulong value, uint distance) {
    if (distance == 0u) return value;
    if (distance < 64u) {
        ulong discarded = value << (64u - distance);
        return (value >> distance) | (discarded != 0ul ? 1ul : 0ul);
    }
    return value != 0ul ? 1ul : 0ul;
}

inline bool ig_q_float_decode_finite(
    ulong bits,
    thread int& exponent,
    thread ulong& significand) {
    uint exponent_bits = uint((bits >> 52ul) & 0x7fful);
    significand = bits & 0x000ffffffffffffful;
    if (exponent_bits == 0x7ffu || (exponent_bits == 0u && significand == 0ul)) {
        return false;
    }
    if (exponent_bits == 0u) {
        exponent = -1022;
        while ((significand & 0x0010000000000000ul) == 0ul) {
            significand <<= 1u;
            --exponent;
        }
    } else {
        exponent = int(exponent_bits) - 1023;
        significand |= 0x0010000000000000ul;
    }
    return true;
}

inline ulong ig_q_float_round_pack(bool negative, int exponent, ulong significand) {
    if (significand == 0ul) return negative ? 0x8000000000000000ul : 0ul;
    while ((significand & 0x0080000000000000ul) == 0ul) {
        significand <<= 1u;
        --exponent;
    }
    if (exponent < -1022) {
        uint distance = uint(min(4096, -1022 - exponent));
        significand = ig_q_shift_right_jam(significand, distance);
        exponent = -1022;
    }
    ulong round_bits = significand & 7ul;
    ulong rounded = significand >> 3u;
    if (round_bits > 4ul || (round_bits == 4ul && (rounded & 1ul) != 0ul)) ++rounded;
    if (rounded >= 0x0020000000000000ul) {
        rounded >>= 1u;
        ++exponent;
    }
    if (exponent > 1023) {
        return negative ? 0xfff0000000000000ul : 0x7ff0000000000000ul;
    }
    ulong sign = negative ? 0x8000000000000000ul : 0ul;
    if (exponent == -1022 && rounded < 0x0010000000000000ul) {
        return sign | rounded;
    }
    return sign | (ulong(exponent + 1023) << 52u)
        | (rounded & 0x000ffffffffffffful);
}

inline ulong ig_q_float_divide(ulong left, ulong right) {
    const ulong canonical_nan = 0x7ff8000000000000ul;
    if (ig_q_float_nan(left) || ig_q_float_nan(right)) return canonical_nan;
    bool negative = ((left ^ right) >> 63u) != 0ul;
    bool left_infinite = ig_q_float_infinite(left);
    bool right_infinite = ig_q_float_infinite(right);
    bool left_zero = (left & 0x7ffffffffffffffful) == 0ul;
    bool right_zero = (right & 0x7ffffffffffffffful) == 0ul;
    if ((left_infinite && right_infinite) || (left_zero && right_zero)) return canonical_nan;
    if (left_infinite || right_zero) {
        return negative ? 0xfff0000000000000ul : 0x7ff0000000000000ul;
    }
    if (right_infinite || left_zero) return negative ? 0x8000000000000000ul : 0ul;
    int left_exponent = 0;
    int right_exponent = 0;
    ulong left_significand = 0ul;
    ulong right_significand = 0ul;
    ig_q_float_decode_finite(left, left_exponent, left_significand);
    ig_q_float_decode_finite(right, right_exponent, right_significand);
    int exponent = left_exponent - right_exponent;
    ulong remainder = left_significand;
    if (remainder < right_significand) {
        remainder <<= 1u;
        --exponent;
    }
    ulong quotient = 0ul;
    for (int bit = 55; bit >= 0; --bit) {
        if (remainder >= right_significand) {
            remainder -= right_significand;
            quotient |= 1ul << uint(bit);
        }
        if (bit != 0) remainder <<= 1u;
    }
    if (remainder != 0ul) quotient |= 1ul;
    return ig_q_float_round_pack(negative, exponent, quotient);
}

// Ryū's bounded binary64-to-decimal core, expressed with an explicit two-word integer because
// Apple GPUs do not expose a native 128-bit integer.  The tables are the compact Ryū tables: the
// larger powers are reconstructed exactly before the usual multiply/shift interval calculation.
// This keeps Cypher toString(Float) byte-for-byte aligned with Rust's shortest round-tripping
// Display representation without relying on unavailable device printf/double support.
struct IgQU128 {
    ulong low;
    ulong high;
};

