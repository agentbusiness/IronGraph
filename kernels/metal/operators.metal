kernel void ig_temporal_register_date_program(
    device const uchar* bytes [[buffer(0)]],
    device const uint* registers [[buffer(1)]],
    device uint* output [[buffer(2)]],
    constant TemporalRegisterStepArgs& constant_args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (row != 0u) return;
    ig_temporal_register_clear(output, constant_args.register_stride);
    if (constant_args.input_tag == 0u) { output[0] = 0u; return; }
    if (constant_args.input_tag == 9u) {
        TemporalRegisterStepArgs args = constant_args;
        if (!ig_temporal_register_to_string(bytes, registers, args, output)) {
            ig_temporal_register_clear(output, args.register_stride);
        }
        return;
    }
    if (constant_args.input_tag == 8u) {
        TemporalRegisterStepArgs args = constant_args;
        ig_temporal_register_comparison_step(bytes, registers, args, output);
        return;
    }
    if (constant_args.input_tag == 2u) return;
    TemporalRegisterStepArgs args = constant_args;
    ig_temporal_register_date_step(bytes, registers, args, output);
}

