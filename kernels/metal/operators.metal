                || nullable[27] != 0ul
                || nullable[29] != expected_roots
                || nullable[30] != 1ul
                || nullable[28] > nullable[31]
                || (unit_kind == IG_SEGMENTED_UNIT_INDEXED_COUNT
                    && (nullable[28] != 0ul || nullable[31] != 1ul
                        || program[20] != 0ul))
                || (unit_kind == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
                    && (nullable[18] != nullable_rows
                        || (scalar_string && program[20] != nullable[31])
                        || (!scalar_string
                            && (nullable[28] != 0ul || nullable[31] != 1ul
                                || program[20] != 0ul))))
                || expected_words != args.nullable_words) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
        }
    }

    return 0u;
}

inline uint ig_segmented_graph_validate_bindings_groups_contract(
    device const ulong* nullable,
    device const ulong* program,
    device const uint* grouping_columns,
    device const uint* aggregate_descriptors,
    constant IgSegmentedGraphArgs& args) {
    ulong binding_count = program[4];
    ulong grouping_count = program[5];
    ulong aggregate_count = program[6];
    ulong slot_count = program[7];
    ulong instruction_count = program[12];
    ulong source_columns = program[18];
    ulong property_value_columns = program[53]
            == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
        ? 1ul : 0ul;
    ulong nullable_rows = program[28];

    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS) {
        ulong property_base = ig_segmented_property_keys_base(program);
        ulong descriptor_count = program[property_base + 2ul];
        ulong entity_kind = program[property_base + 3ul];
        ulong entity_slot = program[property_base + 5ul];
        ulong list_slot = program[property_base + 6ul];
        ulong key_slot = program[property_base + 7ul];
        ulong name_bytes = program[property_base + 8ul];
        ulong maximum_name_bytes = program[property_base + 9ul];
        ulong group_slot = program[property_base + 10ul];
        ulong count_slot = program[property_base + 11ul];
        ulong descriptor_base = property_base + IG_SEGMENTED_PROPERTY_KEYS_HEADER_WORDS;
        ulong names_word_base = descriptor_base
            + descriptor_count * IG_SEGMENTED_PROPERTY_KEYS_DESCRIPTOR_WORDS;
        ulong names_byte_base = names_word_base * 8ul;
        if (descriptor_count > IG_SEGMENTED_PROPERTY_KEYS_MAX_DESCRIPTORS
                || program[property_base + 4ul] != 0ul
                || (entity_kind != 1ul && entity_kind != 2ul)
                || entity_slot >= slot_count || list_slot >= slot_count
                || key_slot >= slot_count || group_slot >= slot_count || count_slot >= slot_count
                || entity_slot == list_slot || entity_slot == key_slot
                || entity_slot == group_slot || entity_slot == count_slot
                || list_slot == key_slot || list_slot == group_slot || list_slot == count_slot
                || key_slot == group_slot || key_slot == count_slot || group_slot == count_slot
                || name_bytes > 0xfffffffful || maximum_name_bytes > 0xfffffffful
                || names_byte_base > 0xfffffffful
                || name_bytes > 0xfffffffful - names_byte_base) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        ulong name_cursor = 0ul;
        ulong observed_maximum = 0ul;
        device const uchar* program_bytes =
            reinterpret_cast<device const uchar*>(program);
        for (ulong descriptor_index = 0ul;
                descriptor_index < descriptor_count; ++descriptor_index) {
            ulong descriptor = descriptor_base
                + descriptor_index * IG_SEGMENTED_PROPERTY_KEYS_DESCRIPTOR_WORDS;
            ulong property = program[descriptor];
            ulong name_offset = program[descriptor + 1ul];
            ulong name_length = program[descriptor + 2ul];
            if (name_offset != name_cursor || name_length == 0ul
                    || name_length > 0xfffffffful || program[descriptor + 3ul] != 0ul
                    || !ig_segmented_graph_range(name_offset, name_length, name_bytes)
                    || !ig_segmented_utf8(
                        program_bytes,
                        uint(names_byte_base + name_offset),
                        uint(name_length))
                    || (descriptor_index != 0ul
                        && program[descriptor - IG_SEGMENTED_PROPERTY_KEYS_DESCRIPTOR_WORDS]
                            >= property)) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            for (ulong prior = 0ul; prior < descriptor_index; ++prior) {
                ulong prior_descriptor = descriptor_base
                    + prior * IG_SEGMENTED_PROPERTY_KEYS_DESCRIPTOR_WORDS;
                ulong prior_length = program[prior_descriptor + 2ul];
                if (prior_length != name_length) continue;
                ulong prior_offset = program[prior_descriptor + 1ul];
                bool equal = true;
                for (ulong byte = 0ul; byte < name_length; ++byte) {
                    equal = equal && ig_segmented_program_byte(
                            program, names_byte_base + prior_offset + byte)
                        == ig_segmented_program_byte(
                            program, names_byte_base + name_offset + byte);
                }
                if (equal) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            name_cursor += name_length;
            observed_maximum = max(observed_maximum, name_length);
        }
        if (name_cursor != name_bytes || observed_maximum != maximum_name_bytes) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        ulong padded_name_bytes = ((name_bytes + 7ul) / 8ul) * 8ul;
        for (ulong byte = name_bytes; byte < padded_name_bytes; ++byte) {
            if (ig_segmented_program_byte(program, names_byte_base + byte) != 0u) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
    }
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH) {
        for (ulong binding = 0ul; binding < binding_count; ++binding) {
            ulong base = program[41] + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
            ulong expected_kind = binding < 2ul ? 1ul : 2ul;
            ulong expected_type = binding < 4ul
                ? IG_NULLABLE_OUTPUT_ENTITY : IG_NULLABLE_OUTPUT_INTEGER_PROPERTY;
            ulong expected_group = binding < 2ul ? 1ul : 0ul;
            if (program[base] != binding || program[base + 1ul] != binding
                    || program[base + 2ul] != expected_kind
                    || program[base + 3ul] != expected_type
                    || program[base + 9ul] != 0ul
                    || program[base + 10ul] != expected_group) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
    }

    ulong group_markers = 0ul;
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER) {
        ulong unit_kind = ig_segmented_unit_kind(program);
        bool integer_list_order = ig_segmented_unit_integer_list_order(program);
        for (ulong binding = 0ul; binding < binding_count; ++binding) {
            ulong base = program[41] + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
            ulong relation_output = program[base];
            ulong source_slot = program[base + 1ul];
            ulong value_type = program[base + 3ul];
            ulong is_group = program[base + 10ul];
            bool indexed_type = unit_kind == IG_SEGMENTED_UNIT_INDEXED_COUNT
                && value_type == IG_SEGMENTED_UNIT_QUANTIFIER_INTEGER;
            bool scalar_type = unit_kind == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
                && (integer_list_order
                    ? value_type == IG_SEGMENTED_UNIT_QUANTIFIER_INTEGER
                    : ((binding == 0ul || binding == 2ul)
                    ? value_type == IG_SEGMENTED_UNIT_QUANTIFIER_INTEGER
                    : value_type >= IG_SEGMENTED_UNIT_QUANTIFIER_BOOLEAN
                        && value_type <= IG_SEGMENTED_UNIT_QUANTIFIER_STRING));
            bool expected_group = unit_kind == IG_SEGMENTED_UNIT_INDEXED_COUNT
                ? binding == 0ul
                : binding == (integer_list_order ? 1ul : 2ul);
            if (relation_output != binding || source_slot >= slot_count
                    || program[base + 2ul] != 0ul
                    || (!indexed_type && !scalar_type)
                    || program[base + 4ul] != 0ul || program[base + 5ul] != 0ul
                    || program[base + 6ul] != 0ul || program[base + 7ul] != 0ul
                    || program[base + 8ul] != 0ul || program[base + 9ul] != 0ul
                    || is_group != (expected_group ? 1ul : 0ul)
                    || program[base + 11ul] != 0ul) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            group_markers += is_group;
            for (ulong prior = 0ul; prior < binding; ++prior) {
                ulong prior_base = program[41] + prior * IG_SEGMENTED_GRAPH_BINDING_WORDS;
                if (program[prior_base] == relation_output
                        || program[prior_base + 1ul] == source_slot) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
            }
        }
    } else {
        // Every source binding seals the matching nullable final-column descriptor. Recomputing
        // the descriptor address prevents a valid descriptor from being aliased elsewhere.
        ulong nullable_column_base = IG_NULLABLE_RELATION_HEADER_WORDS
            + nullable[20] * IG_NULLABLE_RELATION_RECEIPT_WORDS;
        ulong nullable_bytes = args.nullable_words * 8ul;
        for (ulong binding = 0ul; binding < binding_count; ++binding) {
            ulong base = program[41] + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
            ulong relation_output = program[base];
            ulong source_slot = program[base + 1ul];
            ulong kind = program[base + 2ul];
            ulong type = program[base + 3ul];
            ulong maximum_bytes = program[base + 9ul];
            ulong is_group = program[base + 10ul];
            ulong descriptor = program[base + 11ul];
            ulong expected_descriptor = nullable_column_base
                + relation_output * IG_NULLABLE_RELATION_COLUMN_WORDS;
            if (relation_output >= nullable[22] || source_slot >= slot_count
                    || (kind != 1ul && kind != 2ul)
                    || (type != IG_NULLABLE_OUTPUT_ENTITY
                        && type != IG_NULLABLE_OUTPUT_INTEGER_PROPERTY
                        && type != IG_NULLABLE_OUTPUT_FLOAT_PROPERTY
                        && type != IG_NULLABLE_OUTPUT_STRING_PROPERTY
                        && type != IG_NULLABLE_OUTPUT_NULL_PROPERTY)
                    || maximum_bytes > 0xfffffffful
                    || is_group > 1ul
                    || descriptor != expected_descriptor
                    || !ig_segmented_graph_range(
                        descriptor, IG_NULLABLE_RELATION_COLUMN_WORDS, args.nullable_words)
                    || nullable[descriptor + 1ul] != kind
                    || nullable[descriptor + 2ul] != type
                    || nullable[descriptor + 4ul] != maximum_bytes
                    || nullable[descriptor + 5ul] != program[base + 4ul]
                    || nullable[descriptor + 6ul] != program[base + 5ul]
                    || nullable[descriptor + 7ul] != program[base + 6ul]
                    || nullable[descriptor + 8ul] != program[base + 7ul]
                    || nullable[descriptor + 9ul] != program[base + 8ul]) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
            }
            ulong row_bytes = nullable_rows * 4ul;
            ulong expected = program[base + 4ul];
            if (!ig_segmented_graph_range(expected, row_bytes, nullable_bytes)) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
            }
            expected += row_bytes;
            if (type == IG_NULLABLE_OUTPUT_ENTITY || type == IG_NULLABLE_OUTPUT_NULL_PROPERTY) {
                if (program[base + 5ul] != ~0ul || program[base + 6ul] != ~0ul
                        || program[base + 7ul] != ~0ul || program[base + 8ul] != expected
                        || maximum_bytes != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
            } else if (type == IG_NULLABLE_OUTPUT_INTEGER_PROPERTY
                    || type == IG_NULLABLE_OUTPUT_FLOAT_PROPERTY) {
                if (program[base + 5ul] != expected || program[base + 6ul] != ~0ul
                        || maximum_bytes != 0ul) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                ulong value_bytes = nullable_rows * 8ul;
                if (!ig_segmented_graph_range(expected, value_bytes, nullable_bytes)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                expected += value_bytes;
                if (program[base + 7ul] != expected) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                if (!ig_segmented_graph_range(expected, nullable_rows, nullable_bytes)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                expected += nullable_rows;
                if (program[base + 8ul] != expected) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
            } else {
                if (program[base + 5ul] != expected) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                ulong offset_bytes = (nullable_rows + 1ul) * 4ul;
                if (!ig_segmented_graph_range(expected, offset_bytes, nullable_bytes)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                expected += offset_bytes;
                if (program[base + 6ul] != expected) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                ulong string_bytes = 0ul;
                if (!ig_segmented_graph_product(nullable_rows, maximum_bytes, string_bytes)
                        || !ig_segmented_graph_range(expected, string_bytes, nullable_bytes)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                expected += string_bytes;
                if (program[base + 7ul] != expected) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                if (!ig_segmented_graph_range(expected, nullable_rows, nullable_bytes)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
                expected += nullable_rows;
                if (program[base + 8ul] != expected) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE;
                }
            }
            group_markers += is_group;
            for (ulong prior = 0ul; prior < binding; ++prior) {
                ulong prior_base = program[41] + prior * IG_SEGMENTED_GRAPH_BINDING_WORDS;
                if (program[prior_base] == relation_output
                        || program[prior_base + 1ul] == source_slot) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
            }
        }
    }
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS) {
        ulong property_base = ig_segmented_property_keys_base(program);
        ulong binding_base = program[41];
        if (program[binding_base] != 0ul
                || program[binding_base + 1ul] != program[property_base + 5ul]
                || program[binding_base + 2ul] != program[property_base + 3ul]
                || program[binding_base + 3ul] != IG_NULLABLE_OUTPUT_ENTITY
                || program[binding_base + 9ul] != 0ul
                || program[binding_base + 10ul] != 1ul) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }
    ulong property_value_group_markers = 0ul;
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE) {
        ulong property_base = ig_segmented_property_value_base(program);
        ulong binding = program[41]
            + program[property_base + 4ul] * IG_SEGMENTED_GRAPH_BINDING_WORDS;
        ulong mode = program[property_base + 2ul];
        if (program[property_base + 4ul] != 0ul
                || program[binding] != 0ul
                || program[binding + 1ul] != 0ul
                || program[binding + 2ul] != program[property_base + 3ul]
                || program[binding + 3ul] != IG_NULLABLE_OUTPUT_ENTITY
                || program[binding + 9ul] != 0ul
                || program[binding + 10ul] != 0ul
                || program[property_base + 6ul] == program[binding + 1ul]
                || program[property_base + 7ul] != binding_count) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        property_value_columns = 1ul;
        property_value_group_markers =
            mode == IG_SEGMENTED_PROPERTY_VALUE_FLAT_LIST_GROUP ? 1ul : 0ul;
    }
    ulong direct_groups = 0ul;
    ulong computed_groups = 0ul;
    ulong expression_cursor = 0ul;
    for (ulong key = 0ul; key < grouping_count; ++key) {
        ulong descriptor = program[program[42] + key];
        ulong column = ulong(uint(descriptor));
        ulong expression_start = ulong(uint(descriptor >> 32ul) & 0xffffu);
        ulong expression_count = descriptor >> 48ul;
        if (grouping_columns[key] != uint(column)) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        if (expression_count == 0ul) {
            bool property_group = program[53]
                    == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
                && column == binding_count
                && program[ig_segmented_property_value_base(program) + 2ul]
                    == IG_SEGMENTED_PROPERTY_VALUE_FLAT_LIST_GROUP;
            bool binding_group = column < binding_count
                && program[program[41]
                    + column * IG_SEGMENTED_GRAPH_BINDING_WORDS + 10ul] == 1ul;
            if (expression_start != 0ul || (!binding_group && !property_group)) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            ++direct_groups;
        } else {
            if (program[53] != IG_SEGMENTED_GRAPH_SOURCE_GRAPH
                    || column != binding_count + property_value_columns + computed_groups
                    || expression_start != expression_cursor
                    || !ig_segmented_graph_range(
                        expression_start, expression_count, instruction_count)
                    || !ig_segmented_graph_expression_shape(
                        program, expression_start, expression_count, binding_count)
                    || ig_segmented_graph_has_virtual_order_suffix(
                        program, expression_start, expression_count)) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            expression_cursor += expression_count;
            ++computed_groups;
        }
        for (ulong prior = 0ul; prior < key; ++prior) {
            if (uint(program[program[42] + prior]) == uint(column)) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
    }
    if (group_markers + property_value_group_markers != direct_groups
            || direct_groups + computed_groups != grouping_count
            || source_columns != binding_count + property_value_columns
                + computed_groups + aggregate_count + 1ul) {
        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }
    for (ulong binding = 0ul; binding < binding_count; ++binding) {
        ulong binding_base = program[41] + binding * IG_SEGMENTED_GRAPH_BINDING_WORDS;
        if (program[binding_base + 10ul] == 0ul) continue;
        bool found = false;
        for (ulong key = 0ul; key < grouping_count; ++key) {
            ulong descriptor = program[program[42] + key];
            found = found || (descriptor >> 48ul) == 0ul
                && uint(descriptor) == uint(binding);
        }
        if (!found) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }

    return 0u;
}

inline uint ig_segmented_graph_validate_aggregates_initial_contract(
    device const ulong* nullable,
    device const ulong* program,
    device const uint* grouping_columns,
    device const uint* aggregate_descriptors,
    constant IgSegmentedGraphArgs& args) {
    ulong binding_count = program[4];
    ulong grouping_count = program[5];
    ulong aggregate_count = program[6];
    ulong slot_count = program[7];
    ulong initial_count = program[8];
    ulong instruction_count = program[12];
    ulong source_columns = program[18];
    ulong property_value_columns = program[53]
            == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
        ? 1ul : 0ul;

    ulong computed_groups = 0ul;
    ulong expression_cursor = 0ul;
    for (ulong key = 0ul; key < grouping_count; ++key) {
        ulong descriptor = program[program[42] + key];
        ulong expression_count = descriptor >> 48ul;
        if (expression_count == 0ul) continue;
        expression_cursor += expression_count;
        ++computed_groups;
    }

    for (ulong aggregate = 0ul; aggregate < aggregate_count; ++aggregate) {
        ulong descriptor = program[43] + aggregate * IG_SEGMENTED_GRAPH_AGGREGATE_WORDS;
        ulong kind = program[descriptor];
        ulong input = program[descriptor + 1ul];
        ulong distinct = program[descriptor + 2ul];
        ulong encoded_source = program[descriptor + 3ul];
        ulong percentile = program[descriptor + 4ul];
        bool percentile_kind = kind == ulong(IG_SEGMENTED_AGGREGATE_PERCENTILE_DISC)
            || kind == ulong(IG_SEGMENTED_AGGREGATE_PERCENTILE_CONT);
        bool count_all = encoded_source == ~0ul;
        ulong expression_start = count_all ? 0ul : ulong(uint(encoded_source));
        ulong expression_count = count_all ? 0ul : ulong(uint(encoded_source >> 32ul));
        bool direct_source = !count_all && expression_count == 0ul
            && (expression_start < binding_count
                || (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH
                    && expression_start == binding_count)
                || (property_value_columns == 1ul
                    && expression_start == binding_count
                    && program[ig_segmented_property_value_base(program) + 2ul]
                        == IG_SEGMENTED_PROPERTY_VALUE_STRUCTURAL_DISTINCT));
        bool computed_source = !count_all && expression_count != 0ul
            && expression_start == expression_cursor
            && ig_segmented_graph_range(
                expression_start, expression_count, instruction_count)
            && ig_segmented_graph_expression_shape(
                program, expression_start, expression_count, binding_count)
            && !ig_segmented_graph_has_virtual_order_suffix(
                program, expression_start, expression_count);
        ulong tensor = aggregate * IG_SEGMENTED_AGGREGATE_WORDS;
        if (kind < IG_SEGMENTED_AGGREGATE_COUNT_VALUE
                || kind > ulong(IG_SEGMENTED_AGGREGATE_PERCENTILE_CONT)
                || input != binding_count + property_value_columns
                    + computed_groups + aggregate
                || input >= source_columns - 1ul
                || distinct > 1ul
                || (percentile_kind
                    ? !ig_segmented_percentile_valid(percentile)
                    : percentile != 0ul)
                || !((count_all && kind == IG_SEGMENTED_AGGREGATE_COUNT_VALUE)
                    || direct_source || computed_source)
                || aggregate_descriptors[tensor] != uint(kind)
                || aggregate_descriptors[tensor + 1ul] != uint(input)
                || aggregate_descriptors[tensor + 2ul] != uint(distinct)
                || aggregate_descriptors[tensor + 3ul] != uint(percentile)
                || aggregate_descriptors[tensor + 4ul] != uint(percentile >> 32ul)) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        if (computed_source) expression_cursor += expression_count;
    }

    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH) {
        ulong aggregate_base = program[43];
        if (program[program[42]] != 0ul || program[program[42] + 1ul] != 1ul
                || grouping_columns[0] != 0u || grouping_columns[1] != 1u
                || program[aggregate_base] != IG_SEGMENTED_AGGREGATE_SUM
                || program[aggregate_base + 1ul] != 6ul
                || program[aggregate_base + 2ul] != 0ul
                || program[aggregate_base + 3ul] != 6ul
                || program[aggregate_base + 4ul] != 0ul
                || aggregate_descriptors[0] != uint(IG_SEGMENTED_AGGREGATE_SUM)
                || aggregate_descriptors[1] != 6u
                || aggregate_descriptors[2] != 0u
                || aggregate_descriptors[3] != 0u
                || aggregate_descriptors[4] != 0u) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }

    for (ulong mapping = 0ul; mapping < initial_count; ++mapping) {
        ulong base = program[44] + mapping * IG_SEGMENTED_GRAPH_INITIAL_WORDS;
        if (program[base] >= slot_count || program[base + 1ul] >= initial_count) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        for (ulong prior = 0ul; prior < mapping; ++prior) {
            ulong prior_base = program[44] + prior * IG_SEGMENTED_GRAPH_INITIAL_WORDS;
            if (program[prior_base] == program[base]
                    || program[prior_base + 1ul] == program[base + 1ul]) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
    }

    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS) {
        ulong property_base = ig_segmented_property_keys_base(program);
        ulong aggregate_base = program[43];
        ulong first_mapping = program[44];
        ulong second_mapping = first_mapping + IG_SEGMENTED_GRAPH_INITIAL_WORDS;
        if (program[program[42]] != 0ul || grouping_columns[0] != 0u
                || program[aggregate_base] != IG_SEGMENTED_AGGREGATE_COUNT_VALUE
                || program[aggregate_base + 1ul] != 1ul
                || program[aggregate_base + 2ul] != 0ul
                || program[aggregate_base + 3ul] != ~0ul
                || aggregate_descriptors[0] != uint(IG_SEGMENTED_AGGREGATE_COUNT_VALUE)
                || aggregate_descriptors[1] != 1u
                || aggregate_descriptors[2] != 0u || aggregate_descriptors[3] != 0u
                || program[first_mapping] != program[property_base + 10ul]
                || program[first_mapping + 1ul] != 0ul
                || program[second_mapping] != program[property_base + 11ul]
                || program[second_mapping + 1ul] != 1ul
                || program[program[49]] != program[property_base + 10ul]) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE) {
        ulong property_base = ig_segmented_property_value_base(program);
        ulong mode = program[property_base + 2ul];
        ulong property_column = program[property_base + 7ul];
        ulong aggregate_base = program[43];
        ulong first_mapping = program[44];
        bool structural = mode == IG_SEGMENTED_PROPERTY_VALUE_STRUCTURAL_DISTINCT;
        bool flat_group = mode == IG_SEGMENTED_PROPERTY_VALUE_FLAT_LIST_GROUP;
        ulong published_list_slot = program[property_base + 12ul];
        ulong published_outputs = 0ul;
        for (ulong output = 0ul; output < program[13]; ++output) {
            published_outputs += program[program[49] + output] == published_list_slot
                ? 1ul : 0ul;
        }
        ulong expected_input = binding_count + 1ul + computed_groups;
        if (aggregate_count != 1ul
                || program[aggregate_base] != IG_SEGMENTED_AGGREGATE_COUNT_VALUE
                || program[aggregate_base + 1ul] != expected_input
                || program[aggregate_base + 2ul] != (structural ? 1ul : 0ul)
                || program[aggregate_base + 3ul] != (structural ? property_column : ~0ul)
                || aggregate_descriptors[0] != uint(IG_SEGMENTED_AGGREGATE_COUNT_VALUE)
                || aggregate_descriptors[1] != uint(expected_input)
                || aggregate_descriptors[2] != (structural ? 1u : 0u)
                || aggregate_descriptors[3] != 0u
                || (structural
                    && (grouping_count != 0ul || initial_count != 1ul
                        || program[first_mapping + 1ul] != 0ul
                        || published_list_slot != ~0ul))
                || (flat_group
                    && (grouping_count != 1ul || initial_count != 2ul
                        || uint(program[program[42]]) != uint(property_column)
                        || grouping_columns[0] != uint(property_column)
                        || program[first_mapping + 1ul] != 0ul
                        || program[first_mapping + IG_SEGMENTED_GRAPH_INITIAL_WORDS + 1ul]
                            != 1ul
                        || published_list_slot >= slot_count
                        || program[13] != 2ul || published_outputs != 1ul))
                || (!structural && !flat_group)) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER) {
        ulong unit_kind = ig_segmented_unit_kind(program);
        ulong aggregate_base = program[43];
        ulong first_mapping = program[44];
        ulong second_mapping = first_mapping + IG_SEGMENTED_GRAPH_INITIAL_WORDS;
        ulong expected_group_column = unit_kind == IG_SEGMENTED_UNIT_INDEXED_COUNT
            ? 0ul : (ig_segmented_unit_integer_list_order(program) ? 1ul : 2ul);
        ulong expected_kind = unit_kind == IG_SEGMENTED_UNIT_INDEXED_COUNT
            ? IG_SEGMENTED_AGGREGATE_COUNT_VALUE : IG_SEGMENTED_AGGREGATE_COLLECT;
        ulong expected_source = unit_kind == IG_SEGMENTED_UNIT_INDEXED_COUNT ? 1ul : 0ul;
        if (program[program[42]] != expected_group_column
                || grouping_columns[0] != uint(expected_group_column)
                || program[aggregate_base] != expected_kind
                || program[aggregate_base + 1ul] != binding_count
                || program[aggregate_base + 2ul] != 0ul
                || program[aggregate_base + 3ul] != expected_source
                || aggregate_descriptors[0] != uint(expected_kind)
                || aggregate_descriptors[1] != uint(binding_count)
                || aggregate_descriptors[2] != 0u || aggregate_descriptors[3] != 0u
                || program[first_mapping + 1ul] != 0ul
                || program[second_mapping + 1ul] != 1ul) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }

    return 0u;
}

inline uint ig_segmented_graph_validate_stages_contract(
    device const ulong* nullable,
    device const ulong* program,
    device const uint* grouping_columns,
    device const uint* aggregate_descriptors,
    constant IgSegmentedGraphArgs& args) {
    ulong aggregate_count = program[6];
    ulong stage_count = program[9];
    ulong projection_count = program[10];
    ulong order_count = program[11];
    ulong instruction_count = program[12];
    ulong receipt_count = program[14];
    ulong maximum_projection_width = program[15];
    ulong maximum_order_width = program[16];

    ulong project_cursor = 0ul;
    ulong order_cursor = 0ul;
    ulong expression_cursor = 0ul;
    for (ulong key = 0ul; key < program[5]; ++key) {
        expression_cursor += program[program[42] + key] >> 48ul;
    }
    for (ulong aggregate = 0ul; aggregate < aggregate_count; ++aggregate) {
        ulong encoded_source = program[program[43]
            + aggregate * IG_SEGMENTED_GRAPH_AGGREGATE_WORDS + 3ul];
        if (encoded_source != ~0ul) {
            expression_cursor += ulong(uint(encoded_source >> 32ul));
        }
    }
    ulong observed_projection_width = 0ul;
    ulong observed_order_width = 0ul;
    if (program[54] != 0ul
            && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC) {
        if (!ig_segmented_graph_pre_order_shape(program)) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        ulong base = program[54];
        ulong item_start = program[base + 2ul];
        ulong item_count = program[base + 3ul];
        order_cursor = item_count;
        observed_order_width = item_count;
        for (ulong item = 0ul; item < item_count; ++item) {
            ulong descriptor = program[47]
                + (item_start + item) * IG_SEGMENTED_GRAPH_ORDER_WORDS;
            if (program[descriptor] != expression_cursor
                    || !ig_segmented_graph_range(
                        expression_cursor,
                        program[descriptor + 1ul],
                        instruction_count)
                    || !ig_segmented_graph_expression_shape(
                        program,
                        expression_cursor,
                        program[descriptor + 1ul],
                        program[4])) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            expression_cursor += program[descriptor + 1ul];
        }
    }
    for (ulong stage = 0ul; stage < stage_count; ++stage) {
        ulong base = program[45] + stage * IG_SEGMENTED_GRAPH_STAGE_WORDS;
        ulong kind = program[base];
        ulong item_start = program[base + 1ul];
        ulong item_count = program[base + 2ul];
        ulong rows = program[base + 3ul];
        ulong receipt = program[base + 4ul];
        ulong expected_receipt = 2ul + aggregate_count
            + ig_segmented_graph_pre_stage_count(program)
            + stage;
        if (receipt >= receipt_count || receipt != expected_receipt) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        ulong receipt_role = program[
            program[50] + receipt * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS + 2ul];
        ulong expected_role = ~0ul;
        if (kind == IG_SEGMENTED_GRAPH_STAGE_PROJECT) {
            expected_role = IG_SEGMENTED_GRAPH_RECEIPT_PROJECT;
            if (item_start != project_cursor || item_count == 0ul
                    || !ig_segmented_graph_range(item_start, item_count, projection_count)
                    || rows != 0ul) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            project_cursor += item_count;
            observed_projection_width = max(observed_projection_width, item_count);
            for (ulong item = 0ul; item < item_count; ++item) {
                ulong projection = item_start + item;
                ulong projection_base = program[46]
                    + projection * IG_SEGMENTED_GRAPH_PROJECTION_WORDS;
                if (program[projection_base + 1ul] != expression_cursor
                        || !ig_segmented_graph_range(
                            expression_cursor,
                            program[projection_base + 2ul],
                            instruction_count)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
                expression_cursor += program[projection_base + 2ul];
                for (ulong prior = 0ul; prior < item; ++prior) {
                    ulong prior_projection = item_start + prior;
                    ulong prior_base = program[46]
                        + prior_projection * IG_SEGMENTED_GRAPH_PROJECTION_WORDS;
                    if (program[prior_base] == program[projection_base]) {
                        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                    }
                }
            }
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_ORDER) {
            expected_role = IG_SEGMENTED_GRAPH_RECEIPT_ORDER;
            if (item_start != order_cursor || item_count == 0ul
                    || !ig_segmented_graph_range(item_start, item_count, order_count)
                    || rows != 0ul) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            order_cursor += item_count;
            observed_order_width = max(observed_order_width, item_count);
            for (ulong item = 0ul; item < item_count; ++item) {
                ulong order = item_start + item;
                ulong order_base = program[47]
                    + order * IG_SEGMENTED_GRAPH_ORDER_WORDS;
                if (program[order_base] != expression_cursor
                        || !ig_segmented_graph_range(
                            expression_cursor,
                            program[order_base + 1ul],
                            instruction_count)) {
                    return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
                }
                expression_cursor += program[order_base + 1ul];
            }
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_FILTER) {
            expected_role = IG_SEGMENTED_GRAPH_RECEIPT_FILTER;
            if (item_start != expression_cursor || item_count == 0ul
                    || !ig_segmented_graph_range(
                        item_start, item_count, instruction_count)
                    || rows != 0ul) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
            expression_cursor += item_count;
        } else if (kind == IG_SEGMENTED_GRAPH_STAGE_SKIP
                || kind == IG_SEGMENTED_GRAPH_STAGE_LIMIT) {
            expected_role = kind == IG_SEGMENTED_GRAPH_STAGE_SKIP
                ? IG_SEGMENTED_GRAPH_RECEIPT_SKIP : IG_SEGMENTED_GRAPH_RECEIPT_LIMIT;
            if (item_start != 0ul || item_count != 0ul || rows > 0xfffffffful) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        } else {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        if (receipt_role != expected_role) return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        for (ulong prior = 0ul; prior < stage; ++prior) {
            ulong prior_base = program[45] + prior * IG_SEGMENTED_GRAPH_STAGE_WORDS;
            if (program[prior_base + 4ul] == receipt) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
    }
    if (project_cursor != projection_count || order_cursor != order_count
            || expression_cursor != instruction_count
            || observed_projection_width != maximum_projection_width
            || observed_order_width != maximum_order_width) {
        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE) {
        ulong property_base = ig_segmented_property_value_base(program);
        if (program[property_base + 2ul]
                == IG_SEGMENTED_PROPERTY_VALUE_FLAT_LIST_GROUP) {
            ulong stage = program[45];
            ulong first_projection = program[46];
            ulong second_projection = first_projection
                + IG_SEGMENTED_GRAPH_PROJECTION_WORDS;
            ulong first_mapping = program[44];
            ulong second_mapping = first_mapping + IG_SEGMENTED_GRAPH_INITIAL_WORDS;
            ulong group_slot = program[first_mapping];
            ulong count_slot = program[second_mapping];
            ulong published_slot = program[property_base + 12ul];
            bool saw_list = false;
            bool saw_count = false;
            for (ulong item = 0ul; item < 2ul; ++item) {
                ulong projection = first_projection
                    + item * IG_SEGMENTED_GRAPH_PROJECTION_WORDS;
                ulong instruction = program[48]
                    + program[projection + 1ul]
                        * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS;
                ulong source = program[instruction + 1ul];
                bool plain_slot = program[projection + 2ul] == 1ul
                    && program[projection + 3ul] == 0ul
                    && program[instruction] == IG_SEGMENTED_GRAPH_INSTRUCTION_SLOT
                    && program[instruction + 2ul] == 0ul
                    && program[instruction + 3ul] == 0ul;
                saw_list = saw_list || (plain_slot && source == group_slot
                    && program[projection] == published_slot);
                saw_count = saw_count || (plain_slot && source == count_slot
                    && program[projection] != published_slot);
            }
            ulong first_output = program[program[49]];
            ulong second_output = program[program[49] + 1ul];
            bool exact_outputs = first_output != second_output
                && ((first_output == program[first_projection]
                        && second_output == program[second_projection])
                    || (first_output == program[second_projection]
                        && second_output == program[first_projection]));
            if (stage_count != 1ul || projection_count != 2ul
                    || order_count != 0ul || instruction_count != 2ul
                    || program[stage] != IG_SEGMENTED_GRAPH_STAGE_PROJECT
                    || program[stage + 1ul] != 0ul || program[stage + 2ul] != 2ul
                    || program[stage + 3ul] != 0ul || !saw_list || !saw_count
                    || !exact_outputs) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        } else if (program[property_base + 2ul]
                == IG_SEGMENTED_PROPERTY_VALUE_STRUCTURAL_DISTINCT) {
            ulong stage = program[45];
            ulong projection = program[46];
            ulong instruction = program[48];
            ulong reduction_slot = program[program[44]];
            if (stage_count != 1ul || projection_count != 1ul
                    || order_count != 0ul || instruction_count != 1ul
                    || program[13] != 1ul
                    || program[stage] != IG_SEGMENTED_GRAPH_STAGE_PROJECT
                    || program[stage + 1ul] != 0ul || program[stage + 2ul] != 1ul
                    || program[stage + 3ul] != 0ul
                    || program[projection + 1ul] != 0ul
                    || program[projection + 2ul] != 1ul
                    || program[projection + 3ul] != 0ul
                    || program[instruction] != IG_SEGMENTED_GRAPH_INSTRUCTION_SLOT
                    || program[instruction + 1ul] != reduction_slot
                    || program[instruction + 2ul] != 0ul
                    || program[instruction + 3ul] != 0ul
                    || program[program[49]] != program[projection]) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
    }
    if (program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
            && ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY) {
        ulong stage = program[45];
        ulong projection = program[46];
        ulong first_instruction = program[48];
        ulong second_instruction = first_instruction + IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS;
        ulong reduction_mapping = program[44] + IG_SEGMENTED_GRAPH_INITIAL_WORDS;
        if (program[stage] != IG_SEGMENTED_GRAPH_STAGE_PROJECT
                || program[stage + 1ul] != 0ul || program[stage + 2ul] != 1ul
                || program[stage + 3ul] != 0ul
                || program[projection + 1ul] != 0ul || program[projection + 2ul] != 2ul
                || program[projection + 3ul] != 0ul
                || program[first_instruction] != IG_SEGMENTED_GRAPH_INSTRUCTION_SLOT
                || program[first_instruction + 1ul] != program[reduction_mapping]
                || program[first_instruction + 2ul] != 0ul
                || program[first_instruction + 3ul] != 0ul
                || program[second_instruction]
                    != IG_SEGMENTED_GRAPH_INSTRUCTION_RANK_RANGE_EQUAL
                || program[second_instruction + 1ul]
                    != program[17]
                || program[second_instruction + 2ul] != 0ul
                || program[second_instruction + 3ul] != 0ul
                || program[program[49]] != program[projection]) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }

    return 0u;
}

inline uint ig_segmented_graph_validate_expressions_output_contract(
    device const ulong* nullable,
    device const ulong* program,
    device const uint* grouping_columns,
    device const uint* aggregate_descriptors,
    constant IgSegmentedGraphArgs& args) {
    ulong slot_count = program[7];
    ulong projection_count = program[10];
    ulong order_count = program[11];
    ulong instruction_count = program[12];
    ulong output_columns = program[13];
    ulong stage_count = program[9];
    ulong key_value_projections = 0ul;
    ulong map_projections = 0ul;

    for (ulong projection = 0ul; projection < projection_count; ++projection) {
        ulong base = program[46] + projection * IG_SEGMENTED_GRAPH_PROJECTION_WORDS;
        ulong start = program[base + 1ul];
        ulong count = program[base + 2ul];
        bool in_range = ig_segmented_graph_range(start, count, instruction_count);
        bool key_value = in_range && count == 1ul
            && program[program[48] + start * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS]
                == IG_SEGMENTED_GRAPH_INSTRUCTION_KEY_VALUE_LIST;
        bool map = in_range && count != 0ul
            && program[program[48]
                + (start + count - 1ul) * IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS]
                == IG_SEGMENTED_GRAPH_INSTRUCTION_MAP_PUBLICATION;
        bool virtual_order_suffix = in_range
            && ig_segmented_graph_has_virtual_order_suffix(program, start, count);
        if (program[base] >= slot_count || program[base + 2ul] == 0ul
                || !in_range
                || virtual_order_suffix
                || !(key_value
                    ? ig_segmented_key_value_list_shape(program, start, count, slot_count)
                    : map
                        ? ig_segmented_graph_map_shape(
                            program, start, count, program[base], slot_count)
                        : ig_segmented_graph_expression_shape(
                            program, start, count, slot_count))
                || program[base + 3ul] != 0ul) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        key_value_projections += key_value ? 1ul : 0ul;
        map_projections += map ? 1ul : 0ul;
    }
    for (ulong order = 0ul; order < order_count; ++order) {
        ulong base = program[47] + order * IG_SEGMENTED_GRAPH_ORDER_WORDS;
        if (program[base + 1ul] == 0ul
                || !ig_segmented_graph_range(
                    program[base], program[base + 1ul], instruction_count)
                || !ig_segmented_graph_expression_shape(
                    program, program[base], program[base + 1ul], slot_count)
                || program[base + 2ul] > 3ul || program[base + 3ul] != 0ul) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }
    for (ulong stage = 0ul; stage < stage_count; ++stage) {
        ulong base = program[45] + stage * IG_SEGMENTED_GRAPH_STAGE_WORDS;
        if (program[base] == IG_SEGMENTED_GRAPH_STAGE_FILTER
                && (!ig_segmented_graph_expression_shape(
                    program, program[base + 1ul], program[base + 2ul], slot_count)
                    || ig_segmented_graph_has_virtual_order_suffix(
                        program, program[base + 1ul], program[base + 2ul]))) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }
    for (ulong output = 0ul; output < output_columns; ++output) {
        if (program[program[49] + output] >= slot_count) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }
    bool key_value_extension = program[54] != 0ul
        && program[program[54]] == IG_SEGMENTED_KEY_VALUE_LIST_MAGIC;
    bool map_extension = program[54] != 0ul
        && program[program[54]] == IG_SEGMENTED_GRAPH_MAP_MAGIC;
    bool pre_order_extension = program[54] != 0ul
        && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC;
    if (key_value_projections != (key_value_extension ? 1ul : 0ul)
            || map_projections != (map_extension ? 1ul : 0ul)
            || (pre_order_extension && !ig_segmented_graph_pre_order_shape(program))) {
        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }

    return 0u;
}

inline uint ig_segmented_graph_validate_receipts_contract(
    device const ulong* nullable,
    device const ulong* program,
    device const uint* grouping_columns,
    device const uint* aggregate_descriptors,
    constant IgSegmentedGraphArgs& args) {
    ulong aggregate_count = program[6];
    ulong stage_count = program[9];
    ulong receipt_count = program[14];
    ulong pre_stage_count = ig_segmented_graph_pre_stage_count(program);
    ulong aggregate_receipt_index = 1ul + pre_stage_count;
    ulong post_receipt_start = aggregate_receipt_index + 1ul + aggregate_count;

    ulong source_receipts = 0ul;
    ulong aggregate_receipts = 0ul;
    ulong reduction_receipts = 0ul;
    ulong project_receipts = 0ul;
    ulong order_receipts = 0ul;
    ulong skip_receipts = 0ul;
    ulong limit_receipts = 0ul;
    ulong filter_receipts = 0ul;
    ulong pre_project_receipts = 0ul;
    ulong pre_unwind_receipts = 0ul;
    ulong pre_order_receipts = 0ul;
    ulong property_keys_receipts = 0ul;
    ulong property_unwind_receipts = 0ul;
    ulong property_value_receipts = 0ul;
    ulong repeated_aggregate_receipts = 0ul;
    ulong repeated_reduction_receipts = 0ul;
    ulong repeated_project_receipts = 0ul;
    ulong repeated_unwind_receipts = 0ul;
    for (ulong receipt = 0ul; receipt < receipt_count; ++receipt) {
        ulong base = program[50]
            + receipt * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS;
        ulong id = program[base];
        ulong metadata = program[base + 1ul];
        ulong role = program[base + 2ul];
        ulong expected_role = receipt == 0ul ? IG_SEGMENTED_GRAPH_RECEIPT_SOURCE
            : receipt <= pre_stage_count
                ? (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS
                    ? (receipt == 1ul
                        ? IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_KEYS
                        : IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_UNWIND)
                    : program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE
                        ? IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_VALUE
                    : program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH
                        ? (receipt == 1ul
                            ? IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_AGGREGATE
                            : receipt <= 4ul
                                ? IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_REDUCTION
                                : receipt == 5ul
                                    ? IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_PROJECT
                                    : IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_UNWIND)
                    : (program[53] == IG_SEGMENTED_GRAPH_SOURCE_GRAPH
                            && program[54] != 0ul
                            && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC
                        ? IG_SEGMENTED_GRAPH_RECEIPT_PRE_ORDER
                        : ig_segmented_unit_pre_receipt_role(program, receipt)))
            : receipt == aggregate_receipt_index ? IG_SEGMENTED_GRAPH_RECEIPT_AGGREGATE
            : receipt < post_receipt_start ? IG_SEGMENTED_GRAPH_RECEIPT_REDUCTION
            : ig_segmented_graph_stage_receipt_role(program[
                program[45]
                    + (receipt - post_receipt_start)
                        * IG_SEGMENTED_GRAPH_STAGE_WORDS]);
        if (id == 0ul || (metadata >> 32u) != 0ul
                || role > IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_UNWIND
                || role != expected_role) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
        for (ulong prior = 0ul; prior < receipt; ++prior) {
            if (program[program[50]
                    + prior * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS] == id) {
                return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
            }
        }
        source_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_SOURCE ? 1ul : 0ul;
        aggregate_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_AGGREGATE ? 1ul : 0ul;
        reduction_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_REDUCTION ? 1ul : 0ul;
        project_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_PROJECT ? 1ul : 0ul;
        order_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_ORDER ? 1ul : 0ul;
        skip_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_SKIP ? 1ul : 0ul;
        limit_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_LIMIT ? 1ul : 0ul;
        filter_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_FILTER ? 1ul : 0ul;
        pre_project_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_PROJECT ? 1ul : 0ul;
        pre_unwind_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_UNWIND ? 1ul : 0ul;
        pre_order_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_PRE_ORDER ? 1ul : 0ul;
        property_keys_receipts += role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_KEYS ? 1ul : 0ul;
        property_unwind_receipts +=
            role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_UNWIND ? 1ul : 0ul;
        property_value_receipts +=
            role == IG_SEGMENTED_GRAPH_RECEIPT_PROPERTY_VALUE ? 1ul : 0ul;
        repeated_aggregate_receipts +=
            role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_AGGREGATE ? 1ul : 0ul;
        repeated_reduction_receipts +=
            role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_REDUCTION ? 1ul : 0ul;
        repeated_project_receipts +=
            role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_PROJECT ? 1ul : 0ul;
        repeated_unwind_receipts +=
            role == IG_SEGMENTED_GRAPH_RECEIPT_REPEATED_UNWIND ? 1ul : 0ul;
    }
    ulong expected_projects = 0ul;
    ulong expected_orders = 0ul;
    ulong expected_skips = 0ul;
    ulong expected_limits = 0ul;
    ulong expected_filters = 0ul;
    for (ulong stage = 0ul; stage < stage_count; ++stage) {
        ulong kind = program[program[45] + stage * IG_SEGMENTED_GRAPH_STAGE_WORDS];
        expected_projects += kind == IG_SEGMENTED_GRAPH_STAGE_PROJECT ? 1ul : 0ul;
        expected_orders += kind == IG_SEGMENTED_GRAPH_STAGE_ORDER ? 1ul : 0ul;
        expected_skips += kind == IG_SEGMENTED_GRAPH_STAGE_SKIP ? 1ul : 0ul;
        expected_limits += kind == IG_SEGMENTED_GRAPH_STAGE_LIMIT ? 1ul : 0ul;
        expected_filters += kind == IG_SEGMENTED_GRAPH_STAGE_FILTER ? 1ul : 0ul;
    }
    if (source_receipts != 1ul || aggregate_receipts != 1ul
            || reduction_receipts != aggregate_count
            || project_receipts != expected_projects || order_receipts != expected_orders
            || skip_receipts != expected_skips || limit_receipts != expected_limits
            || filter_receipts != expected_filters
            || pre_project_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
                    ? (ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
                        ? 3ul : 1ul)
                    : 0ul)
            || pre_unwind_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
                    ? (ig_segmented_unit_kind(program) == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY
                        ? 1ul : 2ul)
                    : 0ul)
            || pre_order_receipts
                != ((program[53] == IG_SEGMENTED_GRAPH_SOURCE_UNIT_QUANTIFIER
                            && ig_segmented_unit_kind(program)
                                == IG_SEGMENTED_UNIT_SCALAR_CONSISTENCY)
                        || (program[53] == IG_SEGMENTED_GRAPH_SOURCE_GRAPH
                            && program[54] != 0ul
                            && program[program[54]] == IG_SEGMENTED_GRAPH_PRE_ORDER_MAGIC)
                    ? 1ul : 0ul)
            || property_keys_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS ? 1ul : 0ul)
            || property_unwind_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_KEYS ? 1ul : 0ul)
            || property_value_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_PROPERTY_VALUE ? 1ul : 0ul)
            || repeated_aggregate_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH ? 1ul : 0ul)
            || repeated_reduction_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH ? 3ul : 0ul)
            || repeated_project_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH ? 1ul : 0ul)
            || repeated_unwind_receipts
                != (program[53] == IG_SEGMENTED_GRAPH_SOURCE_REPEATED_MATCH ? 1ul : 0ul)) {
        return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
    }

    // Generic receipt order is fixed by the reusable aggregation ABI.  Match its aggregate seed
    // to the unique aggregate receipt and its reduction seeds to reduction receipts in descriptor
    // order, without imposing any order on the outer receipt packet itself.
    ulong reduction_seed = 1ul;
    for (ulong receipt = 0ul; receipt < receipt_count; ++receipt) {
        ulong outer = program[50]
            + receipt * IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS;
        ulong role = program[outer + 2ul];
        ulong seed = ~0ul;
        if (role == IG_SEGMENTED_GRAPH_RECEIPT_AGGREGATE) seed = 0ul;
        else if (role == IG_SEGMENTED_GRAPH_RECEIPT_REDUCTION) seed = reduction_seed++;
        if (seed == ~0ul) continue;
        ulong generic = program[51] + seed * 2ul;
        if (program[generic] != program[outer]
                || program[generic + 1ul] != program[outer + 1ul]) {
            return IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM;
        }
    }
    return 0u;
}

kernel void ig_segmented_graph_initialize(
    device const ulong* program [[buffer(3)]],
    device atomic_uint* graph_control [[buffer(9)]],
    device ulong* output_header [[buffer(10)]],
    device ulong* output_cells [[buffer(11)]],
    device uchar* output_arena [[buffer(12)]],
    device ulong* outer_receipts [[buffer(13)]],
    constant IgSegmentedGraphArgs& args [[buffer(14)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    for (uint word = 0u; word < 8u; ++word) {
        atomic_store_explicit(&graph_control[word], 0u, memory_order_relaxed);
    }
    if (args.output_header_words < IG_SEGMENTED_GRAPH_OUTPUT_HEADER_WORDS) {
        ig_segmented_graph_validation_finish(
            graph_control,
            IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY,
            IG_SEGMENTED_GRAPH_VALIDATION_INITIALIZED);
        return;
    }
    for (ulong word = 0ul; word < args.output_header_words; ++word) output_header[word] = 0ul;
    for (ulong word = 0ul; word < args.output_cell_words; ++word) output_cells[word] = 0ul;
    for (ulong byte = 0ul; byte < args.output_arena_storage_bytes; ++byte) {
        output_arena[byte] = 0u;
    }
    for (ulong word = 0ul; word < args.outer_receipt_words; ++word) outer_receipts[word] = 0ul;
    if (args.program_words < IG_SEGMENTED_GRAPH_PROGRAM_HEADER_WORDS) {
        output_header[0] = IG_SEGMENTED_GRAPH_OUTPUT_MAGIC;
        output_header[23] = IG_SEGMENTED_GRAPH_OUTPUT_VERSION;
        ig_segmented_graph_fail(output_header, IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM);
        ig_segmented_graph_validation_finish(
            graph_control,
            IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM,
            IG_SEGMENTED_GRAPH_VALIDATION_INITIALIZED);
        return;
    }
    ig_segmented_graph_initialize_output(program, output_header);
    atomic_store_explicit(
        &graph_control[7], IG_SEGMENTED_GRAPH_VALIDATION_INITIALIZED, memory_order_relaxed);
}

