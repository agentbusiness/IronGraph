constant uint IG_ROW_PROOF_MAGIC = 0x47525046u;
constant uint IG_ROW_PROOF_HEADER_WORDS = 38u;
constant uint IG_ROW_PROOF_EMPTY = 0u;
constant uint IG_ROW_PROOF_IDENTITY = 1u;
constant uint IG_ROW_PROOF_TOP_K = 2u;
constant uint IG_ROW_PROOF_RADIX = 3u;
constant uint IG_ROW_PROOF_BOUNDS = 1u;
constant uint IG_ROW_PROOF_MEMBERSHIP = 2u;
constant uint IG_ROW_PROOF_ORDER = 4u;
constant uint IG_ROW_PROOF_OPTIMALITY = 8u;
constant uint IG_ROW_PROOF_IDENTITY_FAILURE = 16u;
constant uint IG_ROW_PROOF_GRAPH_ALIGNMENT = 32u;
constant uint IG_ROW_PROOF_DESCRIPTOR = 64u;

constant ulong IG_ROW_F64_SIGN = 0x8000000000000000ul;
constant ulong IG_ROW_F64_EXPONENT = 0x7ff0000000000000ul;
constant ulong IG_ROW_F64_FRACTION = 0x000ffffffffffffful;
constant ulong IG_ROW_F64_HIDDEN = 0x0010000000000000ul;
constant ulong IG_ROW_F64_QUIET = 0x0008000000000000ul;
constant ulong IG_ROW_F64_CANONICAL_NAN = 0x7ff8000000000000ul;
constant ulong IG_ROW_I64_MAX_BITS = 0x7ffffffffffffffful;
constant uint IG_ROW_EVALUATION_OK = 0xffffffffu;
constant uint IG_ROW_ERROR_OVERFLOW = 1u;
constant uint IG_ROW_ERROR_MODULO_ZERO = 2u;
constant uint IG_ROW_ERROR_DESCRIPTOR = 3u;
constant uint IG_ROW_ERROR_NEGATE_OVERFLOW = 4u;
constant uint IG_ROW_ERROR_TEMPORAL_RANGE = 6u;
constant uint IG_ROW_ERROR_UNSUPPORTED_TIMEZONE = 7u;
constant uint IG_ROW_STRING_REFERENCE_MARKER = 0x80000000u;
constant uint IG_ROW_LIST_ELEMENT_BYTES = 9u;
constant uchar IG_ROW_LIST_ELEMENT_INTEGER = 1;
constant uchar IG_ROW_LIST_ELEMENT_NULL = 2;
constant long IG_ROW_NANOS_PER_SECOND = 1000000000L;
constant long IG_ROW_SECONDS_PER_DAY = 86400L;
constant long IG_ROW_NANOS_PER_DAY = 86400000000000L;
constant long IG_ROW_TEMPORAL_MAX_YEAR = 999999999L;
constant long IG_ROW_CHRONO_MIN_YEAR = -262143L;
constant long IG_ROW_CHRONO_MAX_YEAR = 262142L;
constant long IG_ROW_TEMPORAL_MAX_EPOCH_DAY = 366000000000L;

inline bool ig_row_f64_is_nan(ulong bits) {
    return (bits & IG_ROW_F64_EXPONENT) == IG_ROW_F64_EXPONENT
        && (bits & IG_ROW_F64_FRACTION) != 0;
}

inline bool ig_row_f64_is_infinite(ulong bits) {
    return (bits & ~IG_ROW_F64_SIGN) == IG_ROW_F64_EXPONENT;
}

inline ulong ig_row_f64_quiet_nan(ulong bits) {
    return bits | IG_ROW_F64_EXPONENT | IG_ROW_F64_QUIET;
}

inline ulong ig_row_shift_right_jam(ulong value, uint distance) {
    if (distance == 0) return value;
    if (distance < 64) {
        ulong discarded = value << (64 - distance);
        return (value >> distance) | ulong(discarded != 0);
    }
    return ulong(value != 0);
}

inline ulong ig_row_shift_right_jam_128(ulong high, ulong low, uint distance) {
    if (distance == 0) return low;
    if (distance < 64) {
        ulong discarded_mask = (1ul << distance) - 1ul;
        ulong shifted = (low >> distance) | (high << (64 - distance));
        return shifted | ulong((low & discarded_mask) != 0);
    }
    if (distance == 64) return high | ulong(low != 0);
    if (distance < 128) {
        uint high_distance = distance - 64;
        ulong shifted = high >> high_distance;
        ulong discarded = high_distance == 0
            ? low
            : (high << (64 - high_distance)) | low;
        return shifted | ulong(discarded != 0);
    }
    return ulong((high | low) != 0);
}

struct IgRowF64Parts {
    bool sign;
    int exponent;
    ulong significand;
};

inline IgRowF64Parts ig_row_f64_unpack(ulong bits) {
    IgRowF64Parts parts;
    parts.sign = (bits & IG_ROW_F64_SIGN) != 0;
    uint encoded_exponent = uint((bits >> 52) & 0x7fful);
    ulong fraction = bits & IG_ROW_F64_FRACTION;
    if (encoded_exponent != 0) {
        parts.exponent = int(encoded_exponent) - 1023;
        parts.significand = IG_ROW_F64_HIDDEN | fraction;
        return parts;
    }
    uint shift = uint(clz(fraction)) - 11u;
    parts.exponent = -1022 - int(shift);
    parts.significand = fraction << shift;
    return parts;
}

inline ulong ig_row_f64_round_pack(bool sign, int exponent, ulong extended) {
    if (extended == 0) return sign ? IG_ROW_F64_SIGN : 0ul;
    if (exponent < -1022) {
        uint distance = uint(min(4096, -1022 - exponent));
        extended = ig_row_shift_right_jam(extended, distance);
        exponent = -1022;
    }
    ulong significand = extended >> 3;
    ulong remainder = extended & 7ul;
    if (remainder > 4ul || (remainder == 4ul && (significand & 1ul) != 0)) {
        significand += 1ul;
    }
    if ((significand & (IG_ROW_F64_HIDDEN << 1)) != 0) {
        significand >>= 1;
        exponent += 1;
    }
    if (exponent > 1023) {
        return (sign ? IG_ROW_F64_SIGN : 0ul) | IG_ROW_F64_EXPONENT;
    }
    if (significand == 0) return sign ? IG_ROW_F64_SIGN : 0ul;
    ulong sign_bits = sign ? IG_ROW_F64_SIGN : 0ul;
    if (exponent == -1022 && significand < IG_ROW_F64_HIDDEN) {
        return sign_bits | significand;
    }
    ulong encoded_exponent = ulong(exponent + 1023);
    return sign_bits | (encoded_exponent << 52) | (significand & IG_ROW_F64_FRACTION);
}

inline ulong ig_row_i64_to_f64(long value) {
    if (value == 0) return 0ul;
    ulong raw = as_type<ulong>(value);
    bool sign = value < 0;
    ulong magnitude = sign ? (~raw + 1ul) : raw;
    uint most_significant = 63u - uint(clz(magnitude));
    ulong extended = most_significant <= 55u
        ? magnitude << (55u - most_significant)
        : ig_row_shift_right_jam(magnitude, most_significant - 55u);
    return ig_row_f64_round_pack(sign, int(most_significant), extended);
}

inline ulong ig_row_f64_add(ulong left, ulong right) {
    if (ig_row_f64_is_nan(left)) return ig_row_f64_quiet_nan(left);
    if (ig_row_f64_is_nan(right)) return ig_row_f64_quiet_nan(right);
    bool left_infinite = ig_row_f64_is_infinite(left);
    bool right_infinite = ig_row_f64_is_infinite(right);
    if (left_infinite || right_infinite) {
        if (left_infinite && right_infinite
                && ((left ^ right) & IG_ROW_F64_SIGN) != 0) {
            return IG_ROW_F64_CANONICAL_NAN;
        }
        return left_infinite ? left : right;
    }
    ulong left_absolute = left & ~IG_ROW_F64_SIGN;
    ulong right_absolute = right & ~IG_ROW_F64_SIGN;
    if (left_absolute == 0 && right_absolute == 0) {
        return ((left & right) & IG_ROW_F64_SIGN);
    }
    if (left_absolute == 0) return right;
    if (right_absolute == 0) return left;

    IgRowF64Parts a = ig_row_f64_unpack(left);
    IgRowF64Parts b = ig_row_f64_unpack(right);
    if (a.exponent < b.exponent
            || (a.exponent == b.exponent && a.significand < b.significand)) {
        IgRowF64Parts swap = a;
        a = b;
        b = swap;
    }
    uint distance = uint(a.exponent - b.exponent);
    ulong a_extended = a.significand << 3;
    ulong b_extended = ig_row_shift_right_jam(b.significand << 3, distance);
    ulong result;
    if (a.sign == b.sign) {
        result = a_extended + b_extended;
        if ((result & (1ul << 56)) != 0) {
            result = ig_row_shift_right_jam(result, 1);
            a.exponent += 1;
        }
    } else {
        result = a_extended - b_extended;
        if (result == 0) return 0ul;
        uint leading = uint(clz(result));
        if (leading > 8u) {
            uint shift = leading - 8u;
            result <<= shift;
            a.exponent -= int(shift);
        }
    }
    return ig_row_f64_round_pack(a.sign, a.exponent, result);
}

inline ulong ig_row_f64_subtract(ulong left, ulong right) {
    // Rust preserves the first NaN operand's quieted payload for subtraction. Inspect both NaNs
    // before changing the right sign so `finite - NaN(payload)` does not invent a negative NaN.
    if (ig_row_f64_is_nan(left)) return ig_row_f64_quiet_nan(left);
    if (ig_row_f64_is_nan(right)) return ig_row_f64_quiet_nan(right);
    return ig_row_f64_add(left, right ^ IG_ROW_F64_SIGN);
}

inline void ig_row_mul_wide(
    ulong left,
    ulong right,
    thread ulong& high,
    thread ulong& low) {
    ulong left_low = left & 0xfffffffful;
    ulong left_high = left >> 32;
    ulong right_low = right & 0xfffffffful;
    ulong right_high = right >> 32;
    ulong product_0 = left_low * right_low;
    ulong product_1 = left_low * right_high;
    ulong product_2 = left_high * right_low;
    ulong product_3 = left_high * right_high;
    ulong middle = (product_0 >> 32)
        + (product_1 & 0xfffffffful)
        + (product_2 & 0xfffffffful);
    low = (product_0 & 0xfffffffful) | (middle << 32);
    high = product_3 + (product_1 >> 32) + (product_2 >> 32) + (middle >> 32);
}

inline ulong ig_row_f64_multiply(ulong left, ulong right) {
    if (ig_row_f64_is_nan(left)) return ig_row_f64_quiet_nan(left);
    if (ig_row_f64_is_nan(right)) return ig_row_f64_quiet_nan(right);
    bool sign = ((left ^ right) & IG_ROW_F64_SIGN) != 0;
    bool left_infinite = ig_row_f64_is_infinite(left);
    bool right_infinite = ig_row_f64_is_infinite(right);
    bool left_zero = (left & ~IG_ROW_F64_SIGN) == 0;
    bool right_zero = (right & ~IG_ROW_F64_SIGN) == 0;
    if ((left_infinite && right_zero) || (right_infinite && left_zero)) {
        return IG_ROW_F64_CANONICAL_NAN;
    }
    if (left_infinite || right_infinite) {
        return (sign ? IG_ROW_F64_SIGN : 0ul) | IG_ROW_F64_EXPONENT;
    }
    if (left_zero || right_zero) return sign ? IG_ROW_F64_SIGN : 0ul;

    IgRowF64Parts a = ig_row_f64_unpack(left);
    IgRowF64Parts b = ig_row_f64_unpack(right);
    ulong high;
    ulong low;
    ig_row_mul_wide(a.significand, b.significand, high, low);
    bool upper = ((high >> 41) & 1ul) != 0;
    uint shift = upper ? 50u : 49u;
    ulong extended = ig_row_shift_right_jam_128(high, low, shift);
    int exponent = a.exponent + b.exponent + int(upper);
    return ig_row_f64_round_pack(sign, exponent, extended);
}

inline bool ig_row_i64_add(long left, long right, thread long& output) {
    ulong left_bits = as_type<ulong>(left);
    ulong right_bits = as_type<ulong>(right);
    ulong result_bits = left_bits + right_bits;
    output = as_type<long>(result_bits);
    return ((left_bits ^ result_bits) & (right_bits ^ result_bits) & IG_ROW_F64_SIGN) == 0;
}

inline bool ig_row_i64_subtract(long left, long right, thread long& output) {
    ulong left_bits = as_type<ulong>(left);
    ulong right_bits = as_type<ulong>(right);
    ulong result_bits = left_bits - right_bits;
    output = as_type<long>(result_bits);
    return ((left_bits ^ right_bits) & (left_bits ^ result_bits) & IG_ROW_F64_SIGN) == 0;
}

inline bool ig_row_i64_multiply(long left, long right, thread long& output) {
    ulong left_bits = as_type<ulong>(left);
    ulong right_bits = as_type<ulong>(right);
    bool negative = (left < 0) != (right < 0);
    ulong left_magnitude = left < 0 ? (~left_bits + 1ul) : left_bits;
    ulong right_magnitude = right < 0 ? (~right_bits + 1ul) : right_bits;
    ulong high;
    ulong low;
    ig_row_mul_wide(left_magnitude, right_magnitude, high, low);
    ulong limit = negative ? IG_ROW_F64_SIGN : IG_ROW_I64_MAX_BITS;
    if (high != 0 || low > limit) return false;
    output = as_type<long>(negative ? (~low + 1ul) : low);
    return true;
}

inline ulong ig_row_register_value_offset(
    ulong row_count,
    uint reg,
    ulong row) {
    return 1ul + ulong(reg) * row_count + row;
}

inline ulong ig_row_register_validity_offset(
    ulong row_count,
    uint instruction_count,
    uint reg,
    ulong row) {
    return 1ul + ulong(instruction_count) * row_count + ulong(reg) * row_count + row;
}

inline bool ig_row_range_is_valid(ulong start, ulong length, ulong total) {
    return start <= total && length <= total - start;
}

inline bool ig_row_string_slot(
    constant ResidentRowEvaluateArgs& args,
    ulong base,
    ulong capacity,
    ulong row,
    thread uint& offset) {
    if (base > 0x7ffffffful || capacity > 0xfffffffful) return false;
    ulong slot = base + row * capacity;
    ulong output_bytes = args.output_word_count * 8ul;
    if (slot > 0x7ffffffful || !ig_row_range_is_valid(slot, capacity, output_bytes)) {
        return false;
    }
    offset = uint(slot);
    return true;
}

inline ulong ig_row_string_reference(uint offset, uint length) {
    return (ulong(IG_ROW_STRING_REFERENCE_MARKER | offset) << 32) | ulong(length);
}

inline bool ig_row_unpack_string_reference(
    long raw,
    ulong output_bytes,
    thread uint& offset,
    thread uint& length) {
    ulong bits = as_type<ulong>(raw);
    uint high = uint(bits >> 32);
    if ((high & IG_ROW_STRING_REFERENCE_MARKER) == 0u) return false;
    offset = high & ~IG_ROW_STRING_REFERENCE_MARKER;
    length = uint(bits);
    return ig_row_range_is_valid(ulong(offset), ulong(length), output_bytes);
}

inline void ig_row_encode_list_element(
    device uchar* bytes,
    ulong offset,
    long value,
    bool valid) {
    bytes[offset] = valid ? IG_ROW_LIST_ELEMENT_INTEGER : IG_ROW_LIST_ELEMENT_NULL;
    ulong ordered = valid ? (as_type<ulong>(value) ^ IG_ROW_F64_SIGN) : 0ul;
    for (uint index = 0u; index < 8u; ++index) {
        bytes[offset + 1ul + ulong(index)] =
            uchar(ordered >> (56u - index * 8u));
    }
}

inline bool ig_row_decode_list_element(
    device const uchar* bytes,
    ulong offset,
    thread long& value,
    thread long& valid) {
    uchar kind = bytes[offset];
    ulong ordered = 0ul;
    for (uint index = 0u; index < 8u; ++index) {
        ordered = (ordered << 8u) | ulong(bytes[offset + 1ul + ulong(index)]);
    }
    if (kind == IG_ROW_LIST_ELEMENT_INTEGER) {
        value = as_type<long>(ordered ^ IG_ROW_F64_SIGN);
        valid = 1L;
        return true;
    }
    if (kind == IG_ROW_LIST_ELEMENT_NULL && ordered == 0ul) {
        value = 0L;
        valid = 0L;
        return true;
    }
    value = 0L;
    valid = 0L;
    return false;
}

inline bool ig_row_property_byte(
    device const long* property_inputs,
    ulong offset,
    ulong total,
    thread uchar& value) {
    if (offset >= total) return false;
    long word = property_inputs[offset];
    if (word < 0L || word > 255L) return false;
    value = uchar(word);
    return true;
}

inline void ig_row_record_error(
    device atomic_uint* error,
    constant ResidentRowEvaluateArgs& args,
    uint instruction,
    ulong row,
    uint code) {
    // Every work item owns this row-local status word. A later 64-bit row-order reduction chooses
    // the first failing instruction and then the first row, preserving CPU reference order without
    // packing logical row ordinals into a fixed-width global atomic.
    (void)args;
    (void)row;
    uint encoded = (instruction << 3) | code;
    atomic_fetch_min_explicit(error, encoded, memory_order_relaxed);
}

inline long ig_row_saturating_zoned_time(long nanos, long offset_seconds) {
    const long minimum = (-9223372036854775807L - 1L);
    const long maximum = 9223372036854775807L;
    long delta = offset_seconds * 1000000000L;
    if (delta > 0L && nanos < minimum + delta) return minimum;
    if (delta < 0L && nanos > maximum + delta) return maximum;
    return nanos - delta;
}

inline long ig_row_floor_div(long value, long divisor) {
    long quotient = value / divisor;
    long remainder = value % divisor;
    return remainder < 0L ? quotient - 1L : quotient;
}

inline long ig_row_floor_mod(long value, long divisor) {
    long remainder = value % divisor;
    return remainder < 0L ? remainder + divisor : remainder;
}

inline bool ig_row_civil_is_leap(long year) {
    return ig_row_floor_mod(year, 4L) == 0L
        && (ig_row_floor_mod(year, 100L) != 0L
            || ig_row_floor_mod(year, 400L) == 0L);
}

inline uint ig_row_civil_days_in_month(long year, uint month) {
    switch (month) {
        case 1u:
        case 3u:
        case 5u:
        case 7u:
        case 8u:
        case 10u:
        case 12u: return 31u;
        case 4u:
        case 6u:
        case 9u:
        case 11u: return 30u;
        case 2u: return ig_row_civil_is_leap(year) ? 29u : 28u;
        default: return 0u;
    }
}

inline bool ig_row_civil_from_epoch_day(
    long epoch_day,
    thread long& year,
    thread uint& month,
    thread uint& day) {
    if (epoch_day < -IG_ROW_TEMPORAL_MAX_EPOCH_DAY
            || epoch_day > IG_ROW_TEMPORAL_MAX_EPOCH_DAY) {
        return false;
    }
    long shifted;
    if (!ig_row_i64_add(epoch_day, 719468L, shifted)) return false;
    long era = ig_row_floor_div(shifted, 146097L);
    long era_days;
    long day_of_era;
    if (!ig_row_i64_multiply(era, 146097L, era_days)
            || !ig_row_i64_subtract(shifted, era_days, day_of_era)
            || day_of_era < 0L || day_of_era >= 146097L) {
        return false;
    }
    long year_of_era = (day_of_era - day_of_era / 1460L
        + day_of_era / 36524L - day_of_era / 146096L) / 365L;
    long day_of_year = day_of_era
        - (365L * year_of_era + year_of_era / 4L - year_of_era / 100L);
    long month_prime = (5L * day_of_year + 2L) / 153L;
    long computed_day = day_of_year - (153L * month_prime + 2L) / 5L + 1L;
    long computed_month = month_prime + (month_prime < 10L ? 3L : -9L);
    long era_year;
    if (!ig_row_i64_multiply(era, 400L, era_year)
            || !ig_row_i64_add(year_of_era, era_year, year)) {
        return false;
    }
    if (computed_month <= 2L && !ig_row_i64_add(year, 1L, year)) return false;
    if (year < -IG_ROW_TEMPORAL_MAX_YEAR || year > IG_ROW_TEMPORAL_MAX_YEAR
            || computed_month < 1L || computed_month > 12L
            || computed_day < 1L || computed_day > 31L) {
        return false;
    }
    month = uint(computed_month);
    day = uint(computed_day);
    return day <= ig_row_civil_days_in_month(year, month);
}

inline bool ig_row_epoch_day_from_civil(
    long year,
    uint month,
    uint day,
    thread long& epoch_day) {
    uint maximum = ig_row_civil_days_in_month(year, month);
    if (year < -IG_ROW_TEMPORAL_MAX_YEAR || year > IG_ROW_TEMPORAL_MAX_YEAR
            || maximum == 0u || day == 0u || day > maximum) {
        return false;
    }
    long adjusted_year = year;
    if (month <= 2u && !ig_row_i64_subtract(adjusted_year, 1L, adjusted_year)) {
        return false;
    }
    long era = ig_row_floor_div(adjusted_year, 400L);
    long era_year;
    long year_of_era;
    if (!ig_row_i64_multiply(era, 400L, era_year)
            || !ig_row_i64_subtract(adjusted_year, era_year, year_of_era)
            || year_of_era < 0L || year_of_era > 399L) {
        return false;
    }
    long month_prime = long(month) + (month > 2u ? -3L : 9L);
    long day_of_year = (153L * month_prime + 2L) / 5L + long(day) - 1L;
    long day_of_era = year_of_era * 365L + year_of_era / 4L
        - year_of_era / 100L + day_of_year;
    long era_days;
    long shifted;
    return ig_row_i64_multiply(era, 146097L, era_days)
        && ig_row_i64_add(era_days, day_of_era, shifted)
        && ig_row_i64_subtract(shifted, 719468L, epoch_day)
        && epoch_day >= -IG_ROW_TEMPORAL_MAX_EPOCH_DAY
        && epoch_day <= IG_ROW_TEMPORAL_MAX_EPOCH_DAY;
}

inline bool ig_row_add_calendar_date(
    long epoch_day,
    long months,
    long days,
    thread long& result_epoch_day) {
    long year;
    uint month;
    uint day;
    if (!ig_row_civil_from_epoch_day(epoch_day, year, month, day)) return false;
    long total_month;
    long month_zero;
    if (!ig_row_i64_multiply(year, 12L, total_month)
            || !ig_row_i64_add(total_month, long(month - 1u), month_zero)
            || !ig_row_i64_add(month_zero, months, total_month)) {
        return false;
    }
    long result_year = ig_row_floor_div(total_month, 12L);
    long result_month_word = ig_row_floor_mod(total_month, 12L) + 1L;
    if (result_year < -IG_ROW_TEMPORAL_MAX_YEAR
            || result_year > IG_ROW_TEMPORAL_MAX_YEAR) {
        return false;
    }
    uint result_month = uint(result_month_word);
    uint result_day = min(day, ig_row_civil_days_in_month(result_year, result_month));
    long month_epoch_day;
    if (!ig_row_epoch_day_from_civil(
            result_year, result_month, result_day, month_epoch_day)
            || !ig_row_i64_add(month_epoch_day, days, result_epoch_day)) {
        return false;
    }
    long checked_year;
    uint checked_month;
    uint checked_day;
    return ig_row_civil_from_epoch_day(
        result_epoch_day, checked_year, checked_month, checked_day);
}

inline bool ig_row_datetime_year_is_supported(long seconds) {
    long epoch_day = ig_row_floor_div(seconds, IG_ROW_SECONDS_PER_DAY);
    long year;
    uint month;
    uint day;
    return ig_row_civil_from_epoch_day(epoch_day, year, month, day)
        && year >= IG_ROW_CHRONO_MIN_YEAR && year <= IG_ROW_CHRONO_MAX_YEAR;
}

inline bool ig_row_add_timestamp_duration(
    long seconds,
    long nanos,
    long duration_seconds,
    int duration_nanos,
    thread long& result_seconds,
    thread long& result_nanos) {
    if (nanos < 0L || nanos >= IG_ROW_NANOS_PER_SECOND
            || duration_nanos < 0 || duration_nanos >= int(IG_ROW_NANOS_PER_SECOND)) {
        return false;
    }
    long nanos_sum = nanos + long(duration_nanos);
    long carry = nanos_sum / IG_ROW_NANOS_PER_SECOND;
    result_nanos = nanos_sum % IG_ROW_NANOS_PER_SECOND;
    long elapsed_seconds;
    return ig_row_i64_add(duration_seconds, carry, elapsed_seconds)
        && ig_row_i64_add(seconds, elapsed_seconds, result_seconds)
        && ig_row_datetime_year_is_supported(result_seconds);
}

inline bool ig_row_add_clock_duration(
    long clock_nanos,
    long duration_seconds,
    int duration_nanos,
    thread long& result_nanos) {
    if (clock_nanos < 0L || clock_nanos >= IG_ROW_NANOS_PER_DAY
            || duration_nanos < 0 || duration_nanos >= int(IG_ROW_NANOS_PER_SECOND)) {
        return false;
    }
    long seconds_within_day = duration_seconds % IG_ROW_SECONDS_PER_DAY;
    long seconds_nanos = seconds_within_day * IG_ROW_NANOS_PER_SECOND;
    long delta = seconds_nanos + long(duration_nanos);
    result_nanos = ig_row_floor_mod(clock_nanos + delta, IG_ROW_NANOS_PER_DAY);
    return true;
}

inline uchar ig_row_ascii_lower(uchar byte) {
    return byte >= uchar('A') && byte <= uchar('Z') ? byte + uchar(32) : byte;
}

inline bool ig_row_ascii_digit(uchar byte, thread uint& digit) {
    if (byte < uchar('0') || byte > uchar('9')) return false;
    digit = uint(byte - uchar('0'));
    return true;
}

inline bool ig_row_parse_fixed_timezone(
    device const uchar* bytes,
    uint length,
    thread long& offset_seconds) {
    if (length == 1u && (bytes[0] == uchar('Z') || bytes[0] == uchar('z'))) {
        offset_seconds = 0L;
        return true;
    }
    if (length == 3u
            && ig_row_ascii_lower(bytes[0]) == uchar('u')
            && ig_row_ascii_lower(bytes[1]) == uchar('t')
            && ig_row_ascii_lower(bytes[2]) == uchar('c')) {
        offset_seconds = 0L;
        return true;
    }
    if (length != 5u && length != 6u && length != 7u && length != 9u) {
        return false;
    }
    bool negative = bytes[0] == uchar('-');
    if (!negative && bytes[0] != uchar('+')) return false;
    bool colon_format = length == 6u || length == 9u;
    bool seconds_present = length == 7u || length == 9u;
    if (colon_format && (bytes[3] != uchar(':')
            || (seconds_present && bytes[6] != uchar(':')))) {
        return false;
    }
    uint hour_tens;
    uint hour_ones;
    uint minute_tens;
    uint minute_ones;
    uint second_tens = 0u;
    uint second_ones = 0u;
    uint minute_start = colon_format ? 4u : 3u;
    uint second_start = colon_format ? 7u : 5u;
    if (!ig_row_ascii_digit(bytes[1], hour_tens)
            || !ig_row_ascii_digit(bytes[2], hour_ones)
            || !ig_row_ascii_digit(bytes[minute_start], minute_tens)
            || !ig_row_ascii_digit(bytes[minute_start + 1u], minute_ones)
            || (seconds_present
                && (!ig_row_ascii_digit(bytes[second_start], second_tens)
                    || !ig_row_ascii_digit(bytes[second_start + 1u], second_ones)))) {
        return false;
    }
    uint hours = hour_tens * 10u + hour_ones;
    uint minutes = minute_tens * 10u + minute_ones;
    uint seconds = second_tens * 10u + second_ones;
    if (hours > 23u || minutes > 59u || seconds > 59u) return false;
    long magnitude = long(hours * 3600u + minutes * 60u + seconds);
    offset_seconds = negative ? -magnitude : magnitude;
    return true;
}

inline bool ig_row_property_u16(
    device const long* words,
    thread ulong& cursor,
    ulong end,
    thread uint& value) {
    if (!ig_row_range_is_valid(cursor, 2ul, end)) return false;
    uchar first = 0;
    uchar second = 0;
    if (!ig_row_property_byte(words, cursor, end, first)
            || !ig_row_property_byte(words, cursor + 1ul, end, second)) {
        return false;
    }
    cursor += 2ul;
    value = uint(first) | (uint(second) << 8u);
    return true;
}

inline bool ig_row_property_u32(
    device const long* words,
    thread ulong& cursor,
    ulong end,
    thread uint& value) {
    if (!ig_row_range_is_valid(cursor, 4ul, end)) return false;
    uint result = 0u;
    for (uint index = 0u; index < 4u; ++index) {
        uchar byte_value = 0;
        if (!ig_row_property_byte(words, cursor + ulong(index), end, byte_value)) {
            return false;
        }
        result |= uint(byte_value) << (index * 8u);
    }
    cursor += 4ul;
    value = result;
    return true;
}

inline bool ig_row_property_i32(
    device const long* words,
    thread ulong& cursor,
    ulong end,
    thread int& value) {
    uint bits = 0u;
    if (!ig_row_property_u32(words, cursor, end, bits)) return false;
    value = as_type<int>(bits);
    return true;
}

inline bool ig_row_property_i64(
    device const long* words,
    thread ulong& cursor,
    ulong end,
    thread long& value) {
    if (!ig_row_range_is_valid(cursor, 8ul, end)) return false;
    ulong bits = 0ul;
    for (uint index = 0u; index < 8u; ++index) {
        uchar byte_value = 0;
        if (!ig_row_property_byte(words, cursor + ulong(index), end, byte_value)) {
            return false;
        }
        bits |= ulong(byte_value) << (index * 8u);
    }
    cursor += 8ul;
    value = as_type<long>(bits);
    return true;
}

__attribute__((noinline)) bool ig_row_named_zone_offset_at(
    device const long* table,
    ulong table_start,
    ulong table_end,
    device const uchar* requested_name,
    uint requested_length,
    long seconds,
    thread long& offset_seconds) {
    if (table_start >= table_end) return false;
    ulong cursor = table_start;
    uint zone_count = 0u;
    if (!ig_row_property_u32(table, cursor, table_end, zone_count)) return false;
    bool found = false;
    int found_offset = 0;
    for (uint zone = 0u; zone < zone_count; ++zone) {
        uint name_length = 0u;
        if (!ig_row_property_u16(table, cursor, table_end, name_length)
                || !ig_row_range_is_valid(cursor, ulong(name_length), table_end)) {
            return false;
        }
        bool matching = name_length == requested_length;
        for (uint index = 0u; index < name_length; ++index) {
            uchar table_byte = 0;
            if (!ig_row_property_byte(
                    table, cursor + ulong(index), table_end, table_byte)) {
                return false;
            }
            if (matching && table_byte != requested_name[index]) matching = false;
        }
        cursor += ulong(name_length);
        uint interval_count = 0u;
        if (!ig_row_property_u32(table, cursor, table_end, interval_count)
                || interval_count > (table_end - cursor) / 20ul) {
            return false;
        }
        for (uint interval = 0u; interval < interval_count; ++interval) {
            long interval_start = 0L;
            long interval_end = 0L;
            int interval_offset = 0;
            if (!ig_row_property_i64(table, cursor, table_end, interval_start)
                    || !ig_row_property_i64(table, cursor, table_end, interval_end)
                    || !ig_row_property_i32(table, cursor, table_end, interval_offset)) {
                return false;
            }
            if (matching && seconds >= interval_start && seconds < interval_end) {
                if (found) return false;
                found = true;
                found_offset = interval_offset;
            }
        }
    }
    if (cursor != table_end || !found
            || found_offset < -86399 || found_offset > 86399) {
        return false;
    }
    offset_seconds = long(found_offset);
    return true;
}

inline bool ig_row_write_offset_string(
    device uchar* bytes,
    uint slot_offset,
    ulong capacity,
    long offset_seconds,
    thread uint& length) {
    if (offset_seconds < -86399L || offset_seconds > 86399L) return false;
    bool negative = offset_seconds < 0L;
    long magnitude = negative ? -offset_seconds : offset_seconds;
    uint hours = uint(magnitude / 3600L);
    uint minutes = uint((magnitude / 60L) % 60L);
    uint seconds = uint(magnitude % 60L);
    length = seconds == 0u ? 6u : 9u;
    if (capacity < ulong(length)) return false;
    bytes[ulong(slot_offset)] = negative ? uchar('-') : uchar('+');
    bytes[ulong(slot_offset) + 1ul] = uchar('0' + hours / 10u);
    bytes[ulong(slot_offset) + 2ul] = uchar('0' + hours % 10u);
    bytes[ulong(slot_offset) + 3ul] = uchar(':');
    bytes[ulong(slot_offset) + 4ul] = uchar('0' + minutes / 10u);
    bytes[ulong(slot_offset) + 5ul] = uchar('0' + minutes % 10u);
    if (seconds != 0u) {
        bytes[ulong(slot_offset) + 6ul] = uchar(':');
        bytes[ulong(slot_offset) + 7ul] = uchar('0' + seconds / 10u);
        bytes[ulong(slot_offset) + 8ul] = uchar('0' + seconds % 10u);
    }
    return true;
}

inline long ig_row_iso_weekday(long epoch_day) {
    return ig_row_floor_mod(epoch_day, 7L) + 4L > 7L
        ? ig_row_floor_mod(epoch_day, 7L) - 3L
        : ig_row_floor_mod(epoch_day, 7L) + 4L;
}

inline bool ig_row_iso_week(
    long epoch_day,
    thread long& week_year,
    thread long& week) {
    long thursday = 0L;
    long weekday = ig_row_iso_weekday(epoch_day);
    if (!ig_row_i64_add(epoch_day, 4L - weekday, thursday)) return false;
    uint ignored_month = 0u;
    uint ignored_day = 0u;
    if (!ig_row_civil_from_epoch_day(
            thursday, week_year, ignored_month, ignored_day)) {
        return false;
    }
    long january_fourth = 0L;
    if (!ig_row_epoch_day_from_civil(week_year, 1u, 4u, january_fourth)) return false;
    long week_one_monday = 0L;
    if (!ig_row_i64_subtract(
            january_fourth,
            ig_row_iso_weekday(january_fourth) - 1L,
            week_one_monday)) {
        return false;
    }
    long distance = 0L;
    if (!ig_row_i64_subtract(epoch_day, week_one_monday, distance)) return false;
    week = ig_row_floor_div(distance, 7L) + 1L;
    return week >= 1L && week <= 53L;
}

inline bool ig_row_date_accessor(
    long epoch_day,
    ulong accessor,
    thread long& value) {
    long year = 0L;
    uint month = 0u;
    uint day = 0u;
    if (!ig_row_civil_from_epoch_day(epoch_day, year, month, day)) return false;
    if (accessor == 1ul) value = year;
    else if (accessor == 2ul) value = long((month - 1u) / 3u + 1u);
    else if (accessor == 3ul) value = long(month);
    else if (accessor == 4ul || accessor == 5ul) {
        long week_year = 0L;
        long week = 0L;
        if (!ig_row_iso_week(epoch_day, week_year, week)) return false;
        value = accessor == 4ul ? week : week_year;
    } else if (accessor == 6ul) value = long(day);
    else if (accessor == 7ul || accessor == 9ul) {
        uint first_month = accessor == 7ul ? 1u : ((month - 1u) / 3u) * 3u + 1u;
        long accumulated = long(day);
        for (uint current = first_month; current < month; ++current) {
            accumulated += long(ig_row_civil_days_in_month(year, current));
        }
        value = accumulated;
    } else if (accessor == 8ul) value = ig_row_iso_weekday(epoch_day);
    else return false;
    return true;
}

inline bool ig_row_clock_accessor(
    long nanos_of_day,
    ulong accessor,
    thread long& value) {
    if (nanos_of_day < 0L || nanos_of_day >= IG_ROW_NANOS_PER_DAY) return false;
    long seconds = nanos_of_day / IG_ROW_NANOS_PER_SECOND;
    long nanos = nanos_of_day % IG_ROW_NANOS_PER_SECOND;
    if (accessor == 10ul) value = seconds / 3600L;
    else if (accessor == 11ul) value = (seconds / 60L) % 60L;
    else if (accessor == 12ul) value = seconds % 60L;
    else if (accessor == 13ul) value = nanos / 1000000L;
    else if (accessor == 14ul) value = nanos / 1000L;
    else if (accessor == 15ul) value = nanos;
    else return false;
    return true;
}

inline bool ig_row_temporal_accessor_supports(uint source_type, ulong accessor) {
    if (accessor >= 1ul && accessor <= 9ul) {
        return source_type == 5u || source_type == 8u || source_type == 9u;
    }
    if (accessor >= 10ul && accessor <= 15ul) {
        return source_type >= 6u && source_type <= 9u;
    }
    if (accessor >= 16ul && accessor <= 19ul) {
        return source_type == 7u || source_type == 9u;
    }
    return (accessor == 20ul || accessor == 21ul) && source_type == 9u;
}

kernel void ig_resident_row_initialize(
    device long* output [[buffer(0)]],
    constant ResidentRowEvaluateArgs& args [[buffer(1)]],
    uint lane [[thread_position_in_grid]]) {
    if (lane == 0 && args.output_word_count != 0) output[0] = long(IG_ROW_EVALUATION_OK);
}

kernel void ig_resident_row_evaluate(
    device const long* property_inputs [[buffer(0)]],
    device const long* metadata [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant ResidentRowEvaluateArgs& args [[buffer(3)]],
    device const uint* node_string_offsets [[buffer(4)]],
    device const uchar* node_string_bytes [[buffer(5)]],
    device const uint* edge_string_offsets [[buffer(6)]],
    device const uchar* edge_string_bytes [[buffer(7)]],
    uint row_index [[thread_position_in_grid]]) {
    ulong local_row = ulong(row_index);
    if (local_row >= args.dispatch_count
            || args.dispatch_base > args.row_count
            || local_row >= args.row_count - args.dispatch_base) return;
    ulong row = args.dispatch_base + local_row;
    ulong status_base = 1ul
        + ulong(args.instruction_count) * args.row_count * 2ul;
    device atomic_uint* error = reinterpret_cast<device atomic_uint*>(
        output + status_base + row);
    atomic_store_explicit(error, IG_ROW_EVALUATION_OK, memory_order_relaxed);
    if (args.program_abi_version != IG_ROW_PROGRAM_ABI_VERSION || args.reserved != 0u) {
        ig_row_record_error(error, args, 0u, row, IG_ROW_ERROR_DESCRIPTOR);
        return;
    }
    for (uint instruction = 0; instruction < args.instruction_count; ++instruction) {
