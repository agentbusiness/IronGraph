        ulong multiplicity_count = final_relation_secondary_value & 0xfffffffful;
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 15ul),
            10ul | (5ul << 8u), ulong(publication_count), group_count, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 16ul),
            6ul | (5ul << 8u), group_count, multiplicity_count, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 17ul),
            6ul | (5ul << 8u), multiplicity_count, final_relation_value, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 18ul),
            10ul | (5ul << 8u), final_relation_value, 1ul, args);
    } else if (args.final_projection_mode == 13u) {
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 15ul),
            10ul | (5ul << 8u), ulong(publication_count),
            final_relation_cardinality, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 16ul),
            9ul | (5ul << 8u), final_relation_cardinality,
            final_relation_cardinality, args);
    } else if (args.final_projection_mode == 14u) {
        ulong retained = ulong(publication_count) > args.final_projection_flags
            ? ulong(publication_count) - args.final_projection_flags : 0ul;
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 15ul),
            9ul | (5ul << 8u), ulong(publication_count), ulong(publication_count), args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 16ul),
            9ul | (5ul << 8u), ulong(publication_count), retained, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 17ul),
            4ul | (5ul << 8u), final_relation_secondary_value,
            final_relation_value, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 18ul),
            10ul | (5ul << 8u), final_relation_value,
            final_relation_cardinality, args);
    } else if (args.final_projection_mode == 15u) {
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 15ul),
            10ul | (5ul << 8u), ulong(publication_count),
            final_relation_cardinality, args);
    } else if (args.final_projection_mode == 16u) {
        ulong filtered_count = final_relation_secondary_value >> 32u;
        ulong pair_count = final_relation_secondary_value & 0xfffffffful;
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 15ul),
            4ul | (5ul << 8u), ulong(publication_count), filtered_count, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 16ul),
            10ul | (5ul << 8u), filtered_count, pair_count, args);
        ig_variable_path_write_receipt(
            output, receipt++, ig_variable_path_word(packet, 17ul),
            10ul | (5ul << 8u), pair_count, final_relation_cardinality, args);
    }
    if (receipt != args.receipt_count) {
        output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_CORRUPT)
            | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
        return;
    }
    atomic_store_explicit(
        &control[IG_VARIABLE_PATH_CONTROL_PHASE],
        IG_VARIABLE_PATH_PHASE_COMPLETE,
        memory_order_relaxed);
    output[1] = as_type<long>(ulong(IG_VARIABLE_PATH_STATUS_SUCCESS)
        | (ulong(IG_VARIABLE_PATH_PHASE_COMPLETE) << 32u));
}

