                    } else if (accessor == 32ul) {
                        arithmetic_valid = ig_row_i64_multiply(
                                seconds, IG_ROW_NANOS_PER_SECOND, value)
                            && ig_row_i64_add(value, nanos, value);
                    } else if (accessor == 33ul) value = (months / 3L) % 4L;
                    else if (accessor == 34ul) value = months % 3L;
                    else if (accessor == 35ul) value = months % 12L;
                    else if (accessor == 36ul) value = days % 7L;
                    else if (accessor == 37ul) value = (seconds / 60L) % 60L;
                    else if (accessor == 38ul) value = seconds % 60L;
                    else if (accessor == 39ul) value = nanos / 1000000L;
                    else if (accessor == 40ul) value = nanos / 1000L;
                    else value = nanos;
                    if (!arithmetic_valid) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_TEMPORAL_RANGE);
                        value = 0L;
                        valid = 0L;
                    }
                }
            }
        } else if (opcode == 18ul || opcode == 19ul) {
            ulong ordinal = first;
            ulong value_offset = ordinal * args.row_count * 2ul + row;
            ulong validity_offset = value_offset + args.row_count;
            uint slot_offset = 0u;
            uint entry_count = opcode == 18ul
                ? args.node_string_entry_count
                : args.edge_string_entry_count;
            uint byte_count = opcode == 18ul
                ? args.node_string_byte_count
                : args.edge_string_byte_count;
            device const uint* dictionary_offsets = opcode == 18ul
                ? node_string_offsets
                : edge_string_offsets;
            device const uchar* dictionary_bytes = opcode == 18ul
                ? node_string_bytes
                : edge_string_bytes;
            bool descriptor_valid = output_type == 4u
                && second == 0ul && third == 0ul && sixth == 0ul
                && ordinal < ulong(args.property_load_count)
                && validity_offset < args.property_storage_words
                && ig_row_string_slot(args, fourth, fifth, row, slot_offset);
            if (!descriptor_valid) {
                ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                value = 0;
                valid = 0;
            } else {
                valid = property_inputs[validity_offset];
                if (valid != 0 && valid != 1) {
                    ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                    value = 0;
                    valid = 0;
                } else if (valid != 0) {
                    long id_word = property_inputs[value_offset];
                    if (id_word < 0L || as_type<ulong>(id_word) >= ulong(entry_count)) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                        value = 0;
                        valid = 0;
                    } else {
                        uint id = uint(id_word);
                        uint start = dictionary_offsets[id];
                        uint end = dictionary_offsets[id + 1u];
                        ulong length = end >= start ? ulong(end - start) : ulong(-1);
                        if (end < start || end > byte_count
                                || length > fifth || length > 0xfffffffful) {
                            ig_row_record_error(
                                error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                            value = 0;
                            valid = 0;
                        } else {
                            device uchar* output_bytes =
                                reinterpret_cast<device uchar*>(output);
                            for (uint index = 0; index < uint(length); ++index) {
                                output_bytes[ulong(slot_offset) + ulong(index)] =
                                    dictionary_bytes[ulong(start) + ulong(index)];
                            }
                            value = as_type<long>(ig_row_string_reference(
                                slot_offset, uint(length)));
                        }
                    }
                }
            }
        } else if (opcode == 15ul) {
            ulong ordinal = first;
            ulong value_offset = ordinal * args.row_count * 2ul + row;
            ulong validity_offset = value_offset + args.row_count;
            uint entry_count = uint(sixth >> 32);
            uint byte_count = uint(sixth);
            uint slot_offset = 0u;
            bool descriptor_valid = output_type == 4u
                && ordinal < ulong(args.property_load_count)
                && validity_offset < args.property_storage_words
                && ig_row_range_is_valid(second, ulong(entry_count) + 1ul,
                    args.property_storage_words)
                && ig_row_range_is_valid(third, ulong(byte_count),
                    args.property_storage_words)
                && ig_row_string_slot(args, fourth, fifth, row, slot_offset);
            if (!descriptor_valid) {
                ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                value = 0;
                valid = 0;
            } else {
                valid = property_inputs[validity_offset];
                if (valid != 0 && valid != 1) {
                    ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                    value = 0;
                    valid = 0;
                } else if (valid != 0) {
                    long id_word = property_inputs[value_offset];
                    if (id_word < 0L || as_type<ulong>(id_word) >= ulong(entry_count)) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                        value = 0;
                        valid = 0;
                    } else {
                        ulong id = as_type<ulong>(id_word);
                        long start_word = property_inputs[second + id];
                        long end_word = property_inputs[second + id + 1ul];
                        bool range_valid = start_word >= 0L && end_word >= start_word
                            && as_type<ulong>(end_word) <= ulong(byte_count);
                        ulong length = range_valid
                            ? as_type<ulong>(end_word - start_word)
                            : ulong(-1);
                        if (!range_valid || length > fifth || length > 0xfffffffful) {
                            ig_row_record_error(
                                error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                            value = 0;
                            valid = 0;
                        } else {
                            device uchar* output_bytes =
                                reinterpret_cast<device uchar*>(output);
                            ulong source = third + as_type<ulong>(start_word);
                            for (ulong index = 0; index < length; ++index) {
                                long byte_word = property_inputs[source + index];
                                if (byte_word < 0L || byte_word > 255L) {
                                    ig_row_record_error(error, args, instruction, row,
                                        IG_ROW_ERROR_DESCRIPTOR);
                                    value = 0;
                                    valid = 0;
                                    break;
                                }
                                output_bytes[ulong(slot_offset) + index] = uchar(byte_word);
                            }
                            if (valid != 0) {
                                value = as_type<long>(ig_row_string_reference(
                                    slot_offset, uint(length)));
                            }
                        }
                    }
                }
            }
        } else if (opcode == 16ul) {
            uint slot_offset = 0u;
            bool descriptor_valid = output_type == 4u
                && second <= fifth
                && second <= 0xfffffffful
                && ig_row_range_is_valid(first, second, args.property_storage_words)
                && ig_row_string_slot(args, fourth, fifth, row, slot_offset);
            if (!descriptor_valid) {
                ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                value = 0;
                valid = 0;
            } else {
                device uchar* output_bytes = reinterpret_cast<device uchar*>(output);
                for (ulong index = 0; index < second; ++index) {
                    long byte_word = property_inputs[first + index];
                    if (byte_word < 0L || byte_word > 255L) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                        value = 0;
                        valid = 0;
                        break;
                    }
                    output_bytes[ulong(slot_offset) + index] = uchar(byte_word);
                }
                if (valid != 0) {
                    value = as_type<long>(ig_row_string_reference(slot_offset, uint(second)));
                }
            }
        } else if (opcode == 17ul) {
            uint left_register = uint(first);
            uint right_register = uint(second);
            uint slot_offset = 0u;
            bool descriptor_valid = output_type == 4u
                && first < ulong(instruction)
                && second < ulong(instruction)
                && ig_row_string_slot(args, fourth, fifth, row, slot_offset);
            if (!descriptor_valid) {
                ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                value = 0;
                valid = 0;
            } else {
                long left_valid = output[ig_row_register_validity_offset(
                    args.row_count, args.instruction_count, left_register, row)];
                long right_valid = output[ig_row_register_validity_offset(
                    args.row_count, args.instruction_count, right_register, row)];
                if ((left_valid != 0 && left_valid != 1)
                        || (right_valid != 0 && right_valid != 1)) {
                    ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                    value = 0;
                    valid = 0;
                } else {
                    valid = left_valid != 0 && right_valid != 0 ? 1L : 0L;
                    if (valid != 0) {
                        uint left_offset = 0u;
                        uint left_length = 0u;
                        uint right_offset = 0u;
                        uint right_length = 0u;
                        ulong output_bytes_count = args.output_word_count * 8ul;
                        long left_value = output[ig_row_register_value_offset(
                            args.row_count, left_register, row)];
                        long right_value = output[ig_row_register_value_offset(
                            args.row_count, right_register, row)];
                        ulong combined = ulong(left_length) + ulong(right_length);
                        bool references_valid = ig_row_unpack_string_reference(
                                left_value, output_bytes_count, left_offset, left_length)
                            && ig_row_unpack_string_reference(
                                right_value, output_bytes_count, right_offset, right_length);
                        combined = ulong(left_length) + ulong(right_length);
                        if (!references_valid || combined > fifth || combined > 0xfffffffful) {
                            ig_row_record_error(error, args, instruction, row,
                                IG_ROW_ERROR_DESCRIPTOR);
                            value = 0;
                            valid = 0;
                        } else {
                            device uchar* bytes = reinterpret_cast<device uchar*>(output);
                            for (uint index = 0; index < left_length; ++index) {
                                bytes[ulong(slot_offset) + ulong(index)] =
                                    bytes[ulong(left_offset) + ulong(index)];
                            }
                            for (uint index = 0; index < right_length; ++index) {
                                bytes[ulong(slot_offset) + ulong(left_length) + ulong(index)] =
                                    bytes[ulong(right_offset) + ulong(index)];
                            }
                            value = as_type<long>(ig_row_string_reference(
                                slot_offset, uint(combined)));
                        }
                    }
                }
            }
        } else if (opcode == 36ul) {
            uint left_register = uint(first);
            uint right_register = uint(second);
            uint slot_offset = 0u;
            bool descriptor_valid = output_type == 4u
                && first < ulong(instruction)
                && second < ulong(instruction)
                && uint(metadata[ulong(left_register) * 8ul + 1ul]) == 4u
                && uint(metadata[ulong(right_register) * 8ul + 1ul]) == 4u
                && third == 0ul && sixth == 0ul
                && ig_row_string_slot(args, fourth, fifth, row, slot_offset);
            if (!descriptor_valid) {
                ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                value = 0;
                valid = 0;
            } else {
                long left_valid = output[ig_row_register_validity_offset(
                    args.row_count, args.instruction_count, left_register, row)];
                long right_valid = output[ig_row_register_validity_offset(
                    args.row_count, args.instruction_count, right_register, row)];
                if ((left_valid != 0L && left_valid != 1L)
                        || (right_valid != 0L && right_valid != 1L)) {
                    ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                    value = 0;
                    valid = 0;
                } else {
                    valid = left_valid != 0L || right_valid != 0L ? 1L : 0L;
                    if (valid != 0L) {
                        uint selected_register = left_valid != 0L ? left_register : right_register;
                        long selected_value = output[ig_row_register_value_offset(
                            args.row_count, selected_register, row)];
                        uint selected_offset = 0u;
                        uint selected_length = 0u;
                        ulong output_bytes_count = args.output_word_count * 8ul;
                        bool reference_valid = ig_row_unpack_string_reference(
                            selected_value,
                            output_bytes_count,
                            selected_offset,
                            selected_length);
                        if (!reference_valid || ulong(selected_length) > fifth) {
                            ig_row_record_error(
                                error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                            value = 0;
                            valid = 0;
                        } else {
                            device uchar* bytes = reinterpret_cast<device uchar*>(output);
                            for (uint index = 0u; index < selected_length; ++index) {
                                bytes[ulong(slot_offset) + ulong(index)] =
                                    bytes[ulong(selected_offset) + ulong(index)];
                            }
                            value = as_type<long>(ig_row_string_reference(
                                slot_offset, selected_length));
                        }
                    }
                }
            }
        } else if (opcode == 35ul) {
            uint operand = uint(first);
            uint slot_offset = 0u;
            bool descriptor_valid = output_type == 4u
                && first < ulong(instruction)
                && uint(metadata[ulong(operand) * 8ul + 1ul]) == 1u
                && second == 0ul && third == 0ul && sixth == 0ul
                && fifth == 5ul
                && ig_row_string_slot(args, fourth, fifth, row, slot_offset);
            if (!descriptor_valid) {
                ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                value = 0;
                valid = 0;
            } else {
                valid = output[ig_row_register_validity_offset(
                    args.row_count, args.instruction_count, operand, row)];
                long boolean_value = output[ig_row_register_value_offset(
                    args.row_count, operand, row)];
                if ((valid != 0L && valid != 1L)
                        || (boolean_value != 0L && boolean_value != 1L)
                        || (valid == 0L && boolean_value != 0L)) {
                    ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                    value = 0;
                    valid = 0;
                } else if (valid != 0L) {
                    device uchar* bytes = reinterpret_cast<device uchar*>(output);
                    uint length = boolean_value == 0L ? 5u : 4u;
                    bytes[ulong(slot_offset)] = boolean_value == 0L ? uchar('f') : uchar('t');
                    bytes[ulong(slot_offset) + 1ul] = boolean_value == 0L ? uchar('a') : uchar('r');
                    bytes[ulong(slot_offset) + 2ul] = boolean_value == 0L ? uchar('l') : uchar('u');
                    bytes[ulong(slot_offset) + 3ul] = boolean_value == 0L ? uchar('s') : uchar('e');
                    if (boolean_value == 0L) bytes[ulong(slot_offset) + 4ul] = uchar('e');
                    value = as_type<long>(ig_row_string_reference(slot_offset, length));
                }
            }
        } else if (opcode == 4ul || opcode == 5ul || opcode == 6ul) {
            value = as_type<long>(first);
        } else if (opcode == 7ul) {
            uint operand = uint(first);
            valid = output[ig_row_register_validity_offset(
                args.row_count, args.instruction_count, operand, row)];
            long operand_value = output[ig_row_register_value_offset(
                args.row_count, operand, row)];
            value = 1L - operand_value;
        } else if (opcode == 8ul) {
            uint left_register = uint(first);
            uint right_register = uint(second);
            long left_valid = output[ig_row_register_validity_offset(
                args.row_count, args.instruction_count, left_register, row)];
            long right_valid = output[ig_row_register_validity_offset(
                args.row_count, args.instruction_count, right_register, row)];
            long left_value = output[ig_row_register_value_offset(
                args.row_count, left_register, row)];
            long right_value = output[ig_row_register_value_offset(
                args.row_count, right_register, row)];
            bool known_false = (left_valid != 0 && left_value == 0)
                || (right_valid != 0 && right_value == 0);
            valid = ((left_valid != 0 && right_valid != 0) || known_false) ? 1L : 0L;
            value = (valid != 0 && !known_false) ? 1L : 0L;
        } else if (opcode == 9ul || opcode == 10ul || opcode == 12ul || opcode == 13ul) {
            uint left_register = uint(first);
            uint right_register = uint(second);
            long left_valid = output[ig_row_register_validity_offset(
                args.row_count, args.instruction_count, left_register, row)];
            long right_valid = output[ig_row_register_validity_offset(
                args.row_count, args.instruction_count, right_register, row)];
            valid = (left_valid != 0 && right_valid != 0) ? 1L : 0L;
            if (valid != 0) {
                long left_value = output[ig_row_register_value_offset(
                    args.row_count, left_register, row)];
                long right_value = output[ig_row_register_value_offset(
                    args.row_count, right_register, row)];
                if (opcode == 13ul) {
                    if (output_type != 2u) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
                        value = 0;
                        valid = 0;
                    } else if (right_value == 0L) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_MODULO_ZERO);
                        value = 0;
                    } else {
                        // Metal integer division, like Rust's checked remainder, must not execute
                        // MIN / -1 even though the mathematical remainder is exactly zero.
                        value = right_value == -1L ? 0L : left_value % right_value;
                    }
                } else if (output_type == 2u) {
                    bool success = opcode == 9ul
                        ? ig_row_i64_add(left_value, right_value, value)
                        : (opcode == 10ul
                            ? ig_row_i64_multiply(left_value, right_value, value)
                            : ig_row_i64_subtract(left_value, right_value, value));
                    if (!success) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_OVERFLOW);
                        value = 0;
                    }
                } else {
                    uint left_type = uint(metadata[ulong(left_register) * 8ul + 1ul]);
                    uint right_type = uint(metadata[ulong(right_register) * 8ul + 1ul]);
                    ulong left_bits = left_type == 2u
                        ? ig_row_i64_to_f64(left_value)
                        : as_type<ulong>(left_value);
                    ulong right_bits = right_type == 2u
                        ? ig_row_i64_to_f64(right_value)
                        : as_type<ulong>(right_value);
                    ulong result = opcode == 9ul
                        ? ig_row_f64_add(left_bits, right_bits)
                        : (opcode == 10ul
                            ? ig_row_f64_multiply(left_bits, right_bits)
                            : ig_row_f64_subtract(left_bits, right_bits));
                    value = as_type<long>(result);
                }
            }
        } else if (opcode == 11ul) {
            uint operand = uint(first);
            valid = output[ig_row_register_validity_offset(
                args.row_count, args.instruction_count, operand, row)];
            long operand_value = output[ig_row_register_value_offset(
                args.row_count, operand, row)];
            if (output_type == 2u) {
                if (valid != 0) {
                    if (as_type<ulong>(operand_value) == IG_ROW_F64_SIGN) {
                        ig_row_record_error(
                            error, args, instruction, row, IG_ROW_ERROR_NEGATE_OVERFLOW);
                        value = 0;
                    } else {
                        value = -operand_value;
                    }
                }
            } else {
                value = as_type<long>(as_type<ulong>(operand_value) ^ IG_ROW_F64_SIGN);
            }
        } else {
            ig_row_record_error(error, args, instruction, row, IG_ROW_ERROR_DESCRIPTOR);
            value = 0;
            valid = 0;
        }
        output[ig_row_register_value_offset(args.row_count, instruction, row)] = value;
        output[ig_row_register_validity_offset(
            args.row_count, args.instruction_count, instruction, row)] = valid;
    }
}

kernel void ig_resident_row_reduce_error(
    device long* output [[buffer(0)]],
    constant ResidentRowEvaluateArgs& args [[buffer(1)]],
    uint lane [[thread_position_in_grid]]) {
    if (lane != 0u || args.output_word_count == 0ul) return;
    ulong status_base = 1ul
        + ulong(args.instruction_count) * args.row_count * 2ul;
    uint selected = IG_ROW_EVALUATION_OK;
    uint selected_instruction = IG_ROW_EVALUATION_OK;
    for (ulong row = 0ul; row < args.row_count; ++row) {
        // Each status owns one complete `long` slot. Reinterpret that individual slot so advancing
        // a row advances eight bytes; indexing one cast `atomic_uint*` would incorrectly walk the
        // low and high halves of each slot as two different rows.
        device const atomic_uint* status_slot =
            reinterpret_cast<device const atomic_uint*>(output + status_base + row);
        uint status = atomic_load_explicit(status_slot, memory_order_relaxed);
        uint instruction = status >> 3;
        if (instruction < selected_instruction) {
            selected = status;
            selected_instruction = instruction;
        }
    }
    output[0] = long(selected);
}

struct ResidentRowDispatchArgs {
    ulong logical_count;
    ulong dispatch_base;
    ulong dispatch_count;
};

kernel void ig_resident_row_float_order_key(
    device const long* values [[buffer(0)]],
    device long* keys [[buffer(1)]],
    constant ResidentRowDispatchArgs& args [[buffer(2)]],
    uint row_index [[thread_position_in_grid]]) {
    ulong local_row = ulong(row_index);
    if (local_row >= args.dispatch_count
            || args.dispatch_base > args.logical_count
            || local_row >= args.logical_count - args.dispatch_base) return;
    ulong row = args.dispatch_base + local_row;
    ulong bits = as_type<ulong>(values[row]);
    if (ig_row_f64_is_nan(bits)) {
        keys[row] = 0x7fffffffffffffffL;
        return;
    }
    if ((bits & ~IG_ROW_F64_SIGN) == 0) {
        keys[row] = 0;
        return;
    }
    ulong ordered = (bits & IG_ROW_F64_SIGN) == 0
        ? bits ^ IG_ROW_F64_SIGN
        : ~bits;
    keys[row] = as_type<long>(ordered ^ IG_ROW_F64_SIGN);
}

struct ResidentRowStringDigitArgs {
    ulong row_count;
    ulong dispatch_base;
    ulong dispatch_count;
    ulong evaluated_word_count;
    ulong payload_base;
    uint byte_position;
    uint presence;
};

kernel void ig_resident_row_string_digit(
    device const long* evaluated [[buffer(0)]],
    device uchar* digits [[buffer(1)]],
    constant ResidentRowStringDigitArgs& args [[buffer(2)]],
    uint row_index [[thread_position_in_grid]]) {
    ulong local_row = ulong(row_index);
    if (local_row >= args.dispatch_count
            || args.dispatch_base > args.row_count
            || local_row >= args.row_count - args.dispatch_base) return;
    ulong row = args.dispatch_base + local_row;
    uchar digit = 0;
    if (args.presence <= 1u
            && args.payload_base + args.row_count <= args.evaluated_word_count) {
        long raw = evaluated[args.payload_base + row];
        uint offset = 0u;
        uint length = 0u;
        if (ig_row_unpack_string_reference(
                raw, args.evaluated_word_count * 8ul, offset, length)
                && args.byte_position < length) {
            if (args.presence != 0u) {
                digit = 1;
            } else {
                device const uchar* bytes =
                    reinterpret_cast<device const uchar*>(evaluated);
                digit = bytes[ulong(offset) + ulong(args.byte_position)];
            }
        }
    }
    digits[row] = digit;
}

struct ResidentStringMatchArgs {
    uint entry_count;
    uint byte_count;
    uint operand_count;
    uint operation;
};

kernel void ig_resident_string_match(
    device const uint* offsets [[buffer(0)]],
    device const uchar* bytes [[buffer(1)]],
    device const uchar* operand [[buffer(2)]],
    device uchar* output [[buffer(3)]],
    constant ResidentStringMatchArgs& args [[buffer(4)]],
    uint entry [[thread_position_in_grid]]) {
    if (entry >= args.entry_count) return;
    uint start = offsets[entry];
    uint end = offsets[entry + 1u];
    if (end < start || end > args.byte_count || args.operation > 2u) {
        output[entry] = 0;
        return;
    }
    uint length = end - start;
    bool matched = args.operand_count == 0u;
    if (args.operand_count != 0u) {
        if (args.operation == 0u) {
            matched = length >= args.operand_count;
            for (uint index = 0; matched && index < args.operand_count; ++index) {
                matched = bytes[start + index] == operand[index];
            }
        } else if (args.operation == 1u) {
            matched = length >= args.operand_count;
            uint candidate = matched ? end - args.operand_count : start;
            for (uint index = 0; matched && index < args.operand_count; ++index) {
                matched = bytes[candidate + index] == operand[index];
            }
        } else {
            matched = false;
            if (length >= args.operand_count) {
                uint final_candidate = length - args.operand_count;
                for (uint candidate = 0; candidate <= final_candidate && !matched; ++candidate) {
                    bool equal = true;
                    for (uint index = 0; equal && index < args.operand_count; ++index) {
                        equal = bytes[start + candidate + index] == operand[index];
                    }
                    matched = equal;
                }
            }
        }
    }
    output[entry] = matched ? 2 : 1;
}

inline void ig_row_proof_store_u64(
    device uint* proof,
    ulong offset,
    ulong value) {
    proof[offset] = uint(value);
    proof[offset + 1ul] = uint(value >> 32);
}

inline bool ig_row_proof_matches_u64(
    device const uint* proof,
    ulong offset,
    ulong value) {
    return proof[offset] == uint(value)
        && proof[offset + 1ul] == uint(value >> 32);
}

inline ulong ig_row_proof_load_u64(
    device const uint* proof,
    ulong offset) {
    return ulong(proof[offset]) | (ulong(proof[offset + 1ul]) << 32);
}

inline ulong ig_row_proof_value_key(
    device const long* evaluated,
    constant ResidentRowProofArgs& args,
    constant ResidentRowProofKey& key,
    ulong row,
    thread uint& errors) {
    long raw = evaluated[ig_row_register_value_offset(args.input_rows, key.reg, row)];
    ulong ordered;
    if (key.value_type == 1u) {
        if (raw != 0 && raw != 1) errors |= IG_ROW_PROOF_DESCRIPTOR;
        ordered = as_type<ulong>(raw) ^ IG_ROW_F64_SIGN;
    } else if (key.value_type == 2u || key.value_type == 5u
            || key.value_type == 6u || key.value_type == 7u
            || key.value_type == 8u || key.value_type == 9u) {
        ordered = as_type<ulong>(raw) ^ IG_ROW_F64_SIGN;
    } else if (key.value_type == 3u) {
        ulong bits = as_type<ulong>(raw);
        if (ig_row_f64_is_nan(bits)) {
            ordered = ulong(-1);
        } else if ((bits & ~IG_ROW_F64_SIGN) == 0) {
            ordered = IG_ROW_F64_SIGN;
        } else {
            ordered = (bits & IG_ROW_F64_SIGN) == 0
                ? bits ^ IG_ROW_F64_SIGN
                : ~bits;
        }
    } else if (key.value_type == 4u) {
        if (raw < 0L || as_type<ulong>(raw) > 0xfffffffful) {
            errors |= IG_ROW_PROOF_DESCRIPTOR;
        }
        ordered = as_type<ulong>(raw);
    } else {
        errors |= IG_ROW_PROOF_DESCRIPTOR;
        ordered = 0;
    }
    return key.descending != 0 ? ~ordered : ordered;
}

inline int ig_row_proof_compare_string_payload(
    device const long* evaluated,
    constant ResidentRowProofArgs& args,
    constant ResidentRowProofKey& key,
    ulong payload_base,
    ulong left,
    ulong right,
    thread uint& errors) {
    if (payload_base + args.input_rows > args.evaluated_word_count) {
        errors |= IG_ROW_PROOF_DESCRIPTOR;
        return 0;
    }
    long left_raw = evaluated[payload_base + left];
    long right_raw = evaluated[payload_base + right];
    ulong left_bits = as_type<ulong>(left_raw);
    ulong right_bits = as_type<ulong>(right_raw);
    bool left_reference = (uint(left_bits >> 32) & IG_ROW_STRING_REFERENCE_MARKER) != 0u;
    bool right_reference = (uint(right_bits >> 32) & IG_ROW_STRING_REFERENCE_MARKER) != 0u;
    int comparison = 0;
    if (left_reference != right_reference) {
        errors |= IG_ROW_PROOF_DESCRIPTOR;
    } else if (!left_reference) {
        if (left_raw < 0L || right_raw < 0L
                || left_bits > 0xfffffffful || right_bits > 0xfffffffful) {
            errors |= IG_ROW_PROOF_DESCRIPTOR;
        } else if (left_bits < right_bits) {
            comparison = -1;
        } else if (left_bits > right_bits) {
            comparison = 1;
        }
    } else {
        uint left_offset = 0u;
        uint left_length = 0u;
        uint right_offset = 0u;
        uint right_length = 0u;
        ulong evaluated_bytes = args.evaluated_word_count * 8ul;
        bool valid = ig_row_unpack_string_reference(
                left_raw, evaluated_bytes, left_offset, left_length)
            && ig_row_unpack_string_reference(
                right_raw, evaluated_bytes, right_offset, right_length);
        if (valid && key.value_type == 10u) {
            valid = left_length % IG_ROW_LIST_ELEMENT_BYTES == 0u
                && right_length % IG_ROW_LIST_ELEMENT_BYTES == 0u;
            device const uchar* list_bytes =
                reinterpret_cast<device const uchar*>(evaluated);
            for (uint offset = 0u; valid && offset < left_length;
                    offset += IG_ROW_LIST_ELEMENT_BYTES) {
                long ignored_value = 0L;
                long ignored_validity = 0L;
                valid = ig_row_decode_list_element(
                    list_bytes, ulong(left_offset) + ulong(offset),
                    ignored_value, ignored_validity);
            }
            for (uint offset = 0u; valid && offset < right_length;
                    offset += IG_ROW_LIST_ELEMENT_BYTES) {
                long ignored_value = 0L;
                long ignored_validity = 0L;
                valid = ig_row_decode_list_element(
                    list_bytes, ulong(right_offset) + ulong(offset),
                    ignored_value, ignored_validity);
            }
        }
        if (!valid) {
            errors |= IG_ROW_PROOF_DESCRIPTOR;
        } else {
            device const uchar* bytes = reinterpret_cast<device const uchar*>(evaluated);
            uint shared = min(left_length, right_length);
            for (uint index = 0; index < shared; ++index) {
                uchar left_byte = bytes[ulong(left_offset) + ulong(index)];
                uchar right_byte = bytes[ulong(right_offset) + ulong(index)];
                if (left_byte < right_byte) {
                    comparison = -1;
                    break;
                }
                if (left_byte > right_byte) {
                    comparison = 1;
                    break;
                }
            }
            if (comparison == 0) {
                if (left_length < right_length) comparison = -1;
                else if (left_length > right_length) comparison = 1;
            }
        }
    }
    return key.descending != 0 ? -comparison : comparison;
}

inline int ig_row_proof_compare_string(
    device const long* evaluated,
    constant ResidentRowProofArgs& args,
    constant ResidentRowProofKey& key,
    ulong left,
    ulong right,
    thread uint& errors) {
    ulong payload_base = ig_row_register_value_offset(args.input_rows, key.reg, 0ul);
    return ig_row_proof_compare_string_payload(
        evaluated, args, key, payload_base, left, right, errors);
}

inline int ig_row_proof_compare_long_component(
    long left,
    long right,
    uint descending) {
    int comparison = left < right ? -1 : (left > right ? 1 : 0);
    return descending != 0 ? -comparison : comparison;
}

inline int ig_row_proof_compare_temporal(
    device const long* evaluated,
    constant ResidentRowProofArgs& args,
    constant ResidentRowProofKey& key,
    ulong left,
    ulong right,
    thread uint& errors) {
    uint expected_lanes = key.value_type == 8u ? 1u : 2u;
    ulong sidecar_words = ulong(expected_lanes) * args.input_rows;
    if (key.sidecar_lanes != expected_lanes || key.reserved != 0u
            || key.sidecar_base + sidecar_words > args.evaluated_word_count) {
        errors |= IG_ROW_PROOF_DESCRIPTOR;
        return 0;
    }
    long left_primary = evaluated[ig_row_register_value_offset(
        args.input_rows, key.reg, left)];
    long right_primary = evaluated[ig_row_register_value_offset(
        args.input_rows, key.reg, right)];
    if (key.value_type == 7u) {
        long left_local = evaluated[key.sidecar_base + left];
        long right_local = evaluated[key.sidecar_base + right];
        long left_offset = evaluated[key.sidecar_base + args.input_rows + left];
        long right_offset = evaluated[key.sidecar_base + args.input_rows + right];
        if (left_offset < (-2147483647L - 1L) || left_offset > 2147483647L
                || right_offset < (-2147483647L - 1L) || right_offset > 2147483647L
                || left_primary != ig_row_saturating_zoned_time(left_local, left_offset)
                || right_primary != ig_row_saturating_zoned_time(right_local, right_offset)) {
            errors |= IG_ROW_PROOF_DESCRIPTOR;
        }
        int comparison = ig_row_proof_compare_long_component(
            left_primary, right_primary, key.descending);
        if (comparison != 0) return comparison;
        return ig_row_proof_compare_long_component(
            left_offset, right_offset, key.descending);
    }

    long left_nanos = evaluated[key.sidecar_base + left];
    long right_nanos = evaluated[key.sidecar_base + right];
    if (left_nanos < 0L || left_nanos > 999999999L
            || right_nanos < 0L || right_nanos > 999999999L) {
        errors |= IG_ROW_PROOF_DESCRIPTOR;
    }
    int comparison = ig_row_proof_compare_long_component(
        left_primary, right_primary, key.descending);
    if (comparison != 0) return comparison;
    comparison = ig_row_proof_compare_long_component(
        left_nanos, right_nanos, key.descending);
    if (comparison != 0 || key.value_type == 8u) return comparison;
    return ig_row_proof_compare_string_payload(
        evaluated,
        args,
        key,
        key.sidecar_base + args.input_rows,
        left,
        right,
        errors);
}

// Returns the exact total order used by the stable Metal sort. Source row is the final key, so
// equality is possible only when both operands name the same canonical input row.
inline int ig_row_proof_compare(
    device const long* evaluated,
    constant ResidentRowProofArgs& args,
    ulong left,
    ulong right,
    thread uint& errors) {
    for (uint index = 0; index < args.sort_key_count; ++index) {
        constant ResidentRowProofKey& key = args.sort_keys[index];
        uint expected_sidecar_lanes = key.value_type == 8u
            ? 1u
            : ((key.value_type == 7u || key.value_type == 9u) ? 2u : 0u);
        bool sidecar_valid = expected_sidecar_lanes == 0u
            ? (key.sidecar_base == 0ul && key.sidecar_lanes == 0u)
            : (key.sidecar_lanes == expected_sidecar_lanes
                && key.sidecar_base
                    + ulong(expected_sidecar_lanes) * args.input_rows
                    <= args.evaluated_word_count);
        if (key.reg >= args.instruction_count
                || key.value_type < 1u || key.value_type > 10u
                || key.descending > 1u || key.nulls_first > 1u
                || key.reserved != 0u || !sidecar_valid) {
            errors |= IG_ROW_PROOF_DESCRIPTOR;
            continue;
        }
        long left_valid_word = evaluated[ig_row_register_validity_offset(
            args.input_rows, args.instruction_count, key.reg, left)];
        long right_valid_word = evaluated[ig_row_register_validity_offset(
            args.input_rows, args.instruction_count, key.reg, right)];
        if ((left_valid_word != 0 && left_valid_word != 1)
                || (right_valid_word != 0 && right_valid_word != 1)) {
            errors |= IG_ROW_PROOF_DESCRIPTOR;
        }
        bool left_valid = left_valid_word != 0;
        bool right_valid = right_valid_word != 0;
        uint left_category = left_valid
            ? (key.nulls_first != 0 ? 1u : 0u)
            : (key.nulls_first != 0 ? 0u : 1u);
        uint right_category = right_valid
            ? (key.nulls_first != 0 ? 1u : 0u)
            : (key.nulls_first != 0 ? 0u : 1u);
        if (left_category < right_category) return -1;
        if (left_category > right_category) return 1;
        if (left_valid) {
            if (key.value_type == 4u || key.value_type == 10u) {
                int comparison = ig_row_proof_compare_string(
                    evaluated, args, key, left, right, errors);
                if (comparison != 0) return comparison;
            } else if (key.value_type == 7u || key.value_type == 8u
                    || key.value_type == 9u) {
                int comparison = ig_row_proof_compare_temporal(
                    evaluated, args, key, left, right, errors);
                if (comparison != 0) return comparison;
            } else {
                ulong left_key = ig_row_proof_value_key(evaluated, args, key, left, errors);
                ulong right_key = ig_row_proof_value_key(evaluated, args, key, right, errors);
                if (left_key < right_key) return -1;
                if (left_key > right_key) return 1;
            }
        }
    }
    if (left < right) return -1;
    if (left > right) return 1;
    return 0;
}

kernel void ig_resident_row_proof_initialize(
    device uint* proof [[buffer(0)]],
    device atomic_uint* membership [[buffer(1)]],
    constant ResidentRowProofArgs& args [[buffer(2)]],
    uint index [[thread_position_in_grid]]) {
    ulong local = ulong(index);
    if (local >= args.dispatch_count) return;
    ulong logical_index = args.dispatch_base + local;
    if (logical_index < args.dispatch_base) return;
    ulong membership_words = args.input_rows == 0 ? 1ul : args.input_rows;
    if (logical_index < membership_words) {
        atomic_store_explicit(&membership[logical_index], 0u, memory_order_relaxed);
    }
    if (logical_index != 0ul) return;
    proof[0] = IG_ROW_PROOF_MAGIC;
    proof[1] = 0u;
    proof[2] = args.strategy;
    proof[3] = args.sort_key_count;
    ig_row_proof_store_u64(proof, 4u, args.input_rows);
    ig_row_proof_store_u64(proof, 6u, args.position_count);
    ig_row_proof_store_u64(proof, 8u, args.output_rows);
    ig_row_proof_store_u64(proof, 10u, args.offset);
    ig_row_proof_store_u64(proof, 12u, args.graph_column_count);
    ig_row_proof_store_u64(proof, 14u, args.execution_high);
    ig_row_proof_store_u64(proof, 16u, args.execution_low);
    ig_row_proof_store_u64(proof, 18u, args.project_high);
    ig_row_proof_store_u64(proof, 20u, args.project_low);
    ig_row_proof_store_u64(proof, 22u, args.bookmark_term);
    ig_row_proof_store_u64(proof, 24u, args.bookmark_index);
    ig_row_proof_store_u64(proof, 26u, args.graph_revision);
    ig_row_proof_store_u64(proof, 28u, args.layout_version);
    ig_row_proof_store_u64(proof, 30u, args.fingerprint_0);
    ig_row_proof_store_u64(proof, 32u, args.fingerprint_1);
    ig_row_proof_store_u64(proof, 34u, args.fingerprint_2);
    ig_row_proof_store_u64(proof, 36u, args.fingerprint_3);
    if (args.output_rows == 0) {
        proof[IG_ROW_PROOF_HEADER_WORDS] = 0u;
        proof[IG_ROW_PROOF_HEADER_WORDS + 1u] = 0u;
    }
}

kernel void ig_resident_row_proof_mark(
    device const long* positions [[buffer(0)]],
    device atomic_uint* membership [[buffer(1)]],
    device uint* proof [[buffer(2)]],
    constant ResidentRowProofArgs& args [[buffer(3)]],
    uint index [[thread_position_in_grid]]) {
    ulong local = ulong(index);
    if (local >= args.dispatch_count) return;
    ulong logical_index = args.dispatch_base + local;
    if (logical_index < args.dispatch_base || logical_index >= args.position_count) return;
    device atomic_uint* status = reinterpret_cast<device atomic_uint*>(proof + 1u);
    ulong row = as_type<ulong>(positions[logical_index]);
    if (row >= args.input_rows) {
        atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
        return;
    }
    uint previous = atomic_exchange_explicit(&membership[row], 1u, memory_order_relaxed);
    if (previous != 0) {
        atomic_fetch_or_explicit(status, IG_ROW_PROOF_MEMBERSHIP, memory_order_relaxed);
    }
}

kernel void ig_resident_row_proof_verify(
    device const long* evaluated [[buffer(0)]],
    device const long* positions [[buffer(1)]],
    device const uint* graph [[buffer(2)]],
    device const atomic_uint* membership [[buffer(3)]],
    device uint* proof [[buffer(4)]],
    constant ResidentRowProofArgs& args [[buffer(5)]],
    uint index [[thread_position_in_grid]]) {
    device atomic_uint* status = reinterpret_cast<device atomic_uint*>(proof + 1u);
    ulong local = ulong(index);
    if (local >= args.dispatch_count) return;
    ulong lane = args.dispatch_base + local;
    if (lane < args.dispatch_base) return;

    if (lane < args.position_count) {
        ulong row = as_type<ulong>(positions[lane]);
        if (row >= args.input_rows) {
            atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
        } else {
            if (args.strategy == IG_ROW_PROOF_IDENTITY && row != lane) {
                atomic_fetch_or_explicit(
                    status, IG_ROW_PROOF_IDENTITY_FAILURE, memory_order_relaxed);
            }
            if ((args.strategy == IG_ROW_PROOF_TOP_K || args.strategy == IG_ROW_PROOF_RADIX)
                    && lane != 0ul) {
                ulong previous = as_type<ulong>(positions[lane - 1ul]);
                if (previous >= args.input_rows) {
                    atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
                } else {
                    uint errors = 0u;
                    int comparison = ig_row_proof_compare(
                        evaluated, args, previous, row, errors);
                    if (errors != 0) {
                        atomic_fetch_or_explicit(status, errors, memory_order_relaxed);
                    }
                    if (comparison >= 0) {
                        atomic_fetch_or_explicit(
                            status, IG_ROW_PROOF_ORDER, memory_order_relaxed);
                    }
                }
            }
        }
    }

    if (lane < args.input_rows) {
        uint member = atomic_load_explicit(&membership[lane], memory_order_relaxed);
        if (args.strategy == IG_ROW_PROOF_IDENTITY || args.strategy == IG_ROW_PROOF_RADIX) {
            if (member != 1u) {
                atomic_fetch_or_explicit(
                    status, IG_ROW_PROOF_MEMBERSHIP, memory_order_relaxed);
            }
        } else if (args.strategy == IG_ROW_PROOF_TOP_K && member == 0u) {
            if (args.position_count == 0) {
                atomic_fetch_or_explicit(
                    status, IG_ROW_PROOF_OPTIMALITY, memory_order_relaxed);
            } else {
                ulong boundary = as_type<ulong>(positions[args.position_count - 1ul]);
                if (boundary >= args.input_rows) {
                    atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
                } else {
                    uint errors = 0u;
                    int comparison = ig_row_proof_compare(
                        evaluated, args, lane, boundary, errors);
                    if (errors != 0) {
                        atomic_fetch_or_explicit(status, errors, memory_order_relaxed);
                    }
                    if (comparison < 0) {
                        atomic_fetch_or_explicit(
                            status, IG_ROW_PROOF_OPTIMALITY, memory_order_relaxed);
                    }
                }
            }
        }
    }

    if (lane < args.output_rows) {
        ulong selected = args.offset + lane;
        if (selected >= args.position_count) {
            ig_row_proof_store_u64(
                proof, ulong(IG_ROW_PROOF_HEADER_WORDS) + lane * 2ul, 0ul);
            atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
        } else {
            ulong row = as_type<ulong>(positions[selected]);
            ig_row_proof_store_u64(
                proof, ulong(IG_ROW_PROOF_HEADER_WORDS) + lane * 2ul, row);
            if (row >= args.input_rows) {
                atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
            }
        }
    }

    ulong graph_cells = args.graph_column_count * args.output_rows;
    if (lane < graph_cells && args.output_rows != 0) {
        ulong column = lane / args.output_rows;
        ulong output_row = lane - column * args.output_rows;
        ulong selected = args.offset + output_row;
        if (selected >= args.position_count) {
            atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
        } else {
            ulong source_row = as_type<ulong>(positions[selected]);
            if (source_row >= args.input_rows) {
                atomic_fetch_or_explicit(status, IG_ROW_PROOF_BOUNDS, memory_order_relaxed);
            } else {
                ulong input_offset = column * args.input_rows + source_row;
                ulong output_base = args.graph_column_count * args.input_rows;
                ulong output_offset = output_base + column * args.output_rows + output_row;
                if (graph[input_offset] != graph[output_offset]) {
                    atomic_fetch_or_explicit(
                        status, IG_ROW_PROOF_GRAPH_ALIGNMENT, memory_order_relaxed);
                }
            }
        }
    }
}

inline bool ig_row_proof_matches_finalize(
    device const uint* proof,
    constant ResidentRowFinalizeArgs& args) {
    return proof[0] == IG_ROW_PROOF_MAGIC
        && proof[1] == 0u
        && proof[2] == args.proof_strategy
        && proof[3] == args.proof_sort_key_count
        && ig_row_proof_matches_u64(proof, 4u, args.input_rows)
        && ig_row_proof_matches_u64(proof, 6u, args.proof_position_count)
        && ig_row_proof_matches_u64(proof, 8u, args.output_rows)
        && ig_row_proof_matches_u64(proof, 10u, args.proof_offset)
        && ig_row_proof_matches_u64(proof, 12u, args.proof_graph_column_count)
        && ig_row_proof_matches_u64(proof, 14u, args.execution_high)
        && ig_row_proof_matches_u64(proof, 16u, args.execution_low)
        && ig_row_proof_matches_u64(proof, 18u, args.project_high)
        && ig_row_proof_matches_u64(proof, 20u, args.project_low)
        && ig_row_proof_matches_u64(proof, 22u, args.bookmark_term)
        && ig_row_proof_matches_u64(proof, 24u, args.bookmark_index)
        && ig_row_proof_matches_u64(proof, 26u, args.graph_revision)
        && ig_row_proof_matches_u64(proof, 28u, args.layout_version)
        && ig_row_proof_matches_u64(proof, 30u, args.fingerprint_0)
        && ig_row_proof_matches_u64(proof, 32u, args.fingerprint_1)
        && ig_row_proof_matches_u64(proof, 34u, args.fingerprint_2)
        && ig_row_proof_matches_u64(proof, 36u, args.fingerprint_3);
}

inline ulong ig_row_finalize_string_capacity(
    device const long* metadata,
    uint reg) {
    ulong descriptor = ulong(reg) * 8ul;
    ulong opcode = as_type<ulong>(metadata[descriptor]);
    return as_type<ulong>(metadata[descriptor + (opcode == 33ul ? 7ul : 6ul)]);
}

inline ulong ig_row_finalize_projection_words(
    device const long* metadata,
    constant ResidentRowFinalizeArgs& args,
    uint reg) {
    uint value_type = uint(metadata[ulong(reg) * 8ul + 1ul]);
    ulong fixed_columns = (value_type >= 1u && value_type <= 3u)
            || value_type == 4u || value_type == 5u || value_type == 6u
            || value_type == 10u
        ? 2ul
        : ((value_type == 7u || value_type == 8u)
            ? 3ul
            : (value_type == 9u ? 4ul : 0ul));
    if (fixed_columns == 0ul) return 0ul;
    ulong words = 2ul + args.output_rows * fixed_columns;
    if (value_type == 4u || value_type == 9u || value_type == 10u) {
        ulong capacity = value_type == 4u
            ? ig_row_finalize_string_capacity(metadata, reg)
            : as_type<ulong>(metadata[ulong(reg) * 8ul + 7ul]);
        ulong byte_count = args.output_rows * capacity;
        words += (byte_count + 7ul) / 8ul;
    }
    return words;
}

kernel void ig_resident_row_finalize(
    device const long* evaluated [[buffer(0)]],
    device const long* metadata [[buffer(1)]],
    device const uint* proof [[buffer(2)]],
    device long* output [[buffer(3)]],
    constant ResidentRowFinalizeArgs& args [[buffer(4)]],
    uint word_index [[thread_position_in_grid]]) {
    ulong local_word = ulong(word_index);
    if (local_word >= args.dispatch_count
            || args.dispatch_base > args.output_word_count
            || local_word >= args.output_word_count - args.dispatch_base) return;
    ulong word = args.dispatch_base + local_word;
    uint evaluation_status = uint(evaluated[0]);
    bool arithmetic_failure = evaluation_status != IG_ROW_EVALUATION_OK;
    uint arithmetic_code = evaluation_status & 7u;
    if (arithmetic_failure && arithmetic_code == 0u) {
        arithmetic_code = IG_ROW_ERROR_DESCRIPTOR;
    }
    bool proof_complete = ig_row_proof_matches_finalize(proof, args);
    if (arithmetic_failure || !proof_complete) {
        output[word] = word == 0ul
            ? as_type<long>(0x4947524f57505247ul)
            : (word == 1ul ? (arithmetic_failure ? long(arithmetic_code) : 5L) : 0L);
        return;
    }
    device const uint* positions = proof + IG_ROW_PROOF_HEADER_WORDS;
    if (word < 20ul) {
        switch (word) {
            case 0ul: output[word] = as_type<long>(0x4947524f57505247ul); break;
            case 1ul: output[word] = 0L; break;
            case 2ul: output[word] = as_type<long>(args.execution_high); break;
            case 3ul: output[word] = as_type<long>(args.execution_low); break;
            case 4ul: output[word] = as_type<long>(args.project_high); break;
            case 5ul: output[word] = as_type<long>(args.project_low); break;
            case 6ul: output[word] = as_type<long>(args.bookmark_term); break;
            case 7ul: output[word] = as_type<long>(args.bookmark_index); break;
            case 8ul: output[word] = as_type<long>(args.graph_revision); break;
            case 9ul: output[word] = as_type<long>(args.layout_version); break;
            case 10ul: output[word] = as_type<long>(args.fingerprint_0); break;
            case 11ul: output[word] = as_type<long>(args.fingerprint_1); break;
            case 12ul: output[word] = as_type<long>(args.fingerprint_2); break;
            case 13ul: output[word] = as_type<long>(args.fingerprint_3); break;
            case 14ul: output[word] = as_type<long>(args.input_rows); break;
            case 15ul: output[word] = as_type<long>(args.output_rows); break;
            case 16ul: output[word] = as_type<long>(args.output_rows); break;
            case 17ul: output[word] = long(args.projection_count); break;
            case 18ul: output[word] = long(args.receipt_count); break;
            default: output[word] = as_type<long>(args.scratch_bytes); break;
        }
        return;
    }
    ulong source_start = 20ul;
    ulong projection_start = source_start + args.output_rows;
    if (word < projection_start) {
        output[word] = as_type<long>(ig_row_proof_load_u64(
            positions, (word - source_start) * 2ul));
        return;
    }
    ulong receipt_start = projection_start + args.projection_word_count;
    if (word < receipt_start) {
        ulong local = word - projection_start;
        uint projection = 0u;
        uint reg = 0u;
        ulong field = 0ul;
        bool found = false;
        ulong projection_cursor = 0ul;
        for (uint candidate = 0u; candidate < args.projection_count; ++candidate) {
            uint candidate_reg = uint(metadata[
                ulong(args.projection_metadata_offset) + ulong(candidate)]);
            ulong width = ig_row_finalize_projection_words(metadata, args, candidate_reg);
            if (width != 0ul && local >= projection_cursor
                    && local - projection_cursor < width) {
                projection = candidate;
                reg = candidate_reg;
                field = local - projection_cursor;
                found = true;
                break;
            }
            projection_cursor += width;
        }
        if (!found) {
            output[word] = 0L;
            return;
        }
        (void)projection;
        ulong descriptor = ulong(reg) * 8ul;
        uint value_type = uint(metadata[descriptor + 1ul]);
        if (field == 0ul) {
            output[word] = long(reg);
        } else if (field == 1ul) {
            output[word] = long(value_type);
        } else if ((value_type >= 1u && value_type <= 3u)
                || value_type == 5u || value_type == 6u) {
            bool validity_field = field >= 2ul + args.output_rows;
            ulong output_row = validity_field
                ? field - (2ul + args.output_rows)
                : field - 2ul;
            ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
            ulong offset = validity_field
                ? ig_row_register_validity_offset(
                    args.input_rows, args.instruction_count, reg, source_row)
                : ig_row_register_value_offset(args.input_rows, reg, source_row);
            output[word] = evaluated[offset];
        } else if (value_type == 7u || value_type == 8u) {
            ulong output_row = (field - 2ul) % args.output_rows;
            ulong component = (field - 2ul) / args.output_rows;
            ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
            ulong sidecar_word = as_type<ulong>(metadata[descriptor + 5ul]);
            ulong sidecar_base = as_type<ulong>(metadata[descriptor]) == 27ul
                ? ulong(uint(sidecar_word))
                : sidecar_word;
            if (component == 0ul) {
                output[word] = value_type == 7u
                    ? evaluated[sidecar_base + source_row]
                    : evaluated[ig_row_register_value_offset(
                        args.input_rows, reg, source_row)];
            } else if (component == 1ul) {
                output[word] = value_type == 7u
                    ? evaluated[sidecar_base + args.input_rows + source_row]
                    : evaluated[sidecar_base + source_row];
            } else {
                output[word] = evaluated[ig_row_register_validity_offset(
                    args.input_rows, args.instruction_count, reg, source_row)];
            }
        } else if (value_type == 4u) {
            ulong fixed_end = 2ul + args.output_rows * 2ul;
            ulong capacity = ig_row_finalize_string_capacity(metadata, reg);
            if (field < fixed_end) {
                ulong output_row = (field - 2ul) % args.output_rows;
                ulong component = (field - 2ul) / args.output_rows;
                ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
                if (component == 0ul) {
                    long raw = evaluated[ig_row_register_value_offset(
                        args.input_rows, reg, source_row)];
                    uint offset = 0u;
                    uint length = 0u;
                    bool valid_reference = ig_row_unpack_string_reference(
                        raw, args.evaluated_word_count * 8ul, offset, length);
                    output[word] = valid_reference ? long(length) : 0L;
                } else {
                    output[word] = evaluated[ig_row_register_validity_offset(
                        args.input_rows, args.instruction_count, reg, source_row)];
                }
            } else {
                ulong packed_word = field - fixed_end;
                ulong first_byte = packed_word * 8ul;
                ulong total_bytes = args.output_rows * capacity;
                ulong packed = 0ul;
                for (uint lane = 0u; lane < 8u; ++lane) {
                    ulong byte_index = first_byte + ulong(lane);
                    if (byte_index >= total_bytes || capacity == 0ul) continue;
                    ulong output_row = byte_index / capacity;
                    ulong byte_position = byte_index - output_row * capacity;
                    ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
                    long raw = evaluated[ig_row_register_value_offset(
                        args.input_rows, reg, source_row)];
                    uint offset = 0u;
                    uint length = 0u;
                    uchar byte = 0u;
                    if (ig_row_unpack_string_reference(
                            raw, args.evaluated_word_count * 8ul, offset, length)
                            && byte_position < ulong(length)) {
                        device const uchar* evaluated_bytes =
                            reinterpret_cast<device const uchar*>(evaluated);
                        byte = evaluated_bytes[ulong(offset) + byte_position];
                    }
                    packed |= ulong(byte) << (lane * 8u);
                }
                output[word] = as_type<long>(packed);
            }
        } else if (value_type == 10u) {
            ulong fixed_end = 2ul + args.output_rows * 2ul;
            ulong capacity = as_type<ulong>(metadata[descriptor + 7ul]);
            if (field < fixed_end) {
                ulong output_row = (field - 2ul) % args.output_rows;
                ulong component = (field - 2ul) / args.output_rows;
                ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
                if (component == 0ul) {
                    long raw = evaluated[ig_row_register_value_offset(
                        args.input_rows, reg, source_row)];
                    uint offset = 0u;
                    uint length = 0u;
                    bool valid_reference = ig_row_unpack_string_reference(
                        raw, args.evaluated_word_count * 8ul, offset, length)
                        && length % IG_ROW_LIST_ELEMENT_BYTES == 0u;
                    output[word] = valid_reference
                        ? long(length / IG_ROW_LIST_ELEMENT_BYTES)
                        : 0L;
                } else {
                    output[word] = evaluated[ig_row_register_validity_offset(
                        args.input_rows, args.instruction_count, reg, source_row)];
                }
            } else {
                ulong packed_word = field - fixed_end;
                ulong first_byte = packed_word * 8ul;
                ulong total_bytes = args.output_rows * capacity;
                ulong packed = 0ul;
                for (uint lane = 0u; lane < 8u; ++lane) {
                    ulong byte_index = first_byte + ulong(lane);
                    if (byte_index >= total_bytes || capacity == 0ul) continue;
                    ulong output_row = byte_index / capacity;
                    ulong byte_position = byte_index - output_row * capacity;
                    ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
                    long raw = evaluated[ig_row_register_value_offset(
                        args.input_rows, reg, source_row)];
                    uint offset = 0u;
                    uint length = 0u;
                    uchar byte = 0u;
                    if (ig_row_unpack_string_reference(
                            raw, args.evaluated_word_count * 8ul, offset, length)
                            && length % IG_ROW_LIST_ELEMENT_BYTES == 0u
                            && byte_position < ulong(length)) {
                        device const uchar* evaluated_bytes =
                            reinterpret_cast<device const uchar*>(evaluated);
                        byte = evaluated_bytes[ulong(offset) + byte_position];
                    }
                    packed |= ulong(byte) << (lane * 8u);
                }
                output[word] = as_type<long>(packed);
            }
        } else if (value_type == 9u) {
            ulong fixed_end = 2ul + args.output_rows * 4ul;
            ulong sidecar_word = as_type<ulong>(metadata[descriptor + 5ul]);
            ulong sidecar_base = as_type<ulong>(metadata[descriptor]) == 27ul
                ? ulong(uint(sidecar_word))
                : sidecar_word;
            ulong capacity = as_type<ulong>(metadata[descriptor + 7ul]);
            if (field < fixed_end) {
                ulong output_row = (field - 2ul) % args.output_rows;
                ulong component = (field - 2ul) / args.output_rows;
                ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
                if (component == 0ul) {
                    output[word] = evaluated[ig_row_register_value_offset(
                        args.input_rows, reg, source_row)];
                } else if (component == 1ul) {
                    output[word] = evaluated[sidecar_base + source_row];
                } else if (component == 2ul) {
                    long raw = evaluated[
                        sidecar_base + args.input_rows + source_row];
                    uint offset = 0u;
                    uint length = 0u;
                    bool valid_reference = ig_row_unpack_string_reference(
                        raw, args.evaluated_word_count * 8ul, offset, length);
                    output[word] = valid_reference ? long(length) : 0L;
                } else {
                    output[word] = evaluated[ig_row_register_validity_offset(
                        args.input_rows, args.instruction_count, reg, source_row)];
                }
            } else {
                ulong packed_word = field - fixed_end;
                ulong first_byte = packed_word * 8ul;
                ulong total_bytes = args.output_rows * capacity;
                ulong packed = 0ul;
                for (uint lane = 0u; lane < 8u; ++lane) {
                    ulong byte_index = first_byte + ulong(lane);
                    if (byte_index >= total_bytes || capacity == 0ul) continue;
                    ulong output_row = byte_index / capacity;
                    ulong byte_position = byte_index - output_row * capacity;
                    ulong source_row = ig_row_proof_load_u64(positions, output_row * 2ul);
                    long raw = evaluated[
                        sidecar_base + args.input_rows + source_row];
                    uint offset = 0u;
                    uint length = 0u;
                    uchar byte = 0u;
                    if (ig_row_unpack_string_reference(
                            raw, args.evaluated_word_count * 8ul, offset, length)
                            && byte_position < ulong(length)) {
                        device const uchar* evaluated_bytes =
                            reinterpret_cast<device const uchar*>(evaluated);
                        byte = evaluated_bytes[ulong(offset) + byte_position];
                    }
                    packed |= ulong(byte) << (lane * 8u);
                }
                output[word] = as_type<long>(packed);
            }
        } else {
            output[word] = 0L;
        }
        return;
    }
    ulong local = word - receipt_start;
    uint receipt = uint(local / 9ul);
    uint field = uint(local - ulong(receipt) * 9ul);
    ulong descriptor = ulong(args.receipt_metadata_offset) + ulong(receipt) * 4ul;
    switch (field) {
        case 0u: output[word] = as_type<long>(args.execution_high); break;
        case 1u: output[word] = as_type<long>(args.execution_low); break;
        case 2u: output[word] = metadata[descriptor]; break;
        case 3u: output[word] = metadata[descriptor + 1ul]; break;
        case 4u: output[word] = metadata[descriptor + 2ul]; break;
        case 5u: output[word] = metadata[descriptor + 3ul]; break;
        case 6u: output[word] = as_type<long>(args.input_rows); break;
        case 7u: output[word] = receipt == args.instruction_count
            ? as_type<long>(args.output_rows)
            : as_type<long>(args.input_rows); break;
        default: output[word] = 2L; break;
    }
}

struct StableRadixArgs {
    ulong row_count;
    ulong block_count;
    uint digit_pass;
    uint descending;
    uint nullable;
    uint nulls_first;
    uint value_type;
};

struct StableTopKArgs {
    ulong row_count;
    ulong candidate_count;
    uint limit;
    uint descending;
    uint nulls_first;
};

struct StableF32TopKArgs {
    ulong row_count;
    uint limit;
    uint descending;
};

struct StableSelectionArgs {
    ulong row_count;
    ulong block_count;
};

struct IntegerBoundArgs {
    ulong sorted_count;
    ulong needle_count;
    uint upper;
};

struct BoundedScanArgs {
    ulong row_count;
    ulong block_count;
    long cap;
};

struct IntegerGroupSummaryArgs {
    ulong row_count;
    ulong group_count;
};

inline long ig_bounded_scan_add(long left, long right, long cap) {
    if (left >= cap || right >= cap || (right > 0L && left > cap - right)) return cap;
    return min(left + right, cap);
}

kernel void ig_bounded_scan_local(
    device const long* values [[buffer(0)]],
    device long* local_prefix [[buffer(1)]],
    device long* block_offsets [[buffer(2)]],
    constant BoundedScanArgs& args [[buffer(3)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup long scan[IG_SORT_THREADS];
    ulong row = ulong(block) * IG_SORT_THREADS + lane;
    scan[lane] = row < args.row_count ? min(values[row], args.cap) : 0L;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint offset = 1u; offset < IG_SORT_THREADS; offset <<= 1u) {
        long prior = lane >= offset ? scan[lane - offset] : 0L;
        threadgroup_barrier(mem_flags::mem_threadgroup);
        scan[lane] = ig_bounded_scan_add(scan[lane], prior, args.cap);
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (row < args.row_count) local_prefix[row] = scan[lane];
    if (lane + 1u == IG_SORT_THREADS) block_offsets[block] = scan[lane];
}

kernel void ig_bounded_scan_block_offsets(
    device long* block_offsets [[buffer(0)]],
    constant BoundedScanArgs& args [[buffer(1)]],
    uint lane [[thread_position_in_grid]]) {
    if (lane != 0u) return;
    long total = 0L;
    for (ulong block = 0; block < args.block_count; ++block) {
        long count = block_offsets[block];
        block_offsets[block] = total;
        total = ig_bounded_scan_add(total, count, args.cap);
    }
}

kernel void ig_bounded_scan_add_offsets(
    device const long* local_prefix [[buffer(0)]],
    device const long* block_offsets [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant BoundedScanArgs& args [[buffer(3)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    output[row] = ig_bounded_scan_add(
        local_prefix[row], block_offsets[row / IG_SORT_THREADS], args.cap);
}

kernel void ig_integer_bound(
    device const long* sorted [[buffer(0)]],
    device const long* needles [[buffer(1)]],
    device long* output [[buffer(2)]],
    constant IntegerBoundArgs& args [[buffer(3)]],
    uint needle_row [[thread_position_in_grid]]) {
    if (ulong(needle_row) >= args.needle_count) return;
    long needle = needles[needle_row];
    ulong low = 0;
    ulong high = args.sorted_count;
    while (low < high) {
        ulong middle = low + ((high - low) >> 1u);
        long candidate = sorted[middle];
        bool move_right = args.upper != 0 ? candidate <= needle : candidate < needle;
        if (move_right) low = middle + 1u;
        else high = middle;
    }
    output[needle_row] = long(low);
}

kernel void ig_integer_bound_ranges(
    device const long* sorted [[buffer(0)]],
    device const long* needles [[buffer(1)]],
    device const long* ranges [[buffer(2)]],
    device long* output [[buffer(3)]],
    constant IntegerBoundArgs& args [[buffer(4)]],
    uint needle_row [[thread_position_in_grid]]) {
    if (ulong(needle_row) >= args.needle_count) return;
    long needle = needles[needle_row];
    long raw_low = ranges[needle_row];
    long raw_high = ranges[args.needle_count + needle_row];
    ulong low = ulong(max(0L, min(raw_low, long(args.sorted_count))));
    ulong high = ulong(max(long(low), min(raw_high, long(args.sorted_count))));
    while (low < high) {
        ulong middle = low + ((high - low) >> 1u);
        long candidate = sorted[middle];
        bool move_right = args.upper != 0 ? candidate <= needle : candidate < needle;
        if (move_right) low = middle + 1u;
        else high = middle;
    }
    output[needle_row] = long(low);
}

// One threadgroup owns one already-sorted group. This replaces log2(N) whole-relation prefix
// generations when only the terminal count/sum/min/max of each group is consumed.
kernel void ig_integer_group_summary(
    device const long* values [[buffer(0)]],
    device const uchar* validity [[buffer(1)]],
    device const uint* group_starts [[buffer(2)]],
    device long* output [[buffer(3)]],
    constant IntegerGroupSummaryArgs& args [[buffer(4)]],
    uint group [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    if (ulong(group) >= args.group_count) return;
    threadgroup ulong sums[IG_SORT_THREADS];
    threadgroup ulong counts[IG_SORT_THREADS];
    threadgroup long minimums[IG_SORT_THREADS];
    threadgroup long maximums[IG_SORT_THREADS];
    ulong begin = group_starts[group];
    ulong end = ulong(group + 1u) < args.group_count
        ? ulong(group_starts[group + 1u])
        : args.row_count;
    ulong sum = 0ul;
    ulong count = 0ul;
    long minimum = LONG_MAX;
    long maximum = LONG_MIN;
    for (ulong row = begin + lane; row < end; row += IG_SORT_THREADS) {
        if (validity[row] == 0) continue;
        long value = values[row];
        sum += as_type<ulong>(value);
        count += 1ul;
        minimum = min(minimum, value);
        maximum = max(maximum, value);
    }
    sums[lane] = sum;
    counts[lane] = count;
    minimums[lane] = minimum;
    maximums[lane] = maximum;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint width = IG_SORT_THREADS >> 1u; width > 0u; width >>= 1u) {
        if (lane < width) {
            sums[lane] += sums[lane + width];
            counts[lane] += counts[lane + width];
            minimums[lane] = min(minimums[lane], minimums[lane + width]);
            maximums[lane] = max(maximums[lane], maximums[lane + width]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (lane != 0u) return;
    ulong groups = args.group_count;
    output[group] = long(counts[0]);
    output[groups + group] = as_type<long>(sums[0]);
    output[2ul * groups + group] = counts[0] == 0ul ? 0L : minimums[0];
    output[3ul * groups + group] = counts[0] == 0ul ? 0L : maximums[0];
}

struct EdgeAppendArgs {
    ulong old_count;
    ulong row_count;
};

// Publishes the six query-visible fixed relationship columns in one dispatch. Appended rows are
// already canonical, so copying them through six complete host vectors only adds bandwidth and a
// second full-size allocation. Revisions remain in the canonical paged host backing because no
// resident query kernel reads them.
kernel void ig_edge_append(
    device const long* old_ids [[buffer(0)]],
    device const uint* old_sources [[buffer(1)]],
    device const uint* old_targets [[buffer(2)]],
    device const long* old_types [[buffer(3)]],
    device const uchar* old_layers [[buffer(4)]],
    device const uchar* old_active [[buffer(5)]],
    device const long* appended_ids [[buffer(6)]],
    device const uint* appended_sources [[buffer(7)]],
    device const uint* appended_targets [[buffer(8)]],
    device const long* appended_types [[buffer(9)]],
    device const uchar* appended_layers [[buffer(10)]],
    device const uchar* appended_active [[buffer(11)]],
    device long* output_ids [[buffer(12)]],
    device uint* output_sources [[buffer(13)]],
    device uint* output_targets [[buffer(14)]],
    device long* output_types [[buffer(15)]],
    device uchar* output_layers [[buffer(16)]],
    device uchar* output_active [[buffer(17)]],
    constant EdgeAppendArgs& args [[buffer(18)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count) return;
    if (ulong(row) < args.old_count) {
        output_ids[row] = old_ids[row];
        output_sources[row] = old_sources[row];
        output_targets[row] = old_targets[row];
        output_types[row] = old_types[row];
        output_layers[row] = old_layers[row];
        output_active[row] = old_active[row];
        return;
    }
    ulong appended = ulong(row) - args.old_count;
    output_ids[row] = appended_ids[appended];
    output_sources[row] = appended_sources[appended];
    output_targets[row] = appended_targets[appended];
    output_types[row] = appended_types[appended];
    output_layers[row] = appended_layers[appended];
    output_active[row] = appended_active[appended];
}

// Stable mask compaction in three bounded passes. The prior host composition implemented the
// same prefix operation as log2(N) whole-column tensor generations. Here each 256-row block scans
// in threadgroup memory, one bounded lane computes the few block offsets, and the final pass
// scatters dense row ordinals in their original order.
kernel void ig_stable_selection_local_scan(
    device const uchar* mask [[buffer(0)]],
    device uint* local_prefix [[buffer(1)]],
    device uint* block_offsets [[buffer(2)]],
    constant StableSelectionArgs& args [[buffer(3)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup uint scan[IG_SORT_THREADS];
    ulong row = ulong(block) * IG_SORT_THREADS + lane;
    scan[lane] = row < args.row_count && mask[row] != 0 ? 1u : 0u;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint offset = 1u; offset < IG_SORT_THREADS; offset <<= 1u) {
        uint prior = lane >= offset ? scan[lane - offset] : 0u;
        threadgroup_barrier(mem_flags::mem_threadgroup);
        scan[lane] += prior;
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (row < args.row_count) local_prefix[row] = scan[lane];
    if (lane + 1u == IG_SORT_THREADS) block_offsets[block] = scan[lane];
}

kernel void ig_stable_selection_block_offsets(
    device uint* block_offsets [[buffer(0)]],
    device uint* output [[buffer(1)]],
    constant StableSelectionArgs& args [[buffer(2)]],
    uint lane [[thread_position_in_grid]]) {
    if (lane != 0u) return;
    uint total = 0u;
    for (ulong block = 0; block < args.block_count; ++block) {
        uint count = block_offsets[block];
        block_offsets[block] = total;
        total += count;
    }
    output[args.row_count] = total;
}

kernel void ig_stable_selection_scatter(
    device const uchar* mask [[buffer(0)]],
    device const uint* local_prefix [[buffer(1)]],
    device const uint* block_offsets [[buffer(2)]],
    device uint* output [[buffer(3)]],
    constant StableSelectionArgs& args [[buffer(4)]],
    uint row [[thread_position_in_grid]]) {
    if (ulong(row) >= args.row_count || mask[row] == 0) return;
    uint block = row / IG_SORT_THREADS;
    uint destination = block_offsets[block] + local_prefix[row] - 1u;
    output[destination] = row;
}

inline ulong ig_sort_key(
    device const uchar* values,
    ulong row,
    uint value_type,
    bool descending) {
    ulong key;
    if (value_type == 0) {
        key = ulong(values[row]);
    } else if (value_type == 1) {
        device const uint* typed = reinterpret_cast<device const uint*>(values);
        key = ulong(typed[row]);
    } else {
        device const long* typed = reinterpret_cast<device const long*>(values);
        key = as_type<ulong>(typed[row]) ^ 0x8000000000000000ul;
    }
    return descending ? ~key : key;
}

inline ushort ig_radix_digit(
    device const uchar* values,
    device const uchar* validity,
    ulong row,
    constant StableRadixArgs& args) {
    bool valid = args.nullable == 0 || validity[row] != 0;
    if (args.nullable != 0 && args.digit_pass == 8) {
        bool first = args.nulls_first != 0;
        return ushort(valid ? (first ? 1 : 0) : (first ? 0 : 1));
    }
    if (!valid) return 0;
    ulong key = ig_sort_key(values, row, args.value_type, args.descending != 0);
    return ushort((key >> (args.digit_pass * 8)) & 0xfful);
}

kernel void ig_stable_radix_histogram(
    device const uchar* values [[buffer(0)]],
    device const uchar* validity [[buffer(1)]],
    device const long* input_positions [[buffer(2)]],
    device uint* histograms [[buffer(3)]],
    constant StableRadixArgs& args [[buffer(4)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup atomic_uint counts[IG_SORT_RADIX];
    atomic_store_explicit(&counts[lane], 0, memory_order_relaxed);
    threadgroup_barrier(mem_flags::mem_threadgroup);

    ulong base = ulong(block) * IG_SORT_TILE_ROWS;
    for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
        ulong row = base + local;
        if (row < args.row_count) {
            ushort digit = ig_radix_digit(
                values, validity, as_type<ulong>(input_positions[row]), args);
            atomic_fetch_add_explicit(&counts[digit], 1, memory_order_relaxed);
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    histograms[block * IG_SORT_RADIX + lane] =
        atomic_load_explicit(&counts[lane], memory_order_relaxed);
}

kernel void ig_stable_radix_offsets(
    device const uint* histograms [[buffer(0)]],
    device ulong* offsets [[buffer(1)]],
    constant StableRadixArgs& args [[buffer(2)]],
    uint digit [[thread_index_in_threadgroup]]) {
    threadgroup ulong inclusive[IG_SORT_RADIX];
    ulong total = 0ul;
    for (ulong block = 0ul; block < args.block_count; ++block) {
        total += histograms[block * IG_SORT_RADIX + digit];
    }
    inclusive[digit] = total;
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint distance = 1; distance < IG_SORT_RADIX; distance <<= 1) {
        ulong addend = digit >= distance ? inclusive[digit - distance] : 0ul;
        threadgroup_barrier(mem_flags::mem_threadgroup);
        inclusive[digit] += addend;
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    ulong running = digit == 0 ? 0ul : inclusive[digit - 1];
    for (ulong block = 0ul; block < args.block_count; ++block) {
        ulong index = block * IG_SORT_RADIX + ulong(digit);
        offsets[index] = running;
        running += histograms[index];
    }
}

inline bool ig_digit_pair_greater(
    ushort left_digit,
    ushort left_local,
    ushort right_digit,
    ushort right_local) {
    return left_digit > right_digit
        || (left_digit == right_digit && left_local > right_local);
}

kernel void ig_stable_radix_scatter(
    device const uchar* values [[buffer(0)]],
    device const uchar* validity [[buffer(1)]],
    device const long* input_positions [[buffer(2)]],
    device const ulong* offsets [[buffer(3)]],
    device long* output_positions [[buffer(4)]],
    constant StableRadixArgs& args [[buffer(5)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup ushort digits[IG_SORT_TILE_ROWS];
    threadgroup ushort locals[IG_SORT_TILE_ROWS];
    ulong base = ulong(block) * IG_SORT_TILE_ROWS;

    for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
        ulong row = base + local;
        digits[local] = row < args.row_count
            ? ig_radix_digit(
                values, validity, as_type<ulong>(input_positions[row]), args)
            : ushort(IG_SORT_RADIX);
        locals[local] = ushort(local);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint width = 2; width <= IG_SORT_TILE_ROWS; width <<= 1) {
        for (uint stride = width >> 1; stride != 0; stride >>= 1) {
            for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
                uint partner = local ^ stride;
                if (partner > local) {
                    ushort left_digit = digits[local];
                    ushort left_local = locals[local];
                    ushort right_digit = digits[partner];
                    ushort right_local = locals[partner];
                    bool greater = ig_digit_pair_greater(
                        left_digit, left_local, right_digit, right_local);
                    bool less = ig_digit_pair_greater(
                        right_digit, right_local, left_digit, left_local);
                    bool ascending = (local & width) == 0;
                    if ((ascending && greater) || (!ascending && less)) {
                        digits[local] = right_digit;
                        locals[local] = right_local;
                        digits[partner] = left_digit;
                        locals[partner] = left_local;
                    }
                }
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
        }
    }

    for (uint sorted = lane; sorted < IG_SORT_TILE_ROWS; sorted += IG_SORT_THREADS) {
        ushort digit = digits[sorted];
        if (digit < IG_SORT_RADIX) {
            uint low = 0;
            uint high = sorted;
            while (low < high) {
                uint middle = low + ((high - low) >> 1);
                if (digits[middle] < digit) {
                    low = middle + 1;
                } else {
                    high = middle;
                }
            }
            ulong destination = offsets[ulong(block) * IG_SORT_RADIX + digit]
                + ulong(sorted - low);
            output_positions[destination] = input_positions[base + locals[sorted]];
        }
    }
}

inline ushort ig_encoded_radix_digit(
    device const uint* offsets,
    device const uchar* digits,
    device const uchar* validity,
    ulong row,
    constant StableRadixArgs& args) {
    bool valid = validity[row] != 0;
    uint width = args.value_type;
    if (args.digit_pass == width) {
        bool first = args.nulls_first != 0;
        return ushort(valid ? (first ? 1 : 0) : (first ? 0 : 1));
    }
    if (!valid) return 0;
    uint start = offsets[row];
    uint end = offsets[row + 1];
    uint encoded_index = width - 1 - args.digit_pass;
    ushort digit = encoded_index < end - start ? ushort(digits[start + encoded_index]) : 0;
    return args.descending != 0 ? ushort(255 - digit) : digit;
}

kernel void ig_stable_encoded_radix_histogram(
    device const uint* offsets [[buffer(0)]],
    device const uchar* digits [[buffer(1)]],
    device const uchar* validity [[buffer(2)]],
    device const long* input_positions [[buffer(3)]],
    device uint* histograms [[buffer(4)]],
    constant StableRadixArgs& args [[buffer(5)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup atomic_uint counts[IG_SORT_RADIX];
    atomic_store_explicit(&counts[lane], 0, memory_order_relaxed);
    threadgroup_barrier(mem_flags::mem_threadgroup);

    ulong base = ulong(block) * IG_SORT_TILE_ROWS;
    for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
        ulong position = base + local;
        if (position < args.row_count) {
            ulong row = as_type<ulong>(input_positions[position]);
            ushort digit = ig_encoded_radix_digit(offsets, digits, validity, row, args);
            atomic_fetch_add_explicit(&counts[digit], 1, memory_order_relaxed);
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    histograms[block * IG_SORT_RADIX + lane] =
        atomic_load_explicit(&counts[lane], memory_order_relaxed);
}

kernel void ig_stable_encoded_radix_scatter(
    device const uint* offsets [[buffer(0)]],
    device const uchar* digits [[buffer(1)]],
    device const uchar* validity [[buffer(2)]],
    device const long* input_positions [[buffer(3)]],
    device const ulong* radix_offsets [[buffer(4)]],
    device long* output_positions [[buffer(5)]],
    constant StableRadixArgs& args [[buffer(6)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup ushort block_digits[IG_SORT_TILE_ROWS];
    threadgroup ushort locals[IG_SORT_TILE_ROWS];
    ulong base = ulong(block) * IG_SORT_TILE_ROWS;

    for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
        ulong position = base + local;
        block_digits[local] = position < args.row_count
            ? ig_encoded_radix_digit(
                offsets, digits, validity,
                as_type<ulong>(input_positions[position]), args)
            : ushort(IG_SORT_RADIX);
        locals[local] = ushort(local);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint width = 2; width <= IG_SORT_TILE_ROWS; width <<= 1) {
        for (uint stride = width >> 1; stride != 0; stride >>= 1) {
            for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
                uint partner = local ^ stride;
                if (partner > local) {
                    ushort left_digit = block_digits[local];
                    ushort left_local = locals[local];
                    ushort right_digit = block_digits[partner];
                    ushort right_local = locals[partner];
                    bool greater = ig_digit_pair_greater(
                        left_digit, left_local, right_digit, right_local);
                    bool less = ig_digit_pair_greater(
                        right_digit, right_local, left_digit, left_local);
                    bool ascending = (local & width) == 0;
                    if ((ascending && greater) || (!ascending && less)) {
                        block_digits[local] = right_digit;
                        locals[local] = right_local;
                        block_digits[partner] = left_digit;
                        locals[partner] = left_local;
                    }
                }
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
        }
    }

    for (uint sorted = lane; sorted < IG_SORT_TILE_ROWS; sorted += IG_SORT_THREADS) {
        ushort digit = block_digits[sorted];
        if (digit < IG_SORT_RADIX) {
            uint low = 0;
            uint high = sorted;
            while (low < high) {
                uint middle = low + ((high - low) >> 1);
                if (block_digits[middle] < digit) {
                    low = middle + 1;
                } else {
                    high = middle;
                }
            }
            ulong destination = radix_offsets[ulong(block) * IG_SORT_RADIX + digit]
                + ulong(sorted - low);
            output_positions[destination] = input_positions[base + locals[sorted]];
        }
    }
}

inline bool ig_top_key_greater(
    ushort left_category,
    ulong left_key,
    ulong left_position,
    ushort right_category,
    ulong right_key,
    ulong right_position) {
    return left_category > right_category
        || (left_category == right_category && left_key > right_key)
        || (left_category == right_category && left_key == right_key
            && left_position > right_position);
}

kernel void ig_stable_i64_top_k(
    device const long* values [[buffer(0)]],
    device const uchar* validity [[buffer(1)]],
    device const long* candidates [[buffer(2)]],
    device long* output [[buffer(3)]],
    constant StableTopKArgs& args [[buffer(4)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup ushort categories[IG_SORT_TILE_ROWS];
    threadgroup ulong keys[IG_SORT_TILE_ROWS];
    threadgroup ulong positions[IG_SORT_TILE_ROWS];
    ulong base = ulong(block) * IG_SORT_TILE_ROWS;

    for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
        ulong candidate_row = base + local;
        if (candidate_row < args.candidate_count) {
            ulong position = as_type<ulong>(candidates[candidate_row]);
            bool valid = validity[position] != 0;
            categories[local] = ushort(valid
                ? (args.nulls_first != 0 ? 1 : 0)
                : (args.nulls_first != 0 ? 0 : 1));
            ulong key = valid
                ? (as_type<ulong>(values[position]) ^ 0x8000000000000000ul)
                : 0;
            keys[local] = args.descending != 0 && valid ? ~key : key;
            positions[local] = position;
        } else {
            categories[local] = 2;
            keys[local] = ulong(-1);
            positions[local] = ulong(-1);
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint width = 2; width <= IG_SORT_TILE_ROWS; width <<= 1) {
        for (uint stride = width >> 1; stride != 0; stride >>= 1) {
            for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
                uint partner = local ^ stride;
                if (partner > local) {
                    ushort left_category = categories[local];
                    ulong left_key = keys[local];
                    ulong left_position = positions[local];
                    ushort right_category = categories[partner];
                    ulong right_key = keys[partner];
                    ulong right_position = positions[partner];
                    bool greater = ig_top_key_greater(
                        left_category,
                        left_key,
                        left_position,
                        right_category,
                        right_key,
                        right_position);
                    bool less = ig_top_key_greater(
                        right_category,
                        right_key,
                        right_position,
                        left_category,
                        left_key,
                        left_position);
                    bool ascending = (local & width) == 0;
                    if ((ascending && greater) || (!ascending && less)) {
                        categories[local] = right_category;
                        keys[local] = right_key;
                        positions[local] = right_position;
                        categories[partner] = left_category;
                        keys[partner] = left_key;
                        positions[partner] = left_position;
                    }
                }
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
        }
    }

    uint active = uint(min(ulong(IG_SORT_TILE_ROWS), args.candidate_count - base));
    uint keep = min(active, args.limit);
    ulong output_base = ulong(block) * ulong(args.limit);
    for (uint local = lane; local < keep; local += IG_SORT_THREADS) {
        output[output_base + ulong(local)] = as_type<long>(positions[local]);
    }
}

// One-block stable top-k for the model runtime's bounded graph-element score vectors. Converting
// IEEE F32 bits to an unsigned monotonic key lets the same deterministic bitonic ordering handle
// negative scores without host readback or a many-command tensor sorting network.
kernel void ig_stable_f32_top_k(
    device const float* values [[buffer(0)]],
    device uint* output [[buffer(1)]],
    constant StableF32TopKArgs& args [[buffer(2)]],
    uint lane [[thread_index_in_threadgroup]]) {
    threadgroup ushort categories[IG_SORT_TILE_ROWS];
    threadgroup uint keys[IG_SORT_TILE_ROWS];
    threadgroup uint positions[IG_SORT_TILE_ROWS];

    for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
        if (ulong(local) < args.row_count) {
            uint bits = as_type<uint>(values[local]);
            uint ordered = (bits & 0x80000000u) != 0u ? ~bits : (bits ^ 0x80000000u);
            categories[local] = 0;
            keys[local] = args.descending != 0u ? ~ordered : ordered;
            positions[local] = local;
        } else {
            categories[local] = 1;
            keys[local] = 0xffffffffu;
            positions[local] = 0xffffffffu;
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint width = 2; width <= IG_SORT_TILE_ROWS; width <<= 1) {
        for (uint stride = width >> 1; stride != 0; stride >>= 1) {
            for (uint local = lane; local < IG_SORT_TILE_ROWS; local += IG_SORT_THREADS) {
                uint partner = local ^ stride;
                if (partner > local) {
                    ushort left_category = categories[local];
                    uint left_key = keys[local];
                    uint left_position = positions[local];
                    ushort right_category = categories[partner];
                    uint right_key = keys[partner];
                    uint right_position = positions[partner];
                    bool greater = left_category > right_category
                        || (left_category == right_category && left_key > right_key)
                        || (left_category == right_category && left_key == right_key
                            && left_position > right_position);
                    bool less = left_category < right_category
                        || (left_category == right_category && left_key < right_key)
                        || (left_category == right_category && left_key == right_key
                            && left_position < right_position);
                    bool ascending = (local & width) == 0;
                    if ((ascending && greater) || (!ascending && less)) {
                        categories[local] = right_category;
                        keys[local] = right_key;
                        positions[local] = right_position;
                        categories[partner] = left_category;
                        keys[partner] = left_key;
                        positions[partner] = left_position;
                    }
                }
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
        }
    }
    for (uint local = lane; local < args.limit; local += IG_SORT_THREADS) {
        output[local] = positions[local];
    }
}

// Device-resident composition of a complete nullable relationship relation into
// `GROUP BY relationship IS NULL, count(*)`. The nullable packet is never decoded between these
// three dispatches. Tiles retain only two counts and two first-row positions, so work and scratch
// scale with the actual admitted row domain without materializing a second typed input relation.
constant ulong IG_SEGMENTED_NULLABLE_COUNT_MAGIC = 0x47534e554c434e54ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_VERSION = 1ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_HEADER_WORDS = 16ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_CELL_WORDS = 3ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_MAX_CELLS = 4ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_RECEIPT_WORDS = 7ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_RECEIPTS = 3ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_OUTPUT_WORDS = 49ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_TILE_ROWS = 256ul;
constant ulong IG_SEGMENTED_NULLABLE_COUNT_TILE_WORDS = 4ul;
constant uint IG_SEGMENTED_NULLABLE_COUNT_READY = 1u;
constant uint IG_SEGMENTED_NULLABLE_COUNT_CORRUPT = 2u;
constant uint IG_SEGMENTED_NULLABLE_COUNT_CAPACITY = 3u;
constant uint IG_SEGMENTED_NULLABLE_COUNT_INVALID_ROW = 4u;

struct IgSegmentedNullableCountArgs {
    ulong nullable_word_count;
    ulong nullable_execution_high;
    ulong nullable_execution_low;
    ulong project_high;
    ulong project_low;
    ulong bookmark_term;
    ulong bookmark_index;
    ulong graph_revision;
    ulong layout_version;
    ulong catalog_0;
    ulong catalog_1;
    ulong catalog_2;
    ulong catalog_3;
    ulong nullable_fingerprint_0;
    ulong nullable_fingerprint_1;
    ulong nullable_fingerprint_2;
    ulong nullable_fingerprint_3;
    ulong nullable_scratch_bytes;
    ulong nullable_stage_count;
    ulong nullable_receipt_count;
    ulong nullable_program_words;
    ulong nullable_graph_words;
    ulong nullable_final_row_capacity;
    ulong nullable_binding_slots;
    ulong relationship_descriptor_word;
    ulong relationship_slot;
    ulong relationship_row_base_bytes;
    ulong relationship_row_end_bytes;
    ulong relationship_domain_rows;
    ulong outer_execution_high;
    ulong outer_execution_low;
    ulong outer_fingerprint_0;
    ulong outer_fingerprint_1;
    ulong outer_fingerprint_2;
    ulong outer_fingerprint_3;
    ulong maximum_intermediate_rows;
    ulong maximum_output_groups;
    ulong maximum_output_cells;
    ulong output_count_column;
    ulong output_boolean_column;
    ulong source_obligation_id;
    ulong source_obligation_metadata;
    ulong aggregate_obligation_id;
    ulong aggregate_obligation_metadata;
    ulong reduction_obligation_id;
    ulong reduction_obligation_metadata;
    ulong tile_count;
    ulong output_word_count;
};

inline void ig_segmented_nullable_count_fail(
    device atomic_uint* control,
    uint status) {
    uint expected = IG_SEGMENTED_NULLABLE_COUNT_READY;
    while (expected == IG_SEGMENTED_NULLABLE_COUNT_READY
        && !atomic_compare_exchange_weak_explicit(
            control,
            &expected,
            status,
            memory_order_relaxed,
            memory_order_relaxed)) {
    }
}

kernel void ig_segmented_nullable_count_initialize(
    device const ulong* nullable [[buffer(0)]],
    device ulong* output [[buffer(1)]],
    device ulong* tiles [[buffer(2)]],
    device atomic_uint* control [[buffer(3)]],
    constant IgSegmentedNullableCountArgs& args [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    for (ulong word = 0ul; word < IG_SEGMENTED_NULLABLE_COUNT_OUTPUT_WORDS; ++word) {
        output[word] = 0ul;
    }
    output[0] = IG_SEGMENTED_NULLABLE_COUNT_MAGIC;
    output[1] = IG_SEGMENTED_NULLABLE_COUNT_VERSION;
    output[2] = IG_SEGMENTED_NULLABLE_COUNT_CORRUPT;
    output[3] = args.outer_execution_high;
    output[4] = args.outer_execution_low;
    output[5] = args.outer_fingerprint_0;
    output[6] = args.outer_fingerprint_1;
    output[7] = args.outer_fingerprint_2;
    output[8] = args.outer_fingerprint_3;
    output[11] = 2ul;
    output[13] = args.maximum_output_groups;
    output[14] = args.maximum_output_cells;
    output[15] = args.output_word_count;
    atomic_store_explicit(control, IG_SEGMENTED_NULLABLE_COUNT_CORRUPT, memory_order_relaxed);

    ulong descriptor_end = args.relationship_descriptor_word
        + IG_NULLABLE_RELATION_COLUMN_WORDS;
    ulong row_bytes = args.nullable_final_row_capacity * 4ul;
    bool row_layout_valid = args.relationship_row_base_bytes + row_bytes
            >= args.relationship_row_base_bytes
        && args.relationship_row_base_bytes + row_bytes
            == args.relationship_row_end_bytes
        && args.relationship_row_end_bytes <= args.nullable_word_count * 8ul;
    ulong expected_tiles = (max(1ul, args.nullable_final_row_capacity)
        + IG_SEGMENTED_NULLABLE_COUNT_TILE_ROWS - 1ul)
        / IG_SEGMENTED_NULLABLE_COUNT_TILE_ROWS;
    bool valid = args.nullable_word_count >= IG_NULLABLE_RELATION_HEADER_WORDS
        && args.output_word_count == IG_SEGMENTED_NULLABLE_COUNT_OUTPUT_WORDS
        && args.tile_count == expected_tiles
        && args.tile_count != 0ul
        && args.nullable_final_row_capacity != 0ul
        && args.nullable_final_row_capacity <= args.maximum_intermediate_rows
        && args.maximum_output_groups != 0ul
        && args.maximum_output_groups <= 2ul
        && args.maximum_output_cells >= args.maximum_output_groups * 2ul
        && args.output_count_column <= 1ul
        && args.output_boolean_column <= 1ul
        && args.output_count_column != args.output_boolean_column
        && args.source_obligation_id != 0ul
        && args.aggregate_obligation_id != 0ul
        && args.reduction_obligation_id != 0ul
        && descriptor_end >= args.relationship_descriptor_word
        && descriptor_end <= args.nullable_word_count
        && row_layout_valid
        && nullable[0] == IG_NULLABLE_RELATION_MAGIC
        && nullable[1] == 1ul
        && nullable[2] == args.nullable_execution_high
        && nullable[3] == args.nullable_execution_low
        && nullable[4] == args.project_high
        && nullable[5] == args.project_low
        && nullable[6] == args.bookmark_term
        && nullable[7] == args.bookmark_index
        && nullable[8] == args.graph_revision
        && nullable[9] == args.layout_version
        && nullable[10] == args.catalog_0
        && nullable[11] == args.catalog_1
        && nullable[12] == args.catalog_2
        && nullable[13] == args.catalog_3
        && nullable[14] == args.nullable_fingerprint_0
        && nullable[15] == args.nullable_fingerprint_1
        && nullable[16] == args.nullable_fingerprint_2
        && nullable[17] == args.nullable_fingerprint_3
        && nullable[18] == 2ul
        && nullable[19] == args.nullable_stage_count
        && nullable[20] == args.nullable_receipt_count
        && nullable[21] <= args.nullable_final_row_capacity
        && nullable[21] <= args.maximum_intermediate_rows
        && nullable[22] == 1ul
        && nullable[23] == args.nullable_scratch_bytes
        && nullable[24] == args.nullable_word_count
        && nullable[26] == args.nullable_final_row_capacity
        && nullable[27] == args.nullable_binding_slots
        && nullable[28] == args.nullable_program_words
        && nullable[29] == args.nullable_graph_words
        && nullable[30] == IG_NULLABLE_RELATION_VERSION
        && nullable[31] == 0ul;
    if (valid) {
        ulong descriptor = args.relationship_descriptor_word;
        valid = nullable[descriptor] == args.relationship_slot
            && nullable[descriptor + 1ul] == 2ul
            && nullable[descriptor + 2ul] == IG_NULLABLE_OUTPUT_ENTITY
            && nullable[descriptor + 3ul] == ulong(-1)
            && nullable[descriptor + 4ul] == 0ul
            && nullable[descriptor + 5ul] == args.relationship_row_base_bytes
            && nullable[descriptor + 6ul] == ulong(-1)
            && nullable[descriptor + 7ul] == ulong(-1)
            && nullable[descriptor + 8ul] == ulong(-1)
            && nullable[descriptor + 9ul] == args.relationship_row_end_bytes;
    }
    if (valid) {
        atomic_store_explicit(control, IG_SEGMENTED_NULLABLE_COUNT_READY, memory_order_relaxed);
    }
    (void)tiles;
}

kernel void ig_segmented_nullable_count_tiles(
    device const ulong* nullable [[buffer(0)]],
    device ulong* output [[buffer(1)]],
    device ulong* tiles [[buffer(2)]],
    device atomic_uint* control [[buffer(3)]],
    constant IgSegmentedNullableCountArgs& args [[buffer(4)]],
    uint tile [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    if (atomic_load_explicit(control, memory_order_relaxed)
            != IG_SEGMENTED_NULLABLE_COUNT_READY) return;
    threadgroup atomic_uint counts[2];
    threadgroup atomic_uint first_rows[2];
    if (lane < 2u) {
        atomic_store_explicit(&counts[lane], 0u, memory_order_relaxed);
        atomic_store_explicit(&first_rows[lane], uint(-1), memory_order_relaxed);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    ulong row = ulong(tile) * IG_SEGMENTED_NULLABLE_COUNT_TILE_ROWS + ulong(lane);
    ulong row_count = nullable[21];
    if (row < row_count) {
        device const uchar* packet_bytes = reinterpret_cast<device const uchar*>(nullable);
        device const uint* rows = reinterpret_cast<device const uint*>(
            packet_bytes + args.relationship_row_base_bytes);
        uint dense = rows[row];
        bool is_null = dense == uint(IG_NULLABLE_RELATION_NULL_ROW);
        if (!is_null && ulong(dense) >= args.relationship_domain_rows) {
            ig_segmented_nullable_count_fail(
                control,
                IG_SEGMENTED_NULLABLE_COUNT_INVALID_ROW);
        } else {
            uint group = is_null ? 1u : 0u;
            atomic_fetch_add_explicit(&counts[group], 1u, memory_order_relaxed);
            atomic_fetch_min_explicit(
                &first_rows[group], uint(row), memory_order_relaxed);
        }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (lane == 0u) {
        ulong base = ulong(tile) * IG_SEGMENTED_NULLABLE_COUNT_TILE_WORDS;
        tiles[base] = ulong(atomic_load_explicit(&counts[0], memory_order_relaxed));
        tiles[base + 1ul] = ulong(atomic_load_explicit(&counts[1], memory_order_relaxed));
        tiles[base + 2ul] = ulong(
            atomic_load_explicit(&first_rows[0], memory_order_relaxed));
        tiles[base + 3ul] = ulong(
            atomic_load_explicit(&first_rows[1], memory_order_relaxed));
    }
    (void)output;
}

inline void ig_segmented_nullable_count_cell(
    device ulong* output,
    ulong row,
    ulong column,
    ulong tag,
    ulong payload) {
    ulong cell = IG_SEGMENTED_NULLABLE_COUNT_HEADER_WORDS
        + (row * 2ul + column) * IG_SEGMENTED_NULLABLE_COUNT_CELL_WORDS;
    output[cell] = tag;
    output[cell + 1ul] = payload;
    output[cell + 2ul] = 0ul;
}

inline void ig_segmented_nullable_count_receipt(
    device ulong* output,
    constant IgSegmentedNullableCountArgs& args,
    ulong receipt,
    ulong obligation,
    ulong metadata,
    ulong input_rows,
    ulong output_rows) {
    ulong base = IG_SEGMENTED_NULLABLE_COUNT_HEADER_WORDS
        + IG_SEGMENTED_NULLABLE_COUNT_MAX_CELLS
            * IG_SEGMENTED_NULLABLE_COUNT_CELL_WORDS
        + receipt * IG_SEGMENTED_NULLABLE_COUNT_RECEIPT_WORDS;
    output[base] = args.outer_execution_high;
    output[base + 1ul] = args.outer_execution_low;
    output[base + 2ul] = obligation;
    output[base + 3ul] = metadata;
    output[base + 4ul] = input_rows;
    output[base + 5ul] = output_rows;
    output[base + 6ul] = 2ul;
}

kernel void ig_segmented_nullable_count_finalize(
    device const ulong* nullable [[buffer(0)]],
    device ulong* output [[buffer(1)]],
    device ulong* tiles [[buffer(2)]],
    device atomic_uint* control [[buffer(3)]],
    constant IgSegmentedNullableCountArgs& args [[buffer(4)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;
    uint status = atomic_load_explicit(control, memory_order_relaxed);
    if (status != IG_SEGMENTED_NULLABLE_COUNT_READY) {
        output[2] = ulong(status);
        return;
    }
    ulong counts[2] = {0ul, 0ul};
    ulong first_rows[2] = {ulong(-1), ulong(-1)};
    for (ulong tile = 0ul; tile < args.tile_count; ++tile) {
        ulong base = tile * IG_SEGMENTED_NULLABLE_COUNT_TILE_WORDS;
        counts[0] += tiles[base];
        counts[1] += tiles[base + 1ul];
        first_rows[0] = min(first_rows[0], tiles[base + 2ul]);
        first_rows[1] = min(first_rows[1], tiles[base + 3ul]);
    }
    ulong source_rows = nullable[21];
    if (counts[0] + counts[1] < counts[0]
        || counts[0] + counts[1] != source_rows) {
        output[2] = IG_SEGMENTED_NULLABLE_COUNT_CORRUPT;
        return;
    }
    ulong groups = (counts[0] != 0ul ? 1ul : 0ul)
        + (counts[1] != 0ul ? 1ul : 0ul);
    ulong cells = groups * 2ul;
    if (groups > args.maximum_output_groups
        || cells > args.maximum_output_cells
        || cells > IG_SEGMENTED_NULLABLE_COUNT_MAX_CELLS) {
        output[2] = IG_SEGMENTED_NULLABLE_COUNT_CAPACITY;
        return;
    }
    output[9] = source_rows;
    output[10] = groups;
    output[12] = cells;

    bool first_is_null = counts[1] != 0ul
        && (counts[0] == 0ul || first_rows[1] < first_rows[0]);
    for (ulong group_row = 0ul; group_row < groups; ++group_row) {
        bool is_null = groups == 1ul
            ? counts[1] != 0ul
            : (group_row == 0ul ? first_is_null : !first_is_null);
        ulong count = counts[is_null ? 1 : 0];
        ig_segmented_nullable_count_cell(
            output,
            group_row,
            args.output_count_column,
            2ul,
            count);
        ig_segmented_nullable_count_cell(
            output,
            group_row,
            args.output_boolean_column,
            1ul,
            is_null ? 1ul : 0ul);
    }
    ig_segmented_nullable_count_receipt(
        output,
        args,
        0ul,
        args.source_obligation_id,
        args.source_obligation_metadata,
        1ul,
        source_rows);
    ig_segmented_nullable_count_receipt(
        output,
        args,
        1ul,
        args.aggregate_obligation_id,
        args.aggregate_obligation_metadata,
        source_rows,
        groups);
    ig_segmented_nullable_count_receipt(
        output,
        args,
        2ul,
        args.reduction_obligation_id,
        args.reduction_obligation_metadata,
        source_rows,
        groups);
    output[2] = IG_SEGMENTED_NULLABLE_COUNT_READY;
}

// Native segmented aggregation, wire ABI version 2.
//
// This is a backend-owned three-dispatch program. The host supplies only the immutable typed
// relation, grouping-column indices, aggregate descriptors, obligations, and admitted capacities.
// In particular, no group IDs, segment offsets, distinct sets, partial reductions, expected rows,
// or host-reduced values cross this ABI. `ig_segmented_aggregation_group_program` discovers stable
// first-seen groups on the device; `ig_segmented_aggregation_reduce_program` evaluates one
// (group, aggregate) pair per thread; `ig_segmented_aggregation_finalize_program` publishes the
// row-major relation, flat collect suffix, exact byte arena, and receipts.
//
// Encode all three dispatches, in the order above, in one Metal command buffer (or otherwise
// preserve command completion order) and bind the same immutable buffers/argument block to every
// phase. Dispatch GROUP and FINALIZE with exactly one thread. Dispatch REDUCE with
// `maximum_output_groups * aggregate_count` threads; inactive capacity lanes return immediately,
// so discovering group_count never requires host readback or a host answer path.
//
// All wire words are native little-endian Metal uint/ulong values. Every logical zero-length
// buffer must still have a valid one-element sentinel binding. Buffers use the same indices in all
// three kernels; a kernel signature mentions only the bindings it consumes:
//   0  device const ulong input_header[13]
//   1  device const ulong input_cells[args.input_cell_count * 3]
//   2  device const uchar input_arena[max(1, args.input_arena_bytes)]
//   3  device const uint grouping_columns[args.grouping_column_count]
//   4  device const uint aggregate_descriptors[args.aggregate_count * 5]
//   5  device ulong receipt_records[args.receipt_record_capacity * 9] (in/out)
//   6  device ulong output_header[13]
//   7  device ulong output_cells[args.output_cell_capacity * 3]
//   8  device uchar output_arena[max(1, args.output_arena_capacity)]
//   9  device atomic_uint control[8]
//   10 device uint row_group_ids[max(1, args.row_group_capacity)]
//   11 device uint group_first_rows[max(1, args.group_first_capacity)]
//   12 device ulong reduction_states[max(1, args.reduction_state_capacity) * 8]
//   13 constant IgSegmentedAggregationArgs (18 consecutive u32 words, 72 bytes)
//
// input_header, thirteen u64 words:
//   [0] ABI word: low32 magic 0x49475341 ("IGSA"), high32 version 2
//   [1] zero
//   [2] ResidentExecutionId.high
//   [3] ResidentExecutionId.low (the pair must not both be zero)
//   [4] low32 input row_count, bits 32..47 input column_count, bits 48..63 zero
//   [5] low32 input cell_count, high32 input arena byte count
//   [6] bits 0..15 grouping-column count, bits 16..31 aggregate count,
//       bits 32..47 receipt count, bits 48..63 zero
//   [7] low32 maximum output groups, high32 maximum output cells
//   [8] low32 maximum output arena bytes, high32 exact execution flags
//   [9..12] four little-endian u64 lanes of ResidentSegmentedAggregationFingerprint([u8; 32])
//
// output_header has the same thirteen-word allocation. [0], [2..3], and [6..12] echo immutable
// input. [1] is low32 IgSegmentedAggregationStatus and high32 phase. [4] is low32 output row_count
// and bits 32..47 output column_count. [5] is low32 exact output cell_count and high32 exact output
// arena bytes used. [4..5] remain zero unless FINALIZE succeeds. Only SUCCESS + COMPLETE permits
// decoding output cells, arena, or receipts.
//
// Each input/output cell is three u64 words:
//   [0] exact tag with all upper bits zero: NULL=0, BOOLEAN=1, INTEGER=2, FLOAT=3, STRING=4,
//       BYTES=5, NODE=6, RELATIONSHIP=7, LIST=8
//   [1] payload: Boolean 0/1; Integer i64 bits; Float finite IEEE-754 f64 bits; String/Bytes
//       arena offset; Node/Relationship stable u64 ID; List absolute appended-cell start
//   [2] auxiliary: String/Bytes byte length; List element count; otherwise zero
// LIST input is admitted only under FLAT_LIST_MIN_MAX for the sealed global one-column, one-
// aggregate, non-DISTINCT MIN/MAX profile. Its top-level rows point into one disjoint, gap-free
// suffix containing only non-NULL Boolean/Integer/Float/String/Bytes children. Nested lists and
// entity children fail closed. STRING input is validated as UTF-8; BYTES is opaque. Non-empty byte
// ranges must be pairwise disjoint and cover the input arena exactly. Output byte ranges are copied
// in CPU-reference publication order and are gap-free with no aliases or hidden bytes. A collect or
// selected-list top-level cell points into one disjoint suffix after every top-level output cell.
//
// One grouping column is one u32 containing an in-bounds u16 column index. Indices are unique and
// remain in projection order. One aggregate descriptor is five u32 words:
//   [0] kind: COUNT_ALL=1, COUNT_VALUE=2, SUM=3, AVERAGE=4, MINIMUM=5, MAXIMUM=6,
//       COLLECT=7, PERCENTILE_DISC=8, PERCENTILE_CONT=9
//   [1] input column (in-bounds u16), or 0xffffffff only for COUNT_ALL
//   [2] DISTINCT flag, exactly 0 or 1 (COUNT_ALL requires zero)
//   [3..4] little-endian finite percentile f64 bits for percentile kinds, otherwise zero
// DISTINCT is evaluated after NULL filtering. Numeric equality/order promotes INTEGER/FLOAT
// exactly without F32 conversion. STRING/BYTES equality and ordering compare every byte. NODE and
// RELATIONSHIP use stable IDs and remain distinct types. MIN/MAX follows the supported slice of
// canonical Cypher total order:
// NODE < RELATIONSHIP < LIST < STRING < BYTES < BOOLEAN < NUMBER < NULL (NULL is filtered first).
// Flat LIST values compare lexicographically by that same child order.
// SUM(empty)=INTEGER 0, AVG(empty)=NULL; INTEGER sums are checked i64 and a first FLOAT promotes the
// accumulated integer sum to software IEEE-754 f64. Float overflow, NaN, or infinity fails closed.
//
// Each receipt record is nine u64 words. The host initializes [0..1] and zeroes [2..8]:
//   [0] non-zero ResidentExecutionObligation.id
//   [1] bits 0..7 kind, bits 8..15 scope tag, bits 16..31 scope index, upper bits zero
//   [2] pending=0 input; completed=1 output
//   [3] execution.high; [4] execution.low; [5] echoed obligation id; [6] echoed metadata
//   [7] low32 input row cardinality, high32 output group cardinality
//   [8] ResidentDeviceCompletion::Metal=2
// Exactly 1 + aggregate_count records are required. Record 0 is
// [Aggregate kind=10, PatternFinal scope=5, index=0]. Record 1+i is
// [Aggregate kind=10, Expression scope=2, index=i]. IDs must be unique. Every record stays pending
// until all output cells and bytes have succeeded; FINALIZE completes all records immediately before
// its final SUCCESS store.
//
// control is eight atomic u32 words, initialized by GROUP and private to this command:
//   [0] internal status (0 while healthy; SUCCESS or terminal status after FINALIZE)
//   [1] phase; [2] discovered group_count; [3] completed reduction count;
//   [4] expected reduction count; [5] final output cell_count; [6] final arena bytes; [7] zero
// reduction_states is eight u64 words per capacity (group-major, then aggregate-major):
//   [0] ready marker; [1] aggregate kind; [2] mode (CELL=0, INPUT_REF=1, COLLECT=2)
//   [3] CELL tag / input-cell index / collect count; [4] CELL payload; [5] CELL auxiliary;
//   [6] qualifying non-null/distinct value count (COUNT_ALL uses group row count); [7] zero
// Host code must treat control, row_group_ids, group_first_rows, and reduction_states as opaque
// device scratch. They are not semantic output and must never be used to synthesize a result.
//
// Correctness-first optimization boundary: reductions for different (group, aggregate) pairs run
// in parallel and all phases are capacity-bounded. Stable first-seen group discovery and final
// variable-width publication are deliberately serial to avoid nondeterministic atomics. DISTINCT
// uses a prior-row semantic scan and group discovery scans prior groups, so adversarial inputs are
// quadratic. Replacing those two scans with device hash/sort phases is a future performance change,
// not permission to accept host segments or host-reduced values.

constant ulong IG_SEGMENTED_AGGREGATION_ABI_WORD = 0x0000000247435341ul;
constant ulong IG_SEGMENTED_REDUCTION_READY = 0x4753524541445931ul;

constant uint IG_SEGMENTED_VALUE_NULL = 0u;
constant uint IG_SEGMENTED_VALUE_BOOLEAN = 1u;
constant uint IG_SEGMENTED_VALUE_INTEGER = 2u;
constant uint IG_SEGMENTED_VALUE_FLOAT = 3u;
constant uint IG_SEGMENTED_VALUE_STRING = 4u;
constant uint IG_SEGMENTED_VALUE_BYTES = 5u;
constant uint IG_SEGMENTED_VALUE_NODE = 6u;
constant uint IG_SEGMENTED_VALUE_RELATIONSHIP = 7u;
constant uint IG_SEGMENTED_VALUE_LIST = 8u;
constant uint IG_SEGMENTED_VALUE_MAP = 9u;

constant uint IG_SEGMENTED_AGGREGATE_COUNT_ALL = 1u;
constant uint IG_SEGMENTED_AGGREGATE_COUNT_VALUE = 2u;
constant uint IG_SEGMENTED_AGGREGATE_SUM = 3u;
constant uint IG_SEGMENTED_AGGREGATE_AVERAGE = 4u;
constant uint IG_SEGMENTED_AGGREGATE_MINIMUM = 5u;
constant uint IG_SEGMENTED_AGGREGATE_MAXIMUM = 6u;
constant uint IG_SEGMENTED_AGGREGATE_COLLECT = 7u;
constant uint IG_SEGMENTED_AGGREGATE_PERCENTILE_DISC = 8u;
constant uint IG_SEGMENTED_AGGREGATE_PERCENTILE_CONT = 9u;
constant ulong IG_SEGMENTED_AGGREGATE_WORDS = 5ul;

constant uint IG_SEGMENTED_STATUS_NOT_EXECUTED = 0u;
constant uint IG_SEGMENTED_STATUS_SUCCESS = 1u;
constant uint IG_SEGMENTED_STATUS_INVALID_HEADER = 2u;
constant uint IG_SEGMENTED_STATUS_INVALID_SHAPE = 3u;
constant uint IG_SEGMENTED_STATUS_INVALID_CELL = 4u;
constant uint IG_SEGMENTED_STATUS_UNSUPPORTED_LIST_INPUT = 5u;
constant uint IG_SEGMENTED_STATUS_INVALID_UTF8 = 6u;
constant uint IG_SEGMENTED_STATUS_INVALID_GROUP_SPEC = 7u;
constant uint IG_SEGMENTED_STATUS_INVALID_AGGREGATE_SPEC = 8u;
constant uint IG_SEGMENTED_STATUS_INVALID_RECEIPT = 9u;
constant uint IG_SEGMENTED_STATUS_GROUP_CAPACITY = 10u;
constant uint IG_SEGMENTED_STATUS_CELL_CAPACITY = 11u;
constant uint IG_SEGMENTED_STATUS_ARENA_CAPACITY = 12u;
constant uint IG_SEGMENTED_STATUS_INTEGER_OVERFLOW = 13u;
constant uint IG_SEGMENTED_STATUS_FLOAT_OVERFLOW = 14u;
constant uint IG_SEGMENTED_STATUS_AGGREGATE_TYPE = 15u;
constant uint IG_SEGMENTED_STATUS_MALFORMED_PACKET = 16u;
constant uint IG_SEGMENTED_STATUS_PHASE_MISMATCH = 17u;
constant uint IG_SEGMENTED_STATUS_REDUCTION_INCOMPLETE = 18u;
constant uint IG_SEGMENTED_STATUS_INTERNAL_BOUNDS = 19u;

constant uint IG_SEGMENTED_PHASE_NOT_STARTED = 0u;
constant uint IG_SEGMENTED_PHASE_GROUPED = 1u;
constant uint IG_SEGMENTED_PHASE_REDUCED = 2u;
constant uint IG_SEGMENTED_PHASE_COMPLETE = 3u;
constant uint IG_SEGMENTED_PHASE_FAILED = 4u;

constant uint IG_SEGMENTED_REDUCTION_CELL = 0u;
constant uint IG_SEGMENTED_REDUCTION_INPUT_REF = 1u;
constant uint IG_SEGMENTED_REDUCTION_COLLECT = 2u;

constant uint IG_SEGMENTED_FLAG_FLAT_LIST_MIN_MAX = 1u;

constant uint IG_SEGMENTED_MAX_COLUMNS = 256u;
constant uint IG_SEGMENTED_MAX_GROUP_KEYS = 32u;
constant uint IG_SEGMENTED_MAX_AGGREGATES = 64u;
constant uint IG_SEGMENTED_MAX_CELLS = 16777216u;
constant uint IG_SEGMENTED_MAX_ARENA_BYTES = 268435456u;

struct IgSegmentedAggregationArgs {
    uint input_row_count;                 // word 0
    uint input_column_count;              // word 1
    uint input_cell_count;                // word 2, exact rows * columns
    uint input_arena_bytes;               // word 3
    uint grouping_column_count;            // word 4
    uint aggregate_count;                  // word 5
    uint receipt_count;                    // word 6, exactly 1 + aggregate_count
    uint maximum_output_groups;            // word 7
    uint maximum_output_cells;             // word 8
    uint maximum_output_arena_bytes;       // word 9
    uint row_group_capacity;               // word 10, u32 entries
    uint group_first_capacity;             // word 11, u32 entries
    uint reduction_state_capacity;         // word 12, eight-u64 records
    uint output_cell_capacity;             // word 13, three-u64 cells
    uint output_arena_capacity;            // word 14, bytes
    uint receipt_record_capacity;          // word 15, nine-u64 records
    uint flags;                             // word 16, exact known flag mask
    uint reserved;                          // word 17, must be zero
};

struct IgSegmentedCellValue {
    uint tag;
    ulong payload;
    ulong auxiliary;
};

inline void ig_segmented_header_status(
    device ulong* output_header,
    uint status,
    uint phase) {
    output_header[1] = ulong(status) | (ulong(phase) << 32u);
}

inline void ig_segmented_initialize_output_header(
    device const ulong* input_header,
    device ulong* output_header) {
    for (uint word = 0u; word < 13u; ++word) output_header[word] = 0ul;
    output_header[0] = input_header[0];
    output_header[2] = input_header[2];
    output_header[3] = input_header[3];
    for (uint word = 6u; word < 13u; ++word) output_header[word] = input_header[word];
    ig_segmented_header_status(
        output_header, IG_SEGMENTED_STATUS_NOT_EXECUTED, IG_SEGMENTED_PHASE_NOT_STARTED);
}

inline void ig_segmented_group_fail(
    device ulong* output_header,
    device atomic_uint* control,
    uint status) {
    atomic_store_explicit(&control[0], status, memory_order_relaxed);
    atomic_store_explicit(&control[1], IG_SEGMENTED_PHASE_FAILED, memory_order_relaxed);
    ig_segmented_header_status(output_header, status, IG_SEGMENTED_PHASE_FAILED);
}

inline void ig_segmented_parallel_error(
    device atomic_uint* control,
    uint status) {
    atomic_fetch_max_explicit(&control[0], status, memory_order_relaxed);
}

inline IgSegmentedCellValue ig_segmented_input_cell(
    device const ulong* input_cells,
    uint index) {
    ulong base = ulong(index) * 3ul;
    IgSegmentedCellValue value;
    value.tag = uint(input_cells[base]);
    value.payload = input_cells[base + 1ul];
    value.auxiliary = input_cells[base + 2ul];
    return value;
}

inline void ig_segmented_write_cell(
    device ulong* output_cells,
    uint index,
    IgSegmentedCellValue value) {
    ulong base = ulong(index) * 3ul;
    output_cells[base] = ulong(value.tag);
    output_cells[base + 1ul] = value.payload;
    output_cells[base + 2ul] = value.auxiliary;
}

inline IgSegmentedCellValue ig_segmented_null_cell() {
    IgSegmentedCellValue value;
    value.tag = IG_SEGMENTED_VALUE_NULL;
    value.payload = 0ul;
    value.auxiliary = 0ul;
    return value;
}

inline bool ig_segmented_range(uint start, uint length, uint capacity) {
    return start <= capacity && length <= capacity - start;
}

inline bool ig_segmented_f64_finite(ulong bits) {
    return !ig_scalar_program_f64_is_nan(bits)
        && !ig_scalar_program_f64_is_infinite(bits);
}

inline bool ig_segmented_percentile_valid(ulong bits) {
    ulong magnitude = bits & 0x7ffffffffffffffful;
    if (magnitude == 0ul) return true;
    return (bits >> 63) == 0ul
        && ig_segmented_f64_finite(bits)
        && bits <= 0x3ff0000000000000ul;
}

inline bool ig_segmented_utf8(
    device const uchar* bytes,
    uint start,
    uint length) {
    uint cursor = 0u;
    while (cursor < length) {
        uint first = uint(bytes[start + cursor]);
        if (first <= 0x7fu) {
            ++cursor;
            continue;
        }
        if (first >= 0xc2u && first <= 0xdfu) {
            if (cursor + 1u >= length) return false;
            uint second = uint(bytes[start + cursor + 1u]);
            if (second < 0x80u || second > 0xbfu) return false;
            cursor += 2u;
            continue;
        }
        if (first >= 0xe0u && first <= 0xefu) {
            if (cursor + 2u >= length) return false;
            uint second = uint(bytes[start + cursor + 1u]);
            uint third = uint(bytes[start + cursor + 2u]);
            bool second_valid = second >= 0x80u && second <= 0xbfu;
            if (first == 0xe0u) second_valid = second >= 0xa0u && second <= 0xbfu;
            if (first == 0xedu) second_valid = second >= 0x80u && second <= 0x9fu;
            if (!second_valid || third < 0x80u || third > 0xbfu) return false;
            cursor += 3u;
            continue;
        }
        if (first >= 0xf0u && first <= 0xf4u) {
            if (cursor + 3u >= length) return false;
            uint second = uint(bytes[start + cursor + 1u]);
            uint third = uint(bytes[start + cursor + 2u]);
            uint fourth = uint(bytes[start + cursor + 3u]);
            bool second_valid = second >= 0x80u && second <= 0xbfu;
            if (first == 0xf0u) second_valid = second >= 0x90u && second <= 0xbfu;
            if (first == 0xf4u) second_valid = second >= 0x80u && second <= 0x8fu;
            if (!second_valid || third < 0x80u || third > 0xbfu
                    || fourth < 0x80u || fourth > 0xbfu) return false;
            cursor += 4u;
            continue;
        }
        return false;
    }
    return true;
}

inline bool ig_segmented_bytes_equal(
    device const uchar* input_arena,
    IgSegmentedCellValue left,
    IgSegmentedCellValue right) {
    if (left.auxiliary != right.auxiliary) return false;
    uint length = uint(left.auxiliary);
    uint left_start = uint(left.payload);
    uint right_start = uint(right.payload);
    for (uint byte = 0u; byte < length; ++byte) {
        if (input_arena[left_start + byte] != input_arena[right_start + byte]) return false;
    }
    return true;
}

inline bool ig_segmented_values_equal(
    device const uchar* input_arena,
    IgSegmentedCellValue left,
    IgSegmentedCellValue right) {
    bool left_numeric = left.tag == IG_SEGMENTED_VALUE_INTEGER
        || left.tag == IG_SEGMENTED_VALUE_FLOAT;
    bool right_numeric = right.tag == IG_SEGMENTED_VALUE_INTEGER
        || right.tag == IG_SEGMENTED_VALUE_FLOAT;
    if (left_numeric && right_numeric) {
        if (left.tag == IG_SEGMENTED_VALUE_INTEGER
                && right.tag == IG_SEGMENTED_VALUE_INTEGER) {
            return left.payload == right.payload;
        }
        if (left.tag == IG_SEGMENTED_VALUE_FLOAT
                && right.tag == IG_SEGMENTED_VALUE_FLOAT) {
            return ig_scalar_f64_equal(left.payload, right.payload);
        }
        if (left.tag == IG_SEGMENTED_VALUE_INTEGER) {
            return ig_scalar_i64_f64_equal(as_type<long>(left.payload), right.payload);
        }
        return ig_scalar_i64_f64_equal(as_type<long>(right.payload), left.payload);
    }
    if (left.tag != right.tag) return false;
    if (left.tag == IG_SEGMENTED_VALUE_NULL) return true;
    if (left.tag == IG_SEGMENTED_VALUE_STRING || left.tag == IG_SEGMENTED_VALUE_BYTES) {
        return ig_segmented_bytes_equal(input_arena, left, right);
    }
    return left.payload == right.payload;
}

inline uint ig_segmented_key_rank(uint tag) {
    if (tag == IG_SEGMENTED_VALUE_NODE) return 0u;
    if (tag == IG_SEGMENTED_VALUE_RELATIONSHIP) return 1u;
    if (tag == IG_SEGMENTED_VALUE_LIST) return 2u;
    if (tag == IG_SEGMENTED_VALUE_STRING) return 4u;
    if (tag == IG_SEGMENTED_VALUE_BYTES) return 5u;
    if (tag == IG_SEGMENTED_VALUE_BOOLEAN) return 6u;
    if (tag == IG_SEGMENTED_VALUE_INTEGER || tag == IG_SEGMENTED_VALUE_FLOAT) return 7u;
    return 8u;
}

inline int ig_segmented_bytes_order(
    device const uchar* input_arena,
    IgSegmentedCellValue left,
    IgSegmentedCellValue right) {
    uint left_length = uint(left.auxiliary);
    uint right_length = uint(right.auxiliary);
    uint shared = min(left_length, right_length);
    uint left_start = uint(left.payload);
    uint right_start = uint(right.payload);
    for (uint byte = 0u; byte < shared; ++byte) {
        uint left_byte = uint(input_arena[left_start + byte]);
        uint right_byte = uint(input_arena[right_start + byte]);
        if (left_byte < right_byte) return -1;
        if (left_byte > right_byte) return 1;
    }
    return left_length < right_length ? -1 : (left_length > right_length ? 1 : 0);
}

inline int ig_segmented_numeric_order(
    IgSegmentedCellValue left,
    IgSegmentedCellValue right) {
    if (left.tag == IG_SEGMENTED_VALUE_INTEGER
            && right.tag == IG_SEGMENTED_VALUE_INTEGER) {
        long left_value = as_type<long>(left.payload);
        long right_value = as_type<long>(right.payload);
        return left_value < right_value ? -1 : (left_value > right_value ? 1 : 0);
    }
    if (left.tag == IG_SEGMENTED_VALUE_FLOAT
            && right.tag == IG_SEGMENTED_VALUE_FLOAT) {
        ulong left_key = ig_ordered_f64_bits(left.payload);
        ulong right_key = ig_ordered_f64_bits(right.payload);
        return left_key < right_key ? -1 : (left_key > right_key ? 1 : 0);
    }
    if (left.tag == IG_SEGMENTED_VALUE_INTEGER) {
        int order = 0;
        ig_scalar_i64_f64_order(as_type<long>(left.payload), right.payload, order);
        return order;
    }
    int reverse = 0;
    ig_scalar_i64_f64_order(as_type<long>(right.payload), left.payload, reverse);
    return -reverse;
}

inline int ig_segmented_key_order(
    device const uchar* input_arena,
    IgSegmentedCellValue left,
    IgSegmentedCellValue right) {
    uint left_rank = ig_segmented_key_rank(left.tag);
    uint right_rank = ig_segmented_key_rank(right.tag);
    if (left_rank != right_rank) return left_rank < right_rank ? -1 : 1;
    if (left_rank == 7u) return ig_segmented_numeric_order(left, right);
    if (left.tag == IG_SEGMENTED_VALUE_STRING || left.tag == IG_SEGMENTED_VALUE_BYTES) {
        return ig_segmented_bytes_order(input_arena, left, right);
    }
    if (left.tag == IG_SEGMENTED_VALUE_NULL) return 0;
    return left.payload < right.payload ? -1 : (left.payload > right.payload ? 1 : 0);
}

inline int ig_segmented_aggregate_key_order(
    device const ulong* input_cells,
    device const uchar* input_arena,
    IgSegmentedCellValue left,
    IgSegmentedCellValue right) {
    if (left.tag != IG_SEGMENTED_VALUE_LIST || right.tag != IG_SEGMENTED_VALUE_LIST) {
        return ig_segmented_key_order(input_arena, left, right);
    }
    uint left_length = uint(left.auxiliary);
    uint right_length = uint(right.auxiliary);
    uint shared = min(left_length, right_length);
    uint left_start = uint(left.payload);
    uint right_start = uint(right.payload);
    for (uint child = 0u; child < shared; ++child) {
        int order = ig_segmented_key_order(
            input_arena,
            ig_segmented_input_cell(input_cells, left_start + child),
            ig_segmented_input_cell(input_cells, right_start + child));
        if (order != 0) return order;
    }
    return left_length < right_length ? -1 : (left_length > right_length ? 1 : 0);
}

inline bool ig_segmented_receipt_input_valid(
    device const ulong* record,
    uint expected_scope,
    uint expected_index) {
    ulong expected_metadata = 10ul | (ulong(expected_scope) << 8u)
        | (ulong(expected_index) << 16u);
    if (record[0] == 0ul || record[1] != expected_metadata) return false;
    for (uint word = 2u; word < 9u; ++word) {
        if (record[word] != 0ul) return false;
    }
    return true;
}

inline bool ig_segmented_receipts_valid(
    device const ulong* receipt_records,
    constant IgSegmentedAggregationArgs& args) {
    if (args.receipt_count != args.aggregate_count + 1u) return false;
    for (uint receipt = 0u; receipt < args.receipt_count; ++receipt) {
        uint scope = receipt == 0u ? 5u : 2u;
        uint index = receipt == 0u ? 0u : receipt - 1u;
        device const ulong* record = receipt_records + ulong(receipt) * 9ul;
        if (!ig_segmented_receipt_input_valid(record, scope, index)) return false;
        for (uint prior = 0u; prior < receipt; ++prior) {
            if (record[0] == receipt_records[ulong(prior) * 9ul]) return false;
        }
    }
    return true;
}

inline uint ig_segmented_validate_input_cells(
    device const ulong* input_cells,
    device const uchar* input_arena,
    constant IgSegmentedAggregationArgs& args) {
    ulong top_level_wide = ulong(args.input_row_count) * ulong(args.input_column_count);
    if (top_level_wide > ulong(args.input_cell_count)) {
        return IG_SEGMENTED_STATUS_INVALID_SHAPE;
    }
    uint top_level_cells = uint(top_level_wide);
    bool flat_list_min_max = args.flags == IG_SEGMENTED_FLAG_FLAT_LIST_MIN_MAX;
    ulong referenced_bytes = 0ul;
    ulong referenced_list_items = 0ul;
    bool saw_list = false;
    for (uint cell_index = 0u; cell_index < args.input_cell_count; ++cell_index) {
        ulong base = ulong(cell_index) * 3ul;
        ulong raw_tag = input_cells[base];
        ulong payload = input_cells[base + 1ul];
        ulong auxiliary = input_cells[base + 2ul];
        if (raw_tag > ulong(IG_SEGMENTED_VALUE_LIST)) return IG_SEGMENTED_STATUS_INVALID_CELL;
        uint tag = uint(raw_tag);
        if (tag == IG_SEGMENTED_VALUE_LIST) {
            if (!flat_list_min_max) return IG_SEGMENTED_STATUS_UNSUPPORTED_LIST_INPUT;
            if (cell_index >= top_level_cells
                    || payload > 0xfffffffful || auxiliary > 0xfffffffful) {
                return IG_SEGMENTED_STATUS_INVALID_CELL;
            }
            uint start = uint(payload);
            uint length = uint(auxiliary);
            if (start < top_level_cells
                    || !ig_segmented_range(start, length, args.input_cell_count)) {
                return IG_SEGMENTED_STATUS_INVALID_CELL;
            }
            if (length != 0u) {
                uint end = start + length;
                for (uint prior = 0u; prior < cell_index; ++prior) {
                    IgSegmentedCellValue other = ig_segmented_input_cell(input_cells, prior);
                    if (other.tag != IG_SEGMENTED_VALUE_LIST || other.auxiliary == 0ul) continue;
                    uint other_start = uint(other.payload);
                    uint other_end = other_start + uint(other.auxiliary);
                    if (start < other_end && other_start < end) {
                        return IG_SEGMENTED_STATUS_MALFORMED_PACKET;
                    }
                }
            }
            referenced_list_items += ulong(length);
            if (referenced_list_items
                    > ulong(args.input_cell_count - top_level_cells)) {
                return IG_SEGMENTED_STATUS_MALFORMED_PACKET;
            }
            saw_list = true;
            continue;
        }
        if (flat_list_min_max && cell_index >= top_level_cells
                && tag != IG_SEGMENTED_VALUE_BOOLEAN
                && tag != IG_SEGMENTED_VALUE_INTEGER
                && tag != IG_SEGMENTED_VALUE_FLOAT
                && tag != IG_SEGMENTED_VALUE_STRING
                && tag != IG_SEGMENTED_VALUE_BYTES) {
            return IG_SEGMENTED_STATUS_INVALID_CELL;
        }
        if (tag == IG_SEGMENTED_VALUE_NULL) {
            if (payload != 0ul || auxiliary != 0ul) return IG_SEGMENTED_STATUS_INVALID_CELL;
        } else if (tag == IG_SEGMENTED_VALUE_BOOLEAN) {
            if (payload > 1ul || auxiliary != 0ul) return IG_SEGMENTED_STATUS_INVALID_CELL;
        } else if (tag == IG_SEGMENTED_VALUE_INTEGER
                || tag == IG_SEGMENTED_VALUE_NODE
                || tag == IG_SEGMENTED_VALUE_RELATIONSHIP) {
            if (auxiliary != 0ul) return IG_SEGMENTED_STATUS_INVALID_CELL;
        } else if (tag == IG_SEGMENTED_VALUE_FLOAT) {
            if (auxiliary != 0ul || !ig_segmented_f64_finite(payload)) {
                return IG_SEGMENTED_STATUS_INVALID_CELL;
            }
        } else {
            if (payload > 0xfffffffful || auxiliary > 0xfffffffful) {
                return IG_SEGMENTED_STATUS_INVALID_CELL;
            }
            uint start = uint(payload);
            uint length = uint(auxiliary);
            if (!ig_segmented_range(start, length, args.input_arena_bytes)) {
                return IG_SEGMENTED_STATUS_INVALID_CELL;
            }
            if (tag == IG_SEGMENTED_VALUE_STRING
                    && !ig_segmented_utf8(input_arena, start, length)) {
                return IG_SEGMENTED_STATUS_INVALID_UTF8;
            }
            referenced_bytes += ulong(length);
            if (referenced_bytes > ulong(args.input_arena_bytes)) {
                return IG_SEGMENTED_STATUS_MALFORMED_PACKET;
            }
            if (length != 0u) {
                uint end = start + length;
                for (uint prior = 0u; prior < cell_index; ++prior) {
                    IgSegmentedCellValue other = ig_segmented_input_cell(input_cells, prior);
                    if ((other.tag != IG_SEGMENTED_VALUE_STRING
                                && other.tag != IG_SEGMENTED_VALUE_BYTES)
                            || other.auxiliary == 0ul) continue;
                    uint other_start = uint(other.payload);
                    uint other_end = other_start + uint(other.auxiliary);
                    if (start < other_end && other_start < end) {
                        return IG_SEGMENTED_STATUS_MALFORMED_PACKET;
                    }
                }
            }
        }
    }
    bool lists_complete = !flat_list_min_max
        || (saw_list && referenced_list_items
            == ulong(args.input_cell_count - top_level_cells));
    return lists_complete && referenced_bytes == ulong(args.input_arena_bytes)
        ? IG_SEGMENTED_STATUS_SUCCESS
        : IG_SEGMENTED_STATUS_MALFORMED_PACKET;
}

inline bool ig_segmented_same_group(
    device const ulong* input_cells,
    device const uchar* input_arena,
    device const uint* grouping_columns,
    constant IgSegmentedAggregationArgs& args,
    uint left_row,
    uint right_row) {
    ulong left_base = ulong(left_row) * ulong(args.input_column_count);
    ulong right_base = ulong(right_row) * ulong(args.input_column_count);
    for (uint key = 0u; key < args.grouping_column_count; ++key) {
        uint column = grouping_columns[key];
        IgSegmentedCellValue left = ig_segmented_input_cell(
            input_cells, uint(left_base + ulong(column)));
        IgSegmentedCellValue right = ig_segmented_input_cell(
            input_cells, uint(right_base + ulong(column)));
        if (!ig_segmented_values_equal(input_arena, left, right)) return false;
    }
    return true;
}

inline bool ig_segmented_first_distinct(
    device const ulong* input_cells,
    device const uchar* input_arena,
    device const uint* row_group_ids,
    constant IgSegmentedAggregationArgs& args,
    uint row,
    uint group,
    uint column,
    IgSegmentedCellValue value) {
    for (uint prior = 0u; prior < row; ++prior) {
        if (row_group_ids[prior] != group) continue;
        ulong input_index = ulong(prior) * ulong(args.input_column_count) + ulong(column);
        IgSegmentedCellValue other = ig_segmented_input_cell(input_cells, uint(input_index));
        if (other.tag != IG_SEGMENTED_VALUE_NULL
                && ig_segmented_values_equal(input_arena, value, other)) return false;
    }
    return true;
}

inline bool ig_segmented_row_qualifies(
    device const ulong* input_cells,
    device const uchar* input_arena,
    device const uint* row_group_ids,
    constant IgSegmentedAggregationArgs& args,
    uint row,
    uint group,
    uint column,
    bool distinct,
    thread IgSegmentedCellValue& value) {
    if (row_group_ids[row] != group) return false;
    ulong input_index = ulong(row) * ulong(args.input_column_count) + ulong(column);
    value = ig_segmented_input_cell(input_cells, uint(input_index));
    if (value.tag == IG_SEGMENTED_VALUE_NULL) return false;
    return !distinct || ig_segmented_first_distinct(
        input_cells, input_arena, row_group_ids, args, row, group, column, value);
}

inline bool ig_segmented_percentile_numeric(
    IgSegmentedCellValue value,
    thread ulong& bits) {
    if (value.tag == IG_SEGMENTED_VALUE_INTEGER) {
        bits = ig_scalar_program_i64_to_f64(value.payload);
        return true;
    }
    if (value.tag == IG_SEGMENTED_VALUE_FLOAT && ig_segmented_f64_finite(value.payload)) {
        bits = value.payload;
        return true;
    }
    return false;
}

inline ulong ig_segmented_percentile_total_key(ulong bits) {
    return (bits >> 63) != 0ul
        ? ~bits
        : (bits | 0x8000000000000000ul);
}

inline bool ig_segmented_percentile_select(
    device const ulong* input_cells,
    device const uchar* input_arena,
    device const uint* row_group_ids,
    constant IgSegmentedAggregationArgs& args,
    uint group,
    uint column,
    bool distinct,
    ulong target_rank,
    thread uint& selected_input,
    thread ulong& selected_bits) {
    for (uint candidate_row = 0u; candidate_row < args.input_row_count; ++candidate_row) {
        IgSegmentedCellValue candidate;
        if (!ig_segmented_row_qualifies(
                input_cells,
                input_arena,
                row_group_ids,
                args,
                candidate_row,
                group,
                column,
                distinct,
                candidate)) continue;
        ulong candidate_bits = 0ul;
        if (!ig_segmented_percentile_numeric(candidate, candidate_bits)) return false;
        ulong candidate_key = ig_segmented_percentile_total_key(candidate_bits);
        ulong rank = 0ul;
        for (uint other_row = 0u; other_row < args.input_row_count; ++other_row) {
            IgSegmentedCellValue other;
            if (!ig_segmented_row_qualifies(
                    input_cells,
                    input_arena,
                    row_group_ids,
                    args,
                    other_row,
                    group,
                    column,
                    distinct,
                    other)) continue;
            ulong other_bits = 0ul;
            if (!ig_segmented_percentile_numeric(other, other_bits)) return false;
            ulong other_key = ig_segmented_percentile_total_key(other_bits);
            if (other_key < candidate_key
                    || (other_key == candidate_key && other_row < candidate_row)) {
                ++rank;
            }
        }
        if (rank == target_rank) {
            selected_input = uint(
                ulong(candidate_row) * ulong(args.input_column_count) + ulong(column));
            selected_bits = candidate_bits;
            return true;
        }
    }
    return false;
}

kernel void ig_segmented_aggregation_group_program(
    device const ulong* input_header [[buffer(0)]],
    device const ulong* input_cells [[buffer(1)]],
    device const uchar* input_arena [[buffer(2)]],
    device const uint* grouping_columns [[buffer(3)]],
    device const uint* aggregate_descriptors [[buffer(4)]],
    device const ulong* receipt_records [[buffer(5)]],
    device ulong* output_header [[buffer(6)]],
    device atomic_uint* control [[buffer(9)]],
    device uint* row_group_ids [[buffer(10)]],
    device uint* group_first_rows [[buffer(11)]],
    constant IgSegmentedAggregationArgs& args [[buffer(13)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;

    ig_segmented_initialize_output_header(input_header, output_header);
    for (uint word = 0u; word < 8u; ++word) {
        atomic_store_explicit(&control[word], 0u, memory_order_relaxed);
    }

    ulong header_shape = input_header[4];
    ulong header_relation = input_header[5];
    ulong header_program = input_header[6];
    ulong header_capacities = input_header[7];
    ulong header_arena = input_header[8];
    ulong exact_input_cells = ulong(args.input_row_count) * ulong(args.input_column_count);
    ulong exact_reduction_states = ulong(args.maximum_output_groups)
        * ulong(args.aggregate_count);
    if (input_header[0] != IG_SEGMENTED_AGGREGATION_ABI_WORD
            || input_header[1] != 0ul
            || (input_header[2] == 0ul && input_header[3] == 0ul)
            || uint(header_shape) != args.input_row_count
            || uint((header_shape >> 32u) & 0xfffful) != args.input_column_count
            || (header_shape >> 48u) != 0ul
            || uint(header_relation) != args.input_cell_count
            || uint(header_relation >> 32u) != args.input_arena_bytes
            || uint(header_program & 0xfffful) != args.grouping_column_count
            || uint((header_program >> 16u) & 0xfffful) != args.aggregate_count
            || uint((header_program >> 32u) & 0xfffful) != args.receipt_count
            || (header_program >> 48u) != 0ul
            || uint(header_capacities) != args.maximum_output_groups
            || uint(header_capacities >> 32u) != args.maximum_output_cells
            || uint(header_arena) != args.maximum_output_arena_bytes
            || uint(header_arena >> 32u) != args.flags
            || (args.flags & ~IG_SEGMENTED_FLAG_FLAT_LIST_MIN_MAX) != 0u
            || args.reserved != 0u) {
        ig_segmented_group_fail(output_header, control, IG_SEGMENTED_STATUS_INVALID_HEADER);
        return;
    }
    if (args.input_column_count > IG_SEGMENTED_MAX_COLUMNS
            || ((args.flags == 0u && exact_input_cells != ulong(args.input_cell_count))
                || (args.flags == IG_SEGMENTED_FLAG_FLAT_LIST_MIN_MAX
                    && exact_input_cells > ulong(args.input_cell_count)))
            || args.input_cell_count > IG_SEGMENTED_MAX_CELLS
            || args.input_arena_bytes > IG_SEGMENTED_MAX_ARENA_BYTES
            || args.grouping_column_count > IG_SEGMENTED_MAX_GROUP_KEYS
            || args.aggregate_count == 0u
            || args.aggregate_count > IG_SEGMENTED_MAX_AGGREGATES
            || args.receipt_count != args.aggregate_count + 1u
            || args.maximum_output_groups == 0u
            || args.maximum_output_cells > IG_SEGMENTED_MAX_CELLS
            || args.maximum_output_arena_bytes > IG_SEGMENTED_MAX_ARENA_BYTES
            || args.row_group_capacity < args.input_row_count
            || args.group_first_capacity < args.maximum_output_groups
            || exact_reduction_states > 0xfffffffful
            || args.reduction_state_capacity < uint(exact_reduction_states)
            || args.output_cell_capacity < args.maximum_output_cells
            || args.output_arena_capacity < args.maximum_output_arena_bytes
            || args.receipt_record_capacity < args.receipt_count) {
        ig_segmented_group_fail(output_header, control, IG_SEGMENTED_STATUS_INVALID_SHAPE);
        return;
    }

    uint output_columns = args.grouping_column_count + args.aggregate_count;
    if (output_columns > IG_SEGMENTED_MAX_COLUMNS) {
        ig_segmented_group_fail(output_header, control, IG_SEGMENTED_STATUS_INVALID_SHAPE);
        return;
    }
    uint collect_count = 0u;
    for (uint key = 0u; key < args.grouping_column_count; ++key) {
        uint column = grouping_columns[key];
        if (column > 0xffffu || column >= args.input_column_count) {
            ig_segmented_group_fail(
                output_header, control, IG_SEGMENTED_STATUS_INVALID_GROUP_SPEC);
            return;
        }
        for (uint prior = 0u; prior < key; ++prior) {
            if (grouping_columns[prior] == column) {
                ig_segmented_group_fail(
                    output_header, control, IG_SEGMENTED_STATUS_INVALID_GROUP_SPEC);
                return;
            }
        }
    }
    for (uint aggregate = 0u; aggregate < args.aggregate_count; ++aggregate) {
        ulong base = ulong(aggregate) * IG_SEGMENTED_AGGREGATE_WORDS;
        uint kind = aggregate_descriptors[base];
        uint column = aggregate_descriptors[base + 1ul];
        uint distinct = aggregate_descriptors[base + 2ul];
        ulong percentile = ulong(aggregate_descriptors[base + 3ul])
            | (ulong(aggregate_descriptors[base + 4ul]) << 32u);
        bool count_all = kind == IG_SEGMENTED_AGGREGATE_COUNT_ALL;
        bool percentile_kind = kind == IG_SEGMENTED_AGGREGATE_PERCENTILE_DISC
            || kind == IG_SEGMENTED_AGGREGATE_PERCENTILE_CONT;
        if (kind < IG_SEGMENTED_AGGREGATE_COUNT_ALL
                || kind > IG_SEGMENTED_AGGREGATE_PERCENTILE_CONT
                || distinct > 1u
                || (percentile_kind
                    ? !ig_segmented_percentile_valid(percentile)
                    : percentile != 0ul)
                || (count_all && (column != 0xffffffffu || distinct != 0u))
                || (!count_all && (column > 0xffffu || column >= args.input_column_count))) {
            ig_segmented_group_fail(
                output_header, control, IG_SEGMENTED_STATUS_INVALID_AGGREGATE_SPEC);
            return;
        }
        if (kind == IG_SEGMENTED_AGGREGATE_COLLECT) ++collect_count;
    }
    if (args.flags == IG_SEGMENTED_FLAG_FLAT_LIST_MIN_MAX) {
        uint kind = aggregate_descriptors[0];
        uint column = aggregate_descriptors[1];
        uint distinct = aggregate_descriptors[2];
        ulong percentile = ulong(aggregate_descriptors[3])
            | (ulong(aggregate_descriptors[4]) << 32u);
        if (args.input_column_count != 1u
                || args.grouping_column_count != 0u
                || args.aggregate_count != 1u
                || args.maximum_output_groups != 1u
                || (kind != IG_SEGMENTED_AGGREGATE_MINIMUM
                    && kind != IG_SEGMENTED_AGGREGATE_MAXIMUM)
                || column != 0u || distinct != 0u || percentile != 0ul) {
            ig_segmented_group_fail(
                output_header, control, IG_SEGMENTED_STATUS_INVALID_AGGREGATE_SPEC);
            return;
        }
    }
    ulong required_cells = ulong(args.maximum_output_groups) * ulong(output_columns)
        + ulong(args.input_row_count) * ulong(collect_count);
    if (required_cells > ulong(args.maximum_output_cells)) {
        ig_segmented_group_fail(output_header, control, IG_SEGMENTED_STATUS_CELL_CAPACITY);
        return;
    }
    if (!ig_segmented_receipts_valid(receipt_records, args)) {
        ig_segmented_group_fail(output_header, control, IG_SEGMENTED_STATUS_INVALID_RECEIPT);
        return;
    }
    uint cell_status = ig_segmented_validate_input_cells(input_cells, input_arena, args);
    if (cell_status != IG_SEGMENTED_STATUS_SUCCESS) {
        ig_segmented_group_fail(output_header, control, cell_status);
        return;
    }
    if (args.flags == IG_SEGMENTED_FLAG_FLAT_LIST_MIN_MAX) {
        uint maximum_list_items = 0u;
        for (uint row = 0u; row < args.input_row_count; ++row) {
            IgSegmentedCellValue value = ig_segmented_input_cell(input_cells, row);
            if (value.tag == IG_SEGMENTED_VALUE_LIST) {
                maximum_list_items = max(maximum_list_items, uint(value.auxiliary));
            }
        }
        ulong list_required_cells = 1ul + ulong(maximum_list_items);
        if (list_required_cells > ulong(args.maximum_output_cells)) {
            ig_segmented_group_fail(
                output_header, control, IG_SEGMENTED_STATUS_CELL_CAPACITY);
            return;
        }
    }

    uint group_count = args.grouping_column_count == 0u ? 1u : 0u;
    if (args.grouping_column_count == 0u) group_first_rows[0] = 0u;
    for (uint row = 0u; row < args.input_row_count; ++row) {
        uint group = 0u;
        bool found = args.grouping_column_count == 0u;
        if (!found) {
            for (uint candidate = 0u; candidate < group_count; ++candidate) {
                if (ig_segmented_same_group(
                        input_cells,
                        input_arena,
                        grouping_columns,
                        args,
                        row,
                        group_first_rows[candidate])) {
                    group = candidate;
                    found = true;
                    break;
                }
            }
        }
        if (!found) {
            if (group_count >= args.maximum_output_groups) {
                ig_segmented_group_fail(
                    output_header, control, IG_SEGMENTED_STATUS_GROUP_CAPACITY);
                return;
            }
            group = group_count++;
            group_first_rows[group] = row;
        }
        row_group_ids[row] = group;
    }

    uint expected_reductions = group_count * args.aggregate_count;
    atomic_store_explicit(&control[2], group_count, memory_order_relaxed);
    atomic_store_explicit(&control[3], 0u, memory_order_relaxed);
    atomic_store_explicit(&control[4], expected_reductions, memory_order_relaxed);
    uint phase = expected_reductions == 0u
        ? IG_SEGMENTED_PHASE_REDUCED : IG_SEGMENTED_PHASE_GROUPED;
    atomic_store_explicit(&control[1], phase, memory_order_relaxed);
    ig_segmented_header_status(output_header, IG_SEGMENTED_STATUS_NOT_EXECUTED, phase);
}

kernel void ig_segmented_aggregation_reduce_program(
    device const ulong* input_cells [[buffer(1)]],
    device const uchar* input_arena [[buffer(2)]],
    device const uint* aggregate_descriptors [[buffer(4)]],
    device atomic_uint* control [[buffer(9)]],
    device const uint* row_group_ids [[buffer(10)]],
    device ulong* reduction_states [[buffer(12)]],
    constant IgSegmentedAggregationArgs& args [[buffer(13)]],
    uint pair_index [[thread_position_in_grid]]) {
    uint group_count = atomic_load_explicit(&control[2], memory_order_relaxed);
    ulong active_pairs = ulong(group_count) * ulong(args.aggregate_count);
    if (ulong(pair_index) >= active_pairs) return;
    if (atomic_load_explicit(&control[1], memory_order_relaxed)
            != IG_SEGMENTED_PHASE_GROUPED) {
        ig_segmented_parallel_error(control, IG_SEGMENTED_STATUS_PHASE_MISMATCH);
        return;
    }

    uint group = pair_index / args.aggregate_count;
    uint aggregate = pair_index - group * args.aggregate_count;
    ulong descriptor_base = ulong(aggregate) * IG_SEGMENTED_AGGREGATE_WORDS;
    uint kind = aggregate_descriptors[descriptor_base];
    uint column = aggregate_descriptors[descriptor_base + 1ul];
    bool distinct = aggregate_descriptors[descriptor_base + 2ul] != 0u;
    ulong percentile = ulong(aggregate_descriptors[descriptor_base + 3ul])
        | (ulong(aggregate_descriptors[descriptor_base + 4ul]) << 32u);
    bool percentile_kind = kind == IG_SEGMENTED_AGGREGATE_PERCENTILE_DISC
        || kind == IG_SEGMENTED_AGGREGATE_PERCENTILE_CONT;

    ulong count = 0ul;
    ulong integer_sum = 0ul;
    ulong float_sum = 0ul;
    bool saw_float = false;
    uint selected_input = 0xffffffffu;
    uint local_error = 0u;

    for (uint row = 0u; row < args.input_row_count; ++row) {
        if (row_group_ids[row] != group) continue;
        if (kind == IG_SEGMENTED_AGGREGATE_COUNT_ALL) {
            ++count;
            continue;
        }
        IgSegmentedCellValue value;
        if (!ig_segmented_row_qualifies(
                input_cells,
                input_arena,
                row_group_ids,
                args,
                row,
                group,
                column,
                distinct,
                value)) continue;

        if (kind == IG_SEGMENTED_AGGREGATE_COUNT_VALUE
                || kind == IG_SEGMENTED_AGGREGATE_COLLECT) {
            ++count;
            continue;
        }
        uint input_index = uint(
            ulong(row) * ulong(args.input_column_count) + ulong(column));
        if (kind == IG_SEGMENTED_AGGREGATE_MINIMUM
                || kind == IG_SEGMENTED_AGGREGATE_MAXIMUM) {
            ++count;
            if (selected_input == 0xffffffffu) {
                selected_input = input_index;
            } else {
                IgSegmentedCellValue selected = ig_segmented_input_cell(
                    input_cells, selected_input);
                int order = ig_segmented_aggregate_key_order(
                    input_cells, input_arena, value, selected);
                if ((kind == IG_SEGMENTED_AGGREGATE_MINIMUM && order < 0)
                        || (kind == IG_SEGMENTED_AGGREGATE_MAXIMUM && order > 0)) {
                    selected_input = input_index;
                }
            }
            continue;
        }
        if (percentile_kind) {
            ulong numeric = 0ul;
            if (!ig_segmented_percentile_numeric(value, numeric)) {
                local_error = IG_SEGMENTED_STATUS_AGGREGATE_TYPE;
                break;
            }
            ++count;
            continue;
        }
        if (value.tag == IG_SEGMENTED_VALUE_INTEGER) {
            if (saw_float) {
                ulong converted = ig_scalar_program_i64_to_f64(value.payload);
                float_sum = ig_scalar_program_f64_add(float_sum, converted);
                if (!ig_segmented_f64_finite(float_sum)) {
                    local_error = IG_SEGMENTED_STATUS_FLOAT_OVERFLOW;
                    break;
                }
            } else {
                ulong next = 0ul;
                if (!ig_scalar_program_checked_add(integer_sum, value.payload, next)) {
                    local_error = IG_SEGMENTED_STATUS_INTEGER_OVERFLOW;
                    break;
                }
                integer_sum = next;
            }
        } else if (value.tag == IG_SEGMENTED_VALUE_FLOAT) {
            if (!saw_float) {
                float_sum = ig_scalar_program_i64_to_f64(integer_sum);
                saw_float = true;
            }
            float_sum = ig_scalar_program_f64_add(float_sum, value.payload);
            if (!ig_segmented_f64_finite(float_sum)) {
                local_error = IG_SEGMENTED_STATUS_FLOAT_OVERFLOW;
                break;
            }
        } else {
            local_error = IG_SEGMENTED_STATUS_AGGREGATE_TYPE;
            break;
        }
        ++count;
    }

    IgSegmentedCellValue output = ig_segmented_null_cell();
    uint mode = IG_SEGMENTED_REDUCTION_CELL;
    ulong datum = ulong(IG_SEGMENTED_VALUE_NULL);
    if (local_error == 0u) {
        if (kind == IG_SEGMENTED_AGGREGATE_COUNT_ALL
                || kind == IG_SEGMENTED_AGGREGATE_COUNT_VALUE) {
            if (count > 0x7ffffffffffffffful) {
                local_error = IG_SEGMENTED_STATUS_INTEGER_OVERFLOW;
            } else {
                output.tag = IG_SEGMENTED_VALUE_INTEGER;
                output.payload = count;
                datum = ulong(output.tag);
            }
        } else if (kind == IG_SEGMENTED_AGGREGATE_SUM) {
            output.tag = saw_float ? IG_SEGMENTED_VALUE_FLOAT : IG_SEGMENTED_VALUE_INTEGER;
            output.payload = saw_float ? float_sum : integer_sum;
            datum = ulong(output.tag);
        } else if (kind == IG_SEGMENTED_AGGREGATE_AVERAGE) {
            if (count != 0ul) {
                ulong numerator = saw_float
                    ? float_sum : ig_scalar_program_i64_to_f64(integer_sum);
                ulong denominator = ig_scalar_program_i64_to_f64(count);
                ulong quotient = ig_scalar_program_f64_divide(numerator, denominator);
                if (!ig_segmented_f64_finite(quotient)) {
                    local_error = IG_SEGMENTED_STATUS_FLOAT_OVERFLOW;
                } else {
                    output.tag = IG_SEGMENTED_VALUE_FLOAT;
                    output.payload = quotient;
                }
            }
            datum = ulong(output.tag);
        } else if (kind == IG_SEGMENTED_AGGREGATE_MINIMUM
                || kind == IG_SEGMENTED_AGGREGATE_MAXIMUM) {
            if (selected_input != 0xffffffffu) {
                mode = IG_SEGMENTED_REDUCTION_INPUT_REF;
                datum = ulong(selected_input);
            }
        } else if (percentile_kind) {
            if (count != 0ul) {
                ulong target_rank = 0ul;
                if (kind == IG_SEGMENTED_AGGREGATE_PERCENTILE_DISC) {
                    if ((percentile & 0x7ffffffffffffffful) != 0ul) {
                        ulong product = ig_scalar_program_f64_multiply(
                            percentile, ig_scalar_program_i64_to_f64(count));
                        ulong floor_rank = 0ul;
                        if (!ig_segmented_f64_finite(product)
                                || !ig_scalar_program_f64_to_i64(product, floor_rank)) {
                            local_error = IG_SEGMENTED_STATUS_FLOAT_OVERFLOW;
                        } else {
                            ulong floor_bits = ig_scalar_program_i64_to_f64(floor_rank);
                            ulong ceiling = floor_rank
                                + (ig_scalar_f64_equal(product, floor_bits) ? 0ul : 1ul);
                            if (ceiling == 0ul || ceiling > count) {
                                local_error = IG_SEGMENTED_STATUS_INTERNAL_BOUNDS;
                            } else {
                                target_rank = ceiling - 1ul;
                            }
                        }
                    }
                    ulong selected_bits = 0ul;
                    if (local_error == 0u
                            && !ig_segmented_percentile_select(
                                input_cells,
                                input_arena,
                                row_group_ids,
                                args,
                                group,
                                column,
                                distinct,
                                target_rank,
                                selected_input,
                                selected_bits)) {
                        local_error = IG_SEGMENTED_STATUS_INTERNAL_BOUNDS;
                    }
                    if (local_error == 0u) {
                        mode = IG_SEGMENTED_REDUCTION_INPUT_REF;
                        datum = ulong(selected_input);
                    }
                } else {
                    ulong position = ig_scalar_program_f64_multiply(
                        percentile, ig_scalar_program_i64_to_f64(count - 1ul));
                    ulong lower_rank = 0ul;
                    if (!ig_segmented_f64_finite(position)
                            || !ig_scalar_program_f64_to_i64(position, lower_rank)
                            || lower_rank >= count) {
                        local_error = IG_SEGMENTED_STATUS_INTERNAL_BOUNDS;
                    } else {
                        ulong lower_rank_bits = ig_scalar_program_i64_to_f64(lower_rank);
                        ulong upper_rank = lower_rank
                            + (ig_scalar_f64_equal(position, lower_rank_bits) ? 0ul : 1ul);
                        uint lower_input = 0xffffffffu;
                        uint upper_input = 0xffffffffu;
                        ulong lower_bits = 0ul;
                        ulong upper_bits = 0ul;
                        if (upper_rank >= count
                                || !ig_segmented_percentile_select(
                                    input_cells,
                                    input_arena,
                                    row_group_ids,
                                    args,
                                    group,
                                    column,
                                    distinct,
                                    lower_rank,
                                    lower_input,
                                    lower_bits)
                                || !ig_segmented_percentile_select(
                                    input_cells,
                                    input_arena,
                                    row_group_ids,
                                    args,
                                    group,
                                    column,
                                    distinct,
                                    upper_rank,
                                    upper_input,
                                    upper_bits)) {
                            local_error = IG_SEGMENTED_STATUS_INTERNAL_BOUNDS;
                        } else {
                            ulong interpolated = lower_bits;
                            if (upper_rank != lower_rank) {
                                ulong fraction = ig_scalar_program_f64_add(
                                    position,
                                    lower_rank_bits ^ 0x8000000000000000ul);
                                ulong delta = ig_scalar_program_f64_add(
                                    upper_bits,
                                    lower_bits ^ 0x8000000000000000ul);
                                interpolated = ig_scalar_program_f64_add(
                                    lower_bits,
                                    ig_scalar_program_f64_multiply(delta, fraction));
                            }
                            if (!ig_segmented_f64_finite(interpolated)) {
                                local_error = IG_SEGMENTED_STATUS_FLOAT_OVERFLOW;
                            } else {
                                output.tag = IG_SEGMENTED_VALUE_FLOAT;
                                output.payload = interpolated;
                                datum = ulong(output.tag);
                            }
                        }
                    }
                }
            }
        } else {
            mode = IG_SEGMENTED_REDUCTION_COLLECT;
            datum = count;
        }
    }
    if (local_error != 0u) {
        ig_segmented_parallel_error(control, local_error);
        mode = IG_SEGMENTED_REDUCTION_CELL;
        output = ig_segmented_null_cell();
        datum = ulong(output.tag);
    }

    ulong state_base = ulong(pair_index) * 8ul;
    reduction_states[state_base + 1ul] = ulong(kind);
    reduction_states[state_base + 2ul] = ulong(mode);
    reduction_states[state_base + 3ul] = datum;
    reduction_states[state_base + 4ul] = mode == IG_SEGMENTED_REDUCTION_CELL
        ? output.payload : 0ul;
    reduction_states[state_base + 5ul] = mode == IG_SEGMENTED_REDUCTION_CELL
        ? output.auxiliary : 0ul;
    reduction_states[state_base + 6ul] = count;
    reduction_states[state_base + 7ul] = 0ul;
    reduction_states[state_base] = IG_SEGMENTED_REDUCTION_READY;

    uint prior = atomic_fetch_add_explicit(&control[3], 1u, memory_order_relaxed);
    uint expected = atomic_load_explicit(&control[4], memory_order_relaxed);
    if (prior + 1u == expected) {
        atomic_store_explicit(&control[1], IG_SEGMENTED_PHASE_REDUCED, memory_order_relaxed);
    }
}

inline bool ig_segmented_state_valid(
    device const ulong* state,
    uint kind,
    constant IgSegmentedAggregationArgs& args) {
    if (state[0] != IG_SEGMENTED_REDUCTION_READY || state[1] != ulong(kind)
            || state[2] > ulong(IG_SEGMENTED_REDUCTION_COLLECT)
            || state[6] > ulong(args.input_row_count) || state[7] != 0ul) return false;
    uint mode = uint(state[2]);
    if (kind == IG_SEGMENTED_AGGREGATE_COUNT_ALL
            || kind == IG_SEGMENTED_AGGREGATE_COUNT_VALUE
            || kind == IG_SEGMENTED_AGGREGATE_SUM
            || kind == IG_SEGMENTED_AGGREGATE_AVERAGE) {
        if (mode != IG_SEGMENTED_REDUCTION_CELL) return false;
        uint tag = uint(state[3]);
        if (state[3] > ulong(IG_SEGMENTED_VALUE_FLOAT) || state[5] != 0ul) return false;
        if ((kind == IG_SEGMENTED_AGGREGATE_COUNT_ALL
                    || kind == IG_SEGMENTED_AGGREGATE_COUNT_VALUE)
                && (tag != IG_SEGMENTED_VALUE_INTEGER || state[4] != state[6])) return false;
        if (kind == IG_SEGMENTED_AGGREGATE_SUM
                && tag != IG_SEGMENTED_VALUE_INTEGER && tag != IG_SEGMENTED_VALUE_FLOAT) {
            return false;
        }
        if (kind == IG_SEGMENTED_AGGREGATE_AVERAGE
                && !((state[6] == 0ul && tag == IG_SEGMENTED_VALUE_NULL && state[4] == 0ul)
                    || (state[6] != 0ul && tag == IG_SEGMENTED_VALUE_FLOAT
                        && ig_segmented_f64_finite(state[4])))) return false;
        if (tag == IG_SEGMENTED_VALUE_FLOAT && !ig_segmented_f64_finite(state[4])) return false;
        return true;
    }
    if (kind == IG_SEGMENTED_AGGREGATE_MINIMUM
            || kind == IG_SEGMENTED_AGGREGATE_MAXIMUM) {
        if (state[6] == 0ul) {
            return mode == IG_SEGMENTED_REDUCTION_CELL
                && state[3] == ulong(IG_SEGMENTED_VALUE_NULL)
                && state[4] == 0ul && state[5] == 0ul;
        }
        return mode == IG_SEGMENTED_REDUCTION_INPUT_REF
            && state[3] < ulong(args.input_row_count) * ulong(args.input_column_count)
            && state[4] == 0ul && state[5] == 0ul;
    }
    if (kind == IG_SEGMENTED_AGGREGATE_PERCENTILE_DISC) {
        if (state[6] == 0ul) {
            return mode == IG_SEGMENTED_REDUCTION_CELL
                && state[3] == ulong(IG_SEGMENTED_VALUE_NULL)
                && state[4] == 0ul && state[5] == 0ul;
        }
        return mode == IG_SEGMENTED_REDUCTION_INPUT_REF
            && state[3] < ulong(args.input_row_count) * ulong(args.input_column_count)
            && state[4] == 0ul && state[5] == 0ul;
    }
    if (kind == IG_SEGMENTED_AGGREGATE_PERCENTILE_CONT) {
        return mode == IG_SEGMENTED_REDUCTION_CELL
            && ((state[6] == 0ul
                    && state[3] == ulong(IG_SEGMENTED_VALUE_NULL)
                    && state[4] == 0ul && state[5] == 0ul)
                || (state[6] != 0ul
                    && state[3] == ulong(IG_SEGMENTED_VALUE_FLOAT)
                    && ig_segmented_f64_finite(state[4]) && state[5] == 0ul));
    }
    return kind == IG_SEGMENTED_AGGREGATE_COLLECT
        && mode == IG_SEGMENTED_REDUCTION_COLLECT
        && state[3] == state[6] && state[4] == 0ul && state[5] == 0ul;
}

inline bool ig_segmented_preflight_cell(
    IgSegmentedCellValue value,
    uint maximum_arena_bytes,
    thread uint& arena_cursor) {
    if (value.tag != IG_SEGMENTED_VALUE_STRING && value.tag != IG_SEGMENTED_VALUE_BYTES) {
        return value.tag != IG_SEGMENTED_VALUE_LIST;
    }
    uint length = uint(value.auxiliary);
    if (!ig_segmented_range(arena_cursor, length, maximum_arena_bytes)) return false;
    arena_cursor += length;
    return true;
}

inline bool ig_segmented_preflight_selected_input(
    device const ulong* input_cells,
    IgSegmentedCellValue value,
    constant IgSegmentedAggregationArgs& args,
    thread uint& arena_cursor) {
    if (value.tag != IG_SEGMENTED_VALUE_LIST) {
        return ig_segmented_preflight_cell(
            value, args.maximum_output_arena_bytes, arena_cursor);
    }
    if (args.flags != IG_SEGMENTED_FLAG_FLAT_LIST_MIN_MAX
            || value.payload > 0xfffffffful || value.auxiliary > 0xfffffffful) return false;
    uint start = uint(value.payload);
    uint length = uint(value.auxiliary);
    if (!ig_segmented_range(start, length, args.input_cell_count)) return false;
    for (uint child = 0u; child < length; ++child) {
        if (!ig_segmented_preflight_cell(
                ig_segmented_input_cell(input_cells, start + child),
                args.maximum_output_arena_bytes,
                arena_cursor)) return false;
    }
    return true;
}

inline bool ig_segmented_copy_input_cell(
    device const uchar* input_arena,
    IgSegmentedCellValue value,
    device ulong* output_cells,
    uint output_index,
    device uchar* output_arena,
    uint output_arena_capacity,
    thread uint& arena_cursor) {
    if (value.tag == IG_SEGMENTED_VALUE_LIST) return false;
    if (value.tag == IG_SEGMENTED_VALUE_STRING || value.tag == IG_SEGMENTED_VALUE_BYTES) {
        uint input_start = uint(value.payload);
        uint length = uint(value.auxiliary);
        if (!ig_segmented_range(arena_cursor, length, output_arena_capacity)) return false;
        for (uint byte = 0u; byte < length; ++byte) {
            output_arena[arena_cursor + byte] = input_arena[input_start + byte];
        }
        value.payload = ulong(arena_cursor);
        arena_cursor += length;
    }
    ig_segmented_write_cell(output_cells, output_index, value);
    return true;
}

inline void ig_segmented_finalize_fail(
    device ulong* output_header,
    device atomic_uint* control,
    uint status) {
    output_header[4] = 0ul;
    output_header[5] = 0ul;
    atomic_store_explicit(&control[0], status, memory_order_relaxed);
    atomic_store_explicit(&control[1], IG_SEGMENTED_PHASE_FAILED, memory_order_relaxed);
    ig_segmented_header_status(output_header, status, IG_SEGMENTED_PHASE_FAILED);
}

inline void ig_segmented_complete_receipt(
    device ulong* record,
    ulong execution_high,
    ulong execution_low,
    uint input_rows,
    uint output_groups) {
    record[2] = 1ul;
    record[3] = execution_high;
    record[4] = execution_low;
    record[5] = record[0];
    record[6] = record[1];
    record[7] = ulong(input_rows) | (ulong(output_groups) << 32u);
    record[8] = 2ul;
}

kernel void ig_segmented_aggregation_finalize_program(
    device const ulong* input_header [[buffer(0)]],
    device const ulong* input_cells [[buffer(1)]],
    device const uchar* input_arena [[buffer(2)]],
    device const uint* grouping_columns [[buffer(3)]],
    device const uint* aggregate_descriptors [[buffer(4)]],
    device ulong* receipt_records [[buffer(5)]],
    device ulong* output_header [[buffer(6)]],
    device ulong* output_cells [[buffer(7)]],
    device uchar* output_arena [[buffer(8)]],
    device atomic_uint* control [[buffer(9)]],
    device const uint* row_group_ids [[buffer(10)]],
    device const uint* group_first_rows [[buffer(11)]],
    device const ulong* reduction_states [[buffer(12)]],
    constant IgSegmentedAggregationArgs& args [[buffer(13)]],
    uint thread_index [[thread_position_in_grid]]) {
    if (thread_index != 0u) return;

    uint status = atomic_load_explicit(&control[0], memory_order_relaxed);
    uint phase = atomic_load_explicit(&control[1], memory_order_relaxed);
    uint group_count = atomic_load_explicit(&control[2], memory_order_relaxed);
    uint completed = atomic_load_explicit(&control[3], memory_order_relaxed);
    uint expected = atomic_load_explicit(&control[4], memory_order_relaxed);
    if (status != 0u) {
        ig_segmented_finalize_fail(output_header, control, status);
        return;
    }
    if (phase != IG_SEGMENTED_PHASE_REDUCED) {
        ig_segmented_finalize_fail(
            output_header, control, IG_SEGMENTED_STATUS_PHASE_MISMATCH);
        return;
    }
    if (group_count > args.maximum_output_groups
            || expected != group_count * args.aggregate_count
            || completed != expected) {
        ig_segmented_finalize_fail(
            output_header, control, IG_SEGMENTED_STATUS_REDUCTION_INCOMPLETE);
        return;
    }
    if (!ig_segmented_receipts_valid(receipt_records, args)) {
        ig_segmented_finalize_fail(output_header, control, IG_SEGMENTED_STATUS_INVALID_RECEIPT);
        return;
    }

    uint output_columns = args.grouping_column_count + args.aggregate_count;
    ulong top_level_wide = ulong(group_count) * ulong(output_columns);
    if (top_level_wide > ulong(args.maximum_output_cells)) {
        ig_segmented_finalize_fail(output_header, control, IG_SEGMENTED_STATUS_CELL_CAPACITY);
        return;
    }
    uint top_level_cells = uint(top_level_wide);
    ulong appended_wide = 0ul;
    uint arena_required = 0u;

    // Full preflight: validate every reduction state, exact collect count, output cell count, and
    // byte requirement before mutating output or receipts. This is the no-truncation boundary.
    for (uint group = 0u; group < group_count; ++group) {
        if (args.grouping_column_count != 0u
                && group_first_rows[group] >= args.input_row_count) {
            ig_segmented_finalize_fail(
                output_header, control, IG_SEGMENTED_STATUS_INTERNAL_BOUNDS);
            return;
        }
        for (uint key = 0u; key < args.grouping_column_count; ++key) {
            uint input_index = uint(
                ulong(group_first_rows[group]) * ulong(args.input_column_count)
                + ulong(grouping_columns[key]));
            if (!ig_segmented_preflight_cell(
                    ig_segmented_input_cell(input_cells, input_index),
                    args.maximum_output_arena_bytes,
                    arena_required)) {
                ig_segmented_finalize_fail(
                    output_header, control, IG_SEGMENTED_STATUS_ARENA_CAPACITY);
                return;
            }
        }
        for (uint aggregate = 0u; aggregate < args.aggregate_count; ++aggregate) {
            ulong descriptor_base = ulong(aggregate) * IG_SEGMENTED_AGGREGATE_WORDS;
            uint kind = aggregate_descriptors[descriptor_base];
            uint column = aggregate_descriptors[descriptor_base + 1ul];
            bool distinct = aggregate_descriptors[descriptor_base + 2ul] != 0u;
            ulong state_index = ulong(group) * ulong(args.aggregate_count) + ulong(aggregate);
            device const ulong* state = reduction_states + state_index * 8ul;
            if (!ig_segmented_state_valid(state, kind, args)) {
                ig_segmented_finalize_fail(
                    output_header, control, IG_SEGMENTED_STATUS_REDUCTION_INCOMPLETE);
                return;
            }
            uint mode = uint(state[2]);
            if (mode == IG_SEGMENTED_REDUCTION_INPUT_REF) {
                IgSegmentedCellValue value = ig_segmented_input_cell(
                    input_cells, uint(state[3]));
                if (value.tag == IG_SEGMENTED_VALUE_NULL
                        || !ig_segmented_preflight_selected_input(
                            input_cells, value, args, arena_required)) {
                    ig_segmented_finalize_fail(
                        output_header, control, IG_SEGMENTED_STATUS_ARENA_CAPACITY);
                    return;
                }
                if (value.tag == IG_SEGMENTED_VALUE_LIST) {
                    appended_wide += value.auxiliary;
                    if (appended_wide > ulong(args.maximum_output_cells) - top_level_wide) {
                        ig_segmented_finalize_fail(
                            output_header, control, IG_SEGMENTED_STATUS_CELL_CAPACITY);
                        return;
                    }
                }
            } else if (mode == IG_SEGMENTED_REDUCTION_COLLECT) {
                ulong actual_count = 0ul;
                for (uint row = 0u; row < args.input_row_count; ++row) {
                    IgSegmentedCellValue value;
                    if (!ig_segmented_row_qualifies(
                            input_cells,
                            input_arena,
                            row_group_ids,
                            args,
                            row,
                            group,
                            column,
                            distinct,
                            value)) continue;
                    ++actual_count;
                    if (!ig_segmented_preflight_cell(
                            value, args.maximum_output_arena_bytes, arena_required)) {
                        ig_segmented_finalize_fail(
                            output_header, control, IG_SEGMENTED_STATUS_ARENA_CAPACITY);
                        return;
                    }
                }
                if (actual_count != state[3]) {
                    ig_segmented_finalize_fail(
                        output_header, control, IG_SEGMENTED_STATUS_REDUCTION_INCOMPLETE);
                    return;
                }
                appended_wide += actual_count;
                if (appended_wide > ulong(args.maximum_output_cells) - top_level_wide) {
                    ig_segmented_finalize_fail(
                        output_header, control, IG_SEGMENTED_STATUS_CELL_CAPACITY);
                    return;
                }
            }
        }
    }
    uint total_cells = uint(top_level_wide + appended_wide);
    if (total_cells > args.output_cell_capacity
            || arena_required > args.output_arena_capacity) {
        ig_segmented_finalize_fail(
            output_header,
            control,
            total_cells > args.output_cell_capacity
                ? IG_SEGMENTED_STATUS_CELL_CAPACITY : IG_SEGMENTED_STATUS_ARENA_CAPACITY);
        return;
    }

    uint appended_cursor = 0u;
    uint arena_cursor = 0u;
    for (uint group = 0u; group < group_count; ++group) {
        uint row_output = group * output_columns;
        for (uint key = 0u; key < args.grouping_column_count; ++key) {
            uint input_index = uint(
                ulong(group_first_rows[group]) * ulong(args.input_column_count)
                + ulong(grouping_columns[key]));
            if (!ig_segmented_copy_input_cell(
                    input_arena,
                    ig_segmented_input_cell(input_cells, input_index),
                    output_cells,
                    row_output + key,
                    output_arena,
                    args.output_arena_capacity,
                    arena_cursor)) {
                ig_segmented_finalize_fail(
                    output_header, control, IG_SEGMENTED_STATUS_INTERNAL_BOUNDS);
                return;
            }
        }
        for (uint aggregate = 0u; aggregate < args.aggregate_count; ++aggregate) {
            ulong descriptor_base = ulong(aggregate) * IG_SEGMENTED_AGGREGATE_WORDS;
            uint column = aggregate_descriptors[descriptor_base + 1ul];
            bool distinct = aggregate_descriptors[descriptor_base + 2ul] != 0u;
            ulong state_index = ulong(group) * ulong(args.aggregate_count) + ulong(aggregate);
            device const ulong* state = reduction_states + state_index * 8ul;
            uint destination = row_output + args.grouping_column_count + aggregate;
            uint mode = uint(state[2]);
            if (mode == IG_SEGMENTED_REDUCTION_CELL) {
                IgSegmentedCellValue value;
                value.tag = uint(state[3]);
                value.payload = state[4];
                value.auxiliary = state[5];
                ig_segmented_write_cell(output_cells, destination, value);
            } else if (mode == IG_SEGMENTED_REDUCTION_INPUT_REF) {
                IgSegmentedCellValue value = ig_segmented_input_cell(
                    input_cells, uint(state[3]));
                if (value.tag == IG_SEGMENTED_VALUE_LIST) {
                    uint input_start = uint(value.payload);
                    uint length = uint(value.auxiliary);
                    value.payload = ulong(top_level_cells + appended_cursor);
                    ig_segmented_write_cell(output_cells, destination, value);
                    for (uint child = 0u; child < length; ++child) {
                        if (!ig_segmented_copy_input_cell(
                                input_arena,
                                ig_segmented_input_cell(input_cells, input_start + child),
                                output_cells,
                                top_level_cells + appended_cursor + child,
                                output_arena,
                                args.output_arena_capacity,
                                arena_cursor)) {
                            ig_segmented_finalize_fail(
                                output_header, control, IG_SEGMENTED_STATUS_INTERNAL_BOUNDS);
                            return;
                        }
                    }
                    appended_cursor += length;
                } else if (!ig_segmented_copy_input_cell(
                    input_arena,
                    value,
                    output_cells,
                    destination,
                    output_arena,
                    args.output_arena_capacity,
                    arena_cursor)) {
                        ig_segmented_finalize_fail(
                            output_header, control, IG_SEGMENTED_STATUS_INTERNAL_BOUNDS);
                        return;
                }
            } else {
                IgSegmentedCellValue list;
                list.tag = IG_SEGMENTED_VALUE_LIST;
                list.payload = ulong(top_level_cells + appended_cursor);
                list.auxiliary = state[3];
                ig_segmented_write_cell(output_cells, destination, list);
                uint emitted = 0u;
                for (uint row = 0u; row < args.input_row_count; ++row) {
                    IgSegmentedCellValue value;
                    if (!ig_segmented_row_qualifies(
                            input_cells,
                            input_arena,
                            row_group_ids,
                            args,
                            row,
                            group,
                            column,
                            distinct,
                            value)) continue;
                    uint child = top_level_cells + appended_cursor + emitted;
                    if (!ig_segmented_copy_input_cell(
                            input_arena,
                            value,
                            output_cells,
                            child,
                            output_arena,
                            args.output_arena_capacity,
                            arena_cursor)) {
                        ig_segmented_finalize_fail(
                            output_header, control, IG_SEGMENTED_STATUS_INTERNAL_BOUNDS);
                        return;
                    }
                    ++emitted;
                }
                if (ulong(emitted) != state[3]) {
                    ig_segmented_finalize_fail(
                        output_header, control, IG_SEGMENTED_STATUS_REDUCTION_INCOMPLETE);
                    return;
                }
                appended_cursor += emitted;
            }
        }
    }
    if (top_level_cells + appended_cursor != total_cells || arena_cursor != arena_required) {
        ig_segmented_finalize_fail(
            output_header, control, IG_SEGMENTED_STATUS_INTERNAL_BOUNDS);
        return;
    }

    output_header[4] = ulong(group_count) | (ulong(output_columns) << 32u);
    output_header[5] = ulong(total_cells) | (ulong(arena_cursor) << 32u);
    atomic_store_explicit(&control[5], total_cells, memory_order_relaxed);
    atomic_store_explicit(&control[6], arena_cursor, memory_order_relaxed);
    for (uint receipt = 0u; receipt < args.receipt_count; ++receipt) {
        ig_segmented_complete_receipt(
            receipt_records + ulong(receipt) * 9ul,
            input_header[2],
            input_header[3],
            args.input_row_count,
            group_count);
    }
    atomic_store_explicit(&control[0], IG_SEGMENTED_STATUS_SUCCESS, memory_order_relaxed);
    atomic_store_explicit(&control[1], IG_SEGMENTED_PHASE_COMPLETE, memory_order_relaxed);
    ig_segmented_header_status(
        output_header, IG_SEGMENTED_STATUS_SUCCESS, IG_SEGMENTED_PHASE_COMPLETE);
}

// ---- Fused fixed-pattern graph aggregation ------------------------------------------
//
// This adapter keeps the complete fixed-pattern -> aggregate -> post-aggregate command on the
// device.  The source phase translates the already-completed nullable-relation packet into the
// generic segmented relation ABI above.  GROUP/REDUCE/FINALIZE then run unchanged, and the final
// phase interprets the sealed scalar postfix program, stable ORDER/SKIP/LIMIT stages, and publishes
// the only host-visible relation and receipts.  Capacity rows are deliberately present in the
// generic input. One private shadow column per computed group and per reduction makes padding
// semantically inert even when a source binding is both a grouping key and an aggregate input.
//
// A grouping descriptor keeps its generic input column in low32. Bits 32..47 carry the source
// expression start and bits 48..63 its instruction count; both are zero for a direct binding.
// Aggregate descriptor word 3 is all-ones for count(*), a direct binding column when high32 is
// zero, or low32 expression start plus high32 instruction count for a computed input. Source
// descriptor word 4 is the exact percentile f64 payload for percentile reductions and zero for
// every other kind. The paired generic u32 descriptor carries that payload in words 3 and 4.
// expressions are one contiguous prefix of the ordinary postfix instruction section and their
// SLOT operands are physical binding columns, never staged or aggregate-output slots. A final
// hidden byte-cover cell gives the generic validator exact ownership of the admitted arena.

constant ulong IG_SEGMENTED_GRAPH_PROGRAM_MAGIC = 0x4753475250524f47ul;
constant ulong IG_SEGMENTED_GRAPH_PROGRAM_VERSION = 4ul;
constant ulong IG_SEGMENTED_GRAPH_OUTPUT_MAGIC = 0x475347524f555450ul;
constant ulong IG_SEGMENTED_GRAPH_OUTPUT_VERSION = 4ul;
constant ulong IG_SEGMENTED_GRAPH_PROGRAM_HEADER_WORDS = 56ul;
constant ulong IG_SEGMENTED_GRAPH_BINDING_WORDS = 12ul;
constant ulong IG_SEGMENTED_GRAPH_AGGREGATE_WORDS = 5ul;
constant ulong IG_SEGMENTED_GRAPH_INITIAL_WORDS = 2ul;
constant ulong IG_SEGMENTED_GRAPH_STAGE_WORDS = 5ul;
constant ulong IG_SEGMENTED_GRAPH_PROJECTION_WORDS = 4ul;
constant ulong IG_SEGMENTED_GRAPH_ORDER_WORDS = 4ul;
constant ulong IG_SEGMENTED_GRAPH_INSTRUCTION_WORDS = 4ul;
constant ulong IG_SEGMENTED_GRAPH_RECEIPT_DESCRIPTOR_WORDS = 3ul;
constant ulong IG_SEGMENTED_GRAPH_RECEIPT_WORDS = 9ul;
constant ulong IG_SEGMENTED_GRAPH_OUTPUT_HEADER_WORDS = 24ul;
constant uint IG_SEGMENTED_GRAPH_EXPRESSION_STACK = 40u;

constant uint IG_SEGMENTED_GRAPH_STATUS_EXPRESSION_TYPE = 20u;
constant uint IG_SEGMENTED_GRAPH_STATUS_DIVISION_BY_ZERO = 21u;
constant uint IG_SEGMENTED_GRAPH_STATUS_ARITHMETIC_OVERFLOW = 22u;
constant uint IG_SEGMENTED_GRAPH_STATUS_INVALID_PROGRAM = 23u;
constant uint IG_SEGMENTED_GRAPH_STATUS_INVALID_NULLABLE = 24u;
constant uint IG_SEGMENTED_GRAPH_STATUS_SOURCE_CAPACITY = 25u;
constant uint IG_SEGMENTED_GRAPH_STATUS_INVALID_STAGE = 26u;
constant uint IG_SEGMENTED_GRAPH_STATUS_OUTPUT_CAPACITY = 27u;
constant uint IG_SEGMENTED_GRAPH_STATUS_INTERNAL_BOUNDS = 28u;
constant uint IG_SEGMENTED_GRAPH_CONTROL_READY = 0x47534752u;

// Validation is deliberately split across small serial PSOs.  The AGX backend has terminated its
// compiler service while lowering the former monolithic source+validation kernel.  Word 7 is a
// transient ordered token until source materialization replaces it with CONTROL_READY.
constant uint IG_SEGMENTED_GRAPH_VALIDATION_INITIALIZED = 0x47530001u;
